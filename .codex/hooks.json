{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet '/home/amir/ISLAMU/Github/Event/.codex/hooks/SecurityCheck.cs'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet '/home/amir/ISLAMU/Github/Event/.codex/hooks/ContextTracker.cs'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dotnet '/home/amir/ISLAMU/Github/Event/.codex/hooks/SkillTrigger.cs'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dotnet '/home/amir/ISLAMU/Github/Event/.codex/hooks/FormatCode.cs'"
          },
          {
            "type": "command",
            "command": "dotnet '/home/amir/ISLAMU/Github/Event/.codex/hooks/BuildCheck.cs'"
          }
        ]
      }
    ]
  }
}
