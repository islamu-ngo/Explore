@* ABOUTME: Shared host-neutral plan list page for the embedded Event control plane. *@
@* ABOUTME: Renders plan governance actions only when the API supplies matching HAL links. *@

@page "/admin/instance/plans"
@inject IControlPlanePlanService PlanService
@inject NavigationManager Navigation

<PageTitle>Control Plane Plans</PageTitle>

<div class="control-plane-plans">
    <ControlPlanePageHeader Title="Plans"
                            Eyebrow="Instance console"
                            Description="Govern tenant plans, versions, pricing, and provisioning eligibility exposed by the control-plane API.">
        <ActionsContent>
            @if (CanCreatePlan)
            {
                <ControlPlaneActionButton Color="Color.Primary"
                                          Variant="Variant.Filled"
                                          Disabled="true"
                                          StartIcon="@Icons.Material.Filled.Add"
                                          AriaLabel="Create plan">
                    Create plan
                </ControlPlaneActionButton>
            }
        </ActionsContent>
    </ControlPlanePageHeader>

    @if (_result is null)
    {
        <ControlPlanePanel Title="Loading plans">
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        </ControlPlanePanel>
    }
    else if (!_result.IsSuccess)
    {
        <ControlPlanePanel Title="Control-plane API unavailable" Description="Plan data is hidden until the host registers a control-plane API adapter.">
            <p class="control-plane-plans__message" role="alert">@ProblemMessage</p>
        </ControlPlanePanel>
    }
    else if (Plans.Items.Count == 0)
    {
        <ControlPlanePanel Title="No plans yet" Description="The control-plane API did not return any plans for this instance.">
            <p class="control-plane-plans__message">Create affordances will appear here only when the API advertises them.</p>
        </ControlPlanePanel>
    }
    else
    {
        <ControlPlanePanel Title="Plan inventory" Description="@PlanCountLabel">
            <div class="control-plane-plans__list" role="list">
                @foreach (var plan in Plans.Items)
                {
                    <article class="control-plane-plans__item" role="listitem" @key="plan.Id">
                        <div class="control-plane-plans__item-main">
                            <div class="control-plane-plans__heading">
                                <h2 class="control-plane-plans__name">@plan.DisplayName</h2>
                                @if (plan.IsActiveForProvisioning)
                                {
                                    <span class="control-plane-plans__badge control-plane-plans__badge--active" aria-label="Active for provisioning">Active</span>
                                }
                                else
                                {
                                    <span class="control-plane-plans__badge control-plane-plans__badge--inactive" aria-label="Inactive for provisioning">Inactive</span>
                                }
                            </div>
                            <dl class="control-plane-plans__facts">
                                <div>
                                    <dt>Key</dt>
                                    <dd><code>@plan.Key</code></dd>
                                </div>
                                <div>
                                    <dt>Pricing</dt>
                                    <dd>@FormatPricing(plan)</dd>
                                </div>
                                <div>
                                    <dt>Latest version</dt>
                                    <dd>v@plan.LatestVersionNumber</dd>
                                </div>
                                <div>
                                    <dt>Published</dt>
                                    <dd>@FormatPublished(plan)</dd>
                                </div>
                            </dl>
                            @if (!string.IsNullOrWhiteSpace(plan.Description))
                            {
                                <p class="control-plane-plans__description">@plan.Description</p>
                            }
                        </div>

                        <div class="control-plane-plans__actions" aria-label="@($"Plan actions for {plan.DisplayName}")">
                            @if (ControlPlaneHal.HasLink(plan, ControlPlaneLinkRelations.Self))
                            {
                                <ControlPlaneActionButton Size="Size.Small"
                                                          Disabled="@IsBusy"
                                                          AriaLabel="@($"View details for {plan.DisplayName}")"
                                                          OnClick="@(() => OpenPlanDetail(plan))">View details</ControlPlaneActionButton>
                            }
                        </div>
                    </article>
                }
            </div>
        </ControlPlanePanel>
    }
</div>

@if (_commandMessage is not null)
{
    <ControlPlanePanel Title="Plan action result">
        <p class="control-plane-plans__message" role="status">@_commandMessage</p>
    </ControlPlanePanel>
}

@code {
    private ControlPlaneResult<ControlPlaneTenantPlanList>? _result;
    private bool _busy;
    private string? _commandMessage;

    private bool CanCreatePlan => ControlPlaneHal.HasLink(_result?.Value, ControlPlaneLinkRelations.Create);

    private bool IsBusy => _busy;

    private ControlPlaneTenantPlanList Plans => _result?.Value ?? ControlPlaneTenantPlanList.Empty();

    private string ProblemMessage => _result?.Problem?.Message ?? "The control-plane API adapter is not configured for this host.";

    private string PlanCountLabel => Plans.TotalCount == 1
        ? "1 plan returned by the control-plane API."
        : $"{Plans.TotalCount} plans returned by the control-plane API.";

    protected override async Task OnInitializedAsync()
    {
        _result = await PlanService.GetPlansAsync();
    }

    private void OpenPlanDetail(ControlPlaneTenantPlanSummary plan)
    {
        var detail = ControlPlaneRoutes.PlanDetail.Replace("{Key}", Uri.EscapeDataString(plan.Key), StringComparison.Ordinal);
        Navigation.NavigateTo(detail);
    }

    private static string FormatPricing(ControlPlaneTenantPlanSummary plan) =>
        $"{plan.PriceAmount:0.##} {plan.CurrencyCode} / {plan.BillingPeriod}";

    private static string FormatPublished(ControlPlaneTenantPlanSummary plan) =>
        plan.PublishedVersionNumber is null ? "Not published" : $"v{plan.PublishedVersionNumber}";
}
