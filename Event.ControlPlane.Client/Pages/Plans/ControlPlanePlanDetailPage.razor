@* ABOUTME: Shared host-neutral plan detail page for the embedded Event control plane. *@
@* ABOUTME: Renders plan versions, settings, quotas, and lifecycle actions only when HAL links exist. *@

@page "/admin/instance/plans/{Key}"
@inject IControlPlanePlanService PlanService
@inject NavigationManager Navigation

<PageTitle>Plan: @PlanDisplayName</PageTitle>

<div class="control-plane-plan-detail">
    <ControlPlanePageHeader Title="@PlanDisplayName"
                            Eyebrow="Instance console › Plans"
                            Description="@PlanDescriptionLabel">
        <ActionsContent>
            @if (ControlPlaneHal.HasLink(_result?.Value, ControlPlaneLinkRelations.CreateVersionDraft))
            {
                <ControlPlaneActionButton Color="Color.Primary"
                                          Variant="Variant.Filled"
                                          Disabled="@IsBusy"
                                          StartIcon="@Icons.Material.Filled.Add"
                                          AriaLabel="@($"Create new version draft for {PlanDisplayName}")"
                                          OnClick="CreateVersionDraftAsync">New version draft</ControlPlaneActionButton>
            }
            <ControlPlaneActionButton Variant="Variant.Outlined"
                                      AriaLabel="Back to plans list"
                                      OnClick="BackToPlans">Back to plans</ControlPlaneActionButton>
        </ActionsContent>
    </ControlPlanePageHeader>

    @if (_result is null)
    {
        <ControlPlanePanel Title="Loading plan">
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        </ControlPlanePanel>
    }
    else if (!_result.IsSuccess)
    {
        <ControlPlanePanel Title="Control-plane API unavailable" Description="Plan detail is hidden until the host registers a control-plane API adapter.">
            <p class="control-plane-plan-detail__message" role="alert">@ProblemMessage</p>
        </ControlPlanePanel>
    }
    else if (_result.Value is { } detail)
    {
        @if (detail.Versions.Count == 0)
        {
            <ControlPlanePanel Title="No versions yet" Description="This plan has no versions. Create a draft to begin configuring tenant settings and quotas.">
                <p class="control-plane-plan-detail__message">Version affordances will appear here only when the API advertises them.</p>
            </ControlPlanePanel>
        }
        else
        {
            <ControlPlanePanel Title="Plan versions" Description="@VersionCountLabel">
                <div class="control-plane-plan-detail__versions" role="list">
                    @foreach (var version in detail.Versions)
                    {
                        <article class="control-plane-plan-detail__version control-plane-plan-detail__version--@version.StatusCode.ToLowerInvariant()"
                                 role="listitem"
                                 @key="version.Id">
                            <div class="control-plane-plan-detail__version-main">
                                <div class="control-plane-plan-detail__version-heading">
                                    <h2 class="control-plane-plan-detail__version-title">Version @version.VersionNumber</h2>
                                    <span class="control-plane-plan-detail__badge control-plane-plan-detail__badge--@version.StatusCode.ToLowerInvariant()" aria-label="@($"Status: {version.StatusCode}")">@version.StatusCode</span>
                                </div>
                                <dl class="control-plane-plan-detail__facts">
                                    <div>
                                        <dt>Pricing</dt>
                                        <dd>@FormatPricing(version)</dd>
                                    </div>
                                    <div>
                                        <dt>Provisioning</dt>
                                        <dd>@(version.IsActiveForProvisioning ? "Eligible" : "Disabled")</dd>
                                    </div>
                                </dl>

                                @if (version.Settings.Count > 0)
                                {
                                    <details class="control-plane-plan-detail__section">
                                        <summary class="control-plane-plan-detail__section-summary">Settings (@version.Settings.Count)</summary>
                                        <div class="control-plane-plan-detail__domain-groups">
                                            @foreach (var group in GroupSettingsByProductDomain(version.Settings))
                                            {
                                                <section class="control-plane-plan-detail__domain-group" aria-label="@($"{group.Label} settings")" @key="group.Label">
                                                    <h3 class="control-plane-plan-detail__domain-title">
                                                        @group.Label settings
                                                        <span class="control-plane-plan-detail__domain-count">@group.Settings.Count</span>
                                                    </h3>
                                                    <table class="control-plane-plan-detail__table">
                                                        <thead>
                                                            <tr>
                                                                <th scope="col">Key</th>
                                                                <th scope="col">Value</th>
                                                                <th scope="col">Locked</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var setting in group.Settings)
                                                            {
                                                                <tr @key="setting.Key">
                                                                    <td><code>@setting.Key</code></td>
                                                                    <td>@setting.JsonValue</td>
                                                                    <td>@(setting.IsLocked ? "Yes" : "No")</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </section>
                                            }
                                        </div>
                                    </details>
                                }

                                @if (version.Quotas.Count > 0)
                                {
                                    <details class="control-plane-plan-detail__section">
                                        <summary class="control-plane-plan-detail__section-summary">Quotas (@version.Quotas.Count)</summary>
                                        <table class="control-plane-plan-detail__table">
                                            <thead>
                                                <tr>
                                                    <th scope="col">Key</th>
                                                    <th scope="col">Limit</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var quota in version.Quotas)
                                                {
                                                    <tr @key="quota.Key">
                                                        <td><code>@quota.Key</code></td>
                                                        <td>@FormatQuotaLimit(quota.Limit)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </details>
                                }
                            </div>

                             @if (HasVersionAction(version))
                             {
                                 <div class="control-plane-plan-detail__version-actions" aria-label="@($"Version {version.VersionNumber} actions")">
                                    @if (CanEditDraftVersion(version))
                                    {
                                        <ControlPlaneActionButton Size="Size.Small"
                                                                  Color="Color.Primary"
                                                                  Disabled="@IsBusy"
                                                                  AriaLabel="@($"Edit version {version.VersionNumber} draft")"
                                                                  OnClick="@(() => StartDraftEditor(version))">Edit draft</ControlPlaneActionButton>
                                    }
                                     @if (CanPublishVersion(version))
                                     {
                                         <ControlPlaneActionButton Size="Size.Small"
                                                                   Color="Color.Success"
                                                                  Disabled="@IsBusy"
                                                                  AriaLabel="@($"Publish version {version.VersionNumber}")"
                                                                  OnClick="@(() => PublishVersionAsync(version.Id))">Publish</ControlPlaneActionButton>
                                    }
                                    @if (CanArchiveVersion(version))
                                    {
                                        <ControlPlaneActionButton Size="Size.Small"
                                                                  Color="Color.Warning"
                                                                  Disabled="@IsBusy"
                                                                  AriaLabel="@($"Archive version {version.VersionNumber}")"
                                                                  OnClick="@(() => ArchiveVersionAsync(version.Id))">Archive</ControlPlaneActionButton>
                                    }
                                    @if (CanCloneVersion(version))
                                    {
                                        <ControlPlaneActionButton Size="Size.Small"
                                                                  Disabled="@IsBusy"
                                                                  AriaLabel="@($"Clone version {version.VersionNumber}")"
                                                                  OnClick="@(() => StartCloneConfirmation(version))">Clone</ControlPlaneActionButton>
                                    }
                                 </div>
                             }

                            @if (_draftEditor?.VersionId == version.Id)
                            {
                                <form class="control-plane-plan-detail__editor" @onsubmit="SaveDraftAsync" @onsubmit:preventDefault="true">
                                    <h3 class="control-plane-plan-detail__editor-title">Edit draft version @version.VersionNumber</h3>
                                    <p class="control-plane-plan-detail__editor-help">
                                        Settings use one line per key: <code>key|json value|locked</code>. Domain comment lines starting with <code>#</code> are ignored. Quotas use <code>key|limit</code>.
                                    </p>

                                    <div class="control-plane-plan-detail__editor-grid">
                                        <label class="control-plane-plan-detail__editor-field">
                                            Plan name
                                            <input aria-label="Plan name" @bind="_draftEditor.Name" />
                                        </label>
                                        <label class="control-plane-plan-detail__editor-field">
                                            Price amount
                                            <input aria-label="Price amount" inputmode="decimal" @bind="_draftEditor.PriceAmount" />
                                        </label>
                                        <label class="control-plane-plan-detail__editor-field">
                                            Currency
                                            <input aria-label="Currency code" maxlength="3" @bind="_draftEditor.CurrencyCode" />
                                        </label>
                                        <label class="control-plane-plan-detail__editor-field">
                                            Billing period
                                            <input aria-label="Billing period" @bind="_draftEditor.BillingPeriod" />
                                        </label>
                                    </div>

                                    <label class="control-plane-plan-detail__editor-check">
                                        <input type="checkbox" @bind="_draftEditor.IsActiveForProvisioning" />
                                        Active for new tenant provisioning
                                    </label>

                                    <label class="control-plane-plan-detail__editor-field">
                                        Setting overrides
                                        <textarea class="control-plane-plan-detail__editor-textarea"
                                                  aria-label="Setting overrides"
                                                  rows="8"
                                                  @bind="_draftEditor.SettingsText"></textarea>
                                    </label>

                                    <label class="control-plane-plan-detail__editor-field">
                                        Quota limits
                                        <textarea class="control-plane-plan-detail__editor-textarea"
                                                  aria-label="Quota limits"
                                                  rows="5"
                                                  @bind="_draftEditor.QuotasText"></textarea>
                                    </label>

                                    @if (_editorErrors.Count > 0)
                                    {
                                        <div class="control-plane-plan-detail__validation" role="alert">
                                            <strong>Fix draft formatting before saving.</strong>
                                            <ul class="control-plane-plan-detail__validation-list">
                                                @foreach (var error in _editorErrors)
                                                {
                                                    <li>@error</li>
                                                }
                                            </ul>
                                        </div>
                                    }

                                    @if (_validationErrors.Count > 0)
                                    {
                                        <div class="control-plane-plan-detail__validation" role="alert">
                                            <strong>Plan validation found issues.</strong>
                                            <ul class="control-plane-plan-detail__validation-list">
                                                @foreach (var error in _validationErrors)
                                                {
                                                    <li><code>@error.Target</code> @error.Code: @error.Message</li>
                                                }
                                            </ul>
                                        </div>
                                    }

                                    <div class="control-plane-plan-detail__editor-actions">
                                        <ControlPlaneActionButton Color="Color.Secondary"
                                                                  Disabled="@IsBusy"
                                                                  ButtonType="ButtonType.Button"
                                                                  AriaLabel="Validate draft version"
                                                                  OnClick="ValidateDraftAsync">Validate</ControlPlaneActionButton>
                                        <ControlPlaneActionButton Color="Color.Primary"
                                                                  Variant="Variant.Filled"
                                                                  Disabled="@IsBusy"
                                                                  ButtonType="ButtonType.Submit"
                                                                  AriaLabel="Save draft version">Save draft</ControlPlaneActionButton>
                                        <ControlPlaneActionButton Disabled="@IsBusy"
                                                                  ButtonType="ButtonType.Button"
                                                                  AriaLabel="Cancel draft editing"
                                                                  OnClick="CancelDraftEditor">Cancel</ControlPlaneActionButton>
                                    </div>
                                </form>
                            }
                         </article>
                     }
                 </div>
             </ControlPlanePanel>
        }
    }
</div>

@if (_cloneVersion is not null)
{
    <ControlPlanePanel Title="Clone plan version" Description="Create a new draft plan from this version. Provide a unique key and display name.">
        <div class="control-plane-plan-detail__clone-form">
            <p>Source: Version @_cloneVersion.VersionNumber</p>
            <label>
                New plan key
                <input aria-label="New plan key" @bind="_cloneKey" placeholder="e.g. enterprise-v2" />
            </label>
            <label>
                New plan name
                <input aria-label="New plan name" @bind="_cloneName" placeholder="e.g. Enterprise" />
            </label>
            <div class="control-plane-plan-detail__clone-actions">
                <ControlPlaneActionButton Color="Color.Primary"
                                          Disabled="@(!CanConfirmClone || IsBusy)"
                                          AriaLabel="Confirm clone"
                                          OnClick="ConfirmCloneAsync">Clone to new plan</ControlPlaneActionButton>
                <ControlPlaneActionButton Disabled="@IsBusy"
                                          AriaLabel="Cancel clone"
                                          OnClick="CancelCloneConfirmation">Cancel</ControlPlaneActionButton>
            </div>
        </div>
    </ControlPlanePanel>
}

@if (_commandMessage is not null)
{
    <ControlPlanePanel Title="Plan action result">
        <p class="control-plane-plan-detail__message" role="@CommandMessageRole">@_commandMessage</p>
    </ControlPlanePanel>
}

@code {
    [Parameter] public string Key { get; set; } = string.Empty;

    private ControlPlaneResult<ControlPlaneTenantPlanDetail>? _result;
    private bool _busy;
    private string? _commandMessage;
    private bool? _commandSucceeded;
    private ControlPlaneTenantPlanVersion? _cloneVersion;
    private string? _cloneKey;
    private string? _cloneName;
    private DraftEditorState? _draftEditor;
    private IReadOnlyList<string> _editorErrors = [];
    private IReadOnlyList<ControlPlaneTenantPlanValidationError> _validationErrors = [];

    private bool IsBusy => _busy;

    private string PlanDisplayName => _result?.Value?.DisplayName ?? Key;

    private string PlanDescriptionLabel =>
        string.IsNullOrWhiteSpace(_result?.Value?.Description)
            ? $"Plan key: {Key}"
            : _result.Value.Description;

    private string ProblemMessage => _result?.Problem?.Message ?? "The control-plane API adapter is not configured for this host.";

    private string CommandMessageRole => _commandSucceeded == false ? "alert" : "status";

    private string VersionCountLabel =>
        _result?.Value?.Versions.Count == 1
            ? "1 version."
            : $"{_result?.Value?.Versions.Count ?? 0} versions.";

    private bool CanConfirmClone =>
        _cloneVersion is not null
        && !string.IsNullOrWhiteSpace(_cloneKey)
        && !string.IsNullOrWhiteSpace(_cloneName);

    protected override async Task OnInitializedAsync()
    {
        _result = await PlanService.GetPlanAsync(Key);
    }

    private async Task CreateVersionDraftAsync()
    {
        if (_result?.Value is null)
        {
            return;
        }

        var detail = _result.Value;
        _busy = true;
        _commandMessage = null;
        _commandSucceeded = null;
        _editorErrors = [];
        _validationErrors = [];

        var draft = new ControlPlaneTenantPlanDraft(
            detail.Key,
            detail.DisplayName,
            new ControlPlaneTenantPlanPricing(0, "EUR", "monthly"),
            IsActiveForProvisioning: true,
            SettingOverrides: [],
            QuotaLimits: []);

        var result = await PlanService.CreatePlanVersionDraftAsync(detail.Key, draft);
        _commandMessage = result.Message;
        _commandSucceeded = result.Success;

        if (result.Success)
        {
            _result = await PlanService.GetPlanAsync(Key);
        }

        _busy = false;
    }

    private async Task PublishVersionAsync(Guid versionId)
    {
        _busy = true;
        _commandMessage = null;
        _commandSucceeded = null;

        var result = await PlanService.PublishPlanVersionAsync(
            versionId,
            ControlPlaneTenantPlanExistingAssignmentPolicy.LeaveExistingTenantsPinned);

        _commandMessage = result.Message;
        _commandSucceeded = result.Success;

        if (result.Success)
        {
            _result = await PlanService.GetPlanAsync(Key);
        }

        _busy = false;
    }

    private async Task ArchiveVersionAsync(Guid versionId)
    {
        _busy = true;
        _commandMessage = null;
        _commandSucceeded = null;

        var result = await PlanService.ArchivePlanVersionAsync(versionId);
        _commandMessage = result.Message;
        _commandSucceeded = result.Success;

        if (result.Success)
        {
            _result = await PlanService.GetPlanAsync(Key);
        }

        _busy = false;
    }

    private void StartCloneConfirmation(ControlPlaneTenantPlanVersion version)
    {
        _cloneVersion = version;
        _draftEditor = null;
        _editorErrors = [];
        _validationErrors = [];
        _cloneKey = null;
        _cloneName = null;
        _commandMessage = null;
        _commandSucceeded = null;
    }

    private void CancelCloneConfirmation()
    {
        _cloneVersion = null;
        _cloneKey = null;
        _cloneName = null;
    }

    private void StartDraftEditor(ControlPlaneTenantPlanVersion version)
    {
        if (_result?.Value is null)
        {
            return;
        }

        _cloneVersion = null;
        _draftEditor = DraftEditorState.From(_result.Value, version);
        _editorErrors = [];
        _validationErrors = [];
        _commandMessage = null;
        _commandSucceeded = null;
    }

    private void CancelDraftEditor()
    {
        _draftEditor = null;
        _editorErrors = [];
        _validationErrors = [];
    }

    private async Task ValidateDraftAsync()
    {
        if (!TryBuildDraft(out var draft))
        {
            return;
        }

        _busy = true;
        _commandMessage = null;
        _commandSucceeded = null;

        var result = await PlanService.ValidatePlanDraftAsync(draft);
        _validationErrors = result.Value?.Errors ?? [];
        _commandMessage = result.IsSuccess && result.Value?.IsValid == true
            ? "Draft is valid."
            : result.Problem?.Message ?? "Draft has validation issues.";
        _commandSucceeded = result.IsSuccess && result.Value?.IsValid == true;

        _busy = false;
    }

    private async Task SaveDraftAsync()
    {
        if (_draftEditor is null || !TryBuildDraft(out var draft))
        {
            return;
        }

        _busy = true;
        _commandMessage = null;
        _commandSucceeded = null;

        var result = await PlanService.UpdatePlanVersionDraftAsync(_draftEditor.VersionId, draft);
        _commandMessage = result.Message;
        _commandSucceeded = result.Success;

        if (result.Success)
        {
            CancelDraftEditor();
            _result = await PlanService.GetPlanAsync(Key);
        }

        _busy = false;
    }

    private bool TryBuildDraft(out ControlPlaneTenantPlanDraft draft)
    {
        draft = default!;

        if (_draftEditor is null)
        {
            return false;
        }

        if (!_draftEditor.TryBuildDraft(out draft, out var errors))
        {
            _editorErrors = errors;
            _validationErrors = [];
            return false;
        }

        _editorErrors = [];
        return true;
    }

    private async Task ConfirmCloneAsync()
    {
        if (!CanConfirmClone || _cloneVersion is null)
        {
            return;
        }

        _busy = true;
        _commandMessage = null;
        _commandSucceeded = null;

        var result = await PlanService.ClonePlanAsync(
            _cloneVersion.Id,
            _cloneKey!.Trim(),
            _cloneName!.Trim());

        _commandMessage = result.Message;
        _commandSucceeded = result.Success;

        if (result.Success)
        {
            CancelCloneConfirmation();
            Navigation.NavigateTo(ControlPlaneRoutes.Plans);
        }

        _busy = false;
    }

    private void BackToPlans()
    {
        Navigation.NavigateTo(ControlPlaneRoutes.Plans);
    }

    private bool HasVersionAction(ControlPlaneTenantPlanVersion version) =>
        CanEditDraftVersion(version)
        || CanPublishVersion(version)
        || CanArchiveVersion(version)
        || CanCloneVersion(version);

    private bool CanEditDraftVersion(ControlPlaneTenantPlanVersion version) =>
        ControlPlaneHal.HasLink(_result?.Value, ControlPlaneLinkRelations.UpdateVersionDraft)
        && version.StatusCode.Equals("Draft", StringComparison.OrdinalIgnoreCase);

    private bool CanPublishVersion(ControlPlaneTenantPlanVersion version) =>
        ControlPlaneHal.HasLink(_result?.Value, ControlPlaneLinkRelations.Publish)
        && version.StatusCode.Equals("Draft", StringComparison.OrdinalIgnoreCase);

    private bool CanArchiveVersion(ControlPlaneTenantPlanVersion version) =>
        ControlPlaneHal.HasLink(_result?.Value, ControlPlaneLinkRelations.Archive)
        && version.StatusCode.Equals("Published", StringComparison.OrdinalIgnoreCase);

    private bool CanCloneVersion(ControlPlaneTenantPlanVersion version) =>
        ControlPlaneHal.HasLink(_result?.Value, ControlPlaneLinkRelations.Clone)
        && version.StatusCode.Equals("Published", StringComparison.OrdinalIgnoreCase);

    private static string FormatPricing(ControlPlaneTenantPlanVersion version) =>
        $"{version.PriceAmount:0.##} {version.CurrencyCode} / {version.BillingPeriod}";

    private static string FormatQuotaLimit(long limit) =>
        limit >= 1024 * 1024 * 1024
            ? $"{limit / (1024 * 1024 * 1024):0.##} GiB"
            : $"{limit:N0}";

    private static IReadOnlyList<PlanSettingGroup> GroupSettingsByProductDomain(IReadOnlyList<ControlPlaneTenantPlanSetting> settings) =>
        settings
            .GroupBy(setting => ProductDomainForKey(setting.Key))
            .OrderBy(group => group.Key.Order)
            .ThenBy(group => group.Key.Label, StringComparer.Ordinal)
            .Select(group => new PlanSettingGroup(
                group.Key.Label,
                group.OrderBy(setting => setting.Key, StringComparer.OrdinalIgnoreCase).ToArray()))
            .ToArray();

    private static (int Order, string Label) ProductDomainForKey(string key)
    {
        var normalized = key.Trim().ToLowerInvariant();

        return normalized switch
        {
            _ when normalized.StartsWith("modules.", StringComparison.Ordinal) || normalized.StartsWith("module.", StringComparison.Ordinal) => (0, "Modules"),
            _ when normalized.StartsWith("storage.", StringComparison.Ordinal) || normalized.StartsWith("uploads.", StringComparison.Ordinal) => (1, "Storage"),
            _ when normalized.StartsWith("email.", StringComparison.Ordinal) || normalized.StartsWith("smtp.", StringComparison.Ordinal) || normalized.StartsWith("mail.", StringComparison.Ordinal) => (2, "Email"),
            _ when normalized.StartsWith("api_keys.", StringComparison.Ordinal) || normalized.StartsWith("api-keys.", StringComparison.Ordinal) || normalized.StartsWith("keys.", StringComparison.Ordinal) => (3, "API keys"),
            _ when normalized.StartsWith("ai.", StringComparison.Ordinal) || normalized.StartsWith("llm.", StringComparison.Ordinal) => (4, "AI"),
            _ when normalized.StartsWith("mcp.", StringComparison.Ordinal) => (5, "MCP"),
            _ when normalized.StartsWith("rendering.", StringComparison.Ordinal) || normalized.StartsWith("renderer.", StringComparison.Ordinal) => (6, "Rendering"),
            _ when normalized.StartsWith("footer.", StringComparison.Ordinal) => (7, "Footer"),
            _ when normalized.StartsWith("branding.", StringComparison.Ordinal) || normalized.StartsWith("theme.", StringComparison.Ordinal) || normalized.StartsWith("appearance.", StringComparison.Ordinal) => (8, "Branding"),
            _ when normalized.StartsWith("domains.", StringComparison.Ordinal) || normalized.StartsWith("domain.", StringComparison.Ordinal) || normalized.StartsWith("dns.", StringComparison.Ordinal) => (9, "Domains"),
            _ when normalized.StartsWith("moderation.", StringComparison.Ordinal) || normalized.StartsWith("reporting.", StringComparison.Ordinal) || normalized.StartsWith("reports.", StringComparison.Ordinal) || normalized.StartsWith("abuse.", StringComparison.Ordinal) => (10, "Moderation and reporting"),
            _ when normalized.StartsWith("auth.", StringComparison.Ordinal) || normalized.StartsWith("authentication.", StringComparison.Ordinal) || normalized.StartsWith("oidc.", StringComparison.Ordinal) || normalized.StartsWith("sso.", StringComparison.Ordinal) => (11, "Authentication"),
            _ when normalized.StartsWith("authorization.", StringComparison.Ordinal) || normalized.StartsWith("roles.", StringComparison.Ordinal) || normalized.StartsWith("permissions.", StringComparison.Ordinal) || normalized.StartsWith("rbac.", StringComparison.Ordinal) || normalized.StartsWith("cerbos.", StringComparison.Ordinal) => (12, "Authorization"),
            _ when normalized.StartsWith("onboarding.", StringComparison.Ordinal) || normalized.StartsWith("defaults.", StringComparison.Ordinal) || normalized.StartsWith("tenant_defaults.", StringComparison.Ordinal) => (13, "Onboarding defaults"),
            _ => (99, "Other settings")
        };
    }

    private static string FormatSettingsText(IReadOnlyList<ControlPlaneTenantPlanSetting> settings) =>
        string.Join(
            Environment.NewLine + Environment.NewLine,
            GroupSettingsByProductDomain(settings).Select(group => string.Join(
                Environment.NewLine,
                new[] { $"# {group.Label}" }.Concat(group.Settings.Select(setting => $"{setting.Key}|{setting.JsonValue}|{setting.IsLocked}")))));

    private sealed record PlanSettingGroup(string Label, IReadOnlyList<ControlPlaneTenantPlanSetting> Settings);

    private sealed class DraftEditorState
    {
        private DraftEditorState(Guid versionId, string key)
        {
            VersionId = versionId;
            Key = key;
        }

        public Guid VersionId { get; }

        public string Key { get; }

        public string Name { get; set; } = string.Empty;

        public string PriceAmount { get; set; } = "0";

        public string CurrencyCode { get; set; } = "EUR";

        public string BillingPeriod { get; set; } = "monthly";

        public bool IsActiveForProvisioning { get; set; }

        public string SettingsText { get; set; } = string.Empty;

        public string QuotasText { get; set; } = string.Empty;

        public static DraftEditorState From(ControlPlaneTenantPlanDetail detail, ControlPlaneTenantPlanVersion version) =>
            new(version.Id, detail.Key)
            {
                Name = detail.DisplayName,
                PriceAmount = version.PriceAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
                CurrencyCode = version.CurrencyCode,
                BillingPeriod = version.BillingPeriod,
                IsActiveForProvisioning = version.IsActiveForProvisioning,
                SettingsText = FormatSettingsText(version.Settings),
                QuotasText = string.Join(Environment.NewLine, version.Quotas.Select(quota => $"{quota.Key}|{quota.Limit}"))
            };

        public bool TryBuildDraft(out ControlPlaneTenantPlanDraft draft, out IReadOnlyList<string> errors)
        {
            var localErrors = new List<string>();

            if (!decimal.TryParse(PriceAmount, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var priceAmount))
            {
                localErrors.Add("Price amount must be a decimal number, for example 49.99.");
            }

            var settings = ParseSettings(localErrors);
            var quotas = ParseQuotas(localErrors);

            draft = new ControlPlaneTenantPlanDraft(
                Key.Trim(),
                Name.Trim(),
                new ControlPlaneTenantPlanPricing(priceAmount, CurrencyCode.Trim().ToUpperInvariant(), BillingPeriod.Trim()),
                IsActiveForProvisioning,
                settings,
                quotas);

            errors = localErrors;
            return localErrors.Count == 0;
        }

        private IReadOnlyList<ControlPlaneTenantPlanSettingOverride> ParseSettings(List<string> errors)
        {
            var settings = new List<ControlPlaneTenantPlanSettingOverride>();

            foreach (var line in ReadMeaningfulLines(SettingsText))
            {
                var parts = line.Value.Split('|', 3);
                if (parts.Length < 2 || string.IsNullOrWhiteSpace(parts[0]) || string.IsNullOrWhiteSpace(parts[1]))
                {
                    errors.Add($"Setting line {line.Number} must be key|json value|locked.");
                    continue;
                }

                if (parts.Length == 3 && !TryParseBoolean(parts[2], out var locked))
                {
                    errors.Add($"Setting line {line.Number} locked value must be true or false.");
                    continue;
                }

                settings.Add(new ControlPlaneTenantPlanSettingOverride(
                    parts[0].Trim(),
                    parts[1].Trim(),
                    parts.Length == 3 && TryParseBoolean(parts[2], out locked) && locked));
            }

            return settings;
        }

        private IReadOnlyList<ControlPlaneTenantPlanQuotaLimit> ParseQuotas(List<string> errors)
        {
            var quotas = new List<ControlPlaneTenantPlanQuotaLimit>();

            foreach (var line in ReadMeaningfulLines(QuotasText))
            {
                var parts = line.Value.Split('|', 2);
                if (parts.Length != 2 || string.IsNullOrWhiteSpace(parts[0]) || !long.TryParse(parts[1], out var limit))
                {
                    errors.Add($"Quota line {line.Number} must be key|whole-number limit.");
                    continue;
                }

                quotas.Add(new ControlPlaneTenantPlanQuotaLimit(parts[0].Trim(), limit));
            }

            return quotas;
        }

        private static IEnumerable<(int Number, string Value)> ReadMeaningfulLines(string text) =>
            text.Split('\n')
                .Select((line, index) => (Number: index + 1, Value: line.Trim()))
                .Where(line => line.Value.Length > 0 && !line.Value.StartsWith('#'));

        private static bool TryParseBoolean(string value, out bool result)
        {
            var normalized = value.Trim();
            if (bool.TryParse(normalized, out result))
            {
                return true;
            }

            result = normalized.Equals("1", StringComparison.OrdinalIgnoreCase)
                || normalized.Equals("yes", StringComparison.OrdinalIgnoreCase);

            return result
                || normalized.Equals("0", StringComparison.OrdinalIgnoreCase)
                || normalized.Equals("no", StringComparison.OrdinalIgnoreCase);
        }
    }
}
