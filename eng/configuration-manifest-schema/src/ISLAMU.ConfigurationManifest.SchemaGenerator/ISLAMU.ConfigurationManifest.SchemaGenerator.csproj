<!-- ABOUTME: Defines the deterministic ConfigurationManifest JSON Schema generator executable. -->
<!-- ABOUTME: References Application contracts only and adds no third-party runtime dependency. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/Explore.Application/Explore.Application.csproj" />
  </ItemGroup>
</Project>
