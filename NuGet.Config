<!-- ABOUTME: Adds the audited repository-local package feed while preserving nuget.org for public dependencies. -->
<!-- ABOUTME: Maps the exact ISLAMU Terminal.Gui identity to the internal feed to prevent dependency confusion. -->
<configuration>
  <packageSources>
    <clear />
    <add key="islamu-terminal-gui" value="eng/release/dependencies/terminal-gui/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="islamu-terminal-gui">
      <package pattern="ISLAMU.Terminal.Gui" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
