{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/stryker-config.schema.json",
  "stryker-config": {
    "test-runner": "mtp",
    "thresholds": {
      "high": 90,
      "low": 86,
      "break": 86
    },
    "reporters": [
      "json"
    ],
    "mutate": [
      "**/FairReturnWaitlist.cs{8112..10770}",
      "**/FairReturnWaitlist.cs{17874..20571}",
      "**/FairReturnWaitlist.cs{24942..26695}",
      "**/FairReturnWaitlist.cs{29959..31497}"
    ],
    "ignore-mutations": [
      "string"
    ],
    "ignore-mutations": [
      "string.IsNullOrEmpty",
      "string.IsNullOrWhiteSpace"
    ],
    "coverage-analysis": "perTest",
    "disable-bail": false,
    "concurrency": 4
  }
}
