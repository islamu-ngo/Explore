<!-- ABOUTME: E2E browser test project configuration using TUnit, Playwright, and Aspire testing. -->
<!-- ABOUTME: Targets net10.0 and loads the separately built AppHost without a project reference. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <BuildE2EAppHost Condition="'$(BuildE2EAppHost)' == ''">true</BuildE2EAppHost>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- MessagePack explicit override: forces patched 2.5.301 over transitive 2.5.192 (GHSA-hv8m-jj95-wg3x via KubernetesClient) -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Explore.Blazor.Client\Explore.Blazor.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\docker\keycloak\ISLAMU-realm.test.json" Link="TestAssets\ISLAMU-realm.test.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="BuildE2EAppHost" BeforeTargets="Build" Condition="'$(BuildE2EAppHost)' == 'true'">
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\..\..\src\Explore.AppHost\Explore.AppHost.csproj&quot; --configuration $(Configuration) --verbosity quiet" />
  </Target>
</Project>
