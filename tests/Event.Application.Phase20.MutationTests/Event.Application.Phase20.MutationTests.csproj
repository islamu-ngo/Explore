<!-- ABOUTME: Dedicated fast mutation lane for Phase 20 admission authority orchestration. -->
<!-- ABOUTME: Links behavioral tests without inheriting unrelated shared-worktree test failures. -->
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Compile Include="..\Event.Application.UnitTests\Contracts\Admissions\AdmissionIssuanceOrchestrationRedTests.cs"
             Link="Contracts\Admissions\AdmissionIssuanceOrchestrationRedTests.cs" />
    <Compile Include="..\Event.Application.UnitTests\Contracts\Admissions\AdmissionRevocationOrchestrationRedTests.cs"
             Link="Contracts\Admissions\AdmissionRevocationOrchestrationRedTests.cs" />
    <Compile Include="..\Event.Application.UnitTests\Contracts\Admissions\Support\*.cs"
             Link="Contracts\Admissions\Support\%(Filename)%(Extension)" />
    <Compile Include="..\Event.Application.UnitTests\Services\Registration\AdmissionEventCancellationServiceTests.cs"
             Link="Services\Registration\AdmissionEventCancellationServiceTests.cs" />
    <Compile Include="..\Event.Application.UnitTests\Services\Registration\AdmissionRefundRevocationServiceTests.cs"
             Link="Services\Registration\AdmissionRefundRevocationServiceTests.cs" />
    <Compile Include="..\Event.Application.UnitTests\Services\Registration\RefundTestAcceptance.cs"
             Link="Services\Registration\RefundTestAcceptance.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Explore.Application\Explore.Application.csproj" />
    <ProjectReference Include="..\..\src\Explore.Domain\Explore.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

</Project>
