{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/stryker-config.schema.json",
  "stryker-config": {
    "test-runner": "mtp",
    "thresholds": {
      "high": 90,
      "low": 86,
      "break": 86
    },
    "reporters": [
      "json"
    ],
    "mutate": [
      "**/EventAddOnCatalogVersion.cs",
      "**/EventAddOnCatalogItem.cs",
      "**/RegistrationOrderAddOnLine.cs",
      "**/EventAddOnInventoryAllocation.cs",
      "**/EventAddOnFulfillment.cs",
      "**/EventAddOnRefundAllocation.cs",
      "**/EventAddOnResults.cs"
    ],
    "ignore-mutations": [
      "string",
      "string.IsNullOrEmpty",
      "string.IsNullOrWhiteSpace"
    ],
    "coverage-analysis": "perTest",
    "disable-bail": false,
    "concurrency": 4
  }
}
