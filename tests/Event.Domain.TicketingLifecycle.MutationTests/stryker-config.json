{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/stryker-config.schema.json",
  "stryker-config": {
    "test-runner": "mtp",
    "thresholds": {
      "high": 90,
      "low": 86,
      "break": 86
    },
    "reporters": [
      "json"
    ],
    "mutate": [
      "**/AdmissionTicketTransfer.cs",
      "**/AdmissionTicket.cs{30..30}{42..42}{69..79}{137..137}{190..224}"
    ],
    "ignore-mutations": [
      "string.IsNullOrEmpty",
      "string.IsNullOrWhiteSpace"
    ],
    "coverage-analysis": "perTest",
    "disable-bail": false,
    "concurrency": 4
  }
}
