# ABOUTME: Example environment file for Docker Compose and local self-hosting.
# ABOUTME: Documents Infisical-equivalent secret paths, consumers, defaults, and required values.

# =============================================================================
# Compose runtime
# Consumed by: Docker Compose only.
# Optional. Recommended: keep defaults unless ports conflict on your machine.
# =============================================================================
API_HTTP_PORT=7039
UI_HTTP_PORT=7002
KEYCLOAK_HTTP_PORT=8080
MINIO_API_PORT=9005
MINIO_CONSOLE_PORT=9006
CERBOS_HTTP_PORT=3592
CERBOS_GRPC_PORT=3593
SVIX_HTTP_PORT=8071
COOP_HTTP_PORT=8082
OSPREY_HTTP_PORT=5004

# =============================================================================
# Secret provider bootstrap
# Consumed by: API, Blazor, Event.MigrationService.
# Optional for full local Compose. Required only when this run should load Infisical.
#
# Recommended local-full value:
#   SECRET_PROVIDER=None
#   leave INFISICAL_* blank
#
# To use Infisical, set SECRET_PROVIDER=Infisical and fill INFISICAL_*.
# Important: non-empty INFISICAL_* also enables the raw Infisical configuration
# loaders, so /postgresql can outrank local POSTGRESQL_* values.
# =============================================================================
SECRET_PROVIDER=None
INFISICAL_URL=
INFISICAL_PROJECT_ID=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_ENV=dev

# =============================================================================
# /postgresql
# Consumed by: postgres container, API, Blazor, Event.MigrationService.
# Required when local Postgres is used. These disposable values work for the
# first local Compose run and match the Compose defaults.
# =============================================================================
POSTGRESQL_HOST=postgres
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=explore
POSTGRESQL_USERNAME=explore
POSTGRESQL_PASSWORD=explore

# =============================================================================
# /keycloak
# Consumed by: keycloak, keycloak-init, API, Blazor.
# KEYCLOAK_REALM and KEYCLOAK_ENDPOINT are required.
# KEYCLOAK_BLAZOR_CLIENT_SECRET is required for Compose. The value below is the
# checked-in local realm export default and is suitable only for disposable dev.
# KEYCLOAK_API_CLIENT_SECRET is optional for current bearer-token validation.
# =============================================================================
KEYCLOAK_REALM=ISLAMU
KEYCLOAK_ENDPOINT=http://keycloak.localhost:8080
KEYCLOAK_BLAZOR_CLIENT_SECRET=islamu-event-blazor-secret
KEYCLOAK_API_CLIENT_SECRET=islamu-event-api-secret
KEYCLOAK_INIT_ALLOW_DEFAULT_LOCAL_SECRET=false

# Local Keycloak admin and backing DB. Consumed only by local Keycloak containers.
# Required for local Keycloak. Replace all defaults outside throwaway dev.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_REQUIRE_HTTPS_METADATA=false

# =============================================================================
# /api
# Consumed by: API.
# SETUP_SECRET is optional; if blank, API generates a temporary setup secret.
# LuckyPenny values are optional and should stay disabled unless commercial
# AutoMapper/MediatR packages are intentionally used.
# =============================================================================
SETUP_SECRET=
SETUP_SECRET_REQUIRED=true
DEPLOYMENT_MODE=
USE_COMMERCIAL_LUCKYPENNY=false
LUCKYPENNY_LICENSE_KEY=
AUTOMAPPER_COMMERCIAL_VERSION=false
MEDIATR_COMMERCIAL_VERSION=false

# =============================================================================
# /blazor
# Consumed by: Blazor only.
# Optional in Compose because the service defaults to the internal API URL.
# Override only when Blazor should call a different API host.
# =============================================================================
API_ENDPOINT=http://islamu-event-api:8080/

# =============================================================================
# /cerbos
# Consumed by: API and optional authz profile services.
# Optional unless the authz profile or Cerbos provider is enabled.
# The local Admin API password is "cerbos"; the hash below is its base64 bcrypt
# representation. Replace both values together for any shared or hosted stack.
# CERBOS_ADMIN_PASSWORD_HASH is for the Cerbos server.
# CERBOS_ADMIN_PASSWORD is plaintext and needed only for cerbos-policy-sync/API
# Admin API publishing. Do not commit a real production value.
# =============================================================================
CERBOS_GRPC_ENDPOINT=http://cerbos:3593
CERBOS_HTTP_ENDPOINT=http://cerbos:3592
CERBOS_USE_TLS=false
CERBOS_PLAINTEXT_MODE=true
CERBOS_ADMIN_USERNAME=cerbos
CERBOS_ADMIN_PASSWORD_HASH=JDJiJDEwJGxUWWVjblZpTlRseTZvUkhQS3Y5U2VKZGpwZzdqWkFRcGV2S2Ezbkxpbk55bDF5U1dEZVkyCg==
CERBOS_ADMIN_PASSWORD=cerbos
CERBOS_PG_URL=postgres://cerbos_user:cerbos_password@cerbos-db:5432/cerbos?search_path=cerbos&sslmode=disable
CERBOS_POSTGRES_USER=cerbos_user
CERBOS_POSTGRES_PASSWORD=cerbos_password
CERBOS_POSTGRES_DB=cerbos

# =============================================================================
# /storage
# Consumed by: API and optional storage profile services.
# Optional because local file storage works without MinIO/S3.
# Recommended local MinIO values are below. Replace for real S3-compatible infra.
# =============================================================================
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_PUBLIC_ENDPOINT=http://minio.localhost:9005
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET_NAME=explore
STORAGE_S3_ACCESS_KEY_ID=minioadmin
STORAGE_S3_SECRET_ACCESS_KEY=minioadmin
LOCAL_STORAGE_ROOT_PATH=/app/storage-data/local
LOCAL_STORAGE_CREATE_ROOT_IF_MISSING=true
STORAGE_RECONCILIATION_ENABLED=true
STORAGE_RECONCILIATION_DRY_RUN=true
STORAGE_RECONCILIATION_QUARANTINE_MISSING_OBJECTS=false
STORAGE_RECONCILIATION_QUARANTINE_ORPHAN_LOCAL_FILES=false
STORAGE_RECONCILIATION_DELETE_QUARANTINED_OBJECTS=false

# =============================================================================
# /ai
# Consumed by: API.
# Optional. Recommended default is AI_PROVIDER=none.
# Uncomment/fill endpoint, model, and key only when enabling a real provider.
# AI_TOOL_PROPOSALS_ENABLED defaults false unless proposal tooling is intended.
# =============================================================================
AI_PROVIDER=none
AI_ENDPOINT=
AI_MODEL_ID=
AI_API_KEY=
AI_TOOL_PROPOSALS_ENABLED=false

# =============================================================================
# /mcp
# Consumed by: API.
# Optional. Defaults match the API's stateless Streamable HTTP MCP adapter.
# Set MCP_ENABLED=false only when the endpoint must be unmapped at startup.
# =============================================================================
MCP_ENABLED=true
MCP_ENDPOINT_PATH=/mcp
MCP_STATELESS=true
MCP_ENABLE_LEGACY_SSE=true

# =============================================================================
# /smtp
# Consumed by: API email sending through instance/tenant SMTP settings.
# Optional until registration/email workflows need outbound mail.
# These names mirror Infisical. Current SMTP runtime resolution is settings-first,
# so env values are useful as secret-binding/source values, not a full SMTP setup
# by themselves.
# =============================================================================
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_ENCRYPTION=starttls
MAIL_SMTP_FROM_ADDRESS=

# =============================================================================
# Optional outgoing webhook provider: Svix
# Consumed by: API and optional webhooks profile services.
# Optional. Keep WEBHOOKS_PROVIDER=Local unless you enable the webhooks profile
# and want the API to use Svix. WEBHOOKS_SVIX_AUTH_TOKEN is required for Svix.
# =============================================================================
WEBHOOKS_ENABLED=true
WEBHOOKS_PROVIDER=Local
WEBHOOKS_SVIX_BASE_URL=http://svix:8071
WEBHOOKS_SVIX_AUTH_TOKEN_SECRET_REF=webhooks.svix_auth_token
WEBHOOKS_SVIX_AUTH_TOKEN=
SVIX_TAG=latest
SVIX_DB_DATABASE=postgres
SVIX_DB_USERNAME=postgres
SVIX_DB_PASSWORD=postgres
SVIX_DB_DSN=postgresql://postgres:postgres@svix-db:5432/postgres
SVIX_REDIS_DSN=redis://redis:6379
SVIX_QUEUE_TYPE=redis
SVIX_JWT_SECRET=local-dev-svix-jwt-secret-change-me

# =============================================================================
# Optional moderation providers: Coop and Osprey
# Consumed by: API and optional moderation profile services.
# Optional. Keep REPORTING_MODE=LocalOnly until real provider containers or
# external endpoints are configured. Docker Compose starts Coop with the
# moderation profile. Osprey is a separate opt-in profile because the example
# image may require registry access or replacement with a verified image.
# =============================================================================
REPORTING_ENABLED=true
REPORTING_MODE=LocalOnly
REPORTING_SYNC_REPORTS=true
REPORTING_EVALUATE_SIGNALS=false
REPORTING_MIRROR_REVIEW_QUEUE=false
REPORTING_EXECUTE_DECISIONS=true
REPORTING_OSPREY_ENABLED=false
REPORTING_OSPREY_ENDPOINT_URL=http://osprey:5004
REPORTING_OSPREY_API_KEY=
REPORTING_OSPREY_ALLOW_LOCAL_PROVIDER_ENDPOINTS=true
REPORTING_COOP_ENABLED=false
REPORTING_COOP_ENDPOINT_URL=http://coop:8080
REPORTING_COOP_API_KEY=
REPORTING_COOP_ALLOW_LOCAL_PROVIDER_ENDPOINTS=true
REPORTING_COOP_WEBHOOK_SECRET=local-dev-coop-webhook-secret
COOP_IMAGE=ghcr.io/roostorg/coop-server:latest
COOP_NODE_ENV=development
OSPREY_IMAGE=ghcr.io/roostorg/osprey:latest
OSPREY_DEBUG=true
OSPREY_FLASK_DEBUG=1
OSPREY_FLASK_ENV=development
