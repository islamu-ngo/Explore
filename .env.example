# ABOUTME: Example environment file for Docker Compose and local self-hosting.
# ABOUTME: Documents Infisical-equivalent secret paths, consumers, defaults, and required values.

# =============================================================================
# Compose runtime
# Consumed by: Docker Compose only.
# Optional. Recommended: keep defaults unless ports conflict on your machine.
# Env-only/startup-only. These port bindings are not changed from instance
# administration settings because Docker must recreate/rebind containers.
# =============================================================================
API_HTTP_PORT=7039
UI_HTTP_PORT=7002
KEYCLOAK_HTTP_PORT=8080
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MINIO_API_PORT=9005
MINIO_CONSOLE_PORT=9006
CERBOS_HTTP_PORT=3592
CERBOS_GRPC_PORT=3593
SVIX_HTTP_PORT=8071
WEBLATE_HTTP_PORT=8083
COOP_HTTP_PORT=8082
COOP_CLIENT_HTTP_PORT=3001
OSPREY_BIDI_STREAM_PORT=19950
OSPREY_SYNC_ACTION_PORT=19951
MAILPIT_TAG=latest
MAILPIT_MAX_MESSAGES=5000

# =============================================================================
# Secret provider bootstrap
# Consumed by: API, Blazor, Event.MigrationService.
# Optional for full local Compose. Required only when this run should load Infisical.
# Env-only/startup-only. Instance administration cannot bootstrap Infisical
# because the app must know this before it can start.
#
# Recommended local-full value:
#   SECRET_PROVIDER=None
#   leave INFISICAL_* blank
#
# To use Infisical, set SECRET_PROVIDER=Infisical and fill INFISICAL_*.
# Important: non-empty INFISICAL_* also enables the raw Infisical configuration
# loaders, so /postgresql can outrank local POSTGRESQL_* values.
# =============================================================================
SECRET_PROVIDER=None
INFISICAL_URL=
INFISICAL_PROJECT_ID=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_ENV=dev

# =============================================================================
# /postgresql
# Consumed by: postgres container, API, Blazor, Event.MigrationService.
# Required when local Postgres is used. These disposable values work for the
# first local Compose run and match the Compose defaults.
# Env-only/startup-only. Database connection ownership must be chosen before
# migrations, API startup, and Blazor startup.
# =============================================================================
POSTGRESQL_HOST=postgres
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=islamu_event_db
POSTGRESQL_USERNAME=explore
POSTGRESQL_PASSWORD=explore

# =============================================================================
# /keycloak
# Consumed by: keycloak, keycloak-init, API, Blazor.
# KEYCLOAK_REALM and KEYCLOAK_ENDPOINT are required.
# KEYCLOAK_BLAZOR_CLIENT_SECRET is required for Compose and has no checked-in
# fallback. Generate a local value with: openssl rand -hex 32
# KEYCLOAK_API_CLIENT_SECRET is optional for current bearer-token validation.
# Runtime-admin configurable: the application can store/update runtime OIDC
# authority, realm/client settings, and client secret during onboarding and
# instance administration. Env values here are local bootstrap/defaults.
# =============================================================================
KEYCLOAK_REALM=ISLAMU
KEYCLOAK_ENDPOINT=http://keycloak.localhost:8080
KEYCLOAK_BLAZOR_CLIENT_ID=islamu-event-blazor
KEYCLOAK_BLAZOR_CLIENT_SECRET=
KEYCLOAK_API_CLIENT_SECRET=

# Optional exact client callback/origin overrides for a reverse-proxied host.
# Blank values use the repository's exact Compose/Aspire localhost defaults.
# Redirects/web origins are JSON arrays; logout redirects use Keycloak's ## separator.
KEYCLOAK_BLAZOR_REDIRECT_URIS=
KEYCLOAK_BLAZOR_WEB_ORIGINS=
KEYCLOAK_BLAZOR_LOGOUT_REDIRECT_URIS=

# Keycloak realm SMTP bootstrap. Consumed only by keycloak-init.
# Local Compose defaults below route Keycloak registration/reset emails to Mailpit.
# For self-hosting, replace these with real SMTP values or inject equivalent
# environment variables from your secret manager. Leave KEYCLOAK_SMTP_HOST blank
# to keep an existing realm SMTP configuration unchanged.
KEYCLOAK_SMTP_HOST=mailpit
KEYCLOAK_SMTP_PORT=1025
KEYCLOAK_SMTP_FROM=noreply@openislamu.org
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=ISLAMU Event Dev
KEYCLOAK_SMTP_AUTH=false
KEYCLOAK_SMTP_SSL=false
KEYCLOAK_SMTP_STARTTLS=false
KEYCLOAK_SMTP_REPLY_TO=
KEYCLOAK_SMTP_REPLY_TO_DISPLAY_NAME=
KEYCLOAK_SMTP_ENVELOPE_FROM=
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=

# Local Keycloak admin and backing DB. Consumed only by local Keycloak containers.
# Required for local Keycloak. Replace all defaults outside throwaway dev.
# Env-only/startup-only. These are container bootstrap credentials and are not
# stored in ISLAMU runtime settings.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_REQUIRE_HTTPS_METADATA=false

# =============================================================================
# /api
# Consumed by: API.
# SETUP_SECRET is env-only/startup-only. If blank, API generates a temporary
# setup secret and writes it to API startup logs; copy it from the logs to enter
# setup. Set a fixed local value when you do not want to look in logs.
# LuckyPenny values are optional and should stay disabled unless commercial
# AutoMapper/MediatR packages are intentionally used.
# DEPLOYMENT_MODE is startup/bootstrap configuration. It is not a runtime admin
# setting because it affects tenancy and setup behavior.
# =============================================================================
SETUP_SECRET=
SETUP_SECRET_REQUIRED=true
DEPLOYMENT_MODE=
USE_COMMERCIAL_LUCKYPENNY=false
LUCKYPENNY_LICENSE_KEY=
AUTOMAPPER_COMMERCIAL_VERSION=false
MEDIATR_COMMERCIAL_VERSION=false

# =============================================================================
# /blazor
# Consumed by: Blazor only.
# Optional in Compose because the service defaults to the internal API URL.
# Override only when Blazor should call a different API host.
# Env-only/startup-only. API_ENDPOINT is a Blazor BFF wiring value; it is not
# an API secret and only the Blazor service needs it.
# CONTROL_PLANE_PUBLIC_ORIGIN is the integrated Explore.Blazor admin hostname;
# it configures exact-host admin-shell routing and API-reported admin links.
# =============================================================================
API_ENDPOINT=http://islamu-event-api:8080/
CONTROL_PLANE_PUBLIC_ORIGIN=http://admin.localhost:7002

# =============================================================================
# /cerbos
# Consumed by: API and optional authz profile services.
# Optional unless the authz profile or Cerbos provider is enabled.
# Runtime-admin configurable: instance onboarding, instance administration, and
# tenant authorization-provider settings can store Cerbos PDP/Admin API endpoints
# and Admin API credentials. Env values here bootstrap local infrastructure or
# deployment-managed secrets. Bare external host:port values are accepted by the
# app and normalized to https://; keep explicit http:// for local plaintext
# Compose endpoints.
# The local Admin API password is "cerbos"; the hash below is its base64 bcrypt
# representation. Replace both values together for any shared or hosted stack.
# CERBOS_ADMIN_PASSWORD_HASH is env-only/startup-only for the Cerbos server.
# CERBOS_ADMIN_PASSWORD is plaintext and needed only for cerbos-policy-sync/API
# Admin API publishing. Do not commit a real production value.
# =============================================================================
# Blank = choose during onboarding; local/cerbos = deployment-owned and skip the choice page.
AUTHORIZATION_PROVIDER=
CERBOS_GRPC_ENDPOINT=http://cerbos:3593
CERBOS_HTTP_ENDPOINT=http://cerbos:3592
CERBOS_USE_TLS=false
CERBOS_PLAINTEXT_MODE=true
CERBOS_ADMIN_USERNAME=cerbos
CERBOS_ADMIN_PASSWORD_HASH=JDJiJDEwJGxUWWVjblZpTlRseTZvUkhQS3Y5U2VKZGpwZzdqWkFRcGV2S2Ezbkxpbk55bDF5U1dEZVkyCg==
CERBOS_ADMIN_PASSWORD=cerbos
CERBOS_PG_URL=postgres://cerbos_user:cerbos_password@cerbos-db:5432/cerbos?search_path=cerbos&sslmode=disable
CERBOS_POSTGRES_USER=cerbos_user
CERBOS_POSTGRES_PASSWORD=cerbos_password
CERBOS_POSTGRES_DB=cerbos

# =============================================================================
# /storage
# Consumed by: API and optional storage profile services.
# Optional because local file storage works without MinIO/S3.
# Recommended local MinIO values are below. Replace for real S3-compatible infra.
# Runtime-admin configurable: storage provider/bucket/endpoint/access-key values
# can be managed from application settings where the deployment allows it.
# Env values are still useful as local defaults and deployment-managed secrets.
# LOCAL_STORAGE_* is startup-only for the container filesystem provider.
# =============================================================================
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_PUBLIC_ENDPOINT=http://minio.localhost:9005
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET_NAME=explore
STORAGE_S3_ACCESS_KEY_ID=minioadmin
STORAGE_S3_SECRET_ACCESS_KEY=minioadmin
LOCAL_STORAGE_ROOT_PATH=/app/storage-data/local
LOCAL_STORAGE_CREATE_ROOT_IF_MISSING=true
STORAGE_RECONCILIATION_ENABLED=true
STORAGE_RECONCILIATION_DRY_RUN=true
STORAGE_RECONCILIATION_QUARANTINE_MISSING_OBJECTS=false
STORAGE_RECONCILIATION_QUARANTINE_ORPHAN_LOCAL_FILES=false
STORAGE_RECONCILIATION_DELETE_QUARANTINED_OBJECTS=false

# =============================================================================
# /ai
# Consumed by: API.
# Optional. Recommended default is AI_PROVIDER=none.
# Uncomment/fill endpoint, model, and key only when enabling a real provider.
# AI_TOOL_PROPOSALS_ENABLED defaults false unless proposal tooling is intended.
# Runtime-admin configurable: AI provider/model/endpoint/key and proposal
# governance can be managed in instance administration. Env values are bootstrap
# defaults or deployment-managed secrets.
# =============================================================================
AI_PROVIDER=none
AI_ENDPOINT=
AI_MODEL_ID=
AI_API_KEY=
AI_TOOL_PROPOSALS_ENABLED=false

# =============================================================================
# /mcp
# Consumed by: API.
# Optional. Defaults match the API's stateless Streamable HTTP MCP adapter.
# Set MCP_ENABLED=false only when the endpoint must be unmapped at startup.
# Runtime-admin configurable: mcp.enabled can disable runtime behavior after
# startup. Startup mapping values such as MCP_ENDPOINT_PATH and transport ceilings
# are env-only because endpoint shape is decided at application startup.
# =============================================================================
MCP_ENABLED=true
MCP_ENDPOINT_PATH=/mcp
MCP_STATELESS=true
MCP_ENABLE_LEGACY_SSE=true

# =============================================================================
# /smtp
# Consumed by: API email sending through instance/tenant SMTP settings.
# Optional until registration/email workflows need outbound mail. The defaults
# below target the local Mailpit container started by Aspire and Compose.
# These names mirror Infisical. Current SMTP runtime resolution is settings-first,
# so env values are useful as secret-binding/source values, not a full SMTP setup
# by themselves.
# Runtime-admin configurable: SMTP host/port/encryption/from/credentials are
# settings-first and can be stored through instance/tenant administration where
# deployment policy allows it.
# =============================================================================
MAIL_SMTP_HOST=mailpit
MAIL_SMTP_PORT=1025
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_ENCRYPTION=None
MAIL_SMTP_FROM_ADDRESS=noreply@localhost
MAIL_SMTP_FROM_NAME=ISLAMU Event Dev

# =============================================================================
# Browser Web Push
# Consumed by: API.
# Disabled until one long-lived VAPID key pair is supplied. The public key is
# returned to browsers; the private key is server-only and must come from a
# deployment secret manager outside disposable local development.
# =============================================================================
WEB_PUSH_ENABLED=false
VAPID_SUBJECT=mailto:admin@yourdomain.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# =============================================================================
# Optional RabbitMQ Dispatch Mode for EmailDispatch pointers
# Consumed by: API.
# Enabled by default for full-stack local development. This is transport only;
# PostgreSQL EmailDispatchOutbox remains the source of truth and Basic Dispatch
# Mode can still be restored by setting EMAIL_DISPATCH_RABBITMQ_ENABLED=false.
# Env-only/startup-only for broker topology and connection values.
# =============================================================================
MESSAGING_URI=
EMAIL_DISPATCH_RABBITMQ_ENABLED=true
EMAIL_DISPATCH_RABBITMQ_CONNECTION_STRING_NAME=messaging
EMAIL_DISPATCH_RABBITMQ_CONNECTION_STRING=
EMAIL_DISPATCH_RABBITMQ_EXCHANGE_NAME=explore.email-dispatch
EMAIL_DISPATCH_RABBITMQ_DISPATCH_QUEUE_NAME=explore.email-dispatch.dispatch
EMAIL_DISPATCH_RABBITMQ_DISPATCH_ROUTING_KEY=email-dispatch.dispatch
EMAIL_DISPATCH_RABBITMQ_DEAD_LETTER_EXCHANGE_NAME=explore.email-dispatch.dlx
EMAIL_DISPATCH_RABBITMQ_DEAD_LETTER_QUEUE_NAME=explore.email-dispatch.dead-letter
EMAIL_DISPATCH_RABBITMQ_DEAD_LETTER_ROUTING_KEY=email-dispatch.dead-letter
EMAIL_DISPATCH_RABBITMQ_PARKING_QUEUE_NAME=explore.email-dispatch.parking
EMAIL_DISPATCH_RABBITMQ_PARKING_ROUTING_KEY=email-dispatch.parking
EMAIL_DISPATCH_RABBITMQ_CLIENT_PROVIDED_NAME=explore-email-dispatch-rabbitmq
EMAIL_DISPATCH_RABBITMQ_CONSUMER_ID=explore-email-dispatch-rabbitmq-consumer
EMAIL_DISPATCH_RABBITMQ_PREFETCH_COUNT=10
EMAIL_DISPATCH_RABBITMQ_DEAD_LETTER_REPLAY_ENABLED=false
EMAIL_DISPATCH_RABBITMQ_DEAD_LETTER_REPLAY_CONSUMER_ID=explore-email-dispatch-dlq-replay
EMAIL_DISPATCH_RABBITMQ_DEAD_LETTER_REPLAY_PREFETCH_COUNT=5
EMAIL_DISPATCH_RABBITMQ_PUBLISH_TIMEOUT_SECONDS=15
EMAIL_DISPATCH_RABBITMQ_PUBLISHER_POLLING_INTERVAL_SECONDS=5
EMAIL_DISPATCH_RABBITMQ_PUBLISHER_BATCH_SIZE=100
EMAIL_DISPATCH_RABBITMQ_PUBLISHER_RETRY_DELAY_SECONDS=30

# =============================================================================
# Optional outgoing webhook provider: Svix
# Consumed by: API and optional webhooks profile services.
# Local delivery is the default and does not provision Svix. WEBHOOKS_SVIX_AUTH_TOKEN
# is required only when WEBHOOKS_PROVIDER is explicitly set to Svix or Composite.
# Runtime-admin configurable: webhook provider selection and provider token can
# be managed in application settings where enabled. SVIX_* container database,
# queue, image tag, and JWT values are env-only/startup-only for local Compose.
# Svix application credentials are intentionally unset until the self-hosted integration is enabled.
# =============================================================================
WEBHOOKS_ENABLED=true
WEBHOOKS_PROVIDER=Local
WEBHOOKS_SVIX_BASE_URL=http://svix:8071
WEBHOOKS_SVIX_ENVIRONMENT=self-hosted
WEBHOOKS_SVIX_PROVIDER_VERSION=1.96.1
WEBHOOKS_SVIX_CAPABILITY_POLICY_VERSION=svix-self-hosted-1.96.1-v1
WEBHOOKS_SVIX_AUTH_TOKEN_SECRET_REF=webhooks.svix.auth_token
WEBHOOKS_SVIX_OPERATIONAL_WEBHOOK_SECRET_REF=webhooks.svix.operational_webhook_secret
WEBHOOKS_SVIX_AUTH_TOKEN=
WEBHOOKS_SVIX_OPERATIONAL_WEBHOOK_SECRET=
SVIX_TAG=v1.96.1
SVIX_DB_DATABASE=postgres
SVIX_DB_USERNAME=postgres
SVIX_DB_PASSWORD=postgres
SVIX_DB_DSN=postgresql://postgres:postgres@svix-db:5432/postgres
SVIX_REDIS_DSN=redis://redis:6379
SVIX_QUEUE_TYPE=redis
SVIX_CACHE_TYPE=redis
SVIX_JWT_SECRET=local-dev-svix-jwt-secret-change-me

# =============================================================================
# Optional localization provider: Weblate
# Consumed by: optional localization profile services.
# WEBLATE_* values are env-only/startup-only container bootstrap values: image,
# public local domain, admin seed account, and backing database credentials.
# Runtime-admin configurable: choose Weblate in localization governance by setting
# localization.tms_provider=weblate, localization.tms_api_url=http://weblate:8080
# inside Compose, plus the Weblate project/component slugs through the admin UI/API.
# =============================================================================
WEBLATE_IMAGE=weblate/weblate:latest
WEBLATE_SITE_DOMAIN=localhost:8083
WEBLATE_ADMIN_NAME=Admin
WEBLATE_ADMIN_EMAIL=admin@openislamu.org
WEBLATE_ADMIN_PASSWORD=admin
WEBLATE_POSTGRES_USER=weblate
WEBLATE_POSTGRES_PASSWORD=weblate_password
WEBLATE_POSTGRES_DB=weblate

# =============================================================================
# Optional moderation providers: Coop and Osprey
# Consumed by: API and optional moderation profile services.
# Full-stack local uses Coop by default for review queue mirroring. Osprey is a
# separate coordinator image below. The coordinator exposes ports 19950/19951;
# it is not the same as the app's HTTP-compatible Reporting:Osprey facade, so
# the Osprey provider remains disabled until a facade or gRPC adapter is added.
# Runtime-admin configurable: reporting/provider enablement, endpoint URLs,
# API keys, and decision/evaluation toggles can be managed in application
# settings. COOP_*, OSPREY_*, and port/image values are env-only/startup-only
# for local provider containers.
# =============================================================================
REPORTING_ENABLED=true
REPORTING_MODE=Coop
REPORTING_SYNC_REPORTS=true
REPORTING_EVALUATE_SIGNALS=false
REPORTING_MIRROR_REVIEW_QUEUE=true
REPORTING_EXECUTE_DECISIONS=true
REPORTING_HEALTH_STUCK_PROVIDER_SYNC_MINUTES=120
REPORTING_HEALTH_FAILED_PROVIDER_SYNC_WARNING_THRESHOLD=1
REPORTING_OSPREY_ENABLED=false
REPORTING_OSPREY_ENDPOINT_URL=
REPORTING_OSPREY_API_KEY=
REPORTING_OSPREY_ALLOW_LOCAL_PROVIDER_ENDPOINTS=true
REPORTING_COOP_ENABLED=true
REPORTING_COOP_ENDPOINT_URL=http://coop:8080
REPORTING_COOP_API_KEY=local-dev-coop-api-key
REPORTING_COOP_ALLOW_LOCAL_PROVIDER_ENDPOINTS=true
REPORTING_COOP_WEBHOOK_SECRET=local-dev-coop-webhook-secret
COOP_IMAGE=ghcr.io/roostorg/coop-server:latest
COOP_MIGRATIONS_IMAGE=ghcr.io/roostorg/coop-migrations:latest
COOP_CLIENT_IMAGE=ghcr.io/roostorg/coop-client:latest
COOP_NODE_ENV=development
COOP_OTEL_SERVICE_NAME=coop
COOP_UI_URL=http://localhost:3001
COOP_SESSION_SECRET=local-dev-coop-session-secret
COOP_DATABASE_USER=coop
COOP_DATABASE_PASSWORD=coop_password
COOP_DATABASE_NAME=coop
COOP_WAREHOUSE_ADAPTER=noop
COOP_ANALYTICS_ADAPTER=noop
COOP_SCYLLA_HOSTS=coop-scylla
COOP_SCYLLA_USERNAME=cassandra
COOP_SCYLLA_PASSWORD=cassandra
COOP_SCYLLA_LOCAL_DATACENTER=datacenter1
COOP_SCYLLA_SSL=false
OSPREY_IMAGE=ghcr.io/roostorg/osprey/osprey-coordinator:latest
OSPREY_RUST_LOG=info
OSPREY_POD_IP=osprey

# /integrations/listmonk — native subscriber sync integration
# Consumed by the API integration sync worker. Instance URL may be either the Listmonk root
# (https://listmonk.example.com) or API root (https://listmonk.example.com/api).
# Local Compose does not start Listmonk, so the integration stays disabled by default.
LISTMONK_ENABLED=false
LISTMONK_INSTANCE_URL=
LISTMONK_DEFAULT_LIST_ID=0
LISTMONK_PRECONFIRM_SUBSCRIPTIONS=true
LISTMONK_SYNC_ON_REGISTRATION=false
LISTMONK_API_USERNAME=
LISTMONK_API_KEY=
# Privacy erasure authority topology: CoLocated or ExternalDatabase.
PRIVACY_ERASURE_AUTHORITY_TOPOLOGY=CoLocated
PRIVACY_ERASURE_AUTHORITY_RUNTIME_CONNECTION_STRING=
PRIVACY_ERASURE_AUTHORITY_MIGRATOR_CONNECTION_STRING=
PRIVACY_ERASURE_AUTHORITY_DB_USERNAME=
PRIVACY_ERASURE_AUTHORITY_DB_PASSWORD=
PRIVACY_ERASURE_AUTHORITY_DB_DATABASE=
