@* ABOUTME: Page wrapper for organization settings with Blazouter route-parameter resolution. *@
@* ABOUTME: Renders the typed organization administration layout for the matched organization UUID. *@

@using MudBlazor
@using Blazouter.Services
@using Microsoft.AspNetCore.Authorization
@using Explore.Blazor.Client.Pages.Admin.Organization.Components
@using Explore.Blazor.Client.Pages.User.Components
@attribute [Authorize]
@rendermode InteractiveServer
@inject RouterStateService RouterState

<PageTitle>Organization Settings</PageTitle>

<SettingsScopeSelector />
<OrganizationAdminSettingsLayout OrganizationId="OrganizationId" />

@code {
    private Guid OrganizationId => Guid.TryParse(
        RouterState.GetParam(nameof(OrganizationId)),
        out var organizationId)
            ? organizationId
            : Guid.Empty;
}
