@* ABOUTME: Standalone tenant admin component for managing footer configuration, social links, and link groups. *@
@* ABOUTME: Follows Navigation.razor CRUD pattern with settings panel, link group table, and nested link management. *@

@using Explore.Blazor.Client.Pages.Admin.Components
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Contracts.Services.Footer
@using Explore.Blazor.Client.Components.Forms
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using System.Text.Json

@inject IFooterAdminService FooterService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="settings-section">
    <!-- Header -->
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Footer Settings</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Customize footer appearance, content, and link groups</MudText>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
    }

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-12">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">Loading footer settings...</MudText>
        </MudStack>
    }
    else
    {
        <!-- General Settings -->
        <MudPaper Elevation="0" Class="pa-6 rounded-lg border-solid border-1 mud-border-lines-default mb-6">
            <MudText Typo="Typo.h6" Class="mb-4">General Settings</MudText>

            <MudStack Spacing="3">
                <MudSwitch T="bool" @bind-Value="_enabled"
                           Color="Color.Primary"
                           Label="Footer Enabled" />

                <MudSelect T="string" @bind-Value="_template"
                           Label="Template"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("standard-3-col")">Standard 3-Column</MudSelectItem>
                    <MudSelectItem Value="@("standard-2-col")">Standard 2-Column</MudSelectItem>
                    <MudSelectItem Value="@("minimal")">Minimal</MudSelectItem>
                    <MudSelectItem Value="@("community")">Community</MudSelectItem>
                </MudSelect>

                <MudSwitch T="bool" @bind-Value="_showDescription"
                           Color="Color.Primary"
                           Label="Show Description" />

                @if (_showDescription)
                {
                    <MudTextField T="string" @bind-Value="_descriptionText"
                                  Label="Description Text"
                                  Lines="3"
                                  Variant="Variant.Outlined"
                                  Placeholder="Brief description shown in the footer" />
                }

                <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="_copyrightText"
                              Label="Copyright Text"
                              Placeholder="e.g., &copy; 2026 My Organization" />

                <MudSwitch T="bool" @bind-Value="_showCookieSettingsLink"
                           Color="Color.Primary"
                           Label="Show Cookie Settings Link" />
            </MudStack>
        </MudPaper>

        <!-- Social Links -->
        <MudPaper Elevation="0" Class="pa-6 rounded-lg border-solid border-1 mud-border-lines-default mb-6">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.h6">Social Links</MudText>
                <MudSwitch T="bool" @bind-Value="_showSocialLinks"
                           Color="Color.Primary"
                           Label="Show Social Links" />
            </MudStack>

            @if (_showSocialLinks)
            {
                @if (_socialLinks.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-4">
                        No social links configured. Add one to get started.
                    </MudAlert>
                }
                else
                {
                    @for (var i = 0; i < _socialLinks.Count; i++)
                    {
                        var index = i;
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
                            <MudSelect T="string" @bind-Value="_socialLinks[index].Platform"
                                       Label="Platform"
                                       Variant="Variant.Outlined"
                                       Style="min-width: 160px;"
                                       AnchorOrigin="Origin.BottomCenter">
                                @foreach (var platform in AvailablePlatforms)
                                {
                                    <MudSelectItem Value="@platform">@CapitalizePlatform(platform)</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="_socialLinks[index].Url"
                                          Label="URL"
                                          Placeholder="https://..." />
                            <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="_socialLinks[index].Label"
                                          Label="Label (optional)"
                                          Placeholder="Display name" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => RemoveSocialLink(index))"
                                           Title="Remove" />
                        </MudStack>
                    }
                }

                <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddSocialLink"
                           Class="mt-2">
                    Add Social Link
                </MudButton>
            }
        </MudPaper>

        <!-- Save Settings Button -->
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-8">
            <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveSettingsAsync"
                       Disabled="_submitState.IsSubmitting"
                       StartIcon="@Icons.Material.Filled.Save">
                @(_submitState.IsSubmitting ? "Saving..." : "Save Settings")
            </MudButton>
        </MudStack>

        <!-- Link Groups -->
        <MudPaper Elevation="0" Class="pa-6 rounded-lg border-solid border-1 mud-border-lines-default mb-6">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.h6">Link Groups</MudText>
                <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateGroupDialog">
                    Create Group
                </MudButton>
            </MudStack>

            @if (_linkGroups.Count == 0)
            {
                <MudAlert Severity="Severity.Info">
                    No link groups yet. Create one to organize footer links.
                </MudAlert>
            }
            else
            {
                <MudTable Items="@_linkGroups" Hover="true" Striped="true" Dense="false">
                    <HeaderContent>
                        <MudTh>Order</MudTh>
                        <MudTh>Title</MudTh>
                        <MudTh>Active</MudTh>
                        <MudTh>Links</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Order">
                            <MudStack Row="true" Spacing="1">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => MoveGroupUp(context))"
                                               Disabled="@IsFirstGroup(context)"
                                               Title="Move up" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => MoveGroupDown(context))"
                                               Disabled="@IsLastGroup(context)"
                                               Title="Move down" />
                                <MudText Typo="Typo.body2">@context.Order</MudText>
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="Title">@context.Title</MudTd>
                        <MudTd DataLabel="Active">
                            <MudChip T="string" Color="@(context.IsActive == true ? Color.Success : Color.Default)"
                                     Size="Size.Small">
                                @(context.IsActive == true ? "Active" : "Inactive")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Links">@context.LinkCount</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudStack Row="true" Spacing="1">
                                <MudIconButton Icon="@Icons.Material.Filled.Link"
                                               Size="Size.Small"
                                               Color="Color.Info"
                                               OnClick="@(() => SelectGroup(context))"
                                               Title="Manage Links" />
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               OnClick="@(() => OpenEditGroupDialog(context))"
                                               Title="Edit" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => DeleteGroup(context))"
                                               Title="Delete" />
                            </MudStack>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>

        <!-- Selected Group Links -->
        @if (_selectedGroup != null)
        {
            <MudPaper Elevation="0" Class="pa-6 rounded-lg border-solid border-1 mud-border-lines-default">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                       OnClick="DeselectGroup"
                                       Title="Back to groups" />
                        <MudText Typo="Typo.h6">Links in &ldquo;@_selectedGroup.Title&rdquo;</MudText>
                    </MudStack>
                    <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateLinkDialog">
                        Add Link
                    </MudButton>
                </MudStack>

                @if (_selectedGroupLinks.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">
                        No links in this group. Add one to get started.
                    </MudAlert>
                }
                else
                {
                    <MudTable Items="@_selectedGroupLinks" Hover="true" Striped="true" Dense="false">
                        <HeaderContent>
                            <MudTh>Order</MudTh>
                            <MudTh>Label</MudTh>
                            <MudTh>URL</MudTh>
                            <MudTh>New Tab</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Order">@context.Order</MudTd>
                            <MudTd DataLabel="Label">@context.Label</MudTd>
                            <MudTd DataLabel="URL">
                                <MudLink Href="@context.Url" Target="_blank">@TruncateUrl(context.Url)</MudLink>
                            </MudTd>
                            <MudTd DataLabel="New Tab">
                                <MudCheckBox T="bool" Value="@(context.OpenInNewTab == true)" Disabled="true" />
                            </MudTd>
                            <MudTd DataLabel="Actions">
                                <MudStack Row="true" Spacing="1">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => OpenEditLinkDialog(context))"
                                                   Title="Edit" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DeleteLink(context))"
                                                   Title="Delete" />
                                </MudStack>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        }
    }
</div>

@code {
    // ── State ─────────────────────────────────────────────────────────────

    private bool _isLoading = true;
    private FormSubmitState _submitState = new();
    private string? _errorMessage;

    // Settings fields
    private bool _enabled;
    private string _template = "standard-3-col";
    private bool _showDescription;
    private string _descriptionText = string.Empty;
    private string _copyrightText = string.Empty;
    private bool _showCookieSettingsLink;
    private bool _showSocialLinks;
    private List<FooterSocialLinkDto> _socialLinks = new();

    // Link groups
    private List<FooterLinkGroupListDto> _linkGroups = new();

    // Selected group for link management
    private FooterLinkGroupDetailsDto? _selectedGroup;
    private List<FooterLinkItemDto> _selectedGroupLinks = new();

    // ── Available Platforms ───────────────────────────────────────────────

    private static readonly string[] AvailablePlatforms =
    {
        "facebook", "twitter", "instagram", "linkedin", "youtube",
        "tiktok", "bluesky", "whatsapp", "telegram", "github"
    };

    // ── Lifecycle ─────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var settingsTask = FooterService.GetFooterSettingsAsync();
            var groupsTask = FooterService.GetLinkGroupsAsync();

            await Task.WhenAll(settingsTask, groupsTask);

            var settings = settingsTask.Result;
            if (settings != null)
            {
                _enabled = settings.Enabled == true;
                _template = settings.Template ?? "standard-3-col";
                _showDescription = settings.ShowDescription == true;
                _descriptionText = settings.DescriptionText ?? string.Empty;
                _copyrightText = settings.CopyrightText ?? string.Empty;
                _showCookieSettingsLink = settings.ShowCookieSettingsLink == true;
                _showSocialLinks = settings.ShowSocialLinks == true;
                _socialLinks = (settings.SocialLinks ?? [])
                    .Select(s => new FooterSocialLinkDto
                    {
                        Platform = s.Platform ?? "facebook",
                        Url = s.Url ?? string.Empty,
                        Label = s.Label ?? string.Empty
                    })
                    .ToList();
            }

            _linkGroups = groupsTask.Result.OrderBy(g => g.Order).ToList();
        }
        catch (Exception)
        {
            _errorMessage = "Failed to load footer settings.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ── Settings Save ─────────────────────────────────────────────────────

    private async Task SaveSettingsAsync()
    {
        _submitState.Start();
        _errorMessage = null;

        try
        {
            var socialLinksJson = JsonSerializer.Serialize(
                _socialLinks.Select(s => new { platform = s.Platform, url = s.Url, label = s.Label }),
                new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });

            var model = new UpdateTenantFooterSettingsRequest
            {
                Enabled = _enabled,
                Template = _template,
                ShowDescription = _showDescription,
                DescriptionText = _descriptionText,
                ShowSocialLinks = _showSocialLinks,
                SocialLinksJson = socialLinksJson,
                CopyrightText = _copyrightText,
                ShowCookieSettingsLink = _showCookieSettingsLink
            };

            var response = await FooterService.UpdateTenantSettingsAsync(model);
            if (response?.Success == true)
            {
                Snackbar.Add("Footer settings saved.", Severity.Success);
            }
            else
            {
                _errorMessage = response?.Message ?? "Failed to save footer settings.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "An error occurred while saving footer settings.";
        }
        finally
        {
            _submitState.Complete();
        }
    }

    // ── Social Links ──────────────────────────────────────────────────────

    private void AddSocialLink()
    {
        _socialLinks.Add(new FooterSocialLinkDto
        {
            Platform = "facebook",
            Url = string.Empty,
            Label = string.Empty
        });
    }

    private void RemoveSocialLink(int index)
    {
        if (index >= 0 && index < _socialLinks.Count)
        {
            _socialLinks.RemoveAt(index);
        }
    }

    // ── Link Groups CRUD ──────────────────────────────────────────────────

    private async Task LoadLinkGroupsAsync()
    {
        try
        {
            var groups = await FooterService.GetLinkGroupsAsync();
            _linkGroups = groups.OrderBy(g => g.Order).ToList();
        }
        catch (Exception)
        {
            _errorMessage = "Failed to reload link groups.";
        }
    }

    private async Task OpenCreateGroupDialog()
    {
        var dialog = await FooterLinkGroupDialog.ShowAsync(DialogService, "Create Link Group");
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is CreateFooterLinkGroupRequest createModel)
        {
            await CreateGroupAsync(createModel);
        }
    }

    private async Task OpenEditGroupDialog(FooterLinkGroupListDto group)
    {
        if (group.Id is not Guid groupId)
        {
            _errorMessage = "The selected link group has no identifier.";
            return;
        }

        var parameters = new DialogParameters<FooterLinkGroupDialog>
        {
            { x => x.ExistingGroup, group }
        };

        var dialog = await FooterLinkGroupDialog.ShowAsync(DialogService, "Edit Link Group", parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is UpdateFooterLinkGroupRequest updateModel)
        {
            await UpdateGroupAsync(groupId, updateModel);
        }
    }

    private async Task CreateGroupAsync(CreateFooterLinkGroupRequest model)
    {
        try
        {
            var response = await FooterService.CreateLinkGroupAsync(model);
            if (response?.Success == true)
            {
                Snackbar.Add("Link group created.", Severity.Success);
                await LoadLinkGroupsAsync();
            }
            else
            {
                _errorMessage = response?.Message ?? "Failed to create link group.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "An error occurred while creating the link group.";
        }
    }

    private async Task UpdateGroupAsync(Guid id, UpdateFooterLinkGroupRequest model)
    {
        try
        {
            var response = await FooterService.UpdateLinkGroupAsync(id, model);
            if (response?.Success == true)
            {
                Snackbar.Add("Link group updated.", Severity.Success);
                await LoadLinkGroupsAsync();
            }
            else
            {
                _errorMessage = response?.Message ?? "Failed to update link group.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "An error occurred while updating the link group.";
        }
    }

    private async Task DeleteGroup(FooterLinkGroupListDto group)
    {
        if (group.Id is not Guid groupId)
        {
            _errorMessage = "The selected link group has no identifier.";
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            $"Are you sure you want to delete '{group.Title}' and all its links?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            try
            {
                var deleted = await FooterService.DeleteLinkGroupAsync(groupId);
                if (deleted)
                {
                    Snackbar.Add("Link group deleted.", Severity.Success);

                    if (_selectedGroup?.Id == groupId)
                    {
                        _selectedGroup = null;
                        _selectedGroupLinks.Clear();
                    }

                    await LoadLinkGroupsAsync();
                }
                else
                {
                    _errorMessage = "Failed to delete link group.";
                }
            }
            catch (Exception)
            {
                _errorMessage = "An error occurred while deleting the link group.";
            }
        }
    }

    // ── Group Reorder ─────────────────────────────────────────────────────

    private async Task MoveGroupUp(FooterLinkGroupListDto group)
    {
        var index = _linkGroups.IndexOf(group);
        if (index > 0)
        {
            await SwapGroupOrder(index, index - 1);
        }
    }

    private async Task MoveGroupDown(FooterLinkGroupListDto group)
    {
        var index = _linkGroups.IndexOf(group);
        if (index < _linkGroups.Count - 1)
        {
            await SwapGroupOrder(index, index + 1);
        }
    }

    private async Task SwapGroupOrder(int index1, int index2)
    {
        var group1 = _linkGroups[index1];
        var group2 = _linkGroups[index2];

        var tempOrder = group1.Order;
        group1.Order = group2.Order;
        group2.Order = tempOrder;

        _linkGroups[index1] = group2;
        _linkGroups[index2] = group1;

        var orderedIds = _linkGroups.Select(g => g.Id).OfType<Guid>().ToList();
        if (orderedIds.Count != _linkGroups.Count)
        {
            _errorMessage = "A link group has no identifier.";
            await LoadLinkGroupsAsync();
            return;
        }

        try
        {
            var response = await FooterService.ReorderLinkGroupsAsync(orderedIds);
            if (response?.Success != true)
            {
                _errorMessage = response?.Message ?? "Failed to reorder link groups.";
                await LoadLinkGroupsAsync();
            }
        }
        catch (Exception)
        {
            _errorMessage = "An error occurred while reordering link groups.";
            await LoadLinkGroupsAsync();
        }
    }

    private bool IsFirstGroup(FooterLinkGroupListDto group) => _linkGroups.IndexOf(group) == 0;
    private bool IsLastGroup(FooterLinkGroupListDto group) => _linkGroups.IndexOf(group) == _linkGroups.Count - 1;

    // ── Group Links ───────────────────────────────────────────────────────

    private async Task SelectGroup(FooterLinkGroupListDto group)
    {
        if (group.Id is not Guid groupId)
        {
            _errorMessage = "The selected link group has no identifier.";
            return;
        }

        try
        {
            var details = await FooterService.GetLinkGroupAsync(groupId);
            if (details != null)
            {
                _selectedGroup = details;
                _selectedGroupLinks = (details.Links ?? []).OrderBy(l => l.Order).ToList();
            }
            else
            {
                _errorMessage = "Failed to load link group details.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "An error occurred while loading group links.";
        }
    }

    private void DeselectGroup()
    {
        _selectedGroup = null;
        _selectedGroupLinks.Clear();
    }

    private async Task ReloadSelectedGroupLinksAsync()
    {
        if (_selectedGroup?.Id is not Guid groupId) return;

        try
        {
            var details = await FooterService.GetLinkGroupAsync(groupId);
            if (details != null)
            {
                _selectedGroup = details;
                _selectedGroupLinks = (details.Links ?? []).OrderBy(l => l.Order).ToList();
            }
        }
        catch (Exception)
        {
            _errorMessage = "Failed to reload group links.";
        }
    }

    private async Task OpenCreateLinkDialog()
    {
        var dialog = await FooterLinkDialog.ShowAsync(DialogService, "Add Link");
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is CreateFooterLinkRequest createModel)
        {
            await CreateLinkAsync(createModel);
        }
    }

    private async Task OpenEditLinkDialog(FooterLinkItemDto link)
    {
        if (link.Id is not Guid linkId)
        {
            _errorMessage = "The selected link has no identifier.";
            return;
        }

        var parameters = new DialogParameters<FooterLinkDialog>
        {
            { x => x.ExistingLink, link }
        };

        var dialog = await FooterLinkDialog.ShowAsync(DialogService, "Edit Link", parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is UpdateFooterLinkRequest updateModel)
        {
            await UpdateLinkAsync(linkId, updateModel);
        }
    }

    private async Task CreateLinkAsync(CreateFooterLinkRequest model)
    {
        if (_selectedGroup?.Id is not Guid groupId) return;

        try
        {
            var response = await FooterService.CreateLinkAsync(groupId, model);
            if (response?.Success == true)
            {
                Snackbar.Add("Link added.", Severity.Success);
                await ReloadSelectedGroupLinksAsync();
                await LoadLinkGroupsAsync();
            }
            else
            {
                _errorMessage = response?.Message ?? "Failed to add link.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "An error occurred while adding the link.";
        }
    }

    private async Task UpdateLinkAsync(Guid id, UpdateFooterLinkRequest model)
    {
        try
        {
            var response = await FooterService.UpdateLinkAsync(id, model);
            if (response?.Success == true)
            {
                Snackbar.Add("Link updated.", Severity.Success);
                await ReloadSelectedGroupLinksAsync();
            }
            else
            {
                _errorMessage = response?.Message ?? "Failed to update link.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "An error occurred while updating the link.";
        }
    }

    private async Task DeleteLink(FooterLinkItemDto link)
    {
        if (link.Id is not Guid linkId)
        {
            _errorMessage = "The selected link has no identifier.";
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            $"Are you sure you want to delete '{link.Label}'?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            try
            {
                var deleted = await FooterService.DeleteLinkAsync(linkId);
                if (deleted)
                {
                    Snackbar.Add("Link deleted.", Severity.Success);
                    await ReloadSelectedGroupLinksAsync();
                    await LoadLinkGroupsAsync();
                }
                else
                {
                    _errorMessage = "Failed to delete link.";
                }
            }
            catch (Exception)
            {
                _errorMessage = "An error occurred while deleting the link.";
            }
        }
    }

    // ── Helpers ────────────────────────────────────────────────────────────

    private static string TruncateUrl(string? url) =>
        url?.Length > 60 ? string.Concat(url.AsSpan(0, 57), "...") : url ?? string.Empty;

    private static string CapitalizePlatform(string platform) =>
        platform switch
        {
            "bluesky" => "Bluesky",
            "github" => "GitHub",
            "linkedin" => "LinkedIn",
            "tiktok" => "TikTok",
            "whatsapp" => "WhatsApp",
            "youtube" => "YouTube",
            _ => char.ToUpperInvariant(platform[0]) + platform[1..]
        };

}
