@* ABOUTME: Public tenant plan detail and version-governance page for instance administrators. *@
@* ABOUTME: Gates draft, diff, publish, archive, and clone actions through version-specific HAL links. *@

@page "/admin/instance/plans/{Key}"
@using System.Globalization
@using Blazouter.Services
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Components.ControlPlane
@using Explore.Blazor.Client.Contracts.ControlPlane
@using Explore.Blazor.Client.Contracts.Services.Accessibility
@using Explore.Blazor.Client.Contracts.Services.ControlPlane
@using Explore.Blazor.Client.Routing.ControlPlane
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IControlPlanePlanCatalogService PlanCatalog
@inject IAccessibilityFocusService FocusService
@inject IAccessibilityAnnouncerService Announcer
@inject RouterStateService RouterState

<PageTitle>@PageTitleText</PageTitle>

<main class="instance-plan-detail">
    <header class="instance-plan-detail__header">
        <div>
            <p class="instance-plan-detail__eyebrow" dir="auto">Instance console / Plans</p>
            <h1 dir="auto">@(_plan?.DisplayName ?? "Plan detail")</h1>
            @if (!string.IsNullOrWhiteSpace(_plan?.Description))
            {
                <p class="instance-plan-detail__description" data-plan-description dir="auto">@_plan.Description</p>
            }
        </div>
        <div class="instance-plan-detail__header-actions">
            @if (CanCreateVersionDraft)
            {
                <AppButton id="plan-new-version"
                           StartIcon="@Icons.Material.Filled.Add"
                           Disabled="@IsBusy"
                           OnClick="StartNewVersionAsync">
                    New version draft
                </AppButton>
            }
            <AppButton Variant="Variant.Outlined" Href="@ControlPlaneRoutes.Plans" aria-label="Back to tenant plans" dir="auto">
                Back to plans
            </AppButton>
        </div>
    </header>

    @if (_loading)
    {
        <div class="instance-plan-detail__state" role="status" aria-live="polite">
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            <span dir="auto">Loading plan details</span>
        </div>
    }
    else if (_loadFailed)
    {
        <MudAlert Severity="Severity.Error" role="alert" aria-live="assertive">
            <span dir="auto">Tenant plan details are currently unavailable.</span>
        </MudAlert>
    }
    else if (_plan is { } plan)
    {
        <section class="instance-plan-detail__identity" aria-label="Plan identity">
            <dl>
                <div>
                    <dt dir="auto">Plan key</dt>
                    <dd><code data-plan-key dir="ltr">@plan.Key</code></dd>
                </div>
                <div>
                    <dt dir="auto">Versions</dt>
                    <dd dir="ltr">@Versions.Count</dd>
                </div>
            </dl>
        </section>

        @if (_draft is not null)
        {
            <section class="instance-plan-detail__editor" aria-labelledby="plan-draft-editor-heading">
                <h2 id="plan-draft-editor-heading">@EditorTitle</h2>
                <ControlPlanePlanDraftEditor @key="_draft"
                                             Draft="_draft"
                                             KeyReadOnly="true"
                                             Busy="@IsBusy"
                                             CanValidate="@CanValidateDraft"
                                             CanPreviewDiff="@CanPreviewDiff"
                                             SubmitLabel="@EditorSubmitLabel"
                                             ValidationErrors="_validationErrors"
                                             Diff="_diff"
                                             OnValidate="ValidateDraftAsync"
                                             OnPreviewDiff="PreviewDiffAsync"
                                             OnSubmit="SaveDraftAsync"
                                             OnCancel="CancelEditorAsync" />
            </section>
        }

        @if (_cloneVersion is not null)
        {
            <section class="instance-plan-detail__confirmation" aria-labelledby="clone-plan-heading">
                <h2 id="clone-plan-heading">Clone version @_cloneVersion.VersionNumber</h2>
                <p>Create a separate draft plan from this published version.</p>
                <div class="instance-plan-detail__confirmation-grid">
                    <AppTextField T="string" @bind-Value="_cloneKey" Label="New plan key" Required="true" Disabled="@IsBusy" dir="ltr" />
                    <AppTextField T="string" @bind-Value="_cloneName" Label="New plan name" Required="true" Disabled="@IsBusy" dir="auto" />
                </div>
                <div class="instance-plan-detail__actions">
                    <AppButton Disabled="@(!CanConfirmClone || IsBusy)" OnClick="ConfirmCloneAsync">Create cloned draft</AppButton>
                    <AppButton Variant="Variant.Text" Disabled="@IsBusy" OnClick="CancelCloneAsync">Cancel</AppButton>
                </div>
            </section>
        }

        @if (_lifecycleConfirmation is not null)
        {
            <section class="instance-plan-detail__confirmation" aria-labelledby="plan-lifecycle-confirmation-heading">
                <h2 id="plan-lifecycle-confirmation-heading">@_lifecycleConfirmation.Title</h2>
                <p>@_lifecycleConfirmation.Description</p>
                @if (_lifecycleConfirmation.Operation == VersionOperation.Publish)
                {
                    <MudSelect T="int" @bind-Value="_existingTenantPolicy" Label="Existing tenant assignments" Variant="Variant.Outlined" Disabled="@IsBusy">
                        <MudSelectItem T="int" Value="0">Keep tenants pinned to their current version</MudSelectItem>
                        <MudSelectItem T="int" Value="1">Move tenants to the newly published version</MudSelectItem>
                    </MudSelect>
                }
                <p>Type <code dir="ltr">@_lifecycleConfirmation.RequiredPhrase</code> to continue.</p>
                <AppTextField T="string"
                              id="plan-lifecycle-confirmation-input"
                              @bind-Value="_confirmationText"
                              Label="Confirmation phrase"
                              Disabled="@IsBusy"
                              autocomplete="off"
                              dir="ltr" />
                <div class="instance-plan-detail__actions">
                    <AppButton Color="@_lifecycleConfirmation.Color"
                               Disabled="@(!CanConfirmLifecycle || IsBusy)"
                               OnClick="ConfirmLifecycleAsync">
                        @_lifecycleConfirmation.ActionLabel
                    </AppButton>
                    <AppButton Variant="Variant.Text" Disabled="@IsBusy" OnClick="CancelLifecycleAsync">Cancel</AppButton>
                </div>
            </section>
        }

        @if (Versions.Count == 0)
        {
            <MudAlert Severity="Severity.Info"><span dir="auto">No plan versions are available.</span></MudAlert>
        }
        else
        {
            <section class="instance-plan-detail__versions" aria-labelledby="plan-versions-heading">
                <h2 id="plan-versions-heading" dir="auto">Plan versions</h2>

                <div class="instance-plan-detail__version-list" role="list">
                    @foreach (ControlPlaneTenantPlanVersionDto version in Versions.OrderByDescending(item => item.VersionNumber))
                    {
                        <article class="instance-plan-detail__version" role="listitem" data-plan-version="@version.VersionNumber" @key="version.Id">
                            <div class="instance-plan-detail__version-heading">
                                <h3 dir="ltr">Version @version.VersionNumber</h3>
                                <span class="instance-plan-detail__status" dir="ltr">@version.StatusCode</span>
                            </div>

                            <dl class="instance-plan-detail__facts">
                                <div>
                                    <dt dir="auto">Pricing</dt>
                                    <dd dir="ltr">@FormatPricing(version)</dd>
                                </div>
                                <div>
                                    <dt dir="auto">Provisioning</dt>
                                    <dd dir="auto">@(version.IsActiveForProvisioning == true ? "Eligible" : "Disabled")</dd>
                                </div>
                            </dl>

                            @if (HasVersionAction(version))
                            {
                                <div id="@VersionActionId(version)" class="instance-plan-detail__actions" role="group" tabindex="-1" aria-label="@($"Version {version.VersionNumber} actions")">
                                    @if (CanEditVersion(version))
                                    {
                                        <AppButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@IsBusy" OnClick="@(() => StartEditAsync(version))">Edit draft</AppButton>
                                    }
                                    @if (CanPublishVersion(version))
                                    {
                                        <AppButton Size="Size.Small" Color="Color.Success" Disabled="@IsBusy" OnClick="@(() => StartLifecycleAsync(version, VersionOperation.Publish))">Publish</AppButton>
                                    }
                                    @if (CanArchiveVersion(version))
                                    {
                                        <AppButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Disabled="@IsBusy" OnClick="@(() => StartLifecycleAsync(version, VersionOperation.Archive))">Archive</AppButton>
                                    }
                                    @if (CanCloneVersion(version))
                                    {
                                        <AppButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@IsBusy" OnClick="@(() => StartCloneAsync(version))">Clone</AppButton>
                                    }
                                </div>
                            }

                            <section class="instance-plan-detail__data-section" aria-labelledby="settings-heading-@version.VersionNumber">
                                <h4 id="settings-heading-@version.VersionNumber" dir="auto">Settings</h4>
                                @if (version.Settings?.Count is not > 0)
                                {
                                    <p class="instance-plan-detail__empty" dir="auto">No settings in this version.</p>
                                }
                                else
                                {
                                    <div class="instance-plan-detail__table-wrap" role="region" aria-label="@($"Version {version.VersionNumber} settings")" tabindex="0" dir="ltr">
                                        <table>
                                            <thead><tr><th scope="col">Key</th><th scope="col">Value</th><th class="instance-plan-detail__lock-state" scope="col">Lock state</th></tr></thead>
                                            <tbody>
                                                @foreach (ControlPlaneTenantPlanSettingDto setting in version.Settings)
                                                {
                                                    <tr @key="setting.Key"><td><code dir="ltr">@setting.Key</code></td><td><code dir="ltr">@setting.JsonValue</code></td><td class="instance-plan-detail__lock-state">@(setting.IsLocked == true ? "Locked" : "Unlocked")</td></tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </section>

                            <section class="instance-plan-detail__data-section" aria-labelledby="quotas-heading-@version.VersionNumber">
                                <h4 id="quotas-heading-@version.VersionNumber" dir="auto">Quotas</h4>
                                @if (version.Quotas?.Count is not > 0)
                                {
                                    <p class="instance-plan-detail__empty" dir="auto">No quotas in this version.</p>
                                }
                                else
                                {
                                    <div class="instance-plan-detail__table-wrap" role="region" aria-label="@($"Version {version.VersionNumber} quotas")" tabindex="0" dir="ltr">
                                        <table>
                                            <thead><tr><th scope="col">Key</th><th scope="col">Limit</th></tr></thead>
                                            <tbody>
                                                @foreach (ControlPlaneTenantPlanQuotaDto quota in version.Quotas)
                                                {
                                                    <tr @key="quota.Key"><td><code dir="ltr">@quota.Key</code></td><td><code dir="ltr">@((quota.Limit ?? 0).ToString("N0", CultureInfo.InvariantCulture))</code></td></tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </section>
                        </article>
                    }
                </div>
            </section>
        }
    }

    @if (_commandMessage is not null)
    {
        <MudAlert Severity="@(_commandSucceeded ? Severity.Success : Severity.Error)"
                  role="@(_commandSucceeded ? "status" : "alert")"
                  aria-live="@(_commandSucceeded ? "polite" : "assertive")">
            <span dir="auto">@_commandMessage</span>
        </MudAlert>
    }
</main>

@code {
    [Parameter, EditorRequired] public string Key { get; set; } = string.Empty;

    private HalResourceOfControlPlaneTenantPlanDetailDto? _plan;
    private TenantPlanDraft? _draft;
    private Guid? _editingVersionId;
    private ControlPlaneTenantPlanVersionDto? _draftSourceVersion;
    private ControlPlaneTenantPlanVersionDto? _cloneVersion;
    private string _cloneKey = string.Empty;
    private string _cloneName = string.Empty;
    private VersionConfirmation? _lifecycleConfirmation;
    private string _confirmationText = string.Empty;
    private int _existingTenantPolicy;
    private IReadOnlyList<TenantPlanValidationError> _validationErrors = [];
    private TenantPlanDiffResult? _diff;
    private bool _loading = true;
    private bool _loadFailed;
    private bool _busy;
    private string? _focusSelector;
    private string? _commandMessage;
    private bool _commandSucceeded;

    private IReadOnlyList<ControlPlaneTenantPlanVersionDto> Versions => _plan?.Versions?.ToArray() ?? [];
    private string PageTitleText => _plan is null ? "Tenant Plan" : $"Plan: {_plan.DisplayName}";
    private bool IsBusy => _busy;
    private bool CanCreateVersionDraft => ControlPlaneHal.HasLink(_plan?._links, ControlPlaneLinkRelations.CreateVersionDraft);
    private bool CanValidateDraft => ControlPlaneHal.HasLink(_plan?._links, ControlPlaneLinkRelations.Validate);
    private bool CanPreviewDiff => _draftSourceVersion is not null && ControlPlaneHal.HasLink(_plan?._links, ControlPlaneLinkRelations.PreviewDiff);
    private string EditorTitle => _editingVersionId is null ? "New version draft" : $"Edit version {VersionNumber(_editingVersionId.Value)} draft";
    private string EditorSubmitLabel => _editingVersionId is null ? "Create version draft" : "Save draft";
    private bool CanConfirmClone => _cloneVersion is not null && !string.IsNullOrWhiteSpace(_cloneKey) && !string.IsNullOrWhiteSpace(_cloneName);
    private bool CanConfirmLifecycle => _lifecycleConfirmation is not null
        && string.Equals(_confirmationText.Trim(), _lifecycleConfirmation.RequiredPhrase, StringComparison.Ordinal);

    protected override async Task OnParametersSetAsync()
    {
        string key = string.IsNullOrWhiteSpace(Key) ? RouterState.GetParam("Key") ?? string.Empty : Key;
        _loading = true;
        _loadFailed = false;
        _plan = null;

        try
        {
            _plan = await PlanCatalog.GetPlanAsync(key);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch
        {
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusSelector is null)
        {
            return;
        }

        string selector = _focusSelector;
        _focusSelector = null;
        await FocusService.FocusAsync(selector);
    }

    private async Task ReloadAsync()
    {
        _plan = await PlanCatalog.GetPlanAsync(Key);
    }

    private async Task StartNewVersionAsync()
    {
        await FocusService.SaveFocusAsync();
        _draftSourceVersion = Versions.OrderByDescending(version => version.VersionNumber).FirstOrDefault();
        _editingVersionId = null;
        _draft = _draftSourceVersion is null ? NewDraft() : DraftFromVersion(_draftSourceVersion);
        ClearTransientActions();
        _focusSelector = ".control-plane-plan-editor input";
    }

    private async Task StartEditAsync(ControlPlaneTenantPlanVersionDto version)
    {
        await FocusService.SaveFocusAsync();
        _editingVersionId = version.Id;
        _draftSourceVersion = version;
        _draft = DraftFromVersion(version);
        ClearTransientActions();
        _focusSelector = ".control-plane-plan-editor input";
    }

    private async Task CancelEditorAsync()
    {
        string fallback = _editingVersionId is { } id ? $"#{VersionActionId(id)}" : "#plan-new-version";
        _draft = null;
        _editingVersionId = null;
        _draftSourceVersion = null;
        _validationErrors = [];
        _diff = null;
        ClearCommandMessage();
        await FocusService.RestoreFocusAsync(fallback);
    }

    private Task ValidateDraftAsync(TenantPlanDraft draft) => RunActionAsync(async () =>
    {
        TenantPlanValidationResult result = await PlanCatalog.ValidateDraftAsync(draft);
        _validationErrors = result.Errors.ToArray();
        _commandSucceeded = result.IsValid == true;
        _commandMessage = result.IsValid == true ? "Draft is valid." : "Draft validation found issues.";
        return false;
    });

    private Task PreviewDiffAsync(TenantPlanDraft draft) => RunActionAsync(async () =>
    {
        if (_draftSourceVersion is null)
        {
            return false;
        }

        _diff = await PlanCatalog.PreviewDiffAsync(EffectiveConfigurationFrom(_draftSourceVersion), draft);
        _commandSucceeded = true;
        _commandMessage = _diff.SettingChanges.Count == 0 ? "No setting changes." : $"{_diff.SettingChanges.Count} setting changes found.";
        return true;
    });

    private Task SaveDraftAsync(TenantPlanDraft draft) => RunActionAsync(async () =>
    {
        BaseCommandResponseOfGuid result = _editingVersionId is { } versionId
            ? await PlanCatalog.UpdateVersionDraftAsync(versionId, draft)
            : await PlanCatalog.CreateVersionDraftAsync(_plan?.Key ?? Key, draft);

        SetCommandResult(result, "Plan version draft saved.", "Plan version draft could not be saved.");
        if (result.Success != true)
        {
            return false;
        }

        _draft = null;
        _editingVersionId = null;
        _draftSourceVersion = null;
        _validationErrors = [];
        _diff = null;
        await ReloadAsync();
        return true;
    });

    private async Task StartCloneAsync(ControlPlaneTenantPlanVersionDto version)
    {
        await FocusService.SaveFocusAsync();
        _cloneVersion = version;
        _cloneKey = string.Empty;
        _cloneName = string.Empty;
        _draft = null;
        _lifecycleConfirmation = null;
        ClearCommandMessage();
        _focusSelector = ".instance-plan-detail__confirmation input";
    }

    private async Task CancelCloneAsync()
    {
        Guid? versionId = _cloneVersion?.Id;
        _cloneVersion = null;
        _cloneKey = string.Empty;
        _cloneName = string.Empty;
        await FocusService.RestoreFocusAsync(versionId is { } id ? $"#{VersionActionId(id)}" : null);
    }

    private Task ConfirmCloneAsync() => RunActionAsync(async () =>
    {
        if (_cloneVersion?.Id is not { } versionId || !CanConfirmClone)
        {
            return false;
        }

        BaseCommandResponseOfGuid result = await PlanCatalog.ClonePlanAsync(versionId, _cloneKey.Trim(), _cloneName.Trim());
        SetCommandResult(result, "Plan cloned to a new draft.", "Plan could not be cloned.");
        if (result.Success == true)
        {
            _cloneVersion = null;
            _cloneKey = string.Empty;
            _cloneName = string.Empty;
        }

        return result.Success == true;
    });

    private async Task StartLifecycleAsync(ControlPlaneTenantPlanVersionDto version, VersionOperation operation)
    {
        if (version.Id is not { } versionId)
        {
            return;
        }

        await FocusService.SaveFocusAsync();
        _lifecycleConfirmation = new VersionConfirmation(operation, versionId, version.VersionNumber ?? 0, _plan?.Key ?? Key);
        _confirmationText = string.Empty;
        _existingTenantPolicy = 0;
        _draft = null;
        _cloneVersion = null;
        ClearCommandMessage();
        _focusSelector = "#plan-lifecycle-confirmation-input input";
    }

    private async Task CancelLifecycleAsync()
    {
        Guid? versionId = _lifecycleConfirmation?.VersionId;
        _lifecycleConfirmation = null;
        _confirmationText = string.Empty;
        await FocusService.RestoreFocusAsync(versionId is { } id ? $"#{VersionActionId(id)}" : null);
    }

    private Task ConfirmLifecycleAsync() => RunActionAsync(async () =>
    {
        if (_lifecycleConfirmation is not { } confirmation || !CanConfirmLifecycle)
        {
            return false;
        }

        BaseCommandResponseOfGuid result = confirmation.Operation == VersionOperation.Publish
            ? await PlanCatalog.PublishVersionAsync(confirmation.VersionId, _existingTenantPolicy)
            : await PlanCatalog.ArchiveVersionAsync(confirmation.VersionId);
        SetCommandResult(result, $"Plan version {confirmation.ActionLabel.ToLowerInvariant()}ed.", $"Plan version could not be {confirmation.ActionLabel.ToLowerInvariant()}ed.");
        if (result.Success == true)
        {
            _lifecycleConfirmation = null;
            _confirmationText = string.Empty;
            await ReloadAsync();
        }

        return result.Success == true;
    });

    private async Task RunActionAsync(Func<Task<bool>> action)
    {
        _busy = true;
        ClearCommandMessage();
        try
        {
            await action();
            string message = _commandMessage ?? "Plan action completed.";
            if (_commandSucceeded)
            {
                await Announcer.AnnouncePoliteAsync(message);
            }
            else
            {
                await Announcer.AnnounceAssertiveAsync(message);
            }
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch
        {
            _commandSucceeded = false;
            _commandMessage = "The plan action could not be completed.";
            await Announcer.AnnounceAssertiveAsync(_commandMessage);
        }
        finally
        {
            _busy = false;
        }
    }

    private void SetCommandResult(BaseCommandResponseOfGuid result, string successMessage, string failureMessage)
    {
        _commandSucceeded = result.Success == true;
        _commandMessage = result.Message ?? (_commandSucceeded ? successMessage : failureMessage);
    }

    private void ClearTransientActions()
    {
        _cloneVersion = null;
        _lifecycleConfirmation = null;
        _validationErrors = [];
        _diff = null;
        ClearCommandMessage();
    }

    private void ClearCommandMessage()
    {
        _commandMessage = null;
        _commandSucceeded = false;
    }

    private bool HasVersionAction(ControlPlaneTenantPlanVersionDto version) =>
        CanEditVersion(version) || CanPublishVersion(version) || CanArchiveVersion(version) || CanCloneVersion(version);

    private bool CanEditVersion(ControlPlaneTenantPlanVersionDto version) =>
        IsStatus(version, "Draft") && HasVersionLink(ControlPlaneLinkRelations.UpdateVersionDraft, version);

    private bool CanPublishVersion(ControlPlaneTenantPlanVersionDto version) =>
        IsStatus(version, "Draft") && HasVersionLink(ControlPlaneLinkRelations.Publish, version);

    private bool CanArchiveVersion(ControlPlaneTenantPlanVersionDto version) =>
        IsStatus(version, "Published") && HasVersionLink(ControlPlaneLinkRelations.Archive, version);

    private bool CanCloneVersion(ControlPlaneTenantPlanVersionDto version) =>
        IsStatus(version, "Published") && HasVersionLink(ControlPlaneLinkRelations.Clone, version);

    private bool HasVersionLink(string relation, ControlPlaneTenantPlanVersionDto version) =>
        version.Id is { } id && ControlPlaneHal.HasLinkForResource(_plan?._links, relation, id);

    private static bool IsStatus(ControlPlaneTenantPlanVersionDto version, string status) =>
        string.Equals(version.StatusCode, status, StringComparison.OrdinalIgnoreCase);

    private int VersionNumber(Guid versionId) => Versions.FirstOrDefault(version => version.Id == versionId)?.VersionNumber ?? 0;
    private static string VersionActionId(ControlPlaneTenantPlanVersionDto version) => VersionActionId(version.Id ?? Guid.Empty);
    private static string VersionActionId(Guid versionId) => $"plan-version-actions-{versionId:N}";

    private TenantPlanDraft NewDraft() => new()
    {
        Key = _plan?.Key ?? Key,
        Name = _plan?.DisplayName ?? string.Empty,
        Pricing = new TenantPlanPricing { CurrencyCode = "EUR", BillingPeriod = "monthly" },
        IsActiveForProvisioning = true
    };

    private TenantPlanDraft DraftFromVersion(ControlPlaneTenantPlanVersionDto version) => new()
    {
        Key = _plan?.Key ?? Key,
        Name = _plan?.DisplayName ?? string.Empty,
        Pricing = new TenantPlanPricing
        {
            Amount = version.PriceAmount ?? 0,
            CurrencyCode = version.CurrencyCode ?? "EUR",
            BillingPeriod = version.BillingPeriod ?? "monthly"
        },
        IsActiveForProvisioning = version.IsActiveForProvisioning == true,
        SettingOverrides = (version.Settings ?? []).Select(setting => new TenantPlanSettingOverride
        {
            Key = setting.Key ?? string.Empty,
            JsonValue = setting.JsonValue ?? string.Empty,
            IsLocked = setting.IsLocked == true
        }).ToList(),
        QuotaLimits = (version.Quotas ?? []).Select(quota => new TenantPlanQuotaLimit
        {
            Key = quota.Key ?? string.Empty,
            Limit = quota.Limit ?? 0
        }).ToList()
    };

    private static TenantPlanEffectiveConfiguration EffectiveConfigurationFrom(ControlPlaneTenantPlanVersionDto version) => new()
    {
        Settings = (version.Settings ?? []).Select(setting => new TenantPlanEffectiveSetting
        {
            Key = setting.Key ?? string.Empty,
            JsonValue = setting.JsonValue ?? string.Empty,
            IsLocked = setting.IsLocked == true
        }).ToList()
    };

    private static string FormatPricing(ControlPlaneTenantPlanVersionDto version) =>
        $"{(version.PriceAmount ?? 0).ToString("0.##", CultureInfo.InvariantCulture)} {version.CurrencyCode} / {version.BillingPeriod}";

    private enum VersionOperation
    {
        Publish,
        Archive
    }

    private sealed record VersionConfirmation(VersionOperation Operation, Guid VersionId, int VersionNumber, string PlanKey)
    {
        public string ActionLabel => Operation == VersionOperation.Publish ? "Publish" : "Archive";
        public string Title => $"{ActionLabel} version {VersionNumber}";
        public string Description => Operation == VersionOperation.Publish
            ? "Publishing makes this version available for tenant assignment. Choose how existing assignments should be handled."
            : "Archiving removes this published version from future assignment while retaining its audit history.";
        public string RequiredPhrase => $"{ActionLabel.ToUpperInvariant()} {PlanKey} v{VersionNumber}";
        public Color Color => Operation == VersionOperation.Publish ? Color.Success : Color.Warning;
    }
}
