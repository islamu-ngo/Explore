@* ABOUTME: Authenticated current-account registration-order recovery page. *@
@* ABOUTME: Renders lifecycle actions only from the exact HAL links on the current order resource. *@
@page "/registration/events/{EventId:guid}/orders/{OrderId:guid}"
@using Microsoft.AspNetCore.Authorization
@using Explore.Blazor.Client.Helpers
@attribute [Authorize]
@rendermode InteractiveServer
@inject IRegistrationOrderService RegistrationOrderService
@implements IDisposable

<PageTitle>Registration order</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="registration-order-recovery">
    <MudText Typo="Typo.h4" HtmlTag="h1">Registration order</MudText>

    @if (_isLoading)
    {
        <div class="registration-order-recovery__state" role="status">Loading your registration order…</div>
    }
    else if (_order is null)
    {
        <div class="registration-order-recovery__state" role="alert">@(_error ?? "This registration order is unavailable.")</div>
    }
    else
    {
        <section class="registration-order-recovery__summary" aria-labelledby="registration-order-status">
            <MudText Id="registration-order-status" Typo="Typo.h5" HtmlTag="h2">@(_order.StatusName ?? _order.StatusCode ?? "Status unavailable")</MudText>
            <MudText Typo="Typo.body1">@RegistrationOrderRecovery.Guidance(_order.StatusCode)</MudText>
            @if (RegistrationOrderRecovery.Countdown(_order.ExpiresAt, DateTimeOffset.UtcNow) is { } countdown)
            {
                <MudText Typo="Typo.body2" role="status">@countdown</MudText>
            }
        </section>

        <section class="registration-order-recovery__details" aria-labelledby="registration-order-details">
            <MudText Id="registration-order-details" Typo="Typo.h5" HtmlTag="h2">Order details</MudText>
            <ul>
                @foreach (var line in _order.Lines ?? [])
                {
                    <li>@(line.Quantity ?? 0) × @(line.TicketTypeName ?? "Ticket") — @RegistrationOrderMoneyFormatter.Format(line.SubtotalMinor, line.CurrencyCode ?? _order.CurrencyCode)</li>
                }
            </ul>
            <MudText Typo="Typo.body1">Total due: @RegistrationOrderMoneyFormatter.Format(_order.TotalDueMinor, _order.CurrencyCode)</MudText>
        </section>

        @if (_order.PlatformContribution?.Options is { Count: > 0 })
        {
            <MudSelect T="int?" Label="Platform contribution" @bind-Value="_contributionBasisPoints">
                @foreach (var option in _order.PlatformContribution.Options)
                {
                    <MudSelectItem Value="@option.ContributionBasisPoints">@FormatPercentage(option.ContributionBasisPoints) — @RegistrationOrderMoneyFormatter.Format(option.AmountMinor, _order.CurrencyCode)</MudSelectItem>
                }
            </MudSelect>
        }

        <div class="registration-order-recovery__actions">
            @if (_order._links?.ContainsKey("continue") == true)
            {
                <AppButton OnClick="ContinueAsync">Continue registration</AppButton>
            }
            @if (_order._links?.ContainsKey("finalize") == true)
            {
                <AppButton OnClick="FinalizeAsync">Finalize registration</AppButton>
            }
        </div>

        @if (_order._links?.ContainsKey("cancel") == true)
        {
            <AppButton Variant="Variant.Outlined" Color="Color.Error" OnClick="CancelAsync">Cancel registration order</AppButton>
        }
    }
</MudContainer>

@code {
    [Parameter] public Guid EventId { get; set; }
    [Parameter] public Guid OrderId { get; set; }

    private HalResourceOfRegistrationOrderDto? _order;
    private bool _isLoading = true;
    private string? _error;
    private int? _contributionBasisPoints;
    private Timer? _timer;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        _order = await RegistrationOrderService.GetCurrentAsync(EventId, OrderId);
        _contributionBasisPoints = _order?.PlatformContribution?.SelectedBasisPoints;
        _isLoading = false;
        _timer?.Dispose();
        _timer = _order?.ExpiresAt is null ? null : new Timer(_ => _ = InvokeAsync(StateHasChanged), null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private async Task CancelAsync()
    {
        _order = await RegistrationOrderService.CancelCurrentAsync(EventId, OrderId);
        if (_order is null)
        {
            _error = "This registration order could not be cancelled.";
        }
    }

    private Task ContinueAsync() => ApplyAsync(() => RegistrationOrderService.ContinueCurrentAsync(
        EventId,
        OrderId,
        _contributionBasisPoints));

    private Task FinalizeAsync() => ApplyAsync(() => RegistrationOrderService.FinalizeCurrentAsync(EventId, OrderId));

    private async Task ApplyAsync(Func<Task<HalResourceOfRegistrationOrderDto?>> operation)
    {
        var order = await operation();
        if (order is null)
        {
            _error = "This registration order could not be updated.";
            return;
        }

        _order = order;
        _contributionBasisPoints = order.PlatformContribution?.SelectedBasisPoints;
    }

    private static string FormatPercentage(int? basisPoints) => $"{basisPoints.GetValueOrDefault() / 100m:0.##}%";

    public void Dispose() => _timer?.Dispose();
}
