@* ABOUTME: Display-only workspace shell for parent-projected onboarding steps, status, help, and actions. *@
@* ABOUTME: Renders accessible navigation and content regions without owning workflow authority or persistence. *@

<div class="onboarding-workspace" dir="auto">
    <header class="onboarding-workspace__header">
        @HeaderContent

        @if (!string.IsNullOrWhiteSpace(StatusText))
        {
            <p class="onboarding-workspace__status"
               data-state="@State"
               role="status"
               aria-live="polite">
                @StatusText
            </p>
        }
    </header>

    @if (Steps.Count > 0)
    {
        <nav class="onboarding-workspace__progress" aria-label="@ProgressLabel">
            @if (CurrentStepNumber > 0)
            {
                <p class="onboarding-workspace__position">
                    @StepPositionFormatter(CurrentStepNumber, Steps.Count)
                </p>
            }

            <ol class="onboarding-workspace__steps">
                @foreach (var step in Steps)
                {
                    <li class="onboarding-workspace__step" data-state="@step.State">
                        @if (!string.IsNullOrWhiteSpace(step.Href))
                        {
                            <a class="onboarding-workspace__step-link"
                               href="@step.Href"
                               aria-current="@(step.IsCurrent ? "step" : null)">
                                <span class="onboarding-workspace__step-label">@step.Label</span>
                                <span class="onboarding-workspace__step-status">@step.StatusText</span>
                            </a>
                        }
                        else
                        {
                            <span class="onboarding-workspace__step-link"
                                  aria-current="@(step.IsCurrent ? "step" : null)">
                                <span class="onboarding-workspace__step-label">@step.Label</span>
                                <span class="onboarding-workspace__step-status">@step.StatusText</span>
                            </span>
                        }
                    </li>
                }
            </ol>
        </nav>
    }

    <section class="onboarding-workspace__content" aria-labelledby="@HeadingId">
        @HeadingContent
        @ChildContent
    </section>

    @if (SummaryContent is not null)
    {
        <aside class="onboarding-workspace__aside" aria-label="@SummaryLabel">
            <details class="onboarding-workspace__summary" open="@SummaryExpanded">
                <summary class="onboarding-workspace__summary-label">@SummaryLabel</summary>
                <div class="onboarding-workspace__summary-content">
                    @SummaryContent
                </div>
            </details>

            @if (HelpContent is not null)
            {
                <div class="onboarding-workspace__help">
                    @HelpContent
                </div>
            }
        </aside>
    }

    <footer class="onboarding-workspace__actions" aria-label="@ActionsLabel">
        @ActionsContent
    </footer>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<StepDescriptor> Steps { get; set; } = [];

    [Parameter, EditorRequired]
    public string ProgressLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public Func<int, int, string> StepPositionFormatter { get; set; } = static (current, total) => $"{current}/{total}";

    [Parameter, EditorRequired]
    public string HeadingId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string SummaryLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string ActionsLabel { get; set; } = string.Empty;

    [Parameter]
    public string? StatusText { get; set; }

    [Parameter]
    public PresentationState State { get; set; } = PresentationState.Current;

    [Parameter]
    public bool SummaryExpanded { get; set; }

    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment HeadingContent { get; set; } = default!;

    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;

    [Parameter]
    public RenderFragment? SummaryContent { get; set; }

    [Parameter]
    public RenderFragment? HelpContent { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment ActionsContent { get; set; } = default!;

    private int CurrentStepNumber
    {
        get
        {
            for (var index = 0; index < Steps.Count; index++)
            {
                if (Steps[index].IsCurrent)
                {
                    return index + 1;
                }
            }

            return 0;
        }
    }

    public sealed record StepDescriptor(
        string Label,
        string StatusText,
        PresentationState State,
        bool IsCurrent = false,
        string? Href = null);

    public enum PresentationState
    {
        Loading,
        Error,
        Locked,
        Skipped,
        Configured,
        Complete,
        Current,
        Upcoming,
        Dirty
    }
}
