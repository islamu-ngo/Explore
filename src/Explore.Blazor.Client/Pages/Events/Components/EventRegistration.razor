@* ABOUTME: Registration dialog that captures event/day/session intent and optional organizer email-share consent. *@
@* ABOUTME: Uses the registration service boundary so API failures become user-safe validation feedback. *@

@using Explore.Blazor.Client.Helpers
@using Explore.Blazor.Client.Contracts.Interop
@using Explore.Blazor.Client.Contracts.Services
@using Explore.Blazor.Client.Pages.Events
@inject IEventRegistrationService RegistrationService
@inject IUserService UserService
@inject IContactShareConsentService ConsentService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IBrowserActionInterop BrowserActionInterop
@inject ILogger<EventRegistration> Logger
<MudDialog Class="registration-dialog">
    <DialogContent>
        @if (isLoading)
        {
            <div class="registration-shell" style="text-align: center; padding: 48px;">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.body1" style="margin-top: 16px;">
                    Checking registration status...
                </MudText>
            </div>
        }
        else if (isAlreadyRegistered)
        {
            <div class="registration-shell">
                <div class="success-content">
                    <div class="success-icon">
                        <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Style="color: var(--mud-palette-success);" />
                    </div>
                    <MudText Typo="Typo.h4" Class="success-title">
                        You're Already Registered!
                    </MudText>
                    <MudText Typo="Typo.body1" Class="success-message">
                        You have already registered for this event.<br />
                        We look forward to seeing you there!
                    </MudText>
                      <MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="registration__success-actions">
                          <MudButton Elevation="0" Color="Color.Primary" Size="Size.Large"
                                     Variant="Variant.Outlined"
                                     Href="@GetCalendarDownloadUrl()"
                                     StartIcon="@Icons.Material.Filled.CalendarMonth">
                              Add to Calendar
                          </MudButton>
                          <MudButton Elevation="0" Color="Color.Primary" Size="Size.Large"
                                     Variant="Variant.Outlined"
                                     OnClick="ShareEventAsync"
                                    StartIcon="@Icons.Material.Filled.Share">
                             Share this Event
                         </MudButton>
                         <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large"
                                    Href="/my/profile"
                                    StartIcon="@Icons.Material.Filled.AppRegistration">
                            View Registrations
                        </MudButton>
                        <MudButton Elevation="0" Size="Size.Large"
                                   Variant="Variant.Text"
                                   Color="Color.Default"
                                   OnClick="Close"
                                   StartIcon="@Icons.Material.Filled.Close">
                            Close
                        </MudButton>
                    </MudStack>
                </div>
            </div>
        }
        else if (!isRegistered)
        {
            <div class="registration-shell">
                <MudText Typo="Typo.h5" Class="mb-2">@Title</MudText>

                @if (currentUser != null)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-4">
                        You will be registered as: <strong>@currentUser.FirstName @currentUser.LastName</strong> (@currentUser.Email)
                    </MudAlert>
                }

                @if (_allowedScopes.Count > 1)
                {
                    <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">
                        How would you like to register?
                    </MudText>
                    <MudRadioGroup T="int" @bind-Value="_selectedScopeId" Class="mb-4">
                        @foreach (var scopeId in _allowedScopes)
                        {
                            <MudRadio T="int" Value="@scopeId" Color="Color.Primary" Dense="true">
                                <MudText Typo="Typo.body1">@RegistrationPolicyHelper.GetScopeLabel(scopeId)</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @RegistrationPolicyHelper.GetScopeDescription(scopeId)
                                </MudText>
                            </MudRadio>
                        }
                    </MudRadioGroup>
                }
                else if (_allowedScopes.Count == 1)
                {
                    <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
                        @RegistrationPolicyHelper.GetScopeDescription(_allowedScopes[0])
                    </MudText>
                }

                @if (_selectedScopeId == RegistrationPolicyHelper.ScopeDay && Days != null && Days.Any())
                {
                    <MudSelect T="Guid?" @bind-Value="_selectedDayId"
                               Label="Select a day"
                               Variant="Variant.Outlined"
                               AnchorOrigin="Origin.BottomCenter"
                               Class="mb-4"
                               Required="true">
                        @foreach (var day in Days.Where(d => d.IsPublished == true).OrderBy(d => d.LocalDate))
                        {
                            <MudSelectItem T="Guid?" Value="@day.Id">
                                @day.LocalDate?.ToString("ddd, MMM d")@(!string.IsNullOrEmpty(day.Label) ? $" - {day.Label}" : "")
                            </MudSelectItem>
                        }
                    </MudSelect>
                }

                @if (_selectedScopeId == RegistrationPolicyHelper.ScopeSessionSelection && Sessions != null && Sessions.Any())
                {
                    <MudText Typo="Typo.body2" Class="mb-2">Select sessions:</MudText>
                    <div class="mb-4" style="max-height: 300px; overflow-y: auto;">
                        @foreach (var session in Sessions.Where(s => s.Id.HasValue))
                        {
                            <MudCheckBox T="bool"
                                         Value="@_selectedSessionIds.Contains(session.Id!.Value)"
                                         ValueChanged="@((bool v) => ToggleSession(session.Id!.Value, v))"
                                         Label="@session.Title"
                                         Color="Color.Primary"
                                         Dense="true" />
                        }
                    </div>
                }

                @if (RecipientActorId.HasValue && RecipientActorId.Value != Guid.Empty)
                {
                    <MudDivider Class="my-4" />
                    <div class="registration__consent">
                        @if (_hasExistingConsent)
                        {
                            <MudAlert Severity="Severity.Info"
                                      Icon="@Icons.Material.Filled.CheckCircle"
                                      Dense="true"
                                      Class="mb-2">
                                <MudText Typo="Typo.body2">
                                    You're already sharing your email address with this organizer.
                                </MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                                    You can manage this at any time from
                                    <MudLink Href="/settings?section=connected-apps" Underline="Underline.Always">
                                        Connected Apps
                                    </MudLink>.
                                </MudText>
                            </MudAlert>
                        }
                        else
                        {
                            <MudCheckBox T="bool"
                                         @bind-Value="_shareEmailWithOrganizer"
                                         Color="Color.Primary"
                                         Dense="true"
                                         Label="@BuildConsentLabel()" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block registration__consent-hint">
                                Optional. You can withdraw this consent anytime from
                                <MudLink Href="/settings?section=connected-apps" Underline="Underline.Always" Typo="Typo.caption">
                                    Connected Apps
                                </MudLink>.
                            </MudText>
                        }
                    </div>
                }

                <div class="action-buttons">
                    <MudButton Elevation="0" Variant="Variant.Text"
                               Color="Color.Default"
                               OnClick="Cancel"
                               Disabled="isSubmitting">
                        Cancel
                    </MudButton>
                    <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" OnClick="HandleSubmit"
                               Disabled="@IsSubmitDisabled()"
                               StartIcon="@(isSubmitting ? null : Icons.Material.Filled.CheckCircle)">
                        @if (isSubmitting)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Registering...</span>
                        }
                        else
                        {
                            <span>Confirm Registration</span>
                        }
                    </MudButton>
                </div>
            </div>
        }
        else
        {
            <div class="registration-shell">
                <div class="success-content">
                    <div class="success-icon">
                        <MudIcon Icon="@(isWaitlisted ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.CheckCircle)" />
                    </div>
                    <MudText Typo="Typo.h4" Class="success-title">
                        @(isWaitlisted ? "Added to Waitlist!" : "Registration Successful!")
                    </MudText>
                    <MudText Typo="Typo.body1" Class="success-message">
                        @if (isWaitlisted)
                        {
                            <span>Thank you for registering@(currentUser != null ? $", {currentUser.FirstName}" : "")!</span>
                            <br />
                            <span>You have been added to the waitlist because one or more selected sessions are currently full.</span>
                        }
                        else
                        {
                            <span>Thank you for registering@(currentUser != null ? $", {currentUser.FirstName}" : "")!</span>
                            <br />
                            <span>Your registration has been confirmed.</span>
                        }
                    </MudText>
                      <MudStack Row="true" Justify="Justify.Center" Spacing="2" Class="registration__success-actions">
                          <MudButton Elevation="0" Color="Color.Primary" Size="Size.Large"
                                     Variant="Variant.Outlined"
                                     Href="@GetCalendarDownloadUrl()"
                                     StartIcon="@Icons.Material.Filled.CalendarMonth">
                              Add to Calendar
                          </MudButton>
                          <MudButton Elevation="0" Color="Color.Primary" Size="Size.Large"
                                     Variant="Variant.Outlined"
                                     OnClick="ShareEventAsync"
                                    StartIcon="@Icons.Material.Filled.Share">
                             Share this Event
                         </MudButton>
                         <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large"
                                    Href="/my/profile"
                                    StartIcon="@Icons.Material.Filled.AppRegistration">
                            View Registrations
                        </MudButton>
                        <MudButton Elevation="0" Size="Size.Large"
                                   Variant="Variant.Text"
                                   Color="Color.Default"
                                   OnClick="Close"
                                   StartIcon="@Icons.Material.Filled.Close">
                            Close
                        </MudButton>
                    </MudStack>
                </div>
            </div>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private MudBlazor.IDialogReference? DialogReference { get; set; }

    [Parameter]
    public Guid EventId { get; set; }

    [Parameter]
    public Guid EventSessionId { get; set; }

    [Parameter]
    public string Title { get; set; } = "Register for Event";

    [Parameter]
    public int? RegistrationPolicyId { get; set; }

    [Parameter]
    public ICollection<EventDayListDto>? Days { get; set; }

    [Parameter]
    public ICollection<EventSessionListDto>? Sessions { get; set; }

    /// <summary>
    /// The publisher organization's actor id, used to detect and gate the
    /// "share my email with the organizer" consent affordance. When null,
    /// the consent section is not rendered.
    /// </summary>
    [Parameter]
    public Guid? RecipientActorId { get; set; }

    /// <summary>
    /// The publisher organization's display name, used to render the
    /// consent checkbox label. When null or empty, "the organizer" is used.
    /// </summary>
    [Parameter]
    public string? PublisherOrganizationName { get; set; }

    private CreateEventRegistrationDto registrationModel = new();
    private UserDto? currentUser;
    private bool isSubmitting;
    private bool isRegistered;
    private bool isWaitlisted;
    private bool isAlreadyRegistered;
    private bool isLoading = true;

    private IReadOnlyList<int> _allowedScopes = [];
    private int _selectedScopeId;
    private Guid? _selectedDayId;
    private HashSet<Guid> _selectedSessionIds = [];

    private bool _shareEmailWithOrganizer;
    private bool _hasExistingConsent;

    protected override async Task OnInitializedAsync()
    {
        _allowedScopes = RegistrationPolicyHelper.GetAllowedScopes(RegistrationPolicyId);
        _selectedScopeId = _allowedScopes.Count > 0 ? _allowedScopes[0] : RegistrationPolicyHelper.ScopeSessionSelection;

        if (EventSessionId != Guid.Empty)
        {
            _selectedScopeId = RegistrationPolicyHelper.ScopeSessionSelection;
            _selectedSessionIds.Add(EventSessionId);
        }

        try
        {
            currentUser = await UserService.GetCurrentUserAsync();

            if (currentUser != null)
            {
                registrationModel.EventId = EventId;
                registrationModel.UserId = currentUser.Id;

                if (currentUser.Id.HasValue && EventId != Guid.Empty)
                {
                    await LoadExistingRegistrationStatusAsync(currentUser.Id.Value);
                }
            }

            if (RecipientActorId.HasValue && RecipientActorId.Value != Guid.Empty)
            {
                try
                {
                    _hasExistingConsent = await ConsentService.CheckConsentForOrganizerAsync(
                        RecipientActorId.Value,
                        CancellationToken.None);
                }
                catch
                {
                    // Non-fatal: fall through and treat as no existing consent.
                    _hasExistingConsent = false;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load registration dialog data for event {EventId}", EventId);
            Snackbar.Add("Could not load registration data. Please try again.", Severity.Warning);
        }
        finally
        {
            isLoading = false;
        }
    }

    private string BuildConsentLabel()
    {
        var orgName = string.IsNullOrWhiteSpace(PublisherOrganizationName)
            ? "the organizer"
            : PublisherOrganizationName;

        return $"Share my email address with {orgName} so they can contact me about future events and related updates.";
    }

    private async Task LoadExistingRegistrationStatusAsync(Guid userId)
    {
        try
        {
            var registrations = await RegistrationService.GetRegistrationsByUserAsync(userId);
            isAlreadyRegistered = registrations.Any(registration => registration.EventId == EventId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to check existing registration status for event {EventId}", EventId);
            isAlreadyRegistered = false;
        }
    }

    private void ToggleSession(Guid sessionId, bool selected)
    {
        if (selected)
            _selectedSessionIds.Add(sessionId);
        else
            _selectedSessionIds.Remove(sessionId);
    }

    private bool IsSubmitDisabled()
    {
        if (isSubmitting || currentUser == null) return true;

        return _selectedScopeId switch
        {
            RegistrationPolicyHelper.ScopeDay => _selectedDayId == null,
            RegistrationPolicyHelper.ScopeSessionSelection => _selectedSessionIds.Count == 0,
            _ => false
        };
    }

    private async Task HandleSubmit()
    {
        if (currentUser == null)
        {
            Snackbar.Add("You must be logged in to register.", Severity.Error);
            return;
        }

        if (EventId == Guid.Empty)
        {
            Snackbar.Add("Registration is unavailable for this event.", Severity.Error);
            return;
        }

        registrationModel.RegistrationScopeId = _selectedScopeId;

        switch (_selectedScopeId)
        {
            case RegistrationPolicyHelper.ScopeDay:
                registrationModel.SelectedEventDayId = _selectedDayId;
                registrationModel.SelectedSessionIds = null;
                break;
            case RegistrationPolicyHelper.ScopeSessionSelection:
                registrationModel.SelectedSessionIds = _selectedSessionIds.ToList();
                registrationModel.SelectedEventDayId = null;
                break;
            default:
                registrationModel.SelectedSessionIds = null;
                registrationModel.SelectedEventDayId = null;
                break;
        }

        // Populate consent snapshot only when the user explicitly opted in
        // for this registration. Existing-consent cases never set this flag
        // so the server does not re-record the consent.
        if (_shareEmailWithOrganizer && !_hasExistingConsent)
        {
            registrationModel.ShareEmailWithOrganizer = true;
            registrationModel.ConsentTextAcknowledged = BuildConsentLabel();
            registrationModel.ConsentUiVersion = "v1";
        }
        else
        {
            registrationModel.ShareEmailWithOrganizer = false;
            registrationModel.ConsentTextAcknowledged = null;
            registrationModel.ConsentUiVersion = null;
        }

        isSubmitting = true;

        try
        {
            var response = await RegistrationService.RegisterForSessionAsync(registrationModel);

            if (response?.Success == true)
            {
                var outcome = EventListRegistrationWorkflow.ResolveOutcome(response);
                isWaitlisted = outcome.IsWaitlisted;
                isAlreadyRegistered = outcome.IsAlreadyRegistered;
                isRegistered = !outcome.IsAlreadyRegistered;
                Snackbar.Add(outcome.SnackbarMessage, outcome.SnackbarSeverity);
            }
            else
            {
                var outcome = EventListRegistrationWorkflow.ResolveOutcome(response);
                Snackbar.Add(outcome.SnackbarMessage, outcome.SnackbarSeverity);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Registration dialog submission failed for event {EventId}", EventId);
            Snackbar.Add("Registration failed. Please try again.", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        DialogReference?.Close();
    }

    private void Close()
    {
        DialogReference?.Close();
    }

    private async Task ShareEventAsync()
    {
        if (EventId == Guid.Empty)
        {
            Snackbar.Add("Sharing is unavailable for this event.", Severity.Warning);
            return;
        }

        var url = CanonicalUrlHelper.Build(Navigation, $"/events/{EventId}");

        if (await BrowserActionInterop.ShareAsync(Title, url))
        {
            return;
        }

        if (await BrowserActionInterop.CopyTextAsync(url))
        {
            Snackbar.Add("Link copied to clipboard", Severity.Success,
                options => options.VisibleStateDuration = 2000);
            return;
        }

        Logger.LogWarning("Failed to copy event link to clipboard");
        Snackbar.Add("Could not copy link", Severity.Error);
    }

    private string GetCalendarDownloadUrl()
    {
        return EventId == Guid.Empty
            ? "#"
            : $"/api/event/{EventId}/calendar";
    }
}
