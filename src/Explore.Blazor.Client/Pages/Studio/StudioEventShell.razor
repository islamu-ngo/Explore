@* ABOUTME: Authenticated Studio route shell for one managed event and its section handoffs. *@
@* ABOUTME: Shares the scoped event resource with shell navigation and links to existing editors. *@
@page "/studio/events/{EventId:guid}"
@page "/studio/events/{EventId:guid}/schedule"
@page "/studio/events/{EventId:guid}/registration"
@page "/studio/events/{EventId:guid}/publication"
@using Blazouter.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@inject RouterStateService RouterState
@inject NavigationManager Navigation
@inject StudioEventContextState EventContext

<PageTitle>@(Resource?.Title ?? "Studio Event")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="studio-event-shell">
    @if (EventContext.IsLoading && Resource is null)
    {
        <section class="studio-event-shell__state" role="status">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body1">Loading event…</MudText>
        </section>
    }
    else if (Resource is null)
    {
        <section class="studio-event-shell__state" role="alert">
            <MudText Typo="Typo.h4" HtmlTag="h1">Event unavailable</MudText>
            <MudText Typo="Typo.body1">@(EventContext.ErrorMessage ?? "This event could not be loaded.")</MudText>
            <AppButton Href="/studio/events" Variant="Variant.Outlined">All events</AppButton>
        </section>
    }
    else
    {
        <header class="studio-event-shell__header">
            <div>
                <MudText Typo="Typo.h4" HtmlTag="h1">@Resource.Title</MudText>
                @if (!string.IsNullOrWhiteSpace(Resource.EventStatusFullName))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Resource.EventStatusFullName</MudText>
                }
            </div>
        </header>

        <section class="studio-event-shell__section" aria-labelledby="studio-event-section-title">
            <MudText Id="studio-event-section-title" Typo="Typo.h5" HtmlTag="h2">@SectionTitle</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">@SectionDescription</MudText>
            <div class="studio-event-shell__actions">
                @if (Section == "schedule" && CanAddSession)
                {
                    <AppButton Href="@($"/events/{EventId}/sessions/create")" StartIcon="@Icons.Material.Filled.Add">Add session</AppButton>
                }
                @if (Section is "details" or "schedule" or "publication" && Resource.HasHalLink("edit"))
                {
                    <AppButton Href="@($"/events/{EventId}/edit")" Variant="Variant.Outlined">Open event editor</AppButton>
                }
                @if (Section == "registration" && HasRegistrationRelation)
                {
                    <AppButton Href="@EventManagementRoute" Variant="Variant.Outlined">Open event management</AppButton>
                }
            </div>
        </section>
    }
</MudContainer>

@code {
    [Parameter] public Guid EventId { get; set; }

    private EventDto? Resource => EventContext.EventId == EventId ? EventContext.Event : null;
    private string Section => ResolveSection();
    private string SectionTitle => Section switch
    {
        "schedule" => "Schedule",
        "registration" => "Registration",
        "publication" => "Publication",
        _ => "Details"
    };
    private string SectionDescription => Section switch
    {
        "schedule" => "Manage this event's sessions in the existing event editor.",
        "registration" => "Open the existing event management surface for registration operations.",
        "publication" => "Review and edit publication details in the existing event editor.",
        _ => "Edit this event using the existing event editor."
    };
    private bool CanAddSession => Resource?.HasHalLink("add-session") == true
        || Resource?.HasHalLink("create-session-draft") == true;
    private bool HasRegistrationRelation => Resource?.HasHalLink("registration") == true
        || Resource?.HasHalLink("registrations") == true;
    private string EventManagementRoute => EventUrlHelper.BuildPublicPath(Resource?.Slug, Resource?.PublicCode)
        ?? $"/events/{EventId}/edit";

    protected override async Task OnParametersSetAsync()
    {
        if (EventId == Guid.Empty
            && Guid.TryParse(RouterState.GetParam("eventId"), out var routeEventId))
        {
            EventId = routeEventId;
        }

        if (EventId != Guid.Empty)
        {
            await EventContext.LoadAsync(EventId);
        }
    }

    private string ResolveSection()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        return path.EndsWith("/schedule", StringComparison.OrdinalIgnoreCase) ? "schedule"
            : path.EndsWith("/registration", StringComparison.OrdinalIgnoreCase) ? "registration"
            : path.EndsWith("/publication", StringComparison.OrdinalIgnoreCase) ? "publication"
            : "details";
    }
}
