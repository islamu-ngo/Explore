@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Helpers
@using Microsoft.AspNetCore.Components
@using Blazouter.Services

<PageTitle>Organization Members</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-8">
    <div class="d-flex justify-space-between align-center flex-wrap gap-4 mb-6">
        <MudStack Row AlignItems="AlignItems.Center" Spacing="3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Rounded="true">
                <MudIcon Icon="@Icons.Material.Filled.People" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h4" HtmlTag="h1" Style="font-weight: 800;">Organization Members</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Manage access and roles for your organization</MudText>
            </div>
        </MudStack>

        @if (_canCreateMembers)
        {
            <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenInviteDialog" StartIcon="@Icons.Material.Filled.PersonAdd" Class="rounded-pill">
                Invite Member
            </MudButton>
        }
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-6 rounded-lg" ShowCloseIcon="true" CloseIconClicked="@(() => _errorMessage = null)">
            @_errorMessage
        </MudAlert>
    }

    <MudPaper Elevation="0" Class="pa-4 border-solid border-1 mud-border-lines-default rounded-xl overflow-hidden">
        <div class="d-flex gap-4 mb-6 flex-wrap">
            <MudTextField T="string" @bind-Value="_searchString"
                          Placeholder="Search members..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="rounded-pill"
                          Style="max-width: 400px;"/>

            <MudSelect T="int?" Label="Role" @bind-Value="_roleFilter" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter" Style="min-width: 150px;" Clearable="true" Class="rounded-pill">
                @foreach (var role in RoleHelper.GetAllOrgRoles())
                {
                    <MudSelectItem Value="(int?)role.Id">@role.Name</MudSelectItem>
                }
            </MudSelect>
        </div>

        <MudTable Items="@FilteredMembers" Hover="true" Loading="@_loading" Striped="true" Elevation="0" Class="border-none" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>User</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Role</MudTh>
                @if (HasAnyMemberActions)
                {
                    <MudTh Style="text-align:right">Actions</MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="User">
                    <div class="d-flex align-center gap-3">
                        <MudAvatar Color="Color.Secondary" Size="Size.Small" Variant="Variant.Filled">@(string.IsNullOrEmpty(context.UserEmail) ? "?" : context.UserEmail.Substring(0, 1).ToUpper())</MudAvatar>
                        @if (context.UserId == Guid.Empty)
                        {
                            <MudText Typo="Typo.body2" Style="font-style: italic;" Color="Color.Secondary">Pending Invite</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@(context.UserFullName ?? context.UserEmail)</MudText>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="Email">
                    <MudText Typo="Typo.body2">@context.UserEmail</MudText>
                </MudTd>
                <MudTd DataLabel="Role">
                    <MudChip T="string" Color="@GetRoleColor(context.RoleId ?? 0)" Size="Size.Small" Variant="Variant.Filled">@GetRoleName(context.RoleId ?? 0)</MudChip>
                </MudTd>
                @if (HasAnyMemberActions)
                {
                    <MudTd DataLabel="Actions" Style="text-align:right">
                        @if (CanEditMember(context) || CanDeleteMember(context))
                        {
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                @if (CanEditMember(context))
                                {
                                    <MudMenuItem OnClick="@(() => OpenEditRoleDialog(context))" Icon="@Icons.Material.Filled.Edit">Change Role</MudMenuItem>
                                }
                                @if (CanDeleteMember(context))
                                {
                                    <MudMenuItem OnClick="@(() => RemoveMember(context))" Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error">Remove</MudMenuItem>
                                }
                            </MudMenu>
                        }
                    </MudTd>
                }
            </RowTemplate>
            <NoRecordsContent>
                <div class="d-flex flex-column align-center justify-center pa-8">
                    <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Large" Color="Color.Default" />
                    <MudText Typo="Typo.h6" Class="mt-2" Style="font-weight: 700;">No members found</MudText>
                </div>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
</MudContainer>
