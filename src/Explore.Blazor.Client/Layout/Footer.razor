@* ABOUTME: Footer orchestrator component using template dispatch pattern (ADR-005).
   ABOUTME: Loads footer config from PublicExperienceService and delegates rendering to template components. *@
@using Explore.Blazor.Client.Layout.FooterTemplates
@inject IPublicExperienceService PublicExperienceService
@inject CookieConsentStateService CookieConsentState

@if (_footerEnabled)
{
    <div class="site-footer-root">
    <footer class="site-footer">
        <MudContainer MaxWidth="MaxWidth.Large" Class="site-footer__container">
            @switch (_template)
            {
                case "standard-2-col":
                    <FooterTemplateStandard2Col BrandDisplayName="@_brandDisplayName"
                                                BrandLogoUrl="@_brandLogoUrl"
                                                ShowDescription="@_showDescription"
                                                DescriptionText="@_descriptionText"
                                                ShowSocialLinks="@_showSocialLinks"
                                                SocialLinks="@_socialLinks"
                                                CopyrightText="@_copyrightText"
                                                ShowCookieSettingsLink="@_showCookieSettingsLink"
                                                LinkGroups="@_linkGroups"
                                                ShowCommunityGuidelinesLink="@_showCommunityGuidelinesLink"
                                                OnCookieSettingsClick="HandleCookieSettingsClick" />
                    break;
                case "minimal":
                    <FooterTemplateMinimal BrandDisplayName="@_brandDisplayName"
                                           BrandLogoUrl="@_brandLogoUrl"
                                           ShowDescription="@_showDescription"
                                           DescriptionText="@_descriptionText"
                                           ShowSocialLinks="@_showSocialLinks"
                                           SocialLinks="@_socialLinks"
                                           CopyrightText="@_copyrightText"
                                           ShowCookieSettingsLink="@_showCookieSettingsLink"
                                           LinkGroups="@_linkGroups"
                                           ShowCommunityGuidelinesLink="@_showCommunityGuidelinesLink"
                                           OnCookieSettingsClick="HandleCookieSettingsClick" />
                    break;
                case "community":
                    <FooterTemplateCommunity BrandDisplayName="@_brandDisplayName"
                                             BrandLogoUrl="@_brandLogoUrl"
                                             ShowDescription="@_showDescription"
                                             DescriptionText="@_descriptionText"
                                             ShowSocialLinks="@_showSocialLinks"
                                             SocialLinks="@_socialLinks"
                                             CopyrightText="@_copyrightText"
                                             ShowCookieSettingsLink="@_showCookieSettingsLink"
                                             LinkGroups="@_linkGroups"
                                             ShowCommunityGuidelinesLink="@_showCommunityGuidelinesLink"
                                             OnCookieSettingsClick="HandleCookieSettingsClick" />
                    break;
                default:
                    <FooterTemplateStandard3Col BrandDisplayName="@_brandDisplayName"
                                                BrandLogoUrl="@_brandLogoUrl"
                                                ShowDescription="@_showDescription"
                                                DescriptionText="@_descriptionText"
                                                ShowSocialLinks="@_showSocialLinks"
                                                SocialLinks="@_socialLinks"
                                                CopyrightText="@_copyrightText"
                                                ShowCookieSettingsLink="@_showCookieSettingsLink"
                                                LinkGroups="@_linkGroups"
                                                ShowCommunityGuidelinesLink="@_showCommunityGuidelinesLink"
                                                OnCookieSettingsClick="HandleCookieSettingsClick" />
                    break;
            }

            @if (!string.IsNullOrWhiteSpace(_paidEventDirectoryDisclaimer))
            {
                <aside class="site-footer__directory-notice"
                       role="note"
                       aria-label="Paid event directory notice"
                       data-testid="footer-paid-event-directory-disclaimer">
                    <MudText Typo="Typo.body2" HtmlTag="p"><span lang="en" dir="ltr">@_paidEventDirectoryDisclaimer</span></MudText>
                </aside>
            }
        </MudContainer>
    </footer>
    </div>
}

@code {
    private string _brandDisplayName = string.Empty;
    private string _brandLogoUrl = string.Empty;
    private string _template = "standard-3-col";
    private bool _footerEnabled = true;
    private bool _showDescription = true;
    private string _descriptionText = string.Empty;
    private bool _showSocialLinks = true;
    private List<FooterSocialLinkDto> _socialLinks = [];
    private string _copyrightText = string.Empty;
    private bool _showCookieSettingsLink = true;
    private List<FooterLinkGroupDto> _linkGroups = [];
    private bool _showCommunityGuidelinesLink;
    private string? _paidEventDirectoryDisclaimer;

    protected override async Task OnInitializedAsync()
    {
        var settings = await PublicExperienceService.GetCachedSettingsAsync();
        if (settings is null)
            return;

        _brandDisplayName = settings.BrandDisplayName ?? string.Empty;
        _brandLogoUrl = settings.BrandLogoUrl ?? string.Empty;
        _paidEventDirectoryDisclaimer = settings.PaidEventDirectoryDisclaimer;

        var footer = settings.FooterConfig;
        var footerSettings = footer?.Settings;
        _template = footerSettings?.Template ?? _template;
        _footerEnabled = footerSettings?.Enabled ?? _footerEnabled;
        _showDescription = footerSettings?.ShowDescription ?? _showDescription;
        _descriptionText = footerSettings?.DescriptionText ?? string.Empty;
        _showSocialLinks = footerSettings?.ShowSocialLinks ?? _showSocialLinks;
        _socialLinks = footerSettings?.SocialLinks?.ToList() ?? [];
        _showCookieSettingsLink = footerSettings?.ShowCookieSettingsLink ?? _showCookieSettingsLink;
        _linkGroups = footer?.LinkGroups?.ToList() ?? [];

        // Same rule as sidebar (MainLayout): show community guidelines when non-admin users can publish events
        _showCommunityGuidelinesLink = settings.AllowUserSubmittedEvents == true
            || settings.AllowOrganizationSubmittedEvents == true
            || settings.AllowGroupSubmittedEvents == true;

        _copyrightText = string.IsNullOrWhiteSpace(footerSettings?.CopyrightText)
            ? $"© {DateTime.Now.Year} {_brandDisplayName}. All rights reserved."
            : footerSettings.CopyrightText;
    }

    private async Task HandleCookieSettingsClick()
    {
        await CookieConsentState.RequestReopenAsync();
    }
}
