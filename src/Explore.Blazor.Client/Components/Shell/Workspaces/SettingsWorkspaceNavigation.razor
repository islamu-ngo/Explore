@* ABOUTME: Minimal placeholder navigation provider for the Settings workspace. *@
@* ABOUTME: Replaced with scope-aware navigation in Phase 6 per the approved plan. *@
@using Explore.Blazor.Client.Contracts.Services.Shell
@implements IWorkspaceNavigationProvider

<nav class="settings-workspace-navigation" aria-label="@AriaLabel" data-testid="settings-workspace-navigation">
    <MudNavMenu Dense="false" Class="px-2 pt-2">
        <div class="settings-workspace-navigation__header">
            <MudText Typo="Typo.h6" Class="settings-workspace-navigation__title">
                Settings
            </MudText>
        </div>
        <MudNavLink Href="/settings"
                    Icon="@Icons.Material.Filled.Person"
                    Match="NavLinkMatch.Prefix">
            Personal
        </MudNavLink>
    </MudNavMenu>
</nav>