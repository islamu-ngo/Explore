{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.AspNetCore.Authorization": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "EmailSettings": {
    "ApiKey": "",
    "FromName": "",
    "FromAddress": "contact@openislamu.org"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://iloveibadah.app"
    ]
  },
  "RateLimiting": {
    "Global": {
      "TokenLimit": 200,
      "ReplenishPeriodSeconds": 10,
      "TokensPerPeriod": 40
    },
    "Authenticated": {
      "PermitLimit": 200,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 4
    },
    "Write": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "PublicIngestion": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "ControlPlane": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "ConcurrencyLimit": 4,
      "QueueLimit": 0
    },
    "SetupSecret": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "RequestTimeouts": {
    "DefaultSeconds": 30,
    "LookupSeconds": 10,
    "ComplexSeconds": 60,
    "ControlPlaneSeconds": 20
  },
  "EmailDispatchProcessor": {
    "Enabled": true,
    "Mode": "TickerQ",
    "PollingIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxAttemptCount": 5,
    "InitialRetryDelaySeconds": 5,
    "MaxRetryDelaySeconds": 3600
  },
  "Scheduler": {
    "TickerQ": {
      "Enabled": true,
      "Schema": "ticker",
      "DashboardEnabled": false,
      "DashboardPath": "/admin/scheduler",
      "DashboardAuthorizationPolicy": "tickerq_instance_admin",
      "DashboardSessionTimeoutMinutes": 30
    }
  },
  "Cerbos": {
    "GrpcEndpoint": "http://localhost:3593",
    "PlaintextMode": true,
    "AdminApi": {
      "Endpoints": [],
      "AdminUsername": "",
      "AdminPassword": ""
    },
    "PolicyPackagePath": "cerbos/policies"
  }
}
