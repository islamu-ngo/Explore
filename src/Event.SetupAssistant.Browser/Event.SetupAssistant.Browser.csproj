<!-- ABOUTME: Defines the disabled package-free browser target contract shell. -->
<!-- ABOUTME: Successor B owns browser runtime selection, implementation, and activation. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SetupTargetEnabled>false</SetupTargetEnabled>
    <SetupTargetRole>ContractShell</SetupTargetRole>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Event.SetupAssistant\Event.SetupAssistant.csproj" />
  </ItemGroup>
</Project>
