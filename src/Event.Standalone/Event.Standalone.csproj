<!-- ABOUTME: Defines the optional .NET 10 single-process API and Blazor composition root. -->
<!-- ABOUTME: References both owning web hosts without adding persistence providers or copied assets. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CA1716</NoWarn>
    <UserSecretsId>event-shared-secrets</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StandaloneContainerPublish)' == 'true'">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <MvcEnhancedModelMetadataSupport>true</MvcEnhancedModelMetadataSupport>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <UseAppHost>true</UseAppHost>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Explore.API\Explore.API.csproj" />
    <ProjectReference Include="..\Explore.Blazor\Explore.Blazor.csproj" />
  </ItemGroup>

  <Target Name="CopyProviderMigrationsToOutput" AfterTargets="Build">
    <ItemGroup>
      <ProviderMigrationAssembly Include="$(MSBuildProjectDirectory)/../Explore.Persistence*.Migrations.*/bin/$(Configuration)/$(TargetFramework)/Explore.Persistence*.Migrations.*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ProviderMigrationAssembly)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyProviderMigrationsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <ProviderMigrationPublishAssembly Include="$(MSBuildProjectDirectory)/../Explore.Persistence*.Migrations.*/bin/$(Configuration)/$(TargetFramework)/Explore.Persistence*.Migrations.*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ProviderMigrationPublishAssembly)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
