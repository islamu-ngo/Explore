// ABOUTME: Supplies standalone-first SQLite persistence defaults for the combined web host.
// ABOUTME: Keeps standard structured Database overrides available through native .NET configuration.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "Database": "/app/data/event.db"
  },
  "Hosting": {
    "ReplicaCount": 1
  },
  "EmailDispatchProcessor": {
    "Mode": "HostedService"
  },
  "HttpsRedirection": {
    "HttpsPort": 7180
  }
}
