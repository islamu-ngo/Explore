{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.AspNetCore.Authorization": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "EmailSettings": {
    "ApiKey": "",
    "FromName": "",
    "FromAddress": "contact@openislamu.org"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://iloveibadah.app"
    ]
  },
  "RateLimiting": {
    "Global": {
      "TokenLimit": 200,
      "ReplenishPeriodSeconds": 10,
      "TokensPerPeriod": 40
    },
    "Authenticated": {
      "PermitLimit": 200,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 4
    },
    "Write": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "RequestTimeouts": {
    "DefaultSeconds": 30,
    "LookupSeconds": 10,
    "ComplexSeconds": 60
  }
}
