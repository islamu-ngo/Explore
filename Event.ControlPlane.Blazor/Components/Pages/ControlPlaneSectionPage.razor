@* ABOUTME: Provides temporary routed section placeholders for the separate control-plane host shell.
   ABOUTME: Keeps navigation functional while shared RCL pages and API adapters are implemented incrementally. *@
@page "/admin/instance/tenants"
@page "/admin/instance/domains"
@page "/admin/instance/onboarding"
@page "/admin/instance/health"
@page "/admin/instance/storage"
@page "/admin/instance/jobs"
@page "/admin/instance/security"
@page "/admin/instance/policies"
@attribute [Authorize]
@inject NavigationManager Navigation

<PageTitle>@Title - Event Control Plane</PageTitle>

<main class="cp-page">
    <header class="cp-page__header">
        <h1>@Title</h1>
        <p>This section is reserved for the shared control-plane implementation.</p>
    </header>

    <section class="cp-panel">
        <h2>Not connected yet</h2>
        <p>The separate BFF host is available. The section-specific API adapter and shared RCL page will be wired in a later slice.</p>
    </section>
</main>

@code {
    private string Title => Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').Split('/').LastOrDefault() switch
    {
        "tenants" => "Tenants",
        "domains" => "Domains",
        "onboarding" => "Onboarding",
        "health" => "Health",
        "storage" => "Storage",
        "jobs" => "Jobs",
        "security" => "Security",
        "policies" => "Policies",
        _ => "Control Plane"
    };
}
