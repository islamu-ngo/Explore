@using Explore.Domain.Common.Localization
@using Explore.Blazor.Client.Layout
@using Explore.Blazor.Client.Services
@using Microsoft.AspNetCore.Components.Web
@using System.Security.Cryptography
@inject IHttpContextAccessor HttpContextAccessor
@inject IRuntimeRenderPolicyService RuntimeRenderPolicyService
@inject ILogger<App> Logger

@{
    var cspNonce = Convert.ToBase64String(RandomNumberGenerator.GetBytes(32));
    var csp = string.Join(" ",
        "default-src 'self';",
        $"script-src 'self' 'wasm-unsafe-eval' 'unsafe-hashes' 'sha256-qnHnQs7NjQNHHNYv/I9cW+I62HzDJjbnyS/OFzqlix0=' 'nonce-{cspNonce}';",
        "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;",
        "connect-src 'self' https: http: ws: wss:;",
        "img-src 'self' data: https: blob:;",
        "font-src 'self' https://fonts.gstatic.com;",
        "object-src 'none';",
        "frame-ancestors 'self';",
        "base-uri 'self';",
        "form-action 'self';");
}

@{
    // Read the language cookie server-side for correct SSR lang/dir attributes.
    // Raw cookie values are never trusted: we resolve through CultureRegistry, which is the
    // compile-time allowlist. Anything outside it degrades to the canonical default ("en").
    var langCookie = HttpContextAccessor.HttpContext?.Request.Cookies["lang"];
    var pageLang = CultureRegistry.TryGetEntry(langCookie, out var resolvedEntry)
        ? resolvedEntry.Code
        : "en";
    var pageDir = RtlLanguages.IsRtl(pageLang) ? "rtl" : "ltr";
}

<!DOCTYPE html>
<html lang="@pageLang" dir="@pageDir">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta http-equiv="Content-Security-Policy" content="@csp">
	<base href="/" />
	<link href=@Assets["_content/MudBlazor/MudBlazor.min.css"] rel="stylesheet" />
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
	<link href="css/layers.css" rel="stylesheet" />
	<link href="Explore.Blazor.styles.css" rel="stylesheet" />
	<link rel="stylesheet" href="_content/Blazouter/blazouter.min.css" />
	<ImportMap nonce="@cspNonce" />
	<link rel="icon" type="image/ico" href="favicon.ico" />
	<HeadOutlet @rendermode="@_effectiveRenderMode" />
</head>

<body>
    @{
        var theme = HttpContextAccessor.HttpContext?.Request.Cookies["theme"];
        var isDark = theme == "dark";
    }

	<CascadingAuthenticationState>
        <CascadingValue Value="isDark" Name="InitialTheme">
            <ErrorBoundary>
                <ChildContent>
		            <Routes @rendermode="@_effectiveRenderMode" />
                </ChildContent>
                <ErrorContent Context="ex">
                    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
                            An unexpected error occurred. Please try refreshing the page.
                        </MudAlert>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="@(() => { })"
                                   Href="/"
                                   Class="mt-2">
                            Return to Home
                        </MudButton>
                    </MudContainer>
                </ErrorContent>
            </ErrorBoundary>
        </CascadingValue>
	</CascadingAuthenticationState>
	<script src="_framework/blazor.web.js"></script>
	<script src=@Assets["_content/MudBlazor/MudBlazor.min.js"]></script>
	<script src=@Assets["js/localization.js"]></script>
</body>

</html>

@code {
    // Resolved asynchronously from governance settings for non-onboarding paths.
    private IComponentRenderMode? _asyncResolvedMode;

    // Effective render mode used by Routes and HeadOutlet.
    // Onboarding paths are resolved synchronously from the request path — no async dependency.
    // Non-onboarding paths use the async-resolved governance settings with a safe default.
    private IComponentRenderMode _effectiveRenderMode
    {
        get
        {
            var path = HttpContextAccessor.HttpContext?.Request.Path.Value;
            if (IsOnboardingPath(path))
            {
                return new InteractiveServerRenderMode(prerender: true);
            }

            return _asyncResolvedMode ?? new InteractiveServerRenderMode(prerender: true);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var requestPath = HttpContextAccessor.HttpContext?.Request.Path.Value;

        // Onboarding paths don't need async resolution — handled synchronously in _effectiveRenderMode.
        if (IsOnboardingPath(requestPath))
        {
            return;
        }

        try
        {
            var decision = await RuntimeRenderPolicyService.ResolveForPathAsync(requestPath);
            _asyncResolvedMode = CreateRenderMode(decision.RenderMode, decision.PrerenderEnabled);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Falling back to default render policy for path {Path}", requestPath);
            _asyncResolvedMode = new InteractiveServerRenderMode(prerender: true);
        }
    }

    private static bool IsOnboardingPath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return false;
        }

        var normalized = path.Trim().TrimEnd('/').ToLowerInvariant();
        if (!normalized.StartsWith('/'))
        {
            normalized = "/" + normalized;
        }

        return normalized.StartsWith("/onboarding/", StringComparison.Ordinal) ||
               normalized.Equals("/setup", StringComparison.Ordinal) ||
               normalized.Equals("/startup", StringComparison.Ordinal);
    }

    private static IComponentRenderMode CreateRenderMode(string renderMode, bool prerenderEnabled)
    {
        if (renderMode.Equals("InteractiveWebAssembly", StringComparison.OrdinalIgnoreCase))
        {
            return new InteractiveWebAssemblyRenderMode(prerender: prerenderEnabled);
        }

        if (renderMode.Equals("InteractiveServer", StringComparison.OrdinalIgnoreCase))
        {
            return new InteractiveServerRenderMode(prerender: prerenderEnabled);
        }

        return new InteractiveAutoRenderMode(prerender: prerenderEnabled);
    }
}
