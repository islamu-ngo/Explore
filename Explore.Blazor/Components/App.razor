@using Explore.Blazor.Client.Layout
@using Explore.Blazor.Client.Services
@using Microsoft.AspNetCore.Components.Web
@using System.Security.Cryptography
@inject IHttpContextAccessor HttpContextAccessor
@inject IRuntimeRenderPolicyService RuntimeRenderPolicyService
@inject ILogger<App> Logger

@{
    var cspNonce = Convert.ToBase64String(RandomNumberGenerator.GetBytes(32));
    var csp = string.Join(" ",
        "default-src 'self';",
        $"script-src 'self' 'wasm-unsafe-eval' 'unsafe-hashes' 'sha256-qnHnQs7NjQNHHNYv/I9cW+I62HzDJjbnyS/OFzqlix0=' 'nonce-{cspNonce}';",
        "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;",
        "connect-src 'self' https: http: ws: wss:;",
        "img-src 'self' data: https: blob:;",
        "font-src 'self' https://fonts.gstatic.com;",
        "object-src 'none';",
        "frame-ancestors 'self';",
        "base-uri 'self';",
        "form-action 'self';");
}

<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta http-equiv="Content-Security-Policy" content="@csp">
	<base href="/" />
	<link href=@Assets["_content/MudBlazor/MudBlazor.min.css"] rel="stylesheet" />
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
	<link href="css/StyleGlobal.css" rel="stylesheet" />
	<link href="Explore.Blazor.styles.css" rel="stylesheet" />
	<link rel="stylesheet" href="_content/Blazouter/blazouter.min.css" />
	<ImportMap nonce="@cspNonce" />
	<link rel="icon" type="image/ico" href="favicon.ico" />
	<HeadOutlet @rendermode="@_appRenderMode" />
</head>

<body>
    @{
        var theme = HttpContextAccessor.HttpContext?.Request.Cookies["theme"];
        var isDark = theme == "dark";
    }

    @if (_showStartupLoader)
    {
        <div id="isl-startup-loader" class="isl-startup-loader" role="status" aria-live="polite" aria-label="Preparing interactive page">
            <div class="isl-startup-loader__panel">
                <div class="isl-startup-loader__spinner" aria-hidden="true"></div>
                <p class="isl-startup-loader__title">Preparing interactive page...</p>
                <p class="isl-startup-loader__subtitle">This screen unlocks as soon as WebAssembly is ready.</p>
            </div>
        </div>
    }

	<CascadingAuthenticationState>
        <CascadingValue Value="isDark" Name="InitialTheme">
            <ErrorBoundary>
                <ChildContent>
		            <Routes @rendermode="@_appRenderMode" />
                </ChildContent>
                <ErrorContent Context="ex">
                    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
                            An unexpected error occurred. Please try refreshing the page.
                        </MudAlert>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="@(() => { })"
                                   Href="/"
                                   Class="mt-2">
                            Return to Home
                        </MudButton>
                    </MudContainer>
                </ErrorContent>
            </ErrorBoundary>
        </CascadingValue>
	</CascadingAuthenticationState>
	<script nonce="@cspNonce">
        window.ExploreBootstrap = window.ExploreBootstrap || {};
        window.ExploreBootstrap.markLoaderAsSlow = function () {
            var loader = document.getElementById("isl-startup-loader");
            if (!loader || loader.classList.contains("isl-startup-loader--hidden")) {
                return;
            }

            var subtitle = loader.querySelector(".isl-startup-loader__subtitle");
            if (subtitle) {
                subtitle.textContent = "Still loading. If this takes too long, refresh once.";
            }
        };

        window.ExploreBootstrap.hideLoader = function () {
            var loader = document.getElementById("isl-startup-loader");
            if (!loader) {
                return;
            }

            loader.classList.add("isl-startup-loader--hidden");
            window.setTimeout(function () {
                if (loader && loader.parentNode) {
                    loader.parentNode.removeChild(loader);
                }
            }, 260);
        };

        window.setTimeout(function () {
            window.ExploreBootstrap.markLoaderAsSlow();
        }, 10000);
    </script>
	<script src="_framework/blazor.web.js"></script>
	<script src=@Assets["_content/MudBlazor/MudBlazor.min.js"]></script>
</body>

</html>

@code {
    private IComponentRenderMode _appRenderMode = new InteractiveAutoRenderMode(prerender: true);
    private bool _showStartupLoader;

    protected override async Task OnParametersSetAsync()
    {
        var requestPath = HttpContextAccessor.HttpContext?.Request.Path.Value;

        try
        {
            var decision = await RuntimeRenderPolicyService.ResolveForPathAsync(requestPath);
            _appRenderMode = CreateRenderMode(decision.RenderMode, decision.PrerenderEnabled);

            // InteractiveServer connects via SignalR in <1s — no WASM download,
            // so the full-page startup loader is never needed. Only show it for
            // InteractiveAuto/WebAssembly without prerender (blank screen while WASM downloads).
            _showStartupLoader = !decision.PrerenderEnabled &&
                !decision.RenderMode.Equals("InteractiveServer", StringComparison.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Falling back to default render policy for path {Path}", requestPath);
            _appRenderMode = new InteractiveAutoRenderMode(prerender: false);
            _showStartupLoader = true;
        }
    }

    private static IComponentRenderMode CreateRenderMode(string renderMode, bool prerenderEnabled)
    {
        if (renderMode.Equals("InteractiveWebAssembly", StringComparison.OrdinalIgnoreCase))
        {
            return new InteractiveWebAssemblyRenderMode(prerender: prerenderEnabled);
        }

        if (renderMode.Equals("InteractiveServer", StringComparison.OrdinalIgnoreCase))
        {
            return new InteractiveServerRenderMode(prerender: prerenderEnabled);
        }

        return new InteractiveAutoRenderMode(prerender: prerenderEnabled);
    }
}
