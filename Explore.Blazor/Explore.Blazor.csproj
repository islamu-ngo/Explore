<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>event-shared-secrets</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- .NET 10: Prevent NavigateTo from throwing NavigationException during SSR prerender.
         Enabled by default in new .NET 10 templates but required for upgraded projects. -->
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
	<!--<BdtSkipComponents>ItemContent;MudTimelineItem;MudDialog</BdtSkipComponents>-->
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Explore.Blazor.Client\Pages\Event\Component.razor" Link="Component.razor" />
  </ItemGroup>


