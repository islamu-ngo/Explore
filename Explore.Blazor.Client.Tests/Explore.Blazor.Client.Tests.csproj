<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Allow version downgrades for transitive dependencies -->
    <NoWarn>$(NoWarn);NU1605</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Explore.Blazor.Client\Explore.Blazor.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Explore.Blazor\Services\CircuitAccessTokenService.cs" Link="Server\CircuitAccessTokenService.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testing Framework -->
    <PackageReference Include="TUnit" />

    <!-- BUnit for Blazor Component Testing -->
    <PackageReference Include="bunit" />

    <!-- Mocking -->
    <PackageReference Include="NSubstitute" />

    <!-- Data Generation -->
    <PackageReference Include="Bogus" />

    <!-- MudBlazor Testing Support (same version as client) -->
    <PackageReference Include="MudBlazor" />

    <!-- Needed by linked server token service tests -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
