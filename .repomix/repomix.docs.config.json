{
  "include": [
    "schemas/**/*",
    "docs/**/*",
    "README.md",
    "CLAUDE.md",
    "AGENTS.md",
    "docker-compose.yml",
    "global.json",
    "Directory.Build.props",
    "Directory.Packages.props",
    "dotnet-tools.json"
  ],
  "output": {
    "style": "markdown",
    "filePath": ".repomix/repomix-docs.md",
    "showLineNumbers": false,
    "topFilesLength": 50,
    "copyToClipboard": false
  },
  "ignore": {
    "customPatterns": [
      ".claude/hooks/**/*",
      "**/*.log",
      ".env*",
      ".mcp.json",
      ".copilot/mcp-config.json",
      ".codex/config.toml"
    ],
    "useGitignore": true,
    "useDefaultPatterns": true
  }
}
