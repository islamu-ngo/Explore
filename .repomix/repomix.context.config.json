{
  "include": [
    "docs/**/*",
    "dev/_journal/**/*",
    "README.md",
    "CLAUDE.md",
    "AGENTS.md",
    ".claude",
    ".claude/commands/dev-docs.md",
    ".claude/commands/dev-docs-update.md",
    ".claude/commands/plan.md",
    ".claude/commands/task.md",
    ".github/copilot-instructions.md",
    ".claude/agents/**/*",
    ".claude/contract/**/*",
    ".claude/settings.json",
    ".claude/rules/**/*",
    ".claude/skills/**/*",
    ".claude/settings.json",
    ".codex/rules/**/*"
  ],
  "output": {
    "style": "markdown",
    "filePath": ".repomix/repomix-context.md",
    "showLineNumbers": false,
    "topFilesLength": 50,
    "copyToClipboard": false
  },
  "ignore": {
    "customPatterns": [
      "docs/semantic_versioning/**/*",
      "docs/docs-website/**/*",
      ".claude/hooks/**/*",
      ".claude/commands/",
      ".claude/build-cache/**",
      ".claude/context-state.json",
      ".claude/settings.local.json",
      ".repomix/*.md",
      ".mcp.json",
      ".copilot/mcp-config.json",
      ".codex/config.toml",
      "**/*.log",
      ".env*"
    ],
    "useGitignore": true,
    "useDefaultPatterns": true
  }
}
