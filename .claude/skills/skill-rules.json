{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "2.0",
  "description": "Skill activation triggers for .NET Clean Architecture solutions (API, Application, Persistence, Blazor).",
  "customizationNote": "Patterns are project-agnostic by default. If your solution uses non-standard naming, adjust path patterns to your folder structure.",
  "lastUpdated": "2026-01-19",
  "skills": {
    "clean-architecture-rules": {
      "type": "guardrail",
      "enforcement": "block",
      "priority": "critical",
      "description": "Enforces Clean Architecture dependency rules (Domain → Application → Infrastructure → API/Blazor). Blocks violations to maintain architectural integrity.",
      "promptTriggers": {
        "keywords": [
          "dependency",
          "reference",
          "architecture",
          "layer",
          "clean architecture",
          "domain logic",
          "ef core",
          "dbcontext",
          "violation"
        ],
        "intentPatterns": [
          "(add|create|reference).*?(dependency|project|layer)",
          "(where).*?(logic|entity|dto).*?(go|belong)",
          "fix.*?(dependency|reference).*?error"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/*Domain/**/*.cs",
          "**/*Application/**/*.cs"
        ],
        "contentPatterns": [
          "using.*Infrastructure",
          "using.*Api",
          "using.*Microsoft.AspNetCore.Mvc"
        ]
      },
      "blockMessage": "⚠️ BLOCKED - Clean Architecture Violation\n\n📋 VIOLATION DETECTED:\nYou are attempting to add a reference that violates the Dependency Rule.\n\n**Allowed Dependencies:**\n1. **Domain** → Cannot reference ANY other layer\n2. **Application** → Can only reference **Domain**\n3. **Infrastructure** → References **Application** and **Domain**\n4. **API/Blazor** → References **Application** and **Infrastructure**\n\n**Required Action:**\n1. Review the `clean-architecture-rules` skill\n2. Move logic to the correct layer (interfaces in Application, implementations in Infrastructure)",
      "skipConditions": {
        "sessionSkillUsed": true,
        "fileMarkers": ["@skip-architecture-check"]
      }
    },
    "cqrs-mediatr-guidelines": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "CQRS (Command Query Responsibility Segregation) patterns with MediatR. Covers commands, queries, handlers, validation, and pipeline behaviors.",
      "promptTriggers": {
        "keywords": [
          "command",
          "query",
          "handler",
          "mediatr",
          "cqrs",
          "validation",
          "validator",
          "pipeline",
          "behavior",
          "feature",
          "use case"
        ],
        "intentPatterns": [
          "(create|add|implement).*?(feature|endpoint|use case)",
          "(handle|validate).*?(request|command|query)",
          "(how to).*?(mediatr|cqrs)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/*Application/**/*Handler.cs",
          "**/*Application/**/*Command.cs",
          "**/*Application/**/*Query.cs",
          "**/*Application/**/*Validator.cs",
          "**/*Application/**/*Request.cs"
        ],
        "contentPatterns": [
          "IRequest",
          "IRequestHandler",
          "AbstractValidator",
          "FluentValidation",
          "BaseCommandResponse"
        ]
      }
    },
    "blazor-ui-conventions": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Comprehensive Blazor UI conventions including MudBlazor components, BEM CSS methodology, theming, render modes, state management, and component patterns.",
      "promptTriggers": {
        "keywords": [
          "blazor",
          "component",
          "razor",
          "mudblazor",
          "blazouter",
          "route guard",
          "ui",
          "page",
          "dialog",
          "render",
          "parameter",
          "eventcallback",
          "theme",
          "css",
          "state",
          "lifecycle"
        ],
        "intentPatterns": [
          "(create|fix|style).*?(component|page|ui|button|grid|form)",
          "(how to).*?(blazor|mudblazor)",
          "(render|lifecycle).*?(issue|bug|mode)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/*.razor",
          "**/*.razor.cs",
          "**/*Blazor/**/*.cs",
          "**/*Blazor.Client/**/*.cs",
          "**/*.css",
          "**/*.scss"
        ],
        "contentPatterns": [
          "<Mud",
          "Blazouter",
          "@page",
          "@inject",
          "[Parameter]",
          "CascadingValue",
          "EventCallback",
          "@rendermode"
        ]
      }
    },
    "blazor-bff-patterns": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Backend-for-Frontend (BFF) patterns for Blazor including YARP proxy, token forwarding, cookie management, and service layer patterns.",
      "promptTriggers": {
        "keywords": [
          "bff",
          "yarp",
          "proxy",
          "interactiveauto",
          "antiforgery",
          "token forwarding",
          "cookie",
          "api client",
          "service layer",
          "nswag"
        ],
        "intentPatterns": [
          "(configure|setup).*?(bff|proxy|yarp)",
          "(forward|pass).*?(token|auth)",
          "(call|consume).*?api"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/*Blazor/Program.cs",
          "**/*Blazor/Services/**/*.cs",
          "**/*Blazor.Client/Services/**/*.cs",
          "**/*Blazor.Client/Clients/**/*.cs"
        ],
        "contentPatterns": [
          "AddReverseProxy",
          "AccessTokenForwardingHandler",
          "AddAntiforgery",
          "ApiClient",
          "HttpClient"
        ]
      }
    },
    "auth-patterns": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Authentication and authorization patterns for OIDC/JWT APIs, including claim extraction and endpoint authorization.",
      "promptTriggers": {
        "keywords": [
          "auth",
          "authentication",
          "authorization",
          "keycloak",
          "oidc",
          "token",
          "jwt",
          "claim",
          "role",
          "policy",
          "cookies",
          "user id"
        ],
        "intentPatterns": [
          "(login|logout|auth).*?(issue|fail|error)",
          "(check|verify|debug|extract).*?(token|claim|role|user)",
          "(configure).*?(keycloak|oidc|auth)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/*API/Program.cs",
          "**/*Api/Program.cs",
          "**/Program.cs",
          "**/appsettings*.json",
          "**/*Controller.cs"
        ],
        "contentPatterns": [
          "AddAuthentication",
          "AddOpenIdConnect",
          "[Authorize]",
          "[AllowAnonymous]",
          "ClaimTypes",
          "JwtBearer",
          "GetRequiredUserId"
        ]
      }
    },
    "dotnet-efcore-guidelines": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "EF Core patterns for PostgreSQL including DbContext configuration, entity mappings, migrations, repository pattern, and querying best practices.",
      "promptTriggers": {
        "keywords": [
          "database",
          "postgres",
          "postgresql",
          "migration",
          "dbcontext",
          "entity",
          "relationship",
          "foreign key",
          "index",
          "seeding",
          "repository",
          "include",
          "navigation"
        ],
        "intentPatterns": [
          "(add|modify|create).*?(table|column|entity|migration)",
          "(run|create|apply).*?(migration)",
          "(configure).*?(db|context|connection|relationship)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/*Persistence/**/*.cs",
          "**/*DbContext.cs",
          "**/*Configuration.cs",
          "**/*Repository.cs"
        ],
        "contentPatterns": [
          "DbSet<",
          "IEntityTypeConfiguration",
          "OnModelCreating",
          "UseNpgsql",
          "HasQueryFilter",
          "Include("
        ]
      }
    },
    "error-tracking": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "Error tracking and observability patterns for API and application services including exception handling and performance monitoring.",
      "promptTriggers": {
        "keywords": [
          "error",
          "exception",
          "sentry",
          "logging",
          "monitoring",
          "error boundary",
          "performance"
        ],
        "intentPatterns": [
          "(track|log|capture).*?(error|exception)",
          "(add|configure).*?(sentry|error handling)",
          "(monitor).*?(performance)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/Program.cs",
          "**/*Controller.cs",
          "**/*Handler.cs"
        ],
        "contentPatterns": [
          "SentrySdk",
          "try.*catch",
          "ILogger",
          "ErrorBoundary"
        ]
      }
    }
  },
  "architectureLayers": {
    "Domain": {
      "project": "{Project}.Domain",
      "description": "Core business logic, entities, enums, value objects. No external dependencies.",
      "allowedDependencies": []
    },
    "Application": {
      "project": "{Project}.Application",
      "description": "Use cases, CQRS handlers, DTOs, interfaces, validation. Orchestrates domain logic.",
      "allowedDependencies": ["Domain"]
    },
    "Infrastructure": {
      "projects": ["{Project}.Persistence", "{Project}.Infrastructure"],
      "description": "Database access, external services, repository implementations.",
      "allowedDependencies": ["Application", "Domain"]
    },
    "Presentation": {
      "projects": ["{Project}.API", "{Project}.Blazor", "{Project}.Blazor.Client"],
      "description": "REST API controllers, Blazor UI components. Entry points to the application.",
      "allowedDependencies": ["Application", "Infrastructure"]
    }
  }
}
