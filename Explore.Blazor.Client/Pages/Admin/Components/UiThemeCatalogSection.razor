@* ABOUTME: Shared admin section for managing the UI theme catalog (platform or tenant scope). *@
@* ABOUTME: Lists themes with palette previews and exposes Create, Edit, Delete actions via UiThemeEditorDialog. *@

@using MudBlazor
@using System.Net.Http.Json
@using Explore.Blazor.Client.Models.Appearance

<div class="settings-section ui-theme-catalog">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">
            @(IsPlatformCatalog ? "Platform Themes" : "Tenant Themes")
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            @(IsPlatformCatalog
                ? "Platform-wide themes available to every tenant. Exactly one may be marked default."
                : "Themes owned by this tenant, available alongside the platform catalog. Exactly one tenant theme may be default.")
        </MudText>
    </div>

    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @(_themes is null ? "Loading..." : $"{_themes.Count} theme(s)")
            </MudText>
            <MudStack Row="true" Spacing="2">
                <MudSwitch T="bool" @bind-Value="_activeOnly" Color="Color.Primary"
                           Label="Active only" LabelPosition="LabelPosition.End"
                           @bind-Value:after="ReloadAsync" />
                <MudButton StartIcon="@Icons.Material.Filled.Add"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="OpenCreateDialogAsync">
                    New theme
                </MudButton>
            </MudStack>
        </MudStack>

        @if (_loading)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Loading themes...</MudText>
            </MudStack>
        }
        else if (_themes is null || _themes.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                No themes yet. Click "New theme" to create one.
            </MudAlert>
        }
        else
        {
            <MudGrid Spacing="2">
                @foreach (var theme in _themes)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper Class="ui-theme-catalog__card" Elevation="0" Outlined="true">
                            <MudStack Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">
                                        @theme.DisplayName
                                    </MudText>
                                    <MudStack Row="true" Spacing="1">
                                        @if (theme.IsDefault)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                                Default
                                            </MudChip>
                                        }
                                        @if (!theme.IsActive)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                                Inactive
                                            </MudChip>
                                        }
                                    </MudStack>
                                </MudStack>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @(theme.ThemeKey)
                                </MudText>
                                <div class="ui-theme-catalog__swatches">
                                    <span class="ui-theme-catalog__chip"
                                          style="@($"background: {theme.LightPalette.Primary};")"
                                          title="Light primary"></span>
                                    <span class="ui-theme-catalog__chip"
                                          style="@($"background: {theme.LightPalette.Surface}; border-color: {theme.LightPalette.LinesDefault};")"
                                          title="Light surface"></span>
                                    <span class="ui-theme-catalog__chip"
                                          style="@($"background: {theme.DarkPalette.Primary};")"
                                          title="Dark primary"></span>
                                    <span class="ui-theme-catalog__chip"
                                          style="@($"background: {theme.DarkPalette.Surface}; border-color: {theme.DarkPalette.LinesDefault};")"
                                          title="Dark surface"></span>
                                </div>
                                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenEditDialogAsync(theme.Id))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => DeleteAsync(theme))"
                                                   Disabled="@(theme.IsDefault)" />
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudStack>
</div>

@code {
    [Parameter, EditorRequired] public bool IsPlatformCatalog { get; set; }

    [Inject] private HttpClient Http { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;
    [Inject] private ILogger<UiThemeCatalogSection> Logger { get; set; } = null!;

    private List<UiThemeListItemModel>? _themes;
    private bool _loading = true;
    private bool _activeOnly;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var url = $"/api/admin/ui-themes?IsPlatformCatalog={IsPlatformCatalog.ToString().ToLowerInvariant()}&ActiveOnly={_activeOnly.ToString().ToLowerInvariant()}";
            var themes = await Http.GetFromJsonAsync<List<UiThemeListItemModel>>(url);
            _themes = themes ?? new List<UiThemeListItemModel>();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load UI theme catalog");
            Snackbar.Add($"Could not load themes: {ex.Message}", Severity.Error);
            _themes = new List<UiThemeListItemModel>();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialogAsync()
    {
        var parameters = new DialogParameters
        {
            ["Existing"] = null,
            ["IsPlatformCatalog"] = IsPlatformCatalog,
            ["AllowPlatformToggle"] = false
        };

        var dialog = await DialogService.ShowAsync<UiThemeEditorDialog>(
            IsPlatformCatalog ? "Create Platform Theme" : "Create Tenant Theme",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await ReloadAsync();
        }
    }

    private async Task OpenEditDialogAsync(Guid id)
    {
        try
        {
            var details = await Http.GetFromJsonAsync<UiThemeDetailsModel>($"/api/admin/ui-themes/{id}");
            if (details is null)
            {
                Snackbar.Add("Theme could not be loaded.", Severity.Warning);
                return;
            }

            var parameters = new DialogParameters
            {
                ["Existing"] = details,
                ["IsPlatformCatalog"] = IsPlatformCatalog,
                ["AllowPlatformToggle"] = false
            };

            var dialog = await DialogService.ShowAsync<UiThemeEditorDialog>(
                $"Edit theme: {details.DisplayName}",
                parameters,
                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });

            var result = await dialog.Result;
            if (result is { Canceled: false })
            {
                await ReloadAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to open theme editor for {ThemeId}", id);
            Snackbar.Add($"Could not open editor: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteAsync(UiThemeListItemModel theme)
    {
        var id = theme.Id;
        if (id == Guid.Empty) return;

        var confirm = await DialogService.ShowMessageBoxAsync(
            "Delete theme",
            $"Delete theme '{theme.DisplayName}'? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel",
            options: new DialogOptions { CloseOnEscapeKey = true });

        if (confirm != true) return;

        try
        {
            using var response = await Http.DeleteAsync($"/api/admin/ui-themes/{id}");
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Theme deleted.", Severity.Success);
                await ReloadAsync();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Delete failed ({(int)response.StatusCode}): {body}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete theme {ThemeId}", id);
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
    }
}
