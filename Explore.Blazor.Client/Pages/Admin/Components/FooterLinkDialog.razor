@* ABOUTME: Dialog for creating and editing individual footer links within a group. *@
@* ABOUTME: Follows TenantNavigationDialog pattern with EditForm validation and DialogResult dispatch. *@

@using Explore.Blazor.Client.Contracts.Services.Footer
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(_isEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-3 mb-n1" />
            @(_isEdit ? "Edit Link" : "Add Link")
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm EditContext="_editContext">
            <FluentValidationValidator />
            <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="_model.Label"
                          Label="Label"
                          For="@(() => _model.Label)"
                          Required="true"
                          RequiredError="Label is required."
                          Placeholder="e.g., About Us" />

            <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="_model.Url"
                          Label="URL"
                          For="@(() => _model.Url)"
                          Required="true"
                          RequiredError="URL is required."
                          Placeholder="e.g., https://example.com/about" />

            <MudCheckBox T="bool" @bind-Value="_model.OpenInNewTab"
                         Label="Open in new tab"
                         Color="Color.Primary" />

            @if (_isEdit)
            {
                <MudCheckBox T="bool" @bind-Value="_isActive"
                             Label="Active"
                             Color="Color.Primary" />
            }
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" OnClick="Cancel">Cancel</MudButton>
        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@(_isEdit ? "Update" : "Add")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IDialogReference? DialogReference { get; set; }

    [Parameter]
    public FooterLinkDetailModel? ExistingLink { get; set; }

    private EditContext _editContext = default!;
    private bool _isEdit;
    private bool _isActive = true;
    private CreateFooterLinkModel _model = new();

    protected override void OnInitialized()
    {
        _isEdit = ExistingLink != null;

        if (_isEdit && ExistingLink != null)
        {
            _model.Label = ExistingLink.Label;
            _model.Url = ExistingLink.Url;
            _model.OpenInNewTab = ExistingLink.OpenInNewTab;
            _isActive = true;
        }

        _editContext = new EditContext(_model);
    }

    private void Submit()
    {
        if (_editContext.Validate())
        {
            if (_isEdit && ExistingLink != null)
            {
                var updateModel = new UpdateFooterLinkModel
                {
                    Label = _model.Label,
                    Url = _model.Url,
                    OpenInNewTab = _model.OpenInNewTab,
                    IsActive = _isActive
                };
                DialogReference?.Dismiss(DialogResult.Ok(updateModel));
            }
            else
            {
                DialogReference?.Dismiss(DialogResult.Ok(_model));
            }
        }
    }

    private void Cancel() => DialogReference?.Dismiss(DialogResult.Cancel());
}
