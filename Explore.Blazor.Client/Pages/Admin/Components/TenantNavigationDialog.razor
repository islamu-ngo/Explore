@using Explore.Blazor.Client.Contracts.Services.Organizations
@using FluentValidation
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(_isEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-3 mb-n1" />
            @(_isEdit ? "Edit Navigation Link" : "Create Navigation Link")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="success" Model="linkDto">
            <MudTextField @bind-Value="linkDto.Label" 
                          Label="Label" 
                          For="@(() => linkDto.Label)" 
                          Required="true" 
                          RequiredError="Label is required." 
                          Placeholder="e.g., About Us" />
            
            <MudTextField @bind-Value="linkDto.Url" 
                          Label="URL" 
                          For="@(() => linkDto.Url)" 
                          Required="true" 
                          RequiredError="URL is required." 
                          Placeholder="e.g., https://example.com/about" />
            
            <MudTextField @bind-Value="linkDto.Icon" 
                          Label="Icon (Material Design)" 
                          Placeholder="Leave empty to use default Link icon" 
                          HelperText="e.g., Icons.Material.Filled.Info" />
            
            <MudCheckBox T="bool" @bind-Checked="linkDto.OpenInNewTab" 
                         Label="Open in new tab" 
                         Color="Color.Primary" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">@(_isEdit ? "Update" : "Create")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IDialogReference? DialogReference { get; set; }

    [Parameter]
    public TenantNavigationLinkDto? ExistingLink { get; set; }

    private MudForm form = null!;
    private bool success;
    private bool _isEdit;
    private CreateTenantNavigationLinkDto linkDto = new();

    protected override void OnInitialized()
    {
        _isEdit = ExistingLink != null;
        
        if (_isEdit && ExistingLink != null)
        {
            linkDto.Label = ExistingLink.Label;
            linkDto.Url = ExistingLink.Url;
            linkDto.Icon = ExistingLink.Icon;
            linkDto.OpenInNewTab = ExistingLink.OpenInNewTab;
        }
    }

    private async Task Submit()
    {
        await form.Validate();
        if (form.IsValid)
        {
            if (_isEdit && ExistingLink != null)
            {
                var updateDto = new UpdateTenantNavigationLinkDto
                {
                    Id = ExistingLink.Id,
                    Label = linkDto.Label,
                    Url = linkDto.Url,
                    Icon = linkDto.Icon,
                    OpenInNewTab = linkDto.OpenInNewTab
                };
                DialogReference?.Dismiss(DialogResult.Ok(updateDto));
            }
            else
            {
                DialogReference?.Dismiss(DialogResult.Ok(linkDto));
            }
        }
    }

    private void Cancel() => DialogReference?.Dismiss(DialogResult.Cancel());
}
