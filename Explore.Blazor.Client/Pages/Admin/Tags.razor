@page "/admin/tags"
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services.Contracts
@using Explore.Blazor.Client.Components.Admin
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@attribute [StreamRendering]

<div class="admin-tags">
    <!-- Hero Section -->
    <MudPaper Class="admin-tags__hero" Elevation="0">
        <div class="admin-tags__hero-top">
            <div class="admin-tags__hero-title">
                <div class="admin-tags__hero-badge">
                    <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Color="Color.Primary" />
                </div>
                <div>
                    <MudText Typo="Typo.h4" Class="admin-tags__title-text">
                        Tags Management
                    </MudText>
                    <MudText Typo="Typo.body2" Class="admin-tags__hero-subtitle">
                        Create, edit, and manage event tags
                    </MudText>
                </div>
            </div>

            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => Nav.NavigateTo("/admin"))"
                           Class="admin-tags__action-btn">
                    Back to Admin
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadTags"
                           Class="admin-tags__action-btn">
                    Refresh
                </MudButton>
            </MudStack>
        </div>

        <!-- Stats -->
        <div class="admin-tags__stats">
            <div class="admin-tags__stat">
                <div class="admin-tags__stat-row">
                    <div class="admin-tags__stat-icon">
                        <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Color="Color.Primary" />
                    </div>
                    <div>
                        <div class="admin-tags__stat-label">Total Tags</div>
                        <div class="admin-tags__stat-value">@_tags.Count</div>
                    </div>
                </div>
            </div>
        </div>
    </MudPaper>

    @if (_isLoading)
    {
        <MudPaper Class="admin-tags__panel" Elevation="0">
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="py-4">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.body1">Loading tags…</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <div class="admin-tags__section">
            <!-- Toolbar -->
            <MudPaper Class="admin-tags__panel" Elevation="0">
                <div class="admin-tags__toolbar">
                    <MudTextField @bind-Value="_searchString"
                                  Placeholder="Search tags..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Clearable="true"
                                  Margin="Margin.Dense"
                                  Class="admin-tags__search-field" />

                    <MudSpacer />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateDialog"
                               Class="admin-tags__create-btn">
                        Create Tag
                    </MudButton>
                </div>
            </MudPaper>

            <!-- Table -->
            <MudPaper Class="admin-tags__table-panel" Elevation="0">
                <MudTable Items="@FilteredTags"
                          Dense="true"
                          Hover="true"
                          Striped="true"
                          Breakpoint="Breakpoint.Sm"
                          Loading="@_isLoading"
                          LoadingProgressColor="Color.Primary">
                    <HeaderContent>
                        <MudTh Class="admin-tags__col-id">#</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Master Code</MudTh>
                        <MudTh Class="admin-tags__col-actions">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="#">
                            <MudText Typo="Typo.body2" Class="admin-tags__id">@context.Id.ToString()[..8]…</MudText>
                        </MudTd>
                        <MudTd DataLabel="Name">
                            <div class="admin-tags__name-cell">
                                <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Small" Color="Color.Primary" />
                                <MudText Typo="Typo.body2" Class="admin-tags__name-text">@context.FullName</MudText>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Code">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                @context.MasterCode
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Actions" Class="admin-tags__cell-actions">
                            <div class="admin-tags__actions">
                                <MudTooltip Text="Edit">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenEditDialog(context))" />
                                </MudTooltip>
                                <MudTooltip Text="Delete">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => DeleteTag(context))" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="admin-tags__empty">
                            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Large" />
                            <MudText Typo="Typo.h6" Class="admin-tags__empty-title">No tags found</MudText>
                            <MudText Typo="Typo.body2" Class="admin-tags__muted">
                                @if (string.IsNullOrWhiteSpace(_searchString))
                                {
                                    <span>Create your first tag to get started.</span>
                                }
                                else
                                {
                                    <span>No tags match your search criteria.</span>
                                }
                            </MudText>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="OpenCreateDialog"
                                       Class="admin-tags__empty-btn">
                                Create Tag
                            </MudButton>
                        </div>
                    </NoRecordsContent>

                </MudTable>
            </MudPaper>
        </div>
    }
</div>
