@using MudBlazor
@using Explore.Blazor.Client.Clients;
@using Explore.Blazor.Client.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IAdminService AdminService
@inject IUserService UserService
@inject ILogger<AdminList> Logger
<div class="admin-list">

    <!-- HERO -->
    <MudPaper Class="admin-list__hero" Elevation="0">
        <div class="admin-list__hero-top">
            <div>
                <div class="admin-list__hero-title">
                    <div class="admin-list__hero-badge">
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Primary" />
                    </div>
                    <div>
                        <MudText Typo="Typo.h4" Style="font-weight:800; letter-spacing:.2px;">
                            Admin Dashboard
                        </MudText>
                        <MudText Typo="Typo.body2" Class="admin-list__hero-subtitle">
                            Review and action incoming organization requests
                        </MudText>
                    </div>
                </div>
            </div>

            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadOrganizationRequests"
                           Style="border-radius:999px; padding:10px 16px;">
                    Refresh
                </MudButton>
            </MudStack>
        </div>

        <!-- STATS -->
        <div class="admin-list__stats">
            <div class="admin-list__stat">
                <div class="admin-list__stat-row">
                    <div class="admin-list__stat-icon admin-list__stat-icon--pending">
                        <MudIcon Icon="@Icons.Material.Filled.HourglassBottom" Color="Color.Info" />
                    </div>
                    <div>
                        <div class="admin-list__stat-label">Pending</div>
                        <div class="admin-list__stat-value">@PendingCount</div>
                    </div>
                </div>
            </div>

            <div class="admin-list__stat">
                <div class="admin-list__stat-row">
                    <div class="admin-list__stat-icon admin-list__stat-icon--approved">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                    </div>
                    <div>
                        <div class="admin-list__stat-label">Approved</div>
                        <div class="admin-list__stat-value">@ApprovedCount</div>
                    </div>
                </div>
            </div>

            <div class="admin-list__stat">
                <div class="admin-list__stat-row">
                    <div class="admin-list__stat-icon admin-list__stat-icon--rejected">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" />
                    </div>
                    <div>
                        <div class="admin-list__stat-label">Rejected</div>
                        <div class="admin-list__stat-value">@RejectedCount</div>
                    </div>
                </div>
            </div>
        </div>
    </MudPaper>

    <!-- LOOKUP TABLES NAVIGATION -->
    <div class="admin-list__lookup-section">
        <div class="admin-list__section-head">
            <div>
                <MudText Typo="Typo.h5" Style="font-weight:800;">Lookup Tables</MudText>
                <MudText Typo="Typo.body2" Class="admin-list__muted">
                    Manage system data and configurations
                </MudText>
            </div>
        </div>

        <div class="admin-list__lookup-grid">
            <!-- CRUD Tables (Full Edit Access) -->
            <MudPaper Class="admin-list__lookup-card admin-list__lookup-card--crud" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/tags"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--tags">
                    <MudIcon Icon="@Icons.Material.Filled.LocalOffer" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Tags</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">Create, edit, delete tags</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">CRUD</MudChip>
            </MudPaper>

            <MudPaper Class="admin-list__lookup-card admin-list__lookup-card--crud" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/categories"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--categories">
                    <MudIcon Icon="@Icons.Material.Filled.Category" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Categories</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">Manage event categories</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">CRUD</MudChip>
            </MudPaper>

            <MudPaper Class="admin-list__lookup-card admin-list__lookup-card--crud" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/locations"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--locations">
                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Locations</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">Manage event venues</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">CRUD</MudChip>
            </MudPaper>

            <!-- Read-Only Tables -->
            <MudPaper Class="admin-list__lookup-card" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/madhabs"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--madhabs">
                    <MudIcon Icon="@Icons.Material.Filled.MenuBook" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Madhabs</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">Islamic jurisprudence schools</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">View</MudChip>
            </MudPaper>

            <MudPaper Class="admin-list__lookup-card" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/audience-ages"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--ages">
                    <MudIcon Icon="@Icons.Material.Filled.Cake" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Audience Ages</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">Age group classifications</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">View</MudChip>
            </MudPaper>

            <MudPaper Class="admin-list__lookup-card" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/audience-genders"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--genders">
                    <MudIcon Icon="@Icons.Material.Filled.People" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Audience Genders</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">Gender audience options</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">View</MudChip>
            </MudPaper>

            <MudPaper Class="admin-list__lookup-card" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/event-types"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--event-types">
                    <MudIcon Icon="@Icons.Material.Filled.Event" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Event Types</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">Event classifications</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">View</MudChip>
            </MudPaper>

            <MudPaper Class="admin-list__lookup-card" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/event-formats"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--event-formats">
                    <MudIcon Icon="@Icons.Material.Filled.Videocam" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Event Formats</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">In-person, Online, Hybrid</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">View</MudChip>
            </MudPaper>

            <MudPaper Class="admin-list__lookup-card" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/languages"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--languages">
                    <MudIcon Icon="@Icons.Material.Filled.Language" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Languages</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">Supported languages</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">View</MudChip>
            </MudPaper>
        </div>
    </div>

    @if (_isLoading)
    {
        <MudPaper Class="admin-list__panel" Elevation="0" Style="margin-top:14px;">
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="py-4">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.body1">Loading organization requests…</MudText>
                <MudText Typo="Typo.caption" Class="admin-list__muted">Please wait a moment.</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <div class="admin-list__section">
            <div class="admin-list__section-head">
                <div>
                    <MudText Typo="Typo.h5" Style="font-weight:800;">Admin Management</MudText>
                    <MudText Typo="Typo.body2" Class="admin-list__muted">
                        Showing oldest first • @_organizationRequests.Count requests
                    </MudText>
                </div>
            </div>

            <!-- TOOLBAR -->
            <MudPaper Class="admin-list__panel" Elevation="0">
                <div class="admin-list__toolbar">
                    <MudTextField @bind-Value="_search"
                                  Placeholder="Search by name, email, city, country…"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Clearable="true"
                                  Margin="Margin.Dense"
                                  Style="min-width:320px; border-radius:999px;" />

                    <MudDivider Vertical="true" Class="mx-2" />

                    <div class="admin-list__chip-row">
                        <MudChip T="bool"
                                 Selected="@IsStatusSelected(RequestStatus.Pending)"
                                 OnClick="@(() => ToggleStatus(RequestStatus.Pending))"
                                 Color="Color.Info"
                                 Variant="Variant.Outlined">
                            Pending
                        </MudChip>

                        <MudChip T="bool"
                                 Selected="@IsStatusSelected(RequestStatus.Approved)"
                                 OnClick="@(() => ToggleStatus(RequestStatus.Approved))"
                                 Color="Color.Success"
                                 Variant="Variant.Outlined">
                            Approved
                        </MudChip>

                        <MudChip T="bool"
                                 Selected="@IsStatusSelected(RequestStatus.Rejected)"
                                 OnClick="@(() => ToggleStatus(RequestStatus.Rejected))"
                                 Color="Color.Error"
                                 Variant="Variant.Outlined">
                            Rejected
                        </MudChip>

                        <MudButton Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.FilterAltOff"
                                   OnClick="ClearFilters"
                                   Style="border-radius:999px;">
                            Clear
                        </MudButton>
                    </div>

                    <MudSpacer />

                    <MudSelect @bind-Value="_sort"
                               Label="Sort"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="min-width:190px; border-radius:14px;">
                        <MudSelectItem Value="SortOption.OldestFirst">Oldest first</MudSelectItem>
                        <MudSelectItem Value="SortOption.NewestFirst">Newest first</MudSelectItem>
                        <MudSelectItem Value="SortOption.Name">Name</MudSelectItem>
                        <MudSelectItem Value="SortOption.Status">Status</MudSelectItem>
                    </MudSelect>
                </div>
            </MudPaper>

            <!-- TABS -->
            <MudPaper Class="admin-list__tabs" Elevation="0" Style="margin-top:12px;">
                <MudTabs @bind-ActivePanelIndex="_activeTab"
                         Rounded="true"
                         Border="true"
                         ApplyEffectsToContainer="true">
                    <MudTabPanel Text="@($"All ({_organizationRequests.Count})")">
                        @TableMarkup(GetFilteredAndSorted(null))
                    </MudTabPanel>
                    <MudTabPanel Text="@($"Pending ({PendingCount})")">
                        @TableMarkup(GetFilteredAndSorted(RequestStatus.Pending))
                    </MudTabPanel>
                    <MudTabPanel Text="@($"Approved ({ApprovedCount})")">
                        @TableMarkup(GetFilteredAndSorted(RequestStatus.Approved))
                    </MudTabPanel>
                    <MudTabPanel Text="@($"Rejected ({RejectedCount})")">
                        @TableMarkup(GetFilteredAndSorted(RequestStatus.Rejected))
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        </div>
    }

</div>

@code {
    // Status mapping from API to local enum
    private enum RequestStatus { Pending = 1, Approved = 2, Rejected = 3 }

    private ICollection<OrganizationListDto> _organizationRequests = new List<OrganizationListDto>();
    private string _search = string.Empty;
    private int _activeTab = 0;
    private bool _isLoading = true;
    private string? _errorMessage;
    private HashSet<RequestStatus> _selectedStatuses = new();
    private enum SortOption { OldestFirst, NewestFirst, Name, Status }
    private SortOption _sort = SortOption.OldestFirst;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrganizationRequests();
    }

    private async Task LoadOrganizationRequests()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            Logger.LogDebug("Loading organizations from API");
            var tempOrgs = await AdminService.GetOrganizationRequestsAsync();

            if (tempOrgs != null)
            {
                _organizationRequests = tempOrgs;
                Logger.LogDebug("Loaded {OrganizationCount} organizations", _organizationRequests.Count);
            }
            else
            {
                _organizationRequests = new List<OrganizationListDto>();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load organizations: {ex.Message}";
            Logger.LogError(ex, "Failed to load organizations");
            Snackbar.Add(_errorMessage, Severity.Error);
            _organizationRequests = new List<OrganizationListDto>();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private int PendingCount  => _organizationRequests.Count(r => r.ApprovalStatusId == (int)RequestStatus.Pending);
    private int ApprovedCount => _organizationRequests.Count(r => r.ApprovalStatusId == (int)RequestStatus.Approved);
    private int RejectedCount => _organizationRequests.Count(r => r.ApprovalStatusId == (int)RequestStatus.Rejected);

    // filter + sorteer (oudste bovenaan)
    private IEnumerable<OrganizationListDto> GetFilteredAndSorted(RequestStatus? status)
    {
        IEnumerable<OrganizationListDto> q = _organizationRequests;

        if (status.HasValue)
            q = q.Where(r => r.ApprovalStatusId == (int)status.Value);

        // apply chip filters if any selected
        if (_selectedStatuses.Count > 0)
        {
            var allowed = _selectedStatuses.Select(s => (int)s).ToHashSet();
            q = q.Where(r => allowed.Contains(r.ApprovalStatusId));
        }

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim().ToLowerInvariant();
            q = q.Where(r =>
                (r.FullName?.ToLowerInvariant().Contains(s) ?? false) ||
                (r.Id.ToString().ToLowerInvariant().Contains(s)) ||
                (r.Email?.ToLowerInvariant().Contains(s) ?? false) ||
                (r.City?.ToLowerInvariant().Contains(s) ?? false) ||
                (r.Country?.ToLowerInvariant().Contains(s) ?? false));
        }

        // sorting
        q = _sort switch
        {
            SortOption.NewestFirst => q.OrderByDescending(r => r.CreatedAt),
            SortOption.Name        => q.OrderBy(r => r.FullName),
            SortOption.Status      => q.OrderBy(r => r.ApprovalStatusId),
            _ => q.OrderBy(r => r.CreatedAt)
        };

        return q;
    }

    // ====== TABLE (UI modernisée, logique identique) ======
    private RenderFragment TableMarkup(IEnumerable<OrganizationListDto> items) => @<div>
        <MudPaper Class="admin-list__table" Elevation="0" Style="margin-top:12px;">
            <MudTable Items="items" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true">
                <HeaderContent>
                    <MudTh style="width:190px">Submitted</MudTh>
                    <MudTh style="width:150px">ID</MudTh>
                    <MudTh>Organization</MudTh>
                    <MudTh style="width:170px">Status</MudTh>
                    <MudTh style="text-align:center; width:170px">Actions</MudTh>
                    <MudTh style="text-align:center; width:140px">Details</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Submitted">
                        <MudText Typo="Typo.body2" Style="font-weight:650;">
                            @context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </MudText>
                        <MudText Typo="Typo.caption" Class="muted">@GetRelative(context.CreatedAt)</MudText>
                    </MudTd>

                    <MudTd DataLabel="ID">
                        <MudText Class="admin-list__id">@context.Id.ToString()[..8]…</MudText>
                    </MudTd>

                    <MudTd DataLabel="Organization">
                        <div class="admin-list__org-row">
                            <MudAvatar Size="Size.Medium" Variant="Variant.Filled" Style="border-radius:14px;">
                                <MudIcon Icon="@Icons.Material.Filled.Business" />
                            </MudAvatar>

                            <div class="admin-list__org-meta">
                                <MudText Typo="Typo.subtitle2" Style="font-weight:750;">
                                    @context.FullName
                                </MudText>
                                <MudText Typo="Typo.caption" Class="admin-list__muted">
                                    @(context.City ?? "Unknown"), @(context.Country ?? "Unknown") • @context.Email
                                </MudText>
                            </div>
                        </div>
                    </MudTd>

                    <MudTd DataLabel="Status">
                        <MudChip T="string"
                                 Color="@StatusColor((RequestStatus)context.ApprovalStatusId)"
                                 Variant="Variant.Filled"
                                 Class="admin-list__status-pill">
                            @context.StatusTypeFullName
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="Actions" Style="text-align:center">
                        <div class="admin-list__actions">
                            @if (context.ApprovalStatusId == (int)RequestStatus.Pending)
                            {
                                <MudTooltip Text="Approve">
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                                   Color="Color.Success"
                                                   Variant="Variant.Filled"
                                                   OnClick="@(() => Approve(context))"
                                                   Style="border-radius:14px;" />
                                </MudTooltip>
                                <MudTooltip Text="Reject">
                                    <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                                   Color="Color.Error"
                                                   Variant="Variant.Filled"
                                                   OnClick="@(() => Reject(context))"
                                                   Style="border-radius:14px;" />
                                </MudTooltip>
                            }
                            else if (context.ApprovalStatusId == (int)RequestStatus.Approved)
                            {
                                <MudTooltip Text="Revoke approval">
                                    <MudIconButton Icon="@Icons.Material.Filled.Restore"
                                                   Color="Color.Warning"
                                                   Variant="Variant.Filled"
                                                   OnClick="@(() => RevertToPending(context))"
                                                   Style="border-radius:14px;" />
                                </MudTooltip>
                            }
                            else if (context.ApprovalStatusId == (int)RequestStatus.Rejected)
                            {
                                <MudTooltip Text="Move back to pending">
                                    <MudIconButton Icon="@Icons.Material.Filled.Restore"
                                                   Color="Color.Info"
                                                   Variant="Variant.Filled"
                                                   OnClick="@(() => RevertToPending(context))"
                                                   Style="border-radius:14px;" />
                                </MudTooltip>
                            }
                        </div>
                    </MudTd>

                    <MudTd DataLabel="Details" Style="text-align:center">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Class="admin-list__details-btn"
                                   StartIcon="@Icons.Material.Filled.Visibility"
                                   OnClick="@(() => Nav.NavigateTo($"/admin/organization/{context.Id}"))">
                            Details
                        </MudButton>
                    </MudTd>
                </RowTemplate>

                <NoRecordsContent>
                    <div class="admin-list__empty">
                        <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" />
                        <MudText Typo="Typo.h6" Style="margin-top:10px; font-weight:800;">No matching requests</MudText>
                        <MudText Typo="Typo.body2" Class="admin-list__muted">Try clearing filters or changing your search.</MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   OnClick="ClearFilters"
                                   Style="margin-top:12px; border-radius:999px;">
                            Clear filters
                        </MudButton>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>

        <!-- Mobile cards view -->
        <div class="admin-list__mobile" style="margin-top:12px;">
            @foreach (var org in items)
            {
                <div class="admin-list__card">
                    <div class="admin-list__card-header">
                        <div class="admin-list__card-title">
                            <MudAvatar Size="Size.Small" Variant="Variant.Filled" Style="border-radius:10px;">
                                <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.body2" Style="font-weight:700;">@org.FullName</MudText>
                                <div class="admin-list__card-meta">
                                    @(org.City ?? "Unknown"), @(org.Country ?? "Unknown")
                                </div>
                            </div>
                        </div>
                        <div class="admin-list__card-status">
                            <MudChip T="string"
                                     Color="@StatusColor((RequestStatus)org.ApprovalStatusId)"
                                     Variant="Variant.Filled"
                                     Style="font-size:0.75rem; padding:2px 8px !important; border-radius:6px !important;">
                                @org.StatusTypeFullName
                            </MudChip>
                        </div>
                    </div>

                    <div class="admin-list__card-body">
                        <div class="admin-list__card-row">
                            <span class="admin-list__card-label">Email:</span>
                            <span class="admin-list__card-value">@org.Email</span>
                        </div>
                        <div class="admin-list__card-row">
                            <span class="admin-list__card-label">ID:</span>
                            <span class="admin-list__card-value">@org.Id.ToString()[..8]…</span>
                        </div>
                        <div class="admin-list__card-row">
                            <span class="admin-list__card-label">Submitted:</span>
                            <span class="admin-list__card-value">@GetRelative(org.CreatedAt)</span>
                        </div>
                    </div>

                    <div class="admin-list__card-actions">
                        @if (org.ApprovalStatusId == (int)RequestStatus.Pending)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.CheckCircle"
                                       OnClick="@(() => Approve(org))">
                                Approve
                            </MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Cancel"
                                       OnClick="@(() => Reject(org))">
                                Reject
                            </MudButton>
                        }
                        else if (org.ApprovalStatusId == (int)RequestStatus.Approved)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Restore"
                                       OnClick="@(() => RevertToPending(org))">
                                Revoke
                            </MudButton>
                        }
                        else if (org.ApprovalStatusId == (int)RequestStatus.Rejected)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Info"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Restore"
                                       OnClick="@(() => RevertToPending(org))">
                                Revert
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Visibility"
                                   OnClick="@(() => Nav.NavigateTo($"/admin/organization/{org.Id}"))">
                            Details
                        </MudButton>
                    </div>
                </div>
            }
            @if (!items.Any())
            {
                <div class="admin-list__empty">
                    <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" />
                    <MudText Typo="Typo.h6" Style="margin-top:10px; font-weight:800;">No matching requests</MudText>
                    <MudText Typo="Typo.body2" Class="admin-list__muted">Try clearing filters or changing your search.</MudText>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="ClearFilters"
                               Style="margin-top:12px; border-radius:999px;">
                        Clear filters
                    </MudButton>
                </div>
            }
        </div>
    </div>;

    // filter helpers
    private bool IsStatusSelected(RequestStatus s) => _selectedStatuses.Contains(s);

    private void ToggleStatus(RequestStatus s)
    {
        if (_selectedStatuses.Contains(s)) _selectedStatuses.Remove(s); else _selectedStatuses.Add(s);
        StateHasChanged();
    }

    private void ClearFilters()
    {
        _selectedStatuses.Clear();
        _search = string.Empty;
        _sort = SortOption.OldestFirst;
        StateHasChanged();
    }

    // status-kleur
    private Color StatusColor(RequestStatus s) => s switch
    {
        RequestStatus.Pending  => Color.Info,
        RequestStatus.Approved => Color.Success,
        RequestStatus.Rejected => Color.Error,
        _ => Color.Default
    };

    // relatieve tijdsweergave
    private string GetRelative(DateTimeOffset utc)
    {
        var ts = DateTimeOffset.UtcNow - utc;
        if (ts.TotalDays    >= 1) return $"{(int)ts.TotalDays}d ago";
        if (ts.TotalHours   >= 1) return $"{(int)ts.TotalHours}h ago";
        if (ts.TotalMinutes >= 1) return $"{(int)ts.TotalMinutes}m ago";
        return "just now";
    }

    // acties (met ShowMessageBox en API calls)
    private async Task Approve(OrganizationListDto req)
    {
        bool? ok = await DialogService.ShowMessageBox(
            "Confirm approval",
            $"Approve {req.FullName}?",
            yesText: "Approve", cancelText: "Cancel");

        if (ok == true)
        {
            var success = await AdminService.ApproveOrganizationAsync(req.Id);
            if (success)
            {
                Snackbar.Add($"Approved {req.FullName}", Severity.Success);
                await LoadOrganizationRequests(); // Reload data
            }
            else
            {
                Snackbar.Add($"Failed to approve {req.FullName}", Severity.Error);
            }
        }
    }

    private async Task Reject(OrganizationListDto req)
    {
        bool? ok = await DialogService.ShowMessageBox(
            "Confirm rejection",
            $"Reject {req.FullName}?",
            yesText: "Reject", cancelText: "Cancel");

        if (ok == true)
        {
            var success = await AdminService.RejectOrganizationAsync(req.Id);
            if (success)
            {
                Snackbar.Add($"Rejected {req.FullName}", Severity.Error);
                await LoadOrganizationRequests(); // Reload data
            }
            else
            {
                Snackbar.Add($"Failed to reject {req.FullName}", Severity.Error);
            }
        }
    }

    private async Task RevertToPending(OrganizationListDto req)
    {
        var success = await AdminService.RevertToPendingAsync(req.Id);
        if (success)
        {
            Snackbar.Add($"Moved {req.FullName} back to Pending", Severity.Info);
            await LoadOrganizationRequests(); // Reload data
        }
        else
        {
            Snackbar.Add($"Failed to revert {req.FullName} to pending", Severity.Error);
        }
    }
}
