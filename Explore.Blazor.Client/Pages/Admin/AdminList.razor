@page "/admin"
@using MudBlazor
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<style>
    .admin-wrap { padding: 24px; max-width: 1200px; margin: 0 auto; }
    .toolbar { display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom: 12px; }
    .status-chip { min-width: 110px; justify-content: center; }
    .table-actions { display:flex; justify-content:center; gap:8px; }
    .muted { color: var(--mud-palette-text-secondary); }
    .logo-img { width:100%; height:100%; object-fit:cover; border-radius:inherit; }
</style>

<div class="admin-wrap">
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h4">Admin Management</MudText>
        <MudText Typo="Typo.body2" Class="muted">
            <!-- oudste eerst, nieuwste onderaan -->
            Showing oldest first • @_organizationRequests.Count requests
        </MudText>
    </MudStack>

    <!--zoeken + statusoverzicht -->
    <div class="toolbar">
        <MudTextField @bind-Value="_search"
                      Placeholder="Search by name, ID or email"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      Clearable="true"
                      Style="min-width: 280px;" />

        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Class="status-chip">
            Pending: @PendingCount
        </MudChip>
        <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Class="status-chip">
            Approved: @ApprovedCount
        </MudChip>
        <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" Class="status-chip">
            Rejected: @RejectedCount
        </MudChip>

        <MudTooltip Text="Oldest on top • Newest on bottom">
            <MudIcon Icon="@Icons.Material.Filled.South" Class="ml-2 muted" />
        </MudTooltip>
    </div>

    <!-- tabs per status -->
    <MudTabs @bind-ActivePanelIndex="_activeTab" Class="mb-3">
        <MudTabPanel Text="@($"All ({_organizationRequests.Count})")">
            @* gedeelde tabelweergave *@
            @TableMarkup(GetFilteredAndSorted(null))
        </MudTabPanel>
        <MudTabPanel Text="@($"Pending ({PendingCount})")">
            @TableMarkup(GetFilteredAndSorted(RequestStatus.Pending))
        </MudTabPanel>
        <MudTabPanel Text="@($"Approved ({ApprovedCount})")">
            @TableMarkup(GetFilteredAndSorted(RequestStatus.Approved))
        </MudTabPanel>
        <MudTabPanel Text="@($"Rejected ({RejectedCount})")">
            @TableMarkup(GetFilteredAndSorted(RequestStatus.Rejected))
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    // status van een aanvraag
    private enum RequestStatus { Pending, Approved, Rejected }

    // domeinmodel voor admin-tabel
    private class OrganizationRequestModel
    {
        public string Id { get; set; } = string.Empty;
        public string OrganizationName { get; set; } = string.Empty;
        public string ContactEmail { get; set; } = string.Empty;
        public string OrganizationType { get; set; } = string.Empty;
        public DateTime SubmittedAt { get; set; } = DateTime.UtcNow;
        public RequestStatus Status { get; set; } = RequestStatus.Pending;
        public string City { get; set; } = string.Empty;
        public string Country { get; set; } = string.Empty;
        public string? LogoUrl { get; set; }
    }

    private List<OrganizationRequestModel> _organizationRequests = new();
    private string _search = string.Empty;
    private int _activeTab = 0;

    protected override void OnInitialized()
    {
        //  mockdata met verschillende statussen en datums
        var now = DateTime.UtcNow;
        _organizationRequests = new List<OrganizationRequestModel>
        {
            new() { Id="2065651", OrganizationName="Organisation 1", ContactEmail="org1@mail.com", OrganizationType="Non-Profit", City="Brussels", Country="Belgium", Status=RequestStatus.Approved, SubmittedAt=now.AddDays(-18) },
            new() { Id="2065652", OrganizationName="Organisation 2", ContactEmail="org2@mail.com", OrganizationType="Charity",   City="Antwerp",  Country="Belgium", Status=RequestStatus.Pending,  SubmittedAt=now.AddDays(-14) },
            new() { Id="2065653", OrganizationName="Organisation 3", ContactEmail="org3@mail.com", OrganizationType="Community", City="Ghent",    Country="Belgium", Status=RequestStatus.Rejected, SubmittedAt=now.AddDays(-11) },
            new() { Id="2065654", OrganizationName="Organisation 4", ContactEmail="org4@mail.com", OrganizationType="Educational",City="Liège",    Country="Belgium", Status=RequestStatus.Pending,  SubmittedAt=now.AddDays(-7)  },
            new() { Id="2065655", OrganizationName="Organisation 5", ContactEmail="org5@mail.com", OrganizationType="Cultural",  City="Namur",    Country="Belgium", Status=RequestStatus.Pending,  SubmittedAt=now.AddDays(-3)  },
            new() { Id="2065656", OrganizationName="Organisation 6", ContactEmail="org6@mail.com", OrganizationType="Religious", City="Mons",     Country="Belgium", Status=RequestStatus.Approved, SubmittedAt=now.AddDays(-1)  },
        };
    }

    private int PendingCount  => _organizationRequests.Count(r => r.Status == RequestStatus.Pending);
    private int ApprovedCount => _organizationRequests.Count(r => r.Status == RequestStatus.Approved);
    private int RejectedCount => _organizationRequests.Count(r => r.Status == RequestStatus.Rejected);

    // filter + sorteer (oudste bovenaan)
    private IEnumerable<OrganizationRequestModel> GetFilteredAndSorted(RequestStatus? status)
    {
        IEnumerable<OrganizationRequestModel> q = _organizationRequests;

        if (status.HasValue)
            q = q.Where(r => r.Status == status.Value);

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim().ToLowerInvariant();
            q = q.Where(r =>
                (r.OrganizationName?.ToLowerInvariant().Contains(s) ?? false) ||
                (r.Id?.ToLowerInvariant().Contains(s) ?? false) ||
                (r.ContactEmail?.ToLowerInvariant().Contains(s) ?? false));
        }

        return q.OrderBy(r => r.SubmittedAt); // oudste -> nieuwste
    }

    // gedeelde tabel (pure Razor, geen RenderTreeBuilder)
    private RenderFragment TableMarkup(IEnumerable<OrganizationRequestModel> items) => @<MudPaper Elevation="2">
        <MudTable Items="items" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh style="width:120px">Submitted</MudTh>
                <MudTh style="width:120px">ID</MudTh>
                <MudTh>Organization</MudTh>
                <MudTh style="width:140px">Type</MudTh>
                <MudTh style="width:140px">Status</MudTh>
                <MudTh style="text-align:center; width:170px">Actions</MudTh>
                <MudTh style="text-align:center; width:110px">Details</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Submitted">
                    <MudText Typo="Typo.body2">@context.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy")</MudText>
                    <MudText Typo="Typo.caption" Class="muted">@GetRelative(context.SubmittedAt)</MudText>
                </MudTd>

                <MudTd DataLabel="ID">
                    <MudText>@context.Id</MudText>
                </MudTd>

                <MudTd DataLabel="Organization">
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                        @if (!string.IsNullOrWhiteSpace(context.LogoUrl))
                        {
                            <MudAvatar Size="Size.Medium" Variant="Variant.Filled">
                                <img class="logo-img" src="@context.LogoUrl" alt="logo" />
                            </MudAvatar>
                        }
                        else
                        {
                            <MudAvatar Size="Size.Medium" Variant="Variant.Filled">
                                <MudIcon Icon="@Icons.Material.Filled.Business" />
                            </MudAvatar>
                        }
                        <div>
                            <MudText Typo="Typo.subtitle2">@context.OrganizationName</MudText>
                            <MudText Typo="Typo.caption" Class="muted">@context.City, @context.Country • @context.ContactEmail</MudText>
                        </div>
                    </MudStack>
                </MudTd>

                <MudTd DataLabel="Type">
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Default">@context.OrganizationType</MudChip>
                </MudTd>

                <MudTd DataLabel="Status">
                    <MudChip T="string" Color="@StatusColor(context.Status)" Variant="Variant.Filled">
                        @context.Status.ToString()
                    </MudChip>
                </MudTd>

                <MudTd DataLabel="Actions" Style="text-align:center">
                    <div class="table-actions">
                        @if (context.Status == RequestStatus.Pending)
                        {
                            <MudTooltip Text="Approve">
                                <MudIconButton Icon="@Icons.Material.Filled.Check"
                                               Color="Color.Success"
                                               OnClick="@(() => Approve(context))" />
                            </MudTooltip>
                            <MudTooltip Text="Reject">
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Color="Color.Error"
                                               OnClick="@(() => Reject(context))" />
                            </MudTooltip>
                        }
                        else if (context.Status == RequestStatus.Approved)
                        {
                            <MudTooltip Text="Revoke approval">
                                <MudIconButton Icon="@Icons.Material.Filled.Undo"
                                               Color="Color.Warning"
                                               OnClick="@(() => RevertToPending(context))" />
                            </MudTooltip>
                        }
                        else if (context.Status == RequestStatus.Rejected)
                        {
                            <MudTooltip Text="Move back to pending">
                                <MudIconButton Icon="@Icons.Material.Filled.Restore"
                                               Color="Color.Info"
                                               OnClick="@(() => RevertToPending(context))" />
                            </MudTooltip>
                        }
                    </div>
                </MudTd>

                <MudTd DataLabel="Details" Style="text-align:center">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => Nav.NavigateTo($"/admin/organization/{context.Id}"))">
                        Details
                    </MudButton>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText Class="p-4">No requests match your filters.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>;

    // status-kleur
    private Color StatusColor(RequestStatus s) => s switch
    {
        RequestStatus.Pending  => Color.Info,
        RequestStatus.Approved => Color.Success,
        RequestStatus.Rejected => Color.Error,
        _ => Color.Default
    };

    // relatieve tijdsweergave
    private string GetRelative(DateTime utc)
    {
        var ts = DateTime.UtcNow - utc;
        if (ts.TotalDays   >= 1) return $"{(int)ts.TotalDays}d ago";
        if (ts.TotalHours  >= 1) return $"{(int)ts.TotalHours}h ago";
        if (ts.TotalMinutes>= 1) return $"{(int)ts.TotalMinutes}m ago";
        return "just now";
    }

    // acties (met ShowMessageBox en ShowAsync waar nodig)
    private async Task Approve(OrganizationRequestModel req)
    {
        bool? ok = await DialogService.ShowMessageBox(
            "Confirm approval",
            $"Approve {req.OrganizationName}?",
            yesText: "Approve", cancelText: "Cancel");

        if (ok == true)
        {
            req.Status = RequestStatus.Approved;
            Snackbar.Add($"Approved {req.OrganizationName}", Severity.Success);
            StateHasChanged();
        }
    }

    private async Task Reject(OrganizationRequestModel req)
    {
        bool? ok = await DialogService.ShowMessageBox(
            "Confirm rejection",
            $"Reject {req.OrganizationName}?",
            yesText: "Reject", cancelText: "Cancel");

        if (ok == true)
        {
            req.Status = RequestStatus.Rejected;
            Snackbar.Add($"Rejected {req.OrganizationName}", Severity.Error);
            StateHasChanged();
        }
    }

    private void RevertToPending(OrganizationRequestModel req)
    {
        req.Status = RequestStatus.Pending;
        Snackbar.Add($"Moved {req.OrganizationName} back to Pending", Severity.Info);
        StateHasChanged();
    }
}

