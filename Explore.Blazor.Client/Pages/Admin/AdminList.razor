@page "/admin"
@using MudBlazor
@using Explore.Blazor.Client.Components.Admin
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles="Admin")]

@page "/admin"
@using MudBlazor
@using Explore.Blazor.Client.Components.Admin
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles="Admin")]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-8">

    <!-- HERO -->
    <MudPaper Elevation="0" Class="pa-6 mb-6 rounded-xl relative overflow-hidden" Style="background: radial-gradient(circle at 20% 10%, rgba(124, 58, 237, 0.15), transparent 60%), linear-gradient(180deg, var(--mud-palette-surface), var(--mud-palette-background)); border: 1px solid var(--mud-palette-lines-default);">
        <div class="d-flex justify-space-between align-center flex-wrap gap-4">
            <div class="d-flex align-center gap-4">
                <MudAvatar Rounded="true" Size="Size.Large" Color="Color.Primary" Variant="Variant.Filled">
                    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Medium" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h4" Style="font-weight: 800;">Admin Dashboard</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary">Review and action incoming organization requests</MudText>
                </div>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadOrganizationRequests" Class="rounded-pill px-6">Refresh</MudButton>
        </div>

        <MudGrid Class="mt-6" Spacing="3">
            <MudItem xs="12" sm="4">
                <MudCard Elevation="0" Class="pa-4 border-solid border-1 mud-border-lines-default rounded-lg">
                    <div class="d-flex align-center gap-4">
                        <MudAvatar Rounded="true" Color="Color.Info" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.HourglassBottom" />
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Pending</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight: 700;">@PendingCount</MudText>
                        </div>
                    </div>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudCard Elevation="0" Class="pa-4 border-solid border-1 mud-border-lines-default rounded-lg">
                    <div class="d-flex align-center gap-4">
                        <MudAvatar Rounded="true" Color="Color.Success" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Approved</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight: 700;">@ApprovedCount</MudText>
                        </div>
                    </div>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudCard Elevation="0" Class="pa-4 border-solid border-1 mud-border-lines-default rounded-lg">
                    <div class="d-flex align-center gap-4">
                        <MudAvatar Rounded="true" Color="Color.Error" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.Cancel" />
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Rejected</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight: 700;">@RejectedCount</MudText>
                        </div>
                    </div>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">@_errorMessage</MudAlert>
    }

    <!-- LOOKUP TABLES -->
    <div class="mb-8">
        <MudText Typo="Typo.h5" Class="mb-4" Style="font-weight: 700;">Lookup Tables</MudText>
        <MudGrid Spacing="3">
            <!-- CRUD -->
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="0" Class="pa-4 cursor-pointer hover-elevation-4 transition-all border-solid border-1 mud-border-lines-default rounded-lg" @onclick="@(() => Nav.NavigateTo("/admin/tags"))">
                    <div class="d-flex justify-space-between align-start mb-2">
                        <MudAvatar Rounded="true" Color="Color.Primary" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" />
                        </MudAvatar>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">CRUD</MudChip>
                    </div>
                    <MudText Typo="Typo.h6" Class="mt-2">Tags</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Manage tags</MudText>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="0" Class="pa-4 cursor-pointer hover-elevation-4 transition-all border-solid border-1 mud-border-lines-default rounded-lg" @onclick="@(() => Nav.NavigateTo("/admin/categories"))">
                    <div class="d-flex justify-space-between align-start mb-2">
                        <MudAvatar Rounded="true" Color="Color.Primary" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.Category" />
                        </MudAvatar>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">CRUD</MudChip>
                    </div>
                    <MudText Typo="Typo.h6" Class="mt-2">Categories</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Manage categories</MudText>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="0" Class="pa-4 cursor-pointer hover-elevation-4 transition-all border-solid border-1 mud-border-lines-default rounded-lg" @onclick="@(() => Nav.NavigateTo("/admin/locations"))">
                    <div class="d-flex justify-space-between align-start mb-2">
                        <MudAvatar Rounded="true" Color="Color.Primary" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.LocationOn" />
                        </MudAvatar>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">CRUD</MudChip>
                    </div>
                    <MudText Typo="Typo.h6" Class="mt-2">Locations</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Manage venues</MudText>
                </MudCard>
            </MudItem>

            <!-- Read Only / Others -->
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="0" Class="pa-4 cursor-pointer hover-elevation-4 transition-all border-solid border-1 mud-border-lines-default rounded-lg" @onclick="@(() => Nav.NavigateTo("/admin/event-types"))">
                    <div class="d-flex justify-space-between align-start mb-2">
                        <MudAvatar Rounded="true" Color="Color.Secondary" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.Event" />
                        </MudAvatar>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">View</MudChip>
                    </div>
                    <MudText Typo="Typo.h6" Class="mt-2">Event Types</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Classifications</MudText>
                </MudCard>
            </MudItem>
             <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="0" Class="pa-4 cursor-pointer hover-elevation-4 transition-all border-solid border-1 mud-border-lines-default rounded-lg" @onclick="@(() => Nav.NavigateTo("/admin/event-formats"))">
                    <div class="d-flex justify-space-between align-start mb-2">
                        <MudAvatar Rounded="true" Color="Color.Secondary" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.Videocam" />
                        </MudAvatar>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">View</MudChip>
                    </div>
                    <MudText Typo="Typo.h6" Class="mt-2">Formats</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">In-person/Online</MudText>
                </MudCard>
            </MudItem>
             <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="0" Class="pa-4 cursor-pointer hover-elevation-4 transition-all border-solid border-1 mud-border-lines-default rounded-lg" @onclick="@(() => Nav.NavigateTo("/admin/languages"))">
                    <div class="d-flex justify-space-between align-start mb-2">
                        <MudAvatar Rounded="true" Color="Color.Secondary" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.Language" />
                        </MudAvatar>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">View</MudChip>
                    </div>
                    <MudText Typo="Typo.h6" Class="mt-2">Languages</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Supported languages</MudText>
                </MudCard>
            </MudItem>
             <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="0" Class="pa-4 cursor-pointer hover-elevation-4 transition-all border-solid border-1 mud-border-lines-default rounded-lg" @onclick="@(() => Nav.NavigateTo("/admin/audience-ages"))">
                    <div class="d-flex justify-space-between align-start mb-2">
                        <MudAvatar Rounded="true" Color="Color.Secondary" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.Cake" />
                        </MudAvatar>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">View</MudChip>
                    </div>
                    <MudText Typo="Typo.h6" Class="mt-2">Ages</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Audience ages</MudText>
                </MudCard>
            </MudItem>
             <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="0" Class="pa-4 cursor-pointer hover-elevation-4 transition-all border-solid border-1 mud-border-lines-default rounded-lg" @onclick="@(() => Nav.NavigateTo("/admin/audience-genders"))">
                    <div class="d-flex justify-space-between align-start mb-2">
                        <MudAvatar Rounded="true" Color="Color.Secondary" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.People" />
                        </MudAvatar>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">View</MudChip>
                    </div>
                    <MudText Typo="Typo.h6" Class="mt-2">Genders</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Audience genders</MudText>
                </MudCard>
            </MudItem>
             <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Elevation="0" Class="pa-4 cursor-pointer hover-elevation-4 transition-all border-solid border-1 mud-border-lines-default rounded-lg" @onclick="@(() => Nav.NavigateTo("/admin/madhabs"))">
                    <div class="d-flex justify-space-between align-start mb-2">
                        <MudAvatar Rounded="true" Color="Color.Secondary" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.MenuBook" />
                        </MudAvatar>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">View</MudChip>
                    </div>
                    <MudText Typo="Typo.h6" Class="mt-2">Madhabs</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Schools of thought</MudText>
                </MudCard>
            </MudItem>
        </MudGrid>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex flex-column align-center justify-center py-12">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.body1" Class="mt-4" Color="Color.Secondary">Loading organization requests...</MudText>
        </div>
    }
    else
    {
        <MudPaper Elevation="0" Class="pa-4 border-solid border-1 mud-border-lines-default rounded-xl">
            <div class="d-flex justify-space-between align-center flex-wrap gap-4 mb-4">
                <div>
                    <MudText Typo="Typo.h5" Style="font-weight: 700;">Admin Management</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Showing oldest first • @_organizationRequests.Count requests</MudText>
                </div>
                
                <div class="d-flex gap-2 align-center flex-wrap">
                    <MudTextField @bind-Value="_search"
                                  Placeholder="Search..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="rounded-pill"
                                  Style="background: var(--mud-palette-surface);" />
                                  
                    <MudSelect @bind-Value="_sort" Label="Sort" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width: 150px;">
                        <MudSelectItem Value="SortOption.OldestFirst">Oldest first</MudSelectItem>
                        <MudSelectItem Value="SortOption.NewestFirst">Newest first</MudSelectItem>
                        <MudSelectItem Value="SortOption.Name">Name</MudSelectItem>
                        <MudSelectItem Value="SortOption.Status">Status</MudSelectItem>
                    </MudSelect>
                </div>
            </div>

            <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Primary" Class="mt-4">
                <MudTabPanel Text="@($"All ({_organizationRequests.Count})")">
                    <AdminOrganizationTable Items="GetFilteredAndSorted(null)"
                                            OnApprove="Approve"
                                            OnReject="Reject"
                                            OnRevert="RevertToPending"
                                            OnViewDetails="ViewDetails"
                                            OnClearFilters="ClearFilters" />
                </MudTabPanel>
                <MudTabPanel Text="@($"Pending ({PendingCount})")">
                    <AdminOrganizationTable Items="GetFilteredAndSorted(RequestStatus.Pending)"
                                            OnApprove="Approve"
                                            OnReject="Reject"
                                            OnRevert="RevertToPending"
                                            OnViewDetails="ViewDetails"
                                            OnClearFilters="ClearFilters" />
                </MudTabPanel>
                <MudTabPanel Text="@($"Approved ({ApprovedCount})")">
                    <AdminOrganizationTable Items="GetFilteredAndSorted(RequestStatus.Approved)"
                                            OnApprove="Approve"
                                            OnReject="Reject"
                                            OnRevert="RevertToPending"
                                            OnViewDetails="ViewDetails"
                                            OnClearFilters="ClearFilters" />
                </MudTabPanel>
                <MudTabPanel Text="@($"Rejected ({RejectedCount})")">
                    <AdminOrganizationTable Items="GetFilteredAndSorted(RequestStatus.Rejected)"
                                            OnApprove="Approve"
                                            OnReject="Reject"
                                            OnRevert="RevertToPending"
                                            OnViewDetails="ViewDetails"
                                            OnClearFilters="ClearFilters" />
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    }

</MudContainer>
