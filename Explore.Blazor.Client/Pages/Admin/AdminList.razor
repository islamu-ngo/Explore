@page "/admin"
@using MudBlazor
@using Explore.Blazor.Client.Components.Admin
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles="Admin")]

<div class="admin-list">

    <!-- HERO -->
    <MudPaper Class="admin-list__hero" Elevation="0">
        <div class="admin-list__hero-top">
            <div>
                <div class="admin-list__hero-title">
                    <div class="admin-list__hero-badge">
                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Primary" />
                    </div>
                    <div>
                        <MudText Typo="Typo.h4" Style="font-weight:800; letter-spacing:.2px;">
                            Admin Dashboard
                        </MudText>
                        <MudText Typo="Typo.body2" Class="admin-list__hero-subtitle">
                            Review and action incoming organization requests
                        </MudText>
                    </div>
                </div>
            </div>

            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadOrganizationRequests"
                           Style="border-radius:999px; padding:10px 16px;">
                    Refresh
                </MudButton>
            </MudStack>
        </div>

        <!-- STATS -->
        <div class="admin-list__stats">
            <div class="admin-list__stat">
                <div class="admin-list__stat-row">
                    <div class="admin-list__stat-icon admin-list__stat-icon--pending">
                        <MudIcon Icon="@Icons.Material.Filled.HourglassBottom" Color="Color.Info" />
                    </div>
                    <div>
                        <div class="admin-list__stat-label">Pending</div>
                        <div class="admin-list__stat-value">@PendingCount</div>
                    </div>
                </div>
            </div>

            <div class="admin-list__stat">
                <div class="admin-list__stat-row">
                    <div class="admin-list__stat-icon admin-list__stat-icon--approved">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                    </div>
                    <div>
                        <div class="admin-list__stat-label">Approved</div>
                        <div class="admin-list__stat-value">@ApprovedCount</div>
                    </div>
                </div>
            </div>

            <div class="admin-list__stat">
                <div class="admin-list__stat-row">
                    <div class="admin-list__stat-icon admin-list__stat-icon--rejected">
                        <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" />
                    </div>
                    <div>
                        <div class="admin-list__stat-label">Rejected</div>
                        <div class="admin-list__stat-value">@RejectedCount</div>
                    </div>
                </div>
            </div>
        </div>
    </MudPaper>

    <!-- LOOKUP TABLES NAVIGATION -->
    <div class="admin-list__lookup-section">
        <div class="admin-list__section-head">
            <div>
                <MudText Typo="Typo.h5" Style="font-weight:800;">Lookup Tables</MudText>
                <MudText Typo="Typo.body2" Class="admin-list__muted">
                    Manage system data and configurations
                </MudText>
            </div>
        </div>

        <div class="admin-list__lookup-grid">
            <!-- CRUD Tables (Full Edit Access) -->
            <MudPaper Class="admin-list__lookup-card admin-list__lookup-card--crud" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/tags"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--tags">
                    <MudIcon Icon="@Icons.Material.Filled.LocalOffer" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Tags</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">Create, edit, delete tags</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">CRUD</MudChip>
            </MudPaper>

            <MudPaper Class="admin-list__lookup-card admin-list__lookup-card--crud" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/categories"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--categories">
                    <MudIcon Icon="@Icons.Material.Filled.Category" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Categories</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">Manage event categories</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">CRUD</MudChip>
            </MudPaper>

            <MudPaper Class="admin-list__lookup-card admin-list__lookup-card--crud" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/locations"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--locations">
                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Locations</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">Manage event venues</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">CRUD</MudChip>
            </MudPaper>

            <!-- Read-Only Tables -->
            <MudPaper Class="admin-list__lookup-card" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/madhabs"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--madhabs">
                    <MudIcon Icon="@Icons.Material.Filled.MenuBook" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Madhabs</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">Islamic jurisprudence schools</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">View</MudChip>
            </MudPaper>

            <MudPaper Class="admin-list__lookup-card" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/audience-ages"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--ages">
                    <MudIcon Icon="@Icons.Material.Filled.Cake" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Audience Ages</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">Age group classifications</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">View</MudChip>
            </MudPaper>

            <MudPaper Class="admin-list__lookup-card" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/audience-genders"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--genders">
                    <MudIcon Icon="@Icons.Material.Filled.People" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Audience Genders</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">Gender audience options</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">View</MudChip>
            </MudPaper>

            <MudPaper Class="admin-list__lookup-card" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/event-types"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--event-types">
                    <MudIcon Icon="@Icons.Material.Filled.Event" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Event Types</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">Event classifications</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">View</MudChip>
            </MudPaper>

            <MudPaper Class="admin-list__lookup-card" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/event-formats"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--event-formats">
                    <MudIcon Icon="@Icons.Material.Filled.Videocam" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Event Formats</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">In-person, Online, Hybrid</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">View</MudChip>
            </MudPaper>

            <MudPaper Class="admin-list__lookup-card" Elevation="0" @onclick="@(() => Nav.NavigateTo("/admin/languages"))">
                <div class="admin-list__lookup-card-icon admin-list__lookup-card-icon--languages">
                    <MudIcon Icon="@Icons.Material.Filled.Language" />
                </div>
                <div class="admin-list__lookup-card-content">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Languages</MudText>
                    <MudText Typo="Typo.caption" Class="admin-list__muted">Supported languages</MudText>
                </div>
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">View</MudChip>
            </MudPaper>
        </div>
    </div>

    @if (_isLoading)
    {
        <MudPaper Class="admin-list__panel" Elevation="0" Style="margin-top:14px;">
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="py-4">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.body1">Loading organization requests…</MudText>
                <MudText Typo="Typo.caption" Class="admin-list__muted">Please wait a moment.</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <div class="admin-list__section">
            <div class="admin-list__section-head">
                <div>
                    <MudText Typo="Typo.h5" Style="font-weight:800;">Admin Management</MudText>
                    <MudText Typo="Typo.body2" Class="admin-list__muted">
                        Showing oldest first • @_organizationRequests.Count requests
                    </MudText>
                </div>
            </div>

            <!-- TOOLBAR -->
            <MudPaper Class="admin-list__panel" Elevation="0">
                <div class="admin-list__toolbar">
                    <MudTextField @bind-Value="_search"
                                  Placeholder="Search by name, email, city, country…"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Clearable="true"
                                  Margin="Margin.Dense"
                                  Style="min-width:320px; border-radius:999px;" />

                    <MudDivider Vertical="true" Class="mx-2" />

                    <div class="admin-list__chip-row">
                        <MudChip T="bool"
                                 Selected="@IsStatusSelected(RequestStatus.Pending)"
                                 OnClick="@(() => ToggleStatus(RequestStatus.Pending))"
                                 Color="Color.Info"
                                 Variant="Variant.Outlined">
                            Pending
                        </MudChip>

                        <MudChip T="bool"
                                 Selected="@IsStatusSelected(RequestStatus.Approved)"
                                 OnClick="@(() => ToggleStatus(RequestStatus.Approved))"
                                 Color="Color.Success"
                                 Variant="Variant.Outlined">
                            Approved
                        </MudChip>

                        <MudChip T="bool"
                                 Selected="@IsStatusSelected(RequestStatus.Rejected)"
                                 OnClick="@(() => ToggleStatus(RequestStatus.Rejected))"
                                 Color="Color.Error"
                                 Variant="Variant.Outlined">
                            Rejected
                        </MudChip>

                        <MudButton Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.FilterAltOff"
                                   OnClick="ClearFilters"
                                   Style="border-radius:999px;">
                            Clear
                        </MudButton>
                    </div>

                    <MudSpacer />

                    <MudSelect @bind-Value="_sort"
                               Label="Sort"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="min-width:190px; border-radius:14px;">
                        <MudSelectItem Value="SortOption.OldestFirst">Oldest first</MudSelectItem>
                        <MudSelectItem Value="SortOption.NewestFirst">Newest first</MudSelectItem>
                        <MudSelectItem Value="SortOption.Name">Name</MudSelectItem>
                        <MudSelectItem Value="SortOption.Status">Status</MudSelectItem>
                    </MudSelect>
                </div>
            </MudPaper>

            <!-- TABS -->
            <MudPaper Class="admin-list__tabs" Elevation="0" Style="margin-top:12px;">
                <MudTabs @bind-ActivePanelIndex="_activeTab"
                         Rounded="true"
                         Border="true"
                         ApplyEffectsToContainer="true">
                    <MudTabPanel Text="@($"All ({_organizationRequests.Count})")">
                        <AdminOrganizationTable Items="GetFilteredAndSorted(null)"
                                                OnApprove="Approve"
                                                OnReject="Reject"
                                                OnRevert="RevertToPending"
                                                OnViewDetails="ViewDetails"
                                                OnClearFilters="ClearFilters" />
                    </MudTabPanel>
                    <MudTabPanel Text="@($"Pending ({PendingCount})")">
                        <AdminOrganizationTable Items="GetFilteredAndSorted(RequestStatus.Pending)"
                                                OnApprove="Approve"
                                                OnReject="Reject"
                                                OnRevert="RevertToPending"
                                                OnViewDetails="ViewDetails"
                                                OnClearFilters="ClearFilters" />
                    </MudTabPanel>
                    <MudTabPanel Text="@($"Approved ({ApprovedCount})")">
                        <AdminOrganizationTable Items="GetFilteredAndSorted(RequestStatus.Approved)"
                                                OnApprove="Approve"
                                                OnReject="Reject"
                                                OnRevert="RevertToPending"
                                                OnViewDetails="ViewDetails"
                                                OnClearFilters="ClearFilters" />
                    </MudTabPanel>
                    <MudTabPanel Text="@($"Rejected ({RejectedCount})")">
                        <AdminOrganizationTable Items="GetFilteredAndSorted(RequestStatus.Rejected)"
                                                OnApprove="Approve"
                                                OnReject="Reject"
                                                OnRevert="RevertToPending"
                                                OnViewDetails="ViewDetails"
                                                OnClearFilters="ClearFilters" />
                    </MudTabPanel>
                </MudTabs>
            </MudPaper>
        </div>
    }

</div>
