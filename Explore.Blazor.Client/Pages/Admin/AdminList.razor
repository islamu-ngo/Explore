@page "/admin"
@using MudBlazor
@using Explore.Blazor.Client.Models.DTOs
@using Explore.Blazor.Client.Services
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IAdminService AdminService

<style>
    .admin-wrap { padding: 24px; max-width: 1200px; margin: 0 auto; }
    .toolbar { display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom: 12px; }
    .status-chip { min-width: 110px; justify-content: center; }
    .table-actions { display:flex; justify-content:center; gap:8px; }
    .muted { color: var(--mud-palette-text-secondary); }
    .logo-img { width:100%; height:100%; object-fit:cover; border-radius:inherit; }
</style>

<div class="admin-wrap">
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <div>
            <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-1">Admin Dashboard</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Gestion van organisatieaanvragen</MudText>
        </div>
    </MudStack>

    @if (_isLoading)
    {
        <MudPaper Class="p-6" Elevation="2">
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.body1">Loading organization requests...</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudText Typo="Typo.h4">Admin Management</MudText>
        <MudText Typo="Typo.body2" Class="muted">
            <!-- oudste eerst, nieuwste onderaan -->
            Showing oldest first • @_organizationRequests.Count requests
        </MudText>

    <!--zoeken + statusoverzicht -->
    <div class="toolbar">
        <MudTextField @bind-Value="_search"
                      Placeholder="Search by name, ID or email"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      Clearable="true"
                      Style="min-width: 280px;" />

        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Class="status-chip">
            Pending: @PendingCount
        </MudChip>
        <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Class="status-chip">
            Approved: @ApprovedCount
        </MudChip>
        <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" Class="status-chip">
            Rejected: @RejectedCount
        </MudChip>

        <MudTooltip Text="Oldest on top • Newest on bottom">
            <MudIcon Icon="@Icons.Material.Filled.South" Class="ml-2 muted" />
        </MudTooltip>
    </div>

    <!-- tabs per status -->
    <MudTabs @bind-ActivePanelIndex="_activeTab" Class="mb-3">
        <MudTabPanel Text="@($"All ({_organizationRequests.Count})")">
            @* gedeelde tabelweergave *@
            @TableMarkup(GetFilteredAndSorted(null))
        </MudTabPanel>
        <MudTabPanel Text="@($"Pending ({PendingCount})")">
            @TableMarkup(GetFilteredAndSorted(RequestStatus.Pending))
        </MudTabPanel>
        <MudTabPanel Text="@($"Approved ({ApprovedCount})")">
            @TableMarkup(GetFilteredAndSorted(RequestStatus.Approved))
        </MudTabPanel>
        <MudTabPanel Text="@($"Rejected ({RejectedCount})")">
            @TableMarkup(GetFilteredAndSorted(RequestStatus.Rejected))
        </MudTabPanel>
    </MudTabs>
    } @* sluiting van bloc else voor _isLoading *@
</div>

@code {
    // Status mapping van API naar local enum
    private enum RequestStatus { Pending = 1, Approved = 2, Rejected = 3 }

    private List<OrganizationListDto> _organizationRequests = new();
    private string _search = string.Empty;
    private int _activeTab = 0;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrganizationRequests();
    }

    private async Task LoadOrganizationRequests()
    {
        _isLoading = true;
        try
        {
            _organizationRequests = await AdminService.GetOrganizationRequestsAsync();
            Console.WriteLine($"Loaded {_organizationRequests.Count} organizations");
            foreach (var org in _organizationRequests)
            {
                Console.WriteLine($"Org: {org.FullName}, Status: {org.StatusTypeId} - {org.StatusTypeFullName}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading organizations: {ex.Message}");
            Snackbar.Add($"Fout bij laden organisaties: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private int PendingCount  => _organizationRequests.Count(r => r.StatusTypeId == (int)RequestStatus.Pending);
    private int ApprovedCount => _organizationRequests.Count(r => r.StatusTypeId == (int)RequestStatus.Approved);
    private int RejectedCount => _organizationRequests.Count(r => r.StatusTypeId == (int)RequestStatus.Rejected);

    // filter + sorteer (oudste bovenaan)
    private IEnumerable<OrganizationListDto> GetFilteredAndSorted(RequestStatus? status)
    {
        IEnumerable<OrganizationListDto> q = _organizationRequests;

        if (status.HasValue)
            q = q.Where(r => r.StatusTypeId == (int)status.Value);

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var s = _search.Trim().ToLowerInvariant();
            q = q.Where(r =>
                (r.FullName?.ToLowerInvariant().Contains(s) ?? false) ||
                (r.Id.ToString().ToLowerInvariant().Contains(s)) ||
                (r.Email?.ToLowerInvariant().Contains(s) ?? false));
        }

        return q.OrderBy(r => r.Id); // tri par ID en attendant CreatedAt
    }

    // gedeelde tabel (pure Razor, geen RenderTreeBuilder)
    private RenderFragment TableMarkup(IEnumerable<OrganizationListDto> items) => @<MudPaper Elevation="2">
        <MudTable Items="items" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh style="width:120px">Submitted</MudTh>
                <MudTh style="width:120px">ID</MudTh>
                <MudTh>Organization</MudTh>
                <MudTh style="width:140px">Status</MudTh>
                <MudTh style="text-align:center; width:170px">Actions</MudTh>
                <MudTh style="text-align:center; width:110px">Details</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Submitted">
                    <MudText Typo="Typo.body2">@context.Id.ToString()[..8]...</MudText>
                    <MudText Typo="Typo.caption" Class="muted">Organization ID</MudText>
                </MudTd>

                <MudTd DataLabel="ID">
                    <MudText>@context.Id.ToString()[..8]...</MudText>
                </MudTd>

                <MudTd DataLabel="Organization">
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                        <MudAvatar Size="Size.Medium" Variant="Variant.Filled">
                            <MudIcon Icon="@Icons.Material.Filled.Business" />
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.subtitle2">@context.FullName</MudText>
                            <MudText Typo="Typo.caption" Class="muted">@(context.City ?? "Unknown"), @(context.Country ?? "Unknown") • @context.Email</MudText>
                        </div>
                    </MudStack>
                </MudTd>

                <MudTd DataLabel="Status">
                    <MudChip T="string" Color="@StatusColor((RequestStatus)context.StatusTypeId)" Variant="Variant.Filled">
                        @context.StatusTypeFullName
                    </MudChip>
                </MudTd>

                <MudTd DataLabel="Actions" Style="text-align:center">
                    <div class="table-actions">
                        @if (context.StatusTypeId == (int)RequestStatus.Pending)
                        {
                            <MudTooltip Text="Approve">
                                <MudIconButton Icon="@Icons.Material.Filled.Check"
                                               Color="Color.Success"
                                               OnClick="@(() => Approve(context))" />
                            </MudTooltip>
                            <MudTooltip Text="Reject">
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Color="Color.Error"
                                               OnClick="@(() => Reject(context))" />
                            </MudTooltip>
                        }
                        else if (context.StatusTypeId == (int)RequestStatus.Approved)
                        {
                            <MudTooltip Text="Revoke approval">
                                <MudIconButton Icon="@Icons.Material.Filled.Undo"
                                               Color="Color.Warning"
                                               OnClick="@(() => RevertToPending(context))" />
                            </MudTooltip>
                        }
                        else if (context.StatusTypeId == (int)RequestStatus.Rejected)
                        {
                            <MudTooltip Text="Move back to pending">
                                <MudIconButton Icon="@Icons.Material.Filled.Restore"
                                               Color="Color.Info"
                                               OnClick="@(() => RevertToPending(context))" />
                            </MudTooltip>
                        }
                    </div>
                </MudTd>

                <MudTd DataLabel="Details" Style="text-align:center">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="@(() => Nav.NavigateTo($"/admin/organization/{context.Id}"))">
                        Details
                    </MudButton>
                </MudTd>
            </RowTemplate>

            <NoRecordsContent>
                <MudText Class="p-4">No requests match your filters.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>;

    // status-kleur
    private Color StatusColor(RequestStatus s) => s switch
    {
        RequestStatus.Pending  => Color.Info,
        RequestStatus.Approved => Color.Success,
        RequestStatus.Rejected => Color.Error,
        _ => Color.Default
    };

    // relatieve tijdsweergave
    private string GetRelative(DateTime utc)
    {
        var ts = DateTime.UtcNow - utc;
        if (ts.TotalDays   >= 1) return $"{(int)ts.TotalDays}d ago";
        if (ts.TotalHours  >= 1) return $"{(int)ts.TotalHours}h ago";
        if (ts.TotalMinutes>= 1) return $"{(int)ts.TotalMinutes}m ago";
        return "just now";
    }

    // acties (met ShowMessageBox en API calls)
    private async Task Approve(OrganizationListDto req)
    {
        bool? ok = await DialogService.ShowMessageBox(
            "Confirm approval",
            $"Approve {req.FullName}?",
            yesText: "Approve", cancelText: "Cancel");

        if (ok == true)
        {
            var success = await AdminService.ApproveOrganizationAsync(req.Id);
            if (success)
            {
                Snackbar.Add($"Approved {req.FullName}", Severity.Success);
                await LoadOrganizationRequests(); // Reload data
            }
            else
            {
                Snackbar.Add($"Failed to approve {req.FullName}", Severity.Error);
            }
        }
    }

    private async Task Reject(OrganizationListDto req)
    {
        bool? ok = await DialogService.ShowMessageBox(
            "Confirm rejection",
            $"Reject {req.FullName}?",
            yesText: "Reject", cancelText: "Cancel");

        if (ok == true)
        {
            var success = await AdminService.RejectOrganizationAsync(req.Id);
            if (success)
            {
                Snackbar.Add($"Rejected {req.FullName}", Severity.Error);
                await LoadOrganizationRequests(); // Reload data
            }
            else
            {
                Snackbar.Add($"Failed to reject {req.FullName}", Severity.Error);
            }
        }
    }

    private async Task RevertToPending(OrganizationListDto req)
    {
        var success = await AdminService.RevertToPendingAsync(req.Id);
        if (success)
        {
            Snackbar.Add($"Moved {req.FullName} back to Pending", Severity.Info);
            await LoadOrganizationRequests(); // Reload data
        }
        else
        {
            Snackbar.Add($"Failed to revert {req.FullName} to pending", Severity.Error);
        }
    }
}

