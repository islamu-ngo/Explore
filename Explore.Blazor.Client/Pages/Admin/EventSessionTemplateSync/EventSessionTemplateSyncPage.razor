@page "/admin/event-sessions/{sessionId:guid}/template-sync"
@rendermode InteractiveAuto
@* ABOUTME: Event Session Template Sync Page displaying template diffs. *@
@* ABOUTME: Allows operators to selectively sync new, modified, and retired definitions/options for a session. *@

@using Explore.Blazor.Client.Models.Responses
@using Explore.Blazor.Client.Models.EventSessionTemplateSync
@using Explore.Blazor.Client.Services.EventSessionTemplateSync
@using Explore.Blazor.Client.Components.EventTemplateSync
@using MudBlazor
@using System.Net.Http

@inject IEventSessionTemplateSyncService TemplateSyncService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<PageTitle>Session Template Sync</PageTitle>

<div class="template-sync-page">
    <div class="template-sync-page__header d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h5">Session Template Sync</MudText>
        @if (_diff?.Links?.ContainsKey("sync-apply") == true && TotalSelected > 0)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OpenApplyDialogAsync" Class="template-sync-page__apply-button" aria-label="Apply Sync Plan">
                Apply Sync (@TotalSelected changes)
            </MudButton>
        }
    </div>

    @if (_isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" aria-live="polite" />
    }
    else if (_hasStaleError)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            Template has been modified by another operator.
            <MudButton Color="Color.Inherit" OnClick="ReloadAsync">Reload Diff</MudButton>
        </MudAlert>
    }
    else if (_diff != null)
    {
        @if (_diff.UntouchedLocalDefinitions.Any())
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                Warning: Session has @(_diff.UntouchedLocalDefinitions.Count) untouched local definitions that are not managed by the template.
            </MudAlert>
        }

        <MudPaper Elevation="0" Class="pa-4 template-sync-page__diff-panel" Style="border-radius: var(--radius-md, 12px);">
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                <MudTabPanel Text="@($"Modified ({_diff.ModifiedDefinitions.Count})")" BadgeData="@_diff.ModifiedDefinitions.Count" BadgeColor="Color.Info">
                    @foreach (var mod in _diff.ModifiedDefinitions)
                    {
                        <TemplateDiffRow Heading="@($"{mod.Namespace}.{mod.Key}")" 
                                         Changes="@mod.FieldChanges.Select(c => new Explore.Blazor.Client.Models.EventTemplateSync.FieldChangeDto(c.FieldName, c.OldValue, c.NewValue, c.ValueType))" 
                                         @bind-IsSelected="GetSelectedState(mod.Key).Value" />
                    }
                </MudTabPanel>
            </MudTabs>
        </MudPaper>
    }
</div>

@code {
    [Parameter]
    public Guid SessionId { get; set; }

    [SupplyParameterFromQuery]
    public int? TemplateVersion { get; set; }

    private bool _isLoading = true;
    private bool _hasStaleError = false;
    private TemplateDiffDto? _diff;
    private Dictionary<string, SelectedState> _selectedChanges = new();

    private class SelectedState { public bool Value { get; set; } }

    private SelectedState GetSelectedState(string key)
    {
        if (!_selectedChanges.TryGetValue(key, out var state))
        {
            state = new SelectedState { Value = false };
            _selectedChanges[key] = state;
        }
        return state;
    }

    private int TotalSelected => _selectedChanges.Values.Count(x => x.Value);

    protected override async Task OnInitializedAsync()
    {
        await LoadDiffAsync();
    }

    private async Task LoadDiffAsync()
    {
        _isLoading = true;
        _hasStaleError = false;
        try
        {
            _diff = await TemplateSyncService.GetDiffAsync(SessionId, TemplateVersion ?? 0);
            _selectedChanges.Clear();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            _hasStaleError = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add("Failed to load template diff.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ReloadAsync()
    {
        await LoadDiffAsync();
    }

    private async Task OpenApplyDialogAsync()
    {
        var parameters = new DialogParameters<TemplateSyncConfirmationDialog>
        {
            { x => x.ExpectedSlug, "session-slug" },
            { x => x.TargetTemplateVersion, _diff!.TargetTemplateVersion },
            { x => x.TotalChangesToApply, TotalSelected }
        };

        var dialog = await DialogService.ShowAsync<TemplateSyncConfirmationDialog>("Confirm Sync", parameters, DialogOptionsFactory.Confirmation());
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var plan = new TemplateSyncPlanDto
            {
                TargetTemplateVersion = _diff!.TargetTemplateVersion,
                BaseProvenanceVersion = _diff.BaseProvenanceVersion,
                ModifiedDefinitionKeys = _selectedChanges.Where(kv => kv.Value.Value).Select(kv => kv.Key).ToList()
            };

            var request = new EventSessionTemplateSyncApplyRequest(plan, _diff.BaseProvenanceVersion);

            try
            {
                await TemplateSyncService.ApplySyncAsync(SessionId, request);
                Snackbar.Add("Session template sync applied successfully.", Severity.Success);
                await LoadDiffAsync();
            }
            catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _hasStaleError = true;
                StateHasChanged();
            }
            catch (Exception)
            {
                Snackbar.Add("Failed to apply session sync.", Severity.Error);
            }
        }
    }
}
