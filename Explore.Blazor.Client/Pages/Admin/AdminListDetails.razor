@page "/admin/organization/{OrganizationId:guid}"
@using MudBlazor
@using Explore.Blazor.Client.Models.DTOs
@using Explore.Blazor.Client.Services
@inject IAdminService AdminService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<style>
    .details-page {
        padding: 24px;
        max-width: 800px;
        margin: 0 auto;
    }
</style>

<MudContainer Class="details-page">
    <MudPaper Class="pa-6" Elevation="3">
        @if (_isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.body1">Loading organization details...</MudText>
            </MudStack>
        }
        else if (organization != null)
        {
            <!-- Header -->
            <MudStack Spacing="4">
                <MudText Typo="Typo.h4" Color="Color.Primary">
                    <MudIcon Icon="@Icons.Material.Filled.Business" Class="mr-2" />
                    Organization Details
                </MudText>

                <!-- Basic Information -->
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3">Basic Information</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Organization Name" Value="@organization.FullName" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Status" Value="@GetStatusName(organization.StatusTypeId)" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Label="Organization ID" Value="@organization.Id.ToString()" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- Contact Information -->
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3">Contact Information</MudText>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Email" Value="@organization.Email" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField Label="Website" Value="@(organization.WebsiteUrl ?? "Not provided")" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- Address Information -->
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3">Address Information</MudText>
                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField Label="Street Address" Value="@(organization.Address ?? "Not provided")" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Label="Postal Code" Value="@(organization.Postcode == 0 ? "Not provided" : organization.Postcode.ToString())" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Label="City" Value="@(organization.City ?? "Not provided")" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Label="Country" Value="@(organization.Country ?? "Not provided")" ReadOnly="true" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- Back Button -->
                <MudStack Direction="FlexDirection.Row" Justify="Justify.SpaceBetween">
                    <MudButton Variant="Variant.Outlined" 
                              Color="Color.Default" 
                              StartIcon="@Icons.Material.Filled.ArrowBack"
                              OnClick="NavigateBack">
                        Back to List
                    </MudButton>
                </MudStack>
            </MudStack>
        }
        else
        {
            <MudText Typo="Typo.h6" Align="Align.Center">Organization not found</MudText>
        }
    </MudPaper>
</MudContainer>

@code {
    [Parameter]
    public Guid OrganizationId { get; set; }

    private OrganizationListDto? organization;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrganizationDetails();
    }

    private async Task LoadOrganizationDetails()
    {
        _isLoading = true;
        try
        {
            organization = await AdminService.GetOrganizationDetailsAsync(OrganizationId);

            if (organization == null)
            {
                Snackbar.Add("Organization not found", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading organization: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/admin");
    }

    private static string GetStatusName(int statusTypeId)
    {
        return statusTypeId switch
        {
            1 => "Pending",
            2 => "Approved",
            3 => "Rejected",
            _ => "Unknown"
        };
    }
}
