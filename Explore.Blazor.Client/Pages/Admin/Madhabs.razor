@page "/admin/madhabs"
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services.Contracts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IMadhabService MadhabService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" GutterBottom="true">Madhabs</MudText>

<MudTable ServerData="@(new Func<TableState, Task<TableData<MadhabListDto>>>(ServerReload))"
          Dense="true" Hover="true" Striped="true" @ref="_table">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Manage Madhabs</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" @onclick="(() => OpenDialog(null))">Create Madhab</MudButton>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Description</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.FullName</MudTd>
        <MudTd DataLabel="Description">@context.Description</MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenDialog(context.Id))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteMadhab(context.Id))" />
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@code {
    private MudTable<MadhabListDto> _table;
    private IEnumerable<MadhabListDto> _madhabs;

    private async Task<TableData<MadhabListDto>> ServerReload(TableState state)
    {
        _madhabs = await MadhabService.GetMadhabsAsync();
        return new TableData<MadhabListDto>() { TotalItems = _madhabs.Count(), Items = _madhabs };
    }

    private async Task OpenDialog(int? id)
    {
        // For now, this is a placeholder. I will implement the dialog later.
        Snackbar.Add("Create/Edit functionality not yet implemented.", Severity.Info);
        await Task.CompletedTask;
    }

    private async Task DeleteMadhab(int id)
    {
        // For now, this is a placeholder. I will implement the delete functionality later.
        Snackbar.Add("Delete functionality not yet implemented.", Severity.Info);
        await Task.CompletedTask;
    }
}
