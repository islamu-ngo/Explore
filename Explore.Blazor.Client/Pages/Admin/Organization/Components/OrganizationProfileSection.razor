@* ABOUTME: Editable organization profile section with member-facing branding controls. *@
@* ABOUTME: Supports name/info updates, picture URL, and banner white-label customization. *@

@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Helpers
@using Explore.Blazor.Client.Services

@inject IOrganizationService OrganizationService
@inject ISnackbar Snackbar

<div class="settings-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Organization Profile</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            Update organization information, picture, and white-label banner styling.
        </MudText>
    </div>

    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
    }
    else if (_organization is null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
            Organization profile could not be loaded.
        </MudAlert>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-3">
                @_errorMessage
            </MudAlert>
        }

        <MudGrid Spacing="3">
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_model.FullName"
                              Label="Organization Name"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="_model.Email"
                              Label="Email"
                              Variant="Variant.Outlined"
                              Required="true"
                              InputType="InputType.Email" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="_model.WebsiteUrl"
                              Label="Website URL"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="_model.Address"
                              Label="Address"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField @bind-Value="_model.Postcode"
                                 Label="Postcode"
                                 Variant="Variant.Outlined"
                                 HideSpinButtons="true"
                                 Min="0" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="_model.City"
                              Label="City"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="_model.Country"
                              Label="Country"
                              Variant="Variant.Outlined"
                              Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Value="@_organization?.ActorProfilePictureUri"
                              Label="Profile Image URL (managed via Actor)"
                              Variant="Variant.Outlined"
                              ReadOnly="true"
                              Placeholder="Set through Actor settings" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField T="string" @bind-Value="_appearance.BackgroundColor"
                              Label="Banner Color"
                              Variant="Variant.Outlined"
                              InputType="InputType.Color" />
            </MudItem>
            <MudItem xs="12" sm="8">
                <MudTextField T="string" @bind-Value="_appearance.ImageUri"
                              Label="Banner Picture URL"
                              Variant="Variant.Outlined"
                              Placeholder="https://... (image or GIF)" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string"
                           Label="Banner Effect"
                           Variant="Variant.Outlined"
                           @bind-Value="_appearance.BackgroundEffect">
                    <MudSelectItem Value="@("None")">None</MudSelectItem>
                    <MudSelectItem Value="@("SoftOverlay")">Soft Overlay</MudSelectItem>
                    <MudSelectItem Value="@("StrongOverlay")">Strong Overlay</MudSelectItem>
                    <MudSelectItem Value="@("Blur")">Blur</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.subtitle2" Class="mb-2">Preview</MudText>
        <MudPaper Elevation="0"
                  Class="pa-6 rounded-lg border-solid border-1 mud-border-lines-default"
                  Style="@AppearanceStyleBuilder.BuildBannerStyle(_appearance, "#1f6feb")">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                @if (!string.IsNullOrWhiteSpace(GetProfileImageUri()))
                {
                    <MudAvatar Size="Size.Large" Rounded="true">
                        <MudImage Src="@GetProfileImageUri()" Alt="@_model.FullName" ObjectFit="ObjectFit.Cover" />
                    </MudAvatar>
                }
                else
                {
                    <MudAvatar Size="Size.Large" Color="Color.Primary" Variant="Variant.Filled" Rounded="true">
                        @(_model.FullName.Length > 0 ? _model.FullName[..1].ToUpperInvariant() : "O")
                    </MudAvatar>
                }
                <div>
                    <MudText Typo="Typo.h6" Style="font-weight: 700; color: white;">@_model.FullName</MudText>
                    <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.9);">@_model.City, @_model.Country</MudText>
                </div>
            </MudStack>
        </MudPaper>

        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
            <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync"
                       Disabled="@_saving"
                       StartIcon="@(_saving ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.Save)">
                @(_saving ? "Saving..." : "Save Organization Settings")
            </MudButton>
        </MudStack>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public Guid OrganizationId { get; set; }

    private OrganizationDto? _organization;
    private OrganizationProfileEditModel _model = new();
    private AppearanceSettings _appearance = new();
    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrganizationAsync();
    }

    private async Task LoadOrganizationAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            _organization = await OrganizationService.GetOrganizationByIdAsync(OrganizationId);
            if (_organization != null)
            {
                _model = new OrganizationProfileEditModel
                {
                    FullName = _organization.FullName ?? string.Empty,
                    Email = _organization.Email ?? string.Empty,
                    WebsiteUrl = _organization.WebsiteUrl,
                    Address = _organization.Address ?? string.Empty,
                    City = _organization.City ?? string.Empty,
                    Country = _organization.Country ?? string.Empty,
                    Postcode = int.TryParse(_organization.Postcode, out var postcode) ? postcode : 0
                };
                _appearance = new AppearanceSettings
                {
                    BackgroundColor = _organization.ActorBackgroundColor ?? string.Empty,
                    ImageUri = _organization.ActorBannerPictureUri ?? string.Empty,
                    BackgroundEffect = _organization.ActorBackgroundEffect ?? string.Empty
                };
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load organization profile: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.FullName)
            || string.IsNullOrWhiteSpace(_model.Email)
            || string.IsNullOrWhiteSpace(_model.Address)
            || string.IsNullOrWhiteSpace(_model.City)
            || string.IsNullOrWhiteSpace(_model.Country))
        {
            _errorMessage = "Please complete all required fields.";
            return;
        }

        _saving = true;
        _errorMessage = null;
        try
        {
            if (_organization.ConcurrencyStamp is not { } concurrencyStamp || concurrencyStamp == Guid.Empty)
            {
                _errorMessage = "Reload the organization profile before saving changes.";
                return;
            }

            var response = await OrganizationService.UpdateOrganizationAsync(
                OrganizationId,
                concurrencyStamp,
                BuildUpdateDto(_model));

            if (response?.Success == true)
            {
                Snackbar.Add("Organization profile updated.", Severity.Success);
                await LoadOrganizationAsync();
                return;
            }

            _errorMessage = string.IsNullOrWhiteSpace(response?.Message)
                ? "Failed to update organization profile."
                : response!.Message;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to update organization profile: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private string? GetProfileImageUri()
    {
        if (!string.IsNullOrWhiteSpace(_organization?.ActorProfilePictureUri))
        {
            return _organization.ActorProfilePictureUri.Trim();
        }

        return null;
    }

    private static UpdateOrganizationDto BuildUpdateDto(OrganizationProfileEditModel model)
    {
        return new UpdateOrganizationDto
        {
            FullName = new UpdateOrganizationFullNameDto { Value = model.FullName },
            Email = new UpdateOrganizationEmailDto { Value = model.Email },
            WebsiteUrl = new UpdateOrganizationWebsiteUrlDto
            {
                Value = new OptionalUpdateOfstring
                {
                    HasValue = true,
                    Value = string.IsNullOrWhiteSpace(model.WebsiteUrl) ? null : model.WebsiteUrl
                }
            },
            Address = new UpdateOrganizationAddressDto { Value = model.Address },
            City = new UpdateOrganizationCityDto { Value = model.City },
            Country = new UpdateOrganizationCountryDto { Value = model.Country },
            Postcode = new UpdateOrganizationPostcodeDto { Value = model.Postcode }
        };
    }

    private sealed class OrganizationProfileEditModel
    {
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string? WebsiteUrl { get; set; }
        public string Address { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string Country { get; set; } = string.Empty;
        public int Postcode { get; set; }
    }
}
