@page "/admin/languages"
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services.Contracts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode @(new InteractiveAutoRenderMode(prerender: false))

<div class="admin-languages">
    <!-- Hero Section -->
    <MudPaper Class="admin-languages__hero" Elevation="0">
        <div class="admin-languages__hero-top">
            <div class="admin-languages__hero-title">
                <div class="admin-languages__hero-badge">
                    <MudIcon Icon="@Icons.Material.Filled.Language" Color="Color.Success" />
                </div>
                <div>
                    <MudText Typo="Typo.h4" Class="admin-languages__title-text">
                        Languages
                    </MudText>
                    <MudText Typo="Typo.body2" Class="admin-languages__hero-subtitle">
                        Supported languages for events (read-only lookup table)
                    </MudText>
                </div>
            </div>

            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => Nav.NavigateTo("/admin"))"
                           Class="admin-languages__action-btn">
                    Back to Admin
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadData"
                           Class="admin-languages__action-btn">
                    Refresh
                </MudButton>
            </MudStack>
        </div>

        <!-- Stats -->
        <div class="admin-languages__stats">
            <div class="admin-languages__stat">
                <div class="admin-languages__stat-row">
                    <div class="admin-languages__stat-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Language" Color="Color.Success" />
                    </div>
                    <div>
                        <div class="admin-languages__stat-label">Total Languages</div>
                        <div class="admin-languages__stat-value">@_items.Count</div>
                    </div>
                </div>
            </div>
        </div>
    </MudPaper>

    @if (_isLoading)
    {
        <MudPaper Class="admin-languages__panel" Elevation="0">
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="py-4">
                <MudProgressCircular Color="Color.Success" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.body1">Loading languages…</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <div class="admin-languages__section">
            <!-- Info Banner -->
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="admin-languages__alert mb-3">
                <MudText Typo="Typo.body2">
                    <strong>Read-only lookup table.</strong> Languages are system-defined values.
                    Contact system administrator if changes are needed.
                </MudText>
            </MudAlert>

            <!-- Table -->
            <MudPaper Class="admin-languages__table-panel" Elevation="0">
                <MudTable Items="@_items"
                          Dense="true"
                          Hover="true"
                          Striped="true"
                          Breakpoint="Breakpoint.Sm"
                          Loading="@_isLoading"
                          LoadingProgressColor="Color.Success">
                    <HeaderContent>
                        <MudTh Class="admin-languages__col-id">ID</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Code</MudTh>
                        <MudTh>Description</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Default">
                                @context.Id
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Name">
                            <div class="admin-languages__name-cell">
                                <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Small" Color="Color.Success" />
                                <MudText Typo="Typo.body2" Class="admin-languages__name-text">@context.FullName</MudText>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Code">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                @context.MasterCode
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Description">
                            <MudText Typo="Typo.body2" Class="admin-languages__muted">
                                @(context.Description ?? "—")
                            </MudText>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="admin-languages__empty">
                            <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Large" />
                            <MudText Typo="Typo.h6" Class="admin-languages__empty-title">No languages found</MudText>
                            <MudText Typo="Typo.body2" Class="admin-languages__muted">
                                The lookup table is empty.
                            </MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        </div>
    }
</div>
