@page "/admin/locations"
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services.Contracts
@using Explore.Blazor.Client.Components.Admin
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode @(new InteractiveAutoRenderMode(prerender: false))
@inject ILocationService LocationService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<div class="admin-locations">
    <!-- Hero Section -->
    <MudPaper Class="admin-locations__hero" Elevation="0">
        <div class="admin-locations__hero-top">
            <div class="admin-locations__hero-title">
                <div class="admin-locations__hero-badge">
                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Success" />
                </div>
                <div>
                    <MudText Typo="Typo.h4" Class="admin-locations__title-text">
                        Locations Management
                    </MudText>
                    <MudText Typo="Typo.body2" Class="admin-locations__hero-subtitle">
                        Create, edit, and manage event locations
                    </MudText>
                </div>
            </div>

            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => Nav.NavigateTo("/admin"))"
                           Class="admin-locations__action-btn">
                    Back to Admin
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadLocations"
                           Class="admin-locations__action-btn">
                    Refresh
                </MudButton>
            </MudStack>
        </div>

        <!-- Stats -->
        <div class="admin-locations__stats">
            <div class="admin-locations__stat">
                <div class="admin-locations__stat-row">
                    <div class="admin-locations__stat-icon">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Success" />
                    </div>
                    <div>
                        <div class="admin-locations__stat-label">Total Locations</div>
                        <div class="admin-locations__stat-value">@_locations.Count</div>
                    </div>
                </div>
            </div>
            <div class="admin-locations__stat">
                <div class="admin-locations__stat-row">
                    <div class="admin-locations__stat-icon admin-locations__stat-icon--countries">
                        <MudIcon Icon="@Icons.Material.Filled.Public" Color="Color.Info" />
                    </div>
                    <div>
                        <div class="admin-locations__stat-label">Countries</div>
                        <div class="admin-locations__stat-value">@_locations.Select(l => l.Country).Distinct().Count()</div>
                    </div>
                </div>
            </div>
            <div class="admin-locations__stat">
                <div class="admin-locations__stat-row">
                    <div class="admin-locations__stat-icon admin-locations__stat-icon--cities">
                        <MudIcon Icon="@Icons.Material.Filled.LocationCity" Color="Color.Warning" />
                    </div>
                    <div>
                        <div class="admin-locations__stat-label">Cities</div>
                        <div class="admin-locations__stat-value">@_locations.Select(l => l.City).Distinct().Count()</div>
                    </div>
                </div>
            </div>
        </div>
    </MudPaper>

    @if (_isLoading)
    {
        <MudPaper Class="admin-locations__panel" Elevation="0">
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="py-4">
                <MudProgressCircular Color="Color.Success" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.body1">Loading locations…</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <div class="admin-locations__section">
            <!-- Toolbar -->
            <MudPaper Class="admin-locations__panel" Elevation="0">
                <div class="admin-locations__toolbar">
                    <MudTextField @bind-Value="_searchString"
                                  Placeholder="Search locations..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Clearable="true"
                                  Margin="Margin.Dense"
                                  Class="admin-locations__search-field" />

                    <MudSpacer />

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateDialog"
                               Class="admin-locations__create-btn">
                        Create Location
                    </MudButton>
                </div>
            </MudPaper>

            <!-- Table -->
            <MudPaper Class="admin-locations__table-panel" Elevation="0">
                <MudTable Items="@FilteredLocations"
                          Dense="true"
                          Hover="true"
                          Striped="true"
                          Breakpoint="Breakpoint.Sm"
                          Loading="@_isLoading"
                          LoadingProgressColor="Color.Success">
                    <HeaderContent>
                        <MudTh Class="admin-locations__col-id">#</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Address</MudTh>
                        <MudTh>City</MudTh>
                        <MudTh>Country</MudTh>
                        <MudTh Class="admin-locations__col-actions">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="#">
                            <MudText Typo="Typo.body2" Class="admin-locations__id">@context.Id.ToString()[..8]…</MudText>
                        </MudTd>
                        <MudTd DataLabel="Name">
                            <div class="admin-locations__name-cell">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Success" />
                                <MudText Typo="Typo.body2" Class="admin-locations__name-text">@context.FullName</MudText>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Address">
                            <MudText Typo="Typo.body2">@(context.Address ?? "—")</MudText>
                        </MudTd>
                        <MudTd DataLabel="City">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                @(context.City ?? "—")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Country">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Default">
                                @(context.Country ?? "—")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Actions" Class="admin-locations__cell-actions">
                            <div class="admin-locations__actions">
                                <MudTooltip Text="Edit">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenEditDialog(context))" />
                                </MudTooltip>
                                <MudTooltip Text="Delete">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => DeleteLocation(context))" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="admin-locations__empty">
                            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Large" />
                            <MudText Typo="Typo.h6" Class="admin-locations__empty-title">No locations found</MudText>
                            <MudText Typo="Typo.body2" Class="admin-locations__muted">
                                @if (string.IsNullOrWhiteSpace(_searchString))
                                {
                                    <span>Create your first location to get started.</span>
                                }
                                else
                                {
                                    <span>No locations match your search criteria.</span>
                                }
                            </MudText>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       OnClick="OpenCreateDialog"
                                       Class="admin-locations__empty-btn">
                                Create Location
                            </MudButton>
                        </div>
                    </NoRecordsContent>

                </MudTable>
            </MudPaper>
        </div>
    }
</div>

@code {
    private ICollection<LocationListDto> _locations = new List<LocationListDto>();
    private string _searchString = string.Empty;
    private bool _isLoading = true;

    private IEnumerable<LocationListDto> FilteredLocations => string.IsNullOrWhiteSpace(_searchString)
        ? _locations
        : _locations.Where(l =>
            (l.FullName?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (l.Address?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (l.City?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (l.Country?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadLocations();
    }

    private async Task LoadLocations()
    {
        _isLoading = true;
        try
        {
            _locations = await LocationService.GetLocations();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load locations: {ex.Message}", Severity.Error);
            _locations = new List<LocationListDto>();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<CreateLocationDialog>("Create Location", options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: CreateLocationDto createDto })
        {
            var response = await LocationService.CreateLocationAsync(createDto);
            if (response?.Success == true)
            {
                Snackbar.Add($"Location '{createDto.FullName}' created successfully", Severity.Success);
                await LoadLocations();
            }
            else
            {
                var errors = response?.Errors != null ? string.Join(", ", response.Errors) : "Unknown error";
                Snackbar.Add($"Failed to create location: {errors}", Severity.Error);
            }
        }
    }

    private async Task OpenEditDialog(LocationListDto location)
    {
        if (location.Id == null)
        {
            Snackbar.Add("Location ID is missing.", Severity.Error);
            return;
        }

        // First, get the full location details
        var locationDetails = await LocationService.GetLocationByIdAsync(location.Id.Value);
        if (locationDetails == null)
        {
            Snackbar.Add("Failed to load location details", Severity.Error);
            return;
        }

        var parameters = new DialogParameters<EditLocationDialog>
        {
            { x => x.ExistingLocation, locationDetails }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<EditLocationDialog>("Edit Location", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: UpdateLocationDto updateDto })
        {
            if (updateDto.Id == null)
            {
                Snackbar.Add("Location ID is missing for update.", Severity.Error);
                return;
            }
            var response = await LocationService.UpdateLocationAsync(updateDto.Id.Value, updateDto);
            if (response?.Success == true)
            {
                Snackbar.Add($"Location '{updateDto.FullName}' updated successfully", Severity.Success);
                await LoadLocations();
            }
            else
            {
                var errors = response?.Errors != null ? string.Join(", ", response.Errors) : "Unknown error";
                Snackbar.Add($"Failed to update location: {errors}", Severity.Error);
            }
        }
    }

    private async Task DeleteLocation(LocationListDto location)
    {
        bool? confirm = await DialogService.ShowMessageBox(
            "Confirm Delete",
            $"Are you sure you want to delete the location '{location.FullName}'? This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm == true)
        {
            if (location.Id == null)
            {
                Snackbar.Add("Location ID is missing for delete.", Severity.Error);
                return;
            }
            var success = await LocationService.DeleteLocationAsync(location.Id.Value);
            if (success)
            {
                Snackbar.Add($"Location '{location.FullName}' deleted successfully", Severity.Success);
                await LoadLocations();
            }
            else
            {
                Snackbar.Add($"Failed to delete location '{location.FullName}'", Severity.Error);
            }
        }
    }
}
