@page "/admin/categories"
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services.Contracts
@using Explore.Blazor.Client.Components.Admin
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-8">
    <!-- Hero Section -->
    <MudPaper Elevation="0" Class="pa-6 mb-6 rounded-xl relative overflow-hidden" Style="background: radial-gradient(circle at 80% 10%, rgba(156, 39, 176, 0.15), transparent 60%), linear-gradient(180deg, var(--mud-palette-surface), var(--mud-palette-background)); border: 1px solid var(--mud-palette-lines-default);">
        <div class="d-flex justify-space-between align-center flex-wrap gap-4">
            <div class="d-flex align-center gap-4">
                <MudAvatar Rounded="true" Size="Size.Large" Color="Color.Secondary" Variant="Variant.Filled">
                    <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Medium" />
                </MudAvatar>
                <div>
                    <MudText Typo="Typo.h4" Style="font-weight: 800;">Categories Management</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary">Create, edit, and manage event categories</MudText>
                </div>
            </div>
            
            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("/admin"))" Class="rounded-pill">Back to Admin</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadCategories" Class="rounded-pill">Refresh</MudButton>
            </div>
        </div>

        <MudGrid Class="mt-6" Spacing="3">
            <MudItem xs="12" sm="6">
                <MudCard Elevation="0" Class="pa-4 border-solid border-1 mud-border-lines-default rounded-lg">
                    <div class="d-flex align-center gap-4">
                        <MudAvatar Rounded="true" Color="Color.Secondary" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.Category" />
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Total Categories</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight: 700;">@_categories.Count</MudText>
                        </div>
                    </div>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudCard Elevation="0" Class="pa-4 border-solid border-1 mud-border-lines-default rounded-lg">
                    <div class="d-flex align-center gap-4">
                        <MudAvatar Rounded="true" Color="Color.Info" Variant="Variant.Outlined">
                            <MudIcon Icon="@Icons.Material.Filled.AccountTree" />
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Parent Categories</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight: 700;">@_categories.Count(c => c.ParentId == null)</MudText>
                        </div>
                    </div>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-6 rounded-lg">@_errorMessage</MudAlert>
    }

    @if (_isLoading)
    {
        <div class="d-flex flex-column align-center justify-center py-12">
            <MudProgressCircular Color="Color.Secondary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.body1" Class="mt-4" Color="Color.Secondary">Loading categories...</MudText>
        </div>
    }
    else
    {
        <MudPaper Elevation="0" Class="pa-4 border-solid border-1 mud-border-lines-default rounded-xl">
            <!-- Toolbar -->
            <div class="d-flex justify-space-between align-center flex-wrap gap-4 mb-4">
                <MudTextField @bind-Value="_searchString"
                              Placeholder="Search categories..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="rounded-pill"
                              Style="max-width: 400px;" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog"
                           Class="rounded-pill">
                    Create Category
                </MudButton>
            </div>

            <!-- Table -->
            <MudTable Items="@FilteredCategories"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Breakpoint="Breakpoint.Sm"
                      Elevation="0"
                      Class="border-none">
                <HeaderContent>
                    <MudTh>#</MudTh>
                    <MudTh>Name</MudTh>
                    <MudTh>Master Code</MudTh>
                    <MudTh>Parent Category</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="#">
                        <MudText Typo="Typo.caption" Class="font-monospace">@context.Id.ToString()[..8]…</MudText>
                    </MudTd>
                    <MudTd DataLabel="Name">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@context.FullName</MudText>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Code">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                            @context.MasterCode
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Parent">
                        @if (!string.IsNullOrEmpty(context.ParentFullName))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Info">
                                @context.ParentFullName
                            </MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Root category</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align:right">
                        <MudTooltip Text="Edit">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenEditDialog(context))" />
                        </MudTooltip>
                        <MudTooltip Text="Delete">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DeleteCategory(context))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="d-flex flex-column align-center justify-center pa-8">
                        <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Large" Color="Color.Default" />
                        <MudText Typo="Typo.h6" Class="mt-2" Style="font-weight: 700;">No categories found</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @if (string.IsNullOrWhiteSpace(_searchString))
                            {
                                <span>Create your first category to get started.</span>
                            }
                            else
                            {
                                <span>No categories match your search criteria.</span>
                            }
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   OnClick="OpenCreateDialog"
                                   Class="mt-4 rounded-pill">
                            Create Category
                        </MudButton>
                    </div>
                </NoRecordsContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                </PagerContent>
            </MudTable>
        </MudPaper>
    }
</MudContainer>