@page "/admin/categories"
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services.Contracts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject ICategoryService CategoryService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" GutterBottom="true">Categories</MudText>

<MudTable T="CategoryListDto" ServerData="@ServerReload"
          Dense="true" Hover="true" Striped="true" @ref="_table">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Manage Categories</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" @onclick="(() => OpenDialog(null))">Create Category</MudButton>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Parent</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.FullName</MudTd>
        <MudTd DataLabel="Parent">@context.ParentFullName</MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenDialog(context.Id))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteCategory(context.Id))" />
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@code {
    private MudTable<CategoryListDto> _table;
    private IEnumerable<CategoryListDto> _categories;

    private async Task<TableData<CategoryListDto>> ServerReload(TableState state, CancellationToken cancellationToken)
    {
        _categories = await CategoryService.GetCategories();
        return new TableData<CategoryListDto>() { TotalItems = _categories.Count(), Items = _categories };
    }

    private async Task OpenDialog(Guid? id)
    {
        // For now, this is a placeholder. I will implement the dialog later.
        Snackbar.Add("Create/Edit functionality not yet implemented.", Severity.Info);
        await Task.CompletedTask;
    }

    private async Task DeleteCategory(Guid id)
    {
        // For now, this is a placeholder. I will implement the delete functionality later.
        Snackbar.Add("Delete functionality not yet implemented.", Severity.Info);
        await Task.CompletedTask;
    }
}