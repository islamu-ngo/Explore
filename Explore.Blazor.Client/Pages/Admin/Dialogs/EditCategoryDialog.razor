@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Validators
@using FluentValidation
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3 mb-n1" />
            Edit Category
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="success" Model="categoryDto">
            <AppTextField T="string" @bind-Value="categoryDto.FullName" Label="Name" For="@(() => categoryDto.FullName)" Required="true" RequiredError="Name is required." />
            <AppTextField T="string" @bind-Value="categoryDto.MasterCode" Label="Master Code" For="@(() => categoryDto.MasterCode)" Required="true" RequiredError="Master Code is required." />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <AppButton OnClick="Cancel">Cancel</AppButton>
        <AppButton OnClick="Submit">Update</AppButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IDialogReference? DialogReference { get; set; }

    [Parameter] public CategoryListDto ExistingCategory { get; set; }

    private UpdateCategoryDtoValidator validator = new();
    private MudForm form;
    private bool success;

    private UpdateCategoryDto categoryDto = new();

    protected override void OnInitialized()
    {
        categoryDto.Id = ExistingCategory.Id;
        categoryDto.FullName = ExistingCategory.FullName;
        categoryDto.MasterCode = ExistingCategory.MasterCode;
        categoryDto.ParentId = ExistingCategory.ParentId;
    }

    private async Task Submit()
    {
        await form.Validate();
        if (form.IsValid)
        {
            DialogReference?.Dismiss(DialogResult.Ok(categoryDto));
        }
    }

    void Cancel() => DialogReference?.Dismiss(DialogResult.Cancel());
}
