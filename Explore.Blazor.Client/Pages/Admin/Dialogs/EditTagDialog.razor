@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Validators
@using FluentValidation
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3 mb-n1" />
            Edit Tag
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm EditContext="_editContext">
            <FluentValidationValidator />
            <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="tagDto.FullName" Label="Name" For="@(() => tagDto.FullName)" Required="true" RequiredError="Name is required." />
            <MudTextField Variant="Variant.Outlined" T="string" @bind-Value="tagDto.MasterCode" Label="Master Code" For="@(() => tagDto.MasterCode)" Required="true" RequiredError="Master Code is required." />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" OnClick="Cancel">Cancel</MudButton>
        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Update</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IDialogReference? DialogReference { get; set; }

    [Parameter] public TagDto ExistingTag { get; set; }

    private EditContext _editContext = default!;
    private UpdateTagDto tagDto = new();

    protected override void OnInitialized()
    {
        tagDto.Id = ExistingTag.Id;
        tagDto.FullName = ExistingTag.FullName;
        tagDto.MasterCode = ExistingTag.MasterCode;
        tagDto.TenantId = ExistingTag.TenantId;
        _editContext = new EditContext(tagDto);
    }

    private void Submit()
    {
        if (_editContext.Validate())
        {
            DialogReference?.Dismiss(DialogResult.Ok(tagDto));
        }
    }

    void Cancel() => DialogReference?.Dismiss(DialogResult.Cancel());
}
