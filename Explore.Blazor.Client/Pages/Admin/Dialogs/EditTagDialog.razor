@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Validators
@using FluentValidation
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3 mb-n1" />
            Edit Tag
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="success" Model="tagDto">
            <AppTextField T="string" @bind-Value="tagDto.FullName" Label="Name" For="@(() => tagDto.FullName)" Required="true" RequiredError="Name is required." />
            <AppTextField T="string" @bind-Value="tagDto.MasterCode" Label="Master Code" For="@(() => tagDto.MasterCode)" Required="true" RequiredError="Master Code is required." />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <AppButton OnClick="Cancel">Cancel</AppButton>
        <AppButton OnClick="Submit">Update</AppButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IDialogReference? DialogReference { get; set; }

    [Parameter] public TagDto ExistingTag { get; set; }

    private UpdateTagDtoValidator validator = new();
    private MudForm form;
    private bool success;

    private UpdateTagDto tagDto = new();

    protected override void OnInitialized()
    {
        tagDto.Id = ExistingTag.Id;
        tagDto.FullName = ExistingTag.FullName;
        tagDto.MasterCode = ExistingTag.MasterCode;
        tagDto.TenantId = ExistingTag.TenantId;
    }

    private async Task Submit()
    {
        await form.Validate();
        if (form.IsValid)
        {
            DialogReference?.Dismiss(DialogResult.Ok(tagDto));
        }
    }

    void Cancel() => DialogReference?.Dismiss(DialogResult.Cancel());
}
