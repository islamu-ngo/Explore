@page "/admin/lookup-tables"
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode @(new InteractiveAutoRenderMode(prerender: false))

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.TableChart" Class="mr-2" />
        Lookup Tables Management
    </MudText>

    <MudText Typo="Typo.body1" Class="mb-4" Color="Color.Secondary">
        View and manage system lookup tables (read-only). These tables are typically seeded during database initialization.
    </MudText>

    @if (isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
        <!-- Event Related -->
        <MudTabPanel Text="Event Types" Icon="@Icons.Material.Filled.Event">
            <MudDataGrid T="EventTypeListDto" Items="@eventTypes" Dense="true" Hover="true" Bordered="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => x.FullName" Title="Name" />
                    <PropertyColumn Property="x => x.Description" Title="Description" />
                </Columns>
            </MudDataGrid>
        </MudTabPanel>

        <MudTabPanel Text="Event Formats" Icon="@Icons.Material.Filled.FormatListBulleted">
            <MudDataGrid T="EventFormatListDto" Items="@eventFormats" Dense="true" Hover="true" Bordered="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                    <PropertyColumn Property="x => x.FullName" Title="Name" />
                </Columns>
            </MudDataGrid>
        </MudTabPanel>

        <MudTabPanel Text="Event Statuses" Icon="@Icons.Material.Filled.Flag">
            <MudDataGrid T="EventStatusListDto" Items="@eventStatuses" Dense="true" Hover="true" Bordered="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                    <PropertyColumn Property="x => x.FullName" Title="Name" />
                </Columns>
            </MudDataGrid>
        </MudTabPanel>

        <MudTabPanel Text="Visibility Types" Icon="@Icons.Material.Filled.Visibility">
            <MudDataGrid T="VisibilityTypeListDto" Items="@visibilityTypes" Dense="true" Hover="true" Bordered="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                    <PropertyColumn Property="x => x.FullName" Title="Name" />
                </Columns>
            </MudDataGrid>
        </MudTabPanel>

        <MudTabPanel Text="Registration Modes" Icon="@Icons.Material.Filled.HowToReg">
            <MudDataGrid T="RegistrationModeListDto" Items="@registrationModes" Dense="true" Hover="true" Bordered="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                    <PropertyColumn Property="x => x.FullName" Title="Name" />
                </Columns>
            </MudDataGrid>
        </MudTabPanel>

        <!-- Audience Related -->
        <MudTabPanel Text="Audience Genders" Icon="@Icons.Material.Filled.People">
            <MudDataGrid T="AudienceGenderListDto" Items="@audienceGenders" Dense="true" Hover="true" Bordered="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                    <PropertyColumn Property="x => x.FullName" Title="Name" />
                </Columns>
            </MudDataGrid>
        </MudTabPanel>

        <MudTabPanel Text="Audience Ages" Icon="@Icons.Material.Filled.ChildCare">
            <MudDataGrid T="AudienceAgeListDto" Items="@audienceAges" Dense="true" Hover="true" Bordered="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                    <PropertyColumn Property="x => x.FullName" Title="Name" />
                </Columns>
            </MudDataGrid>
        </MudTabPanel>

        <!-- Religious -->
        <MudTabPanel Text="Madhabs" Icon="@Icons.Material.Filled.Mosque">
            <MudDataGrid T="MadhabListDto" Items="@madhabs" Dense="true" Hover="true" Bordered="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                    <PropertyColumn Property="x => x.FullName" Title="Name" />
                </Columns>
            </MudDataGrid>
        </MudTabPanel>

        <!-- Languages -->
        <MudTabPanel Text="Languages" Icon="@Icons.Material.Filled.Language">
            <MudDataGrid T="LanguageListDto" Items="@languages" Dense="true" Hover="true" Bordered="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                    <PropertyColumn Property="x => x.FullName" Title="Name" />
                </Columns>
            </MudDataGrid>
        </MudTabPanel>

        <!-- Organization Related -->
        <MudTabPanel Text="Org Positions" Icon="@Icons.Material.Filled.Work">
            <MudDataGrid T="OrganizationPositionListDto" Items="@organizationPositions" Dense="true" Hover="true" Bordered="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                    <PropertyColumn Property="x => x.FullName" Title="Name" />
                </Columns>
            </MudDataGrid>
        </MudTabPanel>

        <MudTabPanel Text="Approval Statuses" Icon="@Icons.Material.Filled.Approval">
            <MudDataGrid T="StatusTypeListDto" Items="@approvalStatuses" Dense="true" Hover="true" Bordered="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                    <PropertyColumn Property="x => x.FullName" Title="Name" />
                </Columns>
            </MudDataGrid>
        </MudTabPanel>

        <!-- System -->
        <MudTabPanel Text="Actor Types" Icon="@Icons.Material.Filled.Person">
            <MudDataGrid T="ActorTypeListDto" Items="@actorTypes" Dense="true" Hover="true" Bordered="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                    <PropertyColumn Property="x => x.FullName" Title="Name" />
                </Columns>
            </MudDataGrid>
        </MudTabPanel>

        <MudTabPanel Text="File Types" Icon="@Icons.Material.Filled.InsertDriveFile">
            <MudDataGrid T="FileTypeListDto" Items="@fileTypes" Dense="true" Hover="true" Bordered="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                    <PropertyColumn Property="x => x.FullName" Title="Name" />
                </Columns>
            </MudDataGrid>
        </MudTabPanel>

        <MudTabPanel Text="DID Custody Types" Icon="@Icons.Material.Filled.Key">
            <MudDataGrid T="DidCustodyTypeListDto" Items="@didCustodyTypes" Dense="true" Hover="true" Bordered="true">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="ID" />
                    <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                    <PropertyColumn Property="x => x.FullName" Title="Name" />
                </Columns>
            </MudDataGrid>
        </MudTabPanel>
    </MudTabs>
</MudContainer>
