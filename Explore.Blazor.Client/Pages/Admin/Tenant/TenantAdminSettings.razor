@* ABOUTME: Page wrapper for the Tenant Admin Settings sidebar layout. *@
@* ABOUTME: Redirects to instance settings in single-tenant mode; renders TenantAdminSettingsLayout otherwise. *@

@page "/admin/tenant/settings"
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@using Explore.Blazor.Client.Pages.Admin.Tenant.Components
@using Explore.Blazor.Client.Services
@attribute [Authorize]
@rendermode InteractiveServer
@inject IInstanceOnboardingService InstanceOnboardingService
@inject NavigationManager Navigation

<PageTitle>Tenant Settings</PageTitle>

@if (_errorMessage is not null)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
        <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
    </MudContainer>
}
else if (!_redirecting)
{
    <TenantAdminSettingsLayout />
}

@code {
    private bool _redirecting;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var deploymentMode = await InstanceOnboardingService.GetDeploymentModeAsync();
            if (string.Equals(deploymentMode.Mode, "SingleTenant", StringComparison.OrdinalIgnoreCase)
                || string.IsNullOrWhiteSpace(deploymentMode?.Mode))
            {
                _redirecting = true;
                Navigation.NavigateTo("/admin/instance/settings", replace: true);
            }
        }
        catch
        {
            _errorMessage = "Unable to determine deployment mode. Please refresh or contact support.";
        }
    }
}
