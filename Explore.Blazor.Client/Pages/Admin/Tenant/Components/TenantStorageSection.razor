@* ABOUTME: Tenant storage settings section for inherited policy and optional tenant overrides. *@
@* ABOUTME: Renders locked/read-only states and HAL-gated storage provider fields. *@

@using MudBlazor
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients

<div class="settings-section tenant-storage-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Object Storage</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            Review inherited storage policy and configure tenant-specific limits when platform delegation allows overrides.
        </MudText>
    </div>

    @if (Model.TenantOverridesAllowed != true || Model.TenantStorageLocked == true || Model.IsReadOnly == true)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="tenant-storage-section__alert">
            Storage overrides are read-only for this tenant. The effective provider and quotas below are inherited from platform policy.
        </MudAlert>
    }
    else if (!Model.HasLink("edit"))
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="tenant-storage-section__alert">
            Storage settings are visible, but the API response did not include an edit affordance for this session.
        </MudAlert>
    }

    <div class="tenant-storage-section__summary">
        <div class="tenant-storage-section__summary-item">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Effective Provider</MudText>
            <MudText Typo="Typo.subtitle1">@StorageProviderOptions.Label(Model.EffectivePolicy?.Provider)</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@Model.EffectivePolicy?.ProviderSource</MudText>
        </div>
        <div class="tenant-storage-section__summary-item">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Max Upload</MudText>
            <MudText Typo="Typo.subtitle1">@FormatBytes(Model.EffectivePolicy?.MaxUploadBytes ?? 0)</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@Model.EffectivePolicy?.MaxUploadSource</MudText>
        </div>
        <div class="tenant-storage-section__summary-item">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Tenant Quota</MudText>
            <MudText Typo="Typo.subtitle1">@FormatBytes(Model.EffectivePolicy?.TenantQuotaBytes ?? 0)</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@Model.EffectivePolicy?.QuotaSource</MudText>
        </div>
    </div>

    <div class="tenant-storage-section__usage" aria-label="Tenant storage usage">
        <div class="tenant-storage-section__usage-item">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Used</MudText>
            <MudText Typo="Typo.h6">@FormatBytes(Model.Usage?.UsedBytes ?? 0)</MudText>
        </div>
        <div class="tenant-storage-section__usage-item">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Reserved</MudText>
            <MudText Typo="Typo.h6">@FormatBytes(Model.Usage?.ReservedBytes ?? 0)</MudText>
        </div>
        <div class="tenant-storage-section__usage-item">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Available</MudText>
            <MudText Typo="Typo.h6">@(Model.Usage?.AvailableBytes is long available ? FormatBytes(available) : "Not tracked")</MudText>
        </div>
        <div class="tenant-storage-section__usage-item">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Objects</MudText>
            <MudText Typo="Typo.h6">@(Model.Usage?.ObjectCount ?? 0)</MudText>
        </div>
    </div>

    <MudStack Spacing="3" Class="tenant-storage-section__form">
        <MudSelect T="string"
                   Label="Tenant Storage Provider"
                   Variant="Variant.Outlined"
                   @bind-Value="Provider"
                   Disabled="@ControlsDisabled">
            <MudSelectItem T="string" Value="@StorageProviderOptions.Local">Local file storage</MudSelectItem>
            <MudSelectItem T="string" Value="@StorageProviderOptions.S3Compatible">S3-compatible object storage</MudSelectItem>
        </MudSelect>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudNumericField T="long"
                                 Label="Max upload (MB)"
                                 Variant="Variant.Outlined"
                                 @bind-Value="MaxUploadMiB"
                                 Min="1L"
                                 Max="@InstanceMaxUploadMiB"
                                 Disabled="@ControlsDisabled"
                                 HelperText="@($"Platform ceiling: {FormatBytes(Model.EffectivePolicy?.InstanceMaxUploadBytes ?? 0)}")" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="long"
                                 Label="Tenant quota (GB)"
                                 Variant="Variant.Outlined"
                                 @bind-Value="TenantQuotaGiB"
                                 Min="1L"
                                 Disabled="@ControlsDisabled"
                                 HelperText="Total storage quota for this tenant." />
            </MudItem>
        </MudGrid>

        <MudPaper Class="tenant-storage-section__route-matrix pa-4" Elevation="0" Outlined="true">
            <MudStack Spacing="2">
                <div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Hybrid storage routes</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Tenant overrides stay bounded by the platform ceiling and are disabled when storage delegation is locked.
                    </MudText>
                </div>

                @foreach (var route in Model.Routes ?? [])
                {
                    <MudGrid Spacing="3" Class="tenant-storage-section__route-row" aria-label="@($"{StorageRouteOptions.Label(route.RouteKey)} storage route")">
                        <MudItem xs="12" md="4">
                            <MudText Typo="Typo.subtitle2">@StorageRouteOptions.Label(route.RouteKey)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@StorageRouteOptions.Description(route.RouteKey)</MudText>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudSelect T="string"
                                       Label="@($"{StorageRouteOptions.Label(route.RouteKey)} provider")"
                                       Variant="Variant.Outlined"
                                       Dense="true"
                                       @bind-Value="route.Provider"
                                       Disabled="@(ControlsDisabled || route.IsReadOnly == true)">
                                <MudSelectItem T="string" Value="@StorageProviderOptions.Local">Local file storage</MudSelectItem>
                                <MudSelectItem T="string" Value="@StorageProviderOptions.S3Compatible">S3-compatible object storage</MudSelectItem>
                            </MudSelect>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Source: @route.ProviderSource</MudText>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField T="long"
                                             Label="@($"{StorageRouteOptions.Label(route.RouteKey)} max upload (MB)")"
                                             Variant="Variant.Outlined"
                                             Dense="true"
                                             Value="@StorageAdminExtensions.BytesToMiB(route.MaxUploadBytes)"
                                             ValueChanged="@(value => route.MaxUploadBytes = StorageAdminExtensions.MiBToBytes(value))"
                                             Min="1L"
                                             Max="@InstanceMaxUploadMiB"
                                             Disabled="@(ControlsDisabled || route.IsReadOnly == true)" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Source: @route.MaxUploadSource</MudText>
                        </MudItem>
                    </MudGrid>
                }
            </MudStack>
        </MudPaper>

        @if (Provider == StorageProviderOptions.S3Compatible)
        {
            <div class="tenant-storage-section__provider-panel">
                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">S3-Compatible Override</MudText>
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Endpoint"
                                      Variant="Variant.Outlined"
                                      @bind-Value="Model.S3Endpoint"
                                      Disabled="@ControlsDisabled"
                                      Placeholder="https://object-storage.example.com" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Public Endpoint"
                                      Variant="Variant.Outlined"
                                      @bind-Value="Model.S3PublicEndpoint"
                                      Disabled="@ControlsDisabled"
                                      Placeholder="https://cdn.example.com" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Bucket Name"
                                      Variant="Variant.Outlined"
                                      @bind-Value="Model.S3BucketName"
                                      Disabled="@ControlsDisabled" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Region"
                                      Variant="Variant.Outlined"
                                      @bind-Value="Model.S3Region"
                                      Disabled="@ControlsDisabled" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Access Key ID"
                                      Variant="Variant.Outlined"
                                      @bind-Value="Model.S3AccessKeyId"
                                      Disabled="@ControlsDisabled"
                                      HelperText="@ConfiguredText(Model.S3AccessKeyConfigured, "access key")" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Secret Access Key"
                                      Variant="Variant.Outlined"
                                      @bind-Value="Model.S3SecretAccessKey"
                                      InputType="InputType.Password"
                                      Disabled="@ControlsDisabled"
                                      HelperText="@ConfiguredText(Model.S3SecretAccessKeyConfigured, "secret key")" />
                    </MudItem>
                </MudGrid>

                <MudSwitch T="bool"
                           @bind-Value="S3ForcePathStyle"
                           Color="Color.Primary"
                           Disabled="@ControlsDisabled">
                    Force path-style URLs
                </MudSwitch>

                <MudNumericField T="int"
                                 Label="Upload URL expiration (minutes)"
                                 Variant="Variant.Outlined"
                                 @bind-Value="S3UploadUrlExpirationMinutes"
                                 Min="1"
                                 Max="1440"
                                 Disabled="@ControlsDisabled" />
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
                Local file storage is selected for this tenant. Files remain accessible only through metadata-backed API URLs.
            </MudAlert>
        }
    </MudStack>
</div>

@code {
    [Parameter, EditorRequired]
    public HalResourceOfTenantStorageSettingsDto Model { get; set; } = null!;

    [Parameter]
    public bool IsSaving { get; set; }

    private bool ControlsDisabled => IsSaving || !Model.IsEditable();

    private string Provider
    {
        get => StorageProviderOptions.Normalize(Model.Provider);
        set => Model.Provider = value;
    }

    private long MaxUploadMiB
    {
        get => StorageAdminExtensions.BytesToMiB(Model.MaxUploadBytes);
        set => Model.MaxUploadBytes = StorageAdminExtensions.MiBToBytes(value);
    }

    private long TenantQuotaGiB
    {
        get => StorageAdminExtensions.BytesToGiB(Model.TenantQuotaBytes);
        set => Model.TenantQuotaBytes = StorageAdminExtensions.GiBToBytes(value);
    }

    private bool S3ForcePathStyle
    {
        get => Model.S3ForcePathStyle ?? true;
        set => Model.S3ForcePathStyle = value;
    }

    private int S3UploadUrlExpirationMinutes
    {
        get => Model.S3UploadUrlExpirationMinutes ?? 60;
        set => Model.S3UploadUrlExpirationMinutes = value;
    }

    private long InstanceMaxUploadMiB =>
        StorageAdminExtensions.BytesToMiB(Model.EffectivePolicy?.InstanceMaxUploadBytes);

    private static string ConfiguredText(bool? configured, string label) =>
        configured == true ? $"An existing {label} is configured. Leave blank to keep it." : string.Empty;

    private static string FormatBytes(long bytes)
    {
        const double oneKiB = 1024d;
        string[] units = ["bytes", "KB", "MB", "GB", "TB"];
        var value = (double)Math.Max(0, bytes);
        var unit = 0;
        while (value >= oneKiB && unit < units.Length - 1)
        {
            value /= oneKiB;
            unit++;
        }

        return unit == 0 ? $"{value:0} {units[unit]}" : $"{value:0.#} {units[unit]}";
    }
}
