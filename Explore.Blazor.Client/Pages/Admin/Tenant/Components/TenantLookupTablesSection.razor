@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Pages.Admin.Components
@using Explore.Blazor.Client.Pages.Admin.Dialogs
@using Explore.Blazor.Client.Services
@using MudBlazor

<div class="settings-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Lookup Tables</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            Manage editable lookups and review seeded reference tables in one place.
        </MudText>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
    }

    @if (_isLoading)
    {
        <MudStack AlignItems="AlignItems.Center" Class="py-8">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">Loading lookup tables...</MudText>
        </MudStack>
    }
    else
    {
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">
            <MudTabPanel Text="Categories" Icon="@Icons.Material.Filled.Category">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                    <AppTextField T="string" @bind-Value="_categorySearch"
                                  Placeholder="Search categories..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Clearable="true"
                                  Class="flex-grow-1" />
                    <AppButton StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateCategoryDialogAsync">
                        Create
                    </AppButton>
                </MudStack>

                <MudTable Items="FilteredCategories" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Code</MudTh>
                        <MudTh>Parent</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.FullName</MudTd>
                        <MudTd DataLabel="Code">@context.MasterCode</MudTd>
                        <MudTd DataLabel="Parent">@(string.IsNullOrWhiteSpace(context.ParentFullName) ? "Root" : context.ParentFullName)</MudTd>
                        <MudTd DataLabel="Actions">
                            <AppIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditCategoryDialogAsync(context))" />
                            <AppIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteCategoryAsync(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="Tags" Icon="@Icons.Material.Filled.LocalOffer">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                    <AppTextField T="string" @bind-Value="_tagSearch"
                                  Placeholder="Search tags..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Clearable="true"
                                  Class="flex-grow-1" />
                    <AppButton StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateTagDialogAsync">
                        Create
                    </AppButton>
                </MudStack>

                <MudTable Items="FilteredTags" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Code</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.FullName</MudTd>
                        <MudTd DataLabel="Code">@context.MasterCode</MudTd>
                        <MudTd DataLabel="Actions">
                            <AppIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditTagDialogAsync(context))" />
                            <AppIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteTagAsync(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="Locations" Icon="@Icons.Material.Filled.LocationOn">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
                    <AppTextField T="string" @bind-Value="_locationSearch"
                                  Placeholder="Search locations..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Clearable="true"
                                  Class="flex-grow-1" />
                    <AppButton StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenCreateLocationDialogAsync">
                        Create
                    </AppButton>
                </MudStack>

                <MudTable Items="FilteredLocations" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Address</MudTh>
                        <MudTh>City</MudTh>
                        <MudTh>Country</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.FullName</MudTd>
                        <MudTd DataLabel="Address">@(context.Address ?? "-")</MudTd>
                        <MudTd DataLabel="City">@(context.City ?? "-")</MudTd>
                        <MudTd DataLabel="Country">@(context.Country ?? "-")</MudTd>
                        <MudTd DataLabel="Actions">
                            <AppIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditLocationDialogAsync(context))" />
                            <AppIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteLocationAsync(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudTabPanel>

            <MudTabPanel Text="Event Types" Icon="@Icons.Material.Filled.Event">
                <MudDataGrid T="EventTypeListDto" Items="_eventTypes" Dense="true" Hover="true" Bordered="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Id" Title="ID" />
                        <PropertyColumn Property="x => x.FullName" Title="Name" />
                        <PropertyColumn Property="x => x.Description" Title="Description" />
                    </Columns>
                </MudDataGrid>
            </MudTabPanel>

            <MudTabPanel Text="Event Formats" Icon="@Icons.Material.Filled.FormatListBulleted">
                <MudDataGrid T="EventFormatListDto" Items="_eventFormats" Dense="true" Hover="true" Bordered="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Id" Title="ID" />
                        <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                        <PropertyColumn Property="x => x.FullName" Title="Name" />
                    </Columns>
                </MudDataGrid>
            </MudTabPanel>

            <MudTabPanel Text="Event Statuses" Icon="@Icons.Material.Filled.Flag">
                <MudDataGrid T="EventStatusListDto" Items="_eventStatuses" Dense="true" Hover="true" Bordered="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Id" Title="ID" />
                        <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                        <PropertyColumn Property="x => x.FullName" Title="Name" />
                    </Columns>
                </MudDataGrid>
            </MudTabPanel>

            <MudTabPanel Text="Visibility Types" Icon="@Icons.Material.Filled.Visibility">
                <MudDataGrid T="VisibilityTypeListDto" Items="_visibilityTypes" Dense="true" Hover="true" Bordered="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Id" Title="ID" />
                        <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                        <PropertyColumn Property="x => x.FullName" Title="Name" />
                    </Columns>
                </MudDataGrid>
            </MudTabPanel>

            <MudTabPanel Text="Registration Modes" Icon="@Icons.Material.Filled.HowToReg">
                <MudDataGrid T="RegistrationModeListDto" Items="_registrationModes" Dense="true" Hover="true" Bordered="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Id" Title="ID" />
                        <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                        <PropertyColumn Property="x => x.FullName" Title="Name" />
                    </Columns>
                </MudDataGrid>
            </MudTabPanel>

            <MudTabPanel Text="Audience Genders" Icon="@Icons.Material.Filled.People">
                <MudDataGrid T="AudienceGenderListDto" Items="_audienceGenders" Dense="true" Hover="true" Bordered="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Id" Title="ID" />
                        <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                        <PropertyColumn Property="x => x.FullName" Title="Name" />
                    </Columns>
                </MudDataGrid>
            </MudTabPanel>

            <MudTabPanel Text="Audience Ages" Icon="@Icons.Material.Filled.ChildCare">
                <MudDataGrid T="AudienceAgeListDto" Items="_audienceAges" Dense="true" Hover="true" Bordered="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Id" Title="ID" />
                        <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                        <PropertyColumn Property="x => x.FullName" Title="Name" />
                    </Columns>
                </MudDataGrid>
            </MudTabPanel>

            <MudTabPanel Text="Madhabs" Icon="@Icons.Material.Filled.Mosque">
                <MudDataGrid T="MadhabListDto" Items="_madhabs" Dense="true" Hover="true" Bordered="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Id" Title="ID" />
                        <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                        <PropertyColumn Property="x => x.FullName" Title="Name" />
                    </Columns>
                </MudDataGrid>
            </MudTabPanel>

            <MudTabPanel Text="Languages" Icon="@Icons.Material.Filled.Language">
                <MudDataGrid T="LanguageListDto" Items="_languages" Dense="true" Hover="true" Bordered="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Id" Title="ID" />
                        <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                        <PropertyColumn Property="x => x.FullName" Title="Name" />
                    </Columns>
                </MudDataGrid>
            </MudTabPanel>

            <MudTabPanel Text="Org Positions" Icon="@Icons.Material.Filled.Work">
                <MudDataGrid T="OrganizationPositionListDto" Items="_organizationPositions" Dense="true" Hover="true" Bordered="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Id" Title="ID" />
                        <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                        <PropertyColumn Property="x => x.FullName" Title="Name" />
                    </Columns>
                </MudDataGrid>
            </MudTabPanel>

            <MudTabPanel Text="Approval Statuses" Icon="@Icons.Material.Filled.Approval">
                <MudDataGrid T="StatusTypeListDto" Items="_approvalStatuses" Dense="true" Hover="true" Bordered="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Id" Title="ID" />
                        <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                        <PropertyColumn Property="x => x.FullName" Title="Name" />
                    </Columns>
                </MudDataGrid>
            </MudTabPanel>

            <MudTabPanel Text="Actor Types" Icon="@Icons.Material.Filled.Person">
                <MudDataGrid T="ActorTypeListDto" Items="_actorTypes" Dense="true" Hover="true" Bordered="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Id" Title="ID" />
                        <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                        <PropertyColumn Property="x => x.FullName" Title="Name" />
                    </Columns>
                </MudDataGrid>
            </MudTabPanel>

            <MudTabPanel Text="File Types" Icon="@Icons.Material.Filled.InsertDriveFile">
                <MudDataGrid T="FileTypeListDto" Items="_fileTypes" Dense="true" Hover="true" Bordered="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Id" Title="ID" />
                        <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                        <PropertyColumn Property="x => x.FullName" Title="Name" />
                    </Columns>
                </MudDataGrid>
            </MudTabPanel>

            <MudTabPanel Text="DID Custody Types" Icon="@Icons.Material.Filled.Key">
                <MudDataGrid T="DidCustodyTypeListDto" Items="_didCustodyTypes" Dense="true" Hover="true" Bordered="true">
                    <Columns>
                        <PropertyColumn Property="x => x.Id" Title="ID" />
                        <PropertyColumn Property="x => x.MasterCode" Title="Code" />
                        <PropertyColumn Property="x => x.FullName" Title="Name" />
                    </Columns>
                </MudDataGrid>
            </MudTabPanel>
        </MudTabs>
    }
</div>

@code {
    [Inject] private IAdminService AdminService { get; set; } = null!;
    [Inject] private IDialogService DialogService { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    private bool _isLoading = true;
    private string? _errorMessage;

    private string _categorySearch = string.Empty;
    private string _tagSearch = string.Empty;
    private string _locationSearch = string.Empty;

    private ICollection<CategoryListDto> _categories = new List<CategoryListDto>();
    private ICollection<TagListDto> _tags = new List<TagListDto>();
    private ICollection<LocationListDto> _locations = new List<LocationListDto>();

    private ICollection<EventTypeListDto> _eventTypes = new List<EventTypeListDto>();
    private ICollection<EventFormatListDto> _eventFormats = new List<EventFormatListDto>();
    private ICollection<EventStatusListDto> _eventStatuses = new List<EventStatusListDto>();
    private ICollection<VisibilityTypeListDto> _visibilityTypes = new List<VisibilityTypeListDto>();
    private ICollection<RegistrationModeListDto> _registrationModes = new List<RegistrationModeListDto>();
    private ICollection<AudienceGenderListDto> _audienceGenders = new List<AudienceGenderListDto>();
    private ICollection<AudienceAgeListDto> _audienceAges = new List<AudienceAgeListDto>();
    private ICollection<MadhabListDto> _madhabs = new List<MadhabListDto>();
    private ICollection<LanguageListDto> _languages = new List<LanguageListDto>();
    private ICollection<OrganizationPositionListDto> _organizationPositions = new List<OrganizationPositionListDto>();
    private ICollection<StatusTypeListDto> _approvalStatuses = new List<StatusTypeListDto>();
    private ICollection<ActorTypeListDto> _actorTypes = new List<ActorTypeListDto>();
    private ICollection<FileTypeListDto> _fileTypes = new List<FileTypeListDto>();
    private ICollection<DidCustodyTypeListDto> _didCustodyTypes = new List<DidCustodyTypeListDto>();

    private IEnumerable<CategoryListDto> FilteredCategories => string.IsNullOrWhiteSpace(_categorySearch)
        ? _categories
        : _categories.Where(c =>
            (c.FullName?.Contains(_categorySearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (c.MasterCode?.Contains(_categorySearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (c.ParentFullName?.Contains(_categorySearch, StringComparison.OrdinalIgnoreCase) ?? false));

    private IEnumerable<TagListDto> FilteredTags => string.IsNullOrWhiteSpace(_tagSearch)
        ? _tags
        : _tags.Where(t =>
            (t.FullName?.Contains(_tagSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (t.MasterCode?.Contains(_tagSearch, StringComparison.OrdinalIgnoreCase) ?? false));

    private IEnumerable<LocationListDto> FilteredLocations => string.IsNullOrWhiteSpace(_locationSearch)
        ? _locations
        : _locations.Where(l =>
            (l.FullName?.Contains(_locationSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (l.Address?.Contains(_locationSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (l.City?.Contains(_locationSearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (l.Country?.Contains(_locationSearch, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override async Task OnInitializedAsync()
    {
        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var tasks = new List<Task>
            {
                LoadCategoriesAsync(),
                LoadTagsAsync(),
                LoadLocationsAsync(),
                LoadReferenceLookupTablesAsync()
            };

            await Task.WhenAll(tasks);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load lookup data: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadCategoriesAsync()
    {
        _categories = await AdminService.GetCategoriesAsync() ?? new List<CategoryListDto>();
    }

    private async Task LoadTagsAsync()
    {
        _tags = await AdminService.GetTagsAsync() ?? new List<TagListDto>();
    }

    private async Task LoadLocationsAsync()
    {
        _locations = await AdminService.GetLocationsAsync() ?? new List<LocationListDto>();
    }

    private async Task LoadReferenceLookupTablesAsync()
    {
        var tasks = new List<Task>
        {
            LoadEventTypesAsync(),
            LoadEventFormatsAsync(),
            LoadEventStatusesAsync(),
            LoadVisibilityTypesAsync(),
            LoadRegistrationModesAsync(),
            LoadAudienceGendersAsync(),
            LoadAudienceAgesAsync(),
            LoadMadhabsAsync(),
            LoadLanguagesAsync(),
            LoadOrganizationPositionsAsync(),
            LoadApprovalStatusesAsync(),
            LoadActorTypesAsync(),
            LoadFileTypesAsync(),
            LoadDidCustodyTypesAsync()
        };

        await Task.WhenAll(tasks);
    }

    private async Task LoadEventTypesAsync() => _eventTypes = await AdminService.GetEventTypesAsync();
    private async Task LoadEventFormatsAsync() => _eventFormats = await AdminService.GetEventFormatsAsync();
    private async Task LoadEventStatusesAsync() => _eventStatuses = await AdminService.GetEventStatusesAsync();
    private async Task LoadVisibilityTypesAsync() => _visibilityTypes = await AdminService.GetVisibilityTypesAsync();
    private async Task LoadRegistrationModesAsync() => _registrationModes = await AdminService.GetRegistrationModesAsync();
    private async Task LoadAudienceGendersAsync() => _audienceGenders = await AdminService.GetAudienceGendersAsync();
    private async Task LoadAudienceAgesAsync() => _audienceAges = await AdminService.GetAudienceAgesAsync();
    private async Task LoadMadhabsAsync() => _madhabs = await AdminService.GetMadhabsAsync();
    private async Task LoadLanguagesAsync() => _languages = await AdminService.GetLanguagesAsync();
    private async Task LoadOrganizationPositionsAsync() => _organizationPositions = await AdminService.GetOrganizationPositionsAsync();
    private async Task LoadApprovalStatusesAsync() => _approvalStatuses = await AdminService.GetApprovalStatusesAsync();
    private async Task LoadActorTypesAsync() => _actorTypes = await AdminService.GetActorTypesAsync();
    private async Task LoadFileTypesAsync() => _fileTypes = await AdminService.GetFileTypesAsync();
    private async Task LoadDidCustodyTypesAsync() => _didCustodyTypes = await AdminService.GetDidCustodyTypesAsync();

    private async Task OpenCreateCategoryDialogAsync()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await CreateCategoryDialog.ShowAsync(DialogService, "Create Category", options: options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: CreateCategoryDto createDto })
        {
            var success = await AdminService.CreateCategoryAsync(createDto);
            if (success)
            {
                Snackbar.Add($"Category '{createDto.FullName}' created.", Severity.Success);
                await LoadCategoriesAsync();
            }
            else
            {
                Snackbar.Add("Failed to create category.", Severity.Error);
            }
        }
    }

    private async Task OpenEditCategoryDialogAsync(CategoryListDto category)
    {
        if (!category.Id.HasValue)
        {
            return;
        }

        var parameters = new DialogParameters<EditCategoryDialog>
        {
            { x => x.ExistingCategory, category }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await EditCategoryDialog.ShowAsync(DialogService, "Edit Category", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: UpdateCategoryDto updateDto })
        {
            var success = await AdminService.UpdateCategoryAsync(updateDto);
            if (success)
            {
                Snackbar.Add($"Category '{updateDto.FullName}' updated.", Severity.Success);
                await LoadCategoriesAsync();
            }
            else
            {
                Snackbar.Add("Failed to update category.", Severity.Error);
            }
        }
    }

    private async Task DeleteCategoryAsync(CategoryListDto category)
    {
        if (!category.Id.HasValue)
        {
            return;
        }

        var confirm = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            $"Are you sure you want to delete the category '{category.FullName}'? This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm == true)
        {
            var success = await AdminService.DeleteCategoryAsync(category.Id.Value);
            if (success)
            {
                Snackbar.Add($"Category '{category.FullName}' deleted.", Severity.Success);
                await LoadCategoriesAsync();
            }
            else
            {
                Snackbar.Add($"Failed to delete category '{category.FullName}'.", Severity.Error);
            }
        }
    }

    private async Task OpenCreateTagDialogAsync()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await CreateTagDialog.ShowAsync(DialogService, "Create Tag", options: options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: CreateTagDto createDto })
        {
            var success = await AdminService.CreateTagAsync(createDto);
            if (success)
            {
                Snackbar.Add($"Tag '{createDto.FullName}' created.", Severity.Success);
                await LoadTagsAsync();
            }
            else
            {
                Snackbar.Add("Failed to create tag.", Severity.Error);
            }
        }
    }

    private async Task OpenEditTagDialogAsync(TagListDto tag)
    {
        if (!tag.Id.HasValue)
        {
            return;
        }

        var tagDetails = await AdminService.GetTagByIdAsync(tag.Id.Value);
        if (tagDetails == null)
        {
            Snackbar.Add("Failed to load tag details.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters<EditTagDialog>
        {
            { x => x.ExistingTag, tagDetails }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await EditTagDialog.ShowAsync(DialogService, "Edit Tag", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: UpdateTagDto updateDto })
        {
            var success = await AdminService.UpdateTagAsync(updateDto);
            if (success)
            {
                Snackbar.Add($"Tag '{updateDto.FullName}' updated.", Severity.Success);
                await LoadTagsAsync();
            }
            else
            {
                Snackbar.Add("Failed to update tag.", Severity.Error);
            }
        }
    }

    private async Task DeleteTagAsync(TagListDto tag)
    {
        if (!tag.Id.HasValue)
        {
            return;
        }

        var confirm = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            $"Are you sure you want to delete the tag '{tag.FullName}'? This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm == true)
        {
            var success = await AdminService.DeleteTagAsync(tag.Id.Value);
            if (success)
            {
                Snackbar.Add($"Tag '{tag.FullName}' deleted.", Severity.Success);
                await LoadTagsAsync();
            }
            else
            {
                Snackbar.Add($"Failed to delete tag '{tag.FullName}'.", Severity.Error);
            }
        }
    }

    private async Task OpenCreateLocationDialogAsync()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await CreateLocationDialog.ShowAsync(DialogService, "Create Location", options: options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: CreateLocationDto createDto })
        {
            var success = await AdminService.CreateLocationAsync(createDto);
            if (success)
            {
                Snackbar.Add($"Location '{createDto.FullName}' created.", Severity.Success);
                await LoadLocationsAsync();
            }
            else
            {
                Snackbar.Add("Failed to create location.", Severity.Error);
            }
        }
    }

    private async Task OpenEditLocationDialogAsync(LocationListDto location)
    {
        if (!location.Id.HasValue)
        {
            return;
        }

        var locationDetails = await AdminService.GetLocationByIdAsync(location.Id.Value);
        if (locationDetails == null)
        {
            Snackbar.Add("Failed to load location details.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters<EditLocationDialog>
        {
            { x => x.ExistingLocation, locationDetails }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await EditLocationDialog.ShowAsync(DialogService, "Edit Location", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: UpdateLocationDto updateDto })
        {
            var success = await AdminService.UpdateLocationAsync(updateDto);
            if (success)
            {
                Snackbar.Add($"Location '{updateDto.FullName}' updated.", Severity.Success);
                await LoadLocationsAsync();
            }
            else
            {
                Snackbar.Add("Failed to update location.", Severity.Error);
            }
        }
    }

    private async Task DeleteLocationAsync(LocationListDto location)
    {
        if (!location.Id.HasValue)
        {
            return;
        }

        var confirm = await DialogService.ShowMessageBoxAsync(
            "Confirm Delete",
            $"Are you sure you want to delete the location '{location.FullName}'? This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm == true)
        {
            var success = await AdminService.DeleteLocationAsync(location.Id.Value);
            if (success)
            {
                Snackbar.Add($"Location '{location.FullName}' deleted.", Severity.Success);
                await LoadLocationsAsync();
            }
            else
            {
                Snackbar.Add($"Failed to delete location '{location.FullName}'.", Severity.Error);
            }
        }
    }
}
