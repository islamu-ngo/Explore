@* ABOUTME: Sidebar layout component for Tenant Admin Settings. *@
@* ABOUTME: Provides Google-style sidebar navigation for tenant-level policy, domain, and branding settings. *@

@using MudBlazor
@using Microsoft.AspNetCore.Components
@using Explore.Blazor.Client.Services

@inject ITenantOnboardingService TenantOnboardingService
@inject IInstanceOnboardingService InstanceOnboardingService
@inject ISnackbar Snackbar

<div class="settings-layout">
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
        <!-- Header -->
        <div class="settings-header mb-8">
            <MudText Typo="Typo.h4" HtmlTag="h1" Style="font-weight: 800;">
                @(_isSingleTenantMode ? "Administration" : "Tenant Administration")
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                @(_isSingleTenantMode
                    ? "Manage policies, domains, branding, organization approvals, and lookup tables"
                    : "Manage tenant policies, domains, branding, organization approvals, and lookup tables")
            </MudText>
            @if (_isInstanceAdmin && !_isSingleTenantMode)
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-4">
                    <MudChip T="string"
                             Color="Color.Info"
                             Variant="Variant.Outlined"
                             Icon="@Icons.Material.Filled.Apartment">
                        Multi-Tenant
                    </MudChip>
                    <AppButton Variant="Variant.Text"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Dns"
                               Href="/admin/instance/settings">
                        Manage Platform
                    </AppButton>
                </MudStack>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        @if (_isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Class="py-12">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">Loading tenant settings...</MudText>
            </MudStack>
        }
        else if (!_canEdit)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                You do not have tenant administrator permissions to view or modify these settings.
            </MudAlert>
        }
        else
        {
            <!-- Main Layout: Sidebar + Content -->
            <MudGrid Spacing="4">
                <!-- Sidebar Navigation -->
                <MudItem xs="3" sm="3" md="3">
                    <MudPaper Elevation="0" Class="settings-sidebar pa-0">
                        <MudList T="string" Dense="false" DisablePadding="true">
                            <MudListItem Icon="@Icons.Material.Filled.Policy"
                                         Text="Policies"
                                         Class="@GetNavItemClass("policies")"
                                         OnClick="@(() => SelectSection("policies"))" />
                            <MudListItem Icon="@Icons.Material.Filled.Speed"
                                         Text="Render Policy"
                                         Class="@GetNavItemClass("render-policy")"
                                         OnClick="@(() => SelectSection("render-policy"))" />
                            <MudListItem Icon="@Icons.Material.Filled.Language"
                                         Text="Domain"
                                         Class="@GetNavItemClass("domain")"
                                         OnClick="@(() => SelectSection("domain"))" />
                            <MudListItem Icon="@Icons.Material.Filled.Palette"
                                         Text="Branding"
                                         Class="@GetNavItemClass("branding")"
                                         OnClick="@(() => SelectSection("branding"))" />
                            <MudListItem Icon="@Icons.Material.Filled.Business"
                                         Text="Organizations"
                                         Class="@GetNavItemClass("organizations")"
                                         OnClick="@(() => SelectSection("organizations"))" />
                            <MudListItem Icon="@Icons.Material.Filled.TableChart"
                                         Text="Lookup Tables"
                                         Class="@GetNavItemClass("lookups")"
                                         OnClick="@(() => SelectSection("lookups"))" />
                            @if (_model.CanOverrideSmtp)
                            {
                                <MudListItem Icon="@Icons.Material.Filled.Email"
                                             Text="Email (SMTP)"
                                             Class="@GetNavItemClass("smtp")"
                                             OnClick="@(() => SelectSection("smtp"))" />
                            }
                            @if (_model.CanOverrideStorage)
                            {
                                <MudListItem Icon="@Icons.Material.Filled.Cloud"
                                             Text="Object Storage"
                                             Class="@GetNavItemClass("storage")"
                                             OnClick="@(() => SelectSection("storage"))" />
                            }
                            @if (_model.CanOverrideAnalytics)
                            {
                                <MudListItem Icon="@Icons.Material.Filled.Analytics"
                                             Text="Analytics & Privacy"
                                             Class="@GetNavItemClass("analytics")"
                                             OnClick="@(() => SelectSection("analytics"))" />
                            }
                            <MudListItem Icon="@Icons.Material.Outlined.Gavel"
                                         Text="Community Guidelines"
                                         Class="@GetNavItemClass("community-guidelines")"
                                         OnClick="@(() => SelectSection("community-guidelines"))" />
                            @if (_isSingleTenantMode && _isInstanceAdmin)
                            {
                                <MudListItem Icon="@Icons.Material.Filled.Engineering"
                                             Text="Advanced"
                                             Class="@GetNavItemClass("advanced")"
                                             OnClick="@(() => SelectSection("advanced"))" />
                            }
                        </MudList>
                    </MudPaper>
                </MudItem>

                <!-- Content Area -->
                <MudItem xs="9" sm="9" md="9">
                    <MudPaper Elevation="0" Class="settings-content pa-6">
                        @if (_currentSection == "policies")
                        {
                            <TenantPoliciesSection Model="_model" />
                        }
                        else if (_currentSection == "render-policy")
                        {
                            <TenantRenderPolicySection Model="_model" />
                        }
                        else if (_currentSection == "domain")
                        {
                            <TenantDomainSection Model="_model" />
                        }
                        else if (_currentSection == "branding")
                        {
                            <TenantBrandingSection Model="_model" />
                        }
                        else if (_currentSection == "organizations")
                        {
                            <TenantOrganizationsSection />
                        }
                        else if (_currentSection == "lookups")
                        {
                            <TenantLookupTablesSection />
                        }
                        else if (_currentSection == "smtp" && _model.CanOverrideSmtp)
                        {
                            <div class="settings-section">
                                <div class="settings-section-header">
                                    <MudText Typo="Typo.h5" Style="font-weight: 700;">Email (SMTP) Configuration</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                                        Configure SMTP settings for this tenant. When overridden, emails sent on behalf of this tenant will use these credentials instead of the platform defaults.
                                    </MudText>
                                </div>
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                                    Tenant-specific SMTP configuration is enabled by your platform administrator. Per-tenant override controls will be available in a future update.
                                    Currently, emails are sent using the platform-level SMTP settings.
                                </MudAlert>
                            </div>
                        }
                        else if (_currentSection == "storage" && _model.CanOverrideStorage)
                        {
                            <div class="settings-section">
                                <div class="settings-section-header">
                                    <MudText Typo="Typo.h5" Style="font-weight: 700;">Object Storage</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                                        Configure S3-compatible object storage for this tenant. When overridden, file uploads for this tenant will use a dedicated storage bucket.
                                    </MudText>
                                </div>
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                                    Tenant-specific storage configuration is enabled by your platform administrator. Per-tenant override controls will be available in a future update.
                                    Currently, files are stored using the platform-level storage settings.
                                </MudAlert>
                            </div>
                        }
                        else if (_currentSection == "analytics" && _model.CanOverrideAnalytics)
                        {
                            <div class="settings-section">
                                <div class="settings-section-header">
                                    <MudText Typo="Typo.h5" Style="font-weight: 700;">Analytics & Privacy</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                                        Configure analytics and privacy settings for this tenant. When overridden, tenant-specific analytics preferences take effect.
                                    </MudText>
                                </div>
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                                    Tenant-specific analytics configuration is enabled by your platform administrator. Per-tenant override controls will be available in a future update.
                                    Currently, analytics settings are inherited from the platform configuration.
                                </MudAlert>
                            </div>
                        }
                        else if (_currentSection == "community-guidelines")
                        {
                            <div class="settings-section">
                                <div class="settings-section-header">
                                    <MudText Typo="Typo.h5" Style="font-weight: 700;">Community Guidelines</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                                        Manage the community guidelines displayed to users on the
                                        <MudLink Href="/community-guidelines" Target="_blank" Color="Color.Primary">Community Guidelines</MudLink>
                                        page. Guidelines inform event organizers and attendees of the platform's expectations.
                                    </MudText>
                                </div>
                                @if (!_model.CanOverrideCommunityGuidelines)
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4 mb-4">
                                        The community guidelines content has been locked by the platform administrator and cannot be changed for this tenant.
                                    </MudAlert>
                                }
                                <div class="settings-form-section mt-4">
                                    <AppTextField T="string" T="string"
                                                  @bind-Value="_model.CommunityGuidelinesContent"
                                                  Label="Guidelines Content"
                                                  Lines="20"
                                                  Variant="Variant.Outlined"
                                                  ReadOnly="!_model.CanOverrideCommunityGuidelines"
                                                  HelperText="Supports basic Markdown: # Heading, ## Section, - bullet, **bold**, *italic*."
                                                  FullWidth="true"
                                                  Style="font-family: monospace; font-size: 0.875rem;" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                        This content is displayed publicly. Leave empty to use the platform default guidelines.
                                    </MudText>
                                </div>
                            </div>
                        }
                        else if (_currentSection == "advanced" && _isSingleTenantMode && _isInstanceAdmin)
                        {
                            <div class="settings-section">
                                <div class="settings-section-header">
                                    <MudText Typo="Typo.h5" Style="font-weight: 700;">Advanced Settings</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Danger zone and platform-level operations.</MudText>
                                </div>
                                <div class="settings-form-section">
                                    <MudText Typo="Typo.subtitle2">Multi-Tenant Mode</MudText>
                                    <MudText Typo="Typo.body2" Class="mb-4">
                                        Your platform is currently running in Single-Tenant Mode. If you intend to host multiple organizations with their own dedicated instances, domains, and policies, you can switch to Multi-Tenant Mode. 
                                        <strong>This will enable the full Instance Administration dashboard.</strong>
                                    </MudText>
                                    <AppButton Variant="Variant.Outlined" Color="Color.Warning" Href="/admin/instance/settings">
                                        Go to Instance Administration
                                    </AppButton>
                                </div>
                            </div>
                        }

                        <MudDivider Class="my-4" />

                        <MudStack Row="true" Justify="Justify.FlexEnd">
                            <AppButton OnClick="SaveAsync"
                                       Disabled="_isSaving"
                                       StartIcon="@(_isSaving ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.Save)">
                                @(_isSaving ? "Saving..." : "Save Tenant Settings")
                            </AppButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    </MudContainer>
</div>

@code {
    private TenantPolicySettingsModel _model = new();
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _canEdit;
    private bool _isSingleTenantMode;
    private bool _isInstanceAdmin;
    private string? _errorMessage;
    private string _currentSection = "policies";

    protected override async Task OnInitializedAsync()
    {
        var tenantStatus = await TenantOnboardingService.GetStatusAsync();
        _canEdit = tenantStatus?.IsCurrentUserTenantAdministrator == true;

        if (!_canEdit)
        {
            _isLoading = false;
            return;
        }

        var instanceStatus = await InstanceOnboardingService.GetStatusAsync();
        _isInstanceAdmin = instanceStatus?.IsCurrentUserInstanceAdmin == true;
        _isSingleTenantMode = instanceStatus == null
            || string.IsNullOrWhiteSpace(instanceStatus.SelectedDeploymentMode)
            || string.Equals(instanceStatus.SelectedDeploymentMode, "SingleTenant", StringComparison.OrdinalIgnoreCase);

        _model = await TenantOnboardingService.GetSettingsAsync();
        _isLoading = false;
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        _errorMessage = null;

        var response = await TenantOnboardingService.UpdateSettingsAsync(_model);
        _isSaving = false;

        if (response.Success)
        {
            Snackbar.Add("Tenant settings saved.", Severity.Success);
            return;
        }

        _errorMessage = string.IsNullOrWhiteSpace(response.Message)
            ? "Failed to save tenant settings."
            : response.Message;
    }

    private void SelectSection(string section)
    {
        _currentSection = section;
    }

    private string GetNavItemClass(string section)
    {
        return _currentSection == section ? "settings-nav-active" : "";
    }
}
