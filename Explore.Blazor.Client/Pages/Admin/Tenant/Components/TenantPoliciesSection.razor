@* ABOUTME: Renders event and organization policy settings for the Tenant Admin Settings sidebar. *@
@* ABOUTME: Includes user submission, approval, and verification switches with instance-level lock support. *@

@using MudBlazor
@using Explore.Blazor.Client.Services

<div class="settings-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Event & Organization Policies</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            Control how events are submitted, approved, and how organizations are verified.
        </MudText>
    </div>
    <MudStack Spacing="3">
        <MudSwitch T="bool" @bind-Value="Model.AllowUserSubmittedEvents" Color="Color.Primary">
            Allow users to submit events
        </MudSwitch>

        <MudSwitch T="bool" @bind-Value="Model.AllowOrganizationSubmittedEvents" Color="Color.Primary">
            Allow organizations to submit events
        </MudSwitch>

        <MudSwitch T="bool" @bind-Value="Model.AllowGroupSubmittedEvents" Color="Color.Primary">
            Allow groups to submit events
        </MudSwitch>

        @if (!Model.AllowUserSubmittedEvents && !Model.AllowOrganizationSubmittedEvents && !Model.AllowGroupSubmittedEvents)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                No entity types are allowed to submit events. Only administrators will be able to create events through entities they manage.
            </MudAlert>
        }

        <MudDivider />

        <MudSwitch T="bool" @bind-Value="Model.AllowOrganizationSelfRegistration" Color="Color.Primary">
            Allow organization self-registration
        </MudSwitch>

        <MudSwitch T="bool" @bind-Value="Model.AllowGroupSelfRegistration" Color="Color.Primary">
            Allow group self-registration
        </MudSwitch>

        <MudDivider />

        <MudSwitch T="bool" @bind-Value="Model.RequireEventApproval" Color="Color.Primary">
            Require approval before publication
        </MudSwitch>

        <MudSwitch T="bool"
                   @bind-Value="Model.RequireOrganizationVerification"
                   Color="Color.Primary"
                   Disabled="@(!IsSingleTenant && !Model.CanTenantOmitVerification)">
            Require organization verification
        </MudSwitch>

        @if (!IsSingleTenant && !Model.CanTenantOmitVerification)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning">
                Verification requirement is locked by instance policy.
            </MudText>
        }

        <MudDivider />

        <MudSwitch T="bool"
                   @bind-Value="Model.EventCardClickOpensDetailPage"
                   Color="Color.Primary"
                   Disabled="@(!IsSingleTenant && !Model.CanOverrideEventCardClickBehavior)">
            Event card click opens detail page
        </MudSwitch>

        @if (!IsSingleTenant && !Model.CanOverrideEventCardClickBehavior)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning">
                Event card click behavior is locked by instance policy.
            </MudText>
        }

        <MudDivider />

        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">AI Assistant (Beta)</MudText>
        
        <MudSwitch T="bool"
                   Value="Model.AiAssistantEnabled"
                   ValueChanged="OnAiAssistantEnabledChanged"
                   Color="Color.Primary"
                   Disabled="@(!IsSingleTenant && !Model.CanOverrideAiAssistant)">
            Enable AI Assistant capabilities
        </MudSwitch>

        @if (!IsSingleTenant && !Model.CanOverrideAiAssistant)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning">
                AI Assistant configuration is locked by instance policy.
            </MudText>
        }

        @if (Model.AiAssistantEnabled)
        {
            <MudSelect T="string"
                       @bind-Value="Model.AiAssistantProvider"
                       Label="AI Provider"
                       Variant="Variant.Outlined"
                       Disabled="@(!IsSingleTenant && !Model.CanOverrideAiAssistant)"
                       HelperText="Use an OpenAI-compatible provider endpoint.">
                <MudSelectItem T="string" Value="@OpenAiCompatibleProvider">OpenAI-compatible</MudSelectItem>
            </MudSelect>

            <MudSwitch T="bool"
                       @bind-Value="Model.AiAssistantAllowAnonymousAccess"
                       Color="Color.Primary"
                       Disabled="@(!IsSingleTenant && !Model.CanOverrideAiAssistant)">
                Allow unauthenticated visitors to open AI Assistant
            </MudSwitch>

            @if (UsesOpenAiCompatibleProvider)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    The navbar AI button appears only after endpoint URL, API key, and model ID are saved.
                </MudAlert>

                <MudTextField T="string"
                              @bind-Value="Model.AiAssistantEndpointUrl"
                              Label="API Endpoint URL"
                              InputType="InputType.Url"
                              Variant="Variant.Outlined"
                              Disabled="@(!IsSingleTenant && !Model.CanOverrideAiAssistant)"
                              HelperText="Full HTTP(S) URL to the OpenAI-compatible model endpoint." />

                <MudTextField T="string"
                              @bind-Value="Model.AiAssistantApiKey"
                              Label="API Key"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Disabled="@(!IsSingleTenant && !Model.CanOverrideAiAssistant)"
                              HelperText="Required for OpenAI-compatible providers." />

                <MudTextField T="string"
                              @bind-Value="Model.AiAssistantModelId"
                              Label="Model ID"
                              Variant="Variant.Outlined"
                              Disabled="@(!IsSingleTenant && !Model.CanOverrideAiAssistant)"
                              HelperText="Example: gpt-4o-mini, llama3.1, or the model name exposed by your compatible provider." />

                @if (HasIncompleteOpenAiCompatibleConfiguration)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        Complete all OpenAI-compatible fields before saving, otherwise the AI Assistant cannot be enabled.
                    </MudAlert>
                }
            }
        }
    </MudStack>
</div>

@code {
    private const string OpenAiCompatibleProvider = "openai-compatible";
    private const string NoneProvider = "none";

    [Parameter, EditorRequired]
    public TenantPolicySettingsModel Model { get; set; } = null!;

    [Parameter]
    public bool IsSingleTenant { get; set; }

    private bool UsesOpenAiCompatibleProvider =>
        string.Equals(Model.AiAssistantProvider, OpenAiCompatibleProvider, StringComparison.OrdinalIgnoreCase)
        || string.IsNullOrWhiteSpace(Model.AiAssistantProvider)
        || string.Equals(Model.AiAssistantProvider, NoneProvider, StringComparison.OrdinalIgnoreCase);

    private bool HasIncompleteOpenAiCompatibleConfiguration =>
        UsesOpenAiCompatibleProvider
        && (string.IsNullOrWhiteSpace(Model.AiAssistantEndpointUrl)
            || string.IsNullOrWhiteSpace(Model.AiAssistantApiKey)
            || string.IsNullOrWhiteSpace(Model.AiAssistantModelId));

    protected override void OnParametersSet()
    {
        EnsureAiProviderWhenEnabled();
    }

    private void OnAiAssistantEnabledChanged(bool enabled)
    {
        Model.AiAssistantEnabled = enabled;
        EnsureAiProviderWhenEnabled();
    }

    private void EnsureAiProviderWhenEnabled()
    {
        if (!Model.AiAssistantEnabled)
        {
            return;
        }

        if (!string.Equals(Model.AiAssistantProvider, OpenAiCompatibleProvider, StringComparison.OrdinalIgnoreCase))
        {
            Model.AiAssistantProvider = OpenAiCompatibleProvider;
        }
    }
}
