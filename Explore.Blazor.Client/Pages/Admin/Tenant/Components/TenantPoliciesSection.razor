@* ABOUTME: Renders event and organization policy settings for the Tenant Admin Settings sidebar. *@
@* ABOUTME: Includes user submission, approval, and verification switches with instance-level lock support. *@

@using MudBlazor
@using Explore.Blazor.Client.Services

@inject ITenantOnboardingService TenantOnboardingService

<div class="settings-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Event & Organization Policies</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            Control how events are submitted, approved, and how organizations are verified.
        </MudText>
    </div>
    <MudStack Spacing="3">
        <MudSwitch T="bool" @bind-Value="Model.AllowUserSubmittedEvents" Color="Color.Primary">
            Allow users to submit events
        </MudSwitch>

        <MudSwitch T="bool" @bind-Value="Model.AllowOrganizationSubmittedEvents" Color="Color.Primary">
            Allow organizations to submit events
        </MudSwitch>

        <MudSwitch T="bool" @bind-Value="Model.AllowGroupSubmittedEvents" Color="Color.Primary">
            Allow groups to submit events
        </MudSwitch>

        @if (!Model.AllowUserSubmittedEvents && !Model.AllowOrganizationSubmittedEvents && !Model.AllowGroupSubmittedEvents)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                No entity types are allowed to submit events. Only administrators will be able to create events through entities they manage.
            </MudAlert>
        }

        <MudDivider />

        <MudSwitch T="bool" @bind-Value="Model.AllowOrganizationSelfRegistration" Color="Color.Primary">
            Allow organization self-registration
        </MudSwitch>

        <MudSwitch T="bool" @bind-Value="Model.AllowGroupSelfRegistration" Color="Color.Primary">
            Allow group self-registration
        </MudSwitch>

        <MudDivider />

        <MudSwitch T="bool" @bind-Value="Model.RequireEventApproval" Color="Color.Primary">
            Require approval before publication
        </MudSwitch>

        <MudSwitch T="bool"
                   @bind-Value="Model.RequireOrganizationVerification"
                   Color="Color.Primary"
                   Disabled="@(!IsSingleTenant && !Model.CanTenantOmitVerification)">
            Require organization verification
        </MudSwitch>

        @if (!IsSingleTenant && !Model.CanTenantOmitVerification)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning">
                Verification requirement is locked by instance policy.
            </MudText>
        }

        <MudDivider />

        <MudSwitch T="bool"
                   @bind-Value="Model.EventCardClickOpensDetailPage"
                   Color="Color.Primary"
                   Disabled="@(!IsSingleTenant && !Model.CanOverrideEventCardClickBehavior)">
            Event card click opens detail page
        </MudSwitch>

        @if (!IsSingleTenant && !Model.CanOverrideEventCardClickBehavior)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning">
                Event card click behavior is locked by instance policy.
            </MudText>
        }

        <MudDivider />

        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">AI Assistant (Beta)</MudText>
        
        <MudSwitch T="bool"
                   Value="Model.AiAssistantEnabled"
                   ValueChanged="OnAiAssistantEnabledChanged"
                   Color="Color.Primary"
                   Disabled="@(!IsSingleTenant && !Model.CanOverrideAiAssistant)">
            Enable AI Assistant capabilities
        </MudSwitch>

        @if (!IsSingleTenant && !Model.CanOverrideAiAssistant)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning">
                AI Assistant configuration is locked by instance policy.
            </MudText>
        }

        @if (Model.AiAssistantEnabled)
        {
            <MudSelect T="string"
                       @bind-Value="Model.AiAssistantProvider"
                       Label="AI Provider"
                       Variant="Variant.Outlined"
                       Disabled="@(!IsSingleTenant && !Model.CanOverrideAiAssistant)"
                       HelperText="Use an OpenAI-compatible provider endpoint.">
                <MudSelectItem T="string" Value="@OpenAiCompatibleProvider">OpenAI-compatible</MudSelectItem>
            </MudSelect>

            <MudSwitch T="bool"
                       @bind-Value="Model.AiAssistantAllowAnonymousAccess"
                       Color="Color.Primary"
                       Disabled="@(!IsSingleTenant && !Model.CanOverrideAiAssistant)">
                Allow unauthenticated visitors to open AI Assistant
            </MudSwitch>

            @if (UsesOpenAiCompatibleProvider)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    The navbar AI button appears only after an endpoint URL and model ID are saved. API keys are optional for local providers.
                </MudAlert>

                <MudTextField T="string"
                              Value="Model.AiAssistantEndpointUrl"
                              ValueChanged="OnAiEndpointUrlChanged"
                              Label="API Endpoint URL"
                              InputType="InputType.Url"
                              Variant="Variant.Outlined"
                              Disabled="@(!IsSingleTenant && !Model.CanOverrideAiAssistant)"
                              HelperText="Full HTTP(S) URL to the OpenAI-compatible model endpoint." />

                <MudTextField T="string"
                              Value="Model.AiAssistantApiKey"
                              ValueChanged="OnAiApiKeyChanged"
                              Label="API Key"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Disabled="@(!IsSingleTenant && !Model.CanOverrideAiAssistant)"
                              HelperText="Optional bearer token. Leave blank for local providers that do not require authentication." />

                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2" Class="flex-wrap">
                    @if (HasDiscoveredAiModels)
                    {
                        <MudSelect T="string"
                                   @bind-Value="Model.AiAssistantModelId"
                                   Label="Model ID"
                                   Variant="Variant.Outlined"
                                   Disabled="@(!IsSingleTenant && !Model.CanOverrideAiAssistant)"
                                   HelperText="Select a model returned by the provider."
                                   Class="flex-grow-1">
                            @foreach (var model in AiModelOptions)
                            {
                                <MudSelectItem T="string" Value="@model.Id">@FormatAiModelOption(model)</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudTextField T="string"
                                      @bind-Value="Model.AiAssistantModelId"
                                      Label="Model ID"
                                      Variant="Variant.Outlined"
                                      Disabled="@(!IsSingleTenant && !Model.CanOverrideAiAssistant)"
                                      HelperText="Example: gpt-4o-mini, llama3.1, or the model name exposed by your compatible provider."
                                      Class="flex-grow-1" />
                    }

                    <MudButton Elevation="0"
                               Color="Color.Primary"
                               Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadAiModelsAsync"
                               Disabled="@(!CanLoadAiModels)">
                        @(_isLoadingAiModels ? "Loading..." : "Load models")
                    </MudButton>
                </MudStack>

                @if (!string.IsNullOrWhiteSpace(_aiModelLoadMessage))
                {
                    <MudText Typo="Typo.caption" Color="@_aiModelLoadMessageColor">
                        @_aiModelLoadMessage
                    </MudText>
                }

                @if (HasIncompleteOpenAiCompatibleConfiguration)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        Enter an endpoint URL and model ID before saving, otherwise the AI Assistant cannot be enabled.
                    </MudAlert>
                }
            }
        }
    </MudStack>
</div>

@code {
    private const string OpenAiCompatibleProvider = "openai-compatible";
    private const string NoneProvider = "none";

    private IReadOnlyList<AiAssistantModelOptionModel> _aiModels = [];
    private bool _isLoadingAiModels;
    private string? _aiModelLoadMessage;
    private Color _aiModelLoadMessageColor = Color.Secondary;

    [Parameter, EditorRequired]
    public TenantPolicySettingsModel Model { get; set; } = null!;

    [Parameter]
    public bool IsSingleTenant { get; set; }

    private bool UsesOpenAiCompatibleProvider =>
        string.Equals(Model.AiAssistantProvider, OpenAiCompatibleProvider, StringComparison.OrdinalIgnoreCase)
        || string.IsNullOrWhiteSpace(Model.AiAssistantProvider)
        || string.Equals(Model.AiAssistantProvider, NoneProvider, StringComparison.OrdinalIgnoreCase);

    private bool HasIncompleteOpenAiCompatibleConfiguration =>
        UsesOpenAiCompatibleProvider
        && (string.IsNullOrWhiteSpace(Model.AiAssistantEndpointUrl)
            || string.IsNullOrWhiteSpace(Model.AiAssistantModelId));

    private bool HasDiscoveredAiModels => _aiModels.Count > 0;

    private bool CanLoadAiModels =>
        UsesOpenAiCompatibleProvider
        && !_isLoadingAiModels
        && (IsSingleTenant || Model.CanOverrideAiAssistant)
        && !string.IsNullOrWhiteSpace(Model.AiAssistantEndpointUrl);

    private IEnumerable<AiAssistantModelOptionModel> AiModelOptions
    {
        get
        {
            foreach (var model in _aiModels)
            {
                yield return model;
            }

            if (!string.IsNullOrWhiteSpace(Model.AiAssistantModelId)
                && !_aiModels.Any(model => string.Equals(model.Id, Model.AiAssistantModelId, StringComparison.OrdinalIgnoreCase)))
            {
                yield return new AiAssistantModelOptionModel
                {
                    Id = Model.AiAssistantModelId,
                    DisplayName = $"{Model.AiAssistantModelId} (current)"
                };
            }
        }
    }

    protected override void OnParametersSet()
    {
        EnsureAiProviderWhenEnabled();
    }

    private void OnAiAssistantEnabledChanged(bool enabled)
    {
        Model.AiAssistantEnabled = enabled;
        EnsureAiProviderWhenEnabled();
    }

    private void OnAiEndpointUrlChanged(string endpointUrl)
    {
        Model.AiAssistantEndpointUrl = endpointUrl;
        ClearDiscoveredAiModels();
    }

    private void OnAiApiKeyChanged(string apiKey)
    {
        Model.AiAssistantApiKey = apiKey;
        ClearDiscoveredAiModels();
    }

    private async Task LoadAiModelsAsync()
    {
        if (string.IsNullOrWhiteSpace(Model.AiAssistantEndpointUrl))
        {
            SetAiModelLoadMessage("Enter an endpoint URL before loading models.", Color.Warning);
            return;
        }

        _isLoadingAiModels = true;
        SetAiModelLoadMessage(null, Color.Secondary);

        try
        {
            var models = await TenantOnboardingService.GetAiModelsAsync(Model.AiAssistantEndpointUrl, Model.AiAssistantApiKey);
            _aiModels = models
                .Where(model => !string.IsNullOrWhiteSpace(model.Id))
                .GroupBy(model => model.Id, StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .OrderBy(model => model.Id, StringComparer.OrdinalIgnoreCase)
                .ToArray();

            if (_aiModels.Count == 0)
            {
                SetAiModelLoadMessage("No models were returned. Enter the model ID manually.", Color.Warning);
                return;
            }

            if (string.IsNullOrWhiteSpace(Model.AiAssistantModelId))
            {
                Model.AiAssistantModelId = _aiModels[0].Id;
            }

            SetAiModelLoadMessage($"Loaded {_aiModels.Count} model{(_aiModels.Count == 1 ? string.Empty : "s")} from the provider.", Color.Secondary);
        }
        finally
        {
            _isLoadingAiModels = false;
        }
    }

    private void ClearDiscoveredAiModels()
    {
        _aiModels = [];
        SetAiModelLoadMessage(null, Color.Secondary);
    }

    private void SetAiModelLoadMessage(string? message, Color color)
    {
        _aiModelLoadMessage = message;
        _aiModelLoadMessageColor = color;
    }

    private static string FormatAiModelOption(AiAssistantModelOptionModel model)
    {
        return string.IsNullOrWhiteSpace(model.DisplayName) || string.Equals(model.DisplayName, model.Id, StringComparison.OrdinalIgnoreCase)
            ? model.Id
            : model.DisplayName;
    }

    private void EnsureAiProviderWhenEnabled()
    {
        if (!Model.AiAssistantEnabled)
        {
            return;
        }

        if (!string.Equals(Model.AiAssistantProvider, OpenAiCompatibleProvider, StringComparison.OrdinalIgnoreCase))
        {
            Model.AiAssistantProvider = OpenAiCompatibleProvider;
        }
    }
}
