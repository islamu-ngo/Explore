@page "/admin/audience-ages"
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services.Contracts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode @(new InteractiveAutoRenderMode(prerender: false))

<div class="admin-lookup">
    <!-- Hero Section -->
    <MudPaper Class="admin-lookup__hero admin-lookup__hero--age" Elevation="0">
        <div class="admin-lookup__hero-top">
            <div class="admin-lookup__hero-title">
                <div class="admin-lookup__hero-badge admin-lookup__hero-badge--age">
                    <MudIcon Icon="@Icons.Material.Filled.Cake" Color="Color.Warning" />
                </div>
                <div>
                    <MudText Typo="Typo.h4" Style="font-weight:800; letter-spacing:.2px;">
                        Audience Ages
                    </MudText>
                    <MudText Typo="Typo.body2" Class="admin-lookup__hero-subtitle">
                        Age group classifications for events (read-only lookup table)
                    </MudText>
                </div>
            </div>

            <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => Nav.NavigateTo("/admin"))"
                           Style="border-radius:999px; padding:10px 16px;">
                    Back to Admin
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadData"
                           Style="border-radius:999px; padding:10px 16px;">
                    Refresh
                </MudButton>
            </MudStack>
        </div>

        <!-- Stats -->
        <div class="admin-lookup__stats">
            <div class="admin-lookup__stat">
                <div class="admin-lookup__stat-row">
                    <div class="admin-lookup__stat-icon admin-lookup__stat-icon--age">
                        <MudIcon Icon="@Icons.Material.Filled.Cake" Color="Color.Warning" />
                    </div>
                    <div>
                        <div class="admin-lookup__stat-label">Total Age Groups</div>
                        <div class="admin-lookup__stat-value">@_items.Count</div>
                    </div>
                </div>
            </div>
        </div>
    </MudPaper>

    @if (_isLoading)
    {
        <MudPaper Class="admin-lookup__panel" Elevation="0" Style="margin-top:14px;">
            <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="py-4">
                <MudProgressCircular Color="Color.Warning" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.body1">Loading audience ages…</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <div class="admin-lookup__section">
            <!-- Info Banner -->
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3" Style="border-radius:14px;">
                <MudText Typo="Typo.body2">
                    <strong>Read-only lookup table.</strong> Audience age groups are system-defined values.
                    Contact system administrator if changes are needed.
                </MudText>
            </MudAlert>

            <!-- Table -->
            <MudPaper Class="admin-lookup__table-panel" Elevation="0">
                <MudTable Items="@_items"
                          Dense="true"
                          Hover="true"
                          Striped="true"
                          Breakpoint="Breakpoint.Sm"
                          Loading="@_isLoading"
                          LoadingProgressColor="Color.Warning">
                    <HeaderContent>
                        <MudTh Style="width:80px">ID</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Master Code</MudTh>
                        <MudTh Style="width:120px">Min Age</MudTh>
                        <MudTh Style="width:120px">Max Age</MudTh>
                        <MudTh>Description</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="ID">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Default">
                                @context.Id
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Name">
                            <div class="admin-lookup__name-cell">
                                <MudIcon Icon="@Icons.Material.Filled.Cake" Size="Size.Small" Color="Color.Warning" />
                                <MudText Typo="Typo.body2" Style="font-weight:600;">@context.FullName</MudText>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Code">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                @context.MasterCode
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Min Age">
                            <MudText Typo="Typo.body2">
                                @(context.MinAge?.ToString() ?? "—")
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="Max Age">
                            <MudText Typo="Typo.body2">
                                @(context.MaxAge?.ToString() ?? "∞")
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="Description">
                            <MudText Typo="Typo.body2" Class="admin-lookup__muted">
                                @(context.Description ?? "—")
                            </MudText>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="admin-lookup__empty">
                            <MudIcon Icon="@Icons.Material.Filled.Cake" Size="Size.Large" />
                            <MudText Typo="Typo.h6" Style="margin-top:10px; font-weight:800;">No age groups found</MudText>
                            <MudText Typo="Typo.body2" Class="admin-lookup__muted">
                                The lookup table is empty.
                            </MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        </div>
    }
</div>
