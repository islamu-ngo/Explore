@* ABOUTME: Renders instance governance controls including deployment, home-page, and runtime render policy presets. *@
@* Provides preset-first render policy UX with recommended highlighting, help tooltips, and advanced overrides. *@

@using MudBlazor
@using Explore.Blazor.Client.Services

<div class="settings-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">@SectionTitle</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            @SectionDescription
        </MudText>
    </div>
    <MudStack Spacing="3">

        @if (DisplayMode == "multi-tenancy")
        {
            @if (IsSingleTenant)
            {
                <MudAlert Severity="Severity.Warning" Icon="@Icons.Material.Filled.Warning" Class="mb-2">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:600;">Enabling Multi-Tenancy is a structural change</MudText>
                    <MudList T="string" Dense="true" DisablePadding="true" Class="mt-2">
                        <MudListItem Icon="@Icons.Material.Filled.ChevronRight" IconColor="Color.Warning" Dense="true">Settings will split into global defaults and per-tenant overrides</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.ChevronRight" IconColor="Color.Warning" Dense="true">Lock controls will appear to enforce consistency across tenants</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.ChevronRight" IconColor="Color.Warning" Dense="true">Your current configuration becomes the default tenant's settings</MudListItem>
                        <MudListItem Icon="@Icons.Material.Filled.ChevronRight" IconColor="Color.Warning" Dense="true">To revert, you must reduce to one or fewer active tenants</MudListItem>
                    </MudList>
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="mb-2">
                    <MudText Typo="Typo.body2">
                        To revert to Single-Tenant mode, archive or delete all tenants except one. Lock controls will disappear and the remaining tenant's settings will become the instance defaults.
                    </MudText>
                </MudAlert>
            }
        }

        @if (ShowDeploymentMode)
        {
        @* ── Deployment Mode ──────────────────────────────────────────── *@
        <MudPaper Class="pa-4" Elevation="0" Style="@_deploymentModeCardStyle">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="@(DisplayMode == "multi-tenancy" ? Color.Error : Color.Default)" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Deployment Mode</MudText>
                    <MudTooltip Text="Single-Tenant runs one organization per instance. Multi-Tenant enables multiple isolated tenants.">
                        <MudIconButton Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Small" />
                    </MudTooltip>
                </MudStack>

                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Current mode: <strong>@(IsSingleTenant ? "Single-Tenant" : "Multi-Tenant")</strong>
                </MudText>

                @if (IsSingleTenant)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">
                        Enabling Multi-Tenancy allows creating multiple isolated tenants.
                        You can revert to Single-Tenant mode as long as only one tenant exists.
                    </MudAlert>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.SwapHoriz"
                               OnClick="OnEnableMultiTenantClicked">
                        Enable Multi-Tenant Mode
                    </MudButton>
                }
                else
                {
                    @if (_tenantCount > 1)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-1">
                            You currently have <strong>@_tenantCount</strong> tenants.
                            Please delete @(_tenantCount - 1) tenant(s) before reverting to Single-Tenant mode.
                        </MudAlert>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.SwapHoriz"
                                   Disabled="true">
                            Revert to Single-Tenant (delete extra tenants first)
                        </MudButton>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">
                            Only @_tenantCount tenant exists. You can safely revert to Single-Tenant mode.
                        </MudAlert>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.SwapHoriz"
                                   OnClick="OnRevertToSingleTenantClicked">
                            Revert to Single-Tenant Mode
                        </MudButton>
                    }
                }
            </MudStack>
        </MudPaper>

        @* ── Confirm Multi-Tenant Dialog ─────────────────────────────── *@
        <MudDialog @bind-Visible="_showMultiTenantDialog">
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" />
                    <MudText Typo="Typo.h6">Enable Multi-Tenant Mode?</MudText>
                </MudStack>
            </TitleContent>
            <DialogContent>
                <MudText Typo="Typo.body1" Class="mb-3">
                    Switching to Multi-Tenant mode will restructure your platform:
                </MudText>
                <MudList T="string" Dense="true" DisablePadding="true" Class="mb-3">
                    <MudListItem Icon="@Icons.Material.Filled.ChevronRight" IconColor="Color.Warning" Dense="true">
                        Settings will split into global defaults and per-tenant overrides
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.ChevronRight" IconColor="Color.Warning" Dense="true">
                        Lock controls will appear to enforce consistency across tenants
                    </MudListItem>
                    <MudListItem Icon="@Icons.Material.Filled.ChevronRight" IconColor="Color.Warning" Dense="true">
                        Your current configuration becomes the default tenant's settings
                    </MudListItem>
                </MudList>
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                    You can revert to Single-Tenant mode later, as long as no more than one tenant exists.
                </MudAlert>
                <MudTextField @bind-Value="_multiTenantConfirmText"
                              Label="Type ENABLE MULTI-TENANCY to confirm"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              HelperText="This action changes how your platform is administered." />
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="CancelMultiTenantDialog">Cancel</MudButton>
                <MudButton Color="Color.Warning"
                           Variant="Variant.Filled"
                           Disabled="@(!IsMultiTenantConfirmValid)"
                           OnClick="ConfirmMultiTenant">
                    Confirm — Enable Multi-Tenant
                </MudButton>
            </DialogActions>
        </MudDialog>

        @* ── Confirm Single-Tenant Revert Dialog ─────────────────────── *@
        <MudDialog @bind-Visible="_showSingleTenantDialog">
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" />
                    <MudText Typo="Typo.h6">Revert to Single-Tenant Mode?</MudText>
                </MudStack>
            </TitleContent>
            <DialogContent>
                <MudText Typo="Typo.body1">
                    This will switch the platform back to Single-Tenant mode. Instance and tenant
                    settings will be merged into a single administration page.
                </MudText>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="@(() => _showSingleTenantDialog = false)">Cancel</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmSingleTenant">
                    Confirm — Revert to Single-Tenant
                </MudButton>
            </DialogActions>
        </MudDialog>
        }

        @if (ShowGeneralGovernance)
        {
        @if (ShowHomePage && !IsSingleTenant)
        {
            <MudSwitch T="bool" @bind-Value="Delegation.AllowTenantSelfServiceRegistration" Color="Color.Primary">
                Allow tenant self-service registration
            </MudSwitch>
        }

        <MudDivider Class="my-2" />
        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Event Submission Policies</MudText>
        <MudSwitch T="bool" @bind-Value="EventPolicy.AllowUserSubmittedEvents" Color="Color.Primary">
            Allow user-submitted events
        </MudSwitch>
        <MudSwitch T="bool" @bind-Value="EventPolicy.AllowOrganizationSubmittedEvents" Color="Color.Primary">
            Allow organization-submitted events
        </MudSwitch>
        <MudSwitch T="bool" @bind-Value="EventPolicy.AllowGroupSubmittedEvents" Color="Color.Primary">
            Allow group-submitted events
        </MudSwitch>

        @if (!EventPolicy.AllowUserSubmittedEvents && !EventPolicy.AllowOrganizationSubmittedEvents && !EventPolicy.AllowGroupSubmittedEvents)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                No entity types are allowed to submit events. Only administrators will be able to create events through entities they manage.
            </MudAlert>
        }

        <MudDivider Class="my-2" />
        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Self-Registration Controls</MudText>
        <MudSwitch T="bool" @bind-Value="OrganizationPolicy.AllowOrganizationSelfRegistration" Color="Color.Primary">
            Allow organization self-registration
        </MudSwitch>
        <MudSwitch T="bool" @bind-Value="OrganizationPolicy.AllowGroupSelfRegistration" Color="Color.Primary">
            Allow group self-registration
        </MudSwitch>

        @if (ShowHomePage)
        {
            <MudSelect T="string"
                       Label="Default Public Home Page"
                       @bind-Value="Delegation.DefaultPublicHomePage"
                       Variant="Variant.Outlined">
                <MudSelectItem Value="@("EventList")">Event List</MudSelectItem>
                <MudSelectItem Value="@("LandingPage")">Landing Page</MudSelectItem>
            </MudSelect>

            <MudSwitch T="bool" @bind-Value="Delegation.LockTenantHomePagePreference" Color="Color.Primary">
                Lock tenant home page preference
            </MudSwitch>
        }
        }

        @if (ShowRenderPolicies)
        {
        @if (ShowGeneralGovernance)
        {
            <MudDivider Class="my-2" />
        }

        <MudStack Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.h6" Style="font-weight:600;">Runtime Render Policy</MudText>
                <MudTooltip Text="Choose a preset strategy for route rendering. All Interactive Server is recommended for most deployments.">
                    <MudIconButton Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Small" />
                </MudTooltip>
            </MudStack>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Presets balance SEO prerendering and runtime responsiveness. You can enable advanced overrides for per-route-group control.
            </MudText>

            <div class="instance-governance__preset-grid">
                @foreach (var option in PresetOptions)
                {
                    <MudPaper Class="@GetPresetCardClass(option.Value)" Elevation="0" @onclick="() => SelectPreset(option.Value)">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight:600;">@option.Label</MudText>
                                    <MudTooltip Text="@option.HelpText">
                                        <MudIconButton Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Small" />
                                    </MudTooltip>
                                </MudStack>
                                @if (IsRecommendedPreset(option.Value))
                                {
                                    <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small">Recommended</MudChip>
                                }
                            </MudStack>

                            <MudText Typo="Typo.body2" Color="Color.Secondary">@option.Description</MudText>
                        </MudStack>
                    </MudPaper>
                }
            </div>

            <MudSwitch T="bool"
                       Value="RenderPolicy.EnableAdvancedRenderPolicyOverrides"
                       ValueChanged="OnAdvancedOverridesChanged"
                       Color="Color.Primary">
                Enable advanced render-policy overrides
            </MudSwitch>

            @if (RenderPolicy.EnableAdvancedRenderPolicyOverrides)
            {
                <MudPaper Class="instance-governance__advanced-panel pa-4" Elevation="0">
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.subtitle2" Style="font-weight:600;">Global Fallback</MudText>
                            <MudTooltip Text="Used when a route-group specific override is unavailable.">
                                <MudIconButton Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Small" />
                            </MudTooltip>
                        </MudStack>

                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudSelect T="string"
                                           Label="Global Render Mode"
                                           @bind-Value="RenderPolicy.GlobalRenderMode"
                                           Variant="Variant.Outlined">
                                    @foreach (var mode in RenderModeOptions)
                                    {
                                        <MudSelectItem Value="@mode.Value">@mode.Label</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSwitch T="bool" @bind-Value="RenderPolicy.GlobalPrerenderEnabled" Color="Color.Primary">
                                    Global Prerender Enabled
                                </MudSwitch>
                            </MudItem>
                        </MudGrid>

                        @foreach (var group in RouteGroupOptions)
                        {
                            <MudDivider />
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudText Typo="Typo.subtitle2" Style="font-weight:600;">@group.Label</MudText>
                                <MudTooltip Text="@group.HelpText">
                                    <MudIconButton Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Small" />
                                </MudTooltip>
                            </MudStack>

                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudSelect T="string"
                                               Label="@($"{group.Label} Render Mode")"
                                               Value="@GetRouteGroupMode(group.Value)"
                                               ValueChanged="mode => SetRouteGroupMode(group.Value, mode)"
                                               Variant="Variant.Outlined">
                                        @foreach (var mode in RenderModeOptions.Where(x => !IsOnboardingInteractiveServerRestricted(group.Value) || x.Value != "InteractiveServer"))
                                        {
                                            <MudSelectItem Value="@mode.Value">@mode.Label</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudSwitch T="bool"
                                               Value="@GetRouteGroupPrerender(group.Value)"
                                               ValueChanged="enabled => SetRouteGroupPrerender(group.Value, enabled)"
                                               Color="Color.Primary">
                                        @($"{group.Label} Prerender Enabled")
                                    </MudSwitch>
                                </MudItem>
                            </MudGrid>
                        }
                    </MudStack>
                </MudPaper>
            }

            @if (!IsSingleTenant)
            {
            @* ── Tenant Render Policy Delegation ──────────────────────────────── *@
            <MudDivider Class="my-2" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Tenant Render Policy Delegation</MudText>
                <MudTooltip Text="When enabled, tenants can override render policy settings. Use per-route-group locks to restrict specific areas.">
                    <MudIconButton Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Small" />
                </MudTooltip>
            </MudStack>

            <MudSwitch T="bool"
                       @bind-Value="RenderPolicy.AllowTenantRenderPolicyOverride"
                       Color="Color.Primary">
                Allow tenants to override render policy
            </MudSwitch>

            @if (RenderPolicy.AllowTenantRenderPolicyOverride)
            {
                <MudPaper Class="pa-4" Elevation="0" Style="border: 1px solid var(--mud-palette-lines-default);">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Lock specific route groups to prevent tenant overrides. Locked groups use the instance-level setting.
                        </MudText>
                        <MudSwitch T="bool"
                                   @bind-Value="RenderPolicy.LockTenantPublicSeoRenderPolicy"
                                   Color="Color.Warning">
                            Lock Public/SEO render policy
                        </MudSwitch>
                        <MudSwitch T="bool"
                                   @bind-Value="RenderPolicy.LockTenantOperationalRenderPolicy"
                                   Color="Color.Warning">
                            Lock Operational render policy
                        </MudSwitch>
                        <MudSwitch T="bool"
                                   @bind-Value="RenderPolicy.LockTenantAdminRenderPolicy"
                                   Color="Color.Warning">
                            Lock Admin render policy
                        </MudSwitch>
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Onboarding render policy is always controlled at the instance level.
                        </MudAlert>
                    </MudStack>
                </MudPaper>
            }
            }
        </MudStack>
        }
    </MudStack>
</div>

@code {
    private const string RecommendedPreset = "AllInteractiveServer";

    private static readonly IReadOnlyList<PresetOption> PresetOptions =
    [
        new("AllInteractiveServer", "All Interactive Server", "Best default — fast SignalR interactivity for all routes", "Uses InteractiveServer for all route groups with no prerendering. Fastest time-to-interactive via SignalR."),
        new("SeoBalanced", "SEO Balanced", "Prerendering for SEO-sensitive public pages", "Prioritizes prerendering for SEO-sensitive public pages while keeping operational flows interactive."),
        new("AllPrerendered", "All Prerendered", "Maximum first paint and crawler readiness", "Forces prerendering across route groups for predictable initial HTML output."),
        new("AllInteractiveAutoNoPrerender", "All Interactive Auto", "Fast interactivity startup without prerender", "Disables prerender globally and uses InteractiveAuto for all route groups."),
        new("CustomAdvanced", "Custom Advanced", "Fine-grained per route-group control", "Enables explicit overrides for Public SEO, Operational, Admin, and Onboarding route groups.")
    ];

    private static readonly IReadOnlyList<RenderModeOption> RenderModeOptions =
    [
        new("InteractiveAuto", "Interactive Auto"),
        new("InteractiveWebAssembly", "Interactive WebAssembly"),
        new("InteractiveServer", "Interactive Server")
    ];

    private static readonly IReadOnlyList<RouteGroupOption> RouteGroupOptions =
    [
        new("public-seo", "Public SEO", "Public landing and detail routes where SEO/prerender strategy matters most."),
        new("operational", "Operational", "Authenticated user workflows and day-to-day app interactions."),
        new("admin", "Admin", "Administrative surfaces under /admin routes."),
        new("onboarding", "Onboarding", "Setup and onboarding routes. Always uses InteractiveServer for instant interactivity (no WASM download delay).")
    ];

    [Parameter, EditorRequired]
    public TenantDelegationModel Delegation { get; set; } = null!;

    [Parameter, EditorRequired]
    public EventPolicyModel EventPolicy { get; set; } = null!;

    [Parameter, EditorRequired]
    public OrganizationPolicyModel OrganizationPolicy { get; set; } = null!;

    [Parameter, EditorRequired]
    public RenderPolicyModel RenderPolicy { get; set; } = null!;

    [Parameter]
    public string DeploymentMode { get; set; } = "SingleTenant";

    [Parameter]
    public int TenantCount { get; set; }

    [Parameter]
    public EventCallback<string> DeploymentModeChanged { get; set; }

    /// <summary>
    /// Controls which subsections are visible: "full" (default), "general", "render-policies", or "multi-tenancy".
    /// </summary>
    [Parameter]
    public string DisplayMode { get; set; } = "full";

    private bool ShowDeploymentMode => DisplayMode is "full" or "multi-tenancy";
    private bool ShowGeneralGovernance => DisplayMode is "full" or "general";
    private bool ShowRenderPolicies => DisplayMode is "full" or "render-policies";
    private bool ShowHomePage => DisplayMode is "full";

    private string SectionTitle => DisplayMode switch
    {
        "general" => "General",
        "render-policies" => "Render Policies",
        "multi-tenancy" => "Multi-Tenancy",
        _ => "Platform Governance"
    };

    private string SectionDescription => DisplayMode switch
    {
        "general" => IsSingleTenant
            ? "Configure event submission policies, self-registration, and general platform behavior."
            : "Configure tenant registration and general platform behavior.",
        "render-policies" => "Choose a preset strategy for route rendering or configure per-route-group overrides.",
        "multi-tenancy" => "⚠️ Changing the deployment mode restructures how settings and tenants are managed.",
        _ => "Control deployment mode, tenant registration, and default home page behavior."
    };

    private int _tenantCount;
    private bool _showMultiTenantDialog;
    private bool _showSingleTenantDialog;
    private string _multiTenantConfirmText = string.Empty;
    private bool IsMultiTenantConfirmValid => string.Equals(_multiTenantConfirmText?.Trim(), "ENABLE MULTI-TENANCY", StringComparison.OrdinalIgnoreCase);
    private bool IsSingleTenant => string.Equals(DeploymentMode, "SingleTenant", StringComparison.OrdinalIgnoreCase)
                                   || string.IsNullOrWhiteSpace(DeploymentMode);

    private string _deploymentModeCardStyle => DisplayMode == "multi-tenancy"
        ? "border: 2px solid var(--mud-palette-error); border-radius: var(--mud-default-borderradius);"
        : "border: 1px solid var(--mud-palette-lines-default);";

    protected override void OnParametersSet()
    {
        _tenantCount = TenantCount;
        EnsurePresetDefaults();
    }

    private void OnEnableMultiTenantClicked()
    {
        _showMultiTenantDialog = true;
    }

    private void CancelMultiTenantDialog()
    {
        _showMultiTenantDialog = false;
        _multiTenantConfirmText = string.Empty;
    }

    private async Task ConfirmMultiTenant()
    {
        _showMultiTenantDialog = false;
        _multiTenantConfirmText = string.Empty;
        DeploymentMode = "MultiTenant";
        await DeploymentModeChanged.InvokeAsync("MultiTenant");
    }

    private void OnRevertToSingleTenantClicked()
    {
        _showSingleTenantDialog = true;
    }

    private async Task ConfirmSingleTenant()
    {
        _showSingleTenantDialog = false;
        DeploymentMode = "SingleTenant";
        await DeploymentModeChanged.InvokeAsync("SingleTenant");
    }

    private void EnsurePresetDefaults()
    {
        if (string.IsNullOrWhiteSpace(RenderPolicy.RenderPolicyPreset))
        {
            SelectPreset(RecommendedPreset);
            return;
        }

        if (!PresetOptions.Any(x => x.Value.Equals(RenderPolicy.RenderPolicyPreset, StringComparison.OrdinalIgnoreCase)))
        {
            SelectPreset(RecommendedPreset);
            return;
        }

        RenderPolicy.RenderPolicyPreset = PresetOptions.First(x => x.Value.Equals(RenderPolicy.RenderPolicyPreset, StringComparison.OrdinalIgnoreCase)).Value;
        RenderPolicy.EnableAdvancedRenderPolicyOverrides = RenderPolicy.RenderPolicyPreset.Equals("CustomAdvanced", StringComparison.OrdinalIgnoreCase);
    }

    private string GetPresetCardClass(string preset)
    {
        var className = "instance-governance__preset-card";

        if (IsRecommendedPreset(preset))
        {
            className += " instance-governance__preset-card--recommended";
        }

        if (RenderPolicy.RenderPolicyPreset.Equals(preset, StringComparison.OrdinalIgnoreCase))
        {
            className += " instance-governance__preset-card--selected";
        }

        return className;
    }

    private static bool IsRecommendedPreset(string preset)
    {
        return preset.Equals(RecommendedPreset, StringComparison.OrdinalIgnoreCase);
    }

    private void SelectPreset(string preset)
    {
        RenderPolicy.RenderPolicyPreset = preset;

        switch (preset)
        {
            case "AllInteractiveServer":
                RenderPolicy.EnableAdvancedRenderPolicyOverrides = false;
                RenderPolicy.GlobalRenderMode = "InteractiveServer";
                RenderPolicy.GlobalPrerenderEnabled = false;
                break;
            case "AllPrerendered":
                RenderPolicy.EnableAdvancedRenderPolicyOverrides = false;
                RenderPolicy.GlobalRenderMode = "InteractiveAuto";
                RenderPolicy.GlobalPrerenderEnabled = true;
                break;
            case "AllInteractiveAutoNoPrerender":
                RenderPolicy.EnableAdvancedRenderPolicyOverrides = false;
                RenderPolicy.GlobalRenderMode = "InteractiveAuto";
                RenderPolicy.GlobalPrerenderEnabled = false;
                break;
            case "CustomAdvanced":
                RenderPolicy.EnableAdvancedRenderPolicyOverrides = true;
                RenderPolicy.GlobalRenderMode = NormalizeRenderMode(RenderPolicy.GlobalRenderMode);
                break;
            default:
                RenderPolicy.EnableAdvancedRenderPolicyOverrides = false;
                RenderPolicy.GlobalRenderMode = "InteractiveServer";
                RenderPolicy.GlobalPrerenderEnabled = false;
                break;
        }

        if (!RenderPolicy.EnableAdvancedRenderPolicyOverrides)
        {
            ApplyGlobalFallbackToAllGroups();
            if (RenderPolicy.RenderPolicyPreset.Equals("SeoBalanced", StringComparison.OrdinalIgnoreCase))
            {
                RenderPolicy.PublicSeoPrerenderEnabled = true;
            }
        }

        EnsureOnboardingGuardrail();
    }

    private void OnAdvancedOverridesChanged(bool enabled)
    {
        if (enabled)
        {
            SelectPreset("CustomAdvanced");
            return;
        }

        SelectPreset(RecommendedPreset);
    }

    private string GetRouteGroupMode(string group)
    {
        return group switch
        {
            "public-seo" => NormalizeRenderMode(RenderPolicy.PublicSeoRenderMode),
            "operational" => NormalizeRenderMode(RenderPolicy.OperationalRenderMode),
            "admin" => NormalizeRenderMode(RenderPolicy.AdminRenderMode),
            "onboarding" => NormalizeOnboardingRenderMode(RenderPolicy.OnboardingRenderMode),
            _ => "InteractiveAuto"
        };
    }

    private void SetRouteGroupMode(string group, string mode)
    {
        var normalizedMode = NormalizeRenderMode(mode);

        switch (group)
        {
            case "public-seo":
                RenderPolicy.PublicSeoRenderMode = normalizedMode;
                break;
            case "operational":
                RenderPolicy.OperationalRenderMode = normalizedMode;
                break;
            case "admin":
                RenderPolicy.AdminRenderMode = normalizedMode;
                break;
            case "onboarding":
                RenderPolicy.OnboardingRenderMode = NormalizeOnboardingRenderMode(normalizedMode);
                break;
        }

        EnsureOnboardingGuardrail();
    }

    private bool GetRouteGroupPrerender(string group)
    {
        return group switch
        {
            "public-seo" => RenderPolicy.PublicSeoPrerenderEnabled,
            "operational" => RenderPolicy.OperationalPrerenderEnabled,
            "admin" => RenderPolicy.AdminPrerenderEnabled,
            "onboarding" => RenderPolicy.OnboardingPrerenderEnabled,
            _ => false
        };
    }

    private void SetRouteGroupPrerender(string group, bool enabled)
    {
        switch (group)
        {
            case "public-seo":
                RenderPolicy.PublicSeoPrerenderEnabled = enabled;
                break;
            case "operational":
                RenderPolicy.OperationalPrerenderEnabled = enabled;
                break;
            case "admin":
                RenderPolicy.AdminPrerenderEnabled = enabled;
                break;
            case "onboarding":
                RenderPolicy.OnboardingPrerenderEnabled = enabled;
                break;
        }
    }

    private static bool IsOnboardingInteractiveServerRestricted(string group)
    {
        // InteractiveServer is no longer restricted for onboarding — it's the forced default.
        return false;
    }

    private void ApplyGlobalFallbackToAllGroups()
    {
        var mode = NormalizeRenderMode(RenderPolicy.GlobalRenderMode);
        var prerender = RenderPolicy.GlobalPrerenderEnabled;

        RenderPolicy.PublicSeoRenderMode = mode;
        RenderPolicy.PublicSeoPrerenderEnabled = prerender;
        RenderPolicy.OperationalRenderMode = mode;
        RenderPolicy.OperationalPrerenderEnabled = prerender;
        RenderPolicy.AdminRenderMode = mode;
        RenderPolicy.AdminPrerenderEnabled = prerender;
        RenderPolicy.OnboardingRenderMode = NormalizeOnboardingRenderMode(mode);
        RenderPolicy.OnboardingPrerenderEnabled = prerender;
    }

    private void EnsureOnboardingGuardrail()
    {
        // Onboarding is always InteractiveServer for best first-impression UX.
        RenderPolicy.DisallowInteractiveServerOnOnboarding = false;
        RenderPolicy.OnboardingRenderMode = "InteractiveServer";
    }

    private static string NormalizeRenderMode(string? mode)
    {
        if (string.Equals(mode, "InteractiveWebAssembly", StringComparison.OrdinalIgnoreCase))
        {
            return "InteractiveWebAssembly";
        }

        if (string.Equals(mode, "InteractiveServer", StringComparison.OrdinalIgnoreCase))
        {
            return "InteractiveServer";
        }

        return "InteractiveAuto";
    }

    private static string NormalizeOnboardingRenderMode(string? mode)
    {
        // Onboarding always uses InteractiveServer regardless of input.
        return "InteractiveServer";
    }

    private sealed record PresetOption(string Value, string Label, string Description, string HelpText);
    private sealed record RenderModeOption(string Value, string Label);
    private sealed record RouteGroupOption(string Value, string Label, string HelpText);
}
