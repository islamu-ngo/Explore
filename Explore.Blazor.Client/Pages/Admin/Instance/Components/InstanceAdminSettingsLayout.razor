@* ABOUTME: Sidebar layout component for Instance Admin Settings with context-aware sections. *@
@* In single-tenant mode shows unified settings; in multi-tenant mode shows tenant management. *@

@using MudBlazor
@using Microsoft.AspNetCore.Components
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients

@inject IInstanceOnboardingService InstanceOnboardingService
@inject ITenantOnboardingService TenantOnboardingService
@inject IPublicExperienceService PublicExperienceService
@inject ISnackbar Snackbar

<div class="settings-layout">
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
        <!-- Header -->
        <div class="settings-header mb-8">
            <MudText Typo="Typo.h4" Style="font-weight: 800;">
                @(IsSingleTenantMode ? "Administration" : "Instance Administration")
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                @(IsSingleTenantMode
                    ? "Manage platform settings, organizations, modules, storage, and SMTP"
                    : "Manage platform governance, tenants, domain, branding, modules, storage, and SMTP settings")
            </MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-4">
                <MudChip T="string"
                         Color="@(IsSingleTenantMode ? Color.Warning : Color.Info)"
                         Variant="Variant.Outlined"
                         Icon="@Icons.Material.Filled.Apartment">
                    @(IsSingleTenantMode ? "Single Tenant" : "Multi-Tenant")
                </MudChip>

                @if (IsSingleTenantMode)
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.RocketLaunch"
                               OnClick="@(() => SelectSection("multi-tenancy"))">
                        Enable SaaS Mode
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.DomainAdd"
                               OnClick="@(() => SelectSection("tenants"))">
                        Manage Platform
                    </MudButton>
                }
            </MudStack>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        @if (_isLoading)
        {
            <MudStack AlignItems="AlignItems.Center" Class="py-12">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">Loading settings...</MudText>
            </MudStack>
        }
        else if (!_canEdit)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                You do not have instance administrator permissions to view or modify these settings.
            </MudAlert>
        }
        else
        {
            <!-- Main Layout: Sidebar + Content -->
            <MudGrid Spacing="4">
                <!-- Sidebar Navigation -->
                <MudItem xs="3" sm="3" md="3">
                    <MudPaper Elevation="0" Class="settings-sidebar pa-0">
                        <MudList T="string" Dense="false" DisablePadding="true">
                            @if (IsSingleTenantMode)
                            {
                                <MudListItem Icon="@Icons.Material.Filled.Settings"
                                             Text="General"
                                             Class="@GetNavItemClass("governance")"
                                             OnClick="@(() => SelectSection("governance"))" />
                                <MudListItem Icon="@Icons.Material.Filled.People"
                                             Text="Members"
                                             Class="@GetNavItemClass("members")"
                                             OnClick="@(() => SelectSection("members"))" />
                                <MudListItem Icon="@Icons.Material.Filled.Business"
                                             Text="Organizations"
                                             Class="@GetNavItemClass("organizations")"
                                             OnClick="@(() => SelectSection("organizations"))" />
                                <MudListItem Icon="@Icons.Material.Filled.TableChart"
                                             Text="Lookup Tables"
                                             Class="@GetNavItemClass("lookups")"
                                             OnClick="@(() => SelectSection("lookups"))" />
                                <MudListItem Icon="@Icons.Material.Filled.Policy"
                                             Text="Policies"
                                             Class="@GetNavItemClass("policies")"
                                             OnClick="@(() => SelectSection("policies"))" />
                                <MudListItem Icon="@Icons.Material.Filled.Visibility"
                                             Text="Appearance"
                                             Class="@GetNavItemClass("appearance")"
                                             OnClick="@(() => SelectSection("appearance"))" />
                                <MudListItem Icon="@Icons.Material.Filled.Key"
                                             Text="Auth Providers"
                                             Class="@GetNavItemClass("auth-providers")"
                                             OnClick="@(() => SelectSection("auth-providers"))" />
                                <MudListItem Icon="@Icons.Material.Filled.Extension"
                                             Text="Modules"
                                             Class="@GetNavItemClass("modules")"
                                             OnClick="@(() => SelectSection("modules"))" />
                                <MudListItem Icon="@Icons.Material.Filled.Language"
                                             Text="Domain"
                                             Class="@GetNavItemClass("domain")"
                                             OnClick="@(() => SelectSection("domain"))" />
                                <MudListItem Icon="@Icons.Material.Filled.Cloud"
                                             Text="Object Storage"
                                             Class="@GetNavItemClass("storage")"
                                             OnClick="@(() => SelectSection("storage"))" />
                                <MudListItem Icon="@Icons.Material.Filled.AlternateEmail"
                                             Text="SMTP"
                                             Class="@GetNavItemClass("smtp")"
                                             OnClick="@(() => SelectSection("smtp"))" />
                                <MudListItem Icon="@Icons.Material.Filled.Analytics"
                                             Text="Analytics & Privacy"
                                             Class="@GetNavItemClass("analytics-privacy")"
                                             OnClick="@(() => SelectSection("analytics-privacy"))" />

                                <!-- Advanced Section -->
                                <div class="settings-nav-separator">
                                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="settings-nav-separator__label">Advanced</MudText>
                                </div>
                                <MudListItem Icon="@Icons.Material.Filled.DisplaySettings"
                                             Text="Render Policies"
                                             Class="@GetNavItemClass("render-policies")"
                                             OnClick="@(() => SelectSection("render-policies"))" />
                                <MudListItem Icon="@Icons.Material.Filled.SwapHoriz"
                                             Text="Multi-Tenancy"
                                             Class="@GetNavItemClass("multi-tenancy")"
                                             OnClick="@(() => SelectSection("multi-tenancy"))" />

                                <!-- Developer Section -->
                                <div class="settings-nav-separator">
                                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="settings-nav-separator__label">Developer</MudText>
                                </div>
                                <MudListItem Icon="@Icons.Material.Filled.Key"
                                             Text="Access Tokens"
                                             Class="@GetNavItemClass("access-tokens")"
                                             OnClick="@(() => SelectSection("access-tokens"))" />
                                <MudListItem Icon="@Icons.Material.Filled.Webhook"
                                             Text="Webhooks"
                                             Class="@GetNavItemClass("webhooks")"
                                             OnClick="@(() => SelectSection("webhooks"))" />
                            }
                            else
                            {
                                <MudListItem Icon="@Icons.Material.Filled.Gavel"
                                             Text="Governance"
                                             Class="@GetNavItemClass("governance")"
                                             OnClick="@(() => SelectSection("governance"))" />
                                <MudListItem Icon="@Icons.Material.Filled.Language"
                                             Text="Domain"
                                             Class="@GetNavItemClass("domain")"
                                             OnClick="@(() => SelectSection("domain"))" />
                                <MudListItem Icon="@Icons.Material.Filled.Palette"
                                             Text="Branding"
                                             Class="@GetNavItemClass("branding")"
                                             OnClick="@(() => SelectSection("branding"))" />
                                <MudListItem Icon="@Icons.Material.Filled.Key"
                                             Text="Auth Providers"
                                             Class="@GetNavItemClass("auth-providers")"
                                             OnClick="@(() => SelectSection("auth-providers"))" />
                                <MudListItem Icon="@Icons.Material.Filled.Extension"
                                             Text="Modules"
                                             Class="@GetNavItemClass("modules")"
                                             OnClick="@(() => SelectSection("modules"))" />
                                <MudListItem Icon="@Icons.Material.Filled.Cloud"
                                             Text="Object Storage"
                                             Class="@GetNavItemClass("storage")"
                                             OnClick="@(() => SelectSection("storage"))" />
                                <MudListItem Icon="@Icons.Material.Filled.AlternateEmail"
                                             Text="SMTP"
                                             Class="@GetNavItemClass("smtp")"
                                             OnClick="@(() => SelectSection("smtp"))" />
                                <MudListItem Icon="@Icons.Material.Filled.Analytics"
                                             Text="Analytics & Privacy"
                                             Class="@GetNavItemClass("analytics-privacy")"
                                             OnClick="@(() => SelectSection("analytics-privacy"))" />
                                <MudListItem Icon="@Icons.Material.Filled.DomainAdd"
                                             Text="Tenants"
                                             Class="@GetNavItemClass("tenants")"
                                             OnClick="@(() => SelectSection("tenants"))" />
                            }
                        </MudList>
                    </MudPaper>
                </MudItem>

                <!-- Content Area -->
                <MudItem xs="9" sm="9" md="9">
                    <MudPaper Elevation="0" Class="settings-content pa-6">
                        @if (_currentSection == "governance")
                        {
                            <InstanceGovernanceSection Model="_model" TenantCount="_tenantCount" DeploymentModeChanged="OnDeploymentModeChanged" DisplayMode="@(IsSingleTenantMode ? "general" : "full")" />
                            @if (IsSingleTenantMode)
                            {
                                <MudDivider Class="my-6" />
                                <InstanceBrandingSection Model="_model" IsSingleTenant="true" />
                            }
                        }
                        else if (_currentSection == "domain")
                        {
                            <InstanceDomainSection Model="_model" />
                        }
                        else if (_currentSection == "branding" && !IsSingleTenantMode)
                        {
                            <InstanceBrandingSection Model="_model" IsSingleTenant="false" />
                        }
                        else if (_currentSection == "auth-providers")
                        {
                            <InstanceAuthProviderSection Model="_authProviderModel" />
                        }
                        else if (_currentSection == "appearance" && IsSingleTenantMode)
                        {
                            <InstanceAppearanceSection Model="_model" />
                        }
                        else if (_currentSection == "modules")
                        {
                            <InstanceModulesSection Model="_model" />
                        }
                        else if (_currentSection == "storage")
                        {
                            <InstanceStorageSection Model="_storageModel" OnboardingService="InstanceOnboardingService" />
                        }
                        else if (_currentSection == "smtp")
                        {
                            <InstanceSmtpSection Model="_smtpModel" OnboardingService="InstanceOnboardingService" />
                        }
                        else if (_currentSection == "analytics-privacy")
                        {
                            <InstanceAnalyticsPrivacySection Model="_analyticsModel" />
                        }
                        else if (_currentSection == "members" && IsSingleTenantMode)
                        {
                            <TenantMembersSection />
                        }
                        else if (_currentSection == "policies" && IsSingleTenantMode)
                        {
                            <Explore.Blazor.Client.Pages.Admin.Tenant.Components.TenantPoliciesSection Model="_tenantModel" />
                        }
                        else if (_currentSection == "organizations" && IsSingleTenantMode)
                        {
                            <Explore.Blazor.Client.Pages.Admin.Tenant.Components.TenantOrganizationsSection />
                        }
                        else if (_currentSection == "lookups" && IsSingleTenantMode)
                        {
                            <Explore.Blazor.Client.Pages.Admin.Tenant.Components.TenantLookupTablesSection />
                        }
                        else if (_currentSection == "render-policies" && IsSingleTenantMode)
                        {
                            <InstanceGovernanceSection Model="_model" TenantCount="_tenantCount" DeploymentModeChanged="OnDeploymentModeChanged" DisplayMode="render-policies" />
                        }
                        else if (_currentSection == "multi-tenancy" && IsSingleTenantMode)
                        {
                            <InstanceGovernanceSection Model="_model" TenantCount="_tenantCount" DeploymentModeChanged="OnDeploymentModeChanged" DisplayMode="multi-tenancy" />
                        }
                        else if (_currentSection == "access-tokens" && IsSingleTenantMode)
                        {
                            <div class="settings-section">
                                <div class="settings-section-header">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <div>
                                            <MudText Typo="Typo.h5" Style="font-weight: 700;">Access Tokens</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                                                Create and manage API access tokens for programmatic access.
                                            </MudText>
                                        </div>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Add"
                                                   Disabled="true">
                                            Add Access Token
                                        </MudButton>
                                    </MudStack>
                                </div>
                                <MudAlert Severity="Severity.Info" Class="mt-4">
                                    Access token management is coming soon.
                                </MudAlert>
                            </div>
                        }
                        else if (_currentSection == "webhooks" && IsSingleTenantMode)
                        {
                            <div class="settings-section">
                                <div class="settings-section-header">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <div>
                                            <MudText Typo="Typo.h5" Style="font-weight: 700;">Webhooks</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                                                Configure webhook endpoints to receive event notifications.
                                            </MudText>
                                        </div>
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Add"
                                                   Disabled="true">
                                            Add Webhook
                                        </MudButton>
                                    </MudStack>
                                </div>
                                <MudAlert Severity="Severity.Info" Class="mt-4">
                                    Webhook management is coming soon.
                                </MudAlert>
                            </div>
                        }
                        else if (_currentSection == "tenants" && !IsSingleTenantMode)
                        {
                            <InstanceTenantsSection TenantCount="_tenantCount" TenantCountChanged="OnTenantCountChanged" />
                        }

                        @* Only show Save button for settings sections, not for org/lookup/tenants which have their own actions *@
                        @if (IsSettingsSection(_currentSection))
                        {
                            <MudDivider Class="my-4" />

                            <MudStack Row="true" Justify="Justify.FlexEnd">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           OnClick="SaveAsync"
                                           Disabled="_isSaving"
                                           StartIcon="@(_isSaving ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.Save)">
                                    @(_isSaving ? "Saving..." : "Save Settings")
                                </MudButton>
                            </MudStack>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    </MudContainer>
</div>

@code {
    private InstanceGovernanceSettingsModel _model = new();
    private InstanceStorageSettingsModel _storageModel = new();
    private InstanceSmtpSettingsModel _smtpModel = new();
    private AuthProviderConfigurationModel _authProviderModel = new();
    private TenantPolicySettingsModel _tenantModel = new();
    private Explore.Blazor.Client.Models.Analytics.AnalyticsGovernanceSettingsModel _analyticsModel = new();
    private int _tenantCount;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _canEdit;
    private string? _errorMessage;
    private string _currentSection = "governance";

    private bool IsSingleTenantMode => string.Equals(_model.DeploymentMode, "SingleTenant", StringComparison.OrdinalIgnoreCase)
                                       || string.IsNullOrWhiteSpace(_model.DeploymentMode);

    private static bool IsSettingsSection(string section) =>
        section is "governance" or "domain" or "branding" or "auth-providers" or "modules" or "storage" or "smtp" or "policies" or "render-policies" or "multi-tenancy" or "appearance" or "analytics-privacy";

    protected override async Task OnInitializedAsync()
    {
        var status = await InstanceOnboardingService.GetStatusAsync();
        _canEdit = status?.IsCurrentUserInstanceAdmin == true;

        if (!_canEdit)
        {
            _isLoading = false;
            return;
        }

        _model = await InstanceOnboardingService.GetSettingsAsync();
        _storageModel = await InstanceOnboardingService.GetStorageSettingsAsync();
        _smtpModel = await InstanceOnboardingService.GetSmtpSettingsAsync();
        _authProviderModel = await InstanceOnboardingService.GetAuthProviderConfigurationAsync();
        _analyticsModel = await InstanceOnboardingService.GetAnalyticsGovernanceSettingsAsync();
        _tenantCount = await InstanceOnboardingService.GetActiveTenantCountAsync();

        if (IsSingleTenantMode)
        {
            _tenantModel = await TenantOnboardingService.GetSettingsAsync();
        }

        _isLoading = false;
    }

    private async Task OnDeploymentModeChanged(string newMode)
    {
        if (string.Equals(newMode, "SingleTenant", StringComparison.OrdinalIgnoreCase))
        {
            _tenantModel = await TenantOnboardingService.GetSettingsAsync();
            if (_currentSection is "tenants")
            {
                _currentSection = "governance";
            }
        }
        else
        {
            if (_currentSection is "policies" or "organizations" or "lookups" or "members" or "access-tokens" or "webhooks" or "render-policies" or "multi-tenancy" or "appearance")
            {
                _currentSection = "governance";
            }
        }

        StateHasChanged();
    }

    private void OnTenantCountChanged(int newCount)
    {
        _tenantCount = newCount;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        _errorMessage = null;

        var response = await InstanceOnboardingService.UpdateSettingsAsync(_model);

        if (!response.Success)
        {
            _isSaving = false;
            _errorMessage = string.IsNullOrWhiteSpace(response.Message)
                ? "Failed to save settings."
                : response.Message;
            return;
        }

        if (_currentSection == "auth-providers")
        {
            var authProviderResponse = await InstanceOnboardingService.UpdateAuthProviderConfigurationAsAdminAsync(_authProviderModel);
            if (!authProviderResponse.Success)
            {
                _isSaving = false;
                _errorMessage = string.IsNullOrWhiteSpace(authProviderResponse.Message)
                    ? "Settings saved, but auth provider settings failed."
                    : authProviderResponse.Message;
                return;
            }

            await InstanceOnboardingService.RefreshAuthSchemesAsync();
        }

        var storageResponse = await InstanceOnboardingService.UpdateStorageSettingsAsync(_storageModel);
        var smtpResponse = await InstanceOnboardingService.UpdateSmtpSettingsAsync(_smtpModel);
        var analyticsResponse = await InstanceOnboardingService.UpdateAnalyticsGovernanceSettingsAsync(_analyticsModel);

        if (IsSingleTenantMode && _currentSection == "policies")
        {
            var tenantResponse = await TenantOnboardingService.UpdateSettingsAsync(_tenantModel);
            if (!tenantResponse.Success)
            {
                _isSaving = false;
                _errorMessage = string.IsNullOrWhiteSpace(tenantResponse.Message)
                    ? "Settings saved, but policy settings failed."
                    : tenantResponse.Message;
                return;
            }
        }

        _isSaving = false;

        if (storageResponse.Success && smtpResponse.Success)
        {
            PublicExperienceService.ResetCache();
            Snackbar.Add("Settings saved.", Severity.Success);
            return;
        }

        if (!storageResponse.Success)
        {
            _errorMessage = string.IsNullOrWhiteSpace(storageResponse.Message)
                ? "Governance settings saved, but storage settings failed."
                : storageResponse.Message;
            return;
        }

        _errorMessage = string.IsNullOrWhiteSpace(smtpResponse.Message)
            ? "Governance and storage settings saved, but SMTP settings failed."
            : smtpResponse.Message;
    }

    private void SelectSection(string section)
    {
        _currentSection = section;
    }

    private string GetNavItemClass(string section)
    {
        return _currentSection == section ? "settings-nav-active" : "";
    }
}
