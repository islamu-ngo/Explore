@* ABOUTME: Renders branding fields for Instance Admin Settings. *@
@* ABOUTME: In single-tenant mode lock toggles are hidden (no tenant override concept). *@

@using MudBlazor
@using Explore.Blazor.Client.Services

<div class="settings-section">
    <div class="settings-section-header">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Branding</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
            @if (IsSingleTenant)
            {
                @:Customize your platform's brand identity — name, logo, favicon, and optional stylesheet.
            }
            else
            {
                @:Set the default brand identity applied to new tenants. Lock individual fields to prevent tenant overrides.
            }
        </MudText>
    </div>
    <MudStack Spacing="3">
        <MudTextField T="string" Label="Brand Display Name"
                      Variant="Variant.Outlined"
                      @bind-Value="Model.DefaultBrandDisplayName" />

        <MudTextField T="string" Label="Brand Logo URL"
                      Variant="Variant.Outlined"
                      @bind-Value="Model.DefaultBrandLogoUrl" />

        <MudTextField T="string" Label="Brand Favicon URL"
                      Variant="Variant.Outlined"
                      @bind-Value="Model.DefaultBrandFaviconUrl" />

        <MudTextField T="string" Label="Custom CSS URL (Optional)"
                      Variant="Variant.Outlined"
                      @bind-Value="Model.DefaultBrandCustomCssUrl"
                      HelperText="Optional override for a platform-level custom stylesheet." />

        @if (!IsSingleTenant)
        {
            <MudDivider Class="my-1" />
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Tenant Lock Controls</MudText>

            <MudSwitch T="bool"
                       Value="Model.LockTenantBrandDisplayName == true"
                       ValueChanged="@(value => Model.LockTenantBrandDisplayName = value)"
                       Color="Color.Primary">
                Lock tenant brand display name
            </MudSwitch>

            <MudSwitch T="bool"
                       Value="Model.LockTenantBrandLogoUrl == true"
                       ValueChanged="@(value => Model.LockTenantBrandLogoUrl = value)"
                       Color="Color.Primary">
                Lock tenant brand logo
            </MudSwitch>

            <MudSwitch T="bool"
                       Value="Model.LockTenantBrandFaviconUrl == true"
                       ValueChanged="@(value => Model.LockTenantBrandFaviconUrl = value)"
                       Color="Color.Primary">
                Lock tenant brand favicon
            </MudSwitch>

            <MudSwitch T="bool"
                       Value="Model.LockTenantBrandCustomCssUrl == true"
                       ValueChanged="@(value => Model.LockTenantBrandCustomCssUrl = value)"
                       Color="Color.Primary">
                Lock tenant custom CSS URL
            </MudSwitch>
        }
    </MudStack>
</div>

@code {
    [Parameter, EditorRequired]
    public BrandingSettingsDto Model { get; set; } = null!;

    /// <summary>When true, hides lock toggles since there are no tenants to override.</summary>
    [Parameter]
    public bool IsSingleTenant { get; set; }
}
