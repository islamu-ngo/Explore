@* ABOUTME: Legacy standalone settings page — replaced by InstanceAdminSettingsLayout sidebar. *@
@* ABOUTME: Kept as a simple redirect to the new admin settings layout. *@

@page "/admin/instance/settings-legacy"
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/admin/instance/settings", replace: true);
    }
}
