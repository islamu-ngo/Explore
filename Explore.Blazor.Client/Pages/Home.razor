@using Microsoft.AspNetCore.Components.Authorization
@using Explore.Blazor.Client.Pages.Landing
@using Microsoft.Extensions.Logging
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Home> Logger

<PageTitle>ISLAMU Explore</PageTitle>

@if (isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh;">
        <div style="text-align: center;">
            <div style="font-size: 1.2em; margin-bottom: 1rem;">Loading...</div>
            <div>Please wait while we check your authentication status</div>
        </div>
    </div>
}
else if (isAuthenticated)
{
    <LandingPageForUsers />
}
else
{
    <LandingPageForNonUsers />
}

@code {
    private bool isLoading = true;
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Auth check failed");
            isAuthenticated = false;
        }
        finally
        {
            isLoading = false;
        }
    }
}
