@page "/"
@inject IJSRuntime JSRuntime
@using Explore.Blazor.Client.Pages.Landing

<PageTitle>ISLAMU Explore</PageTitle>

@if (isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; height: 100vh;">
        <div style="text-align: center;">
            <div style="font-size: 1.2em; margin-bottom: 1rem;">Loading...</div>
            <div>Please wait while we check your authentication status</div>
        </div>
    </div>
}
else if (isAuthenticated)
{
    <LandingPageForUsers />
}
else
{
    <LandingPageForNonUsers />
}

@code {
    private bool isLoading = true;
    private bool isAuthenticated = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckAuthenticationStatus();
        }
    }

    private async Task CheckAuthenticationStatus()
    {
        try
        {
            var result = await JSRuntime.InvokeAsync<AuthStatusResult>("checkAuthStatus");
            isAuthenticated = result.IsAuthenticated;
            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Auth check failed: {ex.Message}");
            isAuthenticated = false;
            isLoading = false;
            StateHasChanged();
        }
    }

    public class AuthStatusResult
    {
        public bool IsAuthenticated { get; set; }
        public string? Name { get; set; }
    }
}
