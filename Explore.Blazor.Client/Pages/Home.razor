@using Microsoft.AspNetCore.Components.Authorization
@using Explore.Blazor.Client.Pages.Landing
@using Microsoft.Extensions.Logging
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Home> Logger

<PageTitle>ISLAMU Explore</PageTitle>

@if (isLoading)
{
    <div class="home-page__loading">
        <div class="home-page__loading-content">
            <div class="home-page__loading-title">Loading...</div>
            <div class="home-page__loading-text">Please wait while we check your authentication status</div>
        </div>
    </div>
}
else if (isAuthenticated)
{
    <LandingPageForUsers />
}
else
{
    <LandingPageForNonUsers />
}

@code {
    private bool isLoading = true;
    private bool isAuthenticated = false;

    [PersistentState]
    public HomeState? PersistedState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (PersistedState != null)
        {
            isAuthenticated = PersistedState.IsAuthenticated;
            isLoading = false;
            return;
        }

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Auth check failed");
            isAuthenticated = false;
        }
        finally
        {
            isLoading = false;
            PersistedState = new HomeState { IsAuthenticated = isAuthenticated };
        }
    }

    public sealed class HomeState
    {
        public bool IsAuthenticated { get; init; }
    }
}
