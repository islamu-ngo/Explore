@using Explore.Blazor.Client.Pages.Events
@using Explore.Blazor.Client.Helpers
@using Explore.Blazor.Client.Pages.Landing
@inject IStartupRoutingService StartupRoutingService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>
<HeadContent>
    <link rel="canonical" href="@CanonicalUrlHelper.Build(Navigation, "/")" />
</HeadContent>

@switch (_state)
{
    case RootState.Loading:
        <MudContainer Class="pb-8">
            <MudSkeleton Width="200px" Height="20px" Class="mt-4 mb-4" />
            <MudGrid Spacing="4">
                @for (int i = 0; i < 8; i++)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <EventCardSkeleton Layout="LayoutMode.CompactGrid" />
                    </MudItem>
                }
            </MudGrid>
        </MudContainer>
        break;
    case RootState.ShowLanding:
        <Home />
        break;
    case RootState.ShowEvents:
        <EventList />
        break;
    default:
        <MudContainer Class="pb-8">
            <MudSkeleton Width="200px" Height="20px" Class="mt-4 mb-4" />
            <MudGrid Spacing="4">
                @for (int i = 0; i < 4; i++)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <EventCardSkeleton Layout="LayoutMode.CompactGrid" />
                    </MudItem>
                }
            </MudGrid>
        </MudContainer>
        break;
}

@code {
    private RootState _state = RootState.Loading;
    private bool _isInitialized;

    [PersistentState]
    public RootState? PersistedRootState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (_isInitialized)
        {
            return;
        }

        _isInitialized = true;

        if (PersistedRootState.HasValue)
        {
            _state = PersistedRootState.Value;
            return;
        }

        await ResolveRootAsync();
    }

    private async Task ResolveRootAsync()
    {
        var decision = await StartupRoutingService.GetRootDecisionAsync();
        switch (decision)
        {
            case StartupRouteDecision.Setup:
                Navigation.NavigateTo("/setup");
                return;
            case StartupRouteDecision.InstanceAdmin:
                Navigation.NavigateTo("/admin/instance/settings");
                return;
            case StartupRouteDecision.PublicLanding:
                _state = RootState.ShowLanding;
                PersistedRootState = _state;
                return;
            default:
                _state = RootState.ShowEvents;
                PersistedRootState = _state;
                return;
        }
    }

    public enum RootState
    {
        Loading,
        ShowLanding,
        ShowEvents
    }
}
