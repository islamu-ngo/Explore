@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using Blazouter.Services

<MudContainer MaxWidth="MaxWidth.Large" Class="organization-members">
    <MudText Typo="Typo.h4" GutterBottom="true">Organization Members</MudText>

    <div class="d-flex justify-space-between align-center mb-4 gap-4">
        @if (currentUserRole.HasValue && currentUserRole.Value != 4) @* 4 = Member *@
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenInviteDialog" StartIcon="@Icons.Material.Filled.PersonAdd">
                Invite Member
            </MudButton>
        }
        else
        {
            <MudSpacer />
        }
    </div>

    <div class="d-flex gap-4 mb-4">
        <MudTextField @bind-Value="_searchString"
                      Placeholder="Search members..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="flex-grow-1"/>

        <MudSelect T="int?" Label="Role" @bind-Value="_roleFilter" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter" Class="flex-none" Style="min-width: 150px;" Clearable="true">
            <MudSelectItem Value="(int?)1">Creator</MudSelectItem>
            <MudSelectItem Value="(int?)2">Co-Owner</MudSelectItem>
            <MudSelectItem Value="(int?)3">Admin</MudSelectItem>
            <MudSelectItem Value="(int?)4">Member</MudSelectItem>
        </MudSelect>
    </div>

    <MudTable Items="@FilteredMembers" Hover="true" Loading="@_loading" Striped="true">
        <HeaderContent>
            <MudTh>User</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Role</MudTh>
            @if (currentUserRole.HasValue && currentUserRole.Value != 4) @* 4 = Member *@
            {
                <MudTh>Actions</MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="User">
                <div class="d-flex align-center">
                    <MudAvatar Color="Color.Secondary" Size="Size.Small" Class="mr-2">@(string.IsNullOrEmpty(context.UserEmail) ? "?" : context.UserEmail.Substring(0, 1).ToUpper())</MudAvatar>
                    @if (context.UserId == Guid.Empty)
                    {
                        <MudText FontStyle="FontStyle.Italic">Pending Invite</MudText>
                    }
                    else
                    {
                        <MudText>@(context.UserFullName ?? context.UserEmail)</MudText>
                    }
                </div>
            </MudTd>
            <MudTd DataLabel="Email">@context.UserEmail</MudTd>
            <MudTd DataLabel="Role">
                <MudChip T="string" Color="@GetRoleColor(context.OrganizationRoleId ?? 0)" Size="Size.Small">@GetRoleName(context.OrganizationRoleId ?? 0)</MudChip>
            </MudTd>
            @if (currentUserRole.HasValue && currentUserRole.Value != 4) @* 4 = Member *@
            {
                <MudTd DataLabel="Actions">
                    @if (context.OrganizationRoleId != 1) @* 1 = Creator *@
                    {
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small">
                            <MudMenuItem OnClick="@(() => OpenEditRoleDialog(context))" Icon="@Icons.Material.Filled.Edit">Change Role</MudMenuItem>
                            <MudMenuItem OnClick="@(() => RemoveMember(context))" Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error">Remove</MudMenuItem>
                        </MudMenu>
                    }
                </MudTd>
            }
        </RowTemplate>
        <NoRecordsContent>
            <MudText>No members found.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudContainer>
