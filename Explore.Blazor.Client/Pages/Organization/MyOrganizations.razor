@page "/organizations/my"
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients
@attribute [Authorize]

<PageTitle>My Organizations</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="my-organizations">
    <!-- Header -->
    <div class="my-organizations__header">
        <div>
            <MudText Typo="Typo.h4" Class="mb-1">My Organizations</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Manage your organizations and create events
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/organization/create"
                   Class="my-organizations__create-btn">
            Create Organization
        </MudButton>
    </div>

    @if (_isLoading)
    {
        <div class="my-organizations__loading">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-4">
                Loading your organizations...
            </MudText>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-4">
            @_errorMessage
            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="RetryLoadAsync" Class="ml-4">
                Retry
            </MudButton>
        </MudAlert>
    }
    else if (_organizations == null || !_organizations.Any())
    {
        <div class="my-organizations__empty">
            <MudIcon Icon="@Icons.Material.Outlined.Business" Class="my-organizations__empty-icon" />
            <MudText Typo="Typo.h5" Class="mt-4">No organizations yet</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
                Create an organization to start hosting events
            </MudText>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Href="/organization/create"
                       StartIcon="@Icons.Material.Filled.Add">
                Create your first organization
            </MudButton>
        </div>
    }
    else
    {
        <!-- Search -->
        <MudTextField @bind-Value="_searchString"
                      Placeholder="Search by name or email..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Class="my-organizations__search mb-6" />

        @if (!FilteredOrganizations.Any())
        {
            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="mt-8">
                No organizations match your search.
            </MudText>
        }
        else
        {
            <MudGrid Spacing="4">
                @foreach (var org in FilteredOrganizations)
                {
                    <MudItem xs="12" sm="6" md="6" lg="4" xl="3">
                        <MudCard Class="my-organizations__card" Elevation="0">
                            <!-- Card Media / Banner -->
                            <div class="my-organizations__card-media" style="background-color: @GetOrganizationColor(org.FullName);">
                                <MudAvatar Size="Size.Large"
                                           Color="Color.Surface"
                                           Variant="Variant.Filled"
                                           Class="my-organizations__avatar">
                                    <MudText Color="Color.Primary" Typo="Typo.h6">@GetInitials(org.FullName)</MudText>
                                </MudAvatar>
                            </div>

                            <MudCardContent Class="my-organizations__content">
                                <!-- Role Badge -->
                                <div class="my-organizations__badges">
                                    @if (org.CurrentUserRole.HasValue)
                                    {
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="@GetRoleColor(org.CurrentUserRole.Value)"
                                                 Variant="Variant.Outlined"
                                                 Class="my-organizations__role-chip">
                                            @GetRoleName(org.CurrentUserRole.Value)
                                        </MudChip>
                                    }
                                </div>

                                <MudText Typo="Typo.h6" Class="my-organizations__card-title">@org.FullName</MudText>

                                <div class="my-organizations__card-meta">
                                    <div class="my-organizations__info-row mb-1">
                                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Secondary" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            @org.City, @org.Country
                                        </MudText>
                                    </div>
                                    
                                    <div class="my-organizations__info-row">
                                        <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Color="Color.Secondary" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@org.Email</MudText>
                                    </div>
                                </div>
                            </MudCardContent>

                            <MudCardActions Class="my-organizations__actions">
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           Href="@($"/organization/{org.Id}")"
                                           EndIcon="@Icons.Material.Filled.ArrowForward"
                                           Size="Size.Small">
                                    Details
                                </MudButton>
                                <MudSpacer />
                                @if (CanCreateEvents(org))
                                {
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Add"
                                               Href="@($"/organization/{org.Id}/create-event")"
                                               Size="Size.Small">
                                        Event
                                    </MudButton>
                                }
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>

            <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary" Class="mt-6">
                Showing @FilteredOrganizations.Count() of @_organizations.Count organization(s)
            </MudText>
        }
    }
</MudContainer>
