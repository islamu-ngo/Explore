@page "/organization/my"
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Models.DTOs
@using Explore.Blazor.Client.Models.DTOs.OrganizationMember
@using Microsoft.AspNetCore.Authorization
@inject IOrganizationService OrganizationService
@inject IOrganizationMemberService OrganizationMemberService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@attribute [Authorize]

<PageTitle>My Organizations</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    @if (_invitations != null && _invitations.Any())
    {
        <MudPaper Class="pa-6 mb-6">
            <MudText Typo="Typo.h5" GutterBottom="true" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.Mail" Class="mr-2" />
                Pending Invitations
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-4">
                You have been invited to join the following organizations.
            </MudText>

            <MudTable Items="_invitations" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Organization</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Organization">
                        <MudText Typo="Typo.subtitle2">@context.OrganizationName</MudText>
                    </MudTd>
                    <MudTd DataLabel="Role">
                        <MudChip T="string" Color="Color.Info" Size="Size.Small">@context.Role</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Success" 
                                   Size="Size.Small" 
                                   OnClick="@(() => AcceptInvitation(context.Id))"
                                   Class="mr-2">
                            Accept
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" 
                                   Color="Color.Error" 
                                   Size="Size.Small" 
                                   OnClick="@(() => DeclineInvitation(context.Id))">
                            Decline
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }

    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h4" GutterBottom="true">
            <MudIcon Icon="@Icons.Material.Filled.Business" Class="mr-2" />
            My Organizations
        </MudText>
        <MudText Typo="Typo.body1" Class="mb-4">
            Here you can see all organizations you have created.
        </MudText>

        @if (_loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
            <MudText Align="Align.Center">Loading organizations...</MudText>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="my-4">
                @_errorMessage
            </MudAlert>
        }
        else if (_organizations == null || !_organizations.Any())
        {
            <MudAlert Severity="Severity.Info" Class="my-4">
                <MudText>You haven't created any organizations yet.</MudText>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Add"
                           Class="mt-2"
                           Href="/organization/create">
                    Create your first organization
                </MudButton>
            </MudAlert>
        }
        else
        {
            <MudTable Items="_organizations" 
                      Hover="true" 
                      Breakpoint="Breakpoint.Sm" 
                      Dense="true"
                      Class="mt-4">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Location</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Website</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        <MudText Typo="Typo.body2"><strong>@context.FullName</strong></MudText>
                    </MudTd>
                    <MudTd DataLabel="Location">
                        <MudText Typo="Typo.body2">@context.City, @context.Country</MudText>
                        <MudText Typo="Typo.caption">@context.Address, @context.Postcode</MudText>
                    </MudTd>
                    <MudTd DataLabel="Email">
                        <MudText Typo="Typo.body2">@context.Email</MudText>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        @{
                            var statusColor = context.StatusTypeId switch
                            {
                                1 => Color.Warning,  // Pending
                                2 => Color.Success,  // Approved
                                3 => Color.Error,    // Rejected
                                _ => Color.Default
                            };
                        }
                        <MudChip T="string" Color="statusColor" Size="Size.Small">@context.StatusTypeFullName</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Website">
                        @if (!string.IsNullOrEmpty(context.WebsiteUrl))
                        {
                            <MudLink Href="@context.WebsiteUrl" Target="_blank">
                                <MudIcon Icon="@Icons.Material.Filled.Link" Size="Size.Small" />
                            </MudLink>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                       Color="Color.Info" 
                                       Size="Size.Small"
                                       Href="@($"/organization/{context.Id}")"
                                       Title="View" />
                        <MudIconButton Icon="@Icons.Material.Filled.People" 
                                       Color="Color.Secondary" 
                                       Size="Size.Small"
                                       Href="@($"/organization/{context.Id}/members")"
                                       Title="Manage Members" />
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <MudText Typo="Typo.caption" Class="mt-4" Color="Color.Secondary">
                Total: @_organizations.Count organization(s)
            </MudText>
        }

        <MudDivider Class="my-4" />
        
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/organization/create">
            Create new organization
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private List<OrganizationListDto>? _organizations;
    private List<OrganizationInvitationDto>? _invitations;
    private bool _loading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _loading = true;
            _errorMessage = null;
            var orgsTask = OrganizationService.GetMyOrganizationsAsync();
            var invitesTask = OrganizationMemberService.GetMyInvitationsAsync();
            
            await Task.WhenAll(orgsTask, invitesTask);
            
            _organizations = await orgsTask;
            _invitations = await invitesTask;
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred while loading your data: {ex.Message}";
            Console.WriteLine($"Error loading data: {ex}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadOrganizations()
    {
        try
        {
            _organizations = await OrganizationService.GetMyOrganizationsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading organizations: {ex}");
        }
    }

    private async Task LoadInvitations()
    {
        try
        {
            _invitations = await OrganizationMemberService.GetMyInvitationsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading invitations: {ex}");
        }
    }

    private async Task AcceptInvitation(Guid id)
    {
        try
        {
            await OrganizationMemberService.AcceptInvitationAsync(id);
            Snackbar.Add("Invitation accepted!", Severity.Success);
            await LoadData(); // Refresh both lists
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error accepting invitation: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeclineInvitation(Guid id)
    {
        try
        {
            await OrganizationMemberService.DeclineInvitationAsync(id);
            Snackbar.Add("Invitation declined.", Severity.Info);
            await LoadInvitations();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error declining invitation: {ex.Message}", Severity.Error);
        }
    }
}
