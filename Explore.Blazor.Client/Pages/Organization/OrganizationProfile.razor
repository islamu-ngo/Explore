@using MudBlazor
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients
@using Blazouter.Services
@using Microsoft.Extensions.Logging
@attribute [StreamRendering]

<PageTitle>Organization Profile</PageTitle>
<MudContainer Class="organization-profile">
    @if (_isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (_organization == null)
    {
        <MudAlert Severity="Severity.Error">Organization not found.</MudAlert>
    }
    else
    {
        <MudContainer MaxWidth="MaxWidth.Large" Class="organization-profile">
            <!-- Header Section -->
            <div class="organization-profile__header-section mb-6">
                <MudCard Elevation="0" Class="organization-profile__header-card">
                    <div class="organization-profile__banner" style="@_bannerStyle"></div>
                    <div class="organization-profile__header-content">
                        <div class="organization-profile__avatar-wrapper">
                            @if (!string.IsNullOrEmpty(_organization.ActorProfilePictureUri))
                            {
                                <MudImage Src="@_organization.ActorProfilePictureUri"
                                          Alt="@($"{_organization.FullName} Logo")"
                                          Class="organization-profile__avatar-image"
                                          ObjectFit="ObjectFit.Cover" />
                            }
                            else
                            {
                                <MudImage Src="@GetOrganizationPlaceholder()"
                                          Alt="Organization Logo"
                                          Class="organization-profile__avatar-image"
                                          ObjectFit="ObjectFit.Cover" />
                            }
                        </div>

                        <div class="organization-profile__info">
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudText Typo="Typo.h4" Style="font-weight: 700;">@_organization.FullName</MudText>
                                @if (_organization.ApprovalStatusId == 2)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Primary" Title="Verified" Size="Size.Small" />
                                }
                            </div>

                            <div class="d-flex align-center gap-4 mb-4 flex-wrap">
                                <div class="d-flex align-center gap-1">
                                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_organization.City, @_organization.Country</MudText>
                                </div>
                                @if (!string.IsNullOrEmpty(_organization.WebsiteUrl))
                                {
                                    <div class="d-flex align-center gap-1">
                                        <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Small" Color="Color.Secondary" />
                                        <MudLink Href="@_organization.WebsiteUrl" Target="_blank" Typo="Typo.body2" Color="Color.Primary">Website</MudLink>
                                    </div>
                                }
                            </div>

                            <div class="organization-profile__stats d-flex gap-6">
                                <div class="text-center">
                                    <MudText Typo="Typo.h6">@_reviews.Count</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Reviews</MudText>
                                </div>
                                <div class="text-center">
                                    <MudText Typo="Typo.h6">@(_reviews.Any() && _reviews.Any(r => r.Rating.HasValue) ? _reviews.Where(r => r.Rating.HasValue).Average(r => r.Rating!.Value).ToString("0.0") : "-")</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Rating</MudText>
                                </div>
                            </div>
                        </div>
                    </div>
                </MudCard>
            </div>

            <MudGrid>
                <!-- Reviews Column -->
                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.h5" Class="mb-4">Reviews</MudText>
                    @if (_reviews.Any())
                    {
                        <MudStack Spacing="3">
                            @foreach (var review in _reviews.Take(3))
                            {
                                <MudCard Elevation="0" Class="pa-4 border-solid border-1 mud-border-lines-default rounded-lg">
                                    <div class="d-flex justify-space-between align-start mb-2">
                                        <div class="d-flex align-center gap-2">
                                            <MudAvatar Size="Size.Medium" Color="Color.Primary" Variant="Variant.Outlined">
                                                @(string.IsNullOrEmpty(review.UserFullName) ? "?" : review.UserFullName.Substring(0, 1).ToUpper())
                                            </MudAvatar>
                                            <div>
                                                <MudText Typo="Typo.subtitle2">@review.UserFullName</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@(review.CreatedAt?.DateTime.ToShortDateString() ?? "Unknown")</MudText>
                                            </div>
                                        </div>
                                        <MudRating ReadOnly="true" SelectedValue="@(review.Rating ?? 0)" Size="Size.Small" />
                                    </div>
                                    <MudText Typo="Typo.body2">@review.Comment</MudText>
                                </MudCard>
                            }
                        </MudStack>

                        <div class="d-flex justify-center mt-4">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ShowAllReviews">View All Reviews</MudButton>
                        </div>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No reviews yet.</MudAlert>
                    }
                </MudItem>

                <!-- Sidebar Info -->
                <MudItem xs="12" md="4">
                    <MudCard Elevation="0" Class="pa-4 border-solid border-1 mud-border-lines-default rounded-lg">
                        <MudText Typo="Typo.h6" Class="mb-3">About</MudText>
                        <MudList T="string" Dense="true" DisablePadding="true">
                            <MudListItem Icon="@Icons.Material.Filled.Email" IconColor="Color.Primary">
                                <MudText Typo="Typo.body2">@_organization.Email</MudText>
                            </MudListItem>
                            <MudListItem Icon="@Icons.Material.Filled.Work" IconColor="Color.Primary">
                                <MudText Typo="Typo.body2">Religious Organization</MudText>
                            </MudListItem>
                        </MudList>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudContainer>
    }
</MudContainer>
