@page "/organization/profile"
@using MudBlazor

<PageTitle>Organization Profile</PageTitle>

<style>
/* ===== Star Rating Display ===== */
.star-rating {
    display: inline-flex;
    gap: 2px;
    color: #FFC107; /* gold color for stars */
}

.star-rating .mud-icon-root {
    font-size: 1.25rem;
}

/* ===== TOKENS ===== */
:root{
  --ring: color-mix(in srgb, var(--mud-palette-primary) 30%, transparent);
}

/* ===== HERO / HEADER ===== */
.org-hero{
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  background: linear-gradient(135deg, color-mix(in srgb, var(--mud-palette-primary) 18%, #0000), color-mix(in srgb, var(--mud-palette-secondary) 14%, #0000));
  min-height: 140px;
}
.org-hero::after{
  content:""; position:absolute; inset:0;
  background: linear-gradient(180deg, rgba(0,0,0,.05), rgba(0,0,0,.12));
}
.org-header{
  display:flex; gap:18px; align-items:flex-end; padding: 18px; position: relative; z-index: 1;
}
.org-avatar{
  width:120px; height:120px; border-radius: 16px; overflow:hidden;
  border: 2px solid var(--mud-palette-surface);
  box-shadow: 0 10px 26px rgba(0,0,0,.18);
  background: var(--mud-palette-surface);
}

/* ===== NAME + VERIFIED ===== */
.verified{
  display:inline-flex; align-items:center; gap:6px;
  padding:4px 10px; border-radius:999px;
  background: color-mix(in srgb, var(--mud-palette-success) 14%, transparent);
  color: var(--mud-palette-success-text);
  font-weight:600; font-size:.9rem;
}

/* ===== STATS ===== */
.stat-grid{ display:grid; grid-template-columns: repeat(3, 1fr); gap:12px; margin-top: 10px; }
.stat{
  text-align:center; padding:10px 8px; border-radius: 12px;
  background: color-mix(in srgb, var(--mud-palette-primary) 6%, var(--mud-palette-surface));
  border: 1px solid color-mix(in srgb, var(--mud-palette-primary) 18%, var(--mud-palette-lines-default));
}
.stat .num{ color: var(--mud-palette-primary); font-weight: 800; }

/* ===== CARDS ===== */
.section-card{
  border-radius: 16px;
  border: 1px solid color-mix(in srgb, var(--mud-palette-lines-default) 70%, transparent);
  overflow: hidden;
}
.section-body{ padding: 18px; }
.section-body + .section-body{ border-top: 1px solid var(--mud-palette-lines-default); }

/* Info list */
.info-list{ display:grid; gap:10px; }
.info-row{ display:flex; align-items:center; gap:10px; }

/* ===== REVIEWS ===== */
.review{
  border-radius: 14px;
  border: 1px solid color-mix(in srgb, var(--mud-palette-lines-default) 70%, transparent);
  background: color-mix(in srgb, var(--mud-palette-background) 85%, var(--mud-palette-surface));
  transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease;
}
.review:hover{
  transform: translateY(-2px);
  box-shadow: 0 12px 28px rgba(0,0,0,.12);
  border-color: color-mix(in srgb, var(--mud-palette-primary) 35%, var(--mud-palette-lines-default));
}

/* Buttons */
.btn-outline .mud-button-root{
  border-radius: 10px;
}
.btn-outline .mud-button-root:focus-visible{
  box-shadow: 0 0 0 3px var(--ring);
}

/* Responsive */
@@media (max-width: 960px){
  .org-header{ align-items: center; }
  .stat-grid{ grid-template-columns: repeat(3, 1fr); }
}
</style>

<MudContainer Class="py-6">

    <!-- Organization Info (Hero + Header + Stats) -->
    <MudCard Class="mb-6 section-card" Elevation="0">
        <div class="org-hero"></div>

        <MudCardContent Class="section-body" Style="padding-top:0;">
            <div class="org-header">
                <!-- Avatar -->
                <div class="org-avatar">
                    <MudImage Src="https://via.placeholder.com/240x240/2196F3/FFFFFF?text=ORG" Alt="Organization Logo" Style="width:100%; height:100%; object-fit:cover;" />
                </div>

                <!-- Name + Verified + Stats -->
                <div style="flex:1;">
                    <MudText Typo="Typo.h4" Class="mb-1">Muslim Community Center Amsterdam</MudText>
                    <div class="verified">
                        <MudIcon Icon="@Icons.Material.Filled.Verified" />
                        <span>Verified Organization</span>
                    </div>

                    <div class="stat-grid">
                        <div class="stat">
                            <MudText Typo="Typo.h5" Class="num">127</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">reviews</MudText>
                        </div>
                        <div class="stat">
                            <MudText Typo="Typo.h5" Class="num">4.87★</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">overall rating</MudText>
                        </div>
                        <div class="stat">
                            <MudText Typo="Typo.h5" Class="num">8</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">years hosting</MudText>
                        </div>
                    </div>
                </div>
            </div>
        </MudCardContent>
    </MudCard>

    <!-- About Section -->
    <MudCard Class="mb-6 section-card" Elevation="0">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">About the Organization</MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent Class="section-body">
            <div class="info-list">
                <div class="info-row">
                    <MudIcon Icon="@Icons.Material.Filled.Work" Color="Color.Primary" />
                    <MudText Typo="Typo.body1">Organization type: Religious organization</MudText>
                </div>
                <div class="info-row">
                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Primary" />
                    <MudText Typo="Typo.body1">Location: Amsterdam, Netherlands</MudText>
                </div>
                <div class="info-row">
                    <MudIcon Icon="@Icons.Material.Filled.FavoriteBorder" Color="Color.Primary" />
                    <MudText Typo="Typo.body1">Specialties: Community and educational events</MudText>
                </div>
                <div class="info-row">
                    <MudIcon Icon="@Icons.Material.Filled.Favorite" Color="Color.Primary" />
                    <MudText Typo="Typo.body1">What defines us: Building connections in the Muslim community</MudText>
                </div>
            </div>

            <div class="btn-outline">
                <MudButton Variant="Variant.Outlined" Class="mt-4">Show all</MudButton>
            </div>
        </MudCardContent>
    </MudCard>

    <!-- Reviews Section -->
    <MudCard Class="section-card" Elevation="0">
        <MudCardHeader>
            <CardHeaderContent>
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width:100%;">
                    <MudText Typo="Typo.h6">Reviews for this Organization</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary" aria-label="More reviews" />
                </MudStack>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent Class="section-body">
            <MudGrid>
                <!-- Review 1 -->
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4 review" Elevation="0">
                        <MudStack Spacing="2">
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Size="Size.Medium">
                                    <MudImage Src="https://via.placeholder.com/40x40/FF5722/FFFFFF?text=A" Alt="Ahmed"/>
                                </MudAvatar>
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2">Ahmed</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Amsterdam</MudText>
                                </MudStack>
                            </MudStack>

                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                <div class="star-rating">
                                    <MudIcon Icon="@Icons.Material.Filled.Star" />
                                    <MudIcon Icon="@Icons.Material.Filled.Star" />
                                    <MudIcon Icon="@Icons.Material.Filled.Star" />
                                    <MudIcon Icon="@Icons.Material.Filled.Star" />
                                    <MudIcon Icon="@Icons.Material.Filled.Star" />
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">3 days ago</MudText>
                            </MudStack>

                            <MudText Typo="Typo.body2">
                                I attended an excellent event organized by this organization. The welcome was warm and the organization was perfect. The event was very enriching and I was able to meet many wonderful people.
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <!-- Review 2 -->
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4 review" Elevation="0">
                        <MudStack Spacing="2">
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Size="Size.Medium">
                                    <MudImage Src="https://via.placeholder.com/40x40/4CAF50/FFFFFF?text=F" Alt="Fatima"/>
                                </MudAvatar>
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2">Fatima</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Rotterdam</MudText>
                                </MudStack>
                            </MudStack>

                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                <div class="star-rating">
                                    <MudIcon Icon="@Icons.Material.Filled.Star" />
                                    <MudIcon Icon="@Icons.Material.Filled.Star" />
                                    <MudIcon Icon="@Icons.Material.Filled.Star" />
                                    <MudIcon Icon="@Icons.Material.Filled.Star" />
                                    <MudIcon Icon="@Icons.Material.Filled.Star" />
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">1 week ago</MudText>
                            </MudStack>

                            <MudText Typo="Typo.body2">
                                Very professional and welcoming organization. The events are always well prepared and the activities are varied. I highly recommend this organization to the entire community.
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <!-- Review 3 -->
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4 review" Elevation="0">
                        <MudStack Spacing="2">
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Size="Size.Medium">
                                    <MudImage Src="https://via.placeholder.com/40x40/9C27B0/FFFFFF?text=Y" Alt="Yusuf"/>
                                </MudAvatar>
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2">Yusuf</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Den Haag</MudText>
                                </MudStack>
                            </MudStack>

                            <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                                <div class="star-rating">
                                    <MudIcon Icon="@Icons.Material.Filled.Star" />
                                    <MudIcon Icon="@Icons.Material.Filled.Star" />
                                    <MudIcon Icon="@Icons.Material.Filled.Star" />
                                    <MudIcon Icon="@Icons.Material.Filled.Star" />
                                    <MudIcon Icon="@Icons.Material.Outlined.StarBorder" />
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">2 weeks ago</MudText>
                            </MudStack>

                            <MudText Typo="Typo.body2">
                                Excellent organization that does remarkable work to bring together the community. The events are high quality and the atmosphere is always friendly. Thank you for everything you do!
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <div class="btn-outline" style="display:flex; justify-content:center;">
                <MudButton Variant="Variant.Outlined" Class="mt-6" StartIcon="@Icons.Material.Filled.RateReview">
                    Show more reviews
                </MudButton>
            </div>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private int review1Rating = 5;
    private int review2Rating = 5;
    private int review3Rating = 4;
}
