@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Models.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using Microsoft.AspNetCore.Components
@using Blazouter.Services
@using Microsoft.Extensions.Logging
@inject IOrganizationService OrganizationService
@inject IOrganizationMemberService MemberService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject RouterStateService RouterState
@inject ILogger<OrganizationDetails> Logger
@attribute [Authorize]

<PageTitle>Organization Details</PageTitle>

@if (isLoading)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="organization-details organization-details--loading">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Typo="Typo.h6" Class="mt-4">Loading organization...</MudText>
    </MudContainer>
}
else if (organization == null)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="organization-details organization-details--error">
        <MudAlert Severity="Severity.Error">Organization not found.</MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => NavigationManager.NavigateTo("/organization/my"))" Class="mt-4">
            Back to My Organizations
        </MudButton>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="organization-details">
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Primary"
                   Variant="Variant.Text"
                   OnClick="@(() => NavigationManager.NavigateTo("/organization/my"))"
                   Class="mb-4">
            Back to List
        </MudButton>

        <MudCard Elevation="3" Class="pa-2">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Primary" Size="Size.Large" Variant="Variant.Filled">
                        @organization.FullName.Substring(0, 1).ToUpper()
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <div class="d-flex align-center gap-2 flex-wrap">
                        <MudText Typo="Typo.h4" Class="mr-2">@organization.FullName</MudText>
                        <MudChip T="string" Color="@GetStatusColor(organization.ApprovalStatusId)" Size="Size.Small" Variant="Variant.Outlined">
                            @(organization.ApprovalStatusFullName ?? "Pending")
                        </MudChip>
                    </div>
                </CardHeaderContent>
                <CardHeaderActions>
                    @if (canEdit && !isEditMode)
                    {
                        <MudTooltip Text="Create Event">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.Event"
                                       Size="Size.Small"
                                       OnClick="@(() => NavigationManager.NavigateTo($"/organization/{Id}/create-event"))"
                                       Class="mr-2">
                                Create Event
                            </MudButton>
                        </MudTooltip>
                        <MudTooltip Text="Manage Members">
                            <MudIconButton Icon="@Icons.Material.Filled.People"
                                           Color="Color.Secondary"
                                           OnClick="@(() => NavigationManager.NavigateTo($"/organization/{Id}/members"))" />
                        </MudTooltip>
                        <MudTooltip Text="Edit Organization">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           OnClick="ToggleEditMode" />
                        </MudTooltip>
                    }
                    else if (canEdit && isEditMode)
                    {
                         <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   OnClick="ToggleEditMode"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   Size="Size.Small">
                            Cancel
                        </MudButton>
                    }
                </CardHeaderActions>
            </MudCardHeader>

            <MudDivider Class="my-2" />

            <MudCardContent>
                @if (!isEditMode)
                {
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudList T="string" Dense="true" DisablePadding="true">
                                <MudListItem Icon="@Icons.Material.Filled.Email" IconColor="Color.Primary">
                                    <div class="d-flex flex-column">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Email</MudText>
                                        <MudText Typo="Typo.body1">@organization.Email</MudText>
                                    </div>
                                </MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.Language" IconColor="Color.Primary">
                                    <div class="d-flex flex-column">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Website</MudText>
                                        @if (!string.IsNullOrEmpty(organization.WebsiteUrl))
                                        {
                                            <MudLink Href="@organization.WebsiteUrl" Target="_blank" Typo="Typo.body1">@organization.WebsiteUrl</MudLink>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.body1" Class="mud-text-secondary">Not provided</MudText>
                                        }
                                    </div>
                                </MudListItem>
                            </MudList>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudList T="string" Dense="true" DisablePadding="true">
                                <MudListItem Icon="@Icons.Material.Filled.LocationOn" IconColor="Color.Primary">
                                    <div class="d-flex flex-column">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Address</MudText>
                                        <MudText Typo="Typo.body1">@organization.Address</MudText>
                                        <MudText Typo="Typo.body1">@organization.Postcode @organization.City</MudText>
                                        <MudText Typo="Typo.body1">@organization.Country</MudText>
                                    </div>
                                </MudListItem>
                            </MudList>
                        </MudItem>
                    </MudGrid>
                }
                else
                {
                    <!-- Edit Form -->
                    <MudForm @ref="form" @bind-IsValid="@formValid">
                        <MudGrid>
                            <MudItem xs="12">
                                <MudTextField @bind-Value="editModel.FullName"
                                              Label="Organization Name"
                                              Variant="Variant.Outlined"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Business"
                                              Required="true"
                                              RequiredError="Organization name is required" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="editModel.Email"
                                              Label="Email"
                                              Variant="Variant.Outlined"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Email"
                                              Required="true"
                                              RequiredError="Email is required"
                                              Validation="@(new Func<string, string>(ValidateEmail))" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="editModel.WebsiteUrl"
                                              Label="Website (Optional)"
                                              Variant="Variant.Outlined"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Language" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2" Color="Color.Primary">Location Details</MudText>
                                <MudDivider Class="mb-4"/>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="editModel.Address"
                                              Label="Address"
                                              Variant="Variant.Outlined"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Home"
                                              Required="true"
                                              RequiredError="Address is required" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="editModel.Postcode"
                                                 Label="Postcode"
                                                 Variant="Variant.Outlined"
                                                 Adornment="Adornment.Start"
                                                 AdornmentIcon="@Icons.Material.Filled.MarkunreadMailbox"
                                                 Required="true"
                                                 RequiredError="Postcode is required"
                                                 Min="1000"
                                                 Max="99999" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="editModel.City"
                                              Label="City"
                                              Variant="Variant.Outlined"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.LocationCity"
                                              Required="true"
                                              RequiredError="City is required" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="editModel.Country"
                                              Label="Country"
                                              Variant="Variant.Outlined"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Public"
                                              Required="true"
                                              RequiredError="Country is required" />
                            </MudItem>

                            <MudItem xs="12" Class="d-flex justify-end gap-2 mt-4">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           OnClick="SaveChanges"
                                           StartIcon="@Icons.Material.Filled.Save"
                                           Disabled="!formValid || isSaving">
                                    @if (isSaving)
                                    {
                                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                                        <span>Saving...</span>
                                    }
                                    else
                                    {
                                        <span>Save Changes</span>
                                    }
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudForm>
                }
            </MudCardContent>
        </MudCard>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4" CloseIconClicked="@(() => errorMessage = string.Empty)" ShowCloseIcon="true">
                @errorMessage
            </MudAlert>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <MudAlert Severity="Severity.Success" Class="mt-4" CloseIconClicked="@(() => successMessage = string.Empty)" ShowCloseIcon="true">
                @successMessage
            </MudAlert>
        }
    </MudContainer>
}

@code {
    private Guid Id { get; set; }

    private OrganizationDto? organization;
    private UpdateOrganizationDto editModel = new();
    private MudForm? form;
    private bool formValid;
    private bool isLoading = true;
    private bool isEditMode = false;
    private bool isSaving = false;
    private bool canEdit = false;
    private string? errorMessage;
    private string? successMessage;
    private string? currentUserId;
    private int? currentUserRole;

    protected override async Task OnInitializedAsync()
    {
        // Get route parameter from Blazouter
        var idStr = RouterState.GetParam("id");
        if (Guid.TryParse(idStr, out var id))
        {
            Id = id;
        }

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            currentUserId = user.FindFirst("sub")?.Value;
            await LoadOrganization();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading organization");
            errorMessage = "Failed to load organization details.";
            isLoading = false;
        }
    }

    private void InitializeEditModel()
    {
        if (organization != null)
        {
            editModel = new UpdateOrganizationDto
            {
                FullName = organization.FullName,
                Email = organization.Email,
                WebsiteUrl = organization.WebsiteUrl,
                Country = organization.Country,
                City = organization.City,
                Postcode = int.TryParse(organization.Postcode, out var pc) ? pc : 0,
                Address = organization.Address
            };
        }
    }

    private async Task CheckEditPermissions()
    {
        if (organization != null && !string.IsNullOrEmpty(currentUserId))
        {
            try
            {
                var members = await MemberService.GetMembersAsync(Id);
                var me = members.FirstOrDefault(m => m.UserId.ToString() == currentUserId);
                if (me != null)
                {
                    currentUserRole = me.OrganizationRoleId;
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Error loading members for permission check");
            }

            canEdit = currentUserRole == 1 || currentUserRole == 2 || currentUserRole == 3;
        }
    }

    private async Task LoadOrganization()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            Logger.LogDebug("Loading organization {OrganizationId}", Id);
            organization = await OrganizationService.GetOrganizationByIdAsync(Id);

            if (organization != null)
            {
                Logger.LogDebug("Loaded organization: {OrganizationName}", organization.FullName);
                await CheckEditPermissions();
                InitializeEditModel();
            }
            else
            {
                errorMessage = "Organization not found.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load organization: {ex.Message}";
            Logger.LogError(ex, "Failed to load organization {OrganizationId}", Id);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleEditMode()
    {
        if (isEditMode && organization != null)
        {
            // Revert changes
            editModel = new UpdateOrganizationDto
            {
                FullName = organization.FullName,
                Email = organization.Email,
                WebsiteUrl = organization.WebsiteUrl,
                Country = organization.Country,
                City = organization.City,
                Postcode = int.TryParse(organization.Postcode, out var pc) ? pc : 0,
                Address = organization.Address
            };
        }

        isEditMode = !isEditMode;
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private void CancelEdit()
    {
        ToggleEditMode();
    }

    private async Task SaveChanges()
    {
        if (!formValid) return;

        try
        {
            isSaving = true;
            errorMessage = string.Empty;
            successMessage = string.Empty;

            var success = await OrganizationService.UpdateOrganizationAsync(Id, editModel!);

            if (success != null && success.Success)
            {
                successMessage = "Organization updated successfully!";
                isEditMode = false;
                await LoadOrganization(); // Reload to show updated data
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating organization {OrganizationId}", Id);
            errorMessage = $"Failed to update organization: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private string? ValidateEmail(string email)
    {
        if (string.IsNullOrEmpty(email))
            return "Email is required";

        if (!email.Contains("@"))
            return "Invalid email format";

        return null;
    }

    private Color GetStatusColor(int statusTypeId)
    {
        return statusTypeId switch
        {
            1 => Color.Warning,  // Pending
            2 => Color.Success,  // Approved
            3 => Color.Error,    // Rejected
            _ => Color.Default
        };
    }
}
