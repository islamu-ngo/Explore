@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services
@using Microsoft.Extensions.Logging
@inject NavigationManager NavigationManager
@inject IOrganizationService OrganizationService
@inject ILogger<CreateOrganization> Logger

<PageTitle>Create Organization</PageTitle>
<MudContainer Class="create-organization">
    <MudCard Class="mx-auto" Style="max-width: 900px;">
        <MudCardHeader>
            <CardHeaderContent>
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="Icons.Material.Filled.Business" Size="Size.Large" Color="Color.Primary" />
                    <div>
                        <MudText Typo="Typo.h4">Create Organization</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Create your organization to start hosting events. All information will be reviewed by our admin team.
                        </MudText>
                    </div>
                </MudStack>
            </CardHeaderContent>
        </MudCardHeader>

        <div class="create-organization__stepper">
            <div class="create-organization__step-container">
                <div class="create-organization__step-line">
                    <div class="create-organization__step-progress" style="width: @GetProgressWidth()"></div>
                </div>

                @foreach (var stepInfo in steps)
                {
                    <div class="create-organization__step @GetStepClass(stepInfo.Step)">
                        <div class="create-organization__step-circle">
                            @if (IsStepCompleted(stepInfo.Step))
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            }
                            else
                            {
                                @(stepInfo.Step + 1)
                            }
                        </div>
                        <div class="create-organization__step-title">@stepInfo.Title</div>
                    </div>
                }
            </div>
        </div>

        <MudCardContent>
            <EditForm Model="organization">
                @switch (currentStep)
                {
                    case 0:
                        <MudPaper Class="pa-4 mb-6" Style="background-color: var(--mud-palette-background-grey);">
                            <MudText Typo="Typo.h6" Class="mb-3">Organization Logo</MudText>
                            <MudText Typo="Typo.body2" Class="mb-2 mud-text-secondary">
                                Logo upload will be available after organization creation.
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(logoPreview))
                            {
                                <img src="@logoPreview" alt="Logo preview" style="width: 120px; height: 120px; object-fit: cover;" />
                            }
                        </MudPaper>

                        <MudText Typo="Typo.h6" Class="mb-4">
                            <MudIcon Icon="Icons.Material.Filled.Info" Class="mr-2" />
                            Basic Information
                        </MudText>

                        <MudGrid Class="mb-6">
                            <MudItem xs="12">
                                <MudTextField @bind-Value="organization.FullName"
                                              Label="Organization Name"
                                              Variant="Variant.Outlined"
                                              Required
                                              HelperText="Enter the official name of your organization"
                                              Counter="100" MaxLength="100"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Business" />
                            </MudItem>

                            <MudItem xs="12">
                                <MudTextField @bind-Value="organization.WebsiteUrl"
                                              Label="Website URL"
                                              Variant="Variant.Outlined"
                                              HelperText="Organization website (optional)"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Language" />
                            </MudItem>
                        </MudGrid>


                        break;

                    case 1:
                        <MudText Typo="Typo.h6" Class="mb-4">
                            <MudIcon Icon="Icons.Material.Filled.ContactMail" Class="mr-2" />
                            Contact Information
                        </MudText>

                        <MudGrid Class="mb-6">
                            <MudItem xs="12">
                                <MudTextField @bind-Value="organization.Email"
                                              Label="Contact Email"
                                              Variant="Variant.Outlined"
                                              InputType="InputType.Email" Required
                                              HelperText="Primary contact email for the organization"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Email" />
                            </MudItem>
                        </MudGrid>

                        <MudText Typo="Typo.h6" Class="mb-4">
                            <MudIcon Icon="Icons.Material.Filled.LocationOn" Class="mr-2" />
                            Address Information
                        </MudText>

                        <MudGrid Class="mb-6">
                            <MudItem xs="12">
                                <MudTextField @bind-Value="organization.Address"
                                              Label="Street Address"
                                              Variant="Variant.Outlined" Required
                                              HelperText="Complete street address"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Home" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudNumericField @bind-Value="organization.Postcode"
                                                 Label="Postal Code"
                                                 Variant="Variant.Outlined"
                                                 HelperText="Postal/ZIP code"
                                                 Required
                                                 Min="0" Max="99999"
                                                 Adornment="Adornment.Start"
                                                 AdornmentIcon="@Icons.Material.Filled.Pin" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="organization.City"
                                              Label="City"
                                              Variant="Variant.Outlined" Required
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.LocationCity" />
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudSelect @bind-Value="organization.Country"
                                           Label="Country" Variant="Variant.Outlined" Required>
                                    <MudSelectItem Value="@("Netherlands")">Netherlands</MudSelectItem>
                                    <MudSelectItem Value="@("Belgium")">Belgium</MudSelectItem>
                                    <MudSelectItem Value="@("Germany")">Germany</MudSelectItem>
                                    <MudSelectItem Value="@("France")">France</MudSelectItem>
                                    <MudSelectItem Value="@("United Kingdom")">United Kingdom</MudSelectItem>
                                    <MudSelectItem Value="@("Spain")">Spain</MudSelectItem>
                                    <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                        break;

                    case 2:
                        <MudText Typo="Typo.h6" Class="mb-4">Review Your Information</MudText>

                        <MudPaper Class="pa-4 mb-4" Style="background: var(--mud-palette-background-grey);">
                            <MudText Typo="Typo.subtitle1" Class="mb-3">Logo</MudText>
                            @if (!string.IsNullOrWhiteSpace(logoPreview))
                            {
                                <MudStack Row AlignItems="AlignItems.Center" Spacing="3">
                                    <MudImage Src="@logoPreview"
                                              Alt="Organization Logo"
                                              Style="width: 120px; height: 120px; object-fit: cover; border-radius: 8px;" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        This will be the logo used for your organization.
                                    </MudText>
                                </MudStack>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No logo uploaded yet.</MudText>
                            }
                        </MudPaper>

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-4">
                                @errorMessage
                            </MudAlert>
                        }

                        @if (submitSuccess)
                        {
                            <MudAlert Severity="Severity.Success" Class="mb-4">
                                <MudText><b>Succes!</b> Uw organisatie is succesvol ingediend voor review.</MudText>
                            </MudAlert>
                        }

                        <MudPaper Class="pa-4 mb-4" Style="background: var(--mud-palette-background-grey);">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle1">Organization Information</MudText>
                                <MudText><b>Name:</b> @organization.FullName</MudText>
                                <MudText><b>Website:</b> @(string.IsNullOrWhiteSpace(organization.WebsiteUrl) ? "-" : organization.WebsiteUrl)</MudText>
                                <MudText><b>Email:</b> @organization.Email</MudText>
                                <MudText><b>Address:</b> @organization.Address, @organization.Postcode @organization.City, @organization.Country</MudText>
                            </MudStack>
                        </MudPaper>

                        <MudAlert Severity="Severity.Info" Class="mb-4">
                            <MudCheckBox @bind-Value="acceptTerms"
                                         Color="Color.Primary"
                                         Label="I agree to the Terms and Conditions for Organization Creators" />

                            @if (!acceptTerms)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Error" Class="ml-8 mt-2">
                                    U moet akkoord gaan met de voorwaarden om verder te gaan.
                                </MudText>
                            }

                            <MudCheckBox @bind-Value="confirmInformation"
                                         Color="Color.Primary"
                                         Class="mt-2"
                                         Label="I confirm that all provided information is accurate and up-to-date" />
                        </MudAlert>

                        <MudAlert Severity="Severity.Info" Class="mb-4">
                            <MudText Typo="Typo.body2">
                                <strong>Review Process:</strong><br />
                                • Your organization request will be submitted for admin review<br />
                                • We'll verify your company registration and contact information<br />
                                • You'll receive an email notification within 3-5 business days<br />
                                • Once approved, you can start creating and managing events
                            </MudText>
                        </MudAlert>
                        break;
                }
            </EditForm>
        </MudCardContent>

        <MudCardActions Class="justify-space-between pa-4">
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(async () => await (currentStep == 0 ? GoBack() : GoToPreviousStep()))"
                       Disabled="@(currentStep == 0)">
                @(currentStep == 0 ? "Cancel" : "Previous")
            </MudButton>

            @if (currentStep < 2)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           EndIcon="@Icons.Material.Filled.ArrowForward"
                           OnClick="@(async () => await GoToNextStep())">
                    Next
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Send"
                           OnClick="@(async () => await HandleSubmit())"
                           Disabled="@(!CanSubmit() || isSubmitting)">
                    @if (isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate />
                        <span class="ml-2">Submitting...</span>
                    }
                    else
                    {
                        <span>Submit for Review</span>
                    }
                </MudButton>
            }
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    // Organization data for the API
    private CreateOrganizationDto organization = new();
    private bool acceptTerms = false;
    private bool confirmInformation = false;
    private bool isSubmitting = false;
    private string logoPreview = string.Empty;
    private int currentStep = 0;

    // Extra velden die niet in de API zitten maar wel in de UI
    // (Geen extra velden nodig - alle velden komen uit de database)

    // API response handling
    private bool submitSuccess = false;
    private string errorMessage = string.Empty;

    private class StepInfo
    {
        public int Step { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
    }

    private readonly StepInfo[] steps = new[]
    {
        new StepInfo { Step = 0, Title = "Basic Information", Icon = Icons.Material.Filled.Edit },
        new StepInfo { Step = 1, Title = "Contact & Address",  Icon = Icons.Material.Filled.Description },
        new StepInfo { Step = 2, Title = "Review & Submit",    Icon = Icons.Material.Filled.Done }
    };

    private string GetStepClass(int step)
    {
        if (step < currentStep) return "completed";
        if (step == currentStep) return "active";
        return "";
    }

    private bool IsStepCompleted(int step) => step < currentStep;

    private string GetProgressWidth() => currentStep switch
    {
        0 => "0%",
        1 => "50%",
        2 => "100%",
        _ => "0%"
    };

    private Task GoToNextStep()
    {
        // Stap-validatie: controleer verplichte velden stap per stap
        if (currentStep == 0)
        {
            if (string.IsNullOrWhiteSpace(organization.FullName))
            {
                errorMessage = "Vul de organisatienaam in.";
                return Task.CompletedTask;
            }
        }
        else if (currentStep == 1)
        {
            if (string.IsNullOrWhiteSpace(organization.Email)
                || string.IsNullOrWhiteSpace(organization.Address)
                || string.IsNullOrWhiteSpace(organization.City)
                || string.IsNullOrWhiteSpace(organization.Country)
                || organization.Postcode <= 0)
            {
                errorMessage = "Vul alle vereiste velden in.";
                return Task.CompletedTask;
            }
        }

        errorMessage = string.Empty;
        if (currentStep < steps.Length - 1) currentStep++;
        return Task.CompletedTask;
    }

    private Task GoToPreviousStep()
    {
        if (currentStep > 0)
        {
            currentStep--;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    // Voeg een succespagina toe voor het resultaat
    protected override async Task OnInitializedAsync()
    {
        // Initialiseer de organisatie met standaard waarden
        organization = new CreateOrganizationDto();
        await base.OnInitializedAsync();
    }

    private async Task HandleSubmit()
    {
        if (!CanSubmit()) return;

        isSubmitting = true;
        errorMessage = string.Empty;

        try
        {
            // Roep de API aan om de organisatie te maken
            var createdOrganization = await OrganizationService.CreateOrganizationAsync(organization);

            if (createdOrganization != null)
            {
                submitSuccess = true;
                Logger.LogInformation("Organization successfully created with ID: {OrganizationId}", createdOrganization.Id);

                // Wacht een moment en navigeer naar een succespagina
                await Task.Delay(1500);
                NavigationManager.NavigateTo("/organization/success");
            }
            else
            {
                errorMessage = "Er is een fout opgetreden bij het aanmaken van de organisatie. Probeer het opnieuw.";
                Logger.LogWarning("API returned null for organization creation");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Fout bij het aanmaken van de organisatie: {ex.Message}";
            Logger.LogError(ex, "Exception during organization creation");
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    // Logo handling is now done by the ImageUpload component
    // These methods can be removed or kept for backward compatibility
    private async Task OnLogoSelected(IBrowserFile? file)
    {
        // This is now handled by ImageUpload component
        // Kept for backward compatibility if needed
    }

    private Task RemoveLogo()
    {
        // This is now handled by ImageUpload component
        logoPreview = string.Empty;
        return Task.CompletedTask;
    }

    private async Task GoBack()
    {
        if (currentStep == 0)
            NavigationManager.NavigateTo("/");
        else
            await GoToPreviousStep();
    }

    private bool CanSubmit()
    {
        return acceptTerms &&
               confirmInformation &&
               !string.IsNullOrWhiteSpace(organization.FullName) &&
               !string.IsNullOrWhiteSpace(organization.Email) &&
               !string.IsNullOrWhiteSpace(organization.Address) &&
               !string.IsNullOrWhiteSpace(organization.City) &&
               !string.IsNullOrWhiteSpace(organization.Country) &&
               organization.Postcode > 0;
    }

    private void OnLogoImageKeyChanged(string? value)
    {
        // Logo will be handled after organization creation
        logoPreview = value ?? string.Empty;
    }

    private void OnLogoPreviewUrlChanged(string? value)
    {
        logoPreview = value ?? string.Empty;
    }
}
