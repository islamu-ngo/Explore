@page "/organization/create"
@using MudBlazor

<PageTitle>Create Organization</PageTitle>

<MudContainer Class="py-6">
    <MudCard Class="mx-auto" Style="max-width: 900px;">
        <MudCardHeader>
            <CardHeaderContent>
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="Icons.Material.Filled.Business" Size="Size.Large" Color="Color.Primary"/>
                    <div>
                        <MudText Typo="Typo.h4">Create Organization</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Create your organization to start hosting events. All information will be reviewed by our admin team.
                        </MudText>
                    </div>
                </MudStack>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            <EditForm Model="organization" OnValidSubmit="HandleSubmit">
                
                <!-- Logo Upload Section -->
                <MudPaper Class="pa-4 mb-6" Style="background-color: var(--mud-palette-background-grey);">
                    <MudText Typo="Typo.h6" Class="mb-3">Organization Logo</MudText>
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="4">
                        <div style="width: 120px; height: 120px; border: 2px dashed var(--mud-palette-lines-default); border-radius: 8px; display: flex; align-items: center; justify-content: center; background-color: var(--mud-palette-surface);">
                            @if (!string.IsNullOrEmpty(logoPreview))
                            {
                                <MudImage Src="@logoPreview" Alt="Logo Preview" Style="width: 100%; height: 100%; object-fit: cover; border-radius: 6px;"/>
                            }
                            else
                            {
                                <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="Icons.Material.Filled.Business" Size="Size.Large" Color="Color.Secondary"/>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">No logo</MudText>
                                </MudStack>
                            }
                        </div>
                        <MudStack Spacing="2">
                            <MudFileUpload T="IBrowserFile" FilesChanged="OnLogoSelected" Accept=".jpg,.jpeg,.png,.gif">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Outlined" 
                                             StartIcon="Icons.Material.Filled.CloudUpload"
                                             Color="Color.Primary">
                                        Upload Logo
                                    </MudButton>
                                </ActivatorContent>
                            </MudFileUpload>
                            @if (!string.IsNullOrEmpty(logoPreview))
                            {
                                <MudButton Variant="Variant.Text" 
                                         Color="Color.Error" 
                                         Size="Size.Small" 
                                         OnClick="RemoveLogo"
                                         StartIcon="Icons.Material.Filled.Delete">
                                    Remove Logo
                                </MudButton>
                            }
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Supported formats: JPG, PNG, GIF (Max 2MB)
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                <!-- Basic Information -->
                <MudText Typo="Typo.h6" Class="mb-4">
                    <MudIcon Icon="Icons.Material.Filled.Info" Class="mr-2"/>
                    Basic Information
                </MudText>
                
                <MudGrid Class="mb-6">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="organization.Name" 
                                    Label="Organization Name" 
                                    Variant="Variant.Outlined"
                                    Required 
                                    HelperText="Enter the official name of your organization"
                                    Counter="100" 
                                    MaxLength="100"
                                    StartAdornment="Icons.Material.Filled.Business"/>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="organization.Description" 
                                    Label="Description" 
                                    Variant="Variant.Outlined"
                                    Lines="4" 
                                    Required
                                    HelperText="Describe your organization's mission, goals and activities"
                                    Counter="500" 
                                    MaxLength="500"/>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="organization.CompanyRegistrationNumber" 
                                    Label="Company Registration Number" 
                                    Variant="Variant.Outlined"
                                    Required
                                    HelperText="Official company registration number"
                                    StartAdornment="Icons.Material.Filled.Numbers"/>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect @bind-Value="organization.OrganizationType" 
                                 Label="Organization Type" 
                                 Variant="Variant.Outlined"
                                 Required>
                            <MudSelectItem Value="@("Non-Profit")">Non-Profit Organization</MudSelectItem>
                            <MudSelectItem Value="@("Religious")">Religious Organization</MudSelectItem>
                            <MudSelectItem Value="@("Educational")">Educational Institution</MudSelectItem>
                            <MudSelectItem Value="@("Community")">Community Group</MudSelectItem>
                            <MudSelectItem Value="@("Cultural")">Cultural Association</MudSelectItem>
                            <MudSelectItem Value="@("Charity")">Charity</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <!-- Contact Information -->
                <MudText Typo="Typo.h6" Class="mb-4">
                    <MudIcon Icon="Icons.Material.Filled.ContactMail" Class="mr-2"/>
                    Contact Information
                </MudText>
                
                <MudGrid Class="mb-6">
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="organization.ContactEmail" 
                                    Label="Contact Email" 
                                    Variant="Variant.Outlined"
                                    InputType="InputType.Email"
                                    Required
                                    HelperText="Primary contact email for the organization"
                                    StartAdornment="Icons.Material.Filled.Email"/>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="organization.ContactPhone" 
                                    Label="Contact Phone"
                                    Variant="Variant.Outlined"
                                    HelperText="Phone number (optional)"
                                    StartAdornment="Icons.Material.Filled.Phone"/>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="organization.Website" 
                                    Label="Website"
                                    Variant="Variant.Outlined"
                                    HelperText="Organization website (optional)"
                                    StartAdornment="Icons.Material.Filled.Language"/>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="organization.SocialMedia" 
                                    Label="Social Media"
                                    Variant="Variant.Outlined"
                                    HelperText="Main social media handle (optional)"
                                    StartAdornment="Icons.Material.Filled.Share"/>
                    </MudItem>
                </MudGrid>

                <!-- Address Information -->
                <MudText Typo="Typo.h6" Class="mb-4">
                    <MudIcon Icon="Icons.Material.Filled.LocationOn" Class="mr-2"/>
                    Address Information
                </MudText>
                
                <MudGrid Class="mb-6">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="organization.Address" 
                                    Label="Street Address"
                                    Variant="Variant.Outlined"
                                    Required
                                    HelperText="Complete street address including house number"
                                    StartAdornment="Icons.Material.Filled.Home"/>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="organization.PostalCode" 
                                    Label="Postal Code"
                                    Variant="Variant.Outlined"
                                    Required
                                    HelperText="Postal/ZIP code"
                                    StartAdornment="Icons.Material.Filled.Pin"/>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="organization.City" 
                                    Label="City"
                                    Variant="Variant.Outlined"
                                    Required
                                    StartAdornment="Icons.Material.Filled.LocationCity"/>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudSelect @bind-Value="organization.Country" 
                                 Label="Country" 
                                 Variant="Variant.Outlined"
                                 Required>
                            <MudSelectItem Value="@("Netherlands")">Netherlands</MudSelectItem>
                            <MudSelectItem Value="@("Belgium")">Belgium</MudSelectItem>
                            <MudSelectItem Value="@("Germany")">Germany</MudSelectItem>
                            <MudSelectItem Value="@("France")">France</MudSelectItem>
                            <MudSelectItem Value="@("United Kingdom")">United Kingdom</MudSelectItem>
                            <MudSelectItem Value="@("Spain")">Spain</MudSelectItem>
                            <MudSelectItem Value="@("Other")">Other</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <!-- Additional Information -->
                <MudText Typo="Typo.h6" Class="mb-4">
                    <MudIcon Icon="Icons.Material.Filled.Assignment" Class="mr-2"/>
                    Additional Information
                </MudText>
                
                <MudGrid Class="mb-6">
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="organization.EstablishedYear" 
                                       Label="Established Year"
                                       Variant="Variant.Outlined"
                                       Min="1800" 
                                       Max="2025"
                                       HelperText="Year the organization was established"
                                       StartAdornment="Icons.Material.Filled.CalendarToday"/>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="organization.MemberCount" 
                                       Label="Number of Members"
                                       Variant="Variant.Outlined"
                                       Min="1"
                                       HelperText="Approximate number of active members"
                                       StartAdornment="Icons.Material.Filled.Groups"/>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="organization.AdditionalNotes" 
                                    Label="Additional Notes"
                                    Variant="Variant.Outlined"
                                    Lines="3"
                                    HelperText="Any additional information you'd like to share (optional)"
                                    Counter="300" 
                                    MaxLength="300"/>
                    </MudItem>
                </MudGrid>

                <!-- Terms and Conditions -->
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    <MudCheckBox @bind-Value="acceptTerms" 
                               Color="Color.Primary"
                               Label="I agree to the Terms and Conditions for Organization Creators"/>

                    @if (!acceptTerms)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error" Class="ml-8 mt-2">
                            You must accept the terms and conditions to continue
                        </MudText>
                    }

                    <MudCheckBox @bind-Value="confirmInformation" 
                               Color="Color.Primary"
                               Class="mt-2"
                               Label="I confirm that all provided information is accurate and up-to-date"/>
                </MudAlert>

                <!-- Review Process Information -->
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    <MudText Typo="Typo.body2">
                        <strong>Review Process:</strong><br/>
                        • Your organization request will be submitted for admin review<br/>
                        • We'll verify your company registration and contact information<br/>
                        • You'll receive an email notification within 3-5 business days<br/>
                        • Once approved, you can start creating and managing events
                    </MudText>
                </MudAlert>

            </EditForm>
        </MudCardContent>

        <MudCardActions Class="justify-space-between pa-4">
            <MudButton Variant="Variant.Text" 
                     StartIcon="Icons.Material.Filled.ArrowBack"
                     OnClick="@(() => GoBack())">
                Back
            </MudButton>
            
            <MudButton Variant="Variant.Filled" 
                     Color="Color.Primary" 
                     StartIcon="Icons.Material.Filled.Send"
                     OnClick="HandleSubmit"
                     Disabled="@(!CanSubmit() || isSubmitting)">
                    @if (isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate/>
                        <span class="ml-2">Submitting...</span>
                    }
                    else
                    {
                        <span>Submit for Review</span>
                    }
                </MudButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    private Organization organization = new();
    private bool acceptTerms = false;
    private bool confirmInformation = false;
    private bool isSubmitting = false;
    private string logoPreview = string.Empty;

    public class Organization
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string CompanyRegistrationNumber { get; set; } = string.Empty;
        public string OrganizationType { get; set; } = string.Empty;
        public string ContactEmail { get; set; } = string.Empty;
        public string ContactPhone { get; set; } = string.Empty;
        public string Website { get; set; } = string.Empty;
        public string SocialMedia { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
        public string PostalCode { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string Country { get; set; } = string.Empty;
        public int? EstablishedYear { get; set; }
        public int? MemberCount { get; set; }
        public string AdditionalNotes { get; set; } = string.Empty;
        public string LogoUrl { get; set; } = string.Empty;
    }

    private async Task HandleSubmit()
    {
        if (!CanSubmit()) return;

        isSubmitting = true;
        try
        {
            // Simulate API call
            await Task.Delay(2000);
            
            // Show success message (placeholder)
            // In real implementation, this would call the API
            Console.WriteLine("Organization submitted for review!");
            
            // Navigate to success page or show confirmation
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error submitting organization: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task OnLogoSelected(IBrowserFile? file)
    {
        if (file != null)
        {
            if (file.Size > 2 * 1024 * 1024) // 2MB
            {
                Console.WriteLine("File size must be less than 2MB");
                return;
            }

            var allowedTypes = new[] { "image/jpeg", "image/png", "image/gif" };
            if (!allowedTypes.Contains(file.ContentType))
            {
                Console.WriteLine("Only JPG, PNG, and GIF files are allowed");
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            
            var base64 = Convert.ToBase64String(memoryStream.ToArray());
            logoPreview = $"data:{file.ContentType};base64,{base64}";
            organization.LogoUrl = logoPreview;
        }
    }

    private void RemoveLogo()
    {
        logoPreview = string.Empty;
        organization.LogoUrl = string.Empty;
    }

    private void GoBack()
    {
        // Navigate back to previous page
        Console.WriteLine("Going back...");
    }

    private bool CanSubmit()
    {
        return acceptTerms && 
               confirmInformation && 
               !string.IsNullOrWhiteSpace(organization.Name) &&
               !string.IsNullOrWhiteSpace(organization.Description) &&
               !string.IsNullOrWhiteSpace(organization.CompanyRegistrationNumber) &&
               !string.IsNullOrWhiteSpace(organization.ContactEmail) &&
               !string.IsNullOrWhiteSpace(organization.Address) &&
               !string.IsNullOrWhiteSpace(organization.City) &&
               !string.IsNullOrWhiteSpace(organization.Country);
    }
}