@page "/onboarding/tenant"
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@layout SetupLayout
@attribute [Authorize]
@rendermode InteractiveServer
@inject ITenantOnboardingService TenantOnboardingService
@inject IUserService UserService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Tenant Onboarding</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">Tenant Onboarding</MudText>
        <MudText Typo="Typo.body1" Class="mb-4">
            Configure tenant-level policies for submissions, moderation, and organization verification.
        </MudText>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        @if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        }
        else if (!_canEdit)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                You are authenticated but do not have tenant administrator permissions for this tenant.
            </MudAlert>
            <AppButton Href="/events">
                Go to Events
            </AppButton>
        }
        else
        {
            <MudStack Spacing="3">
                <MudText Typo="Typo.caption" Class="mb-1">Fields marked "(Required)" must be provided before completing onboarding.</MudText>

                @{
                    bool hasLocks = !_model.CanTenantOmitVerification || 
                                    !_model.CanOverrideHomePagePreference ||
                                    !_model.CanOverrideEventCardClickBehavior ||
                                    !_model.CanOverrideSubdomain ||
                                    !_model.CanOverrideCustomDomain ||
                                    !_model.CanOverrideBrandDisplayName;
                }

                @if (hasLocks)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-4">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="mr-2" />
                        Some settings are locked by your instance administrator and cannot be changed here.
                    </MudAlert>
                }

                <MudExpansionPanels MultiExpansion="true" Class="mb-4">
                    <MudExpansionPanel Text="Content Governance" IsExpanded="true">
                        <MudStack Spacing="3">
                            <MudSwitch T="bool" @bind-Value="_model.AllowUserSubmittedEvents" Color="Color.Primary">
                                Allow users to submit events
                            </MudSwitch>
                            <MudSwitch T="bool" @bind-Value="_model.RequireEventApproval" Color="Color.Primary">
                                Require approval before user-submitted events are published
                            </MudSwitch>
                            <MudSwitch T="bool"
                                       @bind-Value="_model.RequireOrganizationVerification"
                                       Disabled="@(!_model.CanTenantOmitVerification)"
                                       Color="Color.Primary">
                                Require organization verification @(!_model.CanTenantOmitVerification ? "🔒" : "")
                            </MudSwitch>
                        </MudStack>
                    </MudExpansionPanel>

                    <MudExpansionPanel Text="Tenant Experience">
                        <MudStack Spacing="3">
                            <MudSelect T="string"
                                       Label="@("Preferred Home Page" + (!_model.CanOverrideHomePagePreference ? " 🔒" : " (Required)"))"
                                       @bind-Value="_model.PreferredHomePage"
                                       Disabled="@(!_model.CanOverrideHomePagePreference)"
                                       Variant="Variant.Outlined"
                                       Required="true"
                                       RequiredError="Preferred home page is required.">
                                <MudSelectItem Value="@("EventList")">Event List</MudSelectItem>
                                <MudSelectItem Value="@("LandingPage")">Landing Page</MudSelectItem>
                            </MudSelect>

                            <MudSwitch T="bool"
                                       @bind-Value="_model.EventCardClickOpensDetailPage"
                                       Color="Color.Primary"
                                       Disabled="@(!_model.CanOverrideEventCardClickBehavior)">
                                Event card click opens detail page @(!_model.CanOverrideEventCardClickBehavior ? "🔒" : "")
                            </MudSwitch>

                            <AppTextField T="string" Label="@("Subdomain (Optional)" + (!_model.CanOverrideSubdomain ? " 🔒" : ""))"
                                          Variant="Variant.Outlined"
                                          Placeholder="tenant-slug"
                                          @bind-Value="_model.Subdomain"
                                          Disabled="@(!_model.CanOverrideSubdomain)"
                                          HelperText="@($"Base domain: {(_model.InstanceBaseDomain == string.Empty ? "(not configured)" : _model.InstanceBaseDomain)}")" />

                            <AppTextField T="string" Label="@("Custom Domain (Optional)" + (!_model.CanOverrideCustomDomain ? " 🔒" : ""))"
                                          Variant="Variant.Outlined"
                                          Placeholder="events.example.org"
                                          @bind-Value="_model.CustomDomain"
                                          Disabled="@(!_model.CanOverrideCustomDomain)" />
                        </MudStack>
                    </MudExpansionPanel>

                    <MudExpansionPanel Text="Platform Identity">
                        <MudStack Spacing="3">
                            <AppTextField T="string" Label="@("Brand Display Name" + (!_model.CanOverrideBrandDisplayName ? " 🔒" : " (Required)"))"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          RequiredError="Brand display name is required."
                                          @bind-Value="_model.BrandDisplayName"
                                          Disabled="@(!_model.CanOverrideBrandDisplayName)" />

                            @if (_model.IsTenantWhiteLabelingEnabled)
                            {
                                <AppTextField T="string" Label="@("Brand Logo URL (Optional)" + (!_model.CanOverrideBrandLogoUrl ? " 🔒" : ""))"
                                              Variant="Variant.Outlined"
                                              @bind-Value="_model.BrandLogoUrl"
                                              Disabled="@(!_model.CanOverrideBrandLogoUrl)" />
                                <AppTextField T="string" Label="@("Brand Favicon URL (Optional)" + (!_model.CanOverrideBrandFaviconUrl ? " 🔒" : ""))"
                                              Variant="Variant.Outlined"
                                              @bind-Value="_model.BrandFaviconUrl"
                                              Disabled="@(!_model.CanOverrideBrandFaviconUrl)" />
                                <MudExpansionPanel Text="Advanced Branding" DisableGutters="true" Class="elevation-0">
                                    <AppTextField T="string" Label="@("Custom CSS URL (Optional)" + (!_model.CanOverrideBrandCustomCssUrl ? " 🔒" : ""))"
                                                  Variant="Variant.Outlined"
                                                  @bind-Value="_model.BrandCustomCssUrl"
                                                  Disabled="@(!_model.CanOverrideBrandCustomCssUrl)" />
                                </MudExpansionPanel>
                            }
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>

                <AppButton OnClick="CompleteOnboardingAsync"
                           Disabled="_isSaving"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           Size="Size.Large">
                    Complete Tenant Onboarding
                </AppButton>
            </MudStack>
        }
    </MudPaper>
</MudContainer>

@code {
    private TenantPolicySettingsModel _model = new();
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _canEdit;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await UserService.SyncUserAsync();

        var status = await TenantOnboardingService.GetStatusAsync();
        if (status == null)
        {
            _errorMessage = "Unable to load tenant onboarding status.";
            _isLoading = false;
            return;
        }

        _canEdit = status.IsCurrentUserTenantAdministrator || status.IsCurrentUserPlatformAdministrator;

        if (status.IsCompleted && _canEdit)
        {
            Navigation.NavigateTo("/events");
            return;
        }

        _model = await TenantOnboardingService.GetSettingsAsync();
        _isLoading = false;
    }

    private async Task CompleteOnboardingAsync()
    {
        _isSaving = true;
        _errorMessage = null;

        var response = await TenantOnboardingService.CompleteAsync(_model);
        _isSaving = false;

        if (response.Success)
        {
            Snackbar.Add("Tenant onboarding completed.", Severity.Success);
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        _errorMessage = string.IsNullOrWhiteSpace(response.Message)
            ? "Failed to complete tenant onboarding."
            : response.Message;
    }
}
