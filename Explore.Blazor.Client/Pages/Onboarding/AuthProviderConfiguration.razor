@* ABOUTME: Auth provider configuration page shown after setup token validation, before login. *@
@* ABOUTME: Lets instance admin enable/configure Keycloak, ATProto Login, and Google SSO providers. *@

@page "/onboarding/auth-provider"
@rendermode InteractiveServer
@layout SetupLayout
@inject IInstanceOnboardingService InstanceOnboardingService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@inject ILogger<AuthProviderConfiguration> Logger

<PageTitle>Authentication Providers</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">Authentication Providers</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">
            Choose how users will authenticate. At least one provider must be enabled.
        </MudText>

        @if (_isLoading)
        {
            <MudStack Spacing="3">
                <MudSkeleton Width="60%" Height="20px" Class="mb-1" />
                <MudSkeleton Width="100%" Height="56px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="56px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="56px" Class="mb-2" />
                <MudSkeleton Width="120px" Height="40px" />
            </MudStack>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div role="alert">
                    <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_successMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mb-4">@_successMessage</MudAlert>
            }

            @if (_model.KeycloakDetectedFromEnvironment && !_showAdvancedConfig)
            {
                <MudPaper Class="pa-8 mb-4 d-flex flex-column align-center text-center" Outlined="true">
                    <MudIcon Icon="@Icons.Material.Filled.Key" Color="Color.Primary" Style="font-size: 4rem;" Class="mb-4" />
                    <MudText Typo="Typo.h5" Class="mb-2">Keycloak Detected</MudText>
                    <MudText Typo="Typo.body2" Class="mb-6">We've automatically configured Keycloak from your environment variables.</MudText>
                    <AppButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Disabled="@(!CanSave)" OnClick="SaveAndContinueAsync" Class="mb-4 px-8">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            @:Continuing...
                        }
                        else
                        {
                            @:Continue with Keycloak
                        }
                    </AppButton>
                    <AppButton Variant="Variant.Text" Color="Color.Default" OnClick="@(() => _showAdvancedConfig = true)">
                        Configure Authentication Providers
                    </AppButton>
                </MudPaper>
            }
            else
            {
                <MudExpansionPanels MultiExpansion="true" Class="mb-4">
                    @* ── Keycloak ── *@
                    <MudExpansionPanel Text="Keycloak (OIDC)" IsExpanded="true">
                        <TitleContent>
                            <div class="d-flex align-center">
                                <MudText Typo="Typo.h6" Class="mr-2">Keycloak (OIDC)</MudText>
                                @if (_model.KeycloakDetectedFromEnvironment)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                        Auto-detected
                                    </MudChip>
                                }
                                <MudTooltip Text="Self-hosted identity provider. Full control over user accounts, passwords, and SSO. Requires running a separate Keycloak server.">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Default" />
                                </MudTooltip>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudStack Spacing="2">
                                <MudSwitch T="bool"
                                           Value="_model.KeycloakEnabled"
                                           ValueChanged="OnKeycloakToggled"
                                           Color="Color.Primary"
                                           Disabled="_model.KeycloakDetectedFromEnvironment">
                                    Enable Keycloak
                                </MudSwitch>

                                @if (_model.KeycloakEnabled)
                                {
                                    @if (_model.KeycloakDetectedFromEnvironment)
                                    {
                                        <MudAlert Severity="Severity.Info" Dense="true" NoIcon="true">
                                            <MudText Typo="Typo.caption">
                                                Keycloak credentials were detected from environment variables and cannot be modified here.
                                            </MudText>
                                        </MudAlert>
                                    }
                                    else
                                    {
                                        <AppTextField T="string"
                                                      Label="Authority URL (Required)"
                                                      @bind-Value="_model.KeycloakAuthority"
                                                      Placeholder="https://keycloak.example.com/realms/myrealm"
                                                      HelperText="The Keycloak realm URL used for OIDC discovery." />
                                        <AppTextField T="string"
                                                      Label="Client ID (Required)"
                                                      @bind-Value="_model.KeycloakClientId"
                                                      Placeholder="my-client" />
                                        <AppTextField T="string"
                                                      Label="Client Secret"
                                                      InputType="InputType.Password"
                                                      @bind-Value="_model.KeycloakClientSecret"
                                                      HelperText="Optional for public clients. Required for confidential clients." />
                                    }
                                }
                            </MudStack>
                        </ChildContent>
                    </MudExpansionPanel>

                    @* ── ATProto Login ── *@
                    <MudExpansionPanel Text="AT Protocol Login">
                        <TitleContent>
                            <div class="d-flex align-center">
                                <MudText Typo="Typo.h6" Class="mr-2">AT Protocol Login</MudText>
                                <MudTooltip Text="Users authenticate with their AT Protocol identity (e.g., Bluesky account). No external server needed — users bring their own identity.">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Default" />
                                </MudTooltip>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudStack Spacing="2">
                                <MudSwitch T="bool" @bind-Value="_model.AtprotoLoginEnabled" Color="Color.Primary">
                                    Enable AT Protocol Login
                                </MudSwitch>

                                @if (_model.AtprotoLoginEnabled)
                                {
                                    <AppTextField T="string"
                                                  Label="Public URL (Required)"
                                                  @bind-Value="_model.AtprotoPublicUrl"
                                                  Placeholder="https://event.example.com"
                                                  HelperText="Must be publicly accessible. AT Protocol OAuth requires a reachable client metadata URL." />

                                    @if (IsPrivateUrl(_model.AtprotoPublicUrl))
                                    {
                                        <MudAlert Severity="Severity.Warning" Dense="true">
                                            This URL appears to be a local or private address. AT Protocol OAuth requires a publicly
                                            accessible URL. If you're using a tunneling tool (e.g., ngrok, Cloudflare Tunnel),
                                            this may still work.
                                        </MudAlert>
                                    }
                                }
                            </MudStack>
                        </ChildContent>
                    </MudExpansionPanel>

                    @* ── Google SSO ── *@
                    <MudExpansionPanel Text="Google SSO">
                        <TitleContent>
                            <div class="d-flex align-center">
                                <MudText Typo="Typo.h6" Class="mr-2">Google SSO</MudText>
                                <MudTooltip Text="Users authenticate with their Google account. Requires a Google Cloud project with OAuth credentials configured.">
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Default" />
                                </MudTooltip>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <MudStack Spacing="2">
                                <MudSwitch T="bool" @bind-Value="_model.GoogleSsoEnabled" Color="Color.Primary">
                                    Enable Google SSO
                                </MudSwitch>

                                @if (_model.GoogleSsoEnabled)
                                {
                                    <AppTextField T="string"
                                                  Label="Google Client ID (Required)"
                                                  @bind-Value="_model.GoogleClientId"
                                                  Placeholder="123456789.apps.googleusercontent.com" />
                                    <AppTextField T="string"
                                                  Label="Google Client Secret (Required)"
                                                  InputType="InputType.Password"
                                                  @bind-Value="_model.GoogleClientSecret" />
                                }
                            </MudStack>
                        </ChildContent>
                    </MudExpansionPanel>
                </MudExpansionPanels>

                @* ── Validation message ── *@
                @if (!HasAnyProviderEnabled)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-4">
                        At least one authentication provider must be enabled.
                    </MudAlert>
                }

                @* ── Actions ── *@
                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <AppButton Disabled="@(!CanSave)"
                               OnClick="SaveAndContinueAsync">
                        @if (_isSaving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            @:Saving...
                        }
                        else
                        {
                            @:Save & Continue to Login
                        }
                    </AppButton>
                </MudStack>
            }
        }
    </MudPaper>
</MudContainer>

@code {
    private AuthProviderConfigurationModel _model = new();
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _errorMessage;
    private string? _successMessage;
    private bool _showAdvancedConfig = false;

    private bool HasAnyProviderEnabled =>
        _model.KeycloakEnabled || _model.AtprotoLoginEnabled || _model.GoogleSsoEnabled;

    private bool HasKeycloakCredentials =>
        _model.KeycloakDetectedFromEnvironment ||
        (!string.IsNullOrWhiteSpace(_model.KeycloakAuthority) && !string.IsNullOrWhiteSpace(_model.KeycloakClientId));

    private bool HasAtprotoCredentials =>
        !string.IsNullOrWhiteSpace(_model.AtprotoPublicUrl);

    private bool HasGoogleCredentials =>
        !string.IsNullOrWhiteSpace(_model.GoogleClientId) && !string.IsNullOrWhiteSpace(_model.GoogleClientSecret);

    private bool CanSave =>
        !_isSaving &&
        HasAnyProviderEnabled &&
        (!_model.KeycloakEnabled || HasKeycloakCredentials) &&
        (!_model.AtprotoLoginEnabled || HasAtprotoCredentials) &&
        (!_model.GoogleSsoEnabled || HasGoogleCredentials);

    protected override async Task OnInitializedAsync()
    {
        var status = await InstanceOnboardingService.GetStatusAsync();
        if (status?.IsCompleted == true)
        {
            Navigation.NavigateTo("/");
            return;
        }

        _model = await InstanceOnboardingService.GetAuthProviderConfigurationAsync();

        // Pre-fill the ATProto public URL from the current browser request if not already set
        if (string.IsNullOrWhiteSpace(_model.AtprotoPublicUrl))
        {
            var baseUri = new Uri(Navigation.BaseUri);
            _model.AtprotoPublicUrl = $"{baseUri.Scheme}://{baseUri.Host}" +
                (baseUri.IsDefaultPort ? "" : $":{baseUri.Port}");
        }

        _isLoading = false;
    }

    private void OnKeycloakToggled(bool enabled)
    {
        _model.KeycloakEnabled = enabled;
        if (!enabled)
        {
            // Clear credentials when disabled (unless env-detected)
            if (!_model.KeycloakDetectedFromEnvironment)
            {
                _model.KeycloakAuthority = string.Empty;
                _model.KeycloakClientId = string.Empty;
                _model.KeycloakClientSecret = string.Empty;
            }
        }
    }

    private async Task SaveAndContinueAsync()
    {
        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;

        var response = await InstanceOnboardingService.SaveAuthProviderConfigurationAsync(_model);

        if (!response.Success)
        {
            _isSaving = false;
            _errorMessage = string.IsNullOrWhiteSpace(response.Message)
                ? "Failed to save auth provider configuration."
                : response.Message;

            if (response.Errors.Count > 0)
            {
                _errorMessage += " " + string.Join(" ", response.Errors);
            }
            return;
        }

        // Trigger dynamic auth scheme registration in the BFF
        try
        {
            var bffClient = CreateBffSelfClient();
            await bffClient.PostAsync("/bff/auth/refresh-schemes", null);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to refresh auth schemes after saving config. Login may require app restart.");
        }

        _isSaving = false;

        // Navigate to login so the admin can authenticate with the chosen provider
        Navigation.NavigateTo("/onboarding/authz-provider", forceLoad: true);
    }

    private static bool IsPrivateUrl(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return false;

        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri))
            return false;

        var host = uri.Host.ToLowerInvariant();
        return host is "localhost" or "127.0.0.1" or "0.0.0.0"
            || host.StartsWith("192.168.")
            || host.StartsWith("10.")
            || host.StartsWith("172.16.")
            || host.StartsWith("172.17.")
            || host.StartsWith("172.18.")
            || host.StartsWith("172.19.")
            || host.StartsWith("172.2")
            || host.StartsWith("172.30.")
            || host.StartsWith("172.31.")
            || host.EndsWith(".local")
            || host.EndsWith(".internal");
    }

    private HttpClient CreateBffSelfClient()
    {
        var client = HttpClientFactory.CreateClient("BffSelfClient");
        client.BaseAddress = new Uri(Navigation.BaseUri);
        return client;
    }
}
