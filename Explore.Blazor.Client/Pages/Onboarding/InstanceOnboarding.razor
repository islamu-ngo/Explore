@page "/onboarding/instance"
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@using Explore.Blazor.Client.Clients
@layout SetupLayout
@attribute [Authorize]
@rendermode InteractiveServer
@inject IInstanceOnboardingService InstanceOnboardingService
@inject IGroupService GroupService
@inject IUserService UserService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<InstanceOnboarding> Logger
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h4" Class="mb-2">Instance Onboarding</MudText>
        <MudText Typo="Typo.body1" Class="mb-4">
            Set up your platform instance. You can update these settings anytime in instance settings.
        </MudText>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        @if (_isLoading)
        {
            <MudStack Spacing="3">
                <MudSkeleton Width="50%" Height="20px" Class="mb-1" />
                <MudStack Direction="Direction.Row" Spacing="2" Class="mb-4">
                    @for (int i = 0; i < 4; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" />
                        @if (i < 3) { <MudSkeleton Width="60px" Height="4px" Class="align-self-center" /> }
                    }
                </MudStack>
                <MudSkeleton Width="40%" Height="28px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="56px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="56px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="40px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="40px" />
            </MudStack>
        }
        else
        {
            <MudStepper @key="_stepperKey"
                        @bind-ActiveIndex="_activeStep"
                        NonLinear="false"
                        ShowResetButton="false"
                        OnPreviewInteraction="OnPreviewStepInteraction">
                <ChildContent>
                    <MudStep Title="Tenant Mode">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h6">Choose Your Tenant Mode</MudText>
                        <MudText Typo="Typo.body2">
                            This determines how your instance is organized. Most self-hosters should choose Single Tenant.
                        </MudText>

                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="@GetTenantModeCardClass("SingleTenant")" Elevation="@(IsSingleTenantMode ? 4 : 1)" Style="cursor:pointer; height:100%"
                                          @onclick="@(() => OnDeploymentModeChanged("SingleTenant"))">
                                    <MudStack Spacing="1" Class="pa-4">
                                        <MudStack Direction="Direction.Row" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudIcon Icon="@Icons.Material.Filled.Person" Color="@(IsSingleTenantMode ? Color.Primary : Color.Default)" Size="Size.Large" />
                                            <MudText Typo="Typo.h6">Single Tenant</MudText>
                                        </MudStack>
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">Recommended</MudChip>
                                        <MudText Typo="Typo.body2">
                                            One tenant, one admin panel. Instance and tenant administration are merged.
                                            Everything is allowed by default — no governance overhead.
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Best for: personal instances, small communities, single organizations.
                                        </MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudPaper Class="@GetTenantModeCardClass("MultiTenant")" Elevation="@(IsMultiTenantMode ? 4 : 1)" Style="cursor:pointer; height:100%"
                                          @onclick="@(() => OnDeploymentModeChanged("MultiTenant"))">
                                    <MudStack Spacing="1" Class="pa-4">
                                        <MudStack Direction="Direction.Row" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudIcon Icon="@Icons.Material.Filled.Business" Color="@(IsMultiTenantMode ? Color.Primary : Color.Default)" Size="Size.Large" />
                                            <MudText Typo="Typo.h6">Multi Tenant</MudText>
                                        </MudStack>
                                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">Advanced</MudChip>
                                        <MudText Typo="Typo.body2">
                                            Multiple independent tenants, each with their own branding, policies, and admin.
                                            Instance admin governs tenant-level overrides and onboarding.
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Best for: SaaS platforms, hosting providers, multi-organization deployments.
                                        </MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>

                        <MudExpansionPanels Elevation="0">
                            <MudExpansionPanel Text="Help me choose — what's the difference?">
                                <MudStack Spacing="2">
                                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Text">
                                        <strong>Single Tenant</strong> creates one tenant automatically with all features unlocked.
                                        You manage everything from one admin panel. There is no concept of tenant-level governance
                                        or overrides — you are both the instance admin and the tenant admin. You can transition
                                        to multi-tenant later from instance settings if your needs change.
                                    </MudAlert>
                                    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Text">
                                        <strong>Multi Tenant</strong> separates instance administration from tenant administration.
                                        You control which features tenants can override (branding, home page, policies), whether
                                        tenants can self-register, and domain governance (subdomains, custom domains). Each tenant
                                        gets its own onboarding flow and admin panel. Choose this if you're hosting for multiple
                                        communities or organizations.
                                    </MudAlert>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Not sure? Start with Single Tenant. You can always transition to Multi Tenant later
                                        without losing data — you'll just need to configure tenant governance settings at that point.
                                    </MudText>
                                </MudStack>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </MudStack>
                    </MudStep>

                    <MudStep Title="Instance Settings">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.caption" Class="mb-1">Fields marked "(Required)" must be provided before completing onboarding.</MudText>

                        <MudSelect T="string"
                                   Label="Default Public Home Page (Required)"
                                   @bind-Value="_model.DefaultPublicHomePage"
                                   Variant="Variant.Outlined"
                                   Required="true"
                                   RequiredError="Default public home page is required.">
                            <MudSelectItem Value="@("EventList")">Event List</MudSelectItem>
                            <MudSelectItem Value="@("LandingPage")">Landing Page</MudSelectItem>
                        </MudSelect>

                        @if (IsMultiTenantMode)
                        {
                            <MudDivider />
                            <MudText Typo="Typo.h6">Tenant Governance</MudText>
                            <MudSwitch T="bool" @bind-Value="_model.AllowTenantSelfServiceRegistration" Color="Color.Primary">
                                Allow tenant self-service registration
                            </MudSwitch>
                            <MudSwitch T="bool" @bind-Value="_model.AllowTenantWhiteLabeling" Color="Color.Primary">
                                Allow tenant white-label branding
                            </MudSwitch>
                            <MudSwitch T="bool" @bind-Value="_model.LockTenantHomePagePreference" Color="Color.Primary">
                                Lock tenant home page preference
                            </MudSwitch>

                            <MudDivider />
                            <MudText Typo="Typo.h6">Domain Governance</MudText>
                            <MudTextField Label="Instance Base Domain (Optional)"
                                          Variant="Variant.Outlined"
                                          @bind-Value="_model.InstanceBaseDomain"
                                          Placeholder="example.com"
                                          HelperText="Used for tenant subdomains (e.g., tenant.example.com)." />
                            <MudSwitch T="bool" @bind-Value="_model.AllowTenantCustomDomains" Color="Color.Primary">
                                Allow tenant custom domains
                            </MudSwitch>
                            <MudSwitch T="bool" @bind-Value="_model.LockTenantSubdomain" Color="Color.Primary">
                                Lock tenant subdomain changes
                            </MudSwitch>
                            <MudSwitch T="bool" @bind-Value="_model.LockTenantCustomDomain" Color="Color.Primary">
                                Lock tenant custom domain changes
                            </MudSwitch>
                        }

                        <MudDivider />
                        <MudText Typo="Typo.h6">Policy Defaults</MudText>
                        <MudSwitch T="bool" @bind-Value="_model.EnableIslamicModule" Color="Color.Primary">
                            Enable Islamic module
                        </MudSwitch>
                        <MudSwitch T="bool" @bind-Value="_model.EnableTechModule" Color="Color.Primary">
                            Enable Tech module
                        </MudSwitch>
                        <MudSwitch T="bool" @bind-Value="_model.AllowUserSubmittedEvents" Color="Color.Primary">
                            Allow user-submitted events
                        </MudSwitch>
                        <MudSwitch T="bool" @bind-Value="_model.AllowOrganizationSubmittedEvents" Color="Color.Primary">
                            Allow organization-submitted events
                        </MudSwitch>
                        <MudSwitch T="bool" @bind-Value="_model.AllowGroupSubmittedEvents" Color="Color.Primary">
                            Allow group-submitted events
                        </MudSwitch>

                        @if (!_model.AllowUserSubmittedEvents && !_model.AllowOrganizationSubmittedEvents && !_model.AllowGroupSubmittedEvents)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">
                                No entity types are allowed to submit events. Only administrators will be able to create events through entities they manage.
                            </MudAlert>
                        }

                        <MudSwitch T="bool" @bind-Value="_model.AllowOrganizationSelfRegistration" Color="Color.Primary">
                            Allow organization self-registration
                        </MudSwitch>
                        <MudSwitch T="bool" @bind-Value="_model.AllowGroupSelfRegistration" Color="Color.Primary">
                            Allow group self-registration
                        </MudSwitch>
                        <MudSwitch T="bool" @bind-Value="_model.RequireOrganizationVerification" Color="Color.Primary">
                            Require organization verification
                        </MudSwitch>
                        @if (IsMultiTenantMode)
                        {
                            <MudSwitch T="bool" @bind-Value="_model.AllowTenantToOmitVerification" Color="Color.Primary">
                                Allow tenant admins to omit organization verification
                            </MudSwitch>
                        }
                        <MudSwitch T="bool" @bind-Value="_model.EventCardClickOpensDetailPage" Color="Color.Primary">
                            Event card click opens detail page (instead of sidebar)
                        </MudSwitch>
                        @if (IsMultiTenantMode)
                        {
                            <MudSwitch T="bool" @bind-Value="_model.LockTenantEventCardClickBehavior" Color="Color.Primary">
                                Lock tenant event card click behavior
                            </MudSwitch>
                        }

                        <MudDivider />
                        <MudText Typo="Typo.h6">Default Branding</MudText>
                        <MudTextField Label="Brand Display Name (Required)"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="Brand display name is required."
                                      @bind-Value="_model.DefaultBrandDisplayName" />
                        <MudTextField Label="Brand Logo URL (Optional)"
                                      Variant="Variant.Outlined"
                                      @bind-Value="_model.DefaultBrandLogoUrl" />
                        <MudTextField Label="Brand Favicon URL (Optional)"
                                      Variant="Variant.Outlined"
                                      @bind-Value="_model.DefaultBrandFaviconUrl" />
                        <MudTextField Label="Advanced: Custom CSS URL (Optional)"
                                      Variant="Variant.Outlined"
                                      @bind-Value="_model.DefaultBrandCustomCssUrl"
                                      HelperText="Optional advanced override for platform-level custom stylesheet." />
                        @if (IsMultiTenantMode)
                        {
                            <MudSwitch T="bool" @bind-Value="_model.LockTenantBrandDisplayName" Color="Color.Primary">
                                Lock tenant brand display name
                            </MudSwitch>
                            <MudSwitch T="bool" @bind-Value="_model.LockTenantBrandLogoUrl" Color="Color.Primary">
                                Lock tenant brand logo
                            </MudSwitch>
                            <MudSwitch T="bool" @bind-Value="_model.LockTenantBrandFaviconUrl" Color="Color.Primary">
                                Lock tenant brand favicon
                            </MudSwitch>
                            <MudSwitch T="bool" @bind-Value="_model.LockTenantBrandCustomCssUrl" Color="Color.Primary">
                                Lock tenant custom CSS URL
                            </MudSwitch>
                        }

                        <MudDivider />
                        <MudText Typo="Typo.h6">Federation</MudText>
                        <MudStack Direction="Direction.Row" AlignItems="AlignItems.Center" Spacing="1">
                            <MudSwitch T="bool"
                                       Value="_model.DecentralizationEnabled"
                                       ValueChanged="OnDecentralizationToggled"
                                       Disabled="@(!_atprotoLoginEnabled)"
                                       Color="Color.Primary">
                                Enable ATProto decentralization
                            </MudSwitch>
                            <MudTooltip Text="When enabled, event records are published to users' Personal Data Servers (PDS) on the AT Protocol network. This makes event data publicly accessible and enables cross-instance discovery. Keep disabled if you want events to remain private to this instance.">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Default" />
                            </MudTooltip>
                        </MudStack>
                        @if (!_atprotoLoginEnabled)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">ATProto Login must be enabled in the authentication provider configuration to use decentralization.</MudText>
                        }
                        @if (IsMultiTenantMode)
                        {
                            <MudSwitch T="bool" @bind-Value="_model.LockDecentralizationEnabled" Color="Color.Primary">
                                Lock tenant decentralization override
                            </MudSwitch>
                        }
                    </MudStack>
                    </MudStep>

                    @if (IsSingleTenantMode)
                    {
                        <MudStep Title="First Host Setup">
                        <MudStack Spacing="3">
                            <MudText Typo="Typo.h6">Set Up Your First Host</MudText>
                            <MudText Typo="Typo.body2">
                                Choose how you want to publish events first. This avoids friction later when selecting publisher context during event creation.
                            </MudText>

                            <MudPaper Class="pa-3">
                                <MudStack Spacing="1">
                                    <MudButton Variant="@GetFirstHostButtonVariant(FirstHostSetupChoice.Personal)"
                                               Color="@GetFirstHostButtonColor(FirstHostSetupChoice.Personal)"
                                               StartIcon="@Icons.Material.Filled.Person"
                                               OnClick="@(() => SelectFirstHost(FirstHostSetupChoice.Personal))"
                                               FullWidth="true">
                                        Publish Under My Account
                                    </MudButton>
                                    <MudText Typo="Typo.caption">Quickest start. You can still add group/organization later.</MudText>
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-3">
                                <MudStack Spacing="1">
                                    <MudButton Variant="@GetFirstHostButtonVariant(FirstHostSetupChoice.GroupQuickSetup)"
                                               Color="@GetFirstHostButtonColor(FirstHostSetupChoice.GroupQuickSetup)"
                                               StartIcon="@Icons.Material.Filled.Groups"
                                               OnClick="@(() => SelectFirstHost(FirstHostSetupChoice.GroupQuickSetup))"
                                               FullWidth="true">
                                        Group (Informal Quick Setup)
                                    </MudButton>
                                    <MudText Typo="Typo.caption">We create a starter group for you automatically.</MudText>
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-3">
                                <MudStack Spacing="1">
                                    <MudButton Variant="@GetFirstHostButtonVariant(FirstHostSetupChoice.Organization)"
                                               Color="@GetFirstHostButtonColor(FirstHostSetupChoice.Organization)"
                                               StartIcon="@Icons.Material.Filled.Business"
                                               OnClick="@(() => SelectFirstHost(FirstHostSetupChoice.Organization))"
                                               FullWidth="true">
                                        Organization (Formal Setup)
                                    </MudButton>
                                    <MudText Typo="Typo.caption">For legal entity publishing. We redirect you to complete organization details.</MudText>
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-3">
                                <MudStack Spacing="1">
                                    <MudButton Variant="@GetFirstHostButtonVariant(FirstHostSetupChoice.DoLater)"
                                               Color="@GetFirstHostButtonColor(FirstHostSetupChoice.DoLater)"
                                               StartIcon="@Icons.Material.Filled.Schedule"
                                               OnClick="@(() => SelectFirstHost(FirstHostSetupChoice.DoLater))"
                                               FullWidth="true">
                                        I Will Do This Later
                                    </MudButton>
                                    <MudText Typo="Typo.caption">Continue now and configure hosting entities later.</MudText>
                                </MudStack>
                            </MudPaper>
                        </MudStack>
                        </MudStep>
                    }

                    <MudStep Title="Review & Complete">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">Review</MudText>
                        <MudText Typo="Typo.body2"><strong>Tenant Mode:</strong> @(IsSingleTenantMode ? "Single Tenant" : "Multi Tenant")</MudText>
                        <MudText Typo="Typo.body2"><strong>Default Public Home Page:</strong> @(_model.DefaultPublicHomePage)</MudText>
                        @if (IsSingleTenantMode)
                        {
                            <MudText Typo="Typo.body2"><strong>First Host Choice:</strong> @GetFirstHostChoiceLabel()</MudText>
                        }
                        <MudText Typo="Typo.body2"><strong>Event Card Click Opens Detail Page:</strong> @(_model.EventCardClickOpensDetailPage ? "Yes" : "No")</MudText>
                        <MudText Typo="Typo.body2"><strong>ATProto Decentralization:</strong> @(_model.DecentralizationEnabled ? "Enabled" : "Disabled")</MudText>
                        @if (IsMultiTenantMode)
                        {
                            <MudText Typo="Typo.body2"><strong>Tenant Self-Registration:</strong> @(_model.AllowTenantSelfServiceRegistration ? "Allowed" : "Disabled")</MudText>
                            <MudText Typo="Typo.body2"><strong>Tenant White-Labeling:</strong> @(_model.AllowTenantWhiteLabeling ? "Allowed" : "Disabled")</MudText>
                        }

                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            @GetCompletionRedirectHint()
                        </MudAlert>
                    </MudStack>
                    </MudStep>
                </ChildContent>

                <ActionContent Context="stepper">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Default"
                               Disabled="@(_activeStep == 0 || _isSaving)"
                               OnClick="@(() => stepper.PreviousStepAsync())">
                        Back
                    </MudButton>
                    <MudSpacer />

                    @if (_activeStep < LastStepIndex)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="@(() => stepper.NextStepAsync())"
                                   Disabled="@(_isSaving)">
                            Next
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="CompleteOnboardingAsync"
                                   Disabled="@(_isSaving || IsCompleteDisabled)">
                            @_completeButtonLabel
                        </MudButton>
                    }
                </ActionContent>
            </MudStepper>
        }
    </MudPaper>

<MudDialog @bind-Visible="_showDecentralizationConfirmDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">Enable ATProto Decentralization?</MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            Enabling ATProto decentralization means event records will be published to users' Personal Data Servers (PDS).
            This data becomes publicly accessible on the AT Protocol network.
        </MudAlert>
        <MudText Typo="Typo.body2">
            Self-hosters wanting private events should keep this disabled. This setting can be changed later in instance settings.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CancelDecentralization" Color="Color.Default">Cancel</MudButton>
        <MudButton OnClick="ConfirmDecentralization" Color="Color.Warning" Variant="Variant.Filled">Enable Decentralization</MudButton>
    </DialogActions>
</MudDialog>
</MudContainer>

@code {
    private enum FirstHostSetupChoice
    {
        None = 0,
        Personal = 1,
        GroupQuickSetup = 2,
        Organization = 3,
        DoLater = 4
    }

    private const int FirstHostStepIndex = 2;
    private InstanceGovernanceSettingsModel _model = new();
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _errorMessage;
    private bool _setupSecretSynced;
    private int _activeStep;
    private UserDto? _currentUser;
    private FirstHostSetupChoice _firstHostSetupChoice = FirstHostSetupChoice.None;
    private string _completeButtonLabel = "Complete Instance Onboarding";
    private string _stepperKey = "single";

    private bool _atprotoLoginEnabled;
    private bool _showDecentralizationConfirmDialog;
    private bool IsSingleTenantMode => _model.DeploymentMode.Equals("SingleTenant", StringComparison.OrdinalIgnoreCase);
    private bool IsMultiTenantMode => _model.DeploymentMode.Equals("MultiTenant", StringComparison.OrdinalIgnoreCase);
    // Steps: 0=TenantMode, 1=InstanceSettings, 2=FirstHost(single)/Review(multi), 3=Review(single)
    private int LastStepIndex => IsSingleTenantMode ? 3 : 2;
    private bool IsFirstHostSelectionMissing => IsSingleTenantMode && _firstHostSetupChoice == FirstHostSetupChoice.None;
    private bool IsCompleteDisabled => IsFirstHostSelectionMissing;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await UserService.SyncUserAsync();
            _currentUser = await UserService.GetCurrentUserAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not fully hydrate user context during instance onboarding.");
        }

        var status = await InstanceOnboardingService.GetStatusAsync();
        if (status?.IsCompleted == true)
        {
            Navigation.NavigateTo("/startup");
            return;
        }

        _model = await InstanceOnboardingService.GetSettingsAsync();
        if (IsSingleTenantMode)
        {
            ApplySingleTenantDefaults();
        }

        _stepperKey = IsSingleTenantMode ? "single" : "multi";

        // Load auth provider config to check if ATProto Login is enabled.
        try
        {
            var authConfig = await InstanceOnboardingService.GetAuthProviderConfigurationAsync();
            _atprotoLoginEnabled = authConfig.AtprotoLoginEnabled;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load auth provider configuration during instance onboarding.");
        }

        _isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _setupSecretSynced)
        {
            return;
        }

        var secret = (await JSRuntime.InvokeAsync<string?>("sessionStorage.getItem", "setup-secret"))?.Trim();
        if (string.IsNullOrWhiteSpace(secret))
        {
            return;
        }

        // /bff/setup-secret/sync validates the secret internally — no separate ValidateSecretAsync
        // call needed, which would otherwise consume an extra rate-limit token before complete.
        var bffClient = CreateBffSelfClient();
        var syncResponse = await bffClient.PostAsJsonAsync("/bff/setup-secret/sync", new { Secret = secret });
        if (syncResponse.IsSuccessStatusCode)
        {
            _setupSecretSynced = true;
            return;
        }

        // 400 = invalid secret, 410 = setup already completed → clear and redirect
        if (syncResponse.StatusCode == System.Net.HttpStatusCode.BadRequest ||
            syncResponse.StatusCode == System.Net.HttpStatusCode.Gone)
        {
            await bffClient.DeleteAsync("/bff/setup-secret");
            await JSRuntime.InvokeVoidAsync("sessionStorage.removeItem", "setup-secret");
            _errorMessage = "Setup secret expired or is invalid. Please enter the current setup secret again.";
            StateHasChanged();
            Navigation.NavigateTo("/setup", forceLoad: true);
            return;
        }

        _errorMessage = "Could not sync setup secret for onboarding. Please return to setup and try again.";
        StateHasChanged();
    }

    private void OnDeploymentModeChanged(string deploymentMode)
    {
        var wasSingleTenantMode = IsSingleTenantMode;

        _model.DeploymentMode = string.IsNullOrWhiteSpace(deploymentMode) ? "SingleTenant" : deploymentMode.Trim();

        if (IsSingleTenantMode)
        {
            // Single-tenant: everything allowed, nothing locked
            _model.AllowTenantSelfServiceRegistration = false;
            _model.AllowTenantWhiteLabeling = false;
            _model.AllowTenantCustomDomains = true;
            _model.AllowTenantToOmitVerification = false;
            _model.LockTenantHomePagePreference = false;
            _model.LockTenantSubdomain = false;
            _model.LockTenantCustomDomain = false;
            _model.LockTenantBrandDisplayName = false;
            _model.LockTenantBrandLogoUrl = false;
            _model.LockTenantBrandFaviconUrl = false;
            _model.LockTenantBrandCustomCssUrl = false;
            _model.LockTenantEventCardClickBehavior = false;
            _model.LockDecentralizationEnabled = false;
        }

        if (wasSingleTenantMode != IsSingleTenantMode)
        {
            _stepperKey = IsSingleTenantMode ? "single" : "multi";
        }

        if (_activeStep > LastStepIndex)
        {
            _activeStep = LastStepIndex;
        }

        _errorMessage = null;
    }

    private Task OnPreviewStepInteraction(StepperInteractionEventArgs args)
    {
        if (args.Action != StepAction.Complete)
            return Task.CompletedTask;

        // Validate "First Host Setup" step (index 2 in single-tenant mode)
        if (IsSingleTenantMode && args.StepIndex == FirstHostStepIndex && IsFirstHostSelectionMissing)
        {
            args.Cancel = true;
            _errorMessage = "Please choose how you want to set up your first host before continuing.";
            return Task.CompletedTask;
        }

        _errorMessage = null;
        return Task.CompletedTask;
    }

    private void SelectFirstHost(FirstHostSetupChoice choice)
    {
        _firstHostSetupChoice = choice;
        _errorMessage = null;
    }

    private Variant GetFirstHostButtonVariant(FirstHostSetupChoice choice) =>
        _firstHostSetupChoice == choice ? Variant.Filled : Variant.Outlined;

    private Color GetFirstHostButtonColor(FirstHostSetupChoice choice) =>
        _firstHostSetupChoice == choice ? Color.Primary : Color.Default;

    private string GetFirstHostChoiceLabel()
    {
        return _firstHostSetupChoice switch
        {
            FirstHostSetupChoice.Personal => "Publish under my account",
            FirstHostSetupChoice.GroupQuickSetup => "Group (informal quick setup)",
            FirstHostSetupChoice.Organization => "Organization (formal setup)",
            FirstHostSetupChoice.DoLater => "I will do this later",
            _ => "Not selected"
        };
    }

    private string GetCompletionRedirectHint()
    {
        if (IsMultiTenantMode)
        {
            return "After completion, you will be redirected to instance administration pages.";
        }

        return _firstHostSetupChoice switch
        {
            FirstHostSetupChoice.Organization => "After completion, you will be redirected to create your organization profile first.",
            _ => "After completion, you will be redirected to the event list."
        };
    }

    private async Task CompleteOnboardingAsync()
    {
        if (IsCompleteDisabled)
        {
            _errorMessage = "Please choose how you want to set up your first host before completing onboarding.";
            return;
        }

        _isSaving = true;
        _completeButtonLabel = "Saving...";
        _errorMessage = null;

        if (IsSingleTenantMode)
        {
            ApplySingleTenantDefaults();
        }

        var response = await InstanceOnboardingService.CompleteAsync(_model);
        _isSaving = false;
        _completeButtonLabel = "Complete Instance Onboarding";

        if (response.Success)
        {
            Snackbar.Add("Instance onboarding completed.", Severity.Success);
            await NavigatePostCompletionAsync();
            return;
        }

        _errorMessage = string.IsNullOrWhiteSpace(response.Message)
            ? "Failed to complete onboarding."
            : response.Message;
    }

    private async Task NavigatePostCompletionAsync()
    {
        // forceLoad: true triggers a full HTTP request so the BFF's IClaimsTransformation
        // runs and enriches the cookie principal with freshly-assigned admin claims.
        if (IsMultiTenantMode)
        {
            Navigation.NavigateTo("/admin/instance/settings", forceLoad: true);
            return;
        }

        switch (_firstHostSetupChoice)
        {
            case FirstHostSetupChoice.Organization:
                Snackbar.Add("Complete your organization profile now to publish events as an organization.", Severity.Info);
                Navigation.NavigateTo("/organization/create", forceLoad: true);
                return;

            case FirstHostSetupChoice.GroupQuickSetup:
            {
                var created = await TryCreateQuickGroupAsync();
                if (created)
                {
                    Snackbar.Add("Starter group created. You can now publish events under your group.", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Could not create the starter group automatically. You can set up a group later.", Severity.Warning);
                }

                Navigation.NavigateTo("/events", forceLoad: true);
                return;
            }

            case FirstHostSetupChoice.Personal:
                Snackbar.Add("You can publish events under your account immediately.", Severity.Info);
                Navigation.NavigateTo("/events", forceLoad: true);
                return;

            case FirstHostSetupChoice.DoLater:
            default:
                Snackbar.Add("You can set up a group or organization later from your account area.", Severity.Info);
                Navigation.NavigateTo("/events", forceLoad: true);
                return;
        }
    }

    private async Task<bool> TryCreateQuickGroupAsync()
    {
        var groupName = BuildDefaultGroupName();
        return await GroupService.CreateGroupAsync(groupName, "Starter group created during instance onboarding.");
    }

    private string BuildDefaultGroupName()
    {
        var fullName = string.Join(" ", new[] { _currentUser?.FirstName, _currentUser?.LastName }
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s!.Trim()));

        if (!string.IsNullOrWhiteSpace(fullName))
        {
            return $"{fullName}'s Group";
        }

        if (!string.IsNullOrWhiteSpace(_currentUser?.Username))
        {
            return $"{_currentUser.Username!.Trim()}'s Group";
        }

        return "My Group";
    }

    private HttpClient CreateBffSelfClient()
    {
        var client = HttpClientFactory.CreateClient("BffSelfClient");
        client.BaseAddress = new Uri(Navigation.BaseUri);
        return client;
    }

    private void OnDecentralizationToggled(bool newValue)
    {
        if (newValue)
        {
            // Show confirmation dialog before enabling
            _showDecentralizationConfirmDialog = true;
        }
        else
        {
            _model.DecentralizationEnabled = false;
        }
    }

    private void ConfirmDecentralization()
    {
        _model.DecentralizationEnabled = true;
        _showDecentralizationConfirmDialog = false;
    }

    private void CancelDecentralization()
    {
        _model.DecentralizationEnabled = false;
        _showDecentralizationConfirmDialog = false;
    }

    private void ApplySingleTenantDefaults()
    {
        _model.AllowTenantSelfServiceRegistration = false;
        _model.AllowTenantWhiteLabeling = false;
        _model.AllowTenantCustomDomains = true;
        _model.AllowTenantToOmitVerification = false;
        _model.LockTenantHomePagePreference = false;
        _model.LockTenantSubdomain = false;
        _model.LockTenantCustomDomain = false;
        _model.LockTenantBrandDisplayName = false;
        _model.LockTenantBrandLogoUrl = false;
        _model.LockTenantBrandFaviconUrl = false;
        _model.LockTenantBrandCustomCssUrl = false;
        _model.LockTenantEventCardClickBehavior = false;
        _model.LockDecentralizationEnabled = false;
    }

    private string GetTenantModeCardClass(string mode)
    {
        var isSelected = _model.DeploymentMode.Equals(mode, StringComparison.OrdinalIgnoreCase);
        return isSelected ? "border-solid border-2 mud-border-primary" : "";
    }
}
