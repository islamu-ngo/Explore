@page "/onboarding/instance"
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Models.Responses
@layout SetupLayout
@attribute [Authorize]
@rendermode InteractiveServer
@inject IInstanceOnboardingService InstanceOnboardingService
@inject IGroupService GroupService
@inject IUserService UserService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<InstanceOnboarding> Logger
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Instance Onboarding</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">Instance Onboarding</MudText>
        <MudText Typo="Typo.body1" Class="mb-4">
            Set up your platform instance. You can update these settings anytime in instance settings.
        </MudText>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(_syncWarning))
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">@_syncWarning</MudAlert>
        }

        @if (_isLoading)
        {
            <MudStack Spacing="3">
                <MudSkeleton Width="50%" Height="20px" Class="mb-1" />
                <MudStack Direction="Direction.Row" Spacing="2" Class="mb-4">
                    @for (int i = 0; i < 4; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" />
                        @if (i < 3) { <MudSkeleton Width="60px" Height="4px" Class="align-self-center" /> }
                    }
                </MudStack>
                <MudSkeleton Width="40%" Height="28px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="56px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="56px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="40px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="40px" />
            </MudStack>
        }
        else
        {
            <MudStepper @bind-ActiveIndex="_activeStep"
                        NonLinear="false"
                        ShowResetButton="false"
                        OnPreviewInteraction="OnPreviewStepInteraction">
                <ChildContent>
                    <MudStep Title="Instance Identity">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h6">Name Your Instance</MudText>
                        <MudText Typo="Typo.body2">
                            This name appears in the platform header, emails, and public-facing pages.
                            You can change it anytime in instance settings.
                        </MudText>

                        <MudAlert Severity="@(IsMultiTenantMode ? Severity.Info : Severity.Success)" Dense="true" Variant="Variant.Outlined">
                            @GetDeploymentModeNotice()
                        </MudAlert>

                        <AppTextField T="string" Label="Instance Name (Required)"
                                      Variant="Variant.Outlined"
                                      Required="true"
                                      RequiredError="Instance name is required."
                                      @bind-Value="_instanceName"
                                      Placeholder="e.g. ISLAMU Explore, My Community Events" />

                        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Text">
                            All other settings (modules, policies, branding, domains, federation) can be configured
                            after onboarding from the administration panel.
                        </MudAlert>
                    </MudStack>
                    </MudStep>

                    @if (IsSingleTenantMode)
                    {
                        <MudStep Title="First Host Setup">
                        <MudStack Spacing="3">
                            <MudText Typo="Typo.h6">Set Up Your First Host</MudText>
                            <MudText Typo="Typo.body2">
                                Choose how you want to publish events first. This avoids friction later when selecting publisher context during event creation.
                            </MudText>

                            <MudGrid>
                                <MudItem xs="12" sm="6">
                                    <MudPaper Class="pa-4 h-100" Outlined="true" Style="@GetFirstHostCardStyle(FirstHostSetupChoice.Personal)" @onclick="@(() => SelectFirstHost(FirstHostSetupChoice.Personal))">
                                        <MudStack Spacing="2" AlignItems="AlignItems.Center" Class="text-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Person" Color="@GetFirstHostIconColor(FirstHostSetupChoice.Personal)" Size="Size.Large" />
                                            <MudText Typo="Typo.h6">Personal Account</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">Publish directly under your own name. Quickest start.</MudText>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12" sm="6">
                                    <MudPaper Class="pa-4 h-100" Outlined="true" Style="@GetFirstHostCardStyle(FirstHostSetupChoice.GroupQuickSetup)" @onclick="@(() => SelectFirstHost(FirstHostSetupChoice.GroupQuickSetup))">
                                        <MudStack Spacing="2" AlignItems="AlignItems.Center" Class="text-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Groups" Color="@GetFirstHostIconColor(FirstHostSetupChoice.GroupQuickSetup)" Size="Size.Large" />
                                            <MudText Typo="Typo.h6">Quick Group</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">We'll automatically create a starter group for you.</MudText>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12" sm="12">
                                    <MudPaper Class="pa-4" Outlined="true" Style="@GetFirstHostCardStyle(FirstHostSetupChoice.Organization)" @onclick="@(() => SelectFirstHost(FirstHostSetupChoice.Organization))">
                                        <MudStack Spacing="2" AlignItems="AlignItems.Center" Class="text-center">
                                            <MudIcon Icon="@Icons.Material.Filled.Business" Color="@GetFirstHostIconColor(FirstHostSetupChoice.Organization)" Size="Size.Large" />
                                            <MudText Typo="Typo.h6">Formal Organization</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">For legal entities. Redirects to complete organization details.</MudText>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>

                            <div class="d-flex justify-center mt-4">
                                <AppButton Variant="@(_firstHostSetupChoice == FirstHostSetupChoice.DoLater ? Variant.Filled : Variant.Text)"
                                           Color="@(_firstHostSetupChoice == FirstHostSetupChoice.DoLater ? Color.Primary : Color.Default)"
                                           OnClick="@(() => SelectFirstHost(FirstHostSetupChoice.DoLater))">
                                    I Will Do This Later
                                </AppButton>
                            </div>
                        </MudStack>
                        </MudStep>
                    }

                    <MudStep Title="Review & Complete">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">Review</MudText>
                        <MudText Typo="Typo.body2"><strong>Tenant Mode:</strong> @(IsSingleTenantMode ? "Single Tenant" : "Multi Tenant")</MudText>
                        <MudText Typo="Typo.body2"><strong>Instance Name:</strong> @(string.IsNullOrWhiteSpace(_instanceName) ? "(not set)" : _instanceName)</MudText>
                        @if (IsSingleTenantMode)
                        {
                            <MudText Typo="Typo.body2"><strong>First Host Choice:</strong> @GetFirstHostChoiceLabel()</MudText>
                        }

                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            @GetCompletionRedirectHint()
                        </MudAlert>
                    </MudStack>
                    </MudStep>
                </ChildContent>

                <ActionContent Context="stepper">
                    <AppButton Variant="Variant.Text"
                               Color="Color.Default"
                               Disabled="@(_activeStep == 0 || _isSaving)"
                               OnClick="@(() => stepper.PreviousStepAsync())">
                        Back
                    </AppButton>
                    <MudSpacer />

                    @if (_activeStep < LastStepIndex)
                    {
                        <AppButton OnClick="@(() => stepper.NextStepAsync())"
                                   Disabled="@(_isSaving)">
                            Next
                        </AppButton>
                    }
                    else
                    {
                        <AppButton OnClick="CompleteOnboardingAsync"
                                   Disabled="@(_isSaving || IsCompleteDisabled)">
                            @_completeButtonLabel
                        </AppButton>
                    }
                </ActionContent>
            </MudStepper>
        }
    </MudPaper>
</MudContainer>

@code {
    private enum FirstHostSetupChoice
    {
        None = 0,
        Personal = 1,
        GroupQuickSetup = 2,
        Organization = 3,
        DoLater = 4
    }

    private const int FirstHostStepIndex = 1;
    private string _deploymentMode = "SingleTenant";
    private string _instanceName = string.Empty;
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _errorMessage;
    private bool _setupSecretSynced;
    private string? _syncWarning;
    private int _activeStep;
    private UserDto? _currentUser;
    private FirstHostSetupChoice _firstHostSetupChoice = FirstHostSetupChoice.None;
    private string _completeButtonLabel = "Complete Instance Onboarding";

    private bool IsSingleTenantMode => _deploymentMode.Equals("SingleTenant", StringComparison.OrdinalIgnoreCase);
    private bool IsMultiTenantMode => _deploymentMode.Equals("MultiTenant", StringComparison.OrdinalIgnoreCase);
    // Steps: 0=InstanceIdentity, 1=FirstHost(single)/Review(multi), 2=Review(single)
    private int LastStepIndex => IsSingleTenantMode ? 2 : 1;
    private bool IsFirstHostSelectionMissing => IsSingleTenantMode && _firstHostSetupChoice == FirstHostSetupChoice.None;
    private bool IsCompleteDisabled => IsFirstHostSelectionMissing;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await UserService.SyncUserAsync();
            _currentUser = await UserService.GetCurrentUserAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not fully hydrate user context during instance onboarding.");
        }

        var status = await InstanceOnboardingService.GetStatusAsync();
        if (status?.IsCompleted == true)
        {
            Navigation.NavigateTo("/startup");
            return;
        }

        // Pre-populate from existing settings if available (e.g. restart after partial setup)
        try
        {
            var systemStatus = await InstanceOnboardingService.GetSystemOnboardingStatusAsync();
            _deploymentMode = NormalizeDeploymentMode(systemStatus?.DeploymentMode);

            var brandingResult = await InstanceOnboardingService.GetBrandingSettingsAsync();
            if (!string.IsNullOrWhiteSpace(brandingResult.DefaultBrandDisplayName))
            {
                _instanceName = brandingResult.DefaultBrandDisplayName;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load existing settings during instance onboarding. Using defaults.");
        }

        _isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _setupSecretSynced)
        {
            return;
        }

        var bffModule = await GetBffModuleAsync();

        for (var attempt = 0; attempt <= 3; attempt++)
        {
            if (attempt > 0)
            {
                await Task.Delay(TimeSpan.FromSeconds(attempt * 2));
            }

            var syncResult = await bffModule.InvokeAsync<BffMutationResult>("syncSetupSecret", (string?)null);
            if (syncResult is { Ok: true })
            {
                _setupSecretSynced = true;
                _syncWarning = null;
                StateHasChanged();
                return;
            }

            if (syncResult?.Status is 400 or 410)
            {
                var bffClient = CreateBffSelfClient();
                await bffClient.DeleteAsync("/bff/setup-secret");
                _errorMessage = "Setup secret expired or is invalid. Please enter the current setup secret again.";
                StateHasChanged();
                Navigation.NavigateTo("/setup", forceLoad: true);
                return;
            }
        }

        _syncWarning = "Setup secret sync pending — you can proceed, but saving may require re-entering your setup secret.";
        StateHasChanged();
    }

    private Task OnPreviewStepInteraction(StepperInteractionEventArgs args)
    {
        if (args.Action != StepAction.Complete)
            return Task.CompletedTask;

        // Validate "First Host Setup" step (index 1 in single-tenant mode)
        if (IsSingleTenantMode && args.StepIndex == FirstHostStepIndex && IsFirstHostSelectionMissing)
        {
            args.Cancel = true;
            _errorMessage = "Please choose how you want to set up your first host before continuing.";
            return Task.CompletedTask;
        }

        _errorMessage = null;
        return Task.CompletedTask;
    }

    private void SelectFirstHost(FirstHostSetupChoice choice)
    {
        _firstHostSetupChoice = choice;
        _errorMessage = null;
    }

    private string GetFirstHostCardStyle(FirstHostSetupChoice choice) =>
        _firstHostSetupChoice == choice
            ? "cursor:pointer; border: 2px solid var(--mud-palette-primary); background-color: var(--mud-palette-primary-hover);"
            : "cursor:pointer; transition: all 0.2s ease-in-out;";

    private Color GetFirstHostIconColor(FirstHostSetupChoice choice) =>
        _firstHostSetupChoice == choice ? Color.Primary : Color.Default;

    private string GetFirstHostChoiceLabel()
    {
        return _firstHostSetupChoice switch
        {
            FirstHostSetupChoice.Personal => "Publish under my account",
            FirstHostSetupChoice.GroupQuickSetup => "Group (informal quick setup)",
            FirstHostSetupChoice.Organization => "Organization (formal setup)",
            FirstHostSetupChoice.DoLater => "I will do this later",
            _ => "Not selected"
        };
    }

    private string GetCompletionRedirectHint()
    {
        if (IsMultiTenantMode)
        {
            return "After completion, you will be redirected to instance administration pages.";
        }

        return _firstHostSetupChoice switch
        {
            FirstHostSetupChoice.Organization => "After completion, you will be redirected to create your organization profile first.",
            _ => "After completion, you will be redirected to the event list."
        };
    }

    private string GetDeploymentModeNotice() =>
        IsMultiTenantMode
            ? "Multi-tenant mode is active from deployment configuration. Complete onboarding to configure tenant governance and create tenants."
            : "Single-tenant mode is active. To start as multi-tenant, set DEPLOYMENT_MODE=multi_tenant for the API before completing onboarding.";

    private static string NormalizeDeploymentMode(string? deploymentMode) =>
        string.Equals(deploymentMode, "MultiTenant", StringComparison.OrdinalIgnoreCase)
            ? "MultiTenant"
            : "SingleTenant";

    private async Task CompleteOnboardingAsync()
    {
        if (IsCompleteDisabled)
        {
            _errorMessage = "Please choose how you want to set up your first host before completing onboarding.";
            return;
        }

        _isSaving = true;
        _completeButtonLabel = "Saving...";
        _errorMessage = null;

        var completion = new OnboardingCompletionModel
        {
            DeploymentMode = _deploymentMode,
            InstanceName = string.IsNullOrWhiteSpace(_instanceName) ? null : _instanceName.Trim()
        };

        // Proactively refresh the BFF auth session so the access token forwarded to the API is fresh.
        // The setup form can sit open for minutes while the user reads guidance, and Keycloak access
        // tokens have short lifetimes (often 1-5 min). Without this, the API's [Authorize] rejects
        // the Complete command with 401, and we'd have to redirect the user back through /login,
        // losing their form data. See docs/SECURITY.md on token forwarding.
        var preRefreshed = await InstanceOnboardingService.RefreshAuthSessionAsync();
        if (!preRefreshed)
        {
            Logger.LogWarning("Pre-complete auth session refresh failed. Aborting Complete and redirecting to login.");
            _isSaving = false;
            _completeButtonLabel = "Complete Instance Onboarding";
            _errorMessage = "Your session expired. Please sign in again to complete setup.";
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        var response = await InstanceOnboardingService.CompleteAsync(completion);

        // Retry once on 401: the refresh may not have landed before the request left the circuit,
        // or the token just rotated. A second refresh + retry eliminates the common transient case
        // without forcing the user back through /login and losing their onboarding choices.
        if (response.StatusCode == 401)
        {
            Logger.LogInformation("Complete returned 401 after pre-refresh. Retrying once with forced refresh.");
            var retryRefreshed = await InstanceOnboardingService.RefreshAuthSessionAsync();
            if (retryRefreshed)
            {
                response = await InstanceOnboardingService.CompleteAsync(completion);
            }
            else
            {
                Logger.LogWarning("Retry auth session refresh failed after Complete returned 401.");
            }
        }

        _isSaving = false;
        _completeButtonLabel = "Complete Instance Onboarding";

        if (response.StatusCode == 401)
        {
            // Session truly dead (refresh token rotated out by Keycloak). Only now redirect to login.
            _errorMessage = "Your session expired. Please sign in again to complete setup.";
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        if (response.Success)
        {
            var refreshed = await InstanceOnboardingService.RefreshAuthSessionAsync();
            if (!refreshed)
            {
                Logger.LogWarning("Instance onboarding completed but BFF auth session refresh failed. Falling back to API-backed admin checks.");
            }

            Snackbar.Add("Instance onboarding completed.", Severity.Success);
            await NavigatePostCompletionAsync();
            return;
        }

        _errorMessage = string.IsNullOrWhiteSpace(response.Message)
            ? "Failed to complete onboarding."
            : response.Message;
    }

    private async Task NavigatePostCompletionAsync()
    {
        // forceLoad: true ensures the first destination request uses the freshly renewed cookie
        // after the BFF refresh-session endpoint re-issued admin claims.
        if (IsMultiTenantMode)
        {
            Navigation.NavigateTo("/admin/instance/settings", forceLoad: true);
            return;
        }

        switch (_firstHostSetupChoice)
        {
            case FirstHostSetupChoice.Organization:
                Snackbar.Add("Complete your organization profile now to publish events as an organization.", Severity.Info);
                Navigation.NavigateTo("/organizations/create", forceLoad: true);
                return;

            case FirstHostSetupChoice.GroupQuickSetup:
            {
                var created = await TryCreateQuickGroupAsync();
                if (created)
                {
                    Snackbar.Add("Starter group created. You can now publish events under your group.", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Could not create the starter group automatically. You can set up a group later.", Severity.Warning);
                }

                Navigation.NavigateTo("/events", forceLoad: true);
                return;
            }

            case FirstHostSetupChoice.Personal:
                Snackbar.Add("You can publish events under your account immediately.", Severity.Info);
                Navigation.NavigateTo("/events", forceLoad: true);
                return;

            case FirstHostSetupChoice.DoLater:
            default:
                Snackbar.Add("You can set up a group or organization later from your account area.", Severity.Info);
                Navigation.NavigateTo("/events", forceLoad: true);
                return;
        }
    }

    private async Task<bool> TryCreateQuickGroupAsync()
    {
        var groupName = BuildDefaultGroupName();
        return await GroupService.CreateGroupAsync(groupName, "Starter group created during instance onboarding.");
    }

    private string BuildDefaultGroupName()
    {
        var fullName = string.Join(" ", new[] { _currentUser?.FirstName, _currentUser?.LastName }
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s!.Trim()));

        if (!string.IsNullOrWhiteSpace(fullName))
        {
            return $"{fullName}'s Group";
        }

        if (!string.IsNullOrWhiteSpace(_currentUser?.Username))
        {
            return $"{_currentUser.Username!.Trim()}'s Group";
        }

        return "My Group";
    }

    private HttpClient CreateBffSelfClient()
    {
        var client = HttpClientFactory.CreateClient("BffSelfClient");
        client.BaseAddress = new Uri(Navigation.BaseUri);
        return client;
    }

    private IJSObjectReference? _bffModule;

    private async Task<IJSObjectReference> GetBffModuleAsync()
    {
        _bffModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/js/bff.js");
        return _bffModule;
    }

}
