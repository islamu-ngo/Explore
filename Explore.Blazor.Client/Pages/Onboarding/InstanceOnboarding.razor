@page "/onboarding/instance"
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Explore.Blazor.Client.Models.Responses
@using Explore.Blazor.Client.Components.Forms
@layout SetupLayout
@attribute [Authorize]
@rendermode InteractiveServer
@inject IInstanceOnboardingService InstanceOnboardingService
@inject IUserService UserService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<InstanceOnboarding> Logger
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Instance Onboarding</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-2">Launch Your Site</MudText>
        <MudText Typo="Typo.body1" Class="mb-4">
            Add the minimum public profile, review launch readiness, and hand off to the first useful destination.
        </MudText>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        @if (!string.IsNullOrWhiteSpace(_syncWarning))
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">@_syncWarning</MudAlert>
        }

        @if (_isLoading)
        {
            <MudStack Spacing="3">
                <MudSkeleton Width="50%" Height="20px" Class="mb-1" />
                <MudStack Direction="Direction.Row" Spacing="2" Class="mb-4">
                    @for (int i = 0; i < 4; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" />
                        @if (i < 3) { <MudSkeleton Width="60px" Height="4px" Class="align-self-center" /> }
                    }
                </MudStack>
                <MudSkeleton Width="40%" Height="28px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="56px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="56px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="40px" Class="mb-2" />
                <MudSkeleton Width="100%" Height="40px" />
            </MudStack>
        }
        else
        {
            <MudStepper @bind-ActiveIndex="_activeStep"
                        NonLinear="false"
                        ShowResetButton="false">
                <ChildContent>
                    <MudStep Title="Site Profile">
                    <EditForm EditContext="_profileEditContext" OnValidSubmit="ContinueToPreflightAsync">
                        <DataAnnotationsValidator />
                        <MudStack Spacing="3">
                            <MudText Typo="Typo.h6">Name Your Site</MudText>
                            <MudText Typo="Typo.body2">
                                This is the public identity visitors see first. Everything else can be refined after launch.
                            </MudText>

                            <MudAlert Severity="@(IsMultiTenantMode ? Severity.Info : Severity.Success)" Dense="true" Variant="Variant.Outlined">
                                @GetDeploymentModeNotice()
                            </MudAlert>

                            <ValidationSummary />

                            <MudTextField T="string" Label="Site Name (Required)"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          RequiredError="Site name is required."
                                          For="@(() => _siteProfile.SiteName)"
                                          @bind-Value="_siteProfile.SiteName"
                                          Placeholder="e.g. ISLAMU Explore, My Community Events" />
                            <ValidationMessage For="@(() => _siteProfile.SiteName)" />

                            <MudTextField T="string" Label="Support Email (Optional)"
                                          Variant="Variant.Outlined"
                                          For="@(() => _siteProfile.SupportEmail)"
                                          @bind-Value="_siteProfile.SupportEmail"
                                          Placeholder="support@example.org" />
                            <ValidationMessage For="@(() => _siteProfile.SupportEmail)" />

                            <MudTextField T="string" Label="Canonical URL (Optional)"
                                          Variant="Variant.Outlined"
                                          For="@(() => _siteProfile.CanonicalUrl)"
                                          @bind-Value="_siteProfile.CanonicalUrl"
                                          Placeholder="https://events.example.org" />
                            <ValidationMessage For="@(() => _siteProfile.CanonicalUrl)" />

                            <MudTextField T="string" Label="Purpose (Optional)"
                                          Variant="Variant.Outlined"
                                          Lines="3"
                                          For="@(() => _siteProfile.Purpose)"
                                          @bind-Value="_siteProfile.Purpose"
                                          Placeholder="A short note for future admins about what this site is for." />
                            <ValidationMessage For="@(() => _siteProfile.Purpose)" />

                            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Text">
                                Onboarding will apply safe launch defaults for the public event catalog. Advanced modules,
                                policies, domains, federation, and branding remain available in instance settings.
                            </MudAlert>
                        </MudStack>
                    </EditForm>
                    </MudStep>

                    <MudStep Title="Preflight">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h6">Launch Readiness</MudText>
                        <MudText Typo="Typo.body2">
                            Critical checks must pass before launch. Operational warnings can be handled after the site is online.
                        </MudText>

                        @if (_isPreflightLoading)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                        }
                        else if (_preflight is null)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                Preflight data is not available. Go back and try again.
                            </MudAlert>
                        }
                        else
                        {
                            <MudAlert Severity="@(_preflight.IsReadyToLaunch ? Severity.Success : Severity.Error)" Variant="Variant.Outlined">
                                @(_preflight.IsReadyToLaunch ? "Ready to launch with convention defaults." : "Resolve blocking checks before completing onboarding.")
                            </MudAlert>

                            <MudText Typo="Typo.subtitle2">Blocking Checks</MudText>
                            @foreach (var check in _preflight.BlockingChecks)
                            {
                                <MudAlert Severity="@GetCheckSeverity(check)" Dense="true" Variant="Variant.Text">
                                    <strong>@check.Name:</strong> @check.Message
                                </MudAlert>
                            }

                            @if (_preflight.WarningChecks.Count > 0)
                            {
                                <MudText Typo="Typo.subtitle2">Operational Warnings</MudText>
                                @foreach (var check in _preflight.WarningChecks)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Text">
                                        <strong>@check.Name:</strong> @check.Message
                                    </MudAlert>
                                }
                            }
                        }
                    </MudStack>
                    </MudStep>

                    <MudStep Title="Launch">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h6">Your Site Is Ready</MudText>
                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
                            Onboarding is complete. Start with the public event catalog, then tune advanced settings when you are ready.
                        </MudAlert>
                        <MudText Typo="Typo.body2"><strong>Site:</strong> @_siteProfile.SiteName</MudText>
                        <MudText Typo="Typo.body2"><strong>Mode:</strong> @(IsSingleTenantMode ? "Single Tenant" : "Multi Tenant")</MudText>
                        <MudStack Direction="Direction.Row" Spacing="2">
                            <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" Href="/events" StartIcon="@Icons.Material.Filled.Event">
                                Browse Events
                            </MudButton>
                            <MudButton Elevation="0" Href="/admin/instance/settings"
                                       Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.Settings">
                                Open Instance Settings
                            </MudButton>
                        </MudStack>
                    </MudStack>
                    </MudStep>
                </ChildContent>

                <ActionContent Context="stepper">
                    <MudButton Elevation="0" Variant="Variant.Text"
                               Color="Color.Default"
                               Disabled="@(_activeStep == 0 || _submitState.IsSubmitting)"
                               OnClick="@(() => stepper.PreviousStepAsync())">
                        Back
                    </MudButton>
                    <MudSpacer />

                    @if (_activeStep == SiteProfileStepIndex)
                    {
                        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" OnClick="ContinueToPreflightAsync"
                                   Disabled="@(_submitState.IsSubmitting || _isPreflightLoading)">
                            Next
                        </MudButton>
                    }
                    else if (_activeStep == PreflightStepIndex)
                    {
                        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" OnClick="CompleteOnboardingAsync"
                                   Disabled="@(_submitState.IsSubmitting || _isPreflightLoading || _preflight?.IsReadyToLaunch != true)">
                            @_completeButtonLabel
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" Href="/events">
                            Go to Events
                        </MudButton>
                    }
                </ActionContent>
            </MudStepper>
        }
    </MudPaper>
</MudContainer>

@code {
    private const int SiteProfileStepIndex = 0;
    private const int PreflightStepIndex = 1;
    private const int LaunchStepIndex = 2;
    private string _deploymentMode = "SingleTenant";
    private readonly SelfHostOnboardingProfileModel _siteProfile = new();
    private EditContext _profileEditContext = default!;
    private OnboardingPreflightModel? _preflight;
    private bool _isLoading = true;
    private bool _isPreflightLoading;
    private FormSubmitState _submitState = new();
    private string? _errorMessage;
    private bool _setupSecretSynced;
    private string? _syncWarning;
    private int _activeStep;
    private string _completeButtonLabel = "Complete Instance Onboarding";

    private bool IsSingleTenantMode => _deploymentMode.Equals("SingleTenant", StringComparison.OrdinalIgnoreCase);
    private bool IsMultiTenantMode => _deploymentMode.Equals("MultiTenant", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _profileEditContext = new EditContext(_siteProfile);

        try
        {
            await UserService.SyncUserAsync();
            await UserService.GetCurrentUserAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not fully hydrate user context during instance onboarding.");
        }

        var status = await InstanceOnboardingService.GetStatusAsync();
        if (status?.IsCompleted == true)
        {
            Navigation.NavigateTo("/startup");
            return;
        }

        // Pre-populate from existing settings if available (e.g. restart after partial setup)
        try
        {
            var systemStatus = await InstanceOnboardingService.GetSystemOnboardingStatusAsync();
            _deploymentMode = NormalizeDeploymentMode(systemStatus?.DeploymentMode);

            var brandingResult = await InstanceOnboardingService.GetBrandingSettingsAsync();
            if (!string.IsNullOrWhiteSpace(brandingResult.DefaultBrandDisplayName))
            {
                _siteProfile.SiteName = brandingResult.DefaultBrandDisplayName;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load existing settings during instance onboarding. Using defaults.");
        }

        _isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _setupSecretSynced)
        {
            return;
        }

        var bffModule = await GetBffModuleAsync();

        for (var attempt = 0; attempt <= 3; attempt++)
        {
            if (attempt > 0)
            {
                await Task.Delay(TimeSpan.FromSeconds(attempt * 2));
            }

            var syncResult = await bffModule.InvokeAsync<BffMutationResult>("syncSetupSecret", (string?)null);
            if (syncResult is { Ok: true })
            {
                _setupSecretSynced = true;
                _syncWarning = null;
                StateHasChanged();
                return;
            }

            if (syncResult?.Status is 400 or 410)
            {
                var bffClient = CreateBffSelfClient();
                await bffClient.DeleteAsync("/bff/setup-secret");
                _errorMessage = "Setup secret expired or is invalid. Please enter the current setup secret again.";
                StateHasChanged();
                return;
            }
        }

        _syncWarning = "Setup secret sync pending — you can proceed, but saving may require re-entering your setup secret.";
        StateHasChanged();
    }

    private string GetDeploymentModeNotice() =>
        IsMultiTenantMode
            ? "Multi-tenant mode is active from deployment configuration. Complete onboarding to configure tenant governance and create tenants."
            : "Single-tenant mode is active. To start as multi-tenant, set DEPLOYMENT_MODE=multi_tenant for the API before completing onboarding.";

    private static string NormalizeDeploymentMode(string? deploymentMode) =>
        string.Equals(deploymentMode, "MultiTenant", StringComparison.OrdinalIgnoreCase)
            ? "MultiTenant"
            : "SingleTenant";

    private async Task ContinueToPreflightAsync()
    {
        _errorMessage = null;

        if (!_profileEditContext.Validate())
        {
            return;
        }

        await LoadPreflightAsync();
        _activeStep = PreflightStepIndex;
    }

    private async Task LoadPreflightAsync()
    {
        _isPreflightLoading = true;
        try
        {
            _preflight = await InstanceOnboardingService.GetOnboardingPreflightAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load onboarding preflight status.");
            _preflight = null;
        }
        finally
        {
            _isPreflightLoading = false;
        }
    }

    private async Task CompleteOnboardingAsync()
    {
        if (!_profileEditContext.Validate())
        {
            _activeStep = SiteProfileStepIndex;
            return;
        }

        if (_preflight?.IsReadyToLaunch != true)
        {
            _errorMessage = "Resolve blocking preflight checks before completing setup.";
            return;
        }

        _submitState.Start();
        _completeButtonLabel = "Saving...";
        _errorMessage = null;

        var completion = new OnboardingCompletionModel
        {
            DeploymentMode = _deploymentMode,
            SiteProfile = new SelfHostOnboardingProfileModel
            {
                SiteName = _siteProfile.SiteName.Trim(),
                SupportEmail = NormalizeOptional(_siteProfile.SupportEmail),
                CanonicalUrl = NormalizeOptional(_siteProfile.CanonicalUrl),
                Locale = string.IsNullOrWhiteSpace(_siteProfile.Locale) ? "en" : _siteProfile.Locale.Trim(),
                TimeZone = string.IsNullOrWhiteSpace(_siteProfile.TimeZone) ? "UTC" : _siteProfile.TimeZone.Trim(),
                Purpose = NormalizeOptional(_siteProfile.Purpose)
            },
            InstanceName = _siteProfile.SiteName.Trim()
        };

        // Proactively refresh the BFF auth session so the access token forwarded to the API is fresh.
        // The setup form can sit open for minutes while the user reads guidance, and Keycloak access
        // tokens have short lifetimes (often 1-5 min). Without this, the API's [Authorize] rejects
        // the Complete command with 401, and we'd have to redirect the user back through /login,
        // losing their form data. See docs/SECURITY-MODEL.md on token forwarding.
        var preRefreshed = await InstanceOnboardingService.RefreshAuthSessionAsync();
        if (!preRefreshed)
        {
            Logger.LogWarning("Pre-complete auth session refresh failed. Aborting Complete and redirecting to login.");
            _submitState.Complete();
            _completeButtonLabel = "Complete Instance Onboarding";
            _errorMessage = "Your session expired. Please sign in again to complete setup.";
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        var response = await InstanceOnboardingService.CompleteAsync(completion);

        // Retry once on 401: the refresh may not have landed before the request left the circuit,
        // or the token just rotated. A second refresh + retry eliminates the common transient case
        // without forcing the user back through /login and losing their onboarding choices.
        if (response.StatusCode == 401)
        {
            Logger.LogInformation("Complete returned 401 after pre-refresh. Retrying once with forced refresh.");
            var retryRefreshed = await InstanceOnboardingService.RefreshAuthSessionAsync();
            if (retryRefreshed)
            {
                response = await InstanceOnboardingService.CompleteAsync(completion);
            }
            else
            {
                Logger.LogWarning("Retry auth session refresh failed after Complete returned 401.");
            }
        }

        _submitState.Complete();
        _completeButtonLabel = "Complete Instance Onboarding";

        if (response.StatusCode == 401)
        {
            // Session truly dead (refresh token rotated out by Keycloak). Only now redirect to login.
            _errorMessage = "Your session expired. Please sign in again to complete setup.";
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        if (response.Success)
        {
            var refreshed = await InstanceOnboardingService.RefreshAuthSessionAsync();
            if (!refreshed)
            {
                Logger.LogWarning("Instance onboarding completed but BFF auth session refresh failed. Falling back to API-backed admin checks.");
            }

            Snackbar.Add("Instance onboarding completed.", Severity.Success);
            _activeStep = LaunchStepIndex;
            return;
        }

        _errorMessage = string.IsNullOrWhiteSpace(response.Message)
            ? "Failed to complete onboarding."
            : response.Message;
    }

    private static Severity GetCheckSeverity(OnboardingPreflightCheckModel check) =>
        check.Status.Equals("Pass", StringComparison.OrdinalIgnoreCase)
            ? Severity.Success
            : Severity.Error;

    private static string? NormalizeOptional(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private HttpClient CreateBffSelfClient()
    {
        var client = HttpClientFactory.CreateClient("BffSelfClient");
        client.BaseAddress = new Uri(Navigation.BaseUri);
        return client;
    }

    private IJSObjectReference? _bffModule;

    private async Task<IJSObjectReference> GetBffModuleAsync()
    {
        _bffModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/js/bff.js");
        return _bffModule;
    }

}
