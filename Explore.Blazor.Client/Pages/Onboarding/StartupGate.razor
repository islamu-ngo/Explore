@page "/startup"
@using MudBlazor
@inject IInstanceOnboardingService InstanceOnboardingService
@inject ITenantOnboardingService TenantOnboardingService
@inject IPublicExperienceService PublicExperienceService
@inject NavigationManager Navigation
@inject ILogger<StartupGate> Logger

<MudContainer Class="d-flex justify-center align-center" Style="min-height: 60vh;">
    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
            @_error
        </MudAlert>
    }
    else
    {
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.h6">Preparing your workspace...</MudText>
            <MudText Typo="Typo.caption">Checking instance and tenant onboarding status.</MudText>
        </MudStack>
    }
</MudContainer>

@code {
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await ResolveStartupRouteAsync();
    }

    private async Task ResolveStartupRouteAsync()
    {
        try
        {
            var instanceStatus = await InstanceOnboardingService.GetStatusAsync();
            if (instanceStatus == null)
            {
                _error = "Could not determine onboarding status. Try refreshing.";
                return;
            }

            if (!instanceStatus.IsCompleted)
            {
                Navigation.NavigateTo("/setup");
                return;
            }

            if (instanceStatus.IsAuthenticated)
            {
                if (instanceStatus.SelectedDeploymentMode?.Equals("MultiTenant", StringComparison.OrdinalIgnoreCase) == true)
                {
                    var tenantStatus = await TenantOnboardingService.GetStatusAsync();
                    if (tenantStatus != null &&
                        !tenantStatus.IsCompleted &&
                        (tenantStatus.IsCurrentUserTenantAdministrator || tenantStatus.IsCurrentUserPlatformAdministrator))
                    {
                        Navigation.NavigateTo("/onboarding/tenant");
                        return;
                    }
                }
            }

            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Startup routing failed.");
            _error = "Startup routing failed. Try refreshing.";
        }
    }
}
