@* ABOUTME: Public group profile with banner, subscription affordance, and group-hosted events. *@
@* ABOUTME: Reuses shared EventList cards and the event preview workspace for group event browsing. *@
@using MudBlazor
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Components.Events
@using Explore.Blazor.Client.Helpers
@using Explore.Blazor.Client.Shared
@using Blazouter.Services
@attribute [StreamRendering]

<PageTitle>@(_group?.FullName ?? "Group Profile")</PageTitle>

@if (_isLoading)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </MudContainer>
}
else if (_group == null)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
        <div role="alert">
            <MudAlert Severity="Severity.Error">Group not found.</MudAlert>
        </div>
    </MudContainer>
}
else
{
    <div class="group-profile">
        @* ── Banner Section ── *@
        <div class="group-profile__banner" style="@_bannerStyle"></div>

        <MudContainer MaxWidth="MaxWidth.Large" Class="group-profile__container">
            @* ── Header: Avatar + Info + Subscribe ── *@
            <div class="group-profile__header">
                <div class="group-profile__avatar-wrapper">
                    @if (!string.IsNullOrEmpty(_group.ActorProfilePictureUri))
                    {
                        <MudImage Src="@_group.ActorProfilePictureUri"
                                  Alt="@($"{_group.FullName} Logo")"
                                  Class="group-profile__avatar"
                                  ObjectFit="ObjectFit.Cover" />
                    }
                    else
                    {
                        <MudImage Src="@GetGroupPlaceholder()"
                                  Alt="Group Logo"
                                  Class="group-profile__avatar"
                                  ObjectFit="ObjectFit.Cover" />
                    }
                </div>

                <div class="group-profile__header-right">
                    <ActorSubscriptionButton TargetActorId="@_group.ActorId"
                                             TargetName="@_group.FullName"
                                             CanSubscribe="@_group.HasHalLink("subscribe")"
                                             CanViewSubscription="@_group.HasHalLink("subscription")"
                                             CssClass="group-profile__subscribe-btn" />
                </div>
            </div>

            @* ── Name + Description ── *@
            <div class="group-profile__identity">
                <MudText Typo="Typo.h4" HtmlTag="h1" Style="font-weight: 700;" Class="mb-1">@_group.FullName</MudText>

                @if (!string.IsNullOrEmpty(_group.Description))
                {
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-1">@_group.Description</MudText>
                }
            </div>

            <MudDivider Class="my-6" />

            @if (_isLoadingEvents)
            {
                <div class="group-profile__section">
                    <MudText Typo="Typo.h5" Class="mb-4" Style="font-weight: 700;">Upcoming Events</MudText>
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                </div>
            }
            else if (ProfileEvents.Any())
            {
                <EventPreviewWorkspace @ref="_eventPreviewWorkspace" NavigationEvents="@ProfileEvents">
                    <div class="group-profile__section">
                        <MudText Typo="Typo.h5" Class="mb-4" Style="font-weight: 700;">Upcoming Events</MudText>

                        @if (_upcomingEvents.Any())
                        {
                            <EventCardList Events="@_upcomingEvents"
                                           SelectedEventId="@(_eventPreviewWorkspace?.SelectedEventId)"
                                           AriaLabel="Upcoming group events"
                                           OnEventSelected="HandleEventSelected"
                                           OnShareRequested="HandleEventShare" />
                        }
                        else
                        {
                            <MudPaper Elevation="0" Class="pa-6 text-center border-solid border-1 mud-border-lines-default rounded-lg">
                                <MudIcon Icon="@Icons.Material.Outlined.EventBusy" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                                <MudText Typo="Typo.body1" Color="Color.Secondary">No upcoming events</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Subscribe to get notified when new events are posted.</MudText>
                            </MudPaper>
                        }
                    </div>

                    @if (_pastEvents.Any())
                    {
                        <MudDivider Class="my-6" />

                        <div class="group-profile__section">
                            <MudText Typo="Typo.h5" Class="mb-6" Style="font-weight: 700;">Past Events</MudText>

                            <div class="group-profile__timeline">
                                @foreach (var dateGroup in _pastEventsByDate)
                                {
                                    <div class="group-profile__timeline-group">
                                        <div class="group-profile__timeline-date">
                                            <div class="group-profile__timeline-dot"></div>
                                            <div class="group-profile__timeline-date-text">
                                                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">
                                                    @dateGroup.Key.ToString("MMM dd, yyyy")
                                                </MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @dateGroup.Key.ToString("dddd")
                                                </MudText>
                                            </div>
                                        </div>

                                        <div class="group-profile__timeline-events">
                                            <EventCardList Events="@dateGroup.Value"
                                                           SelectedEventId="@(_eventPreviewWorkspace?.SelectedEventId)"
                                                           AriaLabel="@($"Past group events on {dateGroup.Key:MMM dd, yyyy}")"
                                                           OnEventSelected="HandleEventSelected"
                                                           OnShareRequested="HandleEventShare" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </EventPreviewWorkspace>
            }
            else
            {
                <div class="group-profile__section">
                    <MudText Typo="Typo.h5" Class="mb-4" Style="font-weight: 700;">Upcoming Events</MudText>
                    <MudPaper Elevation="0" Class="pa-6 text-center border-solid border-1 mud-border-lines-default rounded-lg">
                        <MudIcon Icon="@Icons.Material.Outlined.EventBusy" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                        <MudText Typo="Typo.body1" Color="Color.Secondary">No upcoming events</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Subscribe to get notified when new events are posted.</MudText>
                    </MudPaper>
                </div>
            }
        </MudContainer>
    </div>
}
