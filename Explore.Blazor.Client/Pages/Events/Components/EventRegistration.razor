@inject IEventService EventService
@inject IUserService UserService
@inject ISnackbar Snackbar
<MudDialog Class="registration-dialog">
    <DialogContent>
        @if (isLoading)
        {
            <div class="registration-shell" style="text-align: center; padding: 48px;">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.body1" style="margin-top: 16px;">
                    Checking registration status...
                </MudText>
            </div>
        }
        else if (isAlreadyRegistered)
        {
            <div class="registration-shell">
                <div class="success-content">
                    <div class="success-icon">
                        <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Style="color: var(--mud-palette-success);" />
                    </div>
                    <MudText Typo="Typo.h4" Class="success-title">
                        You're Already Registered! ✅
                    </MudText>
                    <MudText Typo="Typo.body1" Class="success-message">
                        You have already registered for this event.<br />
                        We look forward to seeing you there!
                    </MudText>
                    <AppButton Size="Size.Large"
                               OnClick="Close"
                               StartIcon="@Icons.Material.Filled.Close">
                        Close
                    </AppButton>
                </div>
            </div>
        }
        else if (!isRegistered)
        {
            <div class="registration-shell">
                <MudText Typo="Typo.h5" Class="mb-2">@Title</MudText>
                <MudText Typo="Typo.body2" Class="mb-6 mud-text-secondary">
                    Click confirm to register for this event
                </MudText>

                @if (currentUser != null)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-4">
                        You will be registered as: <strong>@currentUser.FirstName @currentUser.LastName</strong> (@currentUser.Email)
                    </MudAlert>
                }

                <div class="action-buttons">
                    <AppButton Variant="Variant.Text"
                               Color="Color.Default"
                               OnClick="Cancel"
                               Disabled="isSubmitting">
                        Cancel
                    </AppButton>
                    <AppButton OnClick="HandleSubmit"
                               Disabled="isSubmitting || currentUser == null"
                               StartIcon="@(isSubmitting ? null : Icons.Material.Filled.CheckCircle)">
                        @if (isSubmitting)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Registering...</span>
                        }
                        else
                        {
                            <span>Confirm Registration</span>
                        }
                    </AppButton>
                </div>
            </div>
        }
        else
        {
            <div class="registration-shell">
                <div class="success-content">
                    <div class="success-icon">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                    </div>
                    <MudText Typo="Typo.h4" Class="success-title">
                        Registration Successful! 🎉
                    </MudText>
                    <MudText Typo="Typo.body1" Class="success-message">
                        Thank you for registering@(currentUser != null ? $", {currentUser.FirstName}" : "")! <br />
                        You will receive a confirmation email shortly.
                    </MudText>
                    <AppButton Size="Size.Large"
                               OnClick="Close"
                               StartIcon="@Icons.Material.Filled.Close">
                        Close
                    </AppButton>
                </div>
            </div>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private MudBlazor.IDialogReference? DialogReference { get; set; }

    [Parameter]
    public Guid EventSessionId { get; set; }

    [Parameter]
    public string Title { get; set; } = "Register for Event";

    private CreateEventRegistrationDto registrationModel = new();
    private UserDto? currentUser;
    private bool isSubmitting = false;
    private bool isRegistered = false;
    private bool isAlreadyRegistered = false;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Get current user
            currentUser = await UserService.GetCurrentUserAsync();

            if (currentUser != null)
            {
                registrationModel.EventSessionId = EventSessionId;
                registrationModel.UserId = currentUser.Id;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading user data: {ex.Message}", Severity.Warning);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (currentUser == null)
        {
            Snackbar.Add("You must be logged in to register.", Severity.Error);
            return;
        }

        if (EventSessionId == Guid.Empty)
        {
            Snackbar.Add("Registration is unavailable for this session.", Severity.Error);
            return;
        }

        isSubmitting = true;

        try
        {
            var response = await EventService.RegisterForEventSessionAsync(registrationModel);

            if (response?.Success == true)
            {
                isRegistered = true;
                Snackbar.Add("You have been successfully registered!", Severity.Success);
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Something went wrong. Please try again later.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Registration error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        DialogReference?.Close();
    }

    private void Close()
    {
        DialogReference?.Close();
    }
}
