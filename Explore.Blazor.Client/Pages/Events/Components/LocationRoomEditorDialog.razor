@* ABOUTME: Dialog for creating/editing a LocationRoom. Fields: name, capacity, description, sort order. *@
@* ABOUTME: Used by LocationRoomManager for both create and edit flows. *@

@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Contracts.Services.Events
@using Microsoft.AspNetCore.Components.Forms
@using Explore.Blazor.Client.Components.Forms

@inject ILocationRoomService RoomService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.MeetingRoom" />
            <MudText Typo="Typo.h6">@(IsNew ? "Add Room" : "Edit Room")</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_isLoadingDetail)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <EditForm EditContext="_editContext">
                <FormSubmissionGuard State="@_submitState">
                <AppValidationSummary />
                <MudStack Spacing="3">
                    <MudTextField T="string"
                                  @bind-Value="_model.Name"
                                  Label="Room Name"
                                  Placeholder="e.g. Main Hall, Room A, Workshop Space"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Room name is required"
                                  FullWidth="true" />

                    <MudTextField T="string"
                                  @bind-Value="_model.Slug"
                                  Label="Slug"
                                  Placeholder="auto-generated if blank"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />

                    <MudNumericField T="int?"
                                     @bind-Value="_model.Capacity"
                                     Label="Capacity"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="0"
                                     Placeholder="0 = unlimited" />

                    <MudTextField T="string"
                                  @bind-Value="_model.Description"
                                  Label="Description"
                                  Placeholder="Optional room description"
                                  Variant="Variant.Outlined"
                                  Lines="2"
                                  FullWidth="true" />

                    <MudNumericField T="int?"
                                     @bind-Value="_model.SortOrder"
                                     Label="Sort Order"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Min="1" />
                </MudStack>
                </FormSubmissionGuard>
            </EditForm>

        }
    </DialogContent>
    <DialogActions>
        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Text" OnClick="Cancel" Disabled="_submitState.IsSubmitting">Cancel</MudButton>
        <MudButton Elevation="0" Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Save"
                   Disabled="_submitState.IsSubmitting">
            @if (_submitState.IsSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(IsNew ? "Add" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public Guid LocationId { get; set; }
    [Parameter] public Guid? RoomId { get; set; }
    [Parameter] public bool IsNew { get; set; } = true;
    [Parameter] public int InitialSortOrder { get; set; } = 1;

    private bool _isLoadingDetail;

    private EditContext _editContext = default!;
    private FormSubmitState _submitState = new();
    private ServerValidationErrorStore _errorStore = new();

    private CreateLocationRoomDto _model = new();

    protected override async Task OnInitializedAsync()
    {
        _model.SortOrder = InitialSortOrder;
        _model.LocationId = LocationId;

        if (!IsNew && RoomId.HasValue)
        {
            _isLoadingDetail = true;
            var room = await RoomService.GetRoomByIdAsync(RoomId.Value);
            if (room != null)
            {
                _model.Name = room.Name;
                _model.Slug = room.Slug ?? string.Empty;
                _model.Description = room.Description ?? string.Empty;
                _model.Capacity = room.Capacity ?? 0;
                _model.SortOrder = room.SortOrder;
            }
            _isLoadingDetail = false;
        }

        _editContext = new EditContext(_model);
        _errorStore.Init(_editContext);
    }

    private async Task Save()
    {
        if (_submitState.IsSubmitting) return;
        if (!_editContext.Validate()) return;

        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _submitState.Fail("Room name is required.");
            return;
        }

        _submitState.Start();

        try
        {
            if (IsNew)
            {
                var dto = new CreateLocationRoomDto
                {
                    LocationId = LocationId,
                    Name = _model.Name.Trim(),
                    Slug = string.IsNullOrWhiteSpace(_model.Slug) ? null : _model.Slug.Trim(),
                    Description = string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description,
                    Capacity = _model.Capacity,
                    SortOrder = _model.SortOrder
                };

                var result = await RoomService.CreateRoomAsync(dto);
                if (result?.Success == true)
                {
                    MudDialog.Close(DialogResult.Ok(result.Id));
                }
                else
                {
                    _submitState.Fail(result?.Message ?? "Failed to create room.");
                }
            }
            else if (RoomId.HasValue)
            {
                var dto = new UpdateLocationRoomDto
                {
                    Name = _model.Name.Trim(),
                    Slug = string.IsNullOrWhiteSpace(_model.Slug) ? null : _model.Slug.Trim(),
                    Description = string.IsNullOrWhiteSpace(_model.Description) ? null : _model.Description,
                    Capacity = _model.Capacity,
                    SortOrder = _model.SortOrder
                };

                var result = await RoomService.UpdateRoomAsync(RoomId.Value, dto);
                if (result?.Success == true)
                {
                    MudDialog.Close(DialogResult.Ok(result.Id));
                }
                else
                {
                    _submitState.Fail(result?.Message ?? "Failed to update room.");
                }
            }
        }
        catch (ApiException ex)
        {
            if (!_errorStore.HandleApiError(ex))
            {
                _submitState.Fail($"Failed to save room: {ex.Message}");
            }
            else
            {
                _submitState.Fail("Please fix the validation errors below.");
            }
        }
        catch (Exception ex)
        {
            _submitState.Fail($"Error: {ex.Message}");
        }
        finally
        {
            if (!_submitState.HasError)
            {
                _submitState.Complete();
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
