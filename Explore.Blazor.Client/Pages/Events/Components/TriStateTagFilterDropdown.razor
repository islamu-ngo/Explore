@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Models

@{
    RenderFragment filterBody = @<text>
        @* Search + Reset controls *@
        <div class="d-flex align-center gap-2 mb-2">
            <MudTextField @bind-Value="_searchTerm"
                          Placeholder="Search tags..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="flex-grow-1" />
            <MudButton Variant="Variant.Text"
                       Color="MudBlazor.Color.Warning"
                       Size="Size.Small"
                       OnClick="ClearVisible"
                       Disabled="@(!HasActiveFilters())">
                Clear Visible
            </MudButton>
            <MudButton Variant="Variant.Text"
                       Color="MudBlazor.Color.Error"
                       Size="Size.Small"
                       OnClick="ResetAll"
                       Disabled="@(!HasActiveFilters())">
                Reset All
            </MudButton>
        </div>

        <MudText Typo="Typo.caption" Class="mb-3" Style="opacity: 0.6;">
            Click: include → exclude → clear
        </MudText>

        @* Tag groups with MangaDex-style section headers *@
        @foreach (var group in GetFilteredGroups())
        {
            <div class="d-flex align-center gap-2 mb-1 mt-2">
                <MudText Typo="Typo.subtitle2" Style="white-space: nowrap; font-weight: 600;">@group.FullName</MudText>
                <MudDivider Class="flex-grow-1" />
            </div>
            <div class="d-flex flex-wrap gap-1 mb-2">
                @foreach (var tag in group.Tags)
                {
                    if (tag.Id.HasValue)
                    {
                        var tagId = tag.Id.Value;
                        var state = GetTagState(tagId);
                        <MudChip T="string"
                                 Color="@GetChipColor(state)"
                                 Variant="@GetChipVariant(state)"
                                 Icon="@GetChipIcon(state)"
                                 Size="Size.Small"
                                 OnClick="@(() => ToggleTagState(tagId))">
                            @tag.FullName
                        </MudChip>
                    }
                }
            </div>
        }

        @if (!GetFilteredGroups().Any())
        {
            <MudText Typo="Typo.body2" Class="pa-4" Align="Align.Center" Style="opacity: 0.5;">
                No tags match your search.
            </MudText>
        }

        @* Other Options: Inclusion/Exclusion mode (MangaDex-style select dropdowns) *@
        <div class="d-flex align-center gap-2 mb-1 mt-3">
            <MudText Typo="Typo.subtitle2" Style="white-space: nowrap; font-weight: 600;">Other Options</MudText>
            <MudDivider Class="flex-grow-1" />
        </div>
        <div class="d-flex gap-4 mb-2">
            <div class="d-flex align-center gap-1">
                <MudText Typo="Typo.caption" Style="white-space: nowrap;">Inclusion mode</MudText>
                <MudSelect T="string" @bind-Value="_inclusionMode" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width: 80px;" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("and")">And</MudSelectItem>
                    <MudSelectItem Value="@("or")">Or</MudSelectItem>
                </MudSelect>
            </div>
            <div class="d-flex align-center gap-1">
                <MudText Typo="Typo.caption" Style="white-space: nowrap;">Exclusion mode</MudText>
                <MudSelect T="string" @bind-Value="_exclusionMode" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width: 80px;" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@("or")">Or</MudSelectItem>
                    <MudSelectItem Value="@("and")">And</MudSelectItem>
                </MudSelect>
            </div>
        </div>
    </text>;
}

@if (!Inline)
{
    <div class="tri-state-tag-filter" style="position: relative;">
        @* Trigger Button with live badge *@
        <MudButton Variant="Variant.Outlined"
                   Color="@(HasActiveFilters() ? MudBlazor.Color.Primary : MudBlazor.Color.Default)"
                   StartIcon="@Icons.Material.Filled.Label"
                   EndIcon="@(_isOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                   OnClick="TogglePopover"
                   Size="Size.Small"
                   FullWidth="true"
                   Class="tri-state-tag-filter__trigger">
            @GetBadgeText()
        </MudButton>

        @* Overlay for click-outside-to-close *@
        <MudOverlay Visible="_isOpen" OnClick="ClosePopover" LockScroll="false" />

        @* Popover content *@
        <MudPopover Open="_isOpen"
                    AnchorOrigin="Origin.BottomLeft"
                    TransformOrigin="Origin.TopLeft"
                    Class="tri-state-tag-filter__popover">
            <MudPaper Class="pa-4" Style="min-width: 400px; max-width: 600px; max-height: 60vh; overflow-y: auto;" Elevation="8">
                @filterBody
            </MudPaper>
        </MudPopover>
    </div>
}
else
{
    <div class="tri-state-tag-filter tri-state-tag-filter--inline">
        @filterBody
    </div>
}
