@page "/events"

@rendermode InteractiveServer

@using MudBlazor

@using Explore.Blazor.Client.Components.Docking

@using Explore.Blazor.Client.Clients

@using Explore.Blazor.Client.Models

@using Explore.Blazor.Client.Services

@using Explore.Blazor.Client.Services.Docking

@using Explore.Blazor.Client.Pages.Events.Components

@using Explore.Blazor.Client.Helpers

@using Microsoft.AspNetCore.Components

@using Microsoft.AspNetCore.Components.Web.Virtualization

@using Microsoft.Extensions.Logging



<PageTitle>Explore Events</PageTitle>
<HeadContent>
    <link rel="canonical" href="@CanonicalUrlHelper.Build(Navigation, "/events")" />
</HeadContent>

<MudText Typo="Typo.h1" HtmlTag="h1" Class="sr-only">Explore Events</MudText>



<div class="event-list__dock-container">

        @* ── Main Content Area (workspace dock host owns customization panel track) ── *@
        <DockLayoutHost Scope="@DockScope.Workspace"
                        Class="event-list__workspace"
                        DataTestId="event-list-workspace-dock-host"
                        ContentDataTestId="event-list-workspace-content">
        <div class="event-list__page">

        <main class="event-list__main">

        <MudContainer Class="event-list-container pb-4" MaxWidth="MaxWidth.False" Gutters="false">



            @if (!string.IsNullOrEmpty(_errorMessage))

            {

                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-6 rounded-lg" ShowCloseIcon="true" CloseIconClicked="@(() => _errorMessage = null)">

                    @_errorMessage

                </MudAlert>

            }

            @if (!string.IsNullOrEmpty(_successMessage))

            {

                <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mb-6 rounded-lg" ShowCloseIcon="true" CloseIconClicked="@(() => _successMessage = null)">

                    @_successMessage

                </MudAlert>

            }



            @if (CuratedEventSections.Count > 0)
            {
                <section class="event-list__presets" aria-labelledby="event-list-presets-heading">
                    <div class="event-list__presets-header">
                        <MudText Typo="Typo.h6" HtmlTag="h2" Id="event-list-presets-heading">
                            Featured @EventCatalogLabel
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Choose a curated section to update the event filters.
                        </MudText>
                    </div>

                    <div class="event-list__preset-list" role="list" aria-label="Curated event filters">
                        @foreach (var curatedSection in CuratedEventSections)
                        {
                            <MudButton Href="@curatedSection.Url"
                                       Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@ResolvePresetIcon(curatedSection.Icon)"
                                       Class="@GetPresetChipClass(curatedSection)"
                                       aria-current="@(IsCurrentPreset(curatedSection) ? "page" : null)"
                                       aria-label="@GetPresetAriaLabel(curatedSection)">
                                @curatedSection.Label
                            </MudButton>
                        }
                    </div>
                </section>
            }



            <EventFilterBar @ref="_filterBar"

                            IsIslamicModuleEnabled="@_isIslamicModuleEnabled"

                            IsTechModuleEnabled="@_isTechModuleEnabled"

                            OnSearchRequested="@RefreshList"

                            CurrentLayout="@_currentLayout"

                            CurrentLayoutChanged="@OnLayoutModeChanged"

                            ResultCount="@_totalCount"

                            ShowResultCount="@(_eventsLoaded && HasActiveFilters())"

                            EventTypes="@eventTypes"

                            Categories="@categories"

                            CategoryGroups="@categoryGroups"

                            Locations="@locations"

                            EventFormats="@eventFormats"

                            Madhabs="@madhabs"

                            RegistrationModes="@registrationModes"

                            Languages="@languages"

                            Tags="@tags"

                            AudienceGenders="@audienceGenders"

                            AudienceAges="@audienceAges"

                            EventStatuses="@eventStatuses"

                            TagGroups="@tagGroups"

                            ShowCustomizationButton="@_showCustomizationButton"

                            OnCustomizationRequested="OpenCustomizationDrawer" />



            @{ var bp = GetGridBreakpoints(); }

            @if (_isLoadingPage)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
            }

            <MudGrid Spacing="0" Justify="Justify.FlexStart" Class="@GetGridCssClass()">
                @if (!_eventsLoaded)
                {
                    @for (int i = 0; i < (_currentLayout == LayoutMode.SingleRow ? 3 : 8); i++)
                    {
                        <MudItem xs="@bp.Xs" sm="@bp.Sm" md="@bp.Md" lg="@bp.Lg" xl="@bp.Xl">
                            <EventCardSkeleton Layout="@_currentLayout" />
                        </MudItem>
                    }
                }
                else if (_browseMode == BrowseMode.Pagination)
                {
                    @foreach (var evt in _pagedEvents)
                    {
                        <MudItem @key="evt.Id" xs="@bp.Xs" sm="@bp.Sm" md="@bp.Md" lg="@bp.Lg">
                            <EventCard Event="@evt"
                                       Layout="@_currentLayout"
                                       IsSelected="@(_selectedEvent?.Id == evt.Id && _detailDrawerOpen)"
                                       CardFieldVisibility="@_cardFieldVisibility"
                                        OnClick="SelectEvent"
                                        OnEditRequested="NavigateToEdit"
                                        OnDeleteRequested="OpenDeleteDialog"
                                        OnShareRequested="ShareEventAsync" />
                        </MudItem>
                    }
                }
                else
                {
                    <Virtualize @ref="_virtualize" ItemsProvider="LoadEventsAsync" ItemSize="350" OverscanCount="4" Context="evt">
                        <ItemContent>
                            <MudItem @key="evt.Id" xs="@bp.Xs" sm="@bp.Sm" md="@bp.Md" lg="@bp.Lg">
                                <EventCard Event="@evt"
                                           Layout="@_currentLayout"
                                           IsSelected="@(_selectedEvent?.Id == evt.Id && _detailDrawerOpen)"
                                           CardFieldVisibility="@_cardFieldVisibility"
                                            OnClick="SelectEvent"
                                            OnEditRequested="NavigateToEdit"
                                            OnDeleteRequested="OpenDeleteDialog"
                                            OnShareRequested="ShareEventAsync" />
                            </MudItem>
                        </ItemContent>
                        <Placeholder>
                            <MudItem xs="@bp.Xs" sm="@bp.Sm" md="@bp.Md" lg="@bp.Lg" xl="@bp.Xl">
                                <EventCardSkeleton Layout="@_currentLayout" />
                            </MudItem>
                        </Placeholder>
                    </Virtualize>
                }
            </MudGrid>

            @if (_browseMode == BrowseMode.Pagination && _eventsLoaded && _totalCount > 0)
            {
                <EventListPagination CurrentPage="@_currentPage"
                                     TotalPages="@((_totalCount + _pageSize - 1) / _pageSize)"
                                     PageSize="@_pageSize"
                                     TotalCount="@_totalCount"
                                     IsLoading="@_isLoadingPage"
                                     CurrentPageChanged="OnPageChanged"
                                     PageSizeChanged="OnPageSizeChanged" />
            }



            @if (_eventsLoaded && _totalCount == 0)

            {

                <div class="d-flex flex-column align-center justify-center py-16">

                    <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />

                    <MudText Typo="Typo.h5" Color="Color.Secondary" Align="Align.Center">@EmptyStateTitle</MudText>

                    <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center" Class="mt-2">

                        @EmptyStateMessage

                    </MudText>

                </div>

            }



            @* Result count moved to filter bar layout row *@



        </MudContainer>

    </main>

        </div> @* .event-list__page *@
        </DockLayoutHost>

    </div> @* .event-list__dock-container *@

@code {
    private RenderFragment RenderEventPreviewPanel => @<text>
@if (_selectedEvent != null)
            {
                <div class="event-list__detail-header d-flex align-center gap-1 px-2 py-1">
                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight"
                                   Size="Size.Small"
                                   OnClick="@HandleDrawerCloseClick"
                                   aria-label="Close" />

                    @* ── Prev / Next navigation arrows ── *@
                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp"
                                   Size="Size.Small"
                                   Disabled="@(!CanNavigatePrevEvent())"
                                   OnClick="@NavigatePrevEvent"
                                   aria-label="Previous event" />
                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown"
                                   Size="Size.Small"
                                   Disabled="@(!CanNavigateNextEvent())"
                                   OnClick="@NavigateNextEvent"
                                   aria-label="Next event" />

                    <div class="d-flex gap-2 mx-auto">
                        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.OpenInNew"
                                   OnClick="@(() => Navigation.NavigateTo($"/events/{_selectedEvent!.Id}"))">
                            Event Page
                        </MudButton>
                        <MudButton Elevation="0" Variant="Variant.Filled" Color="Color.Default"
                                   StartIcon="@Icons.Material.Outlined.ContentCopy"
                                   OnClick="@CopyEventLinkAsync">
                            Copy Link
                        </MudButton>
                    </div>

                    @* ── Three-dots menu (edit / delete) ── *@
                    @if (_selectedEvent.HasManagementLinks())
                    {
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            @if (_selectedEvent.HasHalLink("edit"))
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Edit"
                                             OnClick="@(() => NavigateToEdit(_selectedEvent))">
                                    Edit
                                </MudMenuItem>
                            }
                            @if (_selectedEvent.HasHalLink("delete"))
                            {
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error"
                                             OnClick="@(() => OpenDeleteDialog(_selectedEvent))">
                                    Delete
                                </MudMenuItem>
                            }
                        </MudMenu>
                    }
                </div>

                <div class="event-list__detail-body pa-4">

                    @* ── Event Image (3:4 ratio, centered) ── *@
                    <div class="event-list__detail-image-wrapper">
                        @if (HasDetailActualImage)
                        {
                            <img src="@GetFallbackEventImage(_selectedEvent)"
                                 alt=""
                                 style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block;" />
                        }
                        <img src="@GetDetailImageSrc()"
                             @onerror="HandleDetailImageError"
                             style="position:relative; width:100%; height:100%; object-fit:cover; display:block;"
                             alt="@_selectedEvent?.Title" />
                    </div>

                    @* ── Status & Type Chips ── *@
                    <div class="d-flex gap-2 flex-wrap mb-2">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="font-weight-bold">
                            @GetEventTypeName(_selectedEvent)
                        </MudChip>
                        @if (_isLoadingDetail)
                        {
                            <MudSkeleton Width="80px" Height="24px" />
                            <MudSkeleton Width="60px" Height="24px" />
                        }
                        else if (_selectedEventDetail != null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="GetStatusColor(_selectedEventDetail.EventStatusMasterCode)" Variant="Variant.Filled">
                                @_selectedEventDetail.EventStatusFullName
                            </MudChip>
                            @if (!string.IsNullOrEmpty(_selectedEventDetail.EventFormatFullName))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                    @_selectedEventDetail.EventFormatFullName
                                </MudChip>
                            }
                            @if (!string.IsNullOrEmpty(_selectedEventDetail.VisibilityTypeFullName))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                    @_selectedEventDetail.VisibilityTypeFullName
                                </MudChip>
                            }
                        }
                    </div>

                    @* ── Title & Subtitle ── *@
                    <MudText Typo="Typo.h6" Style="font-weight: 700; line-height: 1.3;" Class="mb-1">
                        @_selectedEvent.Title
                    </MudText>
                    @if (!string.IsNullOrEmpty(_selectedEvent.Subtitle))
                    {
                        <MudText Typo="Typo.subtitle2" Color="Color.Primary" Style="font-weight: 500;" Class="mb-3">
                            @_selectedEvent.Subtitle
                        </MudText>
                    }

                    @* ── Description ── *@
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4"
                             Style="overflow: hidden; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical;">
                        @GetTruncatedDescription(_selectedEvent.Description)
                    </MudText>

                    <MudDivider Class="mb-4" />

                    @* ── Core Info ── *@
                    <MudStack Spacing="3" Class="mb-4">
                        <div class="d-flex gap-3 align-center">
                            <MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Color="Color.Primary" Size="Size.Small" />
                            <div>
                                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Date</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @if (_selectedEvent.FirstSessionDate != null && _selectedEvent.LastSessionDate != null && _selectedEvent.FirstSessionDate != _selectedEvent.LastSessionDate)
                                    {
                                        @($"{_selectedEvent.FirstSessionDate?.ToString("MMM dd, yyyy")} — {_selectedEvent.LastSessionDate?.ToString("MMM dd, yyyy")}")
                                    }
                                    else
                                    {
                                        @(_selectedEvent.FirstSessionDate?.ToString("MMM dd, yyyy") ?? "TBD")
                                    }
                                </MudText>
                            </div>
                        </div>

                        <div class="d-flex gap-3 align-center">
                            <MudIcon Icon="@Icons.Material.Outlined.LocationOn" Color="Color.Primary" Size="Size.Small" />
                            <div>
                                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Location</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@GetLocationText(_selectedEvent)</MudText>
                            </div>
                        </div>

                        <div class="d-flex gap-3 align-center">
                            <MudIcon Icon="@Icons.Material.Outlined.People" Color="Color.Primary" Size="Size.Small" />
                            <div>
                                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Audience</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @GetAudienceText(_selectedEvent)
                                </MudText>
                            </div>
                        </div>

                        <div class="d-flex gap-3 align-center">
                            <MudIcon Icon="@((_selectedEvent.Price ?? 0) > 0 ? Icons.Material.Outlined.Payments : Icons.Material.Outlined.Payments)"
                                     Color="@((_selectedEvent.Price ?? 0) > 0 ? Color.Primary : Color.Success)" Size="Size.Small" />
                            <div>
                                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Price</MudText>
                                @if (_selectedEvent.Price.HasValue && _selectedEvent.Price > 0)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        @($"{_selectedEvent.CurrencyCode ?? "€"}{_selectedEvent.Price:F2}")
                                    </MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Success">Free</MudText>
                                }
                            </div>
                        </div>

                        @if (_isLoadingDetail)
                        {
                            <div class="d-flex gap-3 align-center">
                                <MudSkeleton SkeletonType="SkeletonType.Circle" Width="24px" Height="24px" />
                                <div style="flex: 1;">
                                    <MudSkeleton Width="60px" Height="16px" Class="mb-1" />
                                    <MudSkeleton Width="100px" Height="14px" />
                                </div>
                            </div>
                        }
                        else
                        {
                            @if (_selectedEventDetail?.TotalViews > 0)
                            {
                                <div class="d-flex gap-3 align-center">
                                    <MudIcon Icon="@Icons.Material.Outlined.Visibility" Color="Color.Primary" Size="Size.Small" />
                                    <div>
                                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Views</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@_selectedEventDetail.TotalViews?.ToString("N0")</MudText>
                                    </div>
                                </div>
                            }

                            @if (_selectedEventDetail?.MadhabFullName != null)
                            {
                                <div class="d-flex gap-3 align-center">
                                    <MudIcon Icon="@Icons.Material.Outlined.MenuBook" Color="Color.Primary" Size="Size.Small" />
                                    <div>
                                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Madhab</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@_selectedEventDetail.MadhabFullName</MudText>
                                    </div>
                                </div>
                            }

                            @if (_selectedEventDetail != null)
                            {
                                <div class="d-flex gap-3 align-center">
                                    <MudIcon Icon="@Icons.Material.Outlined.EventNote" Color="Color.Primary" Size="Size.Small" />
                                    <div>
                                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Program</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@GetProgramCountText(_selectedEventDetail, _selectedEventSessions)</MudText>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(_selectedEventDetail.Timezone))
                                {
                                    <div class="d-flex gap-3 align-center">
                                        <MudIcon Icon="@Icons.Material.Outlined.Language" Color="Color.Primary" Size="Size.Small" />
                                        <div>
                                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Timezone</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">@_selectedEventDetail.Timezone</MudText>
                                        </div>
                                    </div>
                                }

                                <div class="d-flex gap-3 align-center">
                                    <MudIcon Icon="@Icons.Material.Outlined.Rule" Color="Color.Primary" Size="Size.Small" />
                                    <div>
                                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Registration policy</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@GetRegistrationPolicyText(_selectedEventDetail)</MudText>
                                    </div>
                                </div>
                            }
                        }
                    </MudStack>

                    @* ── Skeleton placeholders for API-fetched sections ── *@
                    @if (_isLoadingDetail)
                    {
                        <MudDivider Class="mb-4" />
                        @* Organizer skeleton *@
                        <MudSkeleton Width="80px" Height="12px" Class="mb-2" />
                        <div class="d-flex gap-3 align-center mb-4">
                            <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px" />
                            <div style="flex: 1;">
                                <MudSkeleton Width="120px" Height="16px" Class="mb-1" />
                                <MudSkeleton Width="80px" Height="12px" />
                            </div>
                        </div>

                        <MudDivider Class="mb-4" />
                        @* Tags skeleton *@
                        <MudSkeleton Width="40px" Height="12px" Class="mb-2" />
                        <div class="d-flex gap-1 flex-wrap mb-4">
                            <MudSkeleton Width="60px" Height="24px" Class="rounded-pill" />
                            <MudSkeleton Width="80px" Height="24px" Class="rounded-pill" />
                            <MudSkeleton Width="50px" Height="24px" Class="rounded-pill" />
                        </div>

                        <MudDivider Class="mb-4" />
                        @* Session skeleton *@
                        <MudSkeleton Width="80px" Height="12px" Class="mb-2" />
                        <MudPaper Outlined="true" Class="pa-3 rounded-lg mb-4">
                            <MudSkeleton Width="60%" Height="16px" Class="mb-2" />
                            <MudSkeleton Width="100%" Height="14px" Class="mb-1" />
                            <MudSkeleton Width="80%" Height="14px" />
                        </MudPaper>
                    }
                    else
                    {
                        @* ── Actor / Organizer Info ── *@
                        @if (_selectedEventDetail?.ActorDisplayName != null)
                        {
                            var sidebarOrganizerUrl = GetActorProfileUrl(_selectedEventDetail!.ActorId, _selectedEventDetail.ActorTypeId);
                            <MudDivider Class="mb-4" />
                            <MudText Typo="Typo.overline" Class="mb-2" Style="font-weight: 600;">ORGANIZER</MudText>
                            <div class="@($"d-flex gap-3 align-center mb-4{(sidebarOrganizerUrl != null ? " cursor-pointer" : "")}")"
                                 @onclick="@(() => NavigateToActorProfile(_selectedEventDetail.ActorId, _selectedEventDetail.ActorTypeId))">
                                @if (!string.IsNullOrEmpty(_selectedEventDetail.ActorProfilePictureUri))
                                {
                                    <MudAvatar Size="Size.Medium">
                                        <MudImage Src="@_selectedEventDetail.ActorProfilePictureUri" />
                                    </MudAvatar>
                                }
                                else
                                {
                                    <MudAvatar Size="Size.Medium" Color="Color.Primary">
                                        @_selectedEventDetail.ActorDisplayName[0]
                                    </MudAvatar>
                                }
                                <div>
                                    <MudText Typo="Typo.subtitle2" Style="@($"font-weight: 700;{(sidebarOrganizerUrl != null ? " text-decoration: underline dotted;" : "")}")">@_selectedEventDetail.ActorDisplayName</MudText>
                                    @if (!string.IsNullOrEmpty(_selectedEventDetail.ActorTypeFullName))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@_selectedEventDetail.ActorTypeFullName</MudText>
                                    }
                                </div>
                            </div>
                        }

                        @* ── Tags (always shown) ── *@
                        <MudDivider Class="mb-4" />
                        <div class="d-flex align-center justify-space-between mb-2">
                            <MudText Typo="Typo.overline" Style="font-weight: 600;">TAGS</MudText>
                            @if (CanManageSelectedEvent)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                               OnClick="@OpenTagManagement"
                                               aria-label="Manage tags" />
                            }
                        </div>
                        <div class="d-flex gap-1 flex-wrap mb-4">
                            @if (HasDetailTags())
                            {
                                @foreach (var tag in GetDetailTags())
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                        @tag
                                    </MudChip>
                                }
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-style: italic;">
                                    No tags
                                </MudText>
                            }
                        </div>

                        @* ── Categories (always shown) ── *@
                        <MudDivider Class="mb-4" />
                        <div class="d-flex align-center justify-space-between mb-2">
                            <MudText Typo="Typo.overline" Style="font-weight: 600;">CATEGORIES</MudText>
                            @if (CanManageSelectedEvent)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                               OnClick="@OpenCategoryManagement"
                                               aria-label="Manage categories" />
                            }
                        </div>
                        <div class="d-flex gap-1 flex-wrap mb-4">
                            @if (HasDetailCategories())
                            {
                                @foreach (var cat in GetDetailCategories())
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">
                                        @cat
                                    </MudChip>
                                }
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-style: italic;">
                                    No categories
                                </MudText>
                            }
                        </div>

                        @* ── Single session: show as event-level details (hide session abstraction) ── *@
                        @if (_selectedEventSessions is { Count: 1 })
                        {
                            var session = _selectedEventSessions.First();
                            <MudDivider Class="mb-4" />
                            @* Format badge *@
                            @if (!string.IsNullOrEmpty(_selectedEventDetail?.EventFormatFullName))
                            {
                                <div class="mb-2">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Color="@GetFormatColor(_selectedEventDetail)"
                                             Icon="@GetFormatIcon(_selectedEventDetail)">
                                        @_selectedEventDetail.EventFormatFullName
                                    </MudChip>
                                </div>
                            }
                            <MudStack Spacing="2" Class="mb-4">
                                @if (!string.IsNullOrEmpty(session.Title))
                                {
                                    <div class="d-flex gap-3 align-center">
                                        <MudIcon Icon="@Icons.Material.Outlined.Event" Color="Color.Primary" Size="Size.Small" />
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@session.Title</MudText>
                                    </div>
                                }
                                <div class="d-flex gap-3 align-center">
                                    <MudIcon Icon="@Icons.Material.Outlined.Schedule" Color="Color.Primary" Size="Size.Small" />
                                    <div>
                                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Time</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                                            @(session.StartTime?.ToString("MMM dd, HH:mm") ?? "TBD")
                                            @if (session.EndTime != null)
                                            {
                                                @($" — {session.EndTime?.ToString("HH:mm")}")
                                            }
                                        </MudText>
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(session.LocationFullName))
                                {
                                    <div class="d-flex gap-3 align-center">
                                        <MudIcon Icon="@Icons.Material.Outlined.LocationOn" Color="Color.Primary" Size="Size.Small" />
                                        <div>
                                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Venue</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">@session.LocationFullName</MudText>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(_selectedEventDetail?.EventUrl))
                                {
                                    <div class="d-flex gap-3 align-center">
                                        <MudIcon Icon="@Icons.Material.Outlined.Videocam" Color="Color.Primary" Size="Size.Small" />
                                        <div>
                                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Online</MudText>
                                            <MudLink Href="@_selectedEventDetail.EventUrl" Target="_blank" Typo="Typo.body2">
                                                Join meeting
                                            </MudLink>
                                        </div>
                                    </div>
                                }
                                @if (session.MaxAudienceAttendees > 0)
                                {
                                    <div class="d-flex gap-3 align-center">
                                        <MudIcon Icon="@Icons.Material.Outlined.People" Color="Color.Primary" Size="Size.Small" />
                                        <div>
                                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Capacity</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                @(session.CurrentAudienceAttendees ?? 0) / @session.MaxAudienceAttendees attendees
                                            </MudText>
                                        </div>
                                    </div>
                                }
                                @{
                                    var sidebarLanguage = _selectedEventDetail?.IslamicAspect?.PrimaryLanguageName;
                                }
                                @if (!string.IsNullOrEmpty(sidebarLanguage))
                                {
                                    <div class="d-flex gap-3 align-center">
                                        <MudIcon Icon="@Icons.Material.Outlined.Translate" Color="Color.Primary" Size="Size.Small" />
                                        <div>
                                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Language</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">@sidebarLanguage</MudText>
                                        </div>
                                    </div>
                                }
                            </MudStack>
                        }
                        else if (_selectedEventSessions is { Count: > 1 })
                        {
                            @* Multiple sessions: card list *@
                            <MudDivider Class="mb-4" />
                            <MudText Typo="Typo.overline" Class="mb-2" Style="font-weight: 600;">
                                SESSIONS (@_selectedEventSessions.Count)
                            </MudText>
                            <MudStack Spacing="2" Class="mb-4">
                                @foreach (var session in _selectedEventSessions.OrderBy(s => s.StartTime))
                                {
                                    <MudPaper Outlined="true" Class="pa-3 rounded-lg">
                                        @if (!string.IsNullOrEmpty(session.Title))
                                        {
                                            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@session.Title</MudText>
                                        }
                                        <div class="d-flex gap-2 align-center mt-1">
                                            <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Color="Color.Secondary" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @(session.StartTime?.ToString("MMM dd, HH:mm") ?? "TBD")
                                                @if (session.EndTime != null)
                                                {
                                                    @($" — {session.EndTime?.ToString("HH:mm")}")
                                                }
                                            </MudText>
                                        </div>
                                        @if (!string.IsNullOrEmpty(session.LocationFullName))
                                        {
                                            <div class="d-flex gap-2 align-center mt-1">
                                                <MudIcon Icon="@Icons.Material.Outlined.LocationOn" Size="Size.Small" Color="Color.Secondary" />
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@session.LocationFullName</MudText>
                                            </div>
                                        }
                                        @if (session.MaxAudienceAttendees > 0)
                                        {
                                            <div class="d-flex gap-2 align-center mt-1">
                                                <MudIcon Icon="@Icons.Material.Outlined.People" Size="Size.Small" Color="Color.Secondary" />
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @(session.CurrentAudienceAttendees ?? 0) / @session.MaxAudienceAttendees attendees
                                                </MudText>
                                            </div>
                                        }
                                        @if (session.Price > 0)
                                        {
                                            <MudText Typo="Typo.caption" Class="mt-1" Color="Color.Primary">
                                                @($"{session.CurrencyCode ?? "€"}{session.Price:F2}")
                                            </MudText>
                                        }
                                    </MudPaper>
                                }
                            </MudStack>
                        }

                        @* ── Islamic Aspect ── *@
                        @if (_selectedEventDetail?.IslamicAspect != null)
                        {
                            <MudDivider Class="mb-4" />
                            <MudText Typo="Typo.overline" Class="mb-2" Style="font-weight: 600;">
                                <MudIcon Icon="@Icons.Material.Outlined.Mosque" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                                ISLAMIC ASPECT
                            </MudText>
                            <MudSimpleTable Dense="true" Hover="true" Bordered="false" Class="mb-4" Style="background: transparent;">
                                <tbody>
                                    @if (!string.IsNullOrEmpty(_selectedEventDetail.IslamicAspect.GenderModeName))
                                    {
                                        <tr>
                                            <td style="font-weight: 600; width: 140px;">Gender Mode</td>
                                            <td>@_selectedEventDetail.IslamicAspect.GenderModeName</td>
                                        </tr>
                                    }
                                    @if (_selectedEventDetail.IslamicAspect.ReferencePrayer != null)
                                    {
                                        <tr>
                                            <td style="font-weight: 600;">Prayer</td>
                                            <td>
                                                Prayer @_selectedEventDetail.IslamicAspect.ReferencePrayer
                                                @if (_selectedEventDetail.IslamicAspect.PrayerTimeOffset != null && _selectedEventDetail.IslamicAspect.PrayerTimeOffset != 0)
                                                {
                                                    @($" ({(_selectedEventDetail.IslamicAspect.PrayerTimeOffset > 0 ? "+" : "")}{_selectedEventDetail.IslamicAspect.PrayerTimeOffset} min)")
                                                }
                                            </td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(_selectedEventDetail.IslamicAspect.PrimaryLanguageName))
                                    {
                                        <tr>
                                            <td style="font-weight: 600;">Language</td>
                                            <td>@_selectedEventDetail.IslamicAspect.PrimaryLanguageName</td>
                                        </tr>
                                    }
                                    @if (_selectedEventDetail.IslamicAspect.IncludesQuranRecitation == true)
                                    {
                                        <tr>
                                            <td style="font-weight: 600;">Quran</td>
                                            <td>
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" Style="vertical-align: middle;" />
                                                Includes Recitation
                                            </td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(_selectedEventDetail.IslamicAspect.MadhabName))
                                    {
                                        <tr>
                                            <td style="font-weight: 600;">Madhab</td>
                                            <td>@_selectedEventDetail.IslamicAspect.MadhabName</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }

                        @* ── Tech Aspect ── *@
                        @if (_selectedEventDetail?.TechAspect != null)
                        {
                            <MudDivider Class="mb-4" />
                            <MudText Typo="Typo.overline" Class="mb-2" Style="font-weight: 600;">
                                <MudIcon Icon="@Icons.Material.Outlined.Code" Size="Size.Small" Class="mr-1" Style="vertical-align: middle;" />
                                TECH ASPECT
                            </MudText>
                            <MudSimpleTable Dense="true" Hover="true" Bordered="false" Class="mb-4" Style="background: transparent;">
                                <tbody>
                                    @if (!string.IsNullOrEmpty(_selectedEventDetail.TechAspect.SkillLevelName))
                                    {
                                        <tr>
                                            <td style="font-weight: 600; width: 140px;">Skill Level</td>
                                            <td>@_selectedEventDetail.TechAspect.SkillLevelName</td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(_selectedEventDetail.TechAspect.TechStackTags))
                                    {
                                        <tr>
                                            <td style="font-weight: 600;">Tech Stack</td>
                                            <td>
                                                <div class="d-flex gap-1 flex-wrap">
                                                    @foreach (var tech in _selectedEventDetail.TechAspect.TechStackTags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Dark">@tech</MudChip>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(_selectedEventDetail.TechAspect.HackathonTrack))
                                    {
                                        <tr>
                                            <td style="font-weight: 600;">Hackathon</td>
                                            <td>@_selectedEventDetail.TechAspect.HackathonTrack</td>
                                        </tr>
                                    }
                                    @if (_selectedEventDetail.TechAspect.IsCodingCompetition == true)
                                    {
                                        <tr>
                                            <td style="font-weight: 600;">Competition</td>
                                            <td>
                                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" Style="vertical-align: middle;" />
                                                Coding Competition
                                            </td>
                                        </tr>
                                    }
                                    @if (_selectedEventDetail.TechAspect.RequiresLaptop == true)
                                    {
                                        <tr>
                                            <td style="font-weight: 600;">Laptop</td>
                                            <td>
                                                <MudIcon Icon="@Icons.Material.Filled.Laptop" Size="Size.Small" Color="Color.Warning" Style="vertical-align: middle;" />
                                                Required
                                            </td>
                                        </tr>
                                    }
                                    @if (_selectedEventDetail.TechAspect.MaxTeamSize > 0)
                                    {
                                        <tr>
                                            <td style="font-weight: 600;">Team Size</td>
                                            <td>Max @_selectedEventDetail.TechAspect.MaxTeamSize members</td>
                                        </tr>
                                    }
                                    @if (_selectedEventDetail.TechAspect.PrizePool > 0)
                                    {
                                        <tr>
                                            <td style="font-weight: 600;">Prize Pool</td>
                                            <td>@($"{_selectedEventDetail.TechAspect.PrizeCurrencyCode ?? "$"}{_selectedEventDetail.TechAspect.PrizePool:N0}")</td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(_selectedEventDetail.TechAspect.GithubRepoUrl))
                                    {
                                        <tr>
                                            <td style="font-weight: 600;">GitHub</td>
                                            <td>
                                                <MudLink Href="@_selectedEventDetail.TechAspect.GithubRepoUrl" Target="_blank" Typo="Typo.caption">
                                                    @_selectedEventDetail.TechAspect.GithubRepoUrl
                                                </MudLink>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }

                        @* ── Registration Info ── *@
                        @if (_selectedEventDetail?.IsRegistrationRequired == true || !string.IsNullOrEmpty(_selectedEventDetail?.ExternalRegistrationUrl))
                        {
                            <MudDivider Class="mb-4" />
                            <MudText Typo="Typo.overline" Class="mb-2" Style="font-weight: 600;">REGISTRATION</MudText>
                            <MudStack Spacing="1" Class="mb-4">
                                @if (_selectedEventDetail.IsRegistrationRequired == true)
                                {
                                    <MudText Typo="Typo.body2">
                                        <MudIcon Icon="@Icons.Material.Filled.HowToReg" Size="Size.Small" Color="Color.Warning" Style="vertical-align: middle;" Class="mr-1" />
                                        Registration required
                                    </MudText>
                                }
                                @if (!string.IsNullOrEmpty(_selectedEventDetail.ExternalRegistrationUrl))
                                {
                                    <MudLink Href="@_selectedEventDetail.ExternalRegistrationUrl" Target="_blank" Typo="Typo.body2">
                                        <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" Size="Size.Small" Style="vertical-align: middle;" Class="mr-1" />
                                        External Registration
                                    </MudLink>
                                }
                            </MudStack>
                        }
                    }

                    <MudDivider Class="mb-4" />

                    @* ── Action Buttons ── *@
                    @if (IsUserRegistered(_selectedEvent.Id ?? Guid.Empty))
                    {
                        <MudButton Elevation="0" Variant="Variant.Outlined"
                                   Color="Color.Success"
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.EventAvailable"
                                   Disabled="true"
                                   Class="rounded-lg">
                            Registered
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Outlined"
                                   FullWidth="true"
                                   StartIcon="@Icons.Material.Outlined.HowToReg"
                                   OnClick="@(() => OpenInlineRegistration())"
                                   Class="rounded-lg">
                            Register for this Event
                        </MudButton>
                    }
                </div>

                @* ── Inline Registration Popup (overlays the entire preview panel) ── *@
                @if (_showInlineRegistration)
                {
                    <div class="drawer-reg-overlay" @onclick="CloseInlineRegistration" @onclick:stopPropagation="true">
                        <div class="drawer-reg-popup" @onclick:stopPropagation="true">
                            <div class="drawer-reg-popup__header">
                                <MudText Typo="Typo.h6" Class="drawer-reg-popup__title">
                                    Register for Event
                                </MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                               OnClick="CloseInlineRegistration" />
                            </div>

                            @if (_regIsLoading)
                            {
                                <div class="drawer-reg-popup__loading">
                                    <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
                                </div>
                            }
                            else if (_regIsComplete)
                            {
                                <div class="drawer-reg-popup__success">
                                     <div class="drawer-reg-popup__icon drawer-reg-popup__icon--success">
                                        <MudIcon Icon="@(_regIsWaitlisted ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.Check)" />
                                     </div>
                                     <MudText Typo="Typo.h6" Class="mb-2">@(_regIsWaitlisted ? "You're on the Waitlist!" : "You're Registered!")</MudText>
                                     <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                                         @if (_regIsWaitlisted)
                                         {
                                             <span>You have been added to the waitlist because one or more selected sessions are currently full.</span>
                                         }
                                         else
                                         {
                                             <span>You have been successfully registered for this event.</span>
                                         }
                                     </MudText>

                                      <MudButton Elevation="0" Variant="Variant.Outlined" Color="Color.Default" Class="rounded-lg mb-2"
                                                 FullWidth="true"
                                                 Href="@GetSelectedEventCalendarUrl()"
                                                 StartIcon="@Icons.Material.Outlined.CalendarMonth">
                                          Add to Calendar
                                      </MudButton>

                                      <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Outlined" Class="rounded-lg mb-2"
                                                 FullWidth="true"
                                                 OnClick="ShareSelectedEventAsync"
                                                 StartIcon="@Icons.Material.Filled.Share">
                                          Share this Event
                                      </MudButton>

                                      <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" Class="rounded-lg mb-2"
                                                 FullWidth="true"
                                                 Href="/my/registrations"
                                                StartIcon="@Icons.Material.Filled.AppRegistration">
                                         View My Registrations
                                     </MudButton>

                                     <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Text" Class="rounded-lg"
                                                FullWidth="true"
                                                OnClick="CloseInlineRegistration">
                                         Done
                                    </MudButton>
                                </div>
                            }
                            else if (_regIsAlreadyRegistered)
                            {
                                <div class="drawer-reg-popup__success">
                                    <div class="drawer-reg-popup__icon drawer-reg-popup__icon--check">
                                        <MudIcon Icon="@Icons.Material.Filled.EventAvailable" />
                                    </div>
                                    <MudText Typo="Typo.h6" Class="mb-2">Already Registered</MudText>
                                     <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                                         You are already registered for this event.
                                     </MudText>
                                      <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" Class="rounded-lg mb-2"
                                                 FullWidth="true"
                                                 Href="/my/registrations"
                                                 StartIcon="@Icons.Material.Filled.AppRegistration">
                                          View My Registrations
                                      </MudButton>
                                      <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Outlined" Class="rounded-lg mb-2"
                                                 FullWidth="true"
                                                 OnClick="ShareSelectedEventAsync"
                                                 StartIcon="@Icons.Material.Filled.Share">
                                          Share this Event
                                      </MudButton>
                                      <MudButton Elevation="0" Variant="Variant.Outlined" Color="Color.Default" Class="rounded-lg mb-2"
                                                 FullWidth="true"
                                                 Href="@GetSelectedEventCalendarUrl()"
                                                 StartIcon="@Icons.Material.Outlined.CalendarMonth">
                                          Add to Calendar
                                      </MudButton>
                                      <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Text" Class="rounded-lg"
                                                 FullWidth="true"
                                                 OnClick="CloseInlineRegistration">
                                         Close
                                     </MudButton>
                                </div>
                            }
                            else
                            {
                                @* ── Session selection ── *@
                                @if (_regAvailableSessions != null && _regAvailableSessions.Any(s => s.Id.HasValue))
                                {
                                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight: 600;">
                                        Select Sessions
                                    </MudText>

                                    @* Select All toggle *@
                                    <div class="d-flex align-center gap-2 mb-2 cursor-pointer" @onclick="ToggleRegAllSessions">
                                        <MudCheckBox T="bool" Value="@_regAllSessionsSelected"
                                                     ValueChanged="@((_) => ToggleRegAllSessions())"
                                                     Color="Color.Primary" Dense="true" />
                                        <MudText Typo="Typo.body2" Style="font-weight: 600;">All Sessions</MudText>
                                    </div>

                                    <div class="drawer-reg-popup__sessions">
                                        @foreach (var session in _regAvailableSessions.Where(s => s.Id.HasValue).OrderBy(s => s.StartTime))
                                        {
                                            var sid = session.Id!.Value;
                                            var isSelected = _regSelectedSessionIds.Contains(sid);
                                            <MudPaper Outlined="true" Class="@($"pa-3 rounded-lg mb-2 cursor-pointer {(isSelected ? "mud-border-primary" : "")}")"
                                                      @onclick="@(() => ToggleRegSession(sid))">
                                                <div class="d-flex align-center gap-2">
                                                    <MudCheckBox T="bool" Value="@isSelected"
                                                                 ValueChanged="@((_) => ToggleRegSession(sid))"
                                                                 Color="Color.Primary" Dense="true" />
                                                    <div style="flex: 1; min-width: 0;">
                                                        <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                                            @(session.Title ?? "Session")
                                                        </MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            @(session.StartTime?.ToString("MMM dd, HH:mm") ?? "TBD")
                                                            @if (session.EndTime != null) { @($" — {session.EndTime?.ToString("HH:mm")}") }
                                                        </MudText>
                                                    </div>
                                                </div>
                                            </MudPaper>
                                        }
                                    </div>
                                }

                                @* ── Consent checkbox ── *@
                                @if (_regShowConsentOption)
                                {
                                    <div class="d-flex align-start gap-2 mb-4">
                                        <MudCheckBox T="bool" @bind-Value="_regShareEmail"
                                                     Color="Color.Primary" Dense="true" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                            Share my email address with <strong>@_regOrganizerName</strong> so they can contact me about future events and related updates.
                                        </MudText>
                                    </div>
                                }

                                @* ── Google Calendar (placeholder) ── *@
                                <MudButton Elevation="0" Variant="Variant.Outlined" Color="Color.Default" Class="rounded-lg mb-3"
                                           FullWidth="true"
                                           StartIcon="@Icons.Material.Outlined.CalendarMonth"
                                           Disabled="true">
                                    Add to Google Calendar
                                </MudButton>

                                @* ── Submit ── *@
                                <div class="d-flex gap-3">
                                    <MudButton Elevation="0" Variant="Variant.Text" Color="Color.Default" Class="rounded-lg flex-1"
                                               OnClick="CloseInlineRegistration" Disabled="_regIsSubmitting">
                                        Cancel
                                    </MudButton>
                                    <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" Class="rounded-lg flex-1"
                                               OnClick="HandleInlineRegistrationSubmit"
                                               Disabled="@(_regIsSubmitting || !_regSelectedSessionIds.Any())">
                                        @if (_regIsSubmitting)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                            <span>Registering…</span>
                                        }
                                        else
                                        {
                                            <span>Register (@_regSelectedSessionIds.Count)</span>
                                        }
                                    </MudButton>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* ── Tag / Category Management Popup ── *@
                <TagCategoryManagerPopup
                    Visible="_showTagCatPopup"
                    VisibleChanged="@(v => { _showTagCatPopup = v; StateHasChanged(); })"
                    Mode="@_tagCatMode"
                    InitialAppliedIds="@_tagCatInitialIds"
                    OnSaved="HandleTagCatSaved" />
            }

    </text>;
}
