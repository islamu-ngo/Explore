@* ABOUTME: Luma-inspired edit event page — mirrors CreateEvent layout with pre-filled data and Update button. *@
@* ABOUTME: Two-column layout with image left, form right. Loads existing event data and sessions for editing. *@
@using MudBlazor
@using Explore.Blazor.Client.Shared
@using Explore.Blazor.Client.Pages.Events.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Edit Event</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    @if (isLoading)
    {
        <div class="d-flex flex-column align-center justify-center py-16">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-4" Color="Color.Secondary">Loading event...</MudText>
        </div>
    }
    else if (currentEvent == null || updateDto == null)
    {
        <MudContainer Class="py-8">
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">Event not found.</MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/myevents" Class="mt-4">Back to My Events</MudButton>
        </MudContainer>
    }
    else
    {
        <div class="edit-event">
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4 rounded-lg"
                      ShowCloseIcon="true" CloseIconClicked="@(() => errorMessage = string.Empty)">
                @errorMessage
            </MudAlert>
        }

        <EditForm Model="updateDto" OnValidSubmit="@HandleSubmit">

            <MudGrid Spacing="5">
                @* ===== LEFT COLUMN: Event Image ===== *@
                <MudItem xs="12" sm="5" Class="edit-event__col-left">
                    <div class="edit-event__image-area">
                        @if (!string.IsNullOrEmpty(imagePreviewUrl))
                        {
                            <img src="@imagePreviewUrl" alt="Event image" class="edit-event__image" />
                        }
                        else
                        {
                            <div class="edit-event__image-placeholder">
                                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Event Image</MudText>
                            </div>
                        }

                        <MudFileUpload T="IBrowserFile"
                                       FilesChanged="OnImageFileSelected"
                                       Accept=".jpg,.jpeg,.png,.gif,.webp"
                                       MaximumFileCount="1"
                                       Class="edit-event__upload-trigger">
                            <CustomContent Context="fileUpload">
                                <MudFab StartIcon="@Icons.Material.Filled.PhotoCamera"
                                        Size="Size.Small"
                                        Color="Color.Primary"
                                        aria-label="Upload event image"
                                        OnClick="@fileUpload.OpenFilePickerAsync" />
                            </CustomContent>
                        </MudFileUpload>

                        @if (_isUploadingImage)
                        {
                            <div class="edit-event__upload-overlay">
                                <MudProgressCircular Size="Size.Medium" Indeterminate="true" Color="Color.Primary" />
                            </div>
                        }
                    </div>

                    @if (_uploadError != null)
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2" Dense="true"
                                  ShowCloseIcon="true" CloseIconClicked="@(() => _uploadError = null)">
                            @_uploadError
                        </MudAlert>
                    }

                    @* --- Appearance (under image, left column) --- *@
                    <MudExpansionPanels Class="mt-3" Elevation="0">
                        <MudExpansionPanel Text="Event Appearance" MaxHeight="500"
                                           Class="rounded-lg border-solid border-1 mud-border-lines-default">
                            <MudGrid Spacing="2">
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_appearance.BackgroundColor"
                                                  Label="Background Color"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Placeholder="#0f172a" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_appearance.BackgroundMediaUrl"
                                                  Label="Background Media URL"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Placeholder="https://..." />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudSelect @bind-Value="_appearance.BackgroundEffect"
                                               Label="Effect"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               AnchorOrigin="Origin.BottomCenter">
                                        <MudSelectItem Value="@("None")">None</MudSelectItem>
                                        <MudSelectItem Value="@("SoftOverlay")">Soft Overlay</MudSelectItem>
                                        <MudSelectItem Value="@("StrongOverlay")">Strong Overlay</MudSelectItem>
                                        <MudSelectItem Value="@("Blur")">Blur Overlay</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </MudItem>

                @* ===== RIGHT COLUMN: Form ===== *@
                <MudItem xs="12" sm="7" Class="edit-event__col-right">

                    @* --- Event Title (large, Luma-style) --- *@
                    <MudTextField @bind-Value="updateDto.Title"
                                  Placeholder="Event Name"
                                  Variant="Variant.Text"
                                  FullWidth="true"
                                  Immediate="true"
                                  Class="edit-event__title-input mb-1" />

                    @* --- First Session: Luma-style Date/Time Block --- *@
                    @if (sessions.Count > 0)
                    {
                        <div class="edit-event__datetime-block">
                            <div class="edit-event__datetime-row">
                                <div class="edit-event__datetime-indicator">
                                    <div class="edit-event__datetime-dot edit-event__datetime-dot--start"></div>
                                    <div class="edit-event__datetime-line"></div>
                                </div>
                                <MudText Typo="Typo.body2" Class="edit-event__datetime-label">Start</MudText>
                                <MudDatePicker Date="@sessions[0].StartTime.Date"
                                               DateChanged="@(d => OnSessionStartDateChanged(0, d))"
                                               Variant="Variant.Text"
                                               Margin="Margin.Dense"
                                               DisableToolbar="true"
                                               Class="edit-event__datetime-picker" />
                                <MudTimePicker Time="@sessions[0].StartTime.TimeOfDay"
                                               TimeChanged="@(t => OnSessionStartTimeChanged(0, t))"
                                               Variant="Variant.Text"
                                               Margin="Margin.Dense"
                                               Class="edit-event__datetime-picker" />
                            </div>
                            <div class="edit-event__datetime-row">
                                <div class="edit-event__datetime-indicator">
                                    <div class="edit-event__datetime-dot edit-event__datetime-dot--end"></div>
                                </div>
                                <MudText Typo="Typo.body2" Class="edit-event__datetime-label">End</MudText>
                                <MudDatePicker Date="@sessions[0].EndTime.Date"
                                               DateChanged="@(d => OnSessionEndDateChanged(0, d))"
                                               Variant="Variant.Text"
                                               Margin="Margin.Dense"
                                               DisableToolbar="true"
                                               Class="edit-event__datetime-picker" />
                                <MudTimePicker Time="@sessions[0].EndTime.TimeOfDay"
                                               TimeChanged="@(t => OnSessionEndTimeChanged(0, t))"
                                               Variant="Variant.Text"
                                               Margin="Margin.Dense"
                                               Class="edit-event__datetime-picker" />
                            </div>
                            <MudButton Variant="Variant.Text"
                                       Size="Size.Small"
                                       Color="Color.Default"
                                       OnClick="@(() => _showTimezoneSelector = !_showTimezoneSelector)"
                                       Class="edit-event__timezone-btn">
                                <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Small" Class="mr-1" />
                                @_selectedTimezoneDisplay
                                <MudIcon Icon="@(_showTimezoneSelector ? Icons.Material.Filled.ArrowDropUp : Icons.Material.Filled.ArrowDropDown)" Size="Size.Small" />
                            </MudButton>
                            @if (_showTimezoneSelector)
                            {
                                <MudAutocomplete T="TimeZoneInfo"
                                                 Value="_selectedTimezone"
                                                 ValueChanged="OnTimezoneChanged"
                                                 SearchFunc="SearchTimezones"
                                                 ToStringFunc="@(tz => tz?.DisplayName ?? "")"
                                                 Label="Search timezone"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Dense="true"
                                                 Immediate="true"
                                                 Class="edit-event__timezone-autocomplete" />
                            }
                        </div>

                        @* First session location *@
                        <MudButton StartIcon="@Icons.Material.Filled.LocationOn"
                                   Variant="Variant.Text"
                                   Color="Color.Default"
                                   FullWidth="true"
                                   Class="edit-event__action-button justify-start"
                                   OnClick="@(() => _showFirstSessionLocation = !_showFirstSessionLocation)">
                            @if (sessions[0].LocationId.HasValue && locations != null)
                            {
                                var loc = locations.FirstOrDefault(l => (Guid?)l.Id == sessions[0].LocationId);
                                <span>@(loc?.FullName ?? "Change location")</span>
                            }
                            else
                            {
                                <span>Add event location</span>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">Physical or virtual link</MudText>
                            }
                        </MudButton>

                        @if (_showFirstSessionLocation && locations != null)
                        {
                            <MudSelect T="Guid?"
                                       @bind-Value="sessions[0].LocationId"
                                       Label="Location"
                                       Variant="Variant.Outlined"
                                       FullWidth="true"
                                       Clearable="true"
                                       Margin="Margin.Dense"
                                       Class="mb-3">
                                @foreach (var location in locations)
                                {
                                    <MudSelectItem T="Guid?" Value="@((Guid?)location.Id)">
                                        @location.FullName @(!string.IsNullOrEmpty(location.City) ? $" - {location.City}" : "")
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        }

                        @* First session: compact registration & capacity row *@
                        <MudGrid Spacing="2" Class="mb-2">
                            <MudItem xs="6">
                                <MudSelect T="int?"
                                           @bind-Value="sessions[0].RegistrationModeId"
                                           Label="Registration"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           FullWidth="true">
                                    @if (registrationModes != null)
                                    {
                                        @foreach (var mode in registrationModes)
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)mode.Id)">@mode.FullName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6">
                                <MudNumericField T="int?"
                                                 @bind-Value="sessions[0].MaxAudienceAttendees"
                                                 Label="Capacity"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Placeholder="Unlimited"
                                                 Min="0" />
                            </MudItem>
                        </MudGrid>
                    }

                    @* --- Add Description Button (Luma-style popup) --- *@
                    <MudButton StartIcon="@Icons.Material.Filled.Notes"
                               Variant="Variant.Text"
                               Color="Color.Default"
                               FullWidth="true"
                               Class="edit-event__action-button justify-start"
                               OnClick="OpenDescriptionDialog">
                        @if (!string.IsNullOrEmpty(updateDto.Description))
                        {
                            <span class="text-truncate" style="max-width: 400px; text-align: left;">@updateDto.Description</span>
                        }
                        else
                        {
                            <span>Add a description</span>
                        }
                    </MudButton>

                    @* --- Additional Sessions (2+) --- *@
                    @if (sessions.Count > 1)
                    {
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mt-4 mb-2">Additional Sessions</MudText>
                        @for (int i = 1; i < sessions.Count; i++)
                        {
                            var idx = i;
                            <MudPaper Elevation="0" Class="pa-4 mb-3 rounded-lg border-solid border-1 mud-border-lines-default">
                                <div class="d-flex justify-space-between align-center mb-3">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Session @(idx + 1)</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => RemoveSession(idx))" />
                                </div>
                                <EventSessionEditor Session="sessions[idx]"
                                                    SessionChanged="@((s) => OnSessionChanged(idx, s))"
                                                    Index="idx"
                                                    ShowRemoveButton="false"
                                                    ShowLocationSelector="true"
                                                    Locations="locations"
                                                    RegistrationModes="registrationModes"
                                                    ShowLanguageSelector="true"
                                                    Languages="languages" />
                            </MudPaper>
                        }
                    }

                    <MudButton StartIcon="@Icons.Material.Filled.Add"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               FullWidth="true"
                               OnClick="AddSession"
                               Class="mt-2 mb-4 rounded-lg">
                        Add Session
                    </MudButton>

                    @* --- Event Options (Luma-style rows) --- *@
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">Event Options</MudText>
                    <div class="edit-event__options">
                        @* Event Type *@
                        <div class="edit-event__option-row">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">Event Type</MudText>
                            </div>
                            <MudSelect T="int?" @bind-Value="updateDto.EventTypeId"
                                       Variant="Variant.Text" Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Class="edit-event__option-select">
                                <MudSelectItem T="int?" Value="@((int?)null)">— Select —</MudSelectItem>
                                @if (eventTypes != null)
                                {
                                    @foreach (var type in eventTypes)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)type.Id)">@type.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </div>

                        @* Format *@
                        <div class="edit-event__option-row">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Videocam" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">Format</MudText>
                            </div>
                            <MudSelect T="int?" @bind-Value="updateDto.EventFormatId"
                                       Variant="Variant.Text" Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Class="edit-event__option-select">
                                @if (eventFormats != null)
                                {
                                    @foreach (var f in eventFormats)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)f.Id)">@f.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </div>

                        @* Visibility *@
                        <div class="edit-event__option-row">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">Visibility</MudText>
                            </div>
                            <MudSelect T="int?" @bind-Value="updateDto.VisibilityTypeId"
                                       Variant="Variant.Text" Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Class="edit-event__option-select">
                                @if (visibilityTypes != null)
                                {
                                    @foreach (var v in visibilityTypes)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)v.Id)">@v.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </div>

                        @* Status *@
                        <div class="edit-event__option-row">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Flag" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">Status</MudText>
                            </div>
                            <MudSelect T="int?" @bind-Value="updateDto.EventStatusId"
                                       Variant="Variant.Text" Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Class="edit-event__option-select">
                                @if (eventStatuses != null)
                                {
                                    @foreach (var s in eventStatuses)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)s.Id)">@s.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </div>

                        @* Audience Gender & Age *@
                        <div class="edit-event__option-row">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">Audience</MudText>
                            </div>
                            <div class="d-flex gap-2">
                                <MudSelect T="int?" @bind-Value="updateDto.AudienceGenderId"
                                           Variant="Variant.Text" Margin="Margin.Dense"
                                           AnchorOrigin="Origin.BottomCenter"
                                           Class="edit-event__option-select"
                                           Placeholder="Gender">
                                    <MudSelectItem T="int?" Value="@((int?)null)">Any Gender</MudSelectItem>
                                    @if (audienceGenders != null)
                                    {
                                        @foreach (var g in audienceGenders)
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)g.Id)">@g.FullName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                                <MudSelect T="int?" @bind-Value="updateDto.AudienceAgeId"
                                           Variant="Variant.Text" Margin="Margin.Dense"
                                           AnchorOrigin="Origin.BottomCenter"
                                           Class="edit-event__option-select"
                                           Placeholder="Age">
                                    <MudSelectItem T="int?" Value="@((int?)null)">Any Age</MudSelectItem>
                                    @if (audienceAges != null)
                                    {
                                        @foreach (var a in audienceAges)
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)a.Id)">@a.FullName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </div>
                        </div>

                        @* Madhab *@
                        <div class="edit-event__option-row">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">Madhab</MudText>
                            </div>
                            <MudSelect T="int?" @bind-Value="updateDto.MadhabId"
                                       Variant="Variant.Text" Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Clearable="true"
                                       Class="edit-event__option-select">
                                <MudSelectItem T="int?" Value="@((int?)null)">— None —</MudSelectItem>
                                @if (madhabs != null)
                                {
                                    @foreach (var m in madhabs)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)m.Id)">@m.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </div>

                        @* Categories *@
                        <div class="edit-event__option-row">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Label" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">Categories</MudText>
                            </div>
                            <MudSelect T="Guid" MultiSelection="true"
                                       @bind-SelectedValues="selectedCategoryIds"
                                       Variant="Variant.Text" Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Class="edit-event__option-select">
                                @if (allCategories != null)
                                {
                                    @foreach (var c in allCategories)
                                    {
                                        if (c.Id is not Guid categoryId) { continue; }
                                        <MudSelectItem T="Guid" Value="@categoryId">@c.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </div>

                        @* Tags *@
                        <div class="edit-event__option-row">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">Tags</MudText>
                            </div>
                            <MudSelect T="Guid" MultiSelection="true"
                                       @bind-SelectedValues="selectedTagIds"
                                       Variant="Variant.Text" Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Class="edit-event__option-select">
                                @if (allTags != null)
                                {
                                    @foreach (var t in allTags)
                                    {
                                        if (t.Id is not Guid tagId) { continue; }
                                        <MudSelectItem T="Guid" Value="@tagId">@t.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </div>
                    </div>

                </MudItem>
            </MudGrid>

            @* ===== Update Event Button (full width) ===== *@
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="@(isProcessing || _isUploadingImage)"
                       Class="mt-6 edit-event__submit-button"
                       Size="Size.Large">
                @if (isProcessing)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Updating...</span>
                }
                else if (_isUploadingImage)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Uploading image...</span>
                }
                else
                {
                    <span>Update Event</span>
                }
            </MudButton>
        </EditForm>
        </div>
    }
</MudContainer>
