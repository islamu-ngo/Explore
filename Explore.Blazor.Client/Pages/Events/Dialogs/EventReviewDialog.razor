@using MudBlazor
@using System.ComponentModel.DataAnnotations
@using Explore.Blazor.Client.Contracts.Services.Accessibility
@inject IAccessibilityFocusService AccessibilityFocusService

<MudDialog>
    <DialogContent>
<div class="review-dialog-content">
            <div class="rating-section">
                <div class="rating-label" id="rating-label">How would you rate this event?</div>
                <div class="star-rating" role="radiogroup" aria-labelledby="rating-label">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var starIndex = i;
                        var isSelected = starIndex == rating;
                        var isFocusable = isSelected || (rating == 0 && starIndex == 1);
                        <span class="star @(starIndex <= rating ? "filled" : "")"
                              role="radio"
                              aria-checked="@(isSelected ? "true" : "false")"
                              aria-label="@($"{starIndex} out of 5 stars")"
                              tabindex="@(isFocusable ? 0 : -1)"
                              data-star="@starIndex"
                              @onclick="@(() => SetRating(starIndex))"
                              @onkeydown="@(e => HandleStarKeyDown(e, starIndex))">
                            @if (starIndex <= rating)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Star" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.StarBorder" />
                            }
                        </span>
                    }
                </div>
                @if (rating > 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Primary" Class="mt-2" aria-live="polite">
                        @GetRatingText()
                    </MudText>
                }
            </div>

            <div class="comment-section">
                <div class="comment-label">Share your experience (optional)</div>
                <AppTextField T="string" @bind-Value="comment"
                              Label="Your review"
                              Variant="Variant.Outlined"
                              Lines="5"
                              Placeholder="Tell us about your experience at this event..."
                              MaxLength="500"
                              Counter="500" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div role="alert">
                    <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessage</MudAlert>
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <AppButton OnClick="Cancel"
                   Variant="Variant.Text"
                   Color="Color.Default">
            Cancel
        </AppButton>
        <AppButton OnClick="Submit"
                   Disabled="@(rating == 0)"
                   StartIcon="@Icons.Material.Filled.Send">
            Submit Review
        </AppButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IDialogReference? DialogReference { get; set; }

    [Parameter]
    public string EventTitle { get; set; } = "";

    [Parameter]
    public Guid EventId { get; set; }

    private int rating = 0;
    private string comment = "";
    private string errorMessage = "";

    private void SetRating(int value)
    {
        rating = value;
        errorMessage = "";
    }

    private async Task HandleStarKeyDown(KeyboardEventArgs e, int currentIndex)
    {
        var newIndex = e.Key switch
        {
            "ArrowRight" or "ArrowDown" => Math.Min(currentIndex + 1, 5),
            "ArrowLeft" or "ArrowUp" => Math.Max(currentIndex - 1, 1),
            " " or "Enter" => currentIndex,
            _ => -1
        };

        if (newIndex < 0) return;

        SetRating(newIndex);

        if (newIndex != currentIndex)
        {
            await AccessibilityFocusService.FocusAsync($"[data-star='{newIndex}']");
        }
    }

    private string GetRatingText()
    {
        return rating switch
        {
            1 => "Poor",
            2 => "Fair",
            3 => "Good",
            4 => "Very Good",
            5 => "Excellent",
            _ => ""
        };
    }

    private void Submit()
    {
        if (rating == 0)
        {
            errorMessage = "Please select a rating";
            return;
        }

        // Here you would call the API to submit the review
        // For now, just close the dialog with success
        DialogReference?.Close(DialogResult.Ok(new { Rating = rating, Comment = comment }));
    }

    private void Cancel()
    {
        DialogReference?.Close(DialogResult.Cancel());
    }
}

