@using MudBlazor
@using System.ComponentModel.DataAnnotations

<MudDialog>
    <DialogContent>
<div class="review-dialog-content">
            <div class="rating-section">
                <div class="rating-label">How would you rate this event?</div>
                <div class="star-rating">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var starIndex = i;
                        <span class="star @(starIndex <= rating ? "filled" : "")"
                              @onclick="@(() => SetRating(starIndex))">
                            @if (starIndex <= rating)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Star" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.StarBorder" />
                            }
                        </span>
                    }
                </div>
                @if (rating > 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Primary" Class="mt-2">
                        @GetRatingText()
                    </MudText>
                }
            </div>

            <div class="comment-section">
                <div class="comment-label">Share your experience (optional)</div>
                <MudTextField @bind-Value="comment"
                              Label="Your review"
                              Variant="Variant.Outlined"
                              Lines="5"
                              Placeholder="Tell us about your experience at this event..."
                              MaxLength="500"
                              Counter="500" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessage</MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel"
                   Variant="Variant.Text"
                   Color="Color.Default">
            Cancel
        </MudButton>
        <MudButton OnClick="Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(rating == 0)"
                   StartIcon="@Icons.Material.Filled.Send">
            Submit Review
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IDialogReference? DialogReference { get; set; }

    [Parameter]
    public string EventTitle { get; set; } = "";

    [Parameter]
    public Guid EventId { get; set; }

    private int rating = 0;
    private string comment = "";
    private string errorMessage = "";

    private void SetRating(int value)
    {
        rating = value;
        errorMessage = "";
    }

    private string GetRatingText()
    {
        return rating switch
        {
            1 => "Poor",
            2 => "Fair",
            3 => "Good",
            4 => "Very Good",
            5 => "Excellent",
            _ => ""
        };
    }

    private void Submit()
    {
        if (rating == 0)
        {
            errorMessage = "Please select a rating";
            return;
        }

        // Here you would call the API to submit the review
        // For now, just close the dialog with success
        DialogReference?.Close(DialogResult.Ok(new { Rating = rating, Comment = comment }));
    }

    private void Cancel()
    {
        DialogReference?.Close(DialogResult.Cancel());
    }
}

