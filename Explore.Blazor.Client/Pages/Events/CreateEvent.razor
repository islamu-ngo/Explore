@* ABOUTME: Single-page create event form inspired by Luma's design. Two-column layout with image left, form right. *@
@* ABOUTME: Replaces the previous multi-step wizard. Uses inline first session, description dialog popup, and publisher row. *@
@page "/events/create"
@using MudBlazor
@using Explore.Blazor.Client.Shared
@using Explore.Blazor.Client.Pages.Events.Components
@using Blazored.FluentValidation
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Create Event</PageTitle>

<MudText Typo="Typo.h1" HtmlTag="h1" Class="sr-only">Create Event</MudText>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    @if (isLoading)
    {
        <div class="d-flex flex-column align-center justify-center py-16">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-4" Color="Color.Secondary">Loading...</MudText>
        </div>
    }
    else
    {
        <div class="create-event">
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4 rounded-lg"
                          ShowCloseIcon="true" CloseIconClicked="@(() => errorMessage = string.Empty)">
                    @errorMessage
                </MudAlert>
            }

            @if (_publishReadinessErrors.Count > 0)
            {
                <div id="publish-readiness-errors" role="alert" tabindex="-1">
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4 rounded-lg">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Before publishing</MudText>
                        <ul class="create-event__readiness-list">
                            @foreach (var readinessError in _publishReadinessErrors)
                            {
                                <li>
                                    <strong>@readinessError.FieldPath</strong>: @readinessError.Message
                                </li>
                            }
                        </ul>
                    </MudAlert>
                </div>
            }

        <EditForm Model="createDto" OnValidSubmit="@HandleSubmit">
            <FluentValidationValidator />

            <MudGrid Spacing="5">
                @* ===== LEFT COLUMN: Event Image And Appearance ===== *@
                <MudItem xs="12" sm="5" Class="create-event__col-left">
                    <div class="create-event__image-area">
                        @if (!string.IsNullOrEmpty(imagePreviewUrl))
                        {
                            <img src="@imagePreviewUrl" alt="Event image" class="create-event__image" />
                        }
                        else
                        {
                            <div class="create-event__image-placeholder">
                                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Event Image</MudText>
                            </div>
                        }

                        <MudFileUpload T="IBrowserFile"
                                       FilesChanged="OnImageFileSelected"
                                       Accept=".jpg,.jpeg,.png,.gif,.webp"
                                       MaximumFileCount="1"
                                       Class="create-event__upload-trigger">
                            <CustomContent Context="fileUpload">
                                <MudFab StartIcon="@Icons.Material.Filled.PhotoCamera"
                                        Size="Size.Small"
                                        Color="Color.Primary"
                                        aria-label="Upload event image"
                                        OnClick="@fileUpload.OpenFilePickerAsync" />
                            </CustomContent>
                        </MudFileUpload>

                        @if (_isUploadingImage)
                        {
                            <div class="create-event__upload-overlay">
                                <MudProgressCircular Size="Size.Medium" Indeterminate="true" Color="Color.Primary" />
                            </div>
                        }
                    </div>

                    <ThemeQuickBar @bind-BackgroundColor="_bgColor"
                                   @bind-BackgroundEffect="_bgEffect"
                                   OnAdvancedRequested="OpenThemeStudioAsync" />

                    @if (_uploadError != null)
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2" Dense="true"
                                  ShowCloseIcon="true" CloseIconClicked="@(() => _uploadError = null)">
                            @_uploadError
                        </MudAlert>
                    }

                </MudItem>

                @* ===== RIGHT COLUMN: Form ===== *@
                <MudItem xs="12" sm="7" Class="create-event__col-right">
                    @* --- Publication Context --- *@
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">Publication context</MudText>
                    <MudSelect T="string"
                               Value="SelectedPublisherKey"
                               ValueChanged="OnPublisherSelectionChanged"
                               Label="Publishing as"
                               Variant="Variant.Outlined"
                               FullWidth="true"
                               Margin="Margin.Dense"
                               AnchorOrigin="Origin.BottomCenter"
                               Disabled="@(_creationContext is not null && _creationContext.CanCreate != true)"
                               Class="mb-3 create-event__publisher-selector">
                        @foreach (var option in GetPublisherChoices())
                        {
                            <MudSelectItem T="string" Value="@option.Key" Disabled="@(!option.CanPublish)">
                                <div class="create-event__publisher-option">
                                    <MudIcon Icon="@GetPublisherIcon(option.Mode)" Size="Size.Small" />
                                    <div class="create-event__publisher-option-text">
                                        <MudText Typo="Typo.body2">@option.DisplayName</MudText>
                                        <MudText Typo="Typo.caption" Color="@(option.CanPublish ? Color.Secondary : Color.Error)">@option.Description</MudText>
                                    </div>
                                </div>
                            </MudSelectItem>
                        }
                    </MudSelect>

                    @if (!string.IsNullOrWhiteSpace(_creationContextError))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@_creationContextError</MudAlert>
                    }
                    @if (_creationContext is not null && _creationContext.CanCreate != true)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">
                            @(_creationContext.UnavailableReason ?? "You do not have access to create events.")
                        </MudAlert>
                    }
                    @if (_creationContext is not null && _creationContext.CanCreate == true && _creationContext.RequiresApproval == true)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                            Events from this publisher require approval before they go live.
                        </MudAlert>
                    }

                    @if (_creationContext is null && _publisherMode == "organization")
                    {
                        <MudSelect T="Guid?"
                                   Value="_selectedOrganizationId"
                                   ValueChanged="OnOrganizationDropdownChanged"
                                   Label="Select Organization"
                                   Variant="Variant.Outlined"
                                   FullWidth="true"
                                   Margin="Margin.Dense"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Class="mb-3 create-event__publisher-dropdown">
                            @if (_myOrganizations != null && _myOrganizations.Any())
                            {
                                @foreach (var org in _myOrganizations.Where(o => o.Id.HasValue))
                                {
                                    <MudSelectItem T="Guid?" Value="@org.Id" Disabled="@(!CanPublishAsOrganization(org.Id))">@org.FullName</MudSelectItem>
                                }
                            }
                            <MudSelectItem T="Guid?" Value="@CreateOrgSentinel">
                                <div class="d-flex align-center gap-1">
                                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" />
                                    <MudText Color="Color.Primary">Create Organization</MudText>
                                </div>
                            </MudSelectItem>
                        </MudSelect>
                    }

                    @if (_creationContext is null && _publisherMode == "group")
                    {
                        <MudSelect T="Guid?"
                                   Value="_selectedGroupId"
                                   ValueChanged="OnGroupDropdownChanged"
                                   Label="Select Group"
                                   Variant="Variant.Outlined"
                                   FullWidth="true"
                                   Margin="Margin.Dense"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Class="mb-3 create-event__publisher-dropdown">
                            @if (_myGroups != null && _myGroups.Any())
                            {
                                @foreach (var group in _myGroups)
                                {
                                    <MudSelectItem T="Guid?" Value="@group.Id" Disabled="@(!CanPublishAsGroup(group.Id))">@group.FullName</MudSelectItem>
                                }
                            }
                            <MudSelectItem T="Guid?" Value="@CreateGroupSentinel">
                                <div class="d-flex align-center gap-1">
                                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" />
                                    <MudText Color="Color.Primary">Create Group</MudText>
                                </div>
                            </MudSelectItem>
                        </MudSelect>
                    }

                    @if (!string.IsNullOrEmpty(_organizationRoleError))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@_organizationRoleError</MudAlert>
                    }
                    @if (!string.IsNullOrEmpty(_groupRoleError))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@_groupRoleError</MudAlert>
                    }

                    @* --- Event Title (large, Luma-style) --- *@
                    <AppTextField T="string" @bind-Value="createDto.Title"
                                  Label="Event name"
                                  Placeholder="Event Name"
                                  Variant="Variant.Text"
                                  FullWidth="true"
                                  Immediate="true"
                                  Required="true"
                                  Class="create-event__title-input mb-1" />

                    @* --- Event Timezone (event-level, shared by all sessions) --- *@
                    @if (sessions.Count > 0)
                    {
                        <div class="d-flex align-center gap-2 mb-2">
                            <AppButton Variant="Variant.Text"
                                       Size="Size.Small"
                                       Color="Color.Default"
                                       OnClick="@(() => _showTimezoneSelector = !_showTimezoneSelector)"
                                       Class="create-event__timezone-btn">
                                <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Small" Class="mr-1" />
                                @_selectedTimezoneDisplay
                                <MudIcon Icon="@(_showTimezoneSelector ? Icons.Material.Filled.ArrowDropUp : Icons.Material.Filled.ArrowDropDown)" Size="Size.Small" />
                            </AppButton>
                        </div>
                        @if (_showTimezoneSelector)
                        {
                            <MudAutocomplete T="TimeZoneInfo"
                                             Value="_selectedTimezone"
                                             ValueChanged="OnTimezoneChanged"
                                             SearchFunc="SearchTimezones"
                                             ToStringFunc="@(tz => tz?.DisplayName ?? "")"
                                             Label="Search timezone"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Dense="true"
                                             Immediate="true"
                                             Class="mb-2" />
                        }
                    }

                    @* --- First Session: Luma-style Date/Time Block --- *@
                    @if (sessions.Count > 0)
                    {
                        <div class="create-event__datetime-block">
                            <div class="create-event__datetime-row">
                                <div class="create-event__datetime-indicator">
                                    <div class="create-event__datetime-dot create-event__datetime-dot--start"></div>
                                    <div class="create-event__datetime-line"></div>
                                </div>
                                <MudText Typo="Typo.body2" Class="create-event__datetime-label">Start</MudText>
                                <MudDatePicker Date="@sessions[0].StartTime.Date"
                                               DateChanged="@(d => OnSessionStartDateChanged(0, d))"
                                               Variant="Variant.Text"
                                               Margin="Margin.Dense"
                                               DisableToolbar="true"
                                               Class="create-event__datetime-picker" />
                                <MudTimePicker Time="@sessions[0].StartTime.TimeOfDay"
                                               TimeChanged="@(t => OnSessionStartTimeChanged(0, t))"
                                               Variant="Variant.Text"
                                               Margin="Margin.Dense"
                                               Class="create-event__datetime-picker" />
                            </div>
                            <div class="create-event__datetime-row">
                                <div class="create-event__datetime-indicator">
                                    <div class="create-event__datetime-dot create-event__datetime-dot--end"></div>
                                </div>
                                <MudText Typo="Typo.body2" Class="create-event__datetime-label">End</MudText>
                                <MudDatePicker Date="@sessions[0].EndTime.Date"
                                               DateChanged="@(d => OnSessionEndDateChanged(0, d))"
                                               Variant="Variant.Text"
                                               Margin="Margin.Dense"
                                               DisableToolbar="true"
                                               Class="create-event__datetime-picker" />
                                <MudTimePicker Time="@sessions[0].EndTime.TimeOfDay"
                                               TimeChanged="@(t => OnSessionEndTimeChanged(0, t))"
                                               Variant="Variant.Text"
                                               Margin="Margin.Dense"
                                               Class="create-event__datetime-picker" />
                            </div>
                        </div>

                        @* --- Event Format: In-person / Online / Hybrid --- *@
                        <MudToggleGroup T="int?"
                                        @bind-Value="createDto.EventFormatId"
                                        Color="Color.Primary"
                                        SelectionMode="SelectionMode.SingleSelection"
                                        CheckMark="true"
                                        FixedContent="true"
                                        Class="mb-3">
                            <MudToggleItem T="int?" Value="@((int?)1)" Text="In-person" />
                            <MudToggleItem T="int?" Value="@((int?)2)" Text="Online" />
                            <MudToggleItem T="int?" Value="@((int?)3)" Text="Hybrid" />
                        </MudToggleGroup>

                        @* Location selector (shown for In-person and Hybrid) *@
                        @if (createDto.EventFormatId is 1 or 3)
                        {
                            <AppButton StartIcon="@Icons.Material.Filled.LocationOn"
                                       Variant="Variant.Text"
                                       Color="Color.Default"
                                       FullWidth="true"
                                       Class="create-event__action-button justify-start"
                                       OnClick="@(() => _showFirstSessionLocation = !_showFirstSessionLocation)">
                                @if (sessions[0].LocationId.HasValue && locations != null)
                                {
                                    var loc = locations.FirstOrDefault(l => (Guid?)l.Id == sessions[0].LocationId);
                                    <span>@(loc?.FullName ?? "Change location")</span>
                                }
                                else
                                {
                                    <span>Add event location</span>
                                }
                            </AppButton>

                            @if (_showFirstSessionLocation && locations != null)
                            {
                                <MudSelect T="Guid?"
                                           @bind-Value="sessions[0].LocationId"
                                           Label="Location"
                                           Variant="Variant.Outlined"
                                           FullWidth="true"
                                           Clearable="true"
                                           Margin="Margin.Dense"
                                           Class="mb-3">
                                    @foreach (var location in locations)
                                    {
                                        <MudSelectItem T="Guid?" Value="@((Guid?)location.Id)">
                                            @location.FullName @(!string.IsNullOrEmpty(location.City) ? $" - {location.City}" : "")
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            }
                        }

                        @* Meeting link field (shown for Online and Hybrid) *@
                        @if (createDto.EventFormatId is 2 or 3)
                        {
                            <AppTextField T="string" @bind-Value="createDto.EventUrl"
                                          Label="Meeting link"
                                          Placeholder="https://zoom.us/j/... or Google Meet link"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          FullWidth="true"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Link"
                                          Class="mb-3" />
                        }

                        @* First session: compact registration & capacity row *@
                        <MudGrid Spacing="2" Class="mb-2">
                            <MudItem xs="6">
                                <MudSelect T="int?"
                                           @bind-Value="sessions[0].RegistrationModeId"
                                           Label="Registration"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           FullWidth="true">
                                    @if (registrationModes != null)
                                    {
                                        @foreach (var mode in registrationModes)
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)mode.Id)">@mode.FullName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6">
                                <MudNumericField T="int?"
                                                 @bind-Value="sessions[0].MaxAudienceAttendees"
                                                 Label="Capacity"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Placeholder="Unlimited"
                                                 Min="0" />
                            </MudItem>
                        </MudGrid>

                    }

                    @* --- Add Description Button (Luma-style popup) --- *@
                    <AppButton StartIcon="@Icons.Material.Filled.Notes"
                               Variant="Variant.Text"
                               Color="Color.Default"
                               FullWidth="true"
                               Class="create-event__action-button justify-start"
                               OnClick="OpenDescriptionDialog">
                        @if (!string.IsNullOrEmpty(createDto.Description))
                        {
                            <span class="text-truncate" style="max-width: 400px; text-align: start;">@createDto.Description</span>
                        }
                        else
                        {
                            <span>Add a description</span>
                        }
                    </AppButton>

                    @* --- Schedule: default stays single-session, advanced details are explicit. --- *@
                    <section class="create-event__schedule mb-4" aria-labelledby="schedule-title">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mt-4 mb-1" id="schedule-title">
                            Schedule
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                            @ScheduleSummary
                        </MudText>
                        <div class="sr-only" aria-live="polite" aria-atomic="true">@_schedulingAnnouncement</div>

                        <MudExpansionPanels Elevation="0" Class="create-event__disclosure-panels">
                            <MudExpansionPanel Text="Open schedule timeline" @bind-IsExpanded="_isScheduleExpanded"
                                               Class="create-event__disclosure-panel">
                                <ScheduleTimelineComposer Sessions="sessions"
                                                          TimezoneDisplay="@_selectedTimezoneDisplay"
                                                          CanUseRooms="CanUseRoomSetup"
                                                          OnAddSession="AddSessionAsync"
                                                          OnAddItineraryItem="PrepareItineraryForDay"
                                                          OnEditSession="@(idx => _sessionWorkflow.OpenForEdit(sessions, idx))"
                                                          OnDuplicateSession="@(idx => _sessionWorkflow.DuplicateSession(sessions, idx))"
                                                          OnRemoveSession="@(idx => RemoveSession(idx))" />
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </section>

                    @* --- Event Settings (normal behavior controls stay visible) --- *@
                    <EventOptionsSection Title="Event settings"
                                         TitleId="event-settings-title"
                                         Summary="Visibility, audience, registration, classification, categories, and tags."
                                         PolicyNote="@EventOptionsPolicyNote">
                        <EventOptionRow Title="Visibility"
                                        Icon="@Icons.Material.Filled.Visibility"
                                        Summary="@VisibilitySummary"
                                        Description="Controls who can discover this event."
                                        Required="true"
                                        Disabled="@AreEventOptionsDisabled">
                            <MudSelect T="int?" @bind-Value="createDto.VisibilityTypeId"
                                       Variant="Variant.Text" Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Class="create-event__option-select"
                                       Disabled="@AreEventOptionsDisabled"
                                       aria-label="Visibility">
                                @if (visibilityTypes != null)
                                {
                                    @foreach (var v in visibilityTypes)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)v.Id)">@v.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </EventOptionRow>

                        <EventOptionRow Title="Audience"
                                        Icon="@Icons.Material.Filled.People"
                                        Summary="@AudienceSummary"
                                        Description="Audience filters make expectations visible before publishing."
                                        Disabled="@AreEventOptionsDisabled">
                            <div class="create-event__option-editor-group">
                                <MudSelect T="int?" @bind-Value="createDto.AudienceGenderId"
                                           Variant="Variant.Text" Margin="Margin.Dense"
                                           AnchorOrigin="Origin.BottomCenter"
                                           Class="create-event__option-select"
                                           Placeholder="Gender"
                                           Disabled="@AreEventOptionsDisabled"
                                           aria-label="Audience gender">
                                    <MudSelectItem T="int?" Value="@((int?)null)">Any Gender</MudSelectItem>
                                    @if (audienceGenders != null)
                                    {
                                        @foreach (var g in audienceGenders)
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)g.Id)">@g.FullName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                                <MudSelect T="int?" @bind-Value="createDto.AudienceAgeId"
                                           Variant="Variant.Text" Margin="Margin.Dense"
                                           AnchorOrigin="Origin.BottomCenter"
                                           Class="create-event__option-select"
                                           Placeholder="Age"
                                           Disabled="@AreEventOptionsDisabled"
                                           aria-label="Audience age group">
                                    <MudSelectItem T="int?" Value="@((int?)null)">Any Age</MudSelectItem>
                                    @if (audienceAges != null)
                                    {
                                        @foreach (var a in audienceAges)
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)a.Id)">@a.FullName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </div>
                        </EventOptionRow>

                        <EventOptionRow Title="Registration and capacity"
                                        Icon="@Icons.Material.Filled.Policy"
                                        Summary="@RegistrationSummary"
                                        Description="Use this for RSVP flow and first-session capacity defaults."
                                        Disabled="@AreEventOptionsDisabled">
                            <div class="create-event__option-editor-group">
                                <MudSelect T="int?" @bind-Value="createDto.RegistrationPolicyId"
                                           Variant="Variant.Text" Margin="Margin.Dense"
                                           AnchorOrigin="Origin.BottomCenter"
                                           Class="create-event__option-select"
                                           Placeholder="Default (Open)"
                                           Disabled="@AreEventOptionsDisabled"
                                           aria-label="Registration policy">
                                    <MudSelectItem T="int?" Value="@((int?)null)">Default (Open)</MudSelectItem>
                                    @if (registrationPolicies != null)
                                    {
                                        @foreach (var policy in registrationPolicies)
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)policy.Id)">@policy.FullName</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                                <MudNumericField T="int?"
                                                 @bind-Value="sessions[0].MaxAudienceAttendees"
                                                 Variant="Variant.Text"
                                                 Margin="Margin.Dense"
                                                 Placeholder="Unlimited"
                                                 Min="0"
                                                 Disabled="@AreEventOptionsDisabled"
                                                 Class="create-event__option-select"
                                                 aria-label="First session capacity" />
                            </div>
                        </EventOptionRow>

                        <EventOptionRow Title="Event type"
                                        Icon="@Icons.Material.Filled.Category"
                                        Summary="@EventTypeSummary"
                                        Description="Determines relevant templates and classification defaults."
                                        Disabled="@AreEventOptionsDisabled">
                            <MudSelect T="int?" Value="createDto.EventTypeId"
                                       ValueChanged="OnEventTypeChanged"
                                       Variant="Variant.Text" Margin="Margin.Dense"
                                       AnchorOrigin="Origin.BottomCenter"
                                       Class="create-event__option-select"
                                       Disabled="@AreEventOptionsDisabled"
                                       aria-label="Event type">
                                <MudSelectItem T="int?" Value="@((int?)null)">Select event type</MudSelectItem>
                                @if (eventTypes != null)
                                {
                                    @foreach (var type in eventTypes)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)type.Id)">@type.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </EventOptionRow>

                        <EventOptionRow Title="Categories"
                                        Icon="@Icons.Material.Filled.Label"
                                        Summary="@CategoriesSummary"
                                        Description="Broad browsing groups for discovery."
                                        Disabled="@AreEventOptionsDisabled">
                            <div class="create-event__option-chip-editor">
                                @foreach (var category in SelectedCategoryNames)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary">
                                        @category
                                    </MudChip>
                                }
                                <AppIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Disabled="@AreEventOptionsDisabled"
                                               OnClick="OpenCategoryManager"
                                               aria-label="Manage categories" />
                            </div>
                        </EventOptionRow>

                        <EventOptionRow Title="Tags"
                                        Icon="@Icons.Material.Filled.Tag"
                                        Summary="@TagsSummary"
                                        Description="Specific keywords that help people find the event."
                                        Disabled="@AreEventOptionsDisabled">
                            <div class="create-event__option-chip-editor">
                                @foreach (var tag in SelectedTagNames)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                        @tag
                                    </MudChip>
                                }
                                <AppIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Disabled="@AreEventOptionsDisabled"
                                               OnClick="OpenTagManager"
                                               aria-label="Manage tags" />
                            </div>
                        </EventOptionRow>

                        @if (HasLanguageOptions)
                        {
                            <EventOptionRow Title="Languages"
                                            Icon="@Icons.Material.Filled.Translate"
                                            Summary="@LanguagesSummary"
                                            Description="Optional language hints for the first itinerary session."
                                            Disabled="@AreEventOptionsDisabled">
                                <MudSelect T="int" MultiSelection="true"
                                           SelectedValues="FirstSessionLanguageIds"
                                           SelectedValuesChanged="OnFirstSessionLanguagesChanged"
                                           Variant="Variant.Text" Margin="Margin.Dense"
                                           AnchorOrigin="Origin.BottomCenter"
                                           Class="create-event__option-select"
                                           Disabled="@AreEventOptionsDisabled"
                                           aria-label="Event languages">
                                    @foreach (var language in languages!.Where(language => language.Id.HasValue))
                                    {
                                        <MudSelectItem T="int" Value="@language.Id.GetValueOrDefault()">@language.FullName</MudSelectItem>
                                    }
                                </MudSelect>
                            </EventOptionRow>
                        }
                    </EventOptionsSection>

                    @* --- More Options (rare configuration only) --- *@
                    <section class="create-event__more-options" aria-labelledby="more-options-title">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mt-4 mb-1" id="more-options-title">More options</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Template and custom fields.</MudText>
                        <MudExpansionPanels Elevation="0" Class="create-event__disclosure-panels">
                            <MudExpansionPanel Text="Template and custom fields" @bind-IsExpanded="_isMoreOptionsExpanded"
                                               Class="create-event__disclosure-panel">
                                <div class="create-event__options">
                                    @* Event Template *@
                                    <div class="create-event__option-row create-event__option-row--template">
                                        <div class="d-flex align-center gap-2">
                                            <MudIcon Icon="@Icons.Material.Filled.Schema" Size="Size.Small" Color="Color.Secondary" />
                                            <div>
                                                <MudText Typo="Typo.body2">Template</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Optional custom-property blueprint</MudText>
                                            </div>
                                        </div>
                                        <MudSelect T="Guid?" Value="createDto.TemplateId"
                                                   ValueChanged="OnEventTemplateChanged"
                                                   Variant="Variant.Text" Margin="Margin.Dense"
                                                   AnchorOrigin="Origin.BottomCenter"
                                                   Clearable="true"
                                                   Disabled="_isLoadingEventTemplates"
                                                   Class="create-event__option-select create-event__template-select"
                                                   aria-label="Event template">
                                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">No template</MudSelectItem>
                                            @foreach (var template in eventTemplates)
                                            {
                                                <MudSelectItem T="Guid?" Value="@((Guid?)template.Id)">
                                                    @template.DisplayName v@template.Version (@template.DefinitionsCount)
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                    </div>

                                    @if (_isLoadingEventTemplates || _isLoadingTemplatePreview || !string.IsNullOrWhiteSpace(_templateLoadError) || _selectedEventTemplate is not null)
                                    {
                                        <div class="create-event__template-preview" aria-live="polite">
                                            @if (_isLoadingEventTemplates)
                                            {
                                                <div class="d-flex align-center gap-2">
                                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Loading templates...</MudText>
                                                </div>
                                            }
                                            else if (_isLoadingTemplatePreview)
                                            {
                                                <div class="d-flex align-center gap-2">
                                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">Loading template preview...</MudText>
                                                </div>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(_templateLoadError))
                                            {
                                                <MudAlert Severity="Severity.Warning" Dense="true" Class="rounded-lg">
                                                    @_templateLoadError
                                                </MudAlert>
                                            }
                                            else if (_selectedEventTemplate is not null)
                                            {
                                                <div class="create-event__template-preview-header">
                                                    <div>
                                                        <MudText Typo="Typo.subtitle2">@_selectedEventTemplate.DisplayName v@_selectedEventTemplate.Version</MudText>
                                                        @if (!string.IsNullOrWhiteSpace(_selectedEventTemplate.Description))
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@_selectedEventTemplate.Description</MudText>
                                                        }
                                                    </div>
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                                        @_selectedEventTemplate.Definitions.Count definition@(_selectedEventTemplate.Definitions.Count == 1 ? string.Empty : "s")
                                                    </MudChip>
                                                </div>

                                                @if (_selectedEventTemplate.Definitions.Count > 0)
                                                {
                                                    <div class="create-event__template-definitions" aria-label="Template definition preview">
                                                        @foreach (var definition in _selectedEventTemplate.Definitions.OrderBy(d => d.SortOrder).ThenBy(d => d.DisplayName))
                                                        {
                                                            <div class="create-event__template-definition">
                                                                <div class="create-event__template-definition-main">
                                                                    <MudText Typo="Typo.body2">@definition.DisplayName</MudText>
                                                                    @if (!string.IsNullOrWhiteSpace(definition.Description))
                                                                    {
                                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@definition.Description</MudText>
                                                                    }
                                                                </div>
                                                                <div class="create-event__template-definition-meta">
                                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Secondary">@definition.PropertyType</MudChip>
                                                                    @if (definition.IsRequired)
                                                                    {
                                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">Required</MudChip>
                                                                    }
                                                                    @if (definition.IsMulti)
                                                                    {
                                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">Multi</MudChip>
                                                                    }
                                                                    @if (definition.Options.Count > 0)
                                                                    {
                                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">
                                                                            @definition.Options.Count option@(definition.Options.Count == 1 ? string.Empty : "s")
                                                                        </MudChip>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </section>

                </MudItem>
            </MudGrid>

            @* ===== Review And Publish Button with Draft Option ===== *@
            <div class="d-flex gap-0 mt-6" style="width: 100%;">
                <AppButton ButtonType="ButtonType.Submit"
                           Disabled="@IsSubmitDisabled"
                           Class="create-event__submit-button"
                           Size="Size.Large"
                           Style="flex: 1; border-top-right-radius: 0; border-bottom-right-radius: 0;">
                    @if (isProcessing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Reviewing...</span>
                    }
                    else if (_isUploadingImage)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Uploading image...</span>
                    }
                    else if (_isLoadingTemplatePreview)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Loading template...</span>
                    }
                    else
                    {
                        <span>Review and publish</span>
                    }
                </AppButton>
                <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown"
                         Variant="Variant.Filled"
                         Color="Color.Primary"
                         Size="Size.Large"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                          Disabled="@IsSubmitDisabled"
                         Class="create-event__submit-dropdown"
                         Style="border-top-left-radius: 0; border-bottom-left-radius: 0; min-width: 0;">
                    <MudMenuItem OnClick="@SaveAsDraftAsync"
                                 Icon="@Icons.Material.Outlined.Save">
                        Save draft
                    </MudMenuItem>
                </MudMenu>
            </div>
        </EditForm>
        </div>

        @* ===== SESSION EDITOR DRAWER ===== *@
        <MudDrawer @bind-Open="_sessionWorkflow.IsDrawerOpen"
                   Anchor="Anchor.End"
                   Variant="DrawerVariant.Temporary"
                   Width="400px"
                   Elevation="1"
                   Class="create-event__session-drawer">
            <MudDrawerHeader Class="pa-4 border-b">
                <div class="d-flex align-center justify-space-between w-100">
                    <MudText Typo="Typo.h6">@(_sessionWorkflow.IsNewSession ? "Add Session" : "Edit Session")</MudText>
                    <div class="d-flex align-center gap-1">
                        <AppIconButton Icon="@Icons.Material.Filled.NavigateBefore"
                                       Size="Size.Small"
                                       aria-label="Edit previous session"
                                       Disabled="@(!_sessionWorkflow.CanNavigatePrevious(sessions))"
                                       OnClick="@(() => _sessionWorkflow.NavigatePrevious(sessions, imagePreviewUrl))" />
                        <AppIconButton Icon="@Icons.Material.Filled.NavigateNext"
                                       Size="Size.Small"
                                       aria-label="Edit next session"
                                       Disabled="@(!_sessionWorkflow.CanNavigateNext(sessions))"
                                       OnClick="@(() => _sessionWorkflow.NavigateNext(sessions, imagePreviewUrl))" />
                        <AppIconButton Icon="@Icons.Material.Filled.Add"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       aria-label="Add another session"
                                       OnClick="@(() => _sessionWorkflow.AddFromDrawer(sessions, imagePreviewUrl))" />
                        <AppIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="Size.Small"
                                       aria-label="Close session editor"
                                       OnClick="@(() => _sessionWorkflow.Close())" />
                    </div>
                </div>
            </MudDrawerHeader>
            <div class="pa-4">
                @if (_sessionWorkflow.DrawerModel != null)
                {
                     <SessionEditorPanel Session="_sessionWorkflow.DrawerModel"
                                         IsNew="_sessionWorkflow.IsNewSession"
                                         EventImageUrl="@imagePreviewUrl"
                                         ParentEventTemplateId="@_selectedEventTemplate?.Id"
                                         Locations="locations"
                                        RegistrationModes="registrationModes"
                                        Languages="languages"
                                        OnSave="HandleSessionSave"
                                        OnCancel="@(() => _sessionWorkflow.Close())" />
                }
            </div>
        </MudDrawer>

        <ThemeStudioTray IsOpen="_isThemeStudioOpen"
                         BackgroundColor="@_bgColor"
                         BackgroundColorChanged="@(value => _bgColor = value)"
                         BackgroundEffect="@_bgEffect"
                         BackgroundEffectChanged="@(value => _bgEffect = value)"
                         OnClose="CloseThemeStudioAsync" />
    }

    <TagCategoryManagerPopup
        Visible="_showCreateTagCatPopup"
        VisibleChanged="@(v => { _showCreateTagCatPopup = v; StateHasChanged(); })"
        Mode="@_createTagCatMode"
        InitialAppliedIds="@_createTagCatInitialIds"
        OnSaved="HandleCreateTagCatSaved" />

</MudContainer>
