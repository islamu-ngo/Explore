@page "/create-event"
@using MudBlazor
@using Explore.Blazor.Client.Shared
@using Explore.Blazor.Client.Pages.Events.Components
@using Blazored.FluentValidation
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Create Event</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    @if (isLoading)
    {
        <div class="d-flex flex-column align-center justify-center py-16">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-4" Color="Color.Secondary">Loading...</MudText>
        </div>
    }
    else if (!_isRetrying)
    {
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Secondary"
                   Variant="Variant.Text"
                   OnClick="@(() => Navigation.NavigateTo("/events"))"
                   Class="mb-4 rounded-pill">
            Back to Events
        </MudButton>

        <MudPaper Elevation="0" Class="rounded-xl border-solid border-1 mud-border-lines-default overflow-hidden">
            <div class="pa-6 border-b-1 mud-border-lines-default bg-surface">
                <div class="d-flex align-center gap-4">
                    <MudAvatar Rounded="true" Size="Size.Large" Color="Color.Primary" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Medium" />
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h5" Style="font-weight: 700;">Create Event</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @GetPublisherDescription()
                        </MudText>
                    </div>
                </div>
            </div>

            <div class="pa-6">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-6 rounded-lg" ShowCloseIcon="true" CloseIconClicked="@(() => errorMessage = string.Empty)">
                        @errorMessage
                    </MudAlert>
                }

                <EditForm Model="createDto" OnValidSubmit="@HandleSubmit">
                    <FluentValidationValidator />

                    <MudTabs @bind-ActivePanelIndex="_activeStepIndex" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Transparent" SliderColor="Color.Primary">
                        <MudTabPanel Text="Publish As" Icon="@Icons.Material.Filled.AccountCircle">
                            <div class="py-6">
                                <MudText Typo="Typo.h6" Class="mb-4">Who is publishing this event?</MudText>

                                <MudRadioGroup @bind-Value="_publisherMode" T="string" Class="mb-6">
                                    <MudStack Spacing="2">
                                        <MudPaper Elevation="0" Class="pa-4 border-solid border-1 mud-border-lines-default rounded-lg">
                                            <MudRadio Value="@("personal")" Color="Color.Primary">
                                                <span class="d-flex align-center gap-2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                                    <MudText>Myself (User Reported)</MudText>
                                                </span>
                                            </MudRadio>
                                        </MudPaper>

                                        <MudPaper Elevation="0" Class="pa-4 border-solid border-1 mud-border-lines-default rounded-lg">
                                            <MudRadio Value="@("organization")" Color="Color.Primary" Disabled="@(_myOrganizations == null || !_myOrganizations.Any())">
                                                <span class="d-flex align-center gap-2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                                                    <MudText>An Organization</MudText>
                                                </span>
                                            </MudRadio>
                                        </MudPaper>

                                        <MudPaper Elevation="0" Class="pa-4 border-solid border-1 mud-border-lines-default rounded-lg">
                                            <MudRadio Value="@("group")" Color="Color.Primary" Disabled="@(_myGroups == null || !_myGroups.Any())">
                                                <span class="d-flex align-center gap-2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" />
                                                    <MudText>A Group</MudText>
                                                </span>
                                            </MudRadio>
                                        </MudPaper>
                                    </MudStack>
                                </MudRadioGroup>

                                @if (_publisherMode == "personal")
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                                        Events published in your name will be marked as <strong>User Reported</strong>.
                                        These events are subject to community moderation.
                                    </MudAlert>
                                }

                                @if (_publisherMode == "organization")
                                {
                                    @if (_myOrganizations != null && _myOrganizations.Any())
                                    {
                                        <MudSelect @bind-Value="SelectedOrganizationId"
                                                   T="Guid?"
                                                   Label="Select Organization"
                                                   Variant="Variant.Outlined"
                                                   AnchorOrigin="Origin.BottomCenter"
                                                   Required="true"
                                                   Class="mb-4">
                                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">-- Select an organization --</MudSelectItem>
                                            @foreach (var org in _myOrganizations.Where(o => o.Id.HasValue))
                                            {
                                                <MudSelectItem @key="org.Id" T="Guid?" Value="@org.Id">
                                                    @org.FullName @(org.CurrentUserRole.HasValue ? $"({GetRoleName((int)org.CurrentUserRole.Value)})" : "")
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                    }
                                    else
                                    {
                                        <MudAlert Severity="Severity.Warning" Class="mb-4">
                                            You are not a member of any organizations. Create or join an organization first.
                                        </MudAlert>
                                    }

                                    @if (!string.IsNullOrEmpty(_organizationRoleError))
                                    {
                                        <MudAlert Severity="Severity.Error" Class="mb-4">
                                            @_organizationRoleError
                                        </MudAlert>
                                    }
                                }

                                @if (_publisherMode == "group")
                                {
                                    @if (_myGroups != null && _myGroups.Any())
                                    {
                                        <MudSelect @bind-Value="SelectedGroupId"
                                                   T="Guid?"
                                                   Label="Select Group"
                                                   Variant="Variant.Outlined"
                                                   AnchorOrigin="Origin.BottomCenter"
                                                   Required="true"
                                                   Class="mb-4">
                                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">-- Select a group --</MudSelectItem>
                                            @foreach (var group in _myGroups)
                                            {
                                                <MudSelectItem @key="group.Id" T="Guid?" Value="@group.Id">
                                                    @group.FullName @(group.CurrentUserRole.HasValue ? $"({GetRoleName(group.CurrentUserRole.Value)})" : "")
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                    }
                                    else
                                    {
                                        <MudAlert Severity="Severity.Warning" Class="mb-4">
                                            You are not a member of any groups. Create or join a group first.
                                        </MudAlert>
                                    }

                                    @if (!string.IsNullOrEmpty(_groupRoleError))
                                    {
                                        <MudAlert Severity="Severity.Error" Class="mb-4">
                                            @_groupRoleError
                                        </MudAlert>
                                    }
                                }
                            </div>
                        </MudTabPanel>

                        <MudTabPanel Text="General Info" Icon="@Icons.Material.Filled.Info">
                            <div class="py-6">
                                <MudGrid Spacing="3">
                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="createDto.Title"
                                                      Label="Event Title"
                                                      Variant="Variant.Outlined"
                                                      Required
                                                      FullWidth />
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="createDto.Subtitle"
                                                      Label="Event Subtitle (Short summary)"
                                                      Variant="Variant.Outlined"
                                                      FullWidth />
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="createDto.Description"
                                                      Label="Description"
                                                      Variant="Variant.Outlined"
                                                      Lines="6"
                                                      FullWidth />
                                    </MudItem>

                                    <MudItem xs="12" md="6">
                                        <MudSelect T="int?" @bind-Value="createDto.EventTypeId"
                                                   Label="Event Type"
                                                   Variant="Variant.Outlined"
                                                   AnchorOrigin="Origin.BottomCenter">
                                            <MudSelectItem T="int?" Value="@((int?)null)">-- Select Event Type --</MudSelectItem>
                                            @if (eventTypes != null)
                                            {
                                                @foreach (var type in eventTypes)
                                                {
                                                    <MudSelectItem @key="type.Id" T="int?" Value="@((int?)type.Id)">@type.FullName</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudText Typo="Typo.subtitle2" Class="mb-2 mt-2" Color="Color.Secondary">Audience</MudText>
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" md="6">
                                                <MudSelect T="int?" @bind-Value="createDto.AudienceGenderId" Label="Gender" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                                    <MudSelectItem T="int?" Value="@((int?)null)">-- Any --</MudSelectItem>
                                                    @if (audienceGenders != null)
                                                    {
                                                        @foreach (var g in audienceGenders)
                                                        {
                                                            <MudSelectItem @key="g.Id" T="int?" Value="@((int?)g.Id)">@g.FullName</MudSelectItem>
                                                        }
                                                    }
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" md="6">
                                                <MudSelect T="int?" @bind-Value="createDto.AudienceAgeId" Label="Age Group" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                                    <MudSelectItem T="int?" Value="@((int?)null)">-- Any --</MudSelectItem>
                                                    @if (audienceAges != null)
                                                    {
                                                        @foreach (var a in audienceAges)
                                                        {
                                                            <MudSelectItem @key="a.Id" T="int?" Value="@((int?)a.Id)">@a.FullName</MudSelectItem>
                                                        }
                                                    }
                                                </MudSelect>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudGrid>
                            </div>
                        </MudTabPanel>

                        <MudTabPanel Text="Media" Icon="@Icons.Material.Filled.Image">
                            <div class="py-6 d-flex justify-center">
                                <div style="max-width: 600px; width: 100%;">
                                    <MudText Typo="Typo.h6" Class="mb-4 text-center">Event Image</MudText>
                                    <ImageUpload @ref="_imageUploadComponent"
                                                 @bind-PreviewUrl="imagePreviewUrl"
                                                 FileDataSelected="OnImageFileDataSelected"
                                                 IsProcessing="_isUploadingImage"
                                                 Width="100%"
                                                 Height="300px"
                                                 PlaceholderText="Upload featured image" />
                                    @if (_isUploadingImage)
                                    {
                                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Class="mt-4">
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Uploading image...</MudText>
                                        </MudStack>
                                    }
                                    @if (_uploadError != null)
                                    {
                                        <MudAlert Severity="Severity.Error" Class="mt-4" ShowCloseIcon="true" CloseIconClicked="@(() => _uploadError = null)">
                                            @_uploadError
                                        </MudAlert>
                                    }
                                </div>
                            </div>
                        </MudTabPanel>

                        <MudTabPanel Text="Sessions" Icon="@Icons.Material.Filled.EventAvailable">
                            <div class="py-6">
                                <div class="d-flex align-center gap-2 mb-4">
                                    <MudText Typo="Typo.h6">Event Sessions</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info">Minimum 1 required</MudChip>
                                </div>

                                <MudStack Spacing="4">
                                    @for (int i = 0; i < sessions.Count; i++)
                                    {
                                        var index = i;
                                        <MudCard Elevation="0" Class="pa-4 border-solid border-1 mud-border-lines-default rounded-lg">
                                            <div class="d-flex justify-space-between align-center mb-4">
                                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Session @(index + 1)</MudText>
                                                @if (sessions.Count > 1)
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveSession(index))" />
                                                }
                                            </div>

                                            <EventSessionEditor Session="sessions[index]"
                                                                SessionChanged="@((s) => OnSessionChanged(index, s))"
                                                                Index="index"
                                                                ShowRemoveButton="false"
                                                                ShowLocationSelector="true"
                                                                Locations="locations"
                                                                RegistrationModes="registrationModes"
                                                                ShowLanguageSelector="true"
                                                                Languages="languages" />
                                        </MudCard>
                                    }
                                </MudStack>

                                <div class="d-flex justify-center mt-6">
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="AddSession"
                                               Class="rounded-pill">
                                        Add Another Session
                                    </MudButton>
                                </div>
                            </div>
                        </MudTabPanel>

                        <MudTabPanel Text="Settings" Icon="@Icons.Material.Filled.Settings">
                            <div class="py-6">
                                <MudGrid Spacing="4">
                                    <MudItem xs="12" md="6">
                                        <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 700;">Format & Visibility</MudText>
                                        <MudStack Spacing="3">
                                            <MudSelect @bind-Value="createDto.EventFormatId" Label="Format" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                                @if (eventFormats != null)
                                                {
                                                    @foreach (var f in eventFormats)
                                                    {
                                                        <MudSelectItem @key="f.Id" Value="@f.Id">@f.FullName</MudSelectItem>
                                                    }
                                                }
                                            </MudSelect>
                                            <MudSelect @bind-Value="createDto.VisibilityTypeId" Label="Visibility" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                                @if (visibilityTypes != null)
                                                {
                                                    @foreach (var v in visibilityTypes)
                                                    {
                                                        <MudSelectItem @key="v.Id" Value="@v.Id">@v.FullName</MudSelectItem>
                                                    }
                                                }
                                            </MudSelect>
                                        </MudStack>
                                    </MudItem>

                                    <MudItem xs="12" md="6">
                                        <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 700;">Categorization</MudText>
                                        <MudStack Spacing="3">
                                            <MudSelect T="Guid" Label="Categories" MultiSelection="true" @bind-SelectedValues="selectedCategoryIds" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                                @if (allCategories != null)
                                                {
                                                    @foreach (var c in allCategories)
                                                    {
                                                        if (c.Id is not Guid categoryId)
                                                        {
                                                            continue;
                                                        }

                                                        <MudSelectItem T="Guid" @key="categoryId" Value="@categoryId">@c.FullName</MudSelectItem>
                                                    }
                                                }
                                            </MudSelect>
                                            <MudSelect T="Guid" Label="Tags" MultiSelection="true" @bind-SelectedValues="selectedTagIds" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                                @if (allTags != null)
                                                {
                                                    @foreach (var t in allTags)
                                                    {
                                                        if (t.Id is not Guid tagId)
                                                        {
                                                            continue;
                                                        }

                                                        <MudSelectItem T="Guid" @key="tagId" Value="@tagId">@t.FullName</MudSelectItem>
                                                    }
                                                }
                                            </MudSelect>
                                        </MudStack>
                                    </MudItem>

                                    <MudItem xs="12">
                                        <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 700;">Event Appearance</MudText>
                                        <MudPaper Elevation="0" Class="pa-4 bg-surface border-solid border-1 mud-border-lines-default rounded-lg">
                                            <MudGrid Spacing="3">
                                                <MudItem xs="12" md="4">
                                                    <MudTextField @bind-Value="_appearance.BackgroundColor"
                                                                  Label="Background Color"
                                                                  Variant="Variant.Outlined"
                                                                  Placeholder="#0f172a" />
                                                </MudItem>
                                                <MudItem xs="12" md="5">
                                                    <MudTextField @bind-Value="_appearance.BackgroundMediaUrl"
                                                                  Label="Background Media URL (Image/GIF)"
                                                                  Variant="Variant.Outlined"
                                                                  Placeholder="https://..." />
                                                </MudItem>
                                                <MudItem xs="12" md="3">
                                                    <MudSelect @bind-Value="_appearance.BackgroundEffect"
                                                               Label="Effect"
                                                               Variant="Variant.Outlined"
                                                               AnchorOrigin="Origin.BottomCenter">
                                                        <MudSelectItem Value="@("None")">None</MudSelectItem>
                                                        <MudSelectItem Value="@("SoftOverlay")">Soft Overlay</MudSelectItem>
                                                        <MudSelectItem Value="@("StrongOverlay")">Strong Overlay</MudSelectItem>
                                                        <MudSelectItem Value="@("Blur")">Blur Overlay</MudSelectItem>
                                                    </MudSelect>
                                                </MudItem>
                                            </MudGrid>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                                This style is applied per event and can differ between events from the same organization.
                                            </MudText>
                                        </MudPaper>
                                    </MudItem>
                                </MudGrid>
                            </div>
                        </MudTabPanel>
                    </MudTabs>

                    <MudDivider Class="my-4" />

                    <div class="d-flex justify-space-between gap-3">
                        <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/events"))" Class="rounded-pill">Cancel</MudButton>

                        <div class="d-flex gap-3">
                            <MudButton ButtonType="ButtonType.Button"
                                       Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       Disabled="@(_activeStepIndex == 0 || isProcessing || _isUploadingImage)"
                                       StartIcon="@Icons.Material.Filled.NavigateBefore"
                                       OnClick="GoToPreviousStep"
                                       Class="rounded-pill">
                                Previous
                            </MudButton>

                            @if (_activeStepIndex < LastWizardStepIndex)
                            {
                                <MudButton ButtonType="ButtonType.Button"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Disabled="@(isProcessing || _isUploadingImage || !string.IsNullOrEmpty(_organizationRoleError) || !string.IsNullOrEmpty(_groupRoleError))"
                                           EndIcon="@Icons.Material.Filled.NavigateNext"
                                           OnClick="GoToNextStep"
                                           Class="rounded-pill px-6">
                                    Next
                                </MudButton>
                            }
                            else
                            {
                                <MudButton ButtonType="ButtonType.Submit"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Disabled="@(isProcessing || _isUploadingImage || !string.IsNullOrEmpty(_organizationRoleError) || !string.IsNullOrEmpty(_groupRoleError))"
                                           StartIcon="@(isProcessing || _isUploadingImage ? null : Icons.Material.Filled.Save)"
                                           Class="rounded-pill px-6">
                                    @if (isProcessing)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        <span>Creating...</span>
                                    }
                                    else if (_isUploadingImage)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        <span>Uploading image...</span>
                                    }
                                    else
                                    {
                                        <span>Create Event</span>
                                    }
                                </MudButton>
                            }
                        </div>
                    </div>
                </EditForm>
            </div>
        </MudPaper>
    }
</MudContainer>
