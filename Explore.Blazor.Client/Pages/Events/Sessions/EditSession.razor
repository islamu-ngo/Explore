@page "/events/{EventId:guid}/sessions/{SessionId:guid}/edit"
@rendermode InteractiveServer
@attribute [Authorize]

@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Contracts.Services.Events
@using Explore.Blazor.Client.Models.EventSessionGroups
@using Explore.Blazor.Client.Services
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using Explore.Blazor.Client.Models.EventSessions
@using Explore.Blazor.Client.Components.Forms
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Edit program item</PageTitle>

<main class="edit-session" aria-labelledby="edit-session-title">
    <MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
        <MudPaper Class="edit-session__surface pa-6" Elevation="0">
            <MudText Typo="Typo.h4" HtmlTag="h1" id="edit-session-title" Class="mb-2">Edit program item</MudText>
            @if (_isLoading)
            {
                <div class="edit-session__loading" role="status" aria-live="polite">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Loading session...</MudText>
                </div>
            }
            else if (_event is null || _sourceSession is null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
                    @(_submitState.ErrorMessage ?? "The program item could not be loaded. Return to the event draft and try again.")
                </MudAlert>

                <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToEventDraft">
                    Back to event draft
                </MudButton>
            }
            else
            {
                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                    Update <strong>@_sourceSession.Title</strong> for <strong>@_event.Title</strong>. Program items are sessions, not child events.
                </MudText>

                @if (!string.IsNullOrWhiteSpace(_successMessage))
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4" role="status">
                        @_successMessage
                    </MudAlert>
                }

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                    This dedicated composer edits the saved program item without reopening the event shell drawer.
                </MudAlert>

                @if (!_canEditSession)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
                        You do not currently have permission to edit this program item.
                    </MudAlert>
                }

                <EditForm EditContext="_editContext" OnValidSubmit="SaveSessionAsync">
                    <FormSubmissionGuard State="@_submitState">
                    <AppValidationSummary />

                    <div class="edit-session__form-grid">
                        <MudTextField Variant="Variant.Outlined" T="string"
                                      Value="@_session.Title"
                                      ValueChanged="@(value => _session.Title = value)"
                                      For="@(() => _session.Title)"
                                      Required="true"
                                      FullWidth="true"
                                      Placeholder="Program item title"
                                      aria-label="Program item title" />

                        <MudTextField Variant="Variant.Outlined" T="string"
                                      Value="@_session.Description"
                                      ValueChanged="@(value => _session.Description = value)"
                                      For="@(() => _session.Description)"
                                      FullWidth="true"
                                      Lines="4"
                                      Placeholder="What will attendees learn or do?"
                                      aria-label="Program item description" />

                        <MudDatePicker Label="Program item date"
                                       Date="@_sessionDate"
                                       DateChanged="@(value => _sessionDate = value)"
                                       Required="true"
                                       Variant="Variant.Outlined" />

                        <div class="edit-session__time-grid">
                            <MudTimePicker Label="Start time"
                                           Time="@_startTime"
                                           TimeChanged="@(value => _startTime = value)"
                                           Required="true"
                                           Variant="Variant.Outlined" />
                            <MudTimePicker Label="End time"
                                           Time="@_endTime"
                                           TimeChanged="@(value => _endTime = value)"
                                           Required="true"
                                           Variant="Variant.Outlined" />
                        </div>

                        <MudSelect T="Guid?"
                                   Label="Location"
                                   Value="@_session.LocationId"
                                   ValueChanged="OnLocationChangedAsync"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">No location yet</MudSelectItem>
                            @foreach (var location in _locations.Where(location => location.Id.HasValue))
                            {
                                <MudSelectItem T="Guid?" Value="@location.Id">@FormatLocation(location)</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="Guid?"
                                   Label="Room"
                                   Value="@_session.RoomId"
                                   ValueChanged="@(value => _session.RoomId = value)"
                                   Variant="Variant.Outlined"
                                   Disabled="@(!_session.LocationId.HasValue || !_rooms.Any())"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">No room yet</MudSelectItem>
                            @foreach (var room in _rooms)
                            {
                                <MudSelectItem T="Guid?" Value="@room.Id">@FormatRoom(room)</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="Guid?"
                                   Label="Program section"
                                   Value="@_selectedSessionGroupId"
                                   ValueChanged="@(value => _selectedSessionGroupId = value)"
                                   Variant="Variant.Outlined"
                                   Disabled="@(!_sessionGroups.Any())"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">No program section yet</MudSelectItem>
                            @foreach (var group in _sessionGroups.OrderBy(group => group.SortOrder).ThenBy(group => group.Name))
                            {
                                <MudSelectItem T="Guid?" Value="@group.Id">@FormatSessionGroup(group)</MudSelectItem>
                            }
                        </MudSelect>

                        <MudNumericField T="int?"
                                         Label="Capacity"
                                         Value="@_session.MaxAudienceAttendees"
                                         ValueChanged="@(value => _session.MaxAudienceAttendees = value)"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Placeholder="Optional" />

                        <MudSelect T="int?"
                                   Label="Registration mode"
                                   Value="@_session.RegistrationModeId"
                                   ValueChanged="@(value => _session.RegistrationModeId = value)"
                                   Variant="Variant.Outlined"
                                   Disabled="@(!_registrationModes.Any())"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var mode in _registrationModes.Where(mode => mode.Id.HasValue).OrderBy(mode => mode.Id))
                            {
                                <MudSelectItem T="int?" Value="@mode.Id">@FormatRegistrationMode(mode)</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <div class="edit-session__actions">
                        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToEventDraft" Disabled="@_submitState.IsSubmitting">
                            Back to event draft
                        </MudButton>
                        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit" StartIcon="@Icons.Material.Filled.Save" Disabled="@(_submitState.IsSubmitting || !_canEditSession)">
                            @(_submitState.IsSubmitting ? "Saving..." : "Save changes")
                        </MudButton>
                    </div>
                    </FormSubmissionGuard>
                </EditForm>
            }
        </MudPaper>
    </MudContainer>
</main>

@code {
    [Parameter] public Guid EventId { get; set; }
    [Parameter] public Guid SessionId { get; set; }

    [Inject] private IEventService EventService { get; set; } = default!;
    [Inject] private IAdminService AdminService { get; set; } = default!;
    [Inject] private ILocationService LocationService { get; set; } = default!;
    [Inject] private ILocationRoomService LocationRoomService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private EventDto? _event;
    private EventSessionDto? _sourceSession;
    private ICollection<LocationListDto> _locations = new List<LocationListDto>();
    private ICollection<LocationRoomListDto> _rooms = new List<LocationRoomListDto>();
    private ICollection<EventSessionGroupListModel> _sessionGroups = new List<EventSessionGroupListModel>();
    private ICollection<RegistrationModeListDto> _registrationModes = new List<RegistrationModeListDto>();
    private readonly UpdateEventSessionRequest _session = new();
    private DateTime? _sessionDate;
    private TimeSpan? _startTime;
    private TimeSpan? _endTime;
    private bool _isLoading = true;
    private bool _canEditSession;
    private Guid? _selectedSessionGroupId;
    private Guid? _initialSessionGroupId;
    private string? _successMessage;

    private EditContext _editContext = default!;
    private FormSubmitState _submitState = new();
    private ServerValidationErrorStore _errorStore = new();

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_session);
        _errorStore.Init(_editContext);
        var eventTask = EventService.GetEventByIdAsync(EventId);
        var sessionTask = EventService.GetSessionByIdAsync(SessionId);
        var locationsTask = LocationService.GetAllLocationsAsync();
        var sessionGroupsTask = EventService.GetSessionGroupsByEventAsync(EventId);
        var registrationModesTask = AdminService.GetRegistrationModesAsync();

        _event = await eventTask;
        _sourceSession = await sessionTask;
        _locations = await locationsTask;
        _sessionGroups = await sessionGroupsTask;
        _registrationModes = await registrationModesTask;

        if (_event is null)
        {
            _submitState.Fail("The event draft could not be loaded.");
        }
        else if (_sourceSession is null)
        {
            _submitState.Fail("The session could not be loaded.");
        }
        else if (_sourceSession.EventId != EventId)
        {
            _submitState.Fail("This session does not belong to the selected event draft.");
            _sourceSession = null;
        }
        else
        {
            _canEditSession = _sourceSession.HasHalLink("edit");
            PopulateSession(_sourceSession);
            _selectedSessionGroupId = GetPrimarySessionGroupId(_sourceSession);
            _initialSessionGroupId = _selectedSessionGroupId;
            await LoadRoomsForLocationAsync(_session.LocationId);
        }

        _isLoading = false;
    }

    private async Task OnLocationChangedAsync(Guid? locationId)
    {
        _session.LocationId = locationId;
        _session.RoomId = null;
        await LoadRoomsForLocationAsync(locationId);
    }

    private async Task LoadRoomsForLocationAsync(Guid? locationId)
    {
        if (!locationId.HasValue || locationId.Value == Guid.Empty)
        {
            _rooms = new List<LocationRoomListDto>();
            _session.RoomId = null;
            return;
        }

        _rooms = await LocationRoomService.GetRoomsByLocationAsync(locationId.Value);
        if (_session.RoomId.HasValue && _rooms.All(room => room.Id != _session.RoomId.Value))
        {
            _session.RoomId = null;
        }
    }

    private void PopulateSession(EventSessionDto session)
    {
        _session.Id = session.Id;
        _session.EventId = EventId;
        _session.Title = session.Title ?? string.Empty;
        _session.Description = session.Description;
        _session.LocationId = session.LocationId;
        _session.RoomId = session.RoomId;
        _session.SortOrder = session.SortOrder;
        _session.FeaturedImageId = session.FeaturedImageId;
        _session.MaxAudienceAttendees = session.MaxAudienceAttendees;
        _session.RegistrationModeId = session.RegistrationModeId;
        _session.Price = session.Price;
        _session.CurrencyCode = session.CurrencyCode;

        var localStart = DateTimeHelper.ConvertUtcToLocal(session.StartTime);
        var localEnd = DateTimeHelper.ConvertUtcToLocal(session.EndTime);
        _sessionDate = localStart?.Date ?? DateTime.Today;
        _startTime = localStart?.TimeOfDay ?? new TimeSpan(9, 0, 0);
        _endTime = localEnd?.TimeOfDay ?? new TimeSpan(10, 0, 0);
    }

    private async Task SaveSessionAsync()
    {
        _successMessage = null;

        if (!TryPrepareSession(out var validationError))
        {
            _submitState.Fail(validationError!);
            return;
        }

        if (_submitState.IsSubmitting) return;
        _submitState.Start();
        try
        {
            var result = await EventService.UpdateSessionAsync(_session);
            if (result.Success == true)
            {
                if (!await AssignSelectedProgramSectionAsync(SessionId))
                {
                    return;
                }

                _successMessage = "Program item saved. Returning to the event draft.";
                Navigation.NavigateTo($"/events/{EventId}/edit");
                return;
            }

            _submitState.Fail(result.Message ?? "Program item could not be saved. Check the details and try again.");
        }
        catch (ApiException ex)
        {
            if (!_errorStore.HandleApiError(ex))
            {
                _submitState.Fail($"Program item could not be saved: {ex.Message}");
            }
            else
            {
                _submitState.Fail("Please fix the validation errors below.");
            }
        }
        catch (Exception ex)
        {
            _submitState.Fail($"Program item could not be saved: {ex.Message}");
        }
        finally
        {
            if (!_submitState.HasError)
            {
                _submitState.Complete();
            }
        }
    }

    private bool TryPrepareSession(out string? validationError)
    {
        validationError = null;
        if (!_canEditSession)
        {
            validationError = "You do not currently have permission to edit this program item.";
            return false;
        }

        if (_session.Id is null || _session.Id == Guid.Empty || _session.Id != SessionId)
        {
            validationError = "The session context is invalid. Return to the event draft and try again.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(_session.Title))
        {
            validationError = "Program item title is required.";
            return false;
        }

        if (!_sessionDate.HasValue || !_startTime.HasValue || !_endTime.HasValue)
        {
            validationError = "Program item date, start time, and end time are required.";
            return false;
        }

        var start = _sessionDate.Value.Date + _startTime.Value;
        var end = _sessionDate.Value.Date + _endTime.Value;
        if (end <= start)
        {
            validationError = "End time must be after start time.";
            return false;
        }

        _session.EventId = EventId;
        _session.Title = _session.Title.Trim();
        _session.MaxAudienceAttendees = _session.MaxAudienceAttendees > 0 ? _session.MaxAudienceAttendees : null;
        _session.StartTime = DateTimeHelper.ConvertLocalToUtc(start);
        _session.EndTime = DateTimeHelper.ConvertLocalToUtc(end);
        return true;
    }

    private async Task<bool> AssignSelectedProgramSectionAsync(Guid sessionId)
    {
        if (!_selectedSessionGroupId.HasValue || _selectedSessionGroupId.Value == Guid.Empty)
        {
            if (!_initialSessionGroupId.HasValue || _initialSessionGroupId.Value == Guid.Empty)
                return true;

            var unassignResult = await EventService.UnassignSessionFromGroupAsync(
                EventId,
                _initialSessionGroupId.Value,
                sessionId);
            if (unassignResult.Success == true)
                return true;

            _submitState.Fail(unassignResult.Message ?? "Session was saved, but it could not be removed from the previous program section.");
            return false;
        }

        if (_selectedSessionGroupId == _initialSessionGroupId)
            return true;

        var result = await EventService.AssignSessionToGroupAsync(
            EventId,
            _selectedSessionGroupId.Value,
            sessionId);
        if (result.Success == true)
            return true;

        _submitState.Fail(result.Message ?? "Session was saved, but it could not be assigned to the selected program section.");
        return false;
    }

    private static Guid? GetPrimarySessionGroupId(EventSessionDto session)
        => session.SessionGroups?
            .OrderByDescending(group => group.IsPrimary ?? false)
            .ThenBy(group => group.SortOrder ?? int.MaxValue)
            .Select(group => group.EventSessionGroupId)
            .FirstOrDefault(groupId => groupId.HasValue && groupId.Value != Guid.Empty);

    private static string FormatLocation(LocationListDto location)
    {
        if (!string.IsNullOrWhiteSpace(location.City) && !string.IsNullOrWhiteSpace(location.Country))
        {
            return $"{location.FullName} — {location.City}, {location.Country}";
        }

        return location.FullName;
    }

    private static string FormatRoom(LocationRoomListDto room) => room.Capacity.HasValue
        ? $"{room.Name} · {room.Capacity.Value} seats"
        : room.Name;

    private static string FormatSessionGroup(EventSessionGroupListModel group)
    {
        if (!string.IsNullOrWhiteSpace(group.RoomName))
            return $"{group.Name} · {group.RoomName}";

        if (!string.IsNullOrWhiteSpace(group.LocationName))
            return $"{group.Name} · {group.LocationName}";

        return group.Name;
    }

    private static string FormatRegistrationMode(RegistrationModeListDto mode)
        => string.IsNullOrWhiteSpace(mode.Description)
            ? mode.FullName
            : $"{mode.FullName} · {mode.Description}";

    private void BackToEventDraft() => Navigation.NavigateTo($"/events/{EventId}/edit");
}
