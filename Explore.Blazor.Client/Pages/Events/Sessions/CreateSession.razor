@page "/events/{EventId:guid}/sessions/create"
@rendermode InteractiveServer
@attribute [Authorize]

@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Contracts.Services.Events
@using Explore.Blazor.Client.Services
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using Explore.Blazor.Client.Models.EventSessions
@using Explore.Blazor.Client.Components.Forms
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Add program item</PageTitle>

<main class="create-session" aria-labelledby="create-session-title">
    <MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
        <MudPaper Class="create-session__surface pa-6" Elevation="0">
            <MudText Typo="Typo.h4" HtmlTag="h1" id="create-session-title" Class="mb-2">Add program item</MudText>
            @if (_isLoading)
            {
                <div class="create-session__loading" role="status" aria-live="polite">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Loading event draft...</MudText>
                </div>
            }
            else if (_event is null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
                    @(_submitState.ErrorMessage ?? "The event draft could not be loaded. Return to the draft and try again.")
                </MudAlert>

                <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToEventDraft">
                    Back to event draft
                </MudButton>
            }
            else
            {
                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                    Add a talk, workshop, panel, class, or activity to <strong>@_event.Title</strong>. Program items are sessions, not child events.
                </MudText>

                @if (!string.IsNullOrWhiteSpace(_successMessage))
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4" role="status">
                        @_successMessage
                    </MudAlert>
                }

                <SessionCreateContextBanner TimeZoneId="@_createContext?.TimeZoneId"
                                            EventStartDate="@_createContext?.EventStartDate"
                                            EventEndDate="@_createContext?.EventEndDate"
                                            Notices="@_createContext?.Notices" />

                @if (!_canAddSession)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
                        You do not currently have permission to add program items to this event draft.
                    </MudAlert>
                }

                <EditForm EditContext="_editContext" OnValidSubmit="SaveSessionAsync">
                    <FormSubmissionGuard State="@_submitState">
                    <AppValidationSummary />

                    <div class="create-session__form-grid">
                        <MudTextField Variant="Variant.Outlined" T="string"
                                      Value="@_session.Title"
                                      ValueChanged="@(value => _session.Title = value)"
                                      For="@(() => _session.Title)"
                                      Required="true"
                                      FullWidth="true"
                                      Placeholder="Program item title"
                                      aria-label="Program item title" />

                        <MudTextField Variant="Variant.Outlined" T="string"
                                      Value="@_session.Description"
                                      ValueChanged="@(value => _session.Description = value)"
                                      For="@(() => _session.Description)"
                                      FullWidth="true"
                                      Lines="4"
                                      Placeholder="What will attendees learn or do?"
                                      aria-label="Program item description" />

                        <MudDatePicker Label="Program item date"
                                       Date="@_sessionDate"
                                       DateChanged="@(value => _sessionDate = value)"
                                       Required="true"
                                       Variant="Variant.Outlined" />

                        <div class="create-session__time-grid">
                            <MudTimePicker Label="Start time"
                                           Time="@_startTime"
                                           TimeChanged="@(value => _startTime = value)"
                                           Required="true"
                                           Variant="Variant.Outlined" />
                            <MudTimePicker Label="End time"
                                           Time="@_endTime"
                                           TimeChanged="@(value => _endTime = value)"
                                           Required="true"
                                           Variant="Variant.Outlined" />
                        </div>

                        <MudSelect T="Guid?"
                                   Label="Location"
                                   Value="@_session.LocationId"
                                   ValueChanged="OnLocationChangedAsync"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">No location yet</MudSelectItem>
                            @foreach (var location in _locations)
                            {
                                <MudSelectItem T="Guid?" Value="@location.Id">@FormatLocation(location)</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="Guid?"
                                   Label="Room"
                                   Value="@_session.RoomId"
                                   ValueChanged="@(value => _session.RoomId = value)"
                                   Variant="Variant.Outlined"
                                   Disabled="@(!_session.LocationId.HasValue || !_rooms.Any())"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">No room yet</MudSelectItem>
                            @foreach (var room in _rooms)
                            {
                                <MudSelectItem T="Guid?" Value="@room.Id">@FormatRoom(room)</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSelect T="Guid?"
                                   Label="Program section"
                                   Value="@_selectedSessionGroupId"
                                   ValueChanged="@(value => _selectedSessionGroupId = value)"
                                   Variant="Variant.Outlined"
                                   Disabled="@(!_sessionGroups.Any())"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">No program section yet</MudSelectItem>
                            @foreach (var group in _sessionGroups.OrderBy(group => group.SortOrder).ThenBy(group => group.Name))
                            {
                                <MudSelectItem T="Guid?" Value="@group.Id">@FormatSessionGroup(group)</MudSelectItem>
                            }
                        </MudSelect>

                        <MudNumericField T="int?"
                                         Label="Capacity"
                                         Value="@_session.MaxAudienceAttendees"
                                         ValueChanged="@(value => _session.MaxAudienceAttendees = value)"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Placeholder="Optional" />

                        <MudSelect T="int?"
                                   Label="Registration mode"
                                   Value="@_session.RegistrationModeId"
                                   ValueChanged="@(value => _session.RegistrationModeId = value)"
                                   Variant="Variant.Outlined"
                                   Disabled="@(!_registrationModes.Any())"
                                   AnchorOrigin="Origin.BottomCenter">
                            @foreach (var mode in _registrationModes.Where(mode => mode.Id.HasValue).OrderBy(mode => mode.Id))
                            {
                                <MudSelectItem T="int?" Value="@mode.Id">@FormatRegistrationMode(mode)</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <div class="create-session__actions">
                        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToEventDraft" Disabled="@_submitState.IsSubmitting">
                            Back to event draft
                        </MudButton>
                        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit" StartIcon="@Icons.Material.Filled.Save" Disabled="@(_submitState.IsSubmitting || !_canAddSession)">
                            @(_submitState.IsSubmitting ? "Saving..." : "Save program item")
                        </MudButton>
                    </div>
                    </FormSubmissionGuard>
                </EditForm>
            }
        </MudPaper>
    </MudContainer>
</main>

@code {
    [Parameter] public Guid EventId { get; set; }

    [Inject] private IEventService EventService { get; set; } = default!;
    [Inject] private IAdminService AdminService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private const int FallbackRegistrationModeId = 1;

    private EventDto? _event;
    private EventSessionCreateContextDto? _createContext;
    private ICollection<EventSessionCreateLocationOptionDto> _locations = new List<EventSessionCreateLocationOptionDto>();
    private ICollection<EventSessionCreateRoomOptionDto> _rooms = new List<EventSessionCreateRoomOptionDto>();
    private ICollection<EventSessionCreateGroupOptionDto> _sessionGroups = new List<EventSessionCreateGroupOptionDto>();
    private ICollection<RegistrationModeListDto> _registrationModes = new List<RegistrationModeListDto>();
    private readonly CreateEventSessionRequest _session = new()
    {
        RegistrationModeId = FallbackRegistrationModeId,
        Title = string.Empty
    };
    private DateTime? _sessionDate = DateTime.Today.AddDays(1);
    private TimeSpan? _startTime = new(9, 0, 0);
    private TimeSpan? _endTime = new(10, 0, 0);
    private bool _isLoading = true;
    private bool _canAddSession;
    private Guid? _selectedSessionGroupId;
    private Guid? _savedSessionId;
    private string? _successMessage;

    private EditContext _editContext = default!;
    private FormSubmitState _submitState = new();
    private ServerValidationErrorStore _errorStore = new();

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(_session);
        _errorStore.Init(_editContext);
        var eventTask = EventService.GetEventByIdAsync(EventId);
        var createContextTask = EventService.GetEventSessionCreateContextAsync(EventId);
        var registrationModesTask = AdminService.GetRegistrationModesAsync();

        _event = await eventTask;
        _createContext = await createContextTask;
        _registrationModes = await registrationModesTask;
        if (_event is null)
        {
            _submitState.Fail("The event draft could not be loaded.");
        }
        else
        {
            _canAddSession = _event.HasHalLink("add-session");
            if (_createContext is null)
            {
                _submitState.Fail("Program item context could not be loaded. You can still save basic details, but inherited defaults and selector options are unavailable.");
            }
            else
            {
                ApplyCreateContext(_createContext);
            }
        }

        _isLoading = false;
    }

    private void ApplyCreateContext(EventSessionCreateContextDto context)
    {
        _locations = context.Locations ?? new List<EventSessionCreateLocationOptionDto>();
        _sessionGroups = context.SessionGroups ?? new List<EventSessionCreateGroupOptionDto>();
        _session.RegistrationModeId = context.Defaults?.RegistrationModeId > 0
            ? context.Defaults.RegistrationModeId
            : FallbackRegistrationModeId;

        if (context.Defaults?.SessionDate is { } sessionDate)
        {
            _sessionDate = sessionDate.DateTime;
        }

        if (TryParseDefaultTime(context.Defaults?.StartTime, out var startTime))
        {
            _startTime = startTime;
        }

        if (TryParseDefaultTime(context.Defaults?.EndTime, out var endTime))
        {
            _endTime = endTime;
        }
    }

    private static bool TryParseDefaultTime(string? value, out TimeSpan time)
    {
        return TimeSpan.TryParse(
            value,
            System.Globalization.CultureInfo.InvariantCulture,
            out time);
    }

    private Task OnLocationChangedAsync(Guid? locationId)
    {
        _session.LocationId = locationId;
        _session.RoomId = null;
        LoadRoomsForLocation(locationId);
        return Task.CompletedTask;
    }

    private void LoadRoomsForLocation(Guid? locationId)
    {
        if (!locationId.HasValue || locationId.Value == Guid.Empty)
        {
            _rooms = new List<EventSessionCreateRoomOptionDto>();
            _session.RoomId = null;
            return;
        }

        _rooms = (_createContext?.Rooms ?? new List<EventSessionCreateRoomOptionDto>())
            .Where(room => room.LocationId == locationId.Value)
            .OrderBy(room => room.SortOrder)
            .ThenBy(room => room.Name)
            .ToList();
        if (_session.RoomId.HasValue && _rooms.All(room => room.Id != _session.RoomId.Value))
        {
            _session.RoomId = null;
        }
    }

    private async Task SaveSessionAsync()
    {
        _successMessage = null;

        if (!TryPrepareSession(out var validationError))
        {
            _submitState.Fail(validationError!);
            return;
        }

        if (_submitState.IsSubmitting) return;
        _submitState.Start();
        try
        {
            if (!_savedSessionId.HasValue || _savedSessionId.Value == Guid.Empty)
            {
                var result = await EventService.CreateSessionAsync(_session);
                if (result.Success != true || !result.Id.HasValue || result.Id.Value == Guid.Empty)
                {
                    _submitState.Fail(result.Message ?? "Program item could not be saved. Check the details and try again.");
                    return;
                }

                _savedSessionId = result.Id.Value;
            }

            if (!await AssignSelectedProgramSectionAsync(_savedSessionId.Value))
                return;

            _successMessage = "Program item saved. Returning to the event draft.";
            Navigation.NavigateTo($"/events/{EventId}/edit");
        }
        catch (ApiException ex)
        {
            if (!_errorStore.HandleApiError(ex))
            {
                _submitState.Fail($"Program item could not be saved: {ex.Message}");
            }
            else
            {
                _submitState.Fail("Please fix the validation errors below.");
            }
        }
        catch (Exception ex)
        {
            _submitState.Fail($"Program item could not be saved: {ex.Message}");
        }
        finally
        {
            if (!_submitState.HasError)
            {
                _submitState.Complete();
            }
        }
    }

    private bool TryPrepareSession(out string? validationError)
    {
        validationError = null;
        if (_event?.TenantId is null || _event.TenantId == Guid.Empty)
        {
            validationError = "The event draft is missing tenant context. Return to the draft and try again.";
            return false;
        }

        if (!_canAddSession)
        {
            validationError = "You do not currently have permission to add program items to this event draft.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(_session.Title))
        {
            validationError = "Program item title is required.";
            return false;
        }

        if (!_sessionDate.HasValue || !_startTime.HasValue || !_endTime.HasValue)
        {
            validationError = "Program item date, start time, and end time are required.";
            return false;
        }

        var start = _sessionDate.Value.Date + _startTime.Value;
        var end = _sessionDate.Value.Date + _endTime.Value;
        if (end <= start)
        {
            validationError = "End time must be after start time.";
            return false;
        }

        _session.EventId = EventId;
        _session.TenantId = _event.TenantId;
        _session.Title = _session.Title.Trim();
        _session.MaxAudienceAttendees = _session.MaxAudienceAttendees > 0 ? _session.MaxAudienceAttendees : null;
        _session.StartTime = DateTimeHelper.ConvertLocalToUtc(start);
        _session.EndTime = DateTimeHelper.ConvertLocalToUtc(end);
        return true;
    }

    private async Task<bool> AssignSelectedProgramSectionAsync(Guid sessionId)
    {
        if (!_selectedSessionGroupId.HasValue || _selectedSessionGroupId.Value == Guid.Empty)
            return true;

        var result = await EventService.AssignSessionToGroupAsync(
            EventId,
            _selectedSessionGroupId.Value,
            sessionId);
        if (result.Success == true)
            return true;

        _submitState.Fail(result.Message ?? "Session was saved, but it could not be assigned to the selected program section.");
        return false;
    }

    private static string FormatLocation(EventSessionCreateLocationOptionDto location)
    {
        if (!string.IsNullOrWhiteSpace(location.City) && !string.IsNullOrWhiteSpace(location.Country))
        {
            return $"{location.FullName} — {location.City}, {location.Country}";
        }

        return location.FullName;
    }

    private static string FormatRoom(EventSessionCreateRoomOptionDto room) => room.Capacity.HasValue
        ? $"{room.Name} · {room.Capacity.Value} seats"
        : room.Name;

    private static string FormatSessionGroup(EventSessionCreateGroupOptionDto group)
    {
        if (!string.IsNullOrWhiteSpace(group.RoomName))
            return $"{group.Name} · {group.RoomName}";

        if (!string.IsNullOrWhiteSpace(group.LocationName))
            return $"{group.Name} · {group.LocationName}";

        return group.Name;
    }

    private static string FormatRegistrationMode(RegistrationModeListDto mode)
        => string.IsNullOrWhiteSpace(mode.Description)
            ? mode.FullName
            : $"{mode.FullName} · {mode.Description}";

    private void BackToEventDraft() => Navigation.NavigateTo($"/events/{EventId}/edit");
}
