@page "/myevents"
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Pages.Events.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web.Virtualization
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>My Events</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4 py-sm-8 py-md-12">
    <!-- Header -->
    <div class="d-flex flex-wrap align-end justify-space-between gap-4 mb-8">
        <div>
            <MudText Typo="Typo.overline" Class="mud-text-secondary" Style="letter-spacing: 0.18em;">MANAGE</MudText>
            <MudText Typo="Typo.h4">My Events</MudText>
        </div>
        <div class="d-flex flex-wrap gap-3">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Business"
                       OnClick="NavigateToCreateOrganization">
                Create Organization
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="NavigateToCreateEvent">
                Organize Event
            </MudButton>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex flex-column align-center justify-center py-16">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-4">
                Loading your events...
            </MudText>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-4">
            @_errorMessage
            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="RetryLoadAsync" Class="ml-4">
                Retry
            </MudButton>
        </MudAlert>
    }
    else
    {
        <!-- Filters -->
        <MudGrid Class="mb-8">
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="Guid?" Value="@_selectedOrganizationId" ValueChanged="@((Guid? v) => OnOrganizationChanged(v))"
                           Label="Organization" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                    <MudSelectItem T="Guid?" Value="@Guid.Empty">All Organizations</MudSelectItem>
                    @foreach (var org in _myOrganizations)
                    {
                        <MudSelectItem @key="org.Id" T="Guid?" Value="@org.Id">@org.FullName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" Value="@_selectedCategory" ValueChanged="@((string? v) => OnCategoryChanged(v))"
                           Label="Event Type" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                    <MudSelectItem T="string" Value="@("")">All Types</MudSelectItem>
                    @foreach (var eventType in UniqueEventTypes)
                    {
                        <MudSelectItem T="string" Value="@eventType">@eventType</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="12" md="6">
                <MudTextField @bind-Value="_searchString"
                              Placeholder="Search events..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              DebounceInterval="300"
                              TextChanged="OnSearch"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>

        @if (!AllFilteredEvents.Any())
        {
            <div class="d-flex flex-column align-center justify-center py-16">
                <MudIcon Icon="@Icons.Material.Outlined.Event" Size="Size.Large" Color="Color.Default" Style="width: 80px; height: 80px; opacity: 0.2;" />
                <MudText Typo="Typo.h6" Class="mt-4">No events found</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @if (_events.Any())
                    {
                        <span>Try adjusting your filters</span>
                    }
                    else
                    {
                        <span>Create an event to get started</span>
                    }
                </MudText>
            </div>
        }
        else
        {
            <!-- Event Cards — Virtualized infinite scroll -->
            <MudGrid>
                <Virtualize Items="@AllFilteredEvents" Context="evt" OverscanCount="4">
                    <ItemContent>
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Class="h-100 d-flex flex-column position-relative">
                                <div style="position: absolute; top: 12px; right: 12px; z-index: 10;">
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" AriaLabel="Event options" Dense="true" Color="Color.Default" Variant="Variant.Filled" Size="Size.Small" Style="background: rgba(255,255,255,0.8); backdrop-filter: blur(4px); border-radius: 8px;">
                                        @if (CanEditEvent(evt))
                                        {
                                            <MudMenuItem OnClick="@(() => EditEvent(evt))">
                                                <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" Size="Size.Small" /> Edit
                                            </MudMenuItem>
                                        }
                                        <MudMenuItem OnClick="@(() => ViewEventDetails(evt))">
                                            <MudIcon Icon="@Icons.Material.Filled.Visibility" Class="mr-2" Size="Size.Small" /> View Details
                                        </MudMenuItem>
                                        @if (CanEditEvent(evt))
                                        {
                                            <MudMenuItem OnClick="@(() => ViewRegistrations(evt))">
                                                <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" Size="Size.Small" /> Registrations
                                            </MudMenuItem>
                                            <MudMenuItem OnClick="@(() => DeleteEvent(evt))" Class="text-error">
                                                <MudIcon Icon="@Icons.Material.Filled.Delete" Class="mr-2" Size="Size.Small" /> Delete
                                            </MudMenuItem>
                                        }
                                    </MudMenu>
                                </div>

                                <MudCardMedia Image="@GetEventImageUrl(evt)" Height="200" />
                                
                                <MudCardContent Class="flex-grow-1">
                                    <MudText Typo="Typo.button" Class="mud-text-disabled mb-1">@(evt.EventTypeFullName ?? "Event")</MudText>
                                    <MudText Typo="Typo.h6" Class="mb-4">@evt.Title</MudText>
                                    <MudText Typo="Typo.body2" Style="overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;">
                                        @evt.Description
                                    </MudText>
                                    
                                    <div class="d-flex align-center gap-2 mt-4">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Business">
                                            @(evt.ActorDisplayName ?? "Unknown")
                                        </MudChip>
                                        <div class="d-flex align-center gap-1 ml-auto">
                                            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Secondary" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@(evt.EventFormatFullName ?? "Online")</MudText>
                                        </div>
                                    </div>
                                </MudCardContent>

                                <MudCardActions>
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Primary"
                                               Href="@($"/event/detail/{evt.Id}")"
                                               EndIcon="@Icons.Material.Filled.ArrowForward">
                                        Details
                                    </MudButton>
                                    <MudSpacer />
                                    @if (CanEditEvent(evt))
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => EditEvent(evt))">Edit</MudButton>
                                    }
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    </ItemContent>
                    <Placeholder>
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Class="h-100 d-flex flex-column">
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
                                <MudCardContent>
                                    <MudSkeleton Width="40%" Class="mb-1" />
                                    <MudSkeleton Width="80%" Class="mb-4" />
                                    <MudSkeleton Width="100%" />
                                    <MudSkeleton Width="60%" />
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </Placeholder>
                </Virtualize>
            </MudGrid>

            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mt-8 mb-8">
                @AllFilteredEvents.Count event(s)
            </MudText>
        }
    }
</MudContainer>
