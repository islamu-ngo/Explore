@page "/welcome"
@using MudBlazor
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients
@using Microsoft.AspNetCore.Components
@inject IJSRuntime JS
@inject ILandingPageService LandingPageService

<style>
:root{
    --hero-grad-1:#5b7cfa;
    --hero-grad-2:#7f56d9;
    --hero-grad-3:#1f2937;
}

/* ---------- HERO ---------- */
.hero {
    position: relative;
    isolation: isolate;
    padding: 96px 0 64px 0;
    text-align: center;
    background: radial-gradient(1200px 600px at 50% -10%, color-mix(in srgb, var(--mud-palette-primary) 20%, transparent), transparent 60%),
                linear-gradient(180deg, var(--mud-palette-background) 0%, var(--mud-palette-surface) 100%);
    color: var(--mud-palette-text-primary);
    overflow: hidden;
}
.hero::before{
    content:"";
    position:absolute; inset:-20% -20% auto -20%;
    height:120%;
    background: conic-gradient(from 180deg at 50% 50%, var(--hero-grad-1), var(--hero-grad-2), var(--hero-grad-1));
    filter: blur(120px) saturate(140%) opacity(.35);
    animation: swirl 14s linear infinite;
    z-index:-1;
    opacity: 0.5; /* Reduced opacity for light mode compatibility */
}
@@keyframes swirl { to { transform: rotate(360deg);} }

.hero h1 { letter-spacing: .3px; }
.hero-sub { opacity:.92; max-width: 840px; margin: 12px auto 0 auto; }

/* ---------- REGISTER STRIP (glass card) ---------- */
.register-strip{
    margin-top: 36px;
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: 18px;
}
@@media (max-width: 900px){
    .register-strip{ grid-template-columns: 1fr; }
}

.glass{
    background: color-mix(in srgb, var(--mud-palette-surface) 70%, transparent);
    border: 1px solid var(--mud-palette-lines-default);
    border-radius: 18px;
    box-shadow: 0 8px 40px rgba(0,0,0,.15);
    backdrop-filter: blur(10px);
    color: var(--mud-palette-text-primary);
}

/* CTA button big */
.cta-primary .mud-button-label { font-size: 1.05rem; font-weight:600; }
.cta-secondary .mud-button-label { font-weight:600; }

/* ---------- SOCIAL PROOF / STATS ---------- */
.stats { display:flex; gap:18px; justify-content:center; flex-wrap:wrap; margin-top:24px;}
.stat{
    background: var(--mud-palette-surface);
    border:1px solid var(--mud-palette-lines-default);
    border-radius:14px; padding:14px 18px;
    min-width: 180px;
    color: var(--mud-palette-text-primary);
}
.stat b{ font-size:1.25rem; }
.stat span{ opacity:.8; }

/* ---------- BENEFITS GRID ---------- */
.benefits{
    margin: 72px 0 16px 0;
}
.benefit-grid{
    display:grid; gap:18px;
    grid-template-columns: repeat(3, 1fr);
}
@@media (max-width: 900px){
    .benefit-grid{ grid-template-columns:1fr; }
}

/* ---------- EVENTS CAROUSEL ---------- */
.carousel-wrap{
    margin: 36px 0 8px 0;
}

/* Force carousel to show full height */
.carousel-wrap .mud-carousel,
.carousel-wrap .mud-carousel-item,
.carousel-wrap .mud-carousel-content {
    height: auto !important;
    min-height: 450px;
}

.featured-events-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
}

.card{
    width: 340px; max-width: 92vw;
    background-color: var(--mud-palette-surface);
    border-radius: 16px;
    overflow:hidden;
    border: 1px solid color-mix(in srgb, var(--mud-palette-lines-default) 70%, transparent);
    transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
}
.card:hover{
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(0,0,0,.16);
    border-color: color-mix(in srgb, var(--mud-palette-primary) 40%, var(--mud-palette-lines-default));
}
.card-media{
    position: relative;
    height: 200px;
    overflow: hidden;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.2rem;
    font-weight: 600;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
}
.card-media::after{
    content:"";
    position:absolute;
    inset:0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(0,0,0,.25) 100%);
}
.event-body{
    padding: 14px 16px 18px 16px;
    flex: 1;
    display: flex;
    flex-direction: column;
}
.event-chips{ display:flex; gap:8px; margin: 10px 0 8px 0; }

/* Badges row */
.badges{
    display:flex;
    gap:8px;
    align-items:center;
    margin: 10px 0 6px 0;
}

/* Location row */
.loc{
    display:flex;
    align-items:center;
    gap:6px;
    opacity:.85;
}

/* ---------- FAQ ---------- */
.faq{ margin-top: 32px; }

/* ---------- UTIL ---------- */
.section { margin: 56px 0; }
.section h2 { margin-bottom: 6px; }
.muted { color: var(--mud-palette-text-secondary); }
.kicker { letter-spacing:.18em; text-transform:uppercase; font-size:.82rem; opacity:.8; }

@@media (prefers-reduced-motion: reduce){
    .hero::before{ animation:none; }
}

/* Mobile responsiveness (phones) */
@@media (max-width: 480px) {
  .hero {
    padding: 56px 0 40px 0;
  }
  .hero h1 {
    font-size: 1.8rem !important;
    line-height: 1.2;
  }
  .hero-sub {
    font-size: 0.95rem;
    margin: 10px auto 0 auto;
    max-width: 100%;
  }
  .register-strip {
    margin-top: 24px;
    gap: 12px;
  }
  .glass {
    border-radius: 14px;
    padding: 16px;
  }
  .stat {
    min-width: 140px;
    padding: 12px 14px;
    border-radius: 12px;
  }
  .stat b {
    font-size: 1.1rem;
  }
  .stat span {
    font-size: 0.85rem;
  }
  .benefit-grid {
    gap: 12px;
  }
  .carousel-wrap {
    margin: 24px 0 16px 0;
  }
  .carousel-wrap .mud-carousel,
  .carousel-wrap .mud-carousel-item,
  .carousel-wrap .mud-carousel-content {
        min-height: auto;
        height: auto;
  }
    .carousel-wrap .mud-carousel-item { padding: 12px 0 !important; }
    .carousel-wrap .mud-stack { flex-direction: column !important; align-items: stretch !important; gap: 12px !important; }
    .carousel-wrap .card { width: 100% !important; max-width: none !important; }
    .carousel-wrap .card-media { height: 150px; }
  .card {
    width: 100%;
    max-width: 100%;
  }
  .card-media {
    height: 140px;
    font-size: 1rem;
  }
  .event-body {
    padding: 12px 14px 14px 14px;
  }
  .event-chips {
    gap: 6px;
    margin: 8px 0 6px 0;
  }
  .featured-events-header {
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    margin-bottom: 16px;
  }
  .featured-events-header > div:first-child {
    order: 1;
  }
  .featured-events-header .mud-button-root {
    order: 2;
    width: 100%;
  }
  .kicker {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }
  .section {
    margin: 40px 0;
  }
}
</style>

<!-- HERO - Full width -->
<section class="hero">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudText Typo="Typo.overline" Class="kicker">Community • Events • Growth</MudText>
        <MudText Typo="Typo.h2" Align="Align.Center" Class="mt-1">Never Miss a Muslim Event Again</MudText>
        <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="hero-sub">
            Lectures, workshops, charity drives, and social gatherings. Discover, connect, and grow with a thriving Muslim community.
        </MudText>

        <!-- CTA + image -->
        <div class="register-strip">
            <div class="glass" style="padding:24px;">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.Center">
                    <MudButton Href="/login" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" Class="cta-primary" StartIcon="@Icons.Material.Filled.PersonAdd">
                        Create Account
                    </MudButton>
                    <MudButton Href="/login" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Large" Class="cta-secondary" StartIcon="@Icons.Material.Filled.Login">
                        I already have one
                    </MudButton>
                </MudStack>

                <div class="stats">
                    <div class="stat"><b>@_membersCount+</b><br /><span>Active members</span></div>
                    <div class="stat"><b>@_eventsCount</b><br /><span>Upcoming events</span></div>
                    <div class="stat"><b>98%</b><br /><span>Positive feedback</span></div>
                </div>

                <MudText Typo="Typo.caption" Class="mt-2" Style="opacity:.75;">
                    Free to join. Cancel anytime. No credit card required.
                </MudText>
            </div>

            <MudPaper Elevation="0" Class="glass" Style="display:flex;align-items:center;justify-content:center;padding:0;">
                <img src="image/landing_image_nonuser.png" alt="Community and events illustration" style="max-width:100%; border-radius:18px;" fetchpriority="high" width="600" height="400" />
            </MudPaper>
        </div>
    </MudContainer>
</section>

<MudContainer MaxWidth="MaxWidth.Large">

    <!-- BENEFITS -->
    <section class="section benefits" id="benefits">
        <MudText Typo="Typo.h4" Align="Align.Center">Why Join?</MudText>
        <MudText Typo="Typo.subtitle2" Align="Align.Center" Class="muted mb-4">
            Unlock access to exclusive Islamic content and stay informed about every opportunity to learn and give back.
        </MudText>

        <div class="benefit-grid">
            <MudPaper Class="glass" Style="padding:22px;">
                <MudStack Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.AutoStories" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Knowledge & Faith</MudText>
                    <MudText Typo="Typo.body2" Class="muted">
                        Join Quran study circles, lectures, and themed workshops guided by trusted speakers.
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="glass" Style="padding:22px;">
                <MudStack Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Handshake" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.h6">Meet & Connect</MudText>
                    <MudText Typo="Typo.body2" Class="muted">
                        Make meaningful connections, collaborate on projects, and expand your network locally.
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Class="glass" Style="padding:22px;">
                <MudStack Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.VolunteerActivism" Size="Size.Large" Color="Color.Success" />
                    <MudText Typo="Typo.h6">Act & Give Back</MudText>
                    <MudText Typo="Typo.body2" Class="muted">
                        Take part in charity drives, social causes, and community-building initiatives.
                    </MudText>
                </MudStack>
            </MudPaper>
        </div>
    </section>

    <!-- UPCOMING EVENTS -->
    <section class="section">
        <MudStack Spacing="1" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.overline" Class="kicker">Upcoming</MudText>
            <MudText Typo="Typo.h4" Align="Align.Center">Don’t Miss These Events</MudText>
            <MudText Typo="Typo.subtitle2" Align="Align.Center" Class="muted">
                Click any event to register and unlock full details.
            </MudText>
        </MudStack>

        <div class="carousel-wrap">
            <MudCarousel TData="object" AutoCycle="true" CycleInterval="7000" ShowArrows="true" FullHeight="false" Style="height: auto; min-height: 450px;">
                @if (_events.Any())
                {
                    @foreach (var chunk in Chunk(_events, 3))
                {
                    <MudCarouselItem Style="height: auto; padding: 20px 0;">
                        <MudStack Row="true" Gap="16px" Justify="Justify.Center" AlignItems="AlignItems.Stretch" Style="flex-wrap:wrap; height: 100%;">
                            @foreach (var evt in chunk)
                            {
                                <MudCard Elevation="0" Class="card" @onclick="@(() => ScrollToRegister())">
                                    <MudCardMedia Class="card-media">
                                        <div style="position: relative; z-index: 2;">@evt.Title</div>
                                    </MudCardMedia>
                                    <MudCardContent Class="event-body">
                                        <div class="event-chips">
                                            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small" Style="background: #8b5cf6; color: white;">
                                                @(evt.EventTypeFullName ?? "Event")
                                            </MudChip>
                                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" Style="border-color: #3b82f6; color: #60a5fa;">
                                                @(evt.EventFormatFullName ?? "Online")
                                            </MudChip>
                                            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small" Style="border-color: #10b981; color: #34d399;">
                                                @(evt.Price.HasValue && evt.Price > 0 ? $"{evt.CurrencyCode ?? "€"}{evt.Price:F2}" : "Free")
                                            </MudChip>
                                        </div>
                                        <MudText Typo="Typo.h6" Class="mb-2" Style="color: #f8fafc; font-weight: 600;">@evt.Title</MudText>
                                        <MudText Typo="Typo.body2" Class="mb-3" Style="color: #cbd5e1; line-height: 1.5; flex: 1;">@(TruncateText(evt.Description, 150))</MudText>

                                        <div class="d-flex align-center mb-2" style="color: #f472b6; font-size: 0.875rem;">
                                            <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Class="mr-1" />
                                            <span>@(evt.TotalViews > 0 ? $"{evt.TotalViews} views" : "Join community event")</span>
                                        </div>
                                    </MudCardContent>
                                    <MudCardActions Style="padding: 16px 20px; margin-top: auto; border-top: 1px solid #2a2a3a;">
                                        <MudButton Color="Color.Primary" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" Style="color: #60a5fa; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px;">
                                            VIEW DETAILS
                                        </MudButton>
                                        <MudSpacer />
                                        <div class="d-flex align-center" style="color: #94a3b8; font-size: 0.875rem;">
                                            <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Class="mr-1" />
                                            <span>@(evt.ActorDisplayName ?? "Community")</span>
                                        </div>
                                    </MudCardActions>
                                </MudCard>
                            }
                        </MudStack>
                    </MudCarouselItem>
                }
                }
                else
                {
                    <MudCarouselItem Style="height: auto; padding: 20px 0;">
                        <MudStack AlignItems="AlignItems.Center" Spacing="3">
                            @if (_isLoading)
                            {
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                                <MudText>Loading events...</MudText>
                            }
                            else
                            {
                                <MudText>No events available at the moment</MudText>
                            }
                        </MudStack>
                    </MudCarouselItem>
                }
            </MudCarousel>
        </div>

        <MudStack AlignItems="AlignItems.Center" Class="mt-2">
            <MudText Typo="Typo.caption" Class="muted">Ready to join? Click any event to sign up and get full access.</MudText>
        </MudStack>
    </section>

    <!-- FAQ -->
    <section class="section faq">
        <MudText Typo="Typo.h5" Align="Align.Center">Frequently Asked Questions</MudText>
        <MudText Typo="Typo.subtitle2" Align="Align.Center" Class="muted mb-2">All you need to know before getting started</MudText>

        <MudExpansionPanels Elevation="0">
            <MudExpansionPanel Text="Is registration free?" Dense="true">
                <MudText Typo="Typo.body2">Yes, signing up is completely free. Some events might have a fee, but most are open to everyone.</MudText>
            </MudExpansionPanel>
            <MudExpansionPanel Text="How are events selected?" Dense="true">
                <MudText Typo="Typo.body2">We carefully verify organizers and feature only trustworthy, relevant, and community-oriented events.</MudText>
            </MudExpansionPanel>
            <MudExpansionPanel Text="Can I cancel my participation?" Dense="true">
                <MudText Typo="Typo.body2">Absolutely. You can cancel any event with one click from your dashboard.</MudText>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </section>

    <!-- CALL TO ACTION FINAL -->
    <section class="section" id="register">
        <MudPaper Elevation="0" Class="glass" Style="padding:28px; text-align:center;">
            <MudText Typo="Typo.h5">Ready to Join the Community?</MudText>
            <MudText Typo="Typo.body2" Class="muted mb-2">Create your account now and get full access to all upcoming events.</MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.Center">
                <MudButton Href="/login" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PersonAdd" Class="cta-primary">Sign Up</MudButton>
                <MudButton Href="/login" Color="Color.Default" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Visibility">Explore First</MudButton>
            </MudStack>
        </MudPaper>
    </section>
</MudContainer>

@code {
    private ICollection<EventListDto> _events = new List<EventListDto>();
    private int _membersCount = 1200;
    private int _eventsCount = 0;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            Console.WriteLine("[WELCOME PAGE] Loading landing page data from API");

            // Load events, members count, and events count in parallel
            var eventsTask = LandingPageService.GetFeaturedEventsAsync(12);
            var membersTask = LandingPageService.GetTotalMembersCountAsync();
            var eventsCountTask = LandingPageService.GetUpcomingEventsCountAsync();

            await Task.WhenAll(eventsTask, membersTask, eventsCountTask);

            _events = await eventsTask;
            _membersCount = await membersTask;
            _eventsCount = await eventsCountTask;

            Console.WriteLine($"[WELCOME PAGE] Loaded {_events.Count} events, {_membersCount} members, {_eventsCount} upcoming events");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading landing page data: {ex.Message}";
            Console.WriteLine($"[WELCOME PAGE] ERROR: {ex.Message}");
            // Keep default values on error
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string TruncateText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= maxLength)
            return text;

        return text.Substring(0, maxLength) + "...";
    }

    private IEnumerable<List<T>> Chunk<T>(IEnumerable<T> source, int size)
    {
        var bucket = new List<T>(size);
        foreach (var item in source)
        {
            bucket.Add(item);
            if (bucket.Count == size)
            {
                yield return bucket;
                bucket = new List<T>(size);
            }
        }
        if (bucket.Count > 0) yield return bucket;
    }

    private async Task ScrollToRegister()
        => await JS.InvokeVoidAsync("eval", "document.getElementById('register').scrollIntoView({behavior:'smooth',block:'start'});");
}
