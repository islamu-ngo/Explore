@using MudBlazor
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients

<div class="landing-guest">
    <!-- HERO - Full width -->
    <section class="landing-guest__hero">
        <MudContainer MaxWidth="MaxWidth.Large">
            <MudText Typo="Typo.overline" Class="landing-guest__kicker">Community • Events • Growth</MudText>
            <MudText Typo="Typo.h2" Align="Align.Center" Class="landing-guest__hero-title">Never Miss a Muslim Event Again</MudText>
            <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="landing-guest__hero-sub">
                Lectures, workshops, charity drives, and social gatherings. Discover, connect, and grow with a thriving Muslim community.
            </MudText>

            <!-- CTA + image -->
            <div class="landing-guest__register-strip">
                <div class="landing-guest__glass-panel">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.Center">
                        <MudButton Href="/login" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" StartIcon="@Icons.Material.Filled.PersonAdd">
                            Create Account
                        </MudButton>
                        <MudButton Href="/login" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Large" StartIcon="@Icons.Material.Filled.Login">
                            I already have one
                        </MudButton>
                    </MudStack>

                    <div class="landing-guest__stats">
                        <div class="landing-guest__stat"><b>@_membersCount+</b><span>Active members</span></div>
                        <div class="landing-guest__stat"><b>@_eventsCount</b><span>Upcoming events</span></div>
                        <div class="landing-guest__stat"><b>98%</b><span>Positive feedback</span></div>
                    </div>

                    <MudText Typo="Typo.caption" Class="landing-guest__legal-text mt-2">
                        Free to join. Cancel anytime. No credit card required.
                    </MudText>
                </div>

                <div class="landing-guest__hero-image-wrapper landing-guest__glass-panel">
                    <img src="image/landing_image_nonuser.png" alt="Community and events illustration" class="landing-guest__hero-image" fetchpriority="high" width="600" height="400" />
                </div>
            </div>
        </MudContainer>
    </section>

    <MudContainer MaxWidth="MaxWidth.Large">

        <!-- BENEFITS -->
        <section class="landing-guest__section" id="benefits">
            <div class="landing-guest__section-header">
                <MudText Typo="Typo.h4" Align="Align.Center">Why Join?</MudText>
                <MudText Typo="Typo.subtitle2" Align="Align.Center" Class="landing-guest__section-subtitle">
                    Unlock access to exclusive Islamic content and stay informed about every opportunity to learn and give back.
                </MudText>
            </div>

            <div class="landing-guest__benefits-grid">
                <div class="landing-guest__benefit-card">
                    <MudStack Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.AutoStories" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">Knowledge & Faith</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Join Quran study circles, lectures, and themed workshops guided by trusted speakers.
                        </MudText>
                    </MudStack>
                </div>

                <div class="landing-guest__benefit-card">
                    <MudStack Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Handshake" Size="Size.Large" Color="Color.Secondary" />
                        <MudText Typo="Typo.h6">Meet & Connect</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Make meaningful connections, collaborate on projects, and expand your network locally.
                        </MudText>
                    </MudStack>
                </div>

                <div class="landing-guest__benefit-card">
                    <MudStack Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.VolunteerActivism" Size="Size.Large" Color="Color.Success" />
                        <MudText Typo="Typo.h6">Act & Give Back</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Take part in charity drives, social causes, and community-building initiatives.
                        </MudText>
                    </MudStack>
                </div>
            </div>
        </section>

        <!-- UPCOMING EVENTS -->
        <section class="landing-guest__section">
            <MudStack Spacing="1" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.overline" Class="landing-guest__kicker">Upcoming</MudText>
                <MudText Typo="Typo.h4" Align="Align.Center">Don't Miss These Events</MudText>
                <MudText Typo="Typo.subtitle2" Align="Align.Center" Class="landing-guest__section-subtitle">
                    Click any event to register and unlock full details.
                </MudText>
            </MudStack>

            <div class="landing-guest__carousel-wrap">
                <MudCarousel TData="object" AutoCycle="true" CycleInterval="7000" ShowArrows="true" FullHeight="false" Style="height: auto; min-height: 450px;">
                    @if (_events.Any())
                    {
                        @foreach (var chunk in Chunk(_events, 3))
                        {
                            <MudCarouselItem Style="height: auto; padding: 20px 0;">
                                <MudStack Row="true" Gap="4" Justify="Justify.Center" AlignItems="AlignItems.Stretch" Style="flex-wrap:wrap; height: 100%;">
                                    @foreach (var evt in chunk)
                                    {
                                        <div class="landing-guest__event-card" @onclick="@(() => ScrollToRegister())">
                                            <div class="landing-guest__card-media">
                                                <div class="landing-guest__media-title">@evt.Title</div>
                                            </div>
                                            <div class="landing-guest__card-content">
                                                <div class="landing-guest__chips">
                                                    <MudChip T="string" Variant="Variant.Filled" Size="Size.Small" Class="landing-guest__chip--type">
                                                        @(evt.EventTypeFullName ?? "Event")
                                                    </MudChip>
                                                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Class="landing-guest__chip--format">
                                                        @(evt.EventFormatFullName ?? "Online")
                                                    </MudChip>
                                                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Class="landing-guest__chip--price">
                                                        @(evt.Price.HasValue && evt.Price > 0 ? $"{evt.CurrencyCode ?? "€"}{evt.Price:F2}" : "Free")
                                                    </MudChip>
                                                </div>
                                                <MudText Typo="Typo.h6" Class="landing-guest__card-title">@evt.Title</MudText>
                                                <MudText Typo="Typo.body2" Class="landing-guest__card-desc">@(TruncateText(evt.Description, 150))</MudText>

                                                <div class="landing-guest__card-views">
                                                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" />
                                                    <span>@(evt.TotalViews > 0 ? $"{evt.TotalViews} views" : "Join community event")</span>
                                                </div>
                                            </div>
                                            <div class="landing-guest__card-actions">
                                                <MudButton Color="Color.Primary" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" Class="landing-guest__action-btn">
                                                    VIEW DETAILS
                                                </MudButton>
                                                <div class="landing-guest__organizer">
                                                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                                                    <span>@(evt.ActorDisplayName ?? "Community")</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </MudStack>
                            </MudCarouselItem>
                        }
                    }
                    else
                    {
                        <MudCarouselItem Style="height: auto; padding: 20px 0;">
                            <MudStack AlignItems="AlignItems.Center" Spacing="3">
                                @if (_isLoading)
                                {
                                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                                    <MudText>Loading events...</MudText>
                                }
                                else
                                {
                                    <MudText>No events available at the moment</MudText>
                                }
                            </MudStack>
                        </MudCarouselItem>
                    }
                </MudCarousel>
            </div>

            <MudStack AlignItems="AlignItems.Center" Class="mt-2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Ready to join? Click any event to sign up and get full access.</MudText>
            </MudStack>
        </section>

        <!-- FAQ -->
        <section class="landing-guest__section landing-guest__faq">
            <MudText Typo="Typo.h5" Align="Align.Center">Frequently Asked Questions</MudText>
            <MudText Typo="Typo.subtitle2" Align="Align.Center" Class="landing-guest__section-subtitle mb-2">All you need to know before getting started</MudText>

            <MudExpansionPanels Elevation="0">
                <MudExpansionPanel Text="Is registration free?" Dense="true">
                    <MudText Typo="Typo.body2">Yes, signing up is completely free. Some events might have a fee, but most are open to everyone.</MudText>
                </MudExpansionPanel>
                <MudExpansionPanel Text="How are events selected?" Dense="true">
                    <MudText Typo="Typo.body2">We carefully verify organizers and feature only trustworthy, relevant, and community-oriented events.</MudText>
                </MudExpansionPanel>
                <MudExpansionPanel Text="Can I cancel my participation?" Dense="true">
                    <MudText Typo="Typo.body2">Absolutely. You can cancel any event with one click from your dashboard.</MudText>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </section>

        <!-- CALL TO ACTION FINAL -->
        <section class="landing-guest__section landing-guest__cta-final" id="register">
            <div class="landing-guest__cta-box">
                <MudText Typo="Typo.h5">Ready to Join the Community?</MudText>
                <MudText Typo="Typo.body2" Class="landing-guest__section-subtitle mb-2">Create your account now and get full access to all upcoming events.</MudText>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.Center">
                    <MudButton Href="/login" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PersonAdd" Size="Size.Large">Sign Up</MudButton>
                    <MudButton Href="/login" Color="Color.Default" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Visibility" Size="Size.Large">Explore First</MudButton>
                </MudStack>
            </div>
        </section>
    </MudContainer>
</div>
