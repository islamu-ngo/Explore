@using MudBlazor
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients

<div class="py-8">
    <!-- HERO -->
    <MudContainer MaxWidth="MaxWidth.Large" Class="mb-12">
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-8 text-center">
            <MudText Typo="Typo.overline" Style="letter-spacing: 2px; color: var(--mud-palette-primary);">COMMUNITY • EVENTS • GROWTH</MudText>
            <MudText Typo="Typo.h2" Style="font-weight: 800; line-height: 1.2;">Never Miss a Muslim Event Again</MudText>
            <MudText Typo="Typo.h6" Color="Color.Secondary" Style="font-weight: 400; max-width: 800px;">
                Lectures, workshops, charity drives, and social gatherings. Discover, connect, and grow with a thriving Muslim community.
            </MudText>
        </MudStack>

        <!-- CTA Box -->
        <MudPaper Elevation="0" Class="rounded-xl overflow-hidden relative" Style="background: linear-gradient(135deg, var(--mud-palette-surface), var(--mud-palette-background-grey)); border: 1px solid var(--mud-palette-lines-default);">
            <MudGrid>
                <MudItem xs="12" md="6" Class="pa-8 d-flex flex-column justify-center align-start">
                    <MudStack Spacing="6" Style="width: 100%;">
                        <div class="d-flex gap-4 flex-wrap">
                            <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.PersonAdd" Class="rounded-pill px-8 py-3">Create Account</MudButton>
                            <MudButton Href="/login" Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Login" Class="rounded-pill px-8 py-3">Log In</MudButton>
                        </div>

                        <MudDivider />

                        <div class="d-flex justify-space-between gap-4">
                            <div>
                                <MudText Typo="Typo.h5" Style="font-weight: 700;">@_membersCount+</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Active Members</MudText>
                            </div>
                            <div>
                                <MudText Typo="Typo.h5" Style="font-weight: 700;">@_eventsCount</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Upcoming Events</MudText>
                            </div>
                            <div>
                                <MudText Typo="Typo.h5" Style="font-weight: 700;">98%</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Positive Feedback</MudText>
                            </div>
                        </div>

                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Free to join. Cancel anytime. No credit card required.</MudText>
                    </MudStack>
                </MudItem>
                <MudItem xs="12" md="6" Class="relative" Style="min-height: 400px;">
                    <!-- Placeholder for image/illustration -->
                    <div style="position: absolute; inset: 0; background: url('image/landing_image_nonuser.png') no-repeat center center / cover;"></div>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudContainer>

    <!-- BENEFITS -->
    <MudContainer MaxWidth="MaxWidth.Large" Class="mb-16">
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-12 text-center">
            <MudText Typo="Typo.h4" Style="font-weight: 700;">Why Join?</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Unlock access to exclusive Islamic content and opportunities.</MudText>
        </MudStack>

        <MudGrid Spacing="4">
            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="pa-8 rounded-xl border-solid border-1 mud-border-lines-default h-100 d-flex flex-column align-center text-center">
                    <MudAvatar Color="Color.Primary" Size="Size.Large" Variant="Variant.Outlined" Class="mb-6" Style="width: 80px; height: 80px;">
                        <MudIcon Icon="@Icons.Material.Filled.AutoStories" Size="Size.Large" />
                    </MudAvatar>
                    <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-2">Knowledge & Faith</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Join Quran study circles, lectures, and themed workshops guided by trusted speakers.</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="pa-8 rounded-xl border-solid border-1 mud-border-lines-default h-100 d-flex flex-column align-center text-center">
                    <MudAvatar Color="Color.Secondary" Size="Size.Large" Variant="Variant.Outlined" Class="mb-6" Style="width: 80px; height: 80px;">
                        <MudIcon Icon="@Icons.Material.Filled.Handshake" Size="Size.Large" />
                    </MudAvatar>
                    <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-2">Meet & Connect</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Make meaningful connections, collaborate on projects, and expand your network locally.</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Elevation="0" Class="pa-8 rounded-xl border-solid border-1 mud-border-lines-default h-100 d-flex flex-column align-center text-center">
                    <MudAvatar Color="Color.Success" Size="Size.Large" Variant="Variant.Outlined" Class="mb-6" Style="width: 80px; height: 80px;">
                        <MudIcon Icon="@Icons.Material.Filled.VolunteerActivism" Size="Size.Large" />
                    </MudAvatar>
                    <MudText Typo="Typo.h6" Style="font-weight: 700;" Class="mb-2">Act & Give Back</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Take part in charity drives, social causes, and community-building initiatives.</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>

    <!-- UPCOMING -->
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mb-16">
        <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-8 text-center">
            <MudText Typo="Typo.overline" Color="Color.Primary">UPCOMING</MudText>
            <MudText Typo="Typo.h4" Style="font-weight: 700;">Don't Miss These Events</MudText>
        </MudStack>

        @if (_isLoading)
        {
            <div class="d-flex justify-center py-12">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (_events.Any())
        {
            <MudCarousel TData="object" AutoCycle="true" CycleInterval="7000" ShowArrows="true" ShowBullets="true" Style="height: 460px;">
                @foreach (var chunk in Chunk(_events, 3))
                {
                    <MudCarouselItem Transition="Transition.Slide" Color="Color.Transparent">
                        <div class="d-flex justify-center gap-6 px-12 h-100 align-center">
                            @foreach (var evt in chunk)
                            {
                                <MudCard @key="evt.Id" Elevation="0" Class="border-solid border-1 mud-border-lines-default rounded-xl overflow-hidden d-flex flex-column h-100 cursor-pointer hover:mud-elevation-4 transition-all" Style="flex: 1; max-width: 400px;" @onclick="@(() => ScrollToRegister())">
                                    <div style="height: 200px; background-color: var(--mud-palette-background-grey); position: relative;">
                                        @if (!string.IsNullOrEmpty(evt.FeaturedImageUri))
                                        {
                                            <MudImage Src="@evt.FeaturedImageUri" ObjectFit="ObjectFit.Cover" Style="width: 100%; height: 100%;" />
                                        }
                                        else
                                        {
                                            <div class="d-flex justify-center align-center h-100">
                                                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Color="Color.Secondary" />
                                            </div>
                                        }
                                        <div class="absolute pa-3 d-flex gap-2" style="top: 0; left: 0;">
                                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">@(evt.EventTypeFullName ?? "Event")</MudChip>
                                        </div>
                                    </div>
                                    <MudCardContent Class="flex-grow-1 d-flex flex-column pa-4">
                                        <MudText Typo="Typo.h6" Class="mb-2" Style="font-weight: 700; line-height: 1.3;">@evt.Title</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4 flex-grow-1">@TruncateText(evt.Description, 100)</MudText>
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" Class="align-self-start px-0">View Details</MudButton>
                                    </MudCardContent>
                                </MudCard>
                            }
                        </div>
                    </MudCarouselItem>
                }
            </MudCarousel>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="justify-center">No upcoming events found.</MudAlert>
        }
    </MudContainer>

    <!-- FAQ -->
    <MudContainer MaxWidth="MaxWidth.Medium" Class="mb-16">
        <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: 700;" Class="mb-8">Frequently Asked Questions</MudText>
        <MudExpansionPanels Elevation="0" Class="rounded-xl border-solid border-1 mud-border-lines-default overflow-hidden">
            <MudExpansionPanel Text="Is registration free?">
                <MudText Typo="Typo.body2">Yes, signing up is completely free. Some events might have a fee, but most are open to everyone.</MudText>
            </MudExpansionPanel>
            <MudExpansionPanel Text="How are events selected?">
                <MudText Typo="Typo.body2">We carefully verify organizers and feature only trustworthy, relevant, and community-oriented events.</MudText>
            </MudExpansionPanel>
            <MudExpansionPanel Text="Can I cancel my participation?">
                <MudText Typo="Typo.body2">Absolutely. You can cancel any event with one click from your dashboard.</MudText>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudContainer>

    <!-- FINAL CTA -->
    <MudContainer MaxWidth="MaxWidth.Large" Class="mb-12" id="register">
        <MudPaper Elevation="0" Class="rounded-xl pa-12 text-center" Style="background: var(--mud-palette-primary-darken); color: white;">
            <MudText Typo="Typo.h4" Style="font-weight: 800;" Class="mb-4">Ready to Join?</MudText>
            <MudText Typo="Typo.h6" Style="opacity: 0.9; font-weight: 400;" Class="mb-8">Create your account now and get full access to all upcoming events.</MudText>
            <div class="d-flex justify-center gap-4">
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Surface" Size="Size.Large" Style="color: var(--mud-palette-primary-darken); font-weight: 700;" Class="rounded-pill px-8">Sign Up Now</MudButton>
            </div>
        </MudPaper>
    </MudContainer>
</div>
