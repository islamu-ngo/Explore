@using MudBlazor
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients

<div class="py-8">
    <!-- HERO -->
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mb-12">
        <MudPaper Elevation="0" Class="rounded-xl overflow-hidden relative pa-8 pa-md-16" Style="background: linear-gradient(135deg, var(--mud-palette-primary-darken), var(--mud-palette-primary) 120%); color: white;">
            <MudGrid AlignItems="AlignItems.Center" Spacing="6">
                <MudItem xs="12" md="7">
                    <MudText Typo="Typo.overline" Style="letter-spacing: 2px; opacity: 0.9;">COMMUNITY • EVENTS • KNOWLEDGE</MudText>
                    <MudText Typo="Typo.h2" Style="font-weight: 800; line-height: 1.2;" Class="mb-4 mt-2">Never miss<br />knowledge again</MudText>
                    <MudText Typo="Typo.h6" Style="opacity: 0.9; font-weight: 400;" Class="mb-8">"Seeking knowledge is an obligation upon every Muslim."</MudText>

                    <div class="d-flex gap-4 flex-wrap">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Surface" 
                                   Style="color: var(--mud-palette-primary-darken); font-weight: 700;"
                                   Size="Size.Large" 
                                   Href="/events" 
                                   Class="rounded-pill px-8 py-3">
                            Discover Events
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" 
                                   Color="Color.Surface" 
                                   Size="Size.Large" 
                                   Href="#explore"
                                   Class="rounded-pill px-8 py-3">
                            Explore Categories
                        </MudButton>
                    </div>
                </MudItem>
                <MudItem xs="12" md="5" Class="d-flex justify-center">
                    <MudImage Src="image/Icon_landingpage.png" Alt="Illustration" Style="max-width: 100%; height: auto; max-height: 300px;" />
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudContainer>

    <MudContainer MaxWidth="MaxWidth.ExtraLarge">
        <!-- EXPLORE -->
        <div id="explore" class="mb-16">
            <MudText Typo="Typo.h4" Align="Align.Center" Style="font-weight: 700;" Class="mb-2">Explore</MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="mb-8">Find what fits you best – near you, online, or on-demand.</MudText>

            <MudGrid Spacing="4">
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default cursor-pointer hover:mud-elevation-4 transition-all d-flex flex-column align-center text-center h-100" @onclick='() => Nav.NavigateTo("/events?mode=local")'>
                        <MudAvatar Size="Size.Large" Color="Color.Primary" Variant="Variant.Outlined" Class="mb-4" Style="width: 64px; height: 64px;">
                            <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Large" />
                        </MudAvatar>
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Local</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Find events near you</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default cursor-pointer hover:mud-elevation-4 transition-all d-flex flex-column align-center text-center h-100" @onclick='() => Nav.NavigateTo("/events?mode=digital")'>
                        <MudAvatar Size="Size.Large" Color="Color.Secondary" Variant="Variant.Outlined" Class="mb-4" Style="width: 64px; height: 64px;">
                            <MudIcon Icon="@Icons.Material.Filled.DesktopWindows" Size="Size.Large" />
                        </MudAvatar>
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Digital</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Join online sessions</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Class="pa-6 rounded-xl border-solid border-1 mud-border-lines-default cursor-pointer hover:mud-elevation-4 transition-all d-flex flex-column align-center text-center h-100" @onclick='() => Nav.NavigateTo("/archive")'>
                        <MudAvatar Size="Size.Large" Color="Color.Info" Variant="Variant.Outlined" Class="mb-4" Style="width: 64px; height: 64px;">
                            <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Large" />
                        </MudAvatar>
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Archive</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Watch past recordings</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </div>

        <!-- FEATURED EVENTS -->
        <div class="mb-12">
            <div class="d-flex justify-space-between align-center mb-8">
                <div>
                    <MudText Typo="Typo.h4" Style="font-weight: 700;">Featured Events</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary">Discover upcoming events from our community</MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" Href="/events" Class="rounded-pill">View All</MudButton>
            </div>

            @if (_isLoading)
            {
                <div class="d-flex justify-center gap-6 px-12">
                    @for (int i = 0; i < 3; i++)
                    {
                        <MudCard Elevation="0" Class="border-solid border-1 mud-border-lines-default rounded-xl overflow-hidden d-flex flex-column" Style="flex: 1; max-width: 400px;">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
                            <MudCardContent Class="pa-4">
                                <MudSkeleton Width="80%" Height="24px" Class="mb-2" />
                                <MudSkeleton Width="100%" Height="16px" Class="mb-1" />
                                <MudSkeleton Width="90%" Height="16px" Class="mb-4" />
                                <MudSkeleton Width="120px" Height="20px" />
                            </MudCardContent>
                        </MudCard>
                    }
                </div>
            }
            else if (_events.Any())
            {
                <MudCarousel TData="object" AutoCycle="true" CycleInterval="6000" ShowArrows="true" ShowBullets="true" Style="height: 460px;">
                    @foreach (var chunk in Chunk(_events, 3))
                    {
                        <MudCarouselItem Transition="Transition.Slide" Color="Color.Transparent">
                            <div class="d-flex justify-center gap-6 px-12 h-100 align-center">
                                @foreach (var evt in chunk)
                                {
                                    <MudCard @key="evt.Id" Elevation="0" Class="border-solid border-1 mud-border-lines-default rounded-xl overflow-hidden d-flex flex-column h-100" Style="flex: 1; max-width: 400px; transition: transform 0.2s;" onclick="@(() => Nav.NavigateTo($"/events/{evt.Id}"))">
                                        <div style="height: 200px; background-color: var(--mud-palette-background-grey); position: relative;">
                                            @if (!string.IsNullOrEmpty(evt.FeaturedImageUri))
                                            {
                                                <MudImage Src="@evt.FeaturedImageUri" ObjectFit="ObjectFit.Cover" Style="width: 100%; height: 100%;" />
                                            }
                                            else
                                            {
                                                <div class="d-flex justify-center align-center h-100">
                                                    <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Color="Color.Secondary" />
                                                </div>
                                            }
                                            <div class="absolute pa-3 d-flex gap-2" style="top: 0; left: 0;">
                                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">@(evt.EventTypeFullName ?? "Event")</MudChip>
                                                <MudChip T="string" Color="Color.Surface" Size="Size.Small" Variant="Variant.Filled">@(evt.EventFormatFullName ?? "Online")</MudChip>
                                            </div>
                                        </div>
                                        <MudCardContent Class="flex-grow-1 d-flex flex-column pa-4">
                                            <MudText Typo="Typo.h6" Class="mb-2" Style="font-weight: 700; line-height: 1.3;">@evt.Title</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4 flex-grow-1" Style="overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;">
                                                @TruncateText(evt.Description, 150)
                                            </MudText>
                                            <MudDivider Class="my-3" />
                                            <div class="d-flex justify-space-between align-center">
                                                <div class="d-flex align-center gap-2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" Color="Color.Secondary" />
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(evt.ActorDisplayName ?? "Community")</MudText>
                                                </div>
                                                <div class="d-flex align-center gap-1">
                                                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Secondary" />
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@evt.TotalViews</MudText>
                                                </div>
                                            </div>
                                        </MudCardContent>
                                    </MudCard>
                                }
                            </div>
                        </MudCarouselItem>
                    }
                </MudCarousel>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="justify-center">No featured events available at the moment.</MudAlert>
            }
        </div>
    </MudContainer>
</div>

@inject NavigationManager Nav
