@using MudBlazor
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients

<div class="landing-users">
    <!-- HERO - Full width -->
    <section class="landing-users__hero">
        <MudContainer MaxWidth="MaxWidth.Large">
            <MudGrid Spacing="3" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudItem xs="12" md="7">
                    <MudText Typo="Typo.overline" Class="landing-users__kicker">Community • Events • Knowledge</MudText>
                    <MudText Typo="Typo.h3" Class="landing-users__hero-title">Never miss<br />knowledge again</MudText>
                    <MudText Typo="Typo.subtitle1" Class="landing-users__hero-sub">
                        "Seeking knowledge is an obligation upon every Muslim."
                    </MudText>

                    <div class="landing-users__cta-row">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Event" Href="/events" Class="cta-primary" Size="Size.Large">
                            Discover community events
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Explore" Href="#explore" Size="Size.Large">
                            Explore categories
                        </MudButton>
                    </div>
                </MudItem>

                <MudItem xs="12" md="5">
                    <div class="landing-users__hero-image-box">
                        <img src="image/Icon_landingpage.png" alt="Landing page illustration" class="landing-users__hero-image" fetchpriority="high" width="170" height="170" />
                    </div>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </section>

    <MudContainer MaxWidth="MaxWidth.Large" Class="content">

        <!-- EXPLORE -->
        <section class="landing-users__section" id="explore">
            <MudText Typo="Typo.h5" Class="landing-users__section-title">Explore</MudText>
            <MudText Typo="Typo.subtitle2" Class="landing-users__section-subtitle">Find what fits you best – near you, online, or on-demand.</MudText>

            <MudGrid Spacing="3">
                <MudItem xs="12" sm="4">
                    <MudLink Href="/events?mode=local" Class="landing-users__tile-link" aria-label="Browse local events">
                        <div class="landing-users__tile" role="button" tabindex="0">
                            <div class="landing-users__tile-content">
                                <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Large" Class="landing-users__tile-icon" />
                                <MudText Typo="Typo.h6">Local</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Find near you</MudText>
                            </div>
                        </div>
                    </MudLink>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudLink Href="/events?mode=digital" Class="landing-users__tile-link" aria-label="Browse digital events">
                        <div class="landing-users__tile" role="button" tabindex="0">
                            <div class="landing-users__tile-content">
                                <MudIcon Icon="@Icons.Material.Filled.DesktopWindows" Size="Size.Large" Class="landing-users__tile-icon" />
                                <MudText Typo="Typo.h6">Digital</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Find online</MudText>
                            </div>
                        </div>
                    </MudLink>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudLink Href="/archive" Class="landing-users__tile-link" aria-label="Browse archive">
                        <div class="landing-users__tile" role="button" tabindex="0">
                            <div class="landing-users__tile-content">
                                <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Large" Class="landing-users__tile-icon" />
                                <MudText Typo="Typo.h6">Archive</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Watch recordings</MudText>
                            </div>
                        </div>
                    </MudLink>
                </MudItem>
            </MudGrid>
        </section>

        <!-- THIS WEEK - Carousel -->
        <section class="landing-users__section">
            <div class="landing-users__header">
                <div>
                    <MudText Typo="Typo.h5" Class="landing-users__section-title">Featured Events</MudText>
                    <MudText Typo="Typo.subtitle2" Class="landing-users__section-subtitle">Discover upcoming events from our community.</MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/events" StartIcon="@Icons.Material.Filled.PlaylistAddCheck">
                    View All Events
                </MudButton>
            </div>

            <div class="landing-users__carousel-wrap">
                @if (_isLoading)
                {
                    <div class="landing-users__loading-state">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        <MudText Class="mt-2">Loading events...</MudText>
                    </div>
                }
                else if (_events.Any())
                {
                    <MudCarousel TData="object" AutoCycle="true" CycleInterval="6000" ShowArrows="true" FullHeight="false" Style="height: auto; min-height: 400px;">
                        @foreach (var chunk in Chunk(_events, 3))
                        {
                            <MudCarouselItem Style="height: auto; padding: 20px 0;">
                                <MudStack Row="true" Gap="4" Justify="Justify.Center" AlignItems="AlignItems.Stretch" Style="flex-wrap:wrap; height: 100%;">
                                    @foreach (var evt in chunk)
                                    {
                                        <div class="landing-users__event-card">
                                            <div class="landing-users__card-media">
                                                <div class="landing-users__media-title">@evt.Title</div>
                                            </div>
                                            <div class="landing-users__card-content">
                                                <div class="landing-users__chips">
                                                    <MudChip T="string" Variant="Variant.Filled" Size="Size.Small" Class="landing-users__chip--type">
                                                        @(evt.EventTypeFullName ?? "Event")
                                                    </MudChip>
                                                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Class="landing-users__chip--format">
                                                        @(evt.EventFormatFullName ?? "Online")
                                                    </MudChip>
                                                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Class="landing-users__chip--price">
                                                        @(evt.Price.HasValue && evt.Price > 0 ? $"{evt.CurrencyCode ?? "€"}{evt.Price:F2}" : "Free")
                                                    </MudChip>
                                                </div>
                                                <MudText Typo="Typo.h6" Class="landing-users__card-title">@evt.Title</MudText>
                                                <MudText Typo="Typo.body2" Class="landing-users__card-desc">@(TruncateText(evt.Description, 150))</MudText>

                                                <div class="landing-users__card-views">
                                                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" />
                                                    <span>@(evt.TotalViews > 0 ? $"{evt.TotalViews} views" : "Join community event")</span>
                                                </div>
                                            </div>
                                            <div class="landing-users__card-actions">
                                                <MudButton Color="Color.Primary" Variant="Variant.Text" Href="@($"/event/detail/{evt.Id}")" EndIcon="@Icons.Material.Filled.ArrowForward" Class="landing-users__action-btn">
                                                    VIEW DETAILS
                                                </MudButton>
                                                <div class="landing-users__organizer">
                                                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                                                    <span>@(evt.ActorDisplayName ?? "Community")</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </MudStack>
                            </MudCarouselItem>
                        }
                    </MudCarousel>
                }
                else
                {
                    <div class="landing-users__empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Large" Color="Color.Default" Style="opacity: 0.5;" />
                        <MudText>No events available at the moment</MudText>
                        <MudButton Href="/events" Variant="Variant.Outlined">
                            Browse All Events
                        </MudButton>
                    </div>
                }
            </div>
        </section>
    </MudContainer>
</div>
