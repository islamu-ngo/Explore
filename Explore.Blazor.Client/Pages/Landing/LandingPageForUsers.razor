@page "/home"
@using MudBlazor
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Models.DTOs
@attribute [StreamRendering]
@inject IJSRuntime JS
@inject ILandingPageService LandingPageService

<style>
:root{
    --hero-grad-1:#5b7cfa;
    --hero-grad-2:#7f56d9;
}

/* ---------- LAYOUT WIDTH ---------- */
.content { max-width: 1100px; margin: 0 auto; padding: 0 16px; }

/* ---------- HERO ---------- */
.hero {
    position: relative; isolation:isolate;
    padding: 86px 0 60px 0; text-align:center; color:var(--mud-palette-text-primary);
    background: radial-gradient(1200px 600px at 50% -10%, color-mix(in srgb, var(--mud-palette-primary) 20%, transparent), transparent 60%),
                linear-gradient(180deg, var(--mud-palette-background) 0%, var(--mud-palette-surface) 100%);
    overflow:hidden;
}
.hero::before{
    content:""; position:absolute; inset:-20% -20% auto -20%; height:120%;
    background: conic-gradient(from 180deg at 50% 50%, var(--hero-grad-1), var(--hero-grad-2), var(--hero-grad-1));
    filter: blur(120px) saturate(140%) opacity(.35);
    animation: swirl 14s linear infinite; z-index:-1;
    opacity: 0.5;
}
@@keyframes swirl { to { transform: rotate(360deg);} }
.kicker { letter-spacing:.18em; text-transform:uppercase; font-size:.82rem; opacity:.85; }
.hero h1 { letter-spacing:.2px; }
.hero-sub { opacity:.92; max-width: 820px; margin: 10px auto 0; }

/* Logo */
.logoBox{ display:flex; align-items:center; justify-content:center; background:transparent; }
.landing-image { width:100%; height:auto; max-width: 170px; object-fit:contain; filter: drop-shadow(0 6px 22px rgba(0,0,0,.35)); }

/* CTA cluster */
.cta-row{ display:flex; gap:12px; justify-content:center; flex-wrap:wrap; margin-top:18px; }
.cta-primary .mud-button-label{ font-size:1.02rem; font-weight:600; }

/* ---------- GLASS UTIL ---------- */
.glass{
    background: color-mix(in srgb, var(--mud-palette-surface) 70%, transparent);
    border: 1px solid var(--mud-palette-lines-default);
    border-radius: 18px; backdrop-filter: blur(10px);
    box-shadow: 0 10px 40px rgba(0,0,0,.15);
    color: var(--mud-palette-text-primary);
}

/* ---------- SECTION UTILS ---------- */
.section { margin: 56px 0; }
.section h2 { margin-bottom: 6px; }
.muted { color: var(--mud-palette-text-secondary); }
.text-right { text-align:right; }
.mt-6 { margin-top: 1.5rem; }

/* ---------- EXPLORE TILES ---------- */
.tile {
    position: relative; height: 180px; padding: 14px 16px;
    border-radius: 16px; border: 1px solid var(--mud-palette-lines-default);
    background: var(--mud-palette-surface); box-shadow: 0 1px 0 rgba(0,0,0,.1) inset;
    overflow:hidden; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    color: var(--mud-palette-text-primary);
}
.tile:hover { transform: translateY(-3px); box-shadow: 0 12px 26px rgba(0,0,0,.15); border-color: var(--mud-palette-primary); }
.tile-content {
    position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
    display:flex; flex-direction:column; align-items:center; text-align:center; gap:6px; max-width: calc(100% - 32px);
}
.tile .mud-icon-root { font-size: 42px !important; line-height:1; margin:0 0 6px 0; opacity:.9; }
.tile .mud-typography-h6 { font-weight: 600; line-height:1.25; }
.tile .mud-typography-caption { margin-top:2px; line-height:1.35; opacity:.78; }

/* Clickable tile link */
.tile-link{ display:block; text-decoration:none; color:inherit; }

/* ---------- EVENT CARDS ---------- */
.card {
    background-color: var(--mud-palette-surface);
    border-radius: 16px;
    overflow:hidden;
    border: 1px solid color-mix(in srgb, var(--mud-palette-lines-default) 70%, transparent);
    transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
    height: 100%; display: flex; flex-direction: column; cursor: pointer;
}
.card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(0,0,0,.16);
    border-color: color-mix(in srgb, var(--mud-palette-primary) 40%, var(--mud-palette-lines-default));
}
.card-media {
    position: relative; 
    height: 200px; 
    overflow: hidden;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.2rem;
    font-weight: 600;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
}
.card-media::after {
    content:""; 
    position:absolute; 
    inset:0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(0,0,0,.25) 100%);
}
.event-body { padding: 20px; flex: 1; display: flex; flex-direction: column; color: #e2e8f0; }
.event-chips { display: flex; gap: 6px; margin-bottom: 16px; flex-wrap: wrap; }

/* Badges row */
.badges{ 
    display:flex; 
    gap:8px; 
    align-items:center; 
    margin: 10px 0 6px 0; 
}

/* Location row */
.loc{
    display:flex; 
    align-items:center; 
    gap:6px; 
    opacity:.85;
}
    background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: #fff; font-weight: 600;
    font-size: 1.1rem; text-align: center; padding: 20px;
}
.event-body { padding: 20px; flex: 1; display: flex; flex-direction: column; color: #e2e8f0; }
.event-chips { display: flex; gap: 6px; margin-bottom: 16px; flex-wrap: wrap; }

/* ---------- CAROUSEL ---------- */
.carousel-wrap{
    margin: 36px 0 8px 0;
}

/* Force carousel to show full height */
.carousel-wrap .mud-carousel,
.carousel-wrap .mud-carousel-item,
.carousel-wrap .mud-carousel-content {
    height: auto !important;
    min-height: 400px;
}

/* ---------- THIS WEEK CARDS ---------- */
.eventCard { 
    border-radius: 14px; overflow:hidden; transition: transform .18s ease, box-shadow .18s ease; 
    height: 100%; display: flex; flex-direction: column;
}
.eventCard:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(0,0,0,.3); }
.eventThumb {
    height: 180px; display:flex; align-items:center; justify-content:center;
    background: linear-gradient(135deg, #6b5cff, #a855f7); color:#fff; letter-spacing:.3px; font-weight:600;
}
.eventMeta{ display:flex; justify-content:center; gap:8px; margin-top:8px; }

/* Responsive tweaks */
@@media (max-width: 900px){
    .text-right{ text-align:left; }
}
@@media (prefers-reduced-motion: reduce){
    .hero::before{ animation:none; }
}
</style>

<!-- HERO - Full width -->
<section class="hero">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudGrid Spacing="3" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudItem xs="12" md="7">
                <MudText Typo="Typo.overline" Class="kicker">Community • Events • Knowledge</MudText>
                <MudText Typo="Typo.h3" Class="mb-1">Never miss<br />knowledge again</MudText>
                <MudText Typo="Typo.subtitle1" Class="hero-sub">
                    “Seeking knowledge is an obligation upon every Muslim.”
                </MudText>

                <div class="cta-row">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Event" Href="/events" Class="cta-primary">
                        Discover community events
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Explore" Href="#explore">
                        Explore categories
                    </MudButton>
                </div>
            </MudItem>

            <MudItem xs="12" md="5">
                <MudPaper Elevation="0" Class="logoBox glass" Style="padding:18px;">
                    <img src="image/Icon_landingpage.png" alt="Landing page illustration" class="landing-image" fetchpriority="high" width="170" height="170" />
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
</section>

<MudContainer MaxWidth="MaxWidth.Large" Class="content">

    <!-- EXPLORE -->
    <section class="section" id="explore">
        <MudText Typo="Typo.h5" Class="mb-2">Explore</MudText>
        <MudText Typo="Typo.subtitle2" Class="muted mb-3">Find what fits you best — near you, online, or on-demand.</MudText>

        <MudGrid Spacing="3">
            <MudItem xs="12" sm="4">
                <MudLink Href="/events?mode=local" Class="tile-link" aria-label="Browse local events">
                    <MudPaper Class="tile" Elevation="1" role="button" tabindex="0">
                        <div class="tile-content">
                            <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Large" />
                            <MudText Typo="Typo.h6">Local</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Find near you</MudText>
                        </div>
                    </MudPaper>
                </MudLink>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudLink Href="/events?mode=digital" Class="tile-link" aria-label="Browse digital events">
                    <MudPaper Class="tile" Elevation="1" role="button" tabindex="0">
                        <div class="tile-content">
                            <MudIcon Icon="@Icons.Material.Filled.DesktopWindows" Size="Size.Large" />
                            <MudText Typo="Typo.h6">Digital</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Find online</MudText>
                        </div>
                    </MudPaper>
                </MudLink>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudLink Href="/archive" Class="tile-link" aria-label="Browse archive">
                    <MudPaper Class="tile" Elevation="1" role="button" tabindex="0">
                        <div class="tile-content">
                            <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Large" />
                            <MudText Typo="Typo.h6">Archive</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Watch recordings</MudText>
                        </div>
                    </MudPaper>
                </MudLink>
            </MudItem>
        </MudGrid>
    </section>

    <!-- THIS WEEK - Carousel -->
    <section class="section">
        <MudGrid AlignItems="AlignItems.Center">
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.h5">Featured Events</MudText>
                <MudText Typo="Typo.subtitle2" Class="muted">Discover upcoming programs and events from our community.</MudText>
            </MudItem>
            <MudItem xs="12" md="4" Class="text-right">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/events" StartIcon="@Icons.Material.Filled.PlaylistAddCheck">
                    View All Events
                </MudButton>
            </MudItem>
        </MudGrid>

        <div class="carousel-wrap">
            @if (_isLoading)
            {
                <MudPaper Class="pa-6" Style="text-align: center;">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    <MudText Class="mt-2">Loading events...</MudText>
                </MudPaper>
            }
            else if (_events.Any())
            {
                <MudCarousel TData="object" AutoCycle="true" CycleInterval="6000" ShowArrows="true" FullHeight="false" Style="height: auto; min-height: 400px;">
                    @foreach (var chunk in Chunk(_events, 3))
                    {
                        <MudCarouselItem Style="height: auto; padding: 20px 0;">
                            <MudStack Row="true" Gap="16px" Justify="Justify.Center" AlignItems="AlignItems.Stretch" Style="flex-wrap:wrap; height: 100%;">
                                @foreach (var evt in chunk)
                                {
                                    <MudCard Elevation="0" Class="card" Style="width: 340px; max-width: 92vw;">
                                        <MudCardMedia Class="card-media">
                                            <div style="position: relative; z-index: 2;">@evt.Title</div>
                                        </MudCardMedia>
                                        <MudCardContent Class="event-body">
                                            <div class="event-chips">
                                                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Small" Style="background: #8b5cf6; color: white;">
                                                    Event
                                                </MudChip>
                                                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" Style="border-color: #3b82f6; color: #60a5fa;">
                                                    @(evt.Country ?? "Online")
                                                </MudChip>
                                                <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small" Style="border-color: #10b981; color: #34d399;">
                                                    @(evt.Price > 0 ? $"€{evt.Price:F2}" : "Free")
                                                </MudChip>
                                            </div>
                                            <MudText Typo="Typo.h6" Class="mb-2" Style="color: #f8fafc; font-weight: 600;">@evt.Title</MudText>
                                            <MudText Typo="Typo.body2" Class="mb-3" Style="color: #cbd5e1; line-height: 1.5; flex: 1;">@(TruncateText(evt.Description, 150))</MudText>
                                            
                                            <div class="d-flex align-center mb-2" style="color: #f472b6; font-size: 0.875rem;">
                                                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="mr-1" />
                                                <span>@(evt.AudienceAttendees.HasValue && evt.AudienceAttendees > 0 ? $"{evt.AudienceAttendees} attendees" : "Join community event")</span>
                                            </div>
                                        </MudCardContent>
                                        <MudCardActions Style="padding: 16px 20px; margin-top: auto; border-top: 1px solid #2a2a3a;">
                                            <MudButton Color="Color.Primary" Variant="Variant.Text" Href="@($"/event/detail/{evt.Id}")" EndIcon="@Icons.Material.Filled.ArrowForward" Style="color: #60a5fa; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px;">
                                                VIEW DETAILS
                                            </MudButton>
                                            <MudSpacer />
                                            <div class="d-flex align-center" style="color: #94a3b8; font-size: 0.875rem;">
                                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="mr-1" />
                                                <span>@(evt.Country ?? "Online")</span>
                                            </div>
                                        </MudCardActions>
                                    </MudCard>
                                }
                            </MudStack>
                                </MudCarouselItem>
                    }
                </MudCarousel>
            }
            else
            {
                <MudPaper Class="pa-6" Style="text-align: center;">
                    <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Large" Color="Color.Default" Style="opacity: 0.5;" />
                    <MudText Class="mt-2">No events available at the moment</MudText>
                    <MudButton Href="/events" Variant="Variant.Outlined" Class="mt-2">
                        Browse All Events
                    </MudButton>
                </MudPaper>
            }
        </div>
    </section>
</MudContainer>

@code {
    private List<ProgramListDto> _events = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _events = await LandingPageService.GetFeaturedEventsAsync(9); // Load 9 events for 3x3 grid
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading landing page events: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<List<T>> Chunk<T>(IEnumerable<T> source, int size)
    {
        var bucket = new List<T>(size);
        foreach (var item in source)
        {
            bucket.Add(item);
            if (bucket.Count == size)
            {
                yield return bucket;
                bucket = new List<T>(size);
            }
        }
        if (bucket.Count > 0) yield return bucket;
    }

    private string TruncateText(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= maxLength)
            return text ?? "";
        
        return text.Substring(0, maxLength) + "...";
    }
}
