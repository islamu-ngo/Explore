@using MudBlazor
@inject NavigationManager NavigationManager

<PageTitle>Organization Created Successfully</PageTitle>

<MudContainer Class="organization-success">
    <AppCard Class="mx-auto" Style="max-width: 600px;">
        <MudCardContent Class="text-center pa-6">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                         Size="Size.Large"
                         Color="Color.Success"
                         Style="font-size: 4rem;" />

                <MudText Typo="Typo.h4" HtmlTag="h1" Color="Color.Success">
                    Organization Successfully Submitted!
                </MudText>

                <MudText Typo="Typo.body1" Class="text-center">
                    Your organization has been successfully submitted for review by our admin team.
                    You will receive an email within 3-5 business days with the status of your request.
                </MudText>

                <MudAlert Severity="Severity.Info" Class="ma-4">
                    <MudText Typo="Typo.body2">
                        <strong>Next steps:</strong><br/>
                        • Check your email for confirmation<br/>
                        • Wait for approval from the admin team<br/>
                        • After approval, you can start creating events<br/>
                        • You will gain access to the organization dashboard
                    </MudText>
                </MudAlert>

                <MudStack Row Spacing="2" Class="mt-4">
                    <AppButton StartIcon="@Icons.Material.Filled.Home"
                               OnClick="@(() => NavigationManager.NavigateTo("/"))">
                        Return to Home
                    </AppButton>

                    <AppButton Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.Event"
                               OnClick="@(() => NavigationManager.NavigateTo("/events"))">
                        Browse Events
                    </AppButton>
                </MudStack>
            </MudStack>
        </MudCardContent>
    </AppCard>
</MudContainer>
