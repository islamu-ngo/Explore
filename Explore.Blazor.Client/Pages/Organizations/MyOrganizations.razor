@page "/my/organizations"
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web.Virtualization
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>My Organizations</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4 py-sm-8 py-md-12">
    <!-- Header -->
    <div class="d-flex flex-wrap align-end justify-space-between gap-4 mb-8">
        <div>
            <MudText Typo="Typo.overline" Class="mud-text-secondary" Style="letter-spacing: 0.18em;">MANAGEMENT</MudText>
            <MudText Typo="Typo.h4" HtmlTag="h1">My Organizations</MudText>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex flex-column align-center justify-center py-16">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-4">
                Loading your organizations...
            </MudText>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div role="alert">
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-4">
                @_errorMessage
                <MudButton Elevation="0" Variant="Variant.Text" Color="Color.Inherit" OnClick="RetryLoadAsync" Class="ml-4">
                    Retry
                </MudButton>
            </MudAlert>
        </div>
    }
    else if (_organizations == null || !_organizations.Any())
    {
        <div class="d-flex flex-column align-center justify-center py-16">
            <MudIcon Icon="@Icons.Material.Outlined.Business" Size="Size.Large" Color="Color.Default" Style="width: 80px; height: 80px; opacity: 0.2;" />
            <MudText Typo="Typo.h5" Class="mt-4">No organizations yet</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
                No organization creation affordance is currently available.
            </MudText>
        </div>
    }
    else
    {
        <!-- Search -->
        <MudGrid Class="mb-8">
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_searchString"
                              Placeholder="Search by name or email..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>

        @if (!FilteredOrganizations.Any())
        {
            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="mt-8">
                No organizations match your search.
            </MudText>
        }
        else
        {
            <MudGrid>
                <Virtualize Items="@FilteredOrganizations.ToList()" Context="org" OverscanCount="4">
                    <ItemContent>
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="0" Class="h-100 d-flex flex-column">
                                <div class="d-flex align-center justify-center py-8" style="background-color: @GetOrganizationColor(org.FullName); min-height: 120px;">
                                    <MudAvatar Size="Size.Large"
                                               Color="Color.Surface"
                                               Variant="Variant.Filled">
                                        <MudText Color="Color.Primary" Typo="Typo.h5">@GetInitials(org.FullName)</MudText>
                                    </MudAvatar>
                                </div>

                                <MudCardContent Class="flex-grow-1">
                                    <div class="mb-2">
                                        @if (org.CurrentUserRole.HasValue)
                                        {
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="@GetRoleColor(org.CurrentUserRole.Value)"
                                                     Variant="Variant.Outlined">
                                                @GetRoleName(org.CurrentUserRole.Value)
                                            </MudChip>
                                        }
                                    </div>

                                    <MudText Typo="Typo.h6" Class="mb-4">@org.FullName</MudText>

                                    <div class="mt-auto">
                                        <div class="d-flex align-center gap-1 mb-1">
                                            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Secondary" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                @org.City, @org.Country
                                            </MudText>
                                        </div>
                                        
                                        <div class="d-flex align-center gap-1">
                                            <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Color="Color.Secondary" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@org.Email</MudText>
                                        </div>
                                    </div>
                                </MudCardContent>

                                <MudCardActions>
                                    <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Text"
                                               Href="@($"/organization/{org.Id}")"
                                               EndIcon="@Icons.Material.Filled.ArrowForward">
                                        Details
                                    </MudButton>
                                    <MudSpacer />
                                    @if (CanCreateEvents(org))
                                    {
                                        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                                                   Href="@($"/organizations/{org.Id}/events/create")">
                                            Event
                                        </MudButton>
                                    }
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    </ItemContent>
                    <Placeholder>
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="0" Class="h-100 d-flex flex-column">
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" />
                                <MudCardContent>
                                    <MudSkeleton Width="30%" Class="mb-2" />
                                    <MudSkeleton Width="70%" Class="mb-4" />
                                    <MudSkeleton Width="50%" />
                                    <MudSkeleton Width="60%" />
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </Placeholder>
                </Virtualize>
            </MudGrid>

            <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mt-8 mb-8">
                @FilteredOrganizations.Count() organization(s)
            </MudText>
        }
    }
</MudContainer>
