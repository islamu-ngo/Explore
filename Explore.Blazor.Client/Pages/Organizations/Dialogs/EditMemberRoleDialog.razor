@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Helpers
@using Explore.Blazor.Client.Services
@using MudBlazor
@inject IOrganizationMemberService MemberService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText>Change role for @Member.UserEmail</MudText>
        <MudSelect T="int" Label="Role" @bind-Value="newRoleId" AnchorOrigin="Origin.BottomCenter">
            @foreach (var role in RoleHelper.GetAssignableOrgRoles())
            {
                <MudSelectItem Value="@role.Id">@role.Name</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <AppButton OnClick="Cancel">Cancel</AppButton>
        <AppButton OnClick="Submit">Save</AppButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudBlazor.IMudDialogInstance MudDialog { get; set; }
    [Parameter] public OrganizationMemberDto Member { get; set; }
    [Parameter] public Guid OrganizationId { get; set; }

    private int newRoleId;

    protected override void OnInitialized()
    {
        newRoleId = Member.RoleId ?? RoleHelper.OrgMember;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        try
        {
            var updateDto = new UpdateOrganizationMemberRoleDto
            {
                Id = Member.Id,
                Role = newRoleId
            };

            await MemberService.UpdateMemberRoleAsync(updateDto);
            Snackbar.Add("Role updated successfully", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating role: {ex.Message}", Severity.Error);
        }
    }
}
