@page "/my/profile"
@using MudBlazor
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>User Profile</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    @if (IsLoading)
    {
        <div class="d-flex flex-column align-center justify-center py-16">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.body1" Class="mt-4" Color="Color.Secondary">Loading profile...</MudText>
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-6">@ErrorMessage</MudAlert>
        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" OnClick="@LoadUserDataAsync">Retry</MudButton>
    }
    else if (UserData == null)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
            Unable to load user profile. Please try logging in again.
        </MudAlert>
        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Filled" Href="/login" Class="mt-4">Log In</MudButton>
    }
    else
    {
        <div class="org-profile">
            <!-- Hero Banner -->
            <div class="org-profile__banner" style="@_bannerStyle"></div>
            
            <MudContainer MaxWidth="MaxWidth.Large" Class="org-profile__container">
                <!-- Avatar and Header Info -->
                <div class="org-profile__header">
                    <div class="org-profile__avatar-wrapper">
                        <MudAvatar Style="width: 8rem; height: 8rem; font-size: 3rem; border: 0.25rem solid var(--mud-palette-surface);" Class="org-profile__avatar">
                            @if (!string.IsNullOrEmpty(UserData?.ProfileImageUri))
                            {
                                <MudImage Src="@UserData.ProfileImageUri" Alt="Profile picture" ObjectFit="ObjectFit.Cover" />
                            }
                            else
                            {
                                @GetInitials()
                            }
                        </MudAvatar>
                    </div>
                    <div class="org-profile__header-right">
                        <MudButton Elevation="0" Color="Color.Primary" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" Href="/settings" Class="org-profile__subscribe-btn">Edit Profile</MudButton>
                    </div>
                </div>

                <!-- User Identity and Info -->
                <div class="org-profile__identity">
                    <div class="d-flex align-center gap-2 mb-1">
                        <MudText Typo="Typo.h4" HtmlTag="h1" Style="font-weight: 700;">@GetFullName()</MudText>
                    </div>
                    <div class="d-flex align-center gap-1 mb-1">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@@@GetUsername()</MudText>
                    </div>

                    @if (!string.IsNullOrEmpty(GetDisplayLocation()) && GetDisplayLocation() != "Location not set")
                    {
                        <div class="d-flex align-center gap-1 mb-1">
                            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@GetDisplayLocation()</MudText>
                        </div>
                    }

                    <div class="d-flex align-center gap-4 mt-4 mb-4">
                        <div class="d-flex gap-1 align-center">
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@EventsAttended</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">events attended</MudText>
                        </div>
                        <div class="d-flex gap-1 align-center">
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@ReviewsGiven</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">reviews</MudText>
                        </div>
                    </div>

                    <MudText Typo="Typo.body1" Class="mb-2">Member of the community</MudText>
                    
                    <div class="d-flex align-center gap-4 flex-wrap">
                        @if (!string.IsNullOrEmpty(UserData.Email))
                        {
                            <div class="d-flex align-center gap-1">
                                <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Color="Color.Primary" />
                                <MudText Typo="Typo.body2">@UserData.Email</MudText>
                            </div>
                        }
                        @if (UserData.EmailVerified == true)
                        {
                            <div class="d-flex align-center gap-1">
                                <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" Color="Color.Success" />
                                <MudText Typo="Typo.body2">Email Verified</MudText>
                            </div>
                        }
                    </div>
                </div>

                <!-- Tabs Section -->
                <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-6 bg-transparent" Class="mt-6 bg-transparent" Color="Color.Transparent" SliderColor="Color.Primary">
                    <MudTabPanel Text="Posts">
                        <div class="org-profile__section">
                            @if (IsLoading)
                            {
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                            }
                            else if (_posts.Any())
                            {
                                <MudGrid Spacing="4">
                                    @foreach (var evt in _posts)
                                    {
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudCard Elevation="0" Class="org-profile__event-card cursor-pointer" @onclick="@(() => NavigateToEvent(evt.Id))">
                                                <div class="org-profile__event-card-image">
                                                    <MudImage Src="@GetEventImage(evt)" ObjectFit="ObjectFit.Cover" Style="width: 100%; height: 100%; display: block;" />
                                                </div>
                                                <MudCardContent Class="pa-3">
                                                    <div class="d-flex align-center gap-2 mb-2">
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="font-weight-bold px-1">@evt.EventTypeFullName</MudChip>
                                                        @if ((evt.Price ?? 0) == 0)
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="px-1">Free</MudChip>
                                                        }
                                                    </div>
                                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600; line-height: 1.3; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">@evt.Title</MudText>
                                                    <div class="d-flex align-center gap-1 mt-2">
                                                        <MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Size="Size.Small" Color="Color.Secondary" />
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatEventDate(evt)</MudText>
                                                    </div>
                                                    <div class="d-flex align-center gap-1 mt-1">
                                                        <MudIcon Icon="@Icons.Material.Outlined.LocationOn" Size="Size.Small" Color="Color.Secondary" />
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@GetLocationText(evt)</MudText>
                                                    </div>
                                                </MudCardContent>
                                            </MudCard>
                                        </MudItem>
                                    }
                                </MudGrid>
                            }
                            else
                            {
                                <MudPaper Elevation="0" Class="pa-6 text-center border-solid border-1 mud-border-lines-default rounded-lg">
                                    <MudIcon Icon="@Icons.Material.Outlined.EventBusy" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">No posts yet</MudText>
                                </MudPaper>
                            }
                        </div>
                    </MudTabPanel>
                    
                    <MudTabPanel Text="History">
                        <div class="org-profile__section">
                            @if (IsLoading)
                            {
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                            }
                            else if (_history.Any())
                            {
                                <MudGrid Spacing="4">
                                    @foreach (var reg in _history)
                                    {
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudCard Elevation="0" Class="org-profile__event-card cursor-pointer" @onclick="@(() => NavigateToEvent(reg.EventId))">
                                                <div class="org-profile__event-card-image">
                                                    <MudImage Src="@GetHistoryImage(reg)" ObjectFit="ObjectFit.Cover" Style="width: 100%; height: 100%; display: block;" />
                                                </div>
                                                <MudCardContent Class="pa-3">
                                                    <div class="d-flex align-center gap-2 mb-2">
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="font-weight-bold px-1">Registered</MudChip>
                                                    </div>
                                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600; line-height: 1.3; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">@reg.EventTitle</MudText>
                                                    <div class="d-flex align-center gap-1 mt-2">
                                                        <MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Size="Size.Small" Color="Color.Secondary" />
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatHistoryDate(reg)</MudText>
                                                    </div>
                                                </MudCardContent>
                                            </MudCard>
                                        </MudItem>
                                    }
                                </MudGrid>
                            }
                            else
                            {
                                <MudPaper Elevation="0" Class="pa-6 text-center border-solid border-1 mud-border-lines-default rounded-lg">
                                    <MudIcon Icon="@Icons.Material.Outlined.History" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                                    <MudText Typo="Typo.body1" Color="Color.Secondary">No events history</MudText>
                                </MudPaper>
                            }
                        </div>
                    </MudTabPanel>

                    <MudTabPanel Text="Reviews">
                        <div class="org-profile__section">
                            @if (MyReviews != null && MyReviews.Any())
                            {
                                <MudStack Spacing="3">
                                    @foreach (var review in MyReviews)
                                    {
                                        <MudCard Elevation="0" Class="pa-4 border-solid border-1 mud-border-lines-default rounded-lg">
                                            <div class="d-flex justify-space-between align-start mb-2">
                                                <div>
                                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@(review.OrganizationFullName ?? "Organization")</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(review.CreatedAt?.ToString("MMM dd, yyyy") ?? "")</MudText>
                                                </div>
                                                <MudRating ReadOnly="true" SelectedValue="@(review.Rating ?? 0)" Size="Size.Small" />
                                            </div>
                                            <MudText Typo="Typo.body2">@review.Comment</MudText>
                                        </MudCard>
                                    }
                                </MudStack>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No reviews given yet.</MudAlert>
                            }
                        </div>
                    </MudTabPanel>
                </MudTabs>
            </MudContainer>
        </div>
    }
</MudContainer>
