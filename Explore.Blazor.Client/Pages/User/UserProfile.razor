@page "/user/profile"
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients
@attribute [Authorize]

<PageTitle>User Profile</PageTitle>

@if (IsLoading)
{
    <MudContainer Class="user-profile user-profile--loading">
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="min-height: 400px;">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.h6">Loading profile...</MudText>
        </MudStack>
    </MudContainer>
}
else if (!string.IsNullOrEmpty(ErrorMessage))
{
    <MudContainer Class="user-profile user-profile--error">
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @ErrorMessage
        </MudAlert>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@LoadUserDataAsync">
            Retry
        </MudButton>
    </MudContainer>
}
else if (UserData == null)
{
    <MudContainer Class="user-profile user-profile--no-data">
        <MudAlert Severity="Severity.Warning">
            Unable to load user profile. Please try logging in again.
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login" Class="mt-4">
            Log In
        </MudButton>
    </MudContainer>
}
else
{
    <MudContainer Class="user-profile">
        <!-- User Info (Hero + Header + Stats) -->
        <MudCard Class="mb-6 user-profile__card" Elevation="0">
            <div class="user-profile__hero"></div>

            <MudCardContent Class="user-profile__content" Style="padding-top:0;">
                <div class="user-profile__header">
                    <!-- Avatar -->
                    <div class="user-profile__avatar">
                        <MudAvatar Size="Size.Large" Style="width:140px; height:140px; font-size:3rem;">
                            @GetInitials()
                        </MudAvatar>
                    </div>

                    <!-- Name + Stats -->
                    <div style="flex:1;">
                        <MudText Typo="Typo.h4" Class="mb-1">@GetFullName()</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary">
                            @("@" + GetUsername()) @if (!string.IsNullOrEmpty(GetDisplayLocation()) && GetDisplayLocation() != "Location not set") { <span> • @GetDisplayLocation()</span> }
                        </MudText>

                        <div class="user-profile__stats">
                            <div class="user-profile__stat">
                                <MudText Typo="Typo.h5" Class="user-profile__stat-value">@EventsAttended</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Events Attended</MudText>
                            </div>
                            <div class="user-profile__stat">
                                <MudText Typo="Typo.h5" Class="user-profile__stat-value">@ReviewsGiven</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Reviews Given</MudText>
                            </div>
                        </div>
                    </div>
                </div>
            </MudCardContent>
        </MudCard>

        <MudGrid>
            <!-- Left Column -->
            <MudItem xs="12" md="4">
                <!-- About Section -->
                <MudCard Class="mb-6 user-profile__card" Elevation="0">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">About</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>

                    <MudCardContent Class="user-profile__content">
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4" Style="font-style: italic;">
                            Member of the community
                        </MudText>

                        <div class="user-profile__info-list">
                            @if (!string.IsNullOrEmpty(UserData.Email))
                            {
                                <div class="user-profile__info-row">
                                    <MudIcon Icon="@Icons.Material.Filled.Email" Color="Color.Primary" />
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body2">@UserData.Email</MudText>
                                    </MudStack>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(GetDisplayLocation()) && GetDisplayLocation() != "Location not set")
                            {
                                <div class="user-profile__info-row">
                                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Primary" />
                                    <MudText Typo="Typo.body2">Lives in @GetDisplayLocation()</MudText>
                                </div>
                            }
                            @if (UserData.EmailVerified == true)
                            {
                                <div class="user-profile__info-row">
                                    <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Success" />
                                    <MudText Typo="Typo.body2">Email verified</MudText>
                                </div>
                            }
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <!-- Right Column -->
            <MudItem xs="12" md="8">
                <!-- User Reviews Section -->
                <MudCard Class="user-profile__card" Elevation="0">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width:100%;">
                                <MudText Typo="Typo.h6">My Reviews</MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">@ReviewsGiven total</MudChip>
                            </MudStack>
                        </CardHeaderContent>
                    </MudCardHeader>

                    <MudCardContent Class="user-profile__content">
                        <MudStack Spacing="4">
                            @if (MyReviews != null && MyReviews.Any())
                            {
                                @foreach (var review in MyReviews.Take(3))
                                {
                                    <MudPaper Class="pa-4 user-profile__review" Elevation="0">
                                        <MudStack Spacing="2">
                                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.subtitle1" Style="font-weight:600;">
                                                    @(review.OrganizationFullName ?? "Organization")
                                                </MudText>
                                                <div class="user-profile__rating">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        var starIndex = i;
                                                        if (starIndex <= review.Rating)
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" />
                                                        }
                                                        else
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Outlined.StarBorder" />
                                                        }
                                                    }
                                                </div>
                                            </MudStack>

                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @review.CreatedAt.ToString("MMM dd, yyyy")
                                            </MudText>

                                            <MudText Typo="Typo.body2">
                                                @review.Comment
                                            </MudText>
                                        </MudStack>
                                    </MudPaper>
                                }
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No reviews given yet.</MudText>
                            }
                        </MudStack>

                        <div class="btn-outline" style="display:flex; justify-content:center;">
                            <MudButton Variant="Variant.Outlined" Class="mt-6" StartIcon="@Icons.Material.Filled.RateReview" Href="/user/reviews">
                                View All Reviews
                            </MudButton>
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudContainer>
}
