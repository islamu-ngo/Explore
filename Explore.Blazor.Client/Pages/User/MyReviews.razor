@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging
@inject IOrganizationReviewService OrganizationReviewService
@inject IUserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<MyReviews> Logger

<PageTitle>My Reviews</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="my-reviews">
    <MudText Typo="Typo.h4" Class="mb-4">My Reviews</MudText>

    @if (IsLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (Reviews == null || !Reviews.Any())
    {
        <MudAlert Severity="Severity.Info">You haven't given any reviews yet.</MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var review in Reviews)
            {
                <MudItem xs="12">
                    <MudPaper Class="pa-4" Elevation="2">
                        <MudStack Spacing="2">
                            <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.h6">@review.OrganizationFullName</MudText>
                                <div class="d-flex">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" />
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Outlined.StarBorder" Color="Color.Warning" />
                                        }
                                    }
                                </div>
                            </MudStack>
                            <MudText Typo="Typo.caption">@review.CreatedAt.ToString("MMM dd, yyyy")</MudText>
                            <MudText Typo="Typo.body1">@review.Comment</MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private List<OrganizationReviewDto> Reviews { get; set; } = new();
    private bool IsLoading { get; set; } = true;

    // No prerender persistence. Load reviews on the client in OnInitializedAsync.

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                var userData = await UserService.GetCurrentUserAsync();
                if (userData != null)
                {
                    Reviews = (await OrganizationReviewService.GetReviewsByUserId(userData.Id)).ToList();
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading reviews");
        }
        finally
        {
            IsLoading = false;
        }
    }

    // PersistData removed - no PersistentComponentState usage in client-only rendering mode.

    // Dispose removed - no subscriptions to dispose for persistence.
}
