@page "/settings"
@using MudBlazor
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Settings</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    <MudText Typo="Typo.h4" Style="font-weight: 800;" Class="mb-6">Account Settings</MudText>

    @if (_loading)
    {
        <div class="d-flex flex-column align-center justify-center py-16">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.body1" Class="mt-4" Color="Color.Secondary">Loading profile...</MudText>
        </div>
    }
    else if (_user == null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">Failed to load user profile.</MudAlert>
    }
    else
    {
        <MudCard Elevation="0" Class="rounded-xl border-solid border-1 mud-border-lines-default overflow-hidden">
            <div class="pa-6 border-b-1 mud-border-lines-default bg-surface">
                <MudText Typo="Typo.h5" Style="font-weight: 700;">Personal Information</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Update your personal details and profile picture.</MudText>
            </div>
            
            <div class="pa-6">
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-6 rounded-lg" ShowCloseIcon="true" CloseIconClicked="@(() => _errorMessage = null)">
                        @_errorMessage
                    </MudAlert>
                }

                @if (!string.IsNullOrEmpty(_successMessage))
                {
                    <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mb-6 rounded-lg" ShowCloseIcon="true" CloseIconClicked="@(() => _successMessage = null)">
                        @_successMessage
                    </MudAlert>
                }

                <MudForm @ref="_form" @bind-IsValid="_success">
                    <div class="d-flex justify-center mb-8">
                        <div style="width: 200px;">
                            <ImageUpload @bind-PreviewUrl="_profileImagePreview"
                                       FileDataSelected="OnProfileImageFileDataSelected"
                                       PlaceholderText="Select Profile Picture"
                                       UploadButtonText="Change"
                                       Width="200px"
                                       Height="200px"
                                       HintText="JPG, PNG, GIF, WebP (Max 5MB)" 
                                       Icon="@Icons.Material.Filled.Person" />
                        </div>
                    </div>

                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_user.FirstName" 
                                          Label="First Name" 
                                          Required="true" 
                                          Variant="Variant.Outlined" 
                                          Adornment="Adornment.Start" 
                                          AdornmentIcon="@Icons.Material.Filled.Person" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_user.LastName" 
                                          Label="Last Name" 
                                          Required="true" 
                                          Variant="Variant.Outlined"
                                          Adornment="Adornment.Start" 
                                          AdornmentIcon="@Icons.Material.Filled.Person" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_user.Username" 
                                          Label="Username" 
                                          Variant="Variant.Outlined" 
                                          Adornment="Adornment.Start" 
                                          AdornmentIcon="@Icons.Material.Filled.AlternateEmail" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_user.Email" 
                                          Label="Email" 
                                          Variant="Variant.Outlined" 
                                          ReadOnly="true" 
                                          HelperText="Email cannot be changed"
                                          Adornment="Adornment.Start" 
                                          AdornmentIcon="@Icons.Material.Filled.Email" />
                        </MudItem>
                    </MudGrid>

                    <div class="d-flex justify-end mt-8">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   OnClick="SaveSettings" 
                                   Disabled="@(!_success || _isSaving)" 
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Size="Size.Large"
                                   Class="rounded-pill px-8">
                            @if (_isSaving)
                            {
                                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save Changes</span>
                            }
                        </MudButton>
                    </div>
                </MudForm>
            </div>
        </MudCard>
    }
</MudContainer>