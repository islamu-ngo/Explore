@page "/settings"
@using MudBlazor
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true">Settings</MudText>

    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="d-block mx-auto" />
    }
    else if (_user == null)
    {
        <MudAlert Severity="Severity.Error">Failed to load user profile.</MudAlert>
    }
    else
    {
        <MudCard>
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Personal Information</MudText>
                    <MudText Typo="Typo.body2">Update your personal details here.</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudForm @ref="_form" @bind-IsValid="_success">
                    <div class="mb-6">
                        <MudText Typo="Typo.subtitle1" Class="mb-4">Profile Picture</MudText>
                        <ImageUpload @bind-PreviewUrl="_profileImagePreview"
                                   FileSelected="OnProfileImageSelected"
                                   PlaceholderText="Select a new profile picture"
                                   UploadButtonText="Upload Picture"
                                   HintText="JPG, GIF or PNG. Max size of 800K" />
                    </div>

                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_user.FirstName" Label="First Name" Required="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_user.LastName" Label="Last Name" Required="true" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_user.Username" Label="Username" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_user.Email" Label="Email" Variant="Variant.Outlined" ReadOnly="true" />
                        </MudItem>
                    </MudGrid>
                    <div class="d-flex justify-end mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettings" Disabled="@(!_success || _isSaving)" StartIcon="@Icons.Material.Filled.Save">
                            @if (_isSaving)
                            {
                                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                <MudText Class="ms-2">Saving</MudText>
                            }
                            else
                            {
                                <MudText>Save Changes</MudText>
                            }
                        </MudButton>
                    </div>
                </MudForm>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>
