@page "/my/registrations"
@using MudBlazor
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Helpers
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>My Registrations</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4 py-sm-8 py-md-12">
    <!-- Header -->
    <div class="d-flex flex-wrap align-end justify-space-between gap-4 mb-8">
        <div>
            <MudText Typo="Typo.overline" Class="mud-text-secondary" Style="letter-spacing: 0.18em;">PARTICIPANT</MudText>
            <MudText Typo="Typo.h4" HtmlTag="h1">My Registrations</MudText>
        </div>
        <AppButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/my/profile">
            Back to Profile
        </AppButton>
    </div>

    <!-- Filters -->
    <MudGrid Class="mb-8">
        <MudItem xs="12">
            <AppTextField T="string" T="string"
                          @bind-Value="_searchString" 
                          Placeholder="Search events..." 
                          Adornment="Adornment.Start" 
                          AdornmentIcon="@Icons.Material.Filled.Search" 
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        </MudItem>
    </MudGrid>

    @if (_loading)
    {
        <div class="d-flex flex-column align-center justify-center py-16">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-4">
                Loading your registrations...
            </MudText>
        </div>
    }
    else if (!FilteredRegistrations.Any())
    {
        <AppCard Class="my-registrations__empty-state">
            <MudCardContent Class="my-registrations__empty-content" role="status">
                <MudIcon Icon="@Icons.Material.Outlined.AppRegistration"
                         Size="Size.Large"
                         Color="Color.Primary"
                         Class="my-registrations__empty-icon" />
                <MudText Typo="Typo.h5" HtmlTag="h2" Class="my-registrations__empty-title">
                    No registrations yet
                </MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="my-registrations__empty-copy">
                    When you register for an event, it will appear here so you can quickly find the details again.
                </MudText>
                <AppButton Href="/events"
                           StartIcon="@Icons.Material.Filled.Explore"
                           Class="my-registrations__empty-action">
                    Browse Events
                </AppButton>
            </MudCardContent>
        </AppCard>
    }
    else
    {
        <!-- Registration Cards — Virtualized infinite scroll -->
        <MudGrid>
            <Virtualize Items="@FilteredRegistrations.ToList()" Context="reg" OverscanCount="4">
                <ItemContent>
                    <MudItem xs="12" sm="6" md="4">
                        <AppCard Class="h-100 d-flex flex-column">
                            <MudCardMedia Image="@ImageHelper.GetEventImageUrl(reg.FeaturedImageUri, reg.EventTitle ?? "Event")"
                                           Height="200" />
                            <MudCardContent Class="flex-grow-1">
                                <MudText Typo="Typo.button" Color="@(reg.StatusId == 2 ? Color.Success : (reg.StatusId == 3 ? Color.Error : Color.Warning))" Class="mb-1">
                                    @(reg.Status ?? "Pending")
                                </MudText>
                                <MudText Typo="Typo.h6" Class="mb-4">@reg.EventTitle</MudText>
                                
                                <div class="d-flex align-center gap-2 mt-auto pt-4">
                                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@reg.StartTime?.ToString("f")</MudText>
                                </div>
                            </MudCardContent>
                             <MudCardActions>
                                 <AppButton Variant="Variant.Text" 
                                            EndIcon="@Icons.Material.Filled.ArrowForward"
                                            Href="@($"/events/{reg.EventId}")">
                                     Details
                                 </AppButton>
                                 <AppButton Variant="Variant.Text"
                                            StartIcon="@Icons.Material.Filled.CalendarMonth"
                                            Href="@($"/api/event/{reg.EventId}/calendar")">
                                     Calendar
                                 </AppButton>
                                 <MudSpacer />
                                 <AppButton Variant="Variant.Text" 
                                            Color="Color.Error" 
                                           OnClick="@(() => CancelRegistration(reg.RegistrationId))">
                                    Cancel
                                </AppButton>
                            </MudCardActions>
                        </AppCard>
                    </MudItem>
                </ItemContent>
                <Placeholder>
                    <MudItem xs="12" sm="6" md="4">
                        <AppCard Class="h-100 d-flex flex-column">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
                            <MudCardContent>
                                <MudSkeleton Width="30%" Class="mb-1" />
                                <MudSkeleton Width="70%" Class="mb-4" />
                                <MudSkeleton Width="50%" />
                            </MudCardContent>
                        </AppCard>
                    </MudItem>
                </Placeholder>
            </Virtualize>
        </MudGrid>
    }
</MudContainer>
