@page "/my-registrations"
@using MudBlazor
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.AspNetCore.Authorization
@rendermode @(new InteractiveAutoRenderMode(prerender: false))
@attribute [Authorize]

<PageTitle>My Registrations</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4 py-sm-8 py-md-12">
    <!-- Header -->
    <div class="d-flex flex-wrap align-end justify-space-between gap-4 mb-8">
        <div>
            <MudText Typo="Typo.overline" Class="mud-text-secondary" Style="letter-spacing: 0.18em;">PARTICIPANT</MudText>
            <MudText Typo="Typo.h4">My Registrations</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" Href="/user/profile" Color="Color.Primary">
            Back to Profile
        </MudButton>
    </div>

    <!-- Filters -->
    <MudGrid Class="mb-8">
        <MudItem xs="12">
            <MudTextField @bind-Value="_searchString" 
                          Placeholder="Search events..." 
                          Adornment="Adornment.Start" 
                          AdornmentIcon="@Icons.Material.Filled.Search" 
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        </MudItem>
    </MudGrid>

    @if (_loading)
    {
        <div class="d-flex flex-column align-center justify-center py-16">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-4">
                Loading your registrations...
            </MudText>
        </div>
    }
    else if (!FilteredRegistrations.Any())
    {
        <div class="d-flex flex-column align-center justify-center py-16">
            <MudIcon Icon="@Icons.Material.Outlined.AppRegistration" Size="Size.Large" Color="Color.Default" Style="width: 80px; height: 80px; opacity: 0.2;" />
            <MudText Typo="Typo.h6" Class="mt-4">No registrations found</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/events" Class="mt-4">Explore Events</MudButton>
        </div>
    }
    else
    {
        <!-- Registration Cards — Virtualized infinite scroll -->
        <MudGrid>
            <Virtualize Items="@FilteredRegistrations.ToList()" Context="reg" OverscanCount="4">
                <ItemContent>
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Class="h-100 d-flex flex-column">
                            <MudCardMedia Image="@(string.IsNullOrEmpty(reg.FeaturedImageUri) ? $"https://placehold.co/600x400?text={Uri.EscapeDataString(reg.EventTitle ?? "Event")}" : reg.FeaturedImageUri)" 
                                          Height="200" />
                            <MudCardContent Class="flex-grow-1">
                                <MudText Typo="Typo.button" Color="@(reg.StatusId == 2 ? Color.Success : (reg.StatusId == 3 ? Color.Error : Color.Warning))" Class="mb-1">
                                    @(reg.Status ?? "Pending")
                                </MudText>
                                <MudText Typo="Typo.h6" Class="mb-4">@reg.EventTitle</MudText>
                                
                                <div class="d-flex align-center gap-2 mt-auto pt-4">
                                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@reg.StartTime?.ToString("f")</MudText>
                                </div>
                            </MudCardContent>
                            <MudCardActions>
                                <MudButton Variant="Variant.Text" 
                                           Color="Color.Primary" 
                                           EndIcon="@Icons.Material.Filled.ArrowForward"
                                           Href="@($"/event/detail/{reg.EventId}")">
                                    Details
                                </MudButton>
                                <MudSpacer />
                                <MudButton Variant="Variant.Text" 
                                           Color="Color.Error" 
                                           OnClick="@(() => CancelRegistration(reg.RegistrationId))">
                                    Cancel
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                </ItemContent>
                <Placeholder>
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Class="h-100 d-flex flex-column">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
                            <MudCardContent>
                                <MudSkeleton Width="30%" Class="mb-1" />
                                <MudSkeleton Width="70%" Class="mb-4" />
                                <MudSkeleton Width="50%" />
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </Placeholder>
            </Virtualize>
        </MudGrid>
    }
</MudContainer>
