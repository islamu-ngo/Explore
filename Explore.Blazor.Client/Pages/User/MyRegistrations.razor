@page "/my-registrations"
@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Components
@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IProgramService ProgramService
@inject IUserService UserService


<PageTitle>My Registrations</PageTitle>

<style>
/* ===== PAGE WRAPPER ===== */
.registrations-page {
    padding: 24px 0 40px;
    min-height: 100vh;
}

/* ===== HEADER ===== */
.page-header {
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--mud-palette-divider);
}

.page-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 8px;
    background: linear-gradient(135deg, var(--mud-palette-primary), var(--mud-palette-primary-darken));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.page-subtitle {
    color: var(--mud-palette-text-secondary);
    font-size: 1rem;
}

/* ===== STATS CARDS ===== */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 32px;
}

.stat-card {
    padding: 20px;
    border-radius: 12px;
    border: 1px solid var(--mud-palette-lines-default);
    background: var(--mud-palette-surface);
    transition: all 0.3s ease;
}

.stat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0,0,0,0.1);
}

.stat-icon {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.stat-icon.primary {
    background: linear-gradient(135deg, var(--mud-palette-primary), var(--mud-palette-primary-darken));
    color: white;
}

.stat-icon.success {
    background: linear-gradient(135deg, var(--mud-palette-success), var(--mud-palette-success-darken));
    color: white;
}

.stat-icon.warning {
    background: linear-gradient(135deg, var(--mud-palette-warning), var(--mud-palette-warning-darken));
    color: white;
}

.stat-value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--mud-palette-text-primary);
    line-height: 1;
    margin-bottom: 4px;
}

.stat-label {
    font-size: 0.875rem;
    color: var(--mud-palette-text-secondary);
}

/* ===== FILTERS ===== */
.filters-section {
    margin-bottom: 24px;
    padding: 16px;
    border-radius: 12px;
    background: var(--mud-palette-surface);
    border: 1px solid var(--mud-palette-lines-default);
}

.filters-grid {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 16px;
    align-items: end;
}

@@media (max-width: 960px) {
    .filters-grid {
        grid-template-columns: 1fr;
    }
}

/* ===== REGISTRATION CARDS ===== */
.registrations-grid {
    display: grid;
    gap: 20px;
}

.registration-card {
    border-radius: 16px;
    border: 1px solid var(--mud-palette-lines-default);
    overflow: hidden;
    transition: all 0.3s ease;
    background: var(--mud-palette-surface);
}

.registration-card:hover {
    box-shadow: 0 12px 24px rgba(0,0,0,0.12);
    transform: translateY(-2px);
}

.card-content {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    gap: 20px;
    padding: 20px;
}

@@media (max-width: 768px) {
    .card-content {
        grid-template-columns: 1fr;
    }
}

.event-image {
    width: 140px;
    height: 140px;
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--mud-palette-primary), var(--mud-palette-primary-darken));
    position: relative;
}

@@media (max-width: 768px) {
    .event-image {
        width: 100%;
        height: 200px;
    }
}

.event-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.event-details {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.event-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--mud-palette-text-primary);
    margin: 0;
}

.event-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
}

.meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--mud-palette-text-secondary);
    font-size: 0.875rem;
}

.meta-item .mud-icon-root {
    font-size: 1.125rem;
}

.status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.status-badge.upcoming {
    background: rgba(33, 150, 243, 0.1);
    color: var(--mud-palette-primary);
}

.status-badge.completed {
    background: rgba(76, 175, 80, 0.1);
    color: var(--mud-palette-success);
}

.status-badge.cancelled {
    background: rgba(244, 67, 54, 0.1);
    color: var(--mud-palette-error);
}

.event-description {
    color: var(--mud-palette-text-secondary);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.card-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    justify-content: center;
}

@@media (max-width: 768px) {
    .card-actions {
        flex-direction: row;
    }
}

/* ===== EMPTY STATE ===== */
.empty-state {
    text-align: center;
    padding: 60px 20px;
}

.empty-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--mud-palette-primary), var(--mud-palette-primary-darken));
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
}

.empty-icon .mud-icon-root {
    font-size: 2.5rem;
}

.empty-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 8px;
}

.empty-description {
    color: var(--mud-palette-text-secondary);
    margin-bottom: 24px;
}
</style>

<MudContainer MaxWidth="MaxWidth.Large" Class="registrations-page">
    <!-- Header -->
    <div class="page-header">
        <h1 class="page-title">My Registrations</h1>
        <p class="page-subtitle">Manage all your event registrations in one place</p>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon primary">
                <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Large" />
            </div>
            <div class="stat-value">@GetTotalRegistrations()</div>
            <div class="stat-label">Total Registrations</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon success">
                <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Large" />
            </div>
            <div class="stat-value">@GetUpcomingCount()</div>
            <div class="stat-label">Upcoming Events</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon warning">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" />
            </div>
            <div class="stat-value">@GetCompletedCount()</div>
            <div class="stat-label">Completed</div>
        </div>
    </div>

    <!-- Filters -->
    <div class="filters-section">
        <div class="filters-grid">
            <MudTextField @bind-Value="searchQuery"
                          Placeholder="Search registrations..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          OnDebounceIntervalElapsed="FilterRegistrations"
                          DebounceInterval="300" />

            <MudSelect @bind-Value="statusFilter"
                       Label="Status"
                       Variant="Variant.Outlined"
                       T="string"
                       AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem Value="@("all")">All Status</MudSelectItem>
                <MudSelectItem Value="@("upcoming")">Upcoming</MudSelectItem>
                <MudSelectItem Value="@("completed")">Completed</MudSelectItem>
                <MudSelectItem Value="@("cancelled")">Cancelled</MudSelectItem>
            </MudSelect>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="ResetFilters">
                Reset
            </MudButton>
        </div>
    </div>

    <!-- Registrations List -->
    @if (isLoading)
    {
        <div class="empty-state">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <div class="empty-description">Loading your registrations...</div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
    else if (filteredRegistrations.Any())
    {
        <div class="registrations-grid">
            @foreach (var registration in filteredRegistrations)
            {
                <div class="registration-card">
                    <div class="card-content">
                        <div class="event-image">
                            <img src="@GetEventImage(registration)" alt="@registration.EventSessionTitle" />
                        </div>

                        <div class="event-details">
                            <h3 class="event-title">@registration.EventSessionTitle</h3>

                            <div class="event-meta">
                                <div class="meta-item">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" />
                                    <span>@(registration.UserFullName ?? "Unknown")</span>
                                </div>
                            </div>

                            <div>
                                <span class="status-badge @GetStatusClass(registration.ApprovalStatusMasterCode)">
                                    @(registration.ApprovalStatusFullName ?? "Pending")
                                </span>
                            </div>
                        </div>

                        <div class="card-actions">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Visibility"
                                       OnClick="@(() => ViewDetails(registration.EventSessionId))">
                                View Session
                            </MudButton>

                            @if (registration.ApprovalStatusMasterCode?.ToLower() != "completed" &&
                                 registration.ApprovalStatusMasterCode?.ToLower() != "cancelled")
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.Cancel"
                                           OnClick="@(() => CancelRegistration(registration))">
                                    Unregister
                                </MudButton>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">
                <MudIcon Icon="@Icons.Material.Filled.EventBusy" />
            </div>
            <h2 class="empty-title">No Registrations Found</h2>
            <p class="empty-description">
                @if (!string.IsNullOrWhiteSpace(searchQuery) || statusFilter != "all")
                {
                    <span>Try adjusting your filters or search query.</span>
                }
                else
                {
                    <span>You haven't registered for any events yet. Discover amazing programs and register now!</span>
                }
            </p>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Explore"
                       Href="/events">
                Browse Events
            </MudButton>
        </div>
    }
</MudContainer>

@code {
    private ICollection<EventRegistrationListDto> registrations = new List<EventRegistrationListDto>();
    private List<EventRegistrationListDto> filteredRegistrations = new();
    private string searchQuery = "";
    private string statusFilter = "all";
    private bool isLoading = true;
    private string? errorMessage;

    // Simplified initialization: load data from API on client only (no prerender persistence)
    protected override async Task OnInitializedAsync()
    {
        await LoadRegistrationsAsync();
        FilterRegistrations();
    }

    private async Task LoadRegistrationsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var user = await UserService.GetCurrentUserAsync();
            if (user != null)
            {
                registrations = await ProgramService.GetRegistrationsByUserAsync(user.Id);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load your registrations: {ex.Message}";
            Console.WriteLine($"Error loading registrations: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterRegistrations()
    {
        var filtered = registrations.AsEnumerable();

        // Search filter
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            filtered = filtered.Where(r =>
                (r.EventSessionTitle?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        // Status filter
        if (statusFilter != "all")
        {
            filtered = filtered.Where(r =>
                (r.ApprovalStatusMasterCode?.Equals(statusFilter, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        filteredRegistrations = filtered.ToList();
    }

    private void OnSearchChanged(string value)
    {
        searchQuery = value;
        FilterRegistrations();
    }

    private void OnStatusFilterChanged(string value)
    {
        statusFilter = value;
        FilterRegistrations();
    }

    private async Task RefreshData()
    {
        await LoadRegistrationsAsync();
        FilterRegistrations();
    }

    private void ResetFilters()
    {
        searchQuery = "";
        statusFilter = "all";
        FilterRegistrations();
    }

    private int GetTotalRegistrations() => registrations.Count;

    private int GetUpcomingCount() => registrations.Count(r =>
        r.ApprovalStatusMasterCode?.Equals("pending", StringComparison.OrdinalIgnoreCase) == true ||
        r.ApprovalStatusMasterCode?.Equals("approved", StringComparison.OrdinalIgnoreCase) == true);

    private int GetCompletedCount() => registrations.Count(r =>
        r.ApprovalStatusMasterCode?.Equals("completed", StringComparison.OrdinalIgnoreCase) == true);

    private Color GetStatusColor(EventRegistrationListDto registration)
    {
        return registration.ApprovalStatusMasterCode?.ToLower() switch
        {
            "approved" => Color.Success,
            "pending" => Color.Warning,
            "rejected" => Color.Error,
            "completed" => Color.Info,
            _ => Color.Default
        };
    }

    private string GetStatusClass(string? status)
    {
        return status?.ToLower() switch
        {
            "approved" => "status-approved",
            "pending" => "status-pending",
            "rejected" or "cancelled" => "status-cancelled",
            "completed" => "status-completed",
            _ => ""
        };
    }

    private string GetEventImage(EventRegistrationListDto registration)
    {
        var color = registration.ApprovalStatusMasterCode?.ToLower() switch
        {
            "approved" => "4CAF50",
            "pending" => "FF9800",
            "rejected" => "F44336",
            "completed" => "2196F3",
            _ => "607D8B"
        };
        var text = !string.IsNullOrWhiteSpace(registration.EventSessionTitle)
            ? registration.EventSessionTitle.Split(' ').FirstOrDefault() ?? "Event"
            : "Event";
        return $"https://dummyimage.com/400x200/{color}/ffffff&text={Uri.EscapeDataString(text)}";
    }

    private void ViewDetails(Guid sessionId)
    {
        Navigation.NavigateTo($"/event/session/{sessionId}");
    }

    private async Task CancelRegistration(EventRegistrationListDto registration)
    {
        var result = await DialogService.ShowMessageBox(
            "Cancel Registration",
            $"Are you sure you want to unregister from '{registration.EventSessionTitle}'?",
            yesText: "Yes, Unregister",
            cancelText: "No, Keep Registration");

        if (result == true)
        {
            try
            {
                var success = await ProgramService.UnregisterFromProgramAsync(registration.Id);
                if (success)
                {
                    await LoadRegistrationsAsync();
                    FilterRegistrations();
                    Snackbar.Add($"Successfully unregistered from {registration.EventSessionTitle}", Severity.Success);
                }
                else
                {
                    Snackbar.Add($"Failed to unregister", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }
}
