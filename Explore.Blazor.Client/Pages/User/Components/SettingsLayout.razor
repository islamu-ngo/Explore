@using MudBlazor
@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation

<div class="settings-layout">
    <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
        <!-- Header -->
        <div class="settings-header mb-8">
            <MudText Typo="Typo.h4" HtmlTag="h1" Style="font-weight: 800;">Account Settings</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Manage your account settings and preferences</MudText>
        </div>

        <!-- Main Layout: Sidebar + Content -->
        <MudGrid Spacing="4">
            <!-- Sidebar Navigation -->
            <MudItem xs="12" md="3" Class="@(_showMobileMenu ? "d-block" : "d-none d-md-block")">
                <MudPaper Elevation="0" Class="settings-sidebar pa-0" Style="background-color: transparent;">
                    <MudList T="string" Dense="true" DisablePadding="true">
                        <MudListItem Icon="@Icons.Material.Filled.Person" 
                                     Text="Personal Info" 
                                     Class="@GetNavItemClass("personal")"
                                     OnClick="@(() => SelectSection("personal"))" />
                        <MudListItem Icon="@Icons.Material.Filled.Security" 
                                     Text="Security" 
                                     Class="@GetNavItemClass("security")"
                                     OnClick="@(() => SelectSection("security"))" />
                        <MudListItem Icon="@Icons.Material.Filled.PrivacyTip" 
                                     Text="Privacy" 
                                     Class="@GetNavItemClass("privacy")"
                                     OnClick="@(() => SelectSection("privacy"))" />
                        <MudListItem Icon="@Icons.Material.Filled.Notifications" 
                                     Text="Notifications" 
                                     Class="@GetNavItemClass("notifications")"
                                     OnClick="@(() => SelectSection("notifications"))" />
                        <MudListItem Icon="@Icons.Material.Filled.Link" 
                                     Text="Connected Apps" 
                                     Class="@GetNavItemClass("connected-apps")"
                                     OnClick="@(() => SelectSection("connected-apps"))" />
                        <MudListItem Icon="@Icons.Material.Filled.Palette" 
                                     Text="Appearance" 
                                     Class="@GetNavItemClass("appearance")"
                                     OnClick="@(() => SelectSection("appearance"))" />
                        <MudListItem Icon="@Icons.Material.Filled.Key" 
                                     Text="API Keys" 
                                     Class="@GetNavItemClass("api-keys")"
                                     OnClick="@(() => SelectSection("api-keys"))" />
                    </MudList>
                </MudPaper>
            </MudItem>

            <!-- Content Area -->
            <MudItem xs="12" md="9" Class="@(!_showMobileMenu ? "d-block" : "d-none d-md-block")">
                <MudPaper Elevation="0" Class="settings-content pa-6" Style="background-color: transparent;">
                    <div class="d-md-none mb-4">
                        <AppButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToMenu">
                            Settings Menu
                        </AppButton>
                    </div>
                    @if (CurrentSection == "personal")
                    {
                        <SettingsPersonalInfo />
                    }
                    else if (CurrentSection == "security")
                    {
                        <SettingsSecurity />
                    }
                    else if (CurrentSection == "privacy")
                    {
                        <SettingsPrivacy />
                    }
                    else if (CurrentSection == "notifications")
                    {
                        <SettingsNotifications />
                    }
                    else if (CurrentSection == "connected-apps")
                    {
                        <SettingsConnectedApps />
                    }
                    else if (CurrentSection == "appearance")
                    {
                        <SettingsAppearance />
                    }
                    else if (CurrentSection == "api-keys")
                    {
                        <Explore.Blazor.Client.Pages.Admin.Components.ApiKeysSection OwnerType="1" Title="API Keys" Description="Create and manage personal API keys for programmatic access to your account." />
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
</div>

@code {
    private static readonly string[] AllowedSections =
    {
        "personal", "security", "privacy", "notifications",
        "connected-apps", "appearance", "api-keys"
    };

    private string CurrentSection { get; set; } = "personal";
    private bool _showMobileMenu = true;

    protected override void OnInitialized()
    {
        // Respect ?section= query parameter for deep links (e.g., from EventRegistration)
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var section = ParseSectionFromQuery(uri.Query);
        if (section is not null && Array.IndexOf(AllowedSections, section) >= 0)
        {
            CurrentSection = section;
            _showMobileMenu = false;
        }
    }

    private static string? ParseSectionFromQuery(string query)
    {
        if (string.IsNullOrEmpty(query))
        {
            return null;
        }

        var trimmed = query.StartsWith('?') ? query[1..] : query;
        foreach (var pair in trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0)
            {
                continue;
            }

            var key = Uri.UnescapeDataString(pair[..eq]);
            if (!string.Equals(key, "section", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            var value = Uri.UnescapeDataString(pair[(eq + 1)..]);
            return string.IsNullOrWhiteSpace(value) ? null : value;
        }

        return null;
    }

    private void SelectSection(string section)
    {
        CurrentSection = section;
        _showMobileMenu = false;
    }

    private void BackToMenu()
    {
        _showMobileMenu = true;
    }

    private string GetNavItemClass(string section)
    {
        return CurrentSection == section ? "settings-nav-active" : "";
    }
}
