@using MudBlazor

<div class="settings-section">
    <!-- Section Header -->
    <div class="settings-section-header mb-6">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">Security</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Manage your account security and login settings</MudText>
    </div>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Construction" Class="mb-6">
        Security settings are coming soon. Password management, two-factor authentication, and session management will be available in a future update.
    </MudAlert>

    <!-- Password Section -->
    <div class="settings-form-section mb-8" style="opacity: 0.5; pointer-events: none;">
        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;" Class="mb-4">Password</MudText>
        <MudPaper Elevation="0" Class="pa-4 bg-surface border-solid border-1 mud-border-lines-default rounded-lg">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.body1" Style="font-weight: 500;">Change your password</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Update your password regularly to keep your account secure</MudText>
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" Class="rounded-pill" Disabled="true">
                    Change Password
                </MudButton>
            </div>
        </MudPaper>
    </div>

    <!-- Divider -->
    <MudDivider Class="my-6" />

    <!-- Two-Factor Authentication Section -->
    <div class="settings-form-section mb-8" style="opacity: 0.5; pointer-events: none;">
        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;" Class="mb-4">Two-Factor Authentication</MudText>
        <MudPaper Elevation="0" Class="pa-4 bg-surface border-solid border-1 mud-border-lines-default rounded-lg">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <MudText Typo="Typo.body1" Style="font-weight: 500;">Add an extra layer of security</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Require a verification code in addition to your password</MudText>
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Security" Class="rounded-pill" Disabled="true">
                    Enable 2FA
                </MudButton>
            </div>
        </MudPaper>
    </div>

    <!-- Divider -->
    <MudDivider Class="my-6" />

    <!-- Active Sessions Section -->
    <div class="settings-form-section" style="opacity: 0.5; pointer-events: none;">
        <MudText Typo="Typo.subtitle2" Style="font-weight: 600;" Class="mb-4">Active Sessions</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Manage devices where you're signed in</MudText>

        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">
            Session management will be available when security features are enabled.
        </MudAlert>
    </div>
</div>

