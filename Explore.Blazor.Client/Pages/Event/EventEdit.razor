@page "/eventedit/{eventId:guid}"
@using MudBlazor
@using Explore.Blazor.Client.Models
@using Explore.Blazor.Client.Models.DTOs
@using Explore.Blazor.Client.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using System.IO
@inject IEventService EventService
@inject IOrganizationService OrganizationService
@inject IAdminService AdminService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Edit Event</PageTitle>

@if (isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; min-height: 400px;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (currentEvent != null && updateDto != null)
{
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <MudCard Class="pa-6" Style="max-width: 800px; margin: 0 auto;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <div class="d-flex align-items-center">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" 
                                         Color="Color.Primary" 
                                         OnClick="NavigateBack" 
                                         Class="me-3" />
                            <MudText Typo="Typo.h5">Edit Event</MudText>
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <EditForm Model="updateDto" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        
                        <!-- Image Display -->
                        <div class="mb-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Event Image</MudText>
                            <MudPaper Class="pa-4" Style="background-color: var(--mud-palette-background-grey);">
                                <ImageUpload ImageKey="@updateDto.ImageKey"
                                            ImageKeyChanged="OnImageKeyChanged"
                                            PreviewUrl="@selectedImageUrl"
                                            PreviewUrlChanged="OnPreviewUrlChanged"
                                            Width="100%"
                                            Height="300px"
                                            PlaceholderText="Update event image"
                                            HintText="Upload a new image or keep the existing one (JPG, PNG, GIF, WebP - Max 5MB)" />
                            </MudPaper>
                        </div>

                        <!-- Event Title -->
                        <div class="mb-3">
                            <MudTextField @bind-Value="updateDto.Title" 
                                        Label="Event Title" 
                                        Variant="Variant.Outlined" 
                                        Required
                                        FullWidth />
                            <ValidationMessage For="@(() => updateDto.Title)" />
                        </div>

                        <!-- Event Description -->
                        <div class="mb-3">
                            <MudTextField @bind-Value="updateDto.Description" 
                                        Label="Event Description" 
                                        Variant="Variant.Outlined" 
                                        Lines="4"
                                        FullWidth />
                        </div>

                        <!-- Date and Time -->
                        <MudText Typo="Typo.h6" Class="mb-3">Date and Time</MudText>
                        <MudPaper Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                            <MudGrid Spacing="3">
                                <MudItem xs="12" sm="6">
                                    <MudDatePicker Label="Start Date" @bind-Date="_startDate" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTimePicker Label="Start Time" @bind-Time="_startTime" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudDatePicker Label="End Date" @bind-Date="_endDate" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTimePicker Label="End Time" @bind-Time="_endTime" Variant="Variant.Outlined" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <!-- Location Info -->
                        <MudText Typo="Typo.h6" Class="mb-3">Location</MudText>
                        <MudPaper Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                            <MudSwitch @bind-Value="_isOnline" Label="Online Event (No physical location)" Color="Color.Primary" Class="mb-3" />
                            
                            @if (_isOnline)
                            {
                                <MudTextField @bind-Value="updateDto.ProgramUrl" 
                                            Label="Online Meeting Link (e.g. Teams)" 
                                            Variant="Variant.Outlined" 
                                            FullWidth 
                                            Class="mb-3"
                                            Adornment="Adornment.Start"
                                            AdornmentIcon="@Icons.Material.Filled.Link" />
                            }
                            else
                            {
                                <MudGrid Spacing="3">
                                    <MudItem xs="12">
                                        <MudTextField @bind-Value="updateDto.Address" 
                                                    Label="Address" 
                                                    Variant="Variant.Outlined" 
                                                    FullWidth
                                                    Placeholder="Street name and number"
                                                    Adornment="Adornment.Start"
                                                    AdornmentIcon="@Icons.Material.Filled.Home" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField @bind-Value="updateDto.City" 
                                                    Label="City" 
                                                    Variant="Variant.Outlined" 
                                                    FullWidth
                                                    Placeholder="City name"
                                                    Adornment="Adornment.Start"
                                                    AdornmentIcon="@Icons.Material.Filled.LocationCity" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect @bind-Value="updateDto.Country" 
                                                   Label="Country" 
                                                   Variant="Variant.Outlined" 
                                                   FullWidth
                                                   Placeholder="Select Country"
                                                   Adornment="Adornment.Start"
                                                   AdornmentIcon="@Icons.Material.Filled.Public">
                                            <MudSelectItem Value="@("Belgium")">Belgium</MudSelectItem>
                                            <MudSelectItem Value="@("Netherlands")">Netherlands</MudSelectItem>
                                            <MudSelectItem Value="@("France")">France</MudSelectItem>
                                            <MudSelectItem Value="@("Germany")">Germany</MudSelectItem>
                                            <MudSelectItem Value="@("Spain")">Spain</MudSelectItem>
                                            <MudSelectItem Value="@("Italy")">Italy</MudSelectItem>
                                            <MudSelectItem Value="@("United Kingdom")">United Kingdom</MudSelectItem>
                                            <MudSelectItem Value="@("Portugal")">Portugal</MudSelectItem>
                                            <MudSelectItem Value="@("Austria")">Austria</MudSelectItem>
                                            <MudSelectItem Value="@("Switzerland")">Switzerland</MudSelectItem>
                                            <MudSelectItem Value="@("Poland")">Poland</MudSelectItem>
                                            <MudSelectItem Value="@("Sweden")">Sweden</MudSelectItem>
                                            <MudSelectItem Value="@("Denmark")">Denmark</MudSelectItem>
                                            <MudSelectItem Value="@("Norway")">Norway</MudSelectItem>
                                            <MudSelectItem Value="@("Finland")">Finland</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudNumericField @bind-Value="updateDto.PostCode" 
                                                       Label="Postal Code" 
                                                       Variant="Variant.Outlined" 
                                                       FullWidth />
                                    </MudItem>
                                </MudGrid>
                            }
                        </MudPaper>

                        <!-- Price -->
                        <div class="mb-3">
                            <MudNumericField @bind-Value="updateDto.Price" 
                                           Label="Price" 
                                           Variant="Variant.Outlined" 
                                           FullWidth
                                           Min="0"
                                           Adornment="Adornment.Start"
                                           AdornmentIcon="@Icons.Material.Filled.Euro" />
                        </div>

                        <!-- URL -->
                        @if (!_isOnline)
                        {
                            <div class="mb-3">
                                <MudTextField @bind-Value="updateDto.ProgramUrl" 
                                            Label="Event URL (optional)" 
                                            Variant="Variant.Outlined" 
                                            FullWidth
                                            Placeholder="https://..."
                                            Adornment="Adornment.Start"
                                            AdornmentIcon="@Icons.Material.Filled.Link" />
                            </div>
                        }

                        <!-- Event Type -->
                        <div class="mb-3">
                            <MudSelect @bind-Value="updateDto.EventTypeId" 
                                       Label="Event Type" 
                                       Variant="Variant.Outlined" 
                                       FullWidth
                                       Required
                                       Adornment="Adornment.Start"
                                       AdornmentIcon="@Icons.Material.Filled.Category">
                                @if (eventTypes != null)
                                {
                                    @foreach (var eventType in eventTypes)
                                    {
                                        <MudSelectItem Value="@eventType.Id">@eventType.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </div>

                        <!-- Read-only Organization -->
                        <MudAlert Severity="Severity.Info" Class="mb-3">
                            <MudText Typo="Typo.body2">
                                <strong>Organization:</strong> @currentEvent.OrganizationFullName<br/>
                                <MudText Typo="Typo.caption">To change organization, please contact support.</MudText>
                            </MudText>
                        </MudAlert>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between mt-4">
                            <MudButton Variant="Variant.Outlined" 
                                     Color="Color.Secondary" 
                                     OnClick="NavigateBack">
                                Cancel
                            </MudButton>
                            <MudButton ButtonType="ButtonType.Submit" 
                                     Variant="Variant.Filled" 
                                     Color="Color.Primary"
                                     StartIcon="@Icons.Material.Filled.Save">
                                Save Changes
                            </MudButton>
                        </div>
                    </EditForm>
                </MudCardContent>
            </MudCard>
        </div>
    </div>
</div>
}
else
{
    <MudAlert Severity="Severity.Error">Event not found.</MudAlert>
}

@code {
    [Parameter] public Guid EventId { get; set; }
    
    private EventDetailsDto? currentEvent;
    private UpdateEventDto? updateDto;
    private DateTime? _startDate;
    private TimeSpan? _startTime;
    private DateTime? _endDate;
    private TimeSpan? _endTime;
    private bool _isOnline = false;
    private string selectedImageUrl = string.Empty;
    private bool isLoading = true;
    private List<EventTypeListDto>? eventTypes;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            
            // Load event types
            eventTypes = await AdminService.GetEventTypesAsync();
            
            currentEvent = await EventService.GetEventByIdAsync(EventId);
            
            if (currentEvent != null)
            {
                // Initialize updateDto from currentEvent
                updateDto = new UpdateEventDto
                {
                    Id = currentEvent.Id,
                    Title = currentEvent.Title,
                    Description = currentEvent.Description,
                    AudienceGenderId = currentEvent.AudienceGenderId,
                    AudienceAgeId = currentEvent.AudienceAgeId,
                    OrganizationId = currentEvent.OrganizationId,
                    AudienceAttendees = currentEvent.AudienceAttendees,
                    Price = currentEvent.Price,
                    FeaturedImageId = currentEvent.FeaturedImageId,
                    IsRegistrationRequired = currentEvent.IsRegistrationRequired,
                    Country = currentEvent.Country,
                    City = currentEvent.City,
                    PostCode = currentEvent.PostCode,
                    Address = currentEvent.Address,
                    ProgramUrl = currentEvent.ProgramUrl,
                    EventTypeId = currentEvent.EventTypeId,
                    StartDate = currentEvent.StartDate,
                    EndDate = currentEvent.EndDate
                };
                
                // Initialize date/time pickers
                var localStart = currentEvent.StartDate.ToLocalTime();
                var localEnd = currentEvent.EndDate.ToLocalTime();
                
                _startDate = localStart.Date;
                _startTime = localStart.TimeOfDay;
                _endDate = localEnd.Date;
                _endTime = localEnd.TimeOfDay;
                
                // Determine if online based on address fields being empty and URL present
                _isOnline = string.IsNullOrEmpty(currentEvent.Address) && 
                           string.IsNullOrEmpty(currentEvent.City) && 
                           !string.IsNullOrEmpty(currentEvent.ProgramUrl);
                
                selectedImageUrl = currentEvent.FeaturedImageUri ?? GeneratePlaceholderImage();
            }
            else
            {
                Snackbar.Add("Event not found", Severity.Error);
                Navigation.NavigateTo("/myevents");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading event: {ex.Message}", Severity.Error);
            Navigation.NavigateTo("/myevents");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetEventType(bool isOnline)
    {
        if (updateDto != null)
        {
            // For now, we don't have IsOnline in UpdateEventDto
            // This would require backend updates
            StateHasChanged();
        }
    }

    private string GeneratePlaceholderImage()
    {
        if (currentEvent == null) return string.Empty;
        
        var eventTitle = Uri.EscapeDataString(currentEvent.Title ?? "Event");
        var backgroundColor = GetCategoryColor();
        return $"https://via.placeholder.com/400x250/{backgroundColor}/ffffff?text={eventTitle}";
    }
    
    private string GetCategoryColor()
    {
        return currentEvent?.EventTypeFullName?.ToLower() switch
        {
            var s when s?.Contains("conference") == true => "2196F3",
            var s when s?.Contains("workshop") == true => "FF9800",
            var s when s?.Contains("webinar") == true => "4CAF50",
            var s when s?.Contains("seminar") == true => "E91E63",
            var s when s?.Contains("training") == true => "9C27B0",
            _ => "607D8B"
        };
    }
    
    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null && updateDto != null)
        {
            if (file.Size > 10 * 1024 * 1024)
            {
                Snackbar.Add("File size must be less than 10MB", Severity.Error);
                return;
            }
            
            var allowedTypes = new[] { "image/jpeg", "image/png", "image/gif", "image/webp" };
            if (!allowedTypes.Contains(file.ContentType.ToLower()))
            {
                Snackbar.Add("Only image files are allowed", Severity.Error);
                return;
            }
            
            try
            {
                using var stream = file.OpenReadStream(10 * 1024 * 1024);
                var buffer = new byte[file.Size];
                await stream.ReadAsync(buffer, 0, (int)file.Size);
                
                selectedImageUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
                
                // TODO: Upload to server and get FeaturedImageId
                // For now, keep existing image
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error uploading image: {ex.Message}", Severity.Error);
                selectedImageUrl = GeneratePlaceholderImage();
            }
        }
    }
    
    private void RemoveImage()
    {
        selectedImageUrl = GeneratePlaceholderImage();
        if (updateDto != null)
        {
            updateDto.FeaturedImageId = null;
        }
        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        if (updateDto != null)
        {
            try
            {
                // Update dates
                if (_startDate.HasValue && _startTime.HasValue)
                {
                    updateDto.StartDate = (_startDate.Value.Date + _startTime.Value).ToUniversalTime();
                }
                
                if (_endDate.HasValue && _endTime.HasValue)
                {
                    updateDto.EndDate = (_endDate.Value.Date + _endTime.Value).ToUniversalTime();
                }

                // Handle online/offline logic
                if (_isOnline)
                {
                    updateDto.Address = null;
                    updateDto.City = null;
                    updateDto.Country = null;
                    updateDto.PostCode = null;
                }
                else
                {
                    // If switching to offline, clear URL if desired, or keep it as optional
                    // updateDto.ProgramUrl = null; 
                }

                var success = await EventService.UpdateEventAsync(EventId, updateDto);
                
                if (success)
                {
                    Snackbar.Add("Event updated successfully!", Severity.Success);
                    Navigation.NavigateTo("/myevents");
                }
                else
                {
                    Snackbar.Add("Failed to update event", Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error updating event: {ex.Message}", Severity.Error);
            }
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/myevents");
    }

    private void OnImageKeyChanged(string? value)
    {
        if (updateDto != null)
        {
            updateDto.ImageKey = value;
        }
    }

    private void OnPreviewUrlChanged(string? value)
    {
        selectedImageUrl = value ?? string.Empty;
    }
}