@using MudBlazor
@using Explore.Blazor.Client.Models
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Components.Event
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Authorization
@using System.IO
@using Blazouter.Services
@using static Explore.Blazor.Client.Components.Event.EventSessionEditor
@using Explore.Blazor.Client.Helpers
@using Explore.Blazor.Client.Components
@attribute [Authorize]
@inject IEventService EventService
@inject IOrganizationService OrganizationService
@inject IAdminService AdminService
@inject ICategoryService CategoryService
@inject ITagService TagService
@inject IImageStorageService ImageStorageService
@inject NavigationManager Navigation
@inject RouterStateService RouterState
@inject ILogger<EventEdit> Logger

<PageTitle>Edit Event</PageTitle>

@if (isLoading)
{
    <div class="d-flex flex-column align-center justify-center py-16">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.body1" Class="mt-4" Color="Color.Secondary">Loading...</MudText>
    </div>
}
else if (currentEvent != null && updateDto != null)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
        <MudCard Elevation="0" Class="rounded-xl border-solid border-1 mud-border-lines-default">
            <MudCardHeader Class="border-b-1 mud-border-lines-default pa-6">
                <CardHeaderContent>
                    <div class="d-flex align-center gap-4">
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                       Color="Color.Secondary"
                                       OnClick="NavigateBack" />
                        <div>
                            <MudText Typo="Typo.h5" Style="font-weight: 700;">Edit Event</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Update event details</MudText>
                        </div>
                    </div>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-6">
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-6 rounded-lg" ShowCloseIcon="true" CloseIconClicked="@(() => _errorMessage = null)">
                        @_errorMessage
                    </MudAlert>
                }

                <EditForm Model="updateDto" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />

                    <MudStack Spacing="6">
                        <!-- Image Display -->
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 700;">Event Image</MudText>
                            <MudPaper Elevation="0" Class="pa-4 bg-surface border-solid border-1 mud-border-lines-default rounded-lg">
                                <ImageUpload @ref="_imageUploadComponent"
                                             @bind-PreviewUrl="_previewImageUrl"
                                             FileDataSelected="OnImageFileDataSelected"
                                             IsProcessing="_isUploadingImage"
                                             Width="100%"
                                             Height="300px"
                                             PlaceholderText="Update event image"
                                             HintText="Upload a new image or keep the existing one (JPG, PNG, GIF, WebP - Max 5MB)" />
                                @if (_isUploadingImage)
                                {
                                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.Center" Class="mt-4">
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Uploading image...</MudText>
                                    </MudStack>
                                }
                                @if (_uploadError != null)
                                {
                                    <MudAlert Severity="Severity.Error" Class="mt-4" ShowCloseIcon="true" CloseIconClicked="@(() => _uploadError = null)">
                                        @_uploadError
                                    </MudAlert>
                                }
                            </MudPaper>
                        </div>

                        <!-- Basic Info -->
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 700;">Basic Information</MudText>
                            <MudGrid Spacing="3">
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="updateDto.Title"
                                                  Label="Event Title"
                                                  Variant="Variant.Outlined"
                                                  Required
                                                  FullWidth />
                                    <ValidationMessage For="@(() => updateDto.Title)" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="updateDto.Subtitle"
                                                  Label="Event Subtitle (Short summary)"
                                                  Variant="Variant.Outlined"
                                                  FullWidth />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="updateDto.Description"
                                                  Label="Event Description"
                                                  Variant="Variant.Outlined"
                                                  Lines="4"
                                                  FullWidth />
                                </MudItem>
                            </MudGrid>
                        </div>

                        <!-- Date and Time -->
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 700;">Date and Time</MudText>
                            <MudPaper Elevation="0" Class="pa-4 bg-surface border-solid border-1 mud-border-lines-default rounded-lg">
                                <MudGrid Spacing="3">
                                    <MudItem xs="12" sm="6">
                                        <MudDatePicker Label="Start Date" @bind-Date="_startDate" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTimePicker Label="Start Time" @bind-Time="_startTime" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudDatePicker Label="End Date" @bind-Date="_endDate" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTimePicker Label="End Time" @bind-Time="_endTime" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" />
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        </div>

                        <!-- Settings -->
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 700;">Settings & Visibility</MudText>
                            <MudPaper Elevation="0" Class="pa-4 bg-surface border-solid border-1 mud-border-lines-default rounded-lg">
                                <MudGrid Spacing="3">
                                    <MudItem xs="12" sm="6">
                                        <MudSelect @bind-Value="updateDto.EventFormatId" Label="Event Format" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Required>
                                            @if (eventFormats != null)
                                            {
                                                @foreach (var format in eventFormats)
                                                {
                                                    <MudSelectItem Value="@format.Id">@format.FullName</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect @bind-Value="updateDto.VisibilityTypeId" Label="Visibility" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Required>
                                            @if (visibilityTypes != null)
                                            {
                                                @foreach (var visibility in visibilityTypes)
                                                {
                                                    <MudSelectItem Value="@visibility.Id">@visibility.FullName</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect T="int?" @bind-Value="selectedMadhabId" Label="Madhab (Optional)" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                                            @if (madhabs != null)
                                            {
                                                @foreach (var madhab in madhabs)
                                                {
                                                    <MudSelectItem T="int?" Value="@((int?)madhab.Id)">@madhab.FullName</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect @bind-Value="updateDto.EventStatusId" Label="Event Status" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" Required>
                                            @if (eventStatuses != null)
                                            {
                                                @foreach (var status in eventStatuses)
                                                {
                                                    <MudSelectItem Value="@status.Id">@status.FullName</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        </div>

                        <!-- Appearance -->
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 700;">Event Appearance</MudText>
                            <MudPaper Elevation="0" Class="pa-4 bg-surface border-solid border-1 mud-border-lines-default rounded-lg">
                                <MudGrid Spacing="3">
                                    <MudItem xs="12" sm="4">
                                        <MudTextField @bind-Value="_appearance.BackgroundColor"
                                                      Label="Background Color"
                                                      Variant="Variant.Outlined"
                                                      Placeholder="#0f172a" />
                                    </MudItem>
                                    <MudItem xs="12" sm="5">
                                        <MudTextField @bind-Value="_appearance.BackgroundMediaUrl"
                                                      Label="Background Media URL (Image/GIF)"
                                                      Variant="Variant.Outlined"
                                                      Placeholder="https://..." />
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudSelect @bind-Value="_appearance.BackgroundEffect"
                                                   Label="Effect"
                                                   Variant="Variant.Outlined"
                                                   AnchorOrigin="Origin.BottomCenter">
                                            <MudSelectItem Value="@("None")">None</MudSelectItem>
                                            <MudSelectItem Value="@("SoftOverlay")">Soft Overlay</MudSelectItem>
                                            <MudSelectItem Value="@("StrongOverlay")">Strong Overlay</MudSelectItem>
                                            <MudSelectItem Value="@("Blur")">Blur Overlay</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        </div>

                        <!-- Categories & Tags -->
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 700;">Categorization</MudText>
                            <MudPaper Elevation="0" Class="pa-4 bg-surface border-solid border-1 mud-border-lines-default rounded-lg">
                                <MudStack Spacing="4">
                                    @if (allCategories != null && allCategories.Any())
                                    {
                                        <MudSelect T="Guid?" MultiSelection="true" @bind-SelectedValues="selectedCategoryIds" Label="Categories" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" MultiSelectionTextFunc="@(new Func<List<string>, string>(GetCategorySelectionText))">
                                            @foreach (var category in allCategories)
                                            {
                                                <MudSelectItem T="Guid?" Value="@category.Id">@category.FullName</MudSelectItem>
                                            }
                                        </MudSelect>
                                    }
                                    @if (allTags != null && allTags.Any())
                                    {
                                        <MudSelect T="Guid?" MultiSelection="true" @bind-SelectedValues="selectedTagIds" Label="Tags" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter" MultiSelectionTextFunc="@(new Func<List<string>, string>(GetTagSelectionText))">
                                            @foreach (var tag in allTags)
                                            {
                                                <MudSelectItem T="Guid?" Value="@tag.Id">@tag.FullName</MudSelectItem>
                                            }
                                        </MudSelect>
                                    }
                                </MudStack>
                            </MudPaper>
                        </div>

                        <!-- Actions -->
                        <div class="d-flex justify-end gap-3 pt-4 border-t-1 mud-border-lines-default">
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="NavigateBack" Class="rounded-pill">Cancel</MudButton>
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Class="rounded-pill px-6">Save Changes</MudButton>
                        </div>
                    </MudStack>
                </EditForm>
            </MudCardContent>
        </MudCard>
    </MudContainer>
}
else
{
    <MudContainer Class="py-8">
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">Event not found.</MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/myevents" Class="mt-4">Back to My Events</MudButton>
    </MudContainer>
}

@code {
    private Guid EventId { get; set; }

    private EventDto? currentEvent;
    private UpdateEventDto? updateDto;
    private DateTime? _startDate;
    private TimeSpan? _startTime;
    private DateTime? _endDate;
    private TimeSpan? _endTime;
    private bool _isOnline = false;
    private string selectedImageUrl = string.Empty;
    private bool isLoading = true;
    private ICollection<EventTypeListDto>? eventTypes;
    private ICollection<EventFormatListDto>? eventFormats;
    private ICollection<EventStatusListDto>? eventStatuses;
    private ICollection<VisibilityTypeListDto>? visibilityTypes;
    private ICollection<MadhabListDto>? madhabs;
    private ICollection<CategoryListDto>? allCategories;
    private ICollection<TagListDto>? allTags;

    // Nullable Event properties
    private int? selectedMadhabId;
    private string? selectedTimezone;

    // Categories and Tags
    private IEnumerable<Guid?> selectedCategoryIds = new HashSet<Guid?>();
    private IEnumerable<Guid?> selectedTagIds = new HashSet<Guid?>();
    private ICollection<object>? existingCategoriesRaw;
    private ICollection<object>? existingTagsRaw;

    // Sessions
    private List<SessionEditorModel> sessions = new();
    private EventAppearanceSettings _appearance = new();

    // Image upload state
    private FileUploadData? _selectedFileData;
    private string? _previewImageUrl;
    private bool _isUploadingImage = false;
    private Guid? _uploadedStorageObjectId;
    private ImageUpload? _imageUploadComponent;
    private string? _uploadError;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var eventIdStr = RouterState.GetParam("eventId");
        if (Guid.TryParse(eventIdStr, out var id))
        {
            EventId = id;
        }

        try
        {
            isLoading = true;

            var eventTypesTask = AdminService.GetEventTypesAsync();
            var eventFormatsTask = AdminService.GetEventFormatsAsync();
            var eventStatusesTask = AdminService.GetEventStatusesAsync();
            var visibilityTypesTask = AdminService.GetVisibilityTypesAsync();
            var madhabsTask = AdminService.GetMadhabsAsync();

            await Task.WhenAll(eventTypesTask, eventFormatsTask, eventStatusesTask, visibilityTypesTask, madhabsTask);

            eventTypes = await eventTypesTask;
            eventFormats = await eventFormatsTask;
            eventStatuses = await eventStatusesTask;
            visibilityTypes = await visibilityTypesTask;
            madhabs = await madhabsTask;

            currentEvent = await EventService.GetEventByIdAsync(EventId);

            if (currentEvent != null)
            {
                updateDto = new UpdateEventDto
                {
                    Id = currentEvent.Id,
                    Title = currentEvent.Title,
                    Subtitle = currentEvent.Subtitle,
                    Description = currentEvent.Description,
                    AudienceGenderId = currentEvent.AudienceGenderId,
                    AudienceAgeId = currentEvent.AudienceAgeId,
                    ActorId = currentEvent.ActorId,
                    Price = currentEvent.Price,
                    CurrencyCode = currentEvent.CurrencyCode,
                    FeaturedImageId = currentEvent.FeaturedImageId,
                    IsRegistrationRequired = currentEvent.IsRegistrationRequired,
                    ExternalRegistrationUrl = currentEvent.EventUrl,
                    EventTypeId = currentEvent.EventTypeId,
                    EventFormatId = currentEvent.EventFormatId,
                    EventStatusId = currentEvent.EventStatusId,
                    VisibilityTypeId = currentEvent.VisibilityTypeId,
                    FirstSessionDate = currentEvent.FirstSessionDate,
                    LastSessionDate = currentEvent.LastSessionDate,
                    MetadataJson = currentEvent.MetadataJson
                };
                _appearance = EventAppearanceMetadataHelper.Parse(currentEvent.MetadataJson);

                if (currentEvent.FirstSessionDate.HasValue)
                {
                    var localStart = currentEvent.FirstSessionDate.Value.LocalDateTime;
                    _startDate = localStart.Date;
                    _startTime = localStart.TimeOfDay;
                }

                if (currentEvent.LastSessionDate.HasValue)
                {
                    var localEnd = currentEvent.LastSessionDate.Value.LocalDateTime;
                    _endDate = localEnd.Date;
                    _endTime = localEnd.TimeOfDay;
                }

                _isOnline = currentEvent.EventFormatId == 2;
                _previewImageUrl = currentEvent.FeaturedImageUri ?? GeneratePlaceholderImage();
                selectedMadhabId = currentEvent.MadhabId;
                selectedTimezone = currentEvent.Timezone;

                var allCategoriesTask = CategoryService.GetAllCategoriesAsync();
                var allTagsTask = TagService.GetAllTagsAsync();
                var eventCategoriesTask = CategoryService.GetCategoriesByEventAsync(EventId);
                var eventTagsTask = TagService.GetTagsByEventAsync(EventId);
                var sessionsTask = EventService.GetSessionsByEventAsync(EventId);

                await Task.WhenAll(allCategoriesTask, allTagsTask, eventCategoriesTask, eventTagsTask, sessionsTask);

                allCategories = await allCategoriesTask;
                allTags = await allTagsTask;
                existingCategoriesRaw = await eventCategoriesTask;
                existingTagsRaw = await eventTagsTask;
                var eventSessions = await sessionsTask;

                selectedCategoryIds = new HashSet<Guid?>();
                selectedTagIds = new HashSet<Guid?>();

                sessions = eventSessions?.Select(s => SessionEditorModel.FromDto(s)).ToList() ?? new List<SessionEditorModel>();
            }
            else
            {
                _errorMessage = "Event not found";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error loading event: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GeneratePlaceholderImage()
    {
        if (currentEvent == null) return string.Empty;
        var eventTitle = Uri.EscapeDataString(currentEvent.Title ?? "Event");
        return $"https://via.placeholder.com/400x250/607D8B/ffffff?text={eventTitle}";
    }

    private async Task HandleValidSubmit()
    {
        if (updateDto == null) return;

        if (_isUploadingImage)
        {
            _errorMessage = "Please wait for the image upload to complete.";
            return;
        }

        try
        {
            updateDto.FirstSessionDate = DateTimeHelper.CombineDateTimeToUtc(_startDate, _startTime);
            updateDto.LastSessionDate = DateTimeHelper.CombineDateTimeToUtc(_endDate, _endTime);

            if (_uploadedStorageObjectId.HasValue)
            {
                updateDto.FeaturedImageId = _uploadedStorageObjectId.Value;
            }

            updateDto.MetadataJson = EventAppearanceMetadataHelper.Upsert(updateDto.MetadataJson, _appearance);

            if (!updateDto.Id.HasValue)
            {
                _errorMessage = "Event ID is missing";
                return;
            }
            var response = await EventService.UpdateEventAsync(updateDto.Id.Value, updateDto);

            if (response?.Success == true)
            {
                Navigation.NavigateTo("/myevents");
            }
            else
            {
                _errorMessage = response?.Message ?? "Failed to update event";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error updating event");
            _errorMessage = $"Error updating event: {ex.Message}";
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/myevents");
    }

    private async Task OnImageFileDataSelected(FileUploadData? fileData)
    {
        _selectedFileData = fileData;
        _uploadError = null;

        if (fileData == null)
        {
            return;
        }

        _isUploadingImage = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var uploadResult = await ImageStorageService.UploadAndCreateRecordFromBytesAsync(fileData);

            if (uploadResult?.Success == true)
            {
                _uploadedStorageObjectId = uploadResult.StorageObjectId;
                _uploadError = null;
            }
            else
            {
                _uploadError = uploadResult?.ErrorMessage ?? "Failed to upload image.";
                await ClearUploadState();
            }
        }
        catch (Exception ex)
        {
            _uploadError = $"Upload error: {ex.Message}";
            await ClearUploadState();
        }
        finally
        {
            _isUploadingImage = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ClearUploadState()
    {
        try
        {
            if (_imageUploadComponent != null)
            {
                await _imageUploadComponent.RemoveImage();
            }
        }
        catch { }

        _selectedFileData = null;
        if (currentEvent != null && !string.IsNullOrEmpty(currentEvent.FeaturedImageUri))
        {
            _previewImageUrl = currentEvent.FeaturedImageUri;
        }
        else
        {
            _previewImageUrl = GeneratePlaceholderImage();
        }
    }

    private void AddSession()
    {
        sessions.Add(new SessionEditorModel
        {
            StartTime = _startDate?.Date.Add(_startTime ?? TimeSpan.Zero) ?? DateTime.Today.AddHours(9),
            EndTime = _endDate?.Date.Add(_endTime ?? TimeSpan.Zero) ?? DateTime.Today.AddHours(17)
        });
    }

    private void RemoveSession(int index)
    {
        if (sessions.Count > 0 && index >= 0 && index < sessions.Count)
        {
            sessions.RemoveAt(index);
        }
    }

    private void OnSessionChanged(int index, SessionEditorModel session)
    {
        if (index >= 0 && index < sessions.Count)
        {
            sessions[index] = session;
        }
    }

    private string GetCategorySelectionText(List<string> selectedValues)
    {
        if (selectedValues == null || !selectedValues.Any()) return "Select categories";
        return $"{selectedValues.Count} categor{(selectedValues.Count == 1 ? "y" : "ies")} selected";
    }

    private string GetTagSelectionText(List<string> selectedValues)
    {
        if (selectedValues == null || !selectedValues.Any()) return "Select tags";
        return $"{selectedValues.Count} tag{(selectedValues.Count == 1 ? "" : "s")} selected";
    }
}
