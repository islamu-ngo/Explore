@page "/eventedit/{eventId:guid}"
@using MudBlazor
@using Explore.Blazor.Client.Models
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using System.IO
@inject IEventService EventService
@inject IOrganizationService OrganizationService
@inject IAdminService AdminService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Edit Event</PageTitle>

@if (isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; min-height: 400px;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (currentEvent != null && updateDto != null)
{
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <MudCard Class="pa-6" Style="max-width: 800px; margin: 0 auto;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <div class="d-flex align-items-center">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" 
                                         Color="Color.Primary" 
                                         OnClick="NavigateBack" 
                                         Class="me-3" />
                            <MudText Typo="Typo.h5">Edit Event</MudText>
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <EditForm Model="updateDto" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        
                        <!-- Image Display -->
                        <div class="mb-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Event Image</MudText>
                            <MudPaper Class="pa-4" Style="background-color: var(--mud-palette-background-grey);">
                                <ImageUpload ImageKey="@updateDto.ImageKey"
                                             ImageKeyChanged="@((value) => updateDto.ImageKey = value)"
                                             PreviewUrl="@_previewImageUrl"
                                             PreviewUrlChanged="@((value) => _previewImageUrl = value)"
                                            Width="100%"
                                            Height="300px"
                                            PlaceholderText="Update event image"
                                            HintText="Upload a new image or keep the existing one (JPG, PNG, GIF, WebP - Max 5MB)" />
                            </MudPaper>
                        </div>

                        <!-- Event Title -->
                        <div class="mb-3">
                            <MudTextField @bind-Value="updateDto.Title" 
                                        Label="Event Title" 
                                        Variant="Variant.Outlined" 
                                        Required
                                        FullWidth />
                            <ValidationMessage For="@(() => updateDto.Title)" />
                        </div>

                        <!-- Event Description -->
                        <div class="mb-3">
                            <MudTextField @bind-Value="updateDto.Description" 
                                        Label="Event Description" 
                                        Variant="Variant.Outlined" 
                                        Lines="4"
                                        FullWidth />
                        </div>

                        <!-- Date and Time -->
                        <MudText Typo="Typo.h6" Class="mb-3">Date and Time</MudText>
                        <MudPaper Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                            <MudGrid Spacing="3">
                                <MudItem xs="12" sm="6">
                                    <MudDatePicker Label="Start Date" @bind-Date="_startDate" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTimePicker Label="Start Time" @bind-Time="_startTime" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudDatePicker Label="End Date" @bind-Date="_endDate" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTimePicker Label="End Time" @bind-Time="_endTime" Variant="Variant.Outlined" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <!-- Event Format -->
                        <MudText Typo="Typo.h6" Class="mb-3">Event Format</MudText>
                        <MudPaper Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                            <MudSelect @bind-Value="updateDto.EventFormatId"
                                      Label="Event Format"
                                      Variant="Variant.Outlined"
                                      Required>
                                <MudSelectItem Value="1">In-Person</MudSelectItem>
                                <MudSelectItem Value="2">Online</MudSelectItem>
                                <MudSelectItem Value="3">Hybrid</MudSelectItem>
                            </MudSelect>
                            
                            @if (updateDto?.EventFormatId == 2 || updateDto?.EventFormatId == 3)
                            {
                                <MudTextField @bind-Value="updateDto.ExternalRegistrationUrl" 
                                            Label="Online Meeting/Registration Link" 
                                            Variant="Variant.Outlined" 
                                            FullWidth 
                                            Class="mt-3"
                                            Adornment="Adornment.Start"
                                            AdornmentIcon="@Icons.Material.Filled.Link" />
                            }

                            <MudAlert Severity="Severity.Info" Class="mt-3">
                                Location details are managed at the session level after creating the event.
                            </MudAlert>
                        </MudPaper>

                        <!-- Price -->
                        <MudText Typo="Typo.h6" Class="mb-3">Pricing</MudText>
                        <MudPaper Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                            <MudGrid Spacing="3">
                                <MudItem xs="12" sm="6">
                                    <MudNumericField @bind-Value="updateDto.Price" 
                                                   Label="Price" 
                                                   Variant="Variant.Outlined" 
                                                   FullWidth
                                                   Min="0"
                                                   Adornment="Adornment.Start"
                                                   AdornmentIcon="@Icons.Material.Filled.Euro" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="updateDto.CurrencyCode" 
                                                 Label="Currency Code" 
                                                 Variant="Variant.Outlined"
                                                 FullWidth
                                                 Placeholder="EUR" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <!-- Event Type -->
                        <div class="mb-3">
                            <MudSelect @bind-Value="updateDto.EventTypeId" 
                                       Label="Event Type" 
                                       Variant="Variant.Outlined" 
                                       FullWidth
                                       Required
                                       Adornment="Adornment.Start"
                                       AdornmentIcon="@Icons.Material.Filled.Category">
                                @if (eventTypes != null)
                                {
                                    @foreach (var eventType in eventTypes)
                                    {
                                        <MudSelectItem Value="@eventType.Id">@eventType.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </div>

                        <!-- Read-only Organization -->
                        <MudAlert Severity="Severity.Info" Class="mb-3">
                            <MudText Typo="Typo.body2">
                                <strong>Organizer:</strong> @(currentEvent.ActorDisplayName ?? "Unknown")<br/>
                                <MudText Typo="Typo.caption">To change organization, please contact support.</MudText>
                            </MudText>
                        </MudAlert>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between mt-4">
                            <MudButton Variant="Variant.Outlined" 
                                     Color="Color.Secondary" 
                                     OnClick="NavigateBack">
                                Cancel
                            </MudButton>
                            <MudButton ButtonType="ButtonType.Submit" 
                                     Variant="Variant.Filled" 
                                     Color="Color.Primary"
                                     StartIcon="@Icons.Material.Filled.Save">
                                Save Changes
                            </MudButton>
                        </div>
                    </EditForm>
                </MudCardContent>
            </MudCard>
        </div>
    </div>
</div>
}
else
{
    <MudAlert Severity="Severity.Error">Event not found.</MudAlert>
}

@code {
    [Parameter] public Guid EventId { get; set; }
    
    private EventDto? currentEvent;
    private UpdateEventDto? updateDto;
    private DateTime? _startDate;
    private TimeSpan? _startTime;
    private DateTime? _endDate;
    private TimeSpan? _endTime;
    private bool _isOnline = false;
    private string selectedImageUrl = string.Empty;
    private bool isLoading = true;
    private ICollection<EventTypeListDto>? eventTypes;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            
            // Load event types
            eventTypes = await AdminService.GetEventTypesAsync();
            
            currentEvent = await EventService.GetEventByIdAsync(EventId);
            
            if (currentEvent != null)
            {
                // Initialize updateDto from currentEvent
                updateDto = new UpdateEventDto
                {
                    Id = currentEvent.Id,
                    Title = currentEvent.Title,
                    Description = currentEvent.Description,
                    AudienceGenderId = currentEvent.AudienceGenderId,
                    AudienceAgeId = currentEvent.AudienceAgeId,
                    Price = currentEvent.Price,
                    CurrencyCode = currentEvent.CurrencyCode,
                    FeaturedImageId = currentEvent.FeaturedImageId,
                    IsRegistrationRequired = currentEvent.IsRegistrationRequired,
                    ExternalRegistrationUrl = currentEvent.EventUrl,
                    EventTypeId = currentEvent.EventTypeId,
                    EventFormatId = currentEvent.EventFormatId,
                    EventStatusId = currentEvent.EventStatusId,
                    VisibilityTypeId = currentEvent.VisibilityTypeId,
                    FirstSessionDate = currentEvent.FirstSessionDate,
                    LastSessionDate = currentEvent.LastSessionDate
                };
                
                // Initialize date/time pickers
                if (currentEvent.FirstSessionDate.HasValue)
                {
                    var localStart = currentEvent.FirstSessionDate.Value.LocalDateTime;
                    _startDate = localStart.Date;
                    _startTime = localStart.TimeOfDay;
                }
                
                if (currentEvent.LastSessionDate.HasValue)
                {
                    var localEnd = currentEvent.LastSessionDate.Value.LocalDateTime;
                    _endDate = localEnd.Date;
                    _endTime = localEnd.TimeOfDay;
                }
                
                // Determine if online based on format
                _isOnline = currentEvent.EventFormatId == 2; // Assuming 2 = Online
                
                selectedImageUrl = currentEvent.FeaturedImageUri ?? GeneratePlaceholderImage();
            }
            else
            {
                Snackbar.Add("Event not found", Severity.Error);
                Navigation.NavigateTo("/myevents");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading event: {ex.Message}", Severity.Error);
            Navigation.NavigateTo("/myevents");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetEventType(bool isOnline)
    {
        if (updateDto != null)
        {
            // For now, we don't have IsOnline in UpdateEventDto
            // This would require backend updates
            StateHasChanged();
        }
    }

    private string GeneratePlaceholderImage()
    {
        if (currentEvent == null) return string.Empty;
        
        var eventTitle = Uri.EscapeDataString(currentEvent.Title ?? "Event");
        var backgroundColor = GetCategoryColor();
        return $"https://via.placeholder.com/400x250/{backgroundColor}/ffffff?text={eventTitle}";
    }
    
    private string GetCategoryColor()
    {
        return currentEvent?.EventTypeFullName?.ToLower() switch
        {
            var s when s?.Contains("conference") == true => "2196F3",
            var s when s?.Contains("workshop") == true => "FF9800",
            var s when s?.Contains("webinar") == true => "4CAF50",
            var s when s?.Contains("seminar") == true => "E91E63",
            var s when s?.Contains("training") == true => "9C27B0",
            _ => "607D8B"
        };
    }
    
    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null && updateDto != null)
        {
            if (file.Size > 10 * 1024 * 1024)
            {
                Snackbar.Add("File size must be less than 10MB", Severity.Error);
                return;
            }
            
            var allowedTypes = new[] { "image/jpeg", "image/png", "image/gif", "image/webp" };
            if (!allowedTypes.Contains(file.ContentType.ToLower()))
            {
                Snackbar.Add("Only image files are allowed", Severity.Error);
                return;
            }
            
            try
            {
                using var stream = file.OpenReadStream(10 * 1024 * 1024);
                var buffer = new byte[file.Size];
                await stream.ReadAsync(buffer, 0, (int)file.Size);
                
                selectedImageUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";
                
                // TODO: Upload to server and get FeaturedImageId
                // For now, keep existing image
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error uploading image: {ex.Message}", Severity.Error);
            }
        }
    }
    
    private async Task HandleValidSubmit()
    {
        if (updateDto == null) return;
        
        try
        {
            // Update dates
            if (_startDate.HasValue && _startTime.HasValue)
            {
                updateDto.FirstSessionDate = new DateTimeOffset(_startDate.Value.Date + _startTime.Value, TimeSpan.Zero);
            }
            
            if (_endDate.HasValue && _endTime.HasValue)
            {
                updateDto.LastSessionDate = new DateTimeOffset(_endDate.Value.Date + _endTime.Value, TimeSpan.Zero);
            }
            
            var response = await EventService.UpdateEventAsync(updateDto.Id, updateDto);
            
            if (response?.Success == true)
            {
                Snackbar.Add("Event updated successfully!", Severity.Success);
                Navigation.NavigateTo("/myevents");
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Failed to update event", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating event: {ex.Message}", Severity.Error);
        }
    }
    
    private void NavigateBack()
    {
        Navigation.NavigateTo("/myevents");
    }
}

