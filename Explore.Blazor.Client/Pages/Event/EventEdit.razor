@using MudBlazor
@using Explore.Blazor.Client.Models
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Components.Event
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using System.IO
@using Blazouter.Services
@using static Explore.Blazor.Client.Components.Event.EventSessionEditor
@using Explore.Blazor.Client.Helpers
@using Explore.Blazor.Client.Components
@inject IEventService EventService
@inject IOrganizationService OrganizationService
@inject IAdminService AdminService
@inject ICategoryService CategoryService
@inject ITagService TagService
@inject IImageStorageService ImageStorageService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject RouterStateService RouterState
@inject ILogger<EventEdit> Logger

<PageTitle>Edit Event</PageTitle>

@if (isLoading)
{
    <div style="display: flex; justify-content: center; align-items: center; min-height: 400px;">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (currentEvent != null && updateDto != null)
{
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <MudCard Class="pa-6" Style="max-width: 800px; margin: 0 auto;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <div class="d-flex align-items-center">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                         Color="Color.Primary"
                                         OnClick="NavigateBack"
                                         Class="me-3" />
                            <MudText Typo="Typo.h5">Edit Event</MudText>
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <EditForm Model="updateDto" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />

                        <!-- Image Display -->
                        <div class="mb-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Event Image</MudText>
                            <MudPaper Class="pa-4" Style="background-color: var(--mud-palette-background-grey);">
                                <ImageUpload @ref="_imageUploadComponent"
                                             @bind-PreviewUrl="_previewImageUrl"
                                             FileDataSelected="OnImageFileDataSelected"
                                             IsProcessing="_isUploadingImage"
                                             Width="100%"
                                             Height="300px"
                                             PlaceholderText="Update event image"
                                             HintText="Upload a new image or keep the existing one (JPG, PNG, GIF, WebP - Max 5MB)" />
                                @if (_isUploadingImage)
                                {
                                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">Uploading image...</MudText>
                                }
                                @if (_uploadError != null)
                                {
                                    <MudAlert Severity="Severity.Error" Class="mt-2" ShowCloseIcon="true" CloseIconClicked="@(() => _uploadError = null)">
                                        @_uploadError
                                    </MudAlert>
                                }
                            </MudPaper>
                        </div>

                        <!-- Event Title -->
                        <div class="mb-3">
                            <MudTextField @bind-Value="updateDto.Title"
                                        Label="Event Title"
                                        Variant="Variant.Outlined"
                                        Required
                                        FullWidth />
                            <ValidationMessage For="@(() => updateDto.Title)" />
                        </div>

                        <!-- Event Description -->
                        <div class="mb-3">
                            <MudTextField @bind-Value="updateDto.Description"
                                        Label="Event Description"
                                        Variant="Variant.Outlined"
                                        Lines="4"
                                        FullWidth />
                        </div>

                        <!-- Date and Time -->
                        <MudText Typo="Typo.h6" Class="mb-3">Date and Time</MudText>
                        <MudPaper Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                            <MudGrid Spacing="3">
                                <MudItem xs="12" sm="6">
                                    <MudDatePicker Label="Start Date" @bind-Date="_startDate" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTimePicker Label="Start Time" @bind-Time="_startTime" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudDatePicker Label="End Date" @bind-Date="_endDate" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTimePicker Label="End Time" @bind-Time="_endTime" Variant="Variant.Outlined" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <!-- Event Format -->
                        <MudText Typo="Typo.h6" Class="mb-3">Event Format</MudText>
                        <MudPaper Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                            <MudSelect @bind-Value="updateDto.EventFormatId"
                                      Label="Event Format"
                                      Variant="Variant.Outlined"
                                      Required>
                                @if (eventFormats != null)
                                {
                                    @foreach (var format in eventFormats)
                                    {
                                        <MudSelectItem Value="@format.Id">@format.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>


                            <MudAlert Severity="Severity.Info" Class="mt-3">
                                Location details are managed at the session level after creating the event.
                            </MudAlert>
                        </MudPaper>

                        <!-- Visibility & Madhab -->
                        <MudText Typo="Typo.h6" Class="mb-3">Visibility & Religious Settings</MudText>
                        <MudPaper Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                            <MudGrid Spacing="3">
                                <MudItem xs="12" sm="6">
                                    <MudSelect @bind-Value="updateDto.VisibilityTypeId"
                                              Label="Visibility"
                                              Variant="Variant.Outlined"
                                              FullWidth
                                              Required>
                                        @if (visibilityTypes != null)
                                        {
                                            @foreach (var visibility in visibilityTypes)
                                            {
                                                <MudSelectItem Value="@visibility.Id">@visibility.FullName</MudSelectItem>
                                            }
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="int?"
                                              @bind-Value="selectedMadhabId"
                                              Label="Madhab (Optional)"
                                              Variant="Variant.Outlined"
                                              FullWidth
                                              Clearable="true">
                                        @if (madhabs != null)
                                        {
                                            @foreach (var madhab in madhabs)
                                            {
                                                <MudSelectItem T="int?" Value="@((int?)madhab.Id)">@madhab.FullName</MudSelectItem>
                                            }
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudSelect @bind-Value="updateDto.EventStatusId"
                                              Label="Event Status"
                                              Variant="Variant.Outlined"
                                              FullWidth
                                              Required>
                                        @if (eventStatuses != null)
                                        {
                                            @foreach (var status in eventStatuses)
                                            {
                                                <MudSelectItem Value="@status.Id">@status.FullName</MudSelectItem>
                                            }
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="selectedTimezone"
                                                 Label="Timezone (Optional)"
                                                 Variant="Variant.Outlined"
                                                 FullWidth
                                                 Placeholder="e.g., Europe/Paris, America/New_York"
                                                 HelperText="Enter IANA timezone identifier" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <!-- Price -->
                        <MudText Typo="Typo.h6" Class="mb-3">Pricing</MudText>
                        <MudPaper Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                            <MudGrid Spacing="3">
                                <MudItem xs="12" sm="6">
                                    <MudNumericField @bind-Value="updateDto.Price"
                                                   Label="Price"
                                                   Variant="Variant.Outlined"
                                                   FullWidth
                                                   Min="0"
                                                   Adornment="Adornment.Start"
                                                   AdornmentIcon="@Icons.Material.Filled.Euro" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudTextField @bind-Value="updateDto.CurrencyCode"
                                                 Label="Currency Code"
                                                 Variant="Variant.Outlined"
                                                 FullWidth
                                                 Placeholder="EUR" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <!-- Event Type -->
                        <div class="mb-3">
                            <MudSelect @bind-Value="updateDto.EventTypeId"
                                       Label="Event Type"
                                       Variant="Variant.Outlined"
                                       FullWidth
                                       Required
                                       Adornment="Adornment.Start"
                                       AdornmentIcon="@Icons.Material.Filled.Category">
                                @if (eventTypes != null)
                                {
                                    @foreach (var eventType in eventTypes)
                                    {
                                        <MudSelectItem Value="@eventType.Id">@eventType.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </div>

                        <!-- Read-only Organization -->
                        <MudAlert Severity="Severity.Info" Class="mb-3">
                            <MudText Typo="Typo.body2">
                                <strong>Organizer:</strong> @(currentEvent.ActorDisplayName ?? "Unknown")<br/>
                                <MudText Typo="Typo.caption">To change organization, please contact support.</MudText>
                            </MudText>
                        </MudAlert>

                        <!-- Categories -->
                        <MudText Typo="Typo.h6" Class="mb-3">Categories</MudText>
                        <MudPaper Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                            @if (allCategories != null && allCategories.Any())
                            {
                                <MudSelect T="Guid"
                                           MultiSelection="true"
                                           @bind-SelectedValues="selectedCategoryIds"
                                           Label="Select Categories"
                                           Variant="Variant.Outlined"
                                           FullWidth
                                           MultiSelectionTextFunc="@(new Func<List<string>, string>(GetCategorySelectionText))">
                                    @foreach (var category in allCategories)
                                    {
                                        <MudSelectItem Value="@category.Id">@category.FullName</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No categories available</MudText>
                            }
                        </MudPaper>

                        <!-- Tags -->
                        <MudText Typo="Typo.h6" Class="mb-3">Tags</MudText>
                        <MudPaper Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                            @if (allTags != null && allTags.Any())
                            {
                                <MudSelect T="Guid"
                                           MultiSelection="true"
                                           @bind-SelectedValues="selectedTagIds"
                                           Label="Select Tags"
                                           Variant="Variant.Outlined"
                                           FullWidth
                                           MultiSelectionTextFunc="@(new Func<List<string>, string>(GetTagSelectionText))">
                                    @foreach (var tag in allTags)
                                    {
                                        <MudSelectItem Value="@tag.Id">@tag.FullName</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No tags available</MudText>
                            }
                        </MudPaper>

                        <!-- Sessions Management -->
                        <MudText Typo="Typo.h6" Class="mb-3">Sessions</MudText>
                        <MudPaper Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                            @if (sessions.Count == 0)
                            {
                                <MudAlert Severity="Severity.Info" Class="mb-3">
                                    No sessions. Sessions can be managed from the event detail page.
                                </MudAlert>
                            }
                            else
                            {
                                @for (int i = 0; i < sessions.Count; i++)
                                {
                                    var index = i;
                                    <EventSessionEditor Session="sessions[index]"
                                                        SessionChanged="@((s) => OnSessionChanged(index, s))"
                                                        Index="index"
                                                        ShowRemoveButton="@(sessions.Count > 1)"
                                                        OnRemove="@(() => RemoveSession(index))" />
                                }
                            }

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="AddSession"
                                       Class="mt-2">
                                Add Session
                            </MudButton>
                        </MudPaper>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between mt-4">
                            <MudButton Variant="Variant.Outlined"
                                     Color="Color.Secondary"
                                     OnClick="NavigateBack">
                                Cancel
                            </MudButton>
                            <MudButton ButtonType="ButtonType.Submit"
                                     Variant="Variant.Filled"
                                     Color="Color.Primary"
                                     StartIcon="@Icons.Material.Filled.Save">
                                Save Changes
                            </MudButton>
                        </div>
                    </EditForm>
                </MudCardContent>
            </MudCard>
        </div>
    </div>
</div>
}
else
{
    <MudAlert Severity="Severity.Error">Event not found.</MudAlert>
}

@code {
    private Guid EventId { get; set; }

    private EventDto? currentEvent;
    private UpdateEventDto? updateDto;
    private DateTime? _startDate;
    private TimeSpan? _startTime;
    private DateTime? _endDate;
    private TimeSpan? _endTime;
    private bool _isOnline = false;
    private string selectedImageUrl = string.Empty;
    private bool isLoading = true;
    private ICollection<EventTypeListDto>? eventTypes;
    private ICollection<EventFormatListDto>? eventFormats;
    private ICollection<EventStatusListDto>? eventStatuses;
    private ICollection<VisibilityTypeListDto>? visibilityTypes;
    private ICollection<MadhabListDto>? madhabs;
    private ICollection<CategoryListDto>? allCategories;
    private ICollection<TagListDto>? allTags;

    // Nullable Event properties
    private int? selectedMadhabId;
    private string? selectedTimezone;

    // Categories and Tags
    private IEnumerable<Guid> selectedCategoryIds = new HashSet<Guid>();
    private IEnumerable<Guid> selectedTagIds = new HashSet<Guid>();
    private ICollection<CategoryListDto>? existingCategories;
    private ICollection<TagListDto>? existingTags;

    // Sessions
    private List<SessionEditorModel> sessions = new();

    // Image upload state
    private FileUploadData? _selectedFileData;
    private string? _previewImageUrl;
    private bool _isUploadingImage = false;
    private Guid? _uploadedStorageObjectId;
    private ImageUpload? _imageUploadComponent;
    private string? _uploadError;

    protected override async Task OnInitializedAsync()
    {
        // Get route parameter from Blazouter
        var eventIdStr = RouterState.GetParam("eventId");
        if (Guid.TryParse(eventIdStr, out var id))
        {
            EventId = id;
        }

        try
        {
            isLoading = true;

            // Load lookups in parallel
            var eventTypesTask = AdminService.GetEventTypesAsync();
            var eventFormatsTask = AdminService.GetEventFormatsAsync();
            var eventStatusesTask = AdminService.GetEventStatusesAsync();
            var visibilityTypesTask = AdminService.GetVisibilityTypesAsync();
            var madhabsTask = AdminService.GetMadhabsAsync();

            await Task.WhenAll(eventTypesTask, eventFormatsTask, eventStatusesTask, visibilityTypesTask, madhabsTask);

            eventTypes = await eventTypesTask;
            eventFormats = await eventFormatsTask;
            eventStatuses = await eventStatusesTask;
            visibilityTypes = await visibilityTypesTask;
            madhabs = await madhabsTask;

            currentEvent = await EventService.GetEventByIdAsync(EventId);

            if (currentEvent != null)
            {
                // Initialize updateDto from currentEvent
                updateDto = new UpdateEventDto
                {
                    Id = currentEvent.Id,
                    Title = currentEvent.Title,
                    Description = currentEvent.Description,
                    AudienceGenderId = currentEvent.AudienceGenderId,
                    AudienceAgeId = currentEvent.AudienceAgeId,
                    Price = currentEvent.Price,
                    CurrencyCode = currentEvent.CurrencyCode,
                    FeaturedImageId = currentEvent.FeaturedImageId,
                    IsRegistrationRequired = currentEvent.IsRegistrationRequired,
                    ExternalRegistrationUrl = currentEvent.EventUrl,
                    EventTypeId = currentEvent.EventTypeId,
                    EventFormatId = currentEvent.EventFormatId,
                    EventStatusId = currentEvent.EventStatusId,
                    VisibilityTypeId = currentEvent.VisibilityTypeId,
                    FirstSessionDate = currentEvent.FirstSessionDate,
                    LastSessionDate = currentEvent.LastSessionDate
                };

                // Initialize date/time pickers
                if (currentEvent.FirstSessionDate.HasValue)
                {
                    var localStart = currentEvent.FirstSessionDate.Value.LocalDateTime;
                    _startDate = localStart.Date;
                    _startTime = localStart.TimeOfDay;
                }

                if (currentEvent.LastSessionDate.HasValue)
                {
                    var localEnd = currentEvent.LastSessionDate.Value.LocalDateTime;
                    _endDate = localEnd.Date;
                    _endTime = localEnd.TimeOfDay;
                }

                // Determine if online based on format
                _isOnline = currentEvent.EventFormatId == 2; // Assuming 2 = Online

                // Set preview to existing featured image if available
                _previewImageUrl = currentEvent.FeaturedImageUri ?? GeneratePlaceholderImage();

                // Set nullable properties
                selectedMadhabId = currentEvent.MadhabId;
                selectedTimezone = currentEvent.Timezone;

                // Load categories and tags in parallel
                var allCategoriesTask = CategoryService.GetAllCategoriesAsync();
                var allTagsTask = TagService.GetAllTagsAsync();
                var eventCategoriesTask = CategoryService.GetCategoriesByEventAsync(EventId);
                var eventTagsTask = TagService.GetTagsByEventAsync(EventId);
                var sessionsTask = EventService.GetSessionsByEventAsync(EventId);

                await Task.WhenAll(allCategoriesTask, allTagsTask, eventCategoriesTask, eventTagsTask, sessionsTask);

                allCategories = await allCategoriesTask;
                allTags = await allTagsTask;
                existingCategories = await eventCategoriesTask;
                existingTags = await eventTagsTask;
                var eventSessions = await sessionsTask;

                // Set selected categories and tags
                selectedCategoryIds = existingCategories?.Select(c => c.Id).ToHashSet() ?? new HashSet<Guid>();
                selectedTagIds = existingTags?.Select(t => t.Id).ToHashSet() ?? new HashSet<Guid>();

                // Convert sessions to editor models
                sessions = eventSessions?.Select(s => SessionEditorModel.FromDto(s)).ToList() ?? new List<SessionEditorModel>();
            }
            else
            {
                Snackbar.Add("Event not found", Severity.Error);
                Navigation.NavigateTo("/myevents");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading event: {ex.Message}", Severity.Error);
            Navigation.NavigateTo("/myevents");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetEventType(bool isOnline)
    {
        if (updateDto != null)
        {
            // For now, we don't have IsOnline in UpdateEventDto
            // This would require backend updates
            StateHasChanged();
        }
    }

    private string GeneratePlaceholderImage()
    {
        if (currentEvent == null) return string.Empty;

        var eventTitle = Uri.EscapeDataString(currentEvent.Title ?? "Event");
        var backgroundColor = GetCategoryColor();
        return $"https://via.placeholder.com/400x250/{backgroundColor}/ffffff?text={eventTitle}";
    }

    private string GetCategoryColor()
    {
        return currentEvent?.EventTypeFullName?.ToLower() switch
        {
            var s when s?.Contains("conference") == true => "2196F3",
            var s when s?.Contains("workshop") == true => "FF9800",
            var s when s?.Contains("webinar") == true => "4CAF50",
            var s when s?.Contains("seminar") == true => "E91E63",
            var s when s?.Contains("training") == true => "9C27B0",
            _ => "607D8B"
        };
    }

    private async Task HandleValidSubmit()
    {
        if (updateDto == null) return;

        // Don't allow submit while image is uploading
        if (_isUploadingImage)
        {
            Snackbar.Add("Please wait for the image upload to complete.", Severity.Warning);
            return;
        }

        try
        {
            // Update dates - use DateTimeHelper for consistent UTC conversion
            updateDto.FirstSessionDate = DateTimeHelper.CombineDateTimeToUtc(_startDate, _startTime);
            updateDto.LastSessionDate = DateTimeHelper.CombineDateTimeToUtc(_endDate, _endTime);

            // If a new image was uploaded and a storage object id exists, update featured image id
            if (_uploadedStorageObjectId.HasValue)
            {
                updateDto.FeaturedImageId = _uploadedStorageObjectId.Value;
            }

            var response = await EventService.UpdateEventAsync(updateDto.Id, updateDto);

            if (response?.Success == true)
            {
                Snackbar.Add("Event updated successfully!", Severity.Success);
                Navigation.NavigateTo("/myevents");
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Failed to update event", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating event: {ex.Message}", Severity.Error);
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/myevents");
    }

    /// <summary>
    /// Handles file selection with FileUploadData (bytes already in memory).
    /// This is the preferred method for reliable uploads in Blazor WASM.
    /// </summary>
    private async Task OnImageFileDataSelected(FileUploadData? fileData)
    {
        Logger.LogInformation("[EventEdit] OnImageFileDataSelected called with fileData={HasData}", fileData != null);

        _selectedFileData = fileData;
        _uploadError = null;

        if (fileData == null)
        {
            // File was removed - keep existing image unless user explicitly removes
            Logger.LogInformation("[EventEdit] Image selection cleared");
            return;
        }

        _isUploadingImage = true;
        Logger.LogInformation("[EventEdit] Setting _isUploadingImage=true, calling StateHasChanged...");
        await InvokeAsync(StateHasChanged);

        try
        {
            Logger.LogInformation("[EventEdit] Starting upload for {FileName} ({Size} bytes)", fileData.FileName, fileData.Size);

            // Upload the image using the bytes-based method (avoids stream issues)
            Logger.LogInformation("[EventEdit] Calling ImageStorageService.UploadAndCreateRecordFromBytesAsync...");
            var uploadResult = await ImageStorageService.UploadAndCreateRecordFromBytesAsync(fileData);
            Logger.LogInformation("[EventEdit] Upload result: Success={Success}, StorageObjectId={Id}, Error={Error}",
                uploadResult?.Success, uploadResult?.StorageObjectId, uploadResult?.ErrorMessage);

            if (uploadResult?.Success == true)
            {
                _uploadedStorageObjectId = uploadResult.StorageObjectId;
                _uploadError = null;
                Logger.LogInformation("[EventEdit] Featured image uploaded successfully. StorageObjectId: {StorageObjectId}", uploadResult.StorageObjectId);
                Snackbar.Add("Image uploaded successfully!", Severity.Success);
            }
            else
            {
                var errorMsg = uploadResult?.ErrorMessage ?? "Failed to upload image. Please try again.";
                Logger.LogWarning("[EventEdit] Image upload failed: {ErrorMessage}", errorMsg);
                _uploadError = errorMsg;
                Snackbar.Add(errorMsg, Severity.Error);

                // Clear the preview and selected file on failure
                await ClearUploadState();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception during image upload for {FileName}", fileData.FileName);
            _uploadError = $"Upload error: {ex.Message}";
            Snackbar.Add("An error occurred while uploading the image", Severity.Error);

            // Clear on error
            await ClearUploadState();
        }
        finally
        {
            _isUploadingImage = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Clears the upload state on error or cancellation.
    /// </summary>
    private async Task ClearUploadState()
    {
        try
        {
            if (_imageUploadComponent != null)
            {
                await _imageUploadComponent.RemoveImage();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error clearing image upload component");
        }

        _selectedFileData = null;
        // Don't clear _uploadedStorageObjectId - keep existing image ID if there was one
        // Only set _previewImageUrl back to existing image
        if (currentEvent != null && !string.IsNullOrEmpty(currentEvent.FeaturedImageUri))
        {
            _previewImageUrl = currentEvent.FeaturedImageUri;
        }
        else
        {
            _previewImageUrl = GeneratePlaceholderImage();
        }
    }

    // Session management methods
    private void AddSession()
    {
        sessions.Add(new SessionEditorModel
        {
            StartTime = _startDate?.Date.Add(_startTime ?? TimeSpan.Zero) ?? DateTime.Today.AddHours(9),
            EndTime = _endDate?.Date.Add(_endTime ?? TimeSpan.Zero) ?? DateTime.Today.AddHours(17)
        });
    }

    private void RemoveSession(int index)
    {
        if (sessions.Count > 0 && index >= 0 && index < sessions.Count)
        {
            sessions.RemoveAt(index);
        }
    }

    private void OnSessionChanged(int index, SessionEditorModel session)
    {
        if (index >= 0 && index < sessions.Count)
        {
            sessions[index] = session;
        }
    }

    // Category/Tag selection text helpers
    private string GetCategorySelectionText(List<string> selectedValues)
    {
        if (selectedValues == null || !selectedValues.Any())
            return "Select categories";

        return $"{selectedValues.Count} categor{(selectedValues.Count == 1 ? "y" : "ies")} selected";
    }

    private string GetTagSelectionText(List<string> selectedValues)
    {
        if (selectedValues == null || !selectedValues.Any())
            return "Select tags";

        return $"{selectedValues.Count} tag{(selectedValues.Count == 1 ? "" : "s")} selected";
    }
}
