@page "/event"
@page "/events"
@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services
@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation
@inject IProgramService ProgramService

<style>
/* ===== TOKENS ===== */
:root{
    --fx-ring: color-mix(in srgb, var(--mud-palette-primary) 30%, transparent);
}

/* ===== WRAPPER ===== */
.page-wrap{ padding-block: 20px 32px; }

/* ===== BAR: filters ===== */
.filters-bar{
    display:grid; gap:12px;
    grid-template-columns: repeat(12, 1fr);
    align-items:stretch;
}
@@media (max-width: 960px){
    .filters-bar{ grid-template-columns: 1fr; }
}

.filter-cell{ grid-column: span 3; }
.filter-cell.search{ grid-column: span 3; }
@@media (max-width: 960px){
    .filter-cell, .filter-cell.search{ grid-column: 1/-1; }
}

/* Pill trigger */
.filter-paper{
    background-color: var(--mud-palette-surface);
    border: 1px solid var(--mud-palette-lines-default);
    border-radius: 999px;
    cursor: pointer;
    transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease, background .12s ease;
    color: var(--mud-palette-text-primary);
    padding-inline: 12px;
}
.filter-paper:hover{
    transform: translateY(-1px);
    background-color: color-mix(in srgb, var(--mud-palette-primary) 6%, var(--mud-palette-surface));
    border-color: var(--mud-palette-primary);
    box-shadow: 0 0 0 3px var(--fx-ring);
}

/* Chevron */
.filter-paper .mud-icon-root{ opacity:.85; }

/* Popover styling */
.filter-popover{
    background-color: var(--mud-palette-surface) !important;
    border: 1px solid var(--mud-palette-lines-default) !important;
    box-shadow: var(--mud-elevation-8) !important;
    border-radius: 12px !important;
}
.filter-popover .mud-text{ color: var(--mud-palette-text-primary) !important; }
.filter-option{
    padding: 6px 10px;
    border-radius: 8px;
    transition: background .12s ease, color .12s ease;
    cursor: pointer;
}
.filter-option:hover{
    background: color-mix(in srgb, var(--mud-palette-primary) 10%, transparent);
}

/* ===== SECTION HEADER ===== */
.section-head{
    display:flex; align-items:flex-end; justify-content:space-between;
    gap:16px; margin-bottom: 16px;
}
.kicker{ letter-spacing:.18em; text-transform:uppercase; font-size:.82rem; opacity:.7; }

/* ===== CARDS ===== */
.card{
    border-radius: 16px;
    overflow:hidden;
    border: 1px solid color-mix(in srgb, var(--mud-palette-lines-default) 70%, transparent);
    transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
}
.card:hover{
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(0,0,0,.16);
    border-color: color-mix(in srgb, var(--mud-palette-primary) 40%, var(--mud-palette-lines-default));
}

/* Media with subtle overlay */
.card-media{
    position: relative; height: 200px; overflow: hidden;
}
.card-media::after{
    content:""; position:absolute; inset:0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(0,0,0,.25) 100%);
}

/* Badges row */
.badges{ display:flex; gap:8px; align-items:center; margin: 10px 0 6px 0;}

/* Location row */
.loc{
    display:flex; align-items:center; gap:6px; opacity:.85;
}

/* ===== PAGINATION & INFO ===== */
.pager{
    display:flex; justify-content:center; margin-top: 24px;
}
.results{
    display:flex; justify-content:center; margin-top: 8px; opacity:.8;
}

/* ===== SEARCH FIELD ===== */
.search-input .mud-input-root{ border-radius: 999px !important; }
.search-input .mud-input:not(.mud-input-disabled):focus-within{
    box-shadow: 0 0 0 3px var(--fx-ring);
    border-color: var(--mud-palette-primary);
}
</style>

<PageTitle>Explore Events</PageTitle>

<MudContainer Class="page-wrap">
    <div class="pa-4">

        <!-- Header -->
        <div class="section-head">
            <div>
                <MudText Typo="Typo.overline" Class="kicker">Discover</MudText>
                <MudText Typo="Typo.h5">Explore Events</MudText>
            </div>
        </div>

        <!-- Filters -->
        <div class="filters-bar mb-4">
            <!-- Date -->
            <div class="filter-cell">
                <MudPopover Open="@isDateOpen" Fixed="true" Class="filter-popover px-4 py-3">
                    <div class="d-flex flex-column gap-3" style="min-width:220px">
                        <MudText Typo="Typo.subtitle2">Date</MudText>
                        <div class="d-flex flex-column gap-1">
                            <MudText Typo="Typo.body2"
                                     Color="@(selectedDate == "" ? Color.Primary : Color.Default)"
                                     Class="filter-option"
                                     @onclick="@(() => OnDateChanged(""))">Any Time</MudText>
                            <MudText Typo="Typo.body2"
                                     Color="@(selectedDate == "today" ? Color.Primary : Color.Default)"
                                     Class="filter-option"
                                     @onclick="@(() => OnDateChanged("today"))">Today</MudText>
                            <MudText Typo="Typo.body2"
                                     Color="@(selectedDate == "tomorrow" ? Color.Primary : Color.Default)"
                                     Class="filter-option"
                                     @onclick="@(() => OnDateChanged("tomorrow"))">Tomorrow</MudText>
                            <MudText Typo="Typo.body2"
                                     Color="@(selectedDate == "thisweek" ? Color.Primary : Color.Default)"
                                     Class="filter-option"
                                     @onclick="@(() => OnDateChanged("thisweek"))">This Week</MudText>
                            <MudText Typo="Typo.body2"
                                     Color="@(selectedDate == "thismonth" ? Color.Primary : Color.Default)"
                                     Class="filter-option"
                                     @onclick="@(() => OnDateChanged("thismonth"))">This Month</MudText>
                        </div>
                    </div>
                </MudPopover>
                <MudPaper @onclick="@(() => isDateOpen = !isDateOpen)"
                          Class="filter-paper d-flex justify-space-between align-center">
                    <MudText Class="ml-2">
                        @(string.IsNullOrEmpty(selectedDate) ? "Any Time" :
                            (selectedDate == "today" ? "Today" :
                            selectedDate == "tomorrow" ? "Tomorrow" :
                            selectedDate == "thisweek" ? "This Week" :
                            selectedDate == "thismonth" ? "This Month" : selectedDate))
                    </MudText>
                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" />
                </MudPaper>
            </div>

            <!-- Category -->
            <div class="filter-cell">
                <MudPopover Open="@isCategoryOpen" Fixed="true" Class="filter-popover px-4 py-3">
                    <div class="d-flex flex-column gap-3" style="min-width:220px">
                        <MudText Typo="Typo.subtitle2">Category</MudText>
                        <div class="d-flex flex-column gap-1">
                            <MudText Typo="Typo.body2"
                                     Color="@(selectedCategory == "" ? Color.Primary : Color.Default)"
                                     Class="filter-option"
                                     @onclick="@(() => OnCategoryChanged(""))">All Categories</MudText>
                            <MudText Typo="Typo.body2"
                                     Color="@(selectedCategory == "lecture" ? Color.Primary : Color.Default)"
                                     Class="filter-option"
                                     @onclick="@(() => OnCategoryChanged("lecture"))">Lecture</MudText>
                            <MudText Typo="Typo.body2"
                                     Color="@(selectedCategory == "workshop" ? Color.Primary : Color.Default)"
                                     Class="filter-option"
                                     @onclick="@(() => OnCategoryChanged("workshop"))">Workshop</MudText>
                            <MudText Typo="Typo.body2"
                                     Color="@(selectedCategory == "social" ? Color.Primary : Color.Default)"
                                     Class="filter-option"
                                     @onclick="@(() => OnCategoryChanged("social"))">Social</MudText>
                            <MudText Typo="Typo.body2"
                                     Color="@(selectedCategory == "charity" ? Color.Primary : Color.Default)"
                                     Class="filter-option"
                                     @onclick="@(() => OnCategoryChanged("charity"))">Charity</MudText>
                        </div>
                    </div>
                </MudPopover>
                <MudPaper @onclick="@(() => isCategoryOpen = !isCategoryOpen)"
                          Class="filter-paper d-flex justify-space-between align-center">
                    <MudText Class="ml-2">
                        @(string.IsNullOrEmpty(selectedCategory) ? "All Categories" : selectedCategory)
                    </MudText>
                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" />
                </MudPaper>
            </div>

            <!-- Search -->
            <div class="filter-cell search">
                <MudTextField @bind-Value="searchText"
                              Class="search-input"
                              Placeholder="Search"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Immediate="true"
                              DebounceInterval="500"
                              TextChanged="OnSearch"
                              Margin="Margin.Dense" />
            </div>
        </div>

        <!-- Cards -->
        <MudGrid>
            @if (isLoading && !allPrograms.Any())
            {
                <!-- Skeleton loaders voor snelle feedback -->
                @for (int i = 0; i < 6; i++)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="0" Class="card">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
                            <MudCardContent>
                                <MudSkeleton Width="60%" Height="20px" Class="mb-2" />
                                <MudSkeleton Width="40%" Height="16px" Class="mb-2" />
                                <MudSkeleton Width="100%" Height="14px" Class="mb-1" />
                                <MudSkeleton Width="100%" Height="14px" Class="mb-1" />
                                <MudSkeleton Width="80%" Height="14px" />
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            }
            else if (!FilteredEvents.Any())
            {
                <MudItem xs="12" Class="d-flex justify-center align-center pa-8">
                    <div class="text-center">
                        <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                        <MudText Typo="Typo.h6" Color="Color.Secondary">No events found</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                            Try adjusting your filters or search query
                        </MudText>
                    </div>
                </MudItem>
            }
            else
            {
                @foreach (var evt in FilteredEvents)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="0" Class="card">
                            <MudCardMedia Class="card-media">
                                @if (!string.IsNullOrEmpty(evt.FeaturedImageUri))
                                {
                                    <img src="@evt.FeaturedImageUri"
                                         alt="@evt.Title"
                                         style="width: 100%; height: 200px; object-fit: cover;" />
                                }
                                else
                                {
                                    <img src="@GetEventImage(evt)" alt="@evt.Title" style="width: 100%; height: 200px; object-fit: cover;" />
                                }
                            </MudCardMedia>
                            <MudCardContent>
                                <div class="badges">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Category">
                                        @GetEventTypeName(evt)
                                    </MudChip>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.LocationOn">
                                        @GetLocationText(evt)
                                    </MudChip>
                                    @if (evt.Price.HasValue && evt.Price > 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.EuroSymbol">
                                            @evt.CurrencyCode @evt.Price.Value.ToString("F2")
                                        </MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                            Free
                                        </MudChip>
                                    }
                                </div>
                                <MudText Typo="Typo.h6" Class="mb-1">@evt.Title</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Surface" Style="opacity:.85; min-height: 40px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.4;">
                                    @GetTruncatedDescription(evt.Description)
                                </MudText>
                                @if (evt.TotalViews > 0)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" /> @evt.TotalViews views
                                    </MudText>
                                }
                            </MudCardContent>
                            <MudCardActions Class="justify-space-between pa-4 pt-0">
                                <MudButton Variant="Variant.Text"
                                           EndIcon="@Icons.Material.Filled.ArrowForward"
                                           Color="Color.Primary"
                                           OnClick="@(() => Navigation.NavigateTo($"/event/detail/{evt.Id}"))">
                                    View Details
                                </MudButton>
                                <div class="loc">
                                    <MudIcon Icon="@Icons.Material.Filled.Business" />
                                    <MudText>@(evt.ActorDisplayName ?? "Community")</MudText>
                                </div>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            }
        </MudGrid>

        <!-- Pagination + info -->
        <div class="pager">
            <MudPagination Count="@TotalPages"
                           Selected="@currentPage"
                           SelectedChanged="@((int page) => OnPageChanged(page))"
                           Color="Color.Primary"
                           ShowFirstButton="true"
                           ShowLastButton="true" />
        </div>
        <div class="results">
            <MudText Typo="Typo.body2" Color="Color.Surface">
                Showing @((currentPage - 1) * itemsPerPage + 1) - @(Math.Min(currentPage * itemsPerPage, AllFilteredEvents.Count)) of @AllFilteredEvents.Count events (Page @currentPage of @TotalPages)
            </MudText>
        </div>

    </div>
</MudContainer>

@code {
    private string searchText = "";
    private string selectedDate = "";
    private string selectedCategory = "";
    private bool isDateOpen;
    private bool isCategoryOpen;
    private bool isLoading = true;
    private bool _dataLoaded = false;

    // Pagination variables
    private int currentPage = 1;
    private int itemsPerPage = 6;

    // API Data
    private ICollection<EventListDto> allPrograms = new List<EventListDto>();
    private ICollection<EventTypeListDto> eventTypes = new List<EventTypeListDto>();
    private ICollection<EventFormatListDto> programTypes = new List<EventFormatListDto>();
    private Dictionary<int, string> eventTypeMap = new();
    private Dictionary<int, string> programTypeMap = new();

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("[EVENT LIST] OnInitializedAsync starting...");
        // Always load data - don't use any caching that can cause issues
        await LoadDataAsync();
    }

    private void BuildLookupMaps()
    {
        eventTypeMap = eventTypes.Any()
            ? eventTypes.ToDictionary(et => et.Id, et => et.FullName)
            : new();
        programTypeMap = programTypes.Any()
            ? programTypes.ToDictionary(pt => pt.Id, pt => pt.FullName)
            : new();
    }

    private async Task LoadDataAsync()
    {
        // Prevent multiple loads
        if (_dataLoaded) return;
        
        isLoading = true;

        try
        {
            Console.WriteLine("[EVENT LIST] Loading data...");
            
            // Parallel loading
            var programsTask = ProgramService.GetAllProgramsAsync();
            var eventTypesTask = ProgramService.GetEventTypesAsync();
            var programTypesTask = ProgramService.GetProgramTypesAsync();

            await Task.WhenAll(programsTask, eventTypesTask, programTypesTask);

            allPrograms = await programsTask;
            eventTypes = await eventTypesTask;
            programTypes = await programTypesTask;

            Console.WriteLine($"[EVENT LIST] Loaded {allPrograms.Count} events, {eventTypes.Count} types, {programTypes.Count} formats");

            BuildLookupMaps();
            _dataLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[EVENT LIST] LoadDataAsync error: {ex.Message}");
            // Keep empty lists on error - don't throw
            allPrograms = new List<EventListDto>();
            eventTypes = new List<EventTypeListDto>();
            programTypes = new List<EventFormatListDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<EventListDto> AllFilteredEvents
    {
        get
        {
            // Cache filtered results
            return allPrograms
                .Where(e => string.IsNullOrEmpty(searchText) ||
                            e.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                            (e.Description?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
                .Where(e => string.IsNullOrEmpty(selectedCategory) ||
                            GetEventTypeName(e).Equals(selectedCategory, StringComparison.OrdinalIgnoreCase))
                .Where(e => e.LastSessionDate == null || e.LastSessionDate >= DateTimeOffset.Now)
                .ToList();
        }
    }

    private List<EventListDto> FilteredEvents
    {
        get
        {
            var allEvents = AllFilteredEvents;
            return allEvents
                .Skip((currentPage - 1) * itemsPerPage)
                .Take(itemsPerPage)
                .ToList();
        }
    }

    private int TotalPages
    {
        get
        {
            var count = AllFilteredEvents.Count;
            return count > 0 ? (int)Math.Ceiling((double)count / itemsPerPage) : 1;
        }
    }

    private void OnSearch(string value)
    {
        searchText = value;
        currentPage = 1;
    }

    private void OnDateChanged(string value)
    {
        selectedDate = value;
        isDateOpen = false;
        currentPage = 1;
    }

    private void OnCategoryChanged(string value)
    {
        selectedCategory = value;
        isCategoryOpen = false;
        currentPage = 1;
    }

    private void OnPageChanged(int page)
    {
        currentPage = page;
    }

    private string GetEventTypeName(EventListDto program)
    {
        // Use the FullName from the DTO directly if available
        if (!string.IsNullOrEmpty(program.EventTypeFullName))
            return program.EventTypeFullName;

        // Fallback to lookup
        return programTypeMap.TryGetValue(program.EventFormatId, out var programTypeName)
            ? programTypeName
            : "Event";
    }

    private string GetLocationText(EventListDto program)
    {
        // EventListDto doesn't have location directly - use format
        if (program.EventFormatId == 1 // Assuming 1 = Online
            ) return "Online";

        return program.EventFormatFullName ?? "Location TBD";
    }

    private string GetEventImage(EventListDto program)
    {
        // Use FeaturedImageUri if available
        if (!string.IsNullOrEmpty(program.FeaturedImageUri))
            return program.FeaturedImageUri;

        // Fallback to placeholder
        var encodedTitle = Uri.EscapeDataString(program.Title.Length > 30
            ? program.Title.Substring(0, 30) + "..."
            : program.Title);
        var color = GetEventColorForProgram(program);
        return $"https://placehold.co/600x400/{color}/ffffff?text={encodedTitle}";
    }

    private string GetEventColorForProgram(EventListDto program)
    {
        // Quick color hash based on event type
        var typeColors = new Dictionary<int, string>
        {
            { 1, "2196F3" }, // Lecture - Blue
            { 2, "FF9800" }, // Workshop - Orange
            { 3, "4CAF50" }, // Social - Green
            { 4, "E91E63" }, // Charity - Pink
            { 5, "9C27B0" }, // Education - Purple
        };

        if (typeColors.TryGetValue(program.EventTypeId, out var color))
            return color;

        // Fallback: hash of title
        var hash = program.Title.GetHashCode();
        var colors = new[] { "2196F3", "FF9800", "4CAF50", "E91E63", "9C27B0", "607D8B" };
        return colors[Math.Abs(hash) % colors.Length];
    }

    private string GetTruncatedDescription(string? description)
    {
        if (string.IsNullOrWhiteSpace(description))
            return "No description available.";

        // Split op zinnen (. ! ?)
        var sentences = System.Text.RegularExpressions.Regex.Split(description, @"(?<=[.!?])\s+");

        // Neem maximaal 2 zinnen
        var result = string.Join(" ", sentences.Take(2));

        // Als er meer dan 2 zinnen zijn, voeg ... toe
        if (sentences.Length > 2)
            result += "...";

        // Extra veiligheid: limiteer tot 150 karakters
        if (result.Length > 150)
            result = result.Substring(0, 147) + "...";

        return result;
    }
}
