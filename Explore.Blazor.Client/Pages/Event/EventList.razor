@page "/events"
@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Components.Event
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Logging

<PageTitle>Explore Events</PageTitle>

<MudContainer Class="py-4 py-sm-8 py-md-12">
    <MudText Typo="Typo.h3" Class="mb-8">Explore Events</MudText>
    
    <!-- Filters -->
    <MudGrid Class="mb-8">
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudSelect T="string" Value="@selectedDate" ValueChanged="@((string d) => OnDateChanged(d))" 
                       Label="Date" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem Value="@("")">Any Time</MudSelectItem>
                <MudSelectItem Value="@("today")">Today</MudSelectItem>
                <MudSelectItem Value="@("tomorrow")">Tomorrow</MudSelectItem>
                <MudSelectItem Value="@("thisweek")">This Week</MudSelectItem>
                <MudSelectItem Value="@("thismonth")">This Month</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudSelect T="Guid?" Value="@selectedCategoryId" ValueChanged="@(async (Guid? c) => await OnCategoryChanged(c))"
                       Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">All Categories</MudSelectItem>
                @foreach (var category in categories)
                {
                    <MudSelectItem T="Guid?" Value="@category.Id">@category.FullName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudSelect T="Guid?" Value="@selectedLocationId" ValueChanged="@((Guid? l) => OnLocationChanged(l))"
                       Label="Location" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">All Locations</MudSelectItem>
                @foreach (var location in locations)
                {
                    <MudSelectItem T="Guid?" Value="@location.Id">@location.FullName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudSelect T="int?" Value="@selectedFormatId" ValueChanged="@((int? f) => OnFormatChanged(f))" 
                       Label="Format" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                <MudSelectItem T="int?" Value="@((int?)null)">All Formats</MudSelectItem>
                @if (eventFormats != null)
                {
                    @foreach (var format in eventFormats)
                    {
                        <MudSelectItem T="int?" Value="@format.Id">@format.FullName</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="3">
             <MudSelect T="int?" Value="@selectedMadhabId" ValueChanged="@((int? m) => OnMadhabChanged(m))" 
                        Label="Madhab" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" 
                        AnchorOrigin="Origin.BottomCenter" Clearable="true">
                 <MudSelectItem T="int?" Value="@((int?)null)">All Madhabs</MudSelectItem>
                 @if (madhabs != null)
                 {
                     @foreach (var madhab in madhabs)
                     {
                         <MudSelectItem T="int?" Value="@madhab.Id">@madhab.FullName</MudSelectItem>
                     }
                 }
             </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudSelect T="int?" Value="@selectedRegistrationModeId" ValueChanged="@((int? r) => OnRegistrationModeChanged(r))" 
                       Label="Registration" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" 
                       AnchorOrigin="Origin.BottomCenter" Clearable="true">
                <MudSelectItem T="int?" Value="@((int?)null)">All Modes</MudSelectItem>
                @if (registrationModes != null)
                {
                    @foreach (var mode in registrationModes)
                    {
                        <MudSelectItem T="int?" Value="@mode.Id">@mode.FullName</MudSelectItem>
                    }
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="3">
             <MudSelect T="int?" Value="@selectedLanguageId" ValueChanged="@((int? l) => OnLanguageChanged(l))" 
                        Label="Language" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" 
                        AnchorOrigin="Origin.BottomCenter" Clearable="true">
                 <MudSelectItem T="int?" Value="@((int?)null)">All Languages</MudSelectItem>
                 @if (languages != null)
                 {
                     @foreach (var language in languages)
                     {
                         <MudSelectItem T="int?" Value="@language.Id">@language.FullName</MudSelectItem>
                     }
                 }
             </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudSelect T="Guid?" Value="@selectedTagId" ValueChanged="@(async (Guid? t) => await OnTagChanged(t))"
                       Label="Tags" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">All Tags</MudSelectItem>
                @foreach (var tag in tags)
                {
                    <MudSelectItem T="Guid?" Value="@tag.Id">@tag.FullName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudGrid>
        @if ((isLoading && !allEvents.Any()) || isLoadingCategory || isLoadingTag)
        {
            @for (int i = 0; i < 6; i++)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard>
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
                        <MudCardContent>
                            <MudSkeleton Width="30%" Height="20px" Class="mb-2" />
                            <MudSkeleton Width="80%" Height="30px" Class="mb-4" />
                            <MudSkeleton Width="100%" Height="20px" />
                            <MudSkeleton Width="100%" Height="20px" />
                        </MudCardContent>
                        <MudCardActions>
                            <MudSkeleton Width="100px" Height="30px" Class="ml-2" />
                            <MudSpacer />
                            <MudSkeleton Width="40px" Height="30px" Class="mr-2" />
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        }
        else if (!FilteredEvents.Any())
        {
            <MudItem xs="12">
                <div class="d-flex flex-column align-center justify-center py-16">
                    <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
                    <MudText Typo="Typo.h5" Color="Color.Secondary" Align="Align.Center">No events found</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center" Class="mt-2">
                        Try adjusting your filters or search query
                    </MudText>
                </div>
            </MudItem>
        }
        else
        {
            @foreach (var evt in FilteredEvents)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Class="h-100 d-flex flex-column">
                        <MudCardMedia Image="@(string.IsNullOrEmpty(evt.FeaturedImageUri) ? GetEventImage(evt) : evt.FeaturedImageUri)" Height="200" />
                        <MudCardContent Class="flex-grow-1">
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudText Typo="Typo.button" Class="mud-text-disabled">@GetEventTypeName(evt)</MudText>
                                @if (evt.IsUserReported == true)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">User Reported</MudChip>
                                }
                            </div>
                            <MudText Typo="Typo.h6" Class="mb-4">@evt.Title</MudText>
                            <MudText Typo="Typo.body2" Style="overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;">
                                @GetTruncatedDescription(evt.Description)
                            </MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" OnClick="@(() => Navigation.NavigateTo($"/event/detail/{evt.Id}"))">Learn More</MudButton>
                            <MudSpacer />
                            @if (evt.TotalViews > 0)
                            {
                                <MudButton Variant="Variant.Text" Disabled="true" StartIcon="@Icons.Material.Outlined.RemoveRedEye">@evt.TotalViews</MudButton>
                            }
                            @if (IsUserRegistered(evt.Id ?? Guid.Empty))
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Success" Disabled="true" StartIcon="@Icons.Material.Filled.CheckCircle">Joined</MudButton>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.AddCircleOutline" Color="Color.Primary" OnClick="@(() => OpenQuickRegisterDialog(evt))" Title="Quick Register" />
                            }
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        }
    </MudGrid>

    <div class="d-flex justify-center mt-8 mb-4">
        <MudPagination Count="@TotalPages"
                       Selected="@currentPage"
                       SelectedChanged="@((int page) => OnPageChanged(page))"
                       Color="Color.Primary"
                       ShowFirstButton="true"
                       ShowLastButton="true" />
    </div>
    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mb-8">
        Showing @((currentPage - 1) * itemsPerPage + 1) - @(Math.Min(currentPage * itemsPerPage, AllFilteredEvents.Count)) of @AllFilteredEvents.Count events
    </MudText>

</MudContainer>
