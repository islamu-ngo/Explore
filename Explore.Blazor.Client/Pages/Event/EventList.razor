@page "/event"
@page "/events"
@using MudBlazor

<PageTitle>Explore Events</PageTitle>

<MudContainer Class="py-4">
    <MudPaper Class="pa-4">
        <MudGrid>
            <!-- Filters -->
            <MudItem xs="12" Class="d-flex gap-4 flex-wrap">
                <MudSelect T="string" Label="Country" Variant="Variant.Outlined" Dense="true">
                    <MudSelectItem Value="@("nl")">Netherlands</MudSelectItem>
                    <MudSelectItem Value="@("be")">Belgium</MudSelectItem>
                    <MudSelectItem Value="@("de")">Germany</MudSelectItem>
                </MudSelect>

                <MudSelect T="string" Label="Date" Variant="Variant.Outlined" Dense="true">
                    <MudSelectItem Value="@("today")">Today</MudSelectItem>
                    <MudSelectItem Value="@("tomorrow")">Tomorrow</MudSelectItem>
                    <MudSelectItem Value="@("thisweek")">This Week</MudSelectItem>
                    <MudSelectItem Value="@("thismonth")">This Month</MudSelectItem>
                </MudSelect>

                <MudSelect T="string" Label="Category" Variant="Variant.Outlined" Dense="true">
                    <MudSelectItem Value="@("lecture")">Lecture</MudSelectItem>
                    <MudSelectItem Value="@("workshop")">Workshop</MudSelectItem>
                    <MudSelectItem Value="@("social")">Social</MudSelectItem>
                    <MudSelectItem Value="@("charity")">Charity</MudSelectItem>
                </MudSelect>

                <MudTextField T="string" 
                            Label="Search" 
                            Variant="Variant.Outlined" 
                            Dense="true"
                            Adornment="Adornment.End" 
                            AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>

            <!-- Event Cards -->
            <MudItem xs="12">
                <MudGrid>
                    @foreach (var _ in Enumerable.Range(0, 9))
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="0" Class="rounded-lg">
                                <MudCardMedia Image="https://dummyimage.com/600x400" Height="200" Class="rounded-t-lg" />
                                <MudCardContent>
                                    <MudStack Row="true" Class="mb-4">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">DeepDives</MudChip>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary">23/11/2025</MudChip>
                                    </MudStack>
                                    <MudText Typo="Typo.h6" Class="mb-2">Islamic Finance Workshop</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Surface" Style="opacity: 0.8">
                                        Learn about Islamic finance principles and their modern applications in this interactive workshop.
                                    </MudText>
                                </MudCardContent>
                                <MudCardActions Class="justify-space-between pa-4 pt-0">
                                    <MudButton Variant="Variant.Text" 
                                             EndIcon="@Icons.Material.Filled.ArrowForward" 
                                             Color="Color.Primary">View Details</MudButton>
                                    <MudStack Row="true">
                                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" />
                                        <MudText>Amsterdam</MudText>
                                    </MudStack>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            </MudItem>

            <!-- Pagination -->
            <MudItem xs="12" Class="d-flex justify-center mt-6">
                <MudPagination Count="3" Selected="1" Color="Color.Primary" />
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>

@code {
    private string searchText = "";
    private string selectedCountry = "";
    private string selectedDate = "";
    private string selectedCategory = "";
}