@page "/events/my"
@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Components.Event
@attribute [Authorize]

<PageTitle>My Events</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="my-events">
    <!-- Header -->
    <div class="my-events__header">
        <div>
            <MudText Typo="Typo.overline" Class="my-events__kicker">Manage</MudText>
            <MudText Typo="Typo.h5">My Events</MudText>
        </div>
        <div class="my-events__actions">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Business"
                       OnClick="NavigateToCreateOrganization">
                Create Organization
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="NavigateToCreateEvent">
                Organize Event
            </MudButton>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="my-events__loading">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-4">
                Loading your events...
            </MudText>
        </div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-4">
            @_errorMessage
            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="RetryLoadAsync" Class="ml-4">
                Retry
            </MudButton>
        </MudAlert>
    }
    else
    {
        <!-- Filters -->
        <div class="my-events__filters mb-4">
            <!-- Organization Filter -->
            <div class="my-events__filter-cell">
                <MudPopover Open="@_isOrganizationOpen" Fixed="true" Class="my-events__filter-popover px-4 py-3">
                    <div class="my-events__filter-dropdown">
                        <MudText Typo="Typo.subtitle2">Organization</MudText>
                        <div class="my-events__filter-options">
                            <MudText Typo="Typo.body2"
                                     Color="@(_selectedOrganizationId == Guid.Empty ? Color.Primary : Color.Default)"
                                     Class="my-events__filter-option"
                                     @onclick="@(() => OnOrganizationChanged(Guid.Empty))">
                                All Organizations
                            </MudText>
                            @foreach (var org in _myOrganizations)
                            {
                                <MudText Typo="Typo.body2"
                                         Color="@(_selectedOrganizationId == org.Id ? Color.Primary : Color.Default)"
                                         Class="my-events__filter-option"
                                         @onclick="@(() => OnOrganizationChanged(org.Id))">
                                    @org.FullName
                                </MudText>
                            }
                        </div>
                    </div>
                </MudPopover>
                <MudPaper @onclick="ToggleOrganizationFilter" Class="my-events__filter-paper">
                    <MudText Class="ml-2">@GetSelectedOrganizationName()</MudText>
                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" />
                </MudPaper>
            </div>

            <!-- Category Filter -->
            <div class="my-events__filter-cell">
                <MudPopover Open="@_isCategoryOpen" Fixed="true" Class="my-events__filter-popover px-4 py-3">
                    <div class="my-events__filter-dropdown">
                        <MudText Typo="Typo.subtitle2">Event Type</MudText>
                        <div class="my-events__filter-options">
                            <MudText Typo="Typo.body2"
                                     Color="@(string.IsNullOrEmpty(_selectedCategory) ? Color.Primary : Color.Default)"
                                     Class="my-events__filter-option"
                                     @onclick="@(() => OnCategoryChanged(""))">
                                All Types
                            </MudText>
                            @foreach (var eventType in UniqueEventTypes)
                            {
                                <MudText Typo="Typo.body2"
                                         Color="@(_selectedCategory == eventType ? Color.Primary : Color.Default)"
                                         Class="my-events__filter-option"
                                         @onclick="@(() => OnCategoryChanged(eventType))">
                                    @eventType
                                </MudText>
                            }
                        </div>
                    </div>
                </MudPopover>
                <MudPaper @onclick="ToggleCategoryFilter" Class="my-events__filter-paper">
                    <MudText Class="ml-2">@(string.IsNullOrEmpty(_selectedCategory) ? "All Types" : _selectedCategory)</MudText>
                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" />
                </MudPaper>
            </div>

            <!-- Search -->
            <div class="my-events__filter-cell my-events__filter-cell--search">
                <MudTextField @bind-Value="_searchString"
                              Class="my-events__search-input"
                              Placeholder="Search events..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              DebounceInterval="300"
                              TextChanged="OnSearch"
                              Margin="Margin.Dense" />
            </div>
        </div>

        @if (!FilteredEvents.Any())
        {
            <div class="my-events__empty">
                <MudIcon Icon="@Icons.Material.Outlined.Event" Class="my-events__empty-icon" />
                <MudText Typo="Typo.h6" Class="mt-4">No events found</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @if (_events.Any())
                    {
                        <span>Try adjusting your filters</span>
                    }
                    else
                    {
                        <span>Create an event to get started</span>
                    }
                </MudText>
            </div>
        }
        else
        {
            <!-- Event Cards -->
            <MudGrid Spacing="4">
                @foreach (var evt in FilteredEvents)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="0" Class="my-events__card">
                            <!-- Card Media -->
                            <MudCardMedia Class="my-events__card-media">
                                @if (!string.IsNullOrEmpty(evt.FeaturedImageUri))
                                {
                                    <img src="@evt.FeaturedImageUri" alt="@evt.Title" class="my-events__card-image" />
                                }
                                else
                                {
                                    <div class="my-events__card-placeholder" style="background-color: #@GetEventColorCode(evt);">
                                        <MudIcon Icon="@Icons.Material.Filled.Event" Class="my-events__placeholder-icon" />
                                    </div>
                                }
                            </MudCardMedia>

                            <!-- Actions Menu -->
                            <div class="my-events__actions-menu">
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                         Dense="true"
                                         Color="Color.Primary"
                                         Variant="Variant.Filled"
                                         Size="Size.Small">
                                    @if (CanEditEvent(evt))
                                    {
                                        <MudMenuItem OnClick="@(() => EditEvent(evt))">
                                            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" Size="Size.Small" /> Edit
                                        </MudMenuItem>
                                    }
                                    <MudMenuItem OnClick="@(() => ViewEventDetails(evt))">
                                        <MudIcon Icon="@Icons.Material.Filled.Visibility" Class="mr-2" Size="Size.Small" /> View Details
                                    </MudMenuItem>
                                    @if (CanEditEvent(evt))
                                    {
                                        <MudMenuItem OnClick="@(() => ViewRegistrations(evt))">
                                            <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" Size="Size.Small" /> Registrations
                                        </MudMenuItem>
                                        <MudMenuItem OnClick="@(() => DeleteEvent(evt))" Class="text-error">
                                            <MudIcon Icon="@Icons.Material.Filled.Delete" Class="mr-2" Size="Size.Small" /> Delete
                                        </MudMenuItem>
                                    }
                                </MudMenu>
                            </div>

                            <MudCardContent>
                                <div class="my-events__card-badges">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                             StartIcon="@Icons.Material.Filled.Category">
                                        @(evt.EventTypeFullName ?? "Event")
                                    </MudChip>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info"
                                             Variant="Variant.Outlined"
                                             StartIcon="@Icons.Material.Filled.Business">
                                        @(evt.ActorDisplayName ?? "Unknown")
                                    </MudChip>
                                </div>
                                <MudText Typo="Typo.h6" Class="my-events__card-title">@evt.Title</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="my-events__card-description">
                                    @evt.Description
                                </MudText>
                            </MudCardContent>

                            <MudCardActions Class="my-events__card-actions">
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           OnClick="@(() => EditEvent(evt))"
                                           Disabled="@(!CanEditEvent(evt))"
                                           Size="Size.Small">
                                    Edit
                                </MudButton>
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           OnClick="@(() => ViewEventDetails(evt))"
                                           Size="Size.Small">
                                    View
                                </MudButton>
                                <div class="my-events__card-format">
                                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" />
                                    <MudText Typo="Typo.caption">@(evt.EventFormatFullName ?? "Online")</MudText>
                                </div>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>

            <!-- Pagination -->
            <div class="my-events__pagination">
                <MudPagination Count="@TotalPages"
                               Selected="@_currentPage"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary"
                               ShowFirstButton="true"
                               ShowLastButton="true" />
            </div>
            <div class="my-events__results">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Showing @((_currentPage - 1) * ItemsPerPage + 1) - @Math.Min(_currentPage * ItemsPerPage, AllFilteredEvents.Count)
                    of @AllFilteredEvents.Count events
                </MudText>
            </div>
        }
    }
</MudContainer>
