@page "/myevents"
@using MudBlazor
@using Explore.Blazor.Client.Models
@using Explore.Blazor.Client.Models.DTOs
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Models.Enums
@inject IEventService EventService
@inject IProgramService ProgramService
@inject IOrganizationService OrganizationService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<style>
/* ... existing styles ... */
/* ===== TOKENS ===== */
:root{
    --fx-ring: color-mix(in srgb, var(--mud-palette-primary) 30%, transparent);
}

/* ===== WRAPPER ===== */
.page-wrap{ padding-block: 20px 32px; }

/* ===== BAR: filters ===== */
.filters-bar{
    display:grid; gap:12px;
    grid-template-columns: repeat(12, 1fr);
    align-items:stretch;
}
@@media (max-width: 960px){
    .filters-bar{ grid-template-columns: 1fr; }
}

.filter-cell{ grid-column: span 3; }
.filter-cell.search{ grid-column: span 3; }
@@media (max-width: 960px){
    .filter-cell, .filter-cell.search{ grid-column: 1/-1; }
}

/* Pill trigger */
.filter-paper{
    background-color: var(--mud-palette-surface);
    border: 1px solid var(--mud-palette-lines-default);
    border-radius: 999px;
    cursor: pointer;
    transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease, background .12s ease;
    color: var(--mud-palette-text-primary);
    padding-inline: 12px;
}
.filter-paper:hover{
    transform: translateY(-1px);
    background-color: color-mix(in srgb, var(--mud-palette-primary) 6%, var(--mud-palette-surface));
    border-color: var(--mud-palette-primary);
    box-shadow: 0 0 0 3px var(--fx-ring);
}

/* Chevron */
.filter-paper .mud-icon-root{ opacity:.85; }

/* Popover styling */
.filter-popover{
    background-color: var(--mud-palette-surface) !important;
    border: 1px solid var(--mud-palette-lines-default) !important;
    box-shadow: var(--mud-elevation-8) !important;
    border-radius: 12px !important;
}
.filter-popover .mud-text{ color: var(--mud-palette-text-primary) !important; }
.filter-option{
    padding: 6px 10px;
    border-radius: 8px;
    transition: background .12s ease, color .12s ease;
    cursor: pointer;
}
.filter-option:hover{
    background: color-mix(in srgb, var(--mud-palette-primary) 10%, transparent);
}

/* ===== SECTION HEADER ===== */
.section-head{
    display:flex; align-items:flex-end; justify-content:space-between;
    gap:16px; margin-bottom: 16px;
}
.kicker{ letter-spacing:.18em; text-transform:uppercase; font-size:.82rem; opacity:.7; }

/* ===== CARDS ===== */
.card{
    border-radius: 16px;
    overflow:hidden;
    border: 1px solid color-mix(in srgb, var(--mud-palette-lines-default) 70%, transparent);
    transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
}
.card:hover{
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(0,0,0,.16);
    border-color: color-mix(in srgb, var(--mud-palette-primary) 40%, var(--mud-palette-lines-default));
}

/* Media with subtle overlay */
.card-media{
    position: relative; height: 200px; overflow: hidden;
}
.card-media::after{
    content:""; position:absolute; inset:0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(0,0,0,.25) 100%);
}

/* Badges row */
.badges{ display:flex; gap:8px; align-items:center; margin: 10px 0 6px 0; }

/* Location row */
.loc{
    display:flex; align-items:center; gap:6px; opacity:.85;
}

/* ===== PAGINATION & INFO ===== */
.pager{
    display:flex; justify-content:center; margin-top: 24px;
}
.results{
    display:flex; justify-content:center; margin-top: 8px; opacity:.8;
}

/* ===== SEARCH FIELD ===== */
.search-input .mud-input-root{ border-radius: 999px !important; }
.search-input .mud-input:not(.mud-input-disabled):focus-within{
    box-shadow: 0 0 0 3px var(--fx-ring);
    border-color: var(--mud-palette-primary);
}

/* ===== MENU ACTIONS ===== */
.actions-menu{
    position: absolute; top: 12px; right: 12px;
    z-index: 10;
}
.actions-menu .mud-menu{
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(8px);
    border-radius: 8px;
}
</style><PageTitle>My Events</PageTitle>

<MudContainer Class="page-wrap">
    <div class="pa-4">

        <!-- Header -->
        <div class="section-head">
            <div>
                <MudText Typo="Typo.overline" Class="kicker">Manage</MudText>
                <MudText Typo="Typo.h5">My Events</MudText>
            </div>
            <div style="display: flex; gap: 12px;">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Business"
                           OnClick="@NavigateToCreateOrganization">
                    Create Organization
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@NavigateToCreate">
                    Organize Event
                </MudButton>
            </div>
        </div>

        @if (isLoading)
        {
            <div style="display: flex; justify-content: center; align-items: center; min-height: 400px;">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            </div>
        }
        else
        {
        <div class="filters-bar mb-4">
            <!-- Country -->
            <div class="filter-cell">
                <MudPopover Open="@isCountryOpen" Fixed="true" Class="filter-popover px-4 py-3">
                    <div class="d-flex flex-column gap-3" style="min-width:220px">
                        <MudText Typo="Typo.subtitle2">Country</MudText>
                        <div class="d-flex flex-column gap-1">
                            <MudText Typo="Typo.body2"
                                     Color="@(selectedCountry == "" ? Color.Primary : Color.Default)"
                                     Class="filter-option"
                                     @onclick="@(() => OnCountryChanged(""))">All Countries</MudText>
                            <MudText Typo="Typo.body2"
                                     Color="@(selectedCountry == "Netherlands" ? Color.Primary : Color.Default)"
                                     Class="filter-option"
                                     @onclick="@(() => OnCountryChanged("Netherlands"))">Netherlands</MudText>
                            <MudText Typo="Typo.body2"
                                     Color="@(selectedCountry == "Belgium" ? Color.Primary : Color.Default)"
                                     Class="filter-option"
                                     @onclick="@(() => OnCountryChanged("Belgium"))">Belgium</MudText>
                            <MudText Typo="Typo.body2"
                                     Color="@(selectedCountry == "Germany" ? Color.Primary : Color.Default)"
                                     Class="filter-option"
                                     @onclick="@(() => OnCountryChanged("Germany"))">Germany</MudText>
                        </div>
                    </div>
                </MudPopover>
                <MudPaper @onclick="@(() => isCountryOpen = !isCountryOpen)" 
                          Class="filter-paper d-flex justify-space-between align-center">
                    <MudText Class="ml-2">
                        @(string.IsNullOrEmpty(selectedCountry) ? "All Countries" : selectedCountry)
                    </MudText>
                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" />
                </MudPaper>
            </div>

            <!-- Organization -->
            <div class="filter-cell">
                <MudPopover Open="@isOrganizationOpen" Fixed="true" Class="filter-popover px-4 py-3">
                    <div class="d-flex flex-column gap-3" style="min-width:250px; max-height:300px; overflow-y:auto;">
                        <MudText Typo="Typo.subtitle2">Organization</MudText>
                        <div class="d-flex flex-column gap-1">
                            <MudText Typo="Typo.body2"
                                     Color="@(selectedOrganizationId == Guid.Empty ? Color.Primary : Color.Default)"
                                     Class="filter-option"
                                     @onclick="@(() => OnOrganizationChanged(Guid.Empty))">All Organizations</MudText>
                            @foreach (var org in MyOrganizations)
                            {
                                <MudText Typo="Typo.body2"
                                         Color="@(selectedOrganizationId == org.Id ? Color.Primary : Color.Default)"
                                         Class="filter-option"
                                         @onclick="@(() => OnOrganizationChanged(org.Id))">@org.FullName</MudText>
                            }
                        </div>
                    </div>
                </MudPopover>
                <MudPaper @onclick="@(() => isOrganizationOpen = !isOrganizationOpen)"
                          Class="filter-paper d-flex justify-space-between align-center">
                    <MudText Class="ml-2">
                        @(selectedOrganizationId == Guid.Empty ? "All Organizations" : MyOrganizations.FirstOrDefault(o => o.Id == selectedOrganizationId)?.FullName ?? "All Organizations")
                    </MudText>
                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" />
                </MudPaper>
            </div>

            <!-- Category -->
            <div class="filter-cell">
                <MudPopover Open="@isCategoryOpen" Fixed="true" Class="filter-popover px-4 py-3">
                    <div class="d-flex flex-column gap-3" style="min-width:220px">
                        <MudText Typo="Typo.subtitle2">Event Type</MudText>
                        <div class="d-flex flex-column gap-1">
                            <MudText Typo="Typo.body2"
                                     Color="@(selectedCategory == "" ? Color.Primary : Color.Default)"
                                     Class="filter-option"
                                     @onclick="@(() => OnCategoryChanged(""))">All Types</MudText>
                            @foreach (var eventType in UniqueEventTypes)
                            {
                                <MudText Typo="Typo.body2"
                                         Color="@(selectedCategory == eventType ? Color.Primary : Color.Default)"
                                         Class="filter-option"
                                         @onclick="@(() => OnCategoryChanged(eventType))">@eventType</MudText>
                            }
                        </div>
                    </div>
                </MudPopover>
                <MudPaper @onclick="@(() => isCategoryOpen = !isCategoryOpen)"
                          Class="filter-paper d-flex justify-space-between align-center">
                    <MudText Class="ml-2">
                        @(string.IsNullOrEmpty(selectedCategory) ? "All Types" : selectedCategory)
                    </MudText>
                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" />
                </MudPaper>
            </div>

            <!-- Search -->
            <div class="filter-cell search">
                <MudTextField @bind-Value="searchString"
                              Class="search-input"
                              Placeholder="Search"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Immediate="true"
                              DebounceInterval="500"
                              TextChanged="OnSearch"
                              Margin="Margin.Dense" />
            </div>
        </div>

        <!-- Cards -->
        <MudGrid>
            @foreach (var evt in FilteredEvents)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="0" Class="card" Style="position: relative;">
                        <MudCardMedia Class="card-media">
                            @if (!string.IsNullOrEmpty(evt.ImageKey))
                            {
                                <S3Image ImageKey="@evt.ImageKey"
                                        Alt="@evt.Title"
                                        ObjectFit="cover"
                                        ContainerStyle="height: 200px;" />
                            }
                            else
                            {
                                <img src="@($"https://dummyimage.com/1200x800/{GetEventColor(evt)}/ffffff&text={Uri.EscapeDataString(evt.Title)}")" 
                                     alt="@evt.Title" 
                                     style="width: 100%; height: 200px; object-fit: cover;" />
                            }
                        </MudCardMedia>
                        
                        <!-- Actions Menu positioned on card -->
                        <div class="actions-menu">
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" 
                                     Dense="true" 
                                     Color="Color.Primary"
                                     Variant="Variant.Filled"
                                     Size="Size.Small"
                                     Style="background: rgba(255,255,255,0.9); backdrop-filter: blur(8px);">
                                @if (CanEditEvent(evt))
                                {
                                    <MudMenuItem OnClick="@(() => EditEvent(evt))">
                                        <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" Size="Size.Small" /> Edit
                                    </MudMenuItem>
                                }
                                <MudMenuItem OnClick="@(() => ViewEventDetails(evt))">
                                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Class="mr-2" Size="Size.Small" /> View Details
                                </MudMenuItem>
                                @if (CanEditEvent(evt))
                                {
                                    <MudMenuItem OnClick="@(() => ViewRegistrations(evt))">
                                        <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" Size="Size.Small" /> View Registrations
                                    </MudMenuItem>
                                    <MudMenuItem OnClick="@(() => DeleteEvent(evt))" Class="text-error">
                                        <MudIcon Icon="@Icons.Material.Filled.Delete" Class="mr-2" Size="Size.Small" /> Delete
                                    </MudMenuItem>
                                }
                            </MudMenu>
                        </div>

                        <MudCardContent>
                            <div class="badges">
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Category">
                                    @evt.EventTypeFullName
                                </MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Business">
                                    @evt.OrganizationFullName
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.h6" Class="mb-1">@evt.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Surface" Style="opacity:.85; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;">
                                @evt.Description
                            </MudText>
                        </MudCardContent>
                        <MudCardActions Class="justify-space-between pa-4 pt-0">
                            @if (CanEditEvent(evt))
                            {
                                <MudButton Variant="Variant.Text"
                                           EndIcon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           OnClick="@(() => EditEvent(evt))">
                                    Edit Event
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Text"
                                           EndIcon="@Icons.Material.Filled.Visibility"
                                           Color="Color.Primary"
                                           OnClick="@(() => ViewEventDetails(evt))">
                                    View Details
                                </MudButton>
                            }
                            <div class="loc">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" />
                                <MudText>@(evt.City ?? evt.Country ?? "Online")</MudText>
                            </div>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        <!-- No events message -->
        @if (!FilteredEvents.Any())
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">
                <MudText>No events found matching your criteria.</MudText>
            </MudAlert>
        }

        <!-- Pagination + info -->
        @if (FilteredEvents.Any())
        {
            <div class="pager">
                <MudPagination Count="@TotalPages"
                               Selected="@currentPage"
                               SelectedChanged="@((int page) => OnPageChanged(page))"
                               Color="Color.Primary"
                               ShowFirstButton="true"
                               ShowLastButton="true" />
            </div>
            <div class="results">
                <MudText Typo="Typo.body2" Color="Color.Surface">
                    Showing @((currentPage - 1) * itemsPerPage + 1) - @(Math.Min(currentPage * itemsPerPage, AllFilteredEvents.Count)) of @AllFilteredEvents.Count events (Page @currentPage of @TotalPages)
                </MudText>
            </div>
        }
        }
    </div>
</MudContainer>

@code {
    private string searchString = "";
    private string selectedCountry = "";
    private string selectedCategory = "";
    private Guid selectedOrganizationId = Guid.Empty;
    private List<EventListDto> Events = new();
    private List<OrganizationListDto> MyOrganizations = new();
    private bool isCountryOpen;
    private bool isCategoryOpen;
    private bool isOrganizationOpen;
    private bool isLoading = true;

    // Pagination variables
    private int currentPage = 1;
    private int itemsPerPage = 6;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            
            // Load both events and organizations in parallel
            var eventsTask = EventService.GetMyEventsAsync();
            var organizationsTask = OrganizationService.GetMyOrganizationsAsync();
            
            await Task.WhenAll(eventsTask, organizationsTask);
            
            Events = eventsTask.Result;
            MyOrganizations = organizationsTask.Result;
            
            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            isLoading = false;
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
        }
    }
    
    private bool CanEditEvent(EventListDto evt)
    {
        var org = MyOrganizations.FirstOrDefault(o => o.Id == evt.OrganizationId);
        if (org == null) return false;
        
        // Creator, CoOwner or Admin can edit
        return org.CurrentUserRole == OrganizationRole.Creator || org.CurrentUserRole == OrganizationRole.CoOwner || org.CurrentUserRole == OrganizationRole.Admin;
    }

    private List<string> UniqueEventTypes => Events
        .Select(e => e.EventTypeFullName)
        .Distinct()
        .OrderBy(t => t)
        .ToList();

    // Filtered events logic for pagination
    private List<EventListDto> AllFilteredEvents => Events
        .Where(e => string.IsNullOrEmpty(searchString) ||
                    e.Title.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                    (e.Description != null && e.Description.Contains(searchString, StringComparison.OrdinalIgnoreCase)))
        .Where(e => string.IsNullOrEmpty(selectedCountry) ||
                    (e.Country != null && e.Country.Contains(selectedCountry, StringComparison.OrdinalIgnoreCase)))
        .Where(e => string.IsNullOrEmpty(selectedCategory) ||
                    e.EventTypeFullName.Contains(selectedCategory, StringComparison.OrdinalIgnoreCase))
        .Where(e => selectedOrganizationId == Guid.Empty ||
                    e.OrganizationId == selectedOrganizationId)
        .ToList();

    private List<EventListDto> FilteredEvents
    {
        get
        {
            var allEvents = AllFilteredEvents;
            return allEvents
                .Skip((currentPage - 1) * itemsPerPage)
                .Take(itemsPerPage)
                .ToList();
        }
    }

    private int TotalPages
    {
        get
        {
            var count = AllFilteredEvents.Count;
            return count > 0 ? (int)Math.Ceiling((double)count / itemsPerPage) : 1;
        }
    }

    private void EditEvent(EventListDto evt)
    {
        if (CanEditEvent(evt))
        {
            Navigation.NavigateTo($"/eventedit/{evt.Id}");
        }
        else
        {
            Snackbar.Add("You do not have permission to edit this event.", Severity.Error);
        }
    }

    private void ViewEventDetails(EventListDto evt)
    {
        Navigation.NavigateTo($"/event/detail/{evt.Id}");
    }

    private async Task ViewRegistrations(EventListDto evt)
    {
        var parameters = new DialogParameters
        {
            { "EventId", evt.Id }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = DialogService.Show<EventRegistrationsDialog>($"Registrations for {evt.Title}", parameters, options);
        await dialog.Result;
    }

    private async Task DeleteEvent(EventListDto evt)
    {
        if (!CanEditEvent(evt))
        {
            Snackbar.Add("You do not have permission to delete this event.", Severity.Error);
            return;
        }

        try
        {
            bool? result = await DialogService.ShowMessageBox(
                "Delete Event",
                $"Are you sure you want to delete the event '{evt.Title}'? This action cannot be undone.",
                yesText: "Delete", 
                cancelText: "Cancel",
                options: new DialogOptions { MaxWidth = MaxWidth.Small });

            Console.WriteLine($"MessageBox result: {result}");

            if (result == true)
            {
                Console.WriteLine("Attempting to delete event: " + evt.Id);
                var success = await EventService.DeleteEventAsync(evt.Id);
                Console.WriteLine("Delete result: " + success);
                
                if (success)
                {
                    Snackbar.Add($"Event '{evt.Title}' has been deleted successfully.", Severity.Success);
                    
                    // Remove from local list
                    Events.Remove(evt);
                    
                    // Reset to first page if current page is now empty
                    if (!FilteredEvents.Any() && currentPage > 1)
                    {
                        currentPage = 1;
                    }
                    
                    StateHasChanged();
                }
                else
                {
                    Snackbar.Add("Failed to delete event. You may not have permission.", Severity.Error);
                }
            }
            else
            {
                Console.WriteLine("Delete canceled by user");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in DeleteEvent: {ex.Message}");
            Snackbar.Add($"Error deleting event: {ex.Message}", Severity.Error);
        }
    }

    private void OnSearch(string value)
    {
        searchString = value;
        currentPage = 1;
        StateHasChanged();
    }

    private void OnCountryChanged(string value)
    {
        selectedCountry = value;
        isCountryOpen = false;
        currentPage = 1;
        StateHasChanged();
    }

    private void OnCategoryChanged(string value)
    {
        selectedCategory = value;
        isCategoryOpen = false;
        currentPage = 1;
        StateHasChanged();
    }

    private void OnOrganizationChanged(Guid organizationId)
    {
        selectedOrganizationId = organizationId;
        isOrganizationOpen = false;
        currentPage = 1;
        StateHasChanged();
    }

    private void OnPageChanged(int page)
    {
        currentPage = page;
        StateHasChanged();
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/create");
    }

    private void NavigateToCreateOrganization()
    {
        Navigation.NavigateTo("/organization/create");
    }

    private string GetEventColor(EventListDto evt)
    {
        // Generate color based on event type
        return evt.EventTypeFullName?.ToLower() switch
        {
            var s when s.Contains("conference") => "2196F3",    // Blue
            var s when s.Contains("workshop") => "FF9800",      // Orange
            var s when s.Contains("webinar") => "4CAF50",       // Green
            var s when s.Contains("seminar") => "E91E63",       // Pink
            var s when s.Contains("training") => "9C27B0",      // Purple
            _ => "607D8B"                                        // Blue Grey
        };
    }
}
