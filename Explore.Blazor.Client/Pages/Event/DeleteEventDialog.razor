@using MudBlazor
@using Microsoft.Extensions.Logging
@inject ILogger<DeleteEventDialog> Logger

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">
            Are you sure you want to delete the event <strong>@EventTitle</strong>?
        </MudText>
        <MudText Typo="Typo.body2" Class="mt-3" Color="Color.Error">
            This action cannot be undone.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">Cancel</MudButton>
        <MudButton OnClick="Submit" Color="Color.Error" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete">
            Delete
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IDialogReference? DialogReference { get; set; }

    [Parameter]
    public string EventTitle { get; set; } = string.Empty;

    void Submit()
    {
        Logger.LogDebug("Delete button clicked - Submit called. DialogReference is null: {IsNull}", DialogReference == null);
        DialogReference?.Close(DialogResult.Ok(true));
        Logger.LogDebug("Dialog closed with OK result");
    }

    void Cancel()
    {
        Logger.LogDebug("Cancel button clicked");
        DialogReference?.Close(DialogResult.Cancel());
    }
}
