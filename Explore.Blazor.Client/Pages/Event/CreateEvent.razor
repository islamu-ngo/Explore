@page "/create"
@using System.ComponentModel.DataAnnotations
@using MudBlazor
@using Microsoft.AspNetCore.Components.Forms

<style>
/* ---- Page framing ---- */
.create-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 16px;
}

/* ---- Form card ---- */
.event-form {
    padding: 20px;
    border-radius: 12px;
    background: var(--mud-palette-background-paper);
}

/* ---- Title ---- */
.title {
    margin: 4px 0 16px;
    font-weight: 600;
}

/* ---- Image picker ---- */
.image-row {
    position: relative;
}

/* Clickable label styled like a dashed box */
.image-picker {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 14px 16px;
    border: 1px dashed var(--mud-palette-lines-default);
    border-radius: 12px;
    cursor: pointer;
    background: transparent;
}

    /* Hide the actual input while keeping it clickable (fills the label) */
    .hidden-file-input,
    .image-picker input[type="file"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        width: 100%;
        height: 100%;
        cursor: pointer;
    }

/* Preview under the picker */
.image-preview {
    display: block;
    margin-top: 12px;
    max-width: 100%;
    max-height: 220px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--mud-palette-lines-default);
}

/* Helper: ensure caption shows on its own line */
.image-text .mud-typography-caption {
    display: block;
}

/* ---- Radios stacked neatly ---- */
.radio-col .mud-radio {
    display: inline-block;
    margin-right: 32px;
    margin-bottom: 0;
}

/* ---- Dropdown spacing ---- */
.event-type-select {
    margin-top: 16px;
    margin-bottom: 16px;
}

/* ---- Event type radio spacing ---- */
.event-type-radio .mud-radio {
    display: block;
    margin-bottom: 12px;
}

/* ---- Fallback margin utilities ---- */
.mb-4 {
    margin-bottom: 16px !important;
}

.sm\:mb-0 {
    margin-bottom: 0 !important;
}

/* ---- Event type row ---- */
.event-type-row {
    display: flex;
    align-items: flex-end;
    gap: 24px;
}

.event-type-select {
    min-width: 180px;
    margin: 0;
}

.event-type-select select {
    width: 100%;
    padding: 10px 12px;
    border-radius: 6px;
    border: 1px solid var(--mud-palette-lines-default);
    background: var(--mud-palette-background-paper);
    color: var(--mud-palette-text-primary);
    font-size: 1rem;
}

.event-type-select label {
    font-weight: 500;
    margin-bottom: 4px;
    display: block;
}

</style>

<MudContainer Class="create-page" DisableGutters="true">
    <MudPaper Class="event-form" Elevation="1">
        <MudText Typo="Typo.h4" Class="title">Create a new event</MudText>

        <!-- Image picker with preview -->
        <div class="image-row mb-4">
            <label class="image-picker">
                <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Size="Size.Large" />
                <div class="image-text">
                    <MudText Typo="Typo.body1">Add an image</MudText>
                    @if (!string.IsNullOrEmpty(SelectedFileName))
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@SelectedFileName</MudText>
                    }
                </div>

                <!-- Hidden but clickable file input -->
                <InputFile OnChange="OnFileSelected" accept="image/*" class="hidden-file-input" />
            </label>

            @if (!string.IsNullOrEmpty(ImageDataUrl))
            {
                <img src="@ImageDataUrl" alt="Selected image preview" class="image-preview" />
            }
        </div>

        <!-- Form -->
        <MudForm @ref="form" Model="Model" OnValidSubmit="OnCreate">
            <MudStack Spacing="3">

                <MudTextField class="mb-4"
                              @bind-Value="Model.Title"
                              For="@(() => Model.Title)"
                              Label="Title"
                              Required="true"
                              Immediate="true"
                              Margin="Margin.Normal" />

                <MudTextField class="mb-4"
                              @bind-Value="Model.Description"
                              For="@(() => Model.Description)"
                              Label="Description"
                              TextArea="true"
                              Lines="4"
                              Margin="Margin.Normal" />

                <!-- Date / Time / Type -->
                <MudGrid Class="mb-4">
                    <MudItem xs="12" sm="4" Class="mb-4 sm:mb-0">
                        <MudDatePicker @bind-Date="Model.Date"
                                       For="@(() => Model.Date)"
                                       Label="Date"
                                       Required="true"
                                       CloseToSelectableDate="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4" Class="mb-4 sm:mb-0">
                        <MudTimePicker @bind-Time="Model.Time"
                                       For="@(() => Model.Time)"
                                       Label="Time"
                                       AmPm="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <!-- intentionally left empty for spacing -->
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudRadioGroup T="string"
                                       @bind-SelectedOption="Model.Type"
                                       For="@(() => Model.Type)"
                                       Label="Tag / Event type"
                                       Required="true"
                                       Class="radio-col">
                            <MudRadio T="string" Option="Digital" Label="Digital" />
                            <MudRadio T="string" Option="Local" Label="Local" />
                        </MudRadioGroup>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <div class="event-type-select">
                            <label for="eventCategory">Event Category</label>
                            <select id="eventCategory" name="eventCategory">
                                <option>All Categories</option>
                                <option>Lecture</option>
                                <option>Workshop</option>
                                <option>Social</option>
                                <option>Charity</option>
                            </select>
                        </div>
                    </MudItem>
                </MudGrid>

                <MudTextField class="mb-4"
                              @bind-Value="Model.Location"
                              For="@(() => Model.Location)"
                              Label="Location / Link"
                              Margin="Margin.Normal" />

                <MudStack Direction="Row" Spacing="2" Class="actions">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               ButtonType="ButtonType.Submit">
                        CREATE EVENT
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               Href="/">
                        CANCEL
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudForm>

    </MudPaper>
</MudContainer>

@code {
    private MudForm? form;
    private string? SelectedFileName;
    private string? ImageDataUrl; // data: URL for the preview
    private EventCreateModel Model = new();

    private async Task OnCreate()
    {
        await form!.Validate();
        // TODO: save/navigate
    }

    // Read the selected image and build a data URL for preview
    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            SelectedFileName = null;
            ImageDataUrl = null;
            return;
        }

        SelectedFileName = file.Name;

        // Limit read size (e.g., 10 MB) to protect from huge files
        const long max = 10 * 1024 * 1024;

        using var stream = file.OpenReadStream(max);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);

        var bytes = ms.ToArray();
        var base64 = Convert.ToBase64String(bytes);
        ImageDataUrl = $"data:{file.ContentType};base64,{base64}";
    }

    private class EventCreateModel
    {
        [Required(ErrorMessage = "Please enter a title.")]
        public string? Title { get; set; }

        public string? Description { get; set; }

        [Required(ErrorMessage = "Please choose a date.")]
        public DateTime? Date { get; set; }

        public TimeSpan? Time { get; set; }

        [Required]
        public string? Type { get; set; } = "Digital";

        [Required]
        public string? EventCategory { get; set; } = "Lecture"; // mock value

        public string? Location { get; set; }
    }
}
