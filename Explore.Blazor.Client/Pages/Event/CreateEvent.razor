@page "/create-event"
@using MudBlazor
@using Explore.Blazor.Client.Components
@using Explore.Blazor.Client.Components.Event
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Create Event</PageTitle>
<MudContainer Class="create-event" DisableGutters="true">
    @if (isLoading)
    {
        <div class="create-event__loading">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (!_isRetrying)
    {
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Primary"
                   Variant="Variant.Text"
                   OnClick="@(() => Navigation.NavigateTo("/events"))"
                   Class="create-event__back-button">
            Back to Events
        </MudButton>

        <MudPaper Class="isl-card isl-form-card" Elevation="1">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Large" Color="Color.Primary" />
                        <div>
                            <MudText Typo="Typo.h5">Create Event</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @GetPublisherDescription()
                            </MudText>
                        </div>
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>

            <MudCardContent>
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => errorMessage = string.Empty)">
                        @errorMessage
                    </MudAlert>
                }

                <EditForm Model="createDto" OnValidSubmit="@HandleSubmit">
                    <DataAnnotationsValidator />

                    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
                        <MudTabPanel Text="Publish As" Icon="@Icons.Material.Filled.AccountCircle">
                            <MudText Class="isl-form__section-title mb-3">Who is publishing this event?</MudText>

                            <MudRadioGroup @bind-Value="_publisherMode" T="string" Class="mb-4">
                                <MudRadio Value="@("personal")" Color="Color.Primary" Dense="true">
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                        <MudText>Myself (User Reported)</MudText>
                                    </MudStack>
                                </MudRadio>
                                <MudRadio Value="@("organization")" Color="Color.Primary" Dense="true"
                                          Disabled="@(_myOrganizations == null || !_myOrganizations.Any())">
                                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                                        <MudText>An Organization</MudText>
                                    </MudStack>
                                </MudRadio>
                            </MudRadioGroup>

                            @if (_publisherMode == "personal")
                            {
                                <MudAlert Severity="Severity.Info" Class="mb-4" Variant="Variant.Outlined">
                                    Events published in your name will be marked as <strong>User Reported</strong>.
                                    These events are subject to community moderation.
                                </MudAlert>
                            }

                            @if (_publisherMode == "organization")
                            {
                                @if (_myOrganizations != null && _myOrganizations.Any())
                                {
                                    <MudSelect Value="_selectedOrganizationId"
                                               T="Guid?"
                                               Label="Select Organization"
                                               Variant="Variant.Outlined"
                                               Required="true"
                                               Class="mb-3"
                                               ValueChanged="OnOrganizationSelected">
                                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">-- Select an organization --</MudSelectItem>
                                        @foreach (var org in _myOrganizations)
                                        {
                                            <MudSelectItem T="Guid?" Value="@((Guid?)org.Id)">
                                                @org.FullName @(org.CurrentUserRole.HasValue ? $"({GetRoleName((int)org.CurrentUserRole.Value)})" : "")
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Warning" Class="mb-4">
                                        You are not a member of any organizations. Create or join an organization first.
                                    </MudAlert>
                                }

                                @if (!string.IsNullOrEmpty(_organizationRoleError))
                                {
                                    <MudAlert Severity="Severity.Error" Class="mb-4">
                                        @_organizationRoleError
                                    </MudAlert>
                                }
                            }
                        </MudTabPanel>

                        <MudTabPanel Text="General Info" Icon="@Icons.Material.Filled.Info">
                            <MudGrid>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="createDto.Title"
                                                  Label="Event Title"
                                                  Variant="Variant.Outlined"
                                                  Required
                                                  FullWidth
                                                  Class="mb-4" />

                                    <MudTextField @bind-Value="createDto.Description"
                                                  Label="Description"
                                                  Variant="Variant.Outlined"
                                                  Lines="6"
                                                  FullWidth
                                                  Class="mb-4" />

                                    <MudSelect @bind-Value="createDto.EventTypeId"
                                               Label="Event Type"
                                               Variant="Variant.Outlined"
                                               Required
                                               Class="mb-4">
                                        @if (eventTypes != null)
                                        {
                                            @foreach (var type in eventTypes)
                                            {
                                                <MudSelectItem Value="@type.Id">@type.FullName</MudSelectItem>
                                            }
                                        }
                                    </MudSelect>

                                    <MudText Class="isl-form__section-title mb-2 mt-2">Audience</MudText>
                                    <MudGrid>
                                        <MudItem xs="12" md="6">
                                            <MudSelect @bind-Value="createDto.AudienceGenderId" Label="Gender" Variant="Variant.Outlined">
                                                @if (audienceGenders != null)
                                                {
                                                    @foreach (var g in audienceGenders)
                                                    {
                                                        <MudSelectItem Value="@g.Id">@g.FullName</MudSelectItem>
                                                    }
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudSelect @bind-Value="createDto.AudienceAgeId" Label="Age Group" Variant="Variant.Outlined">
                                                @if (audienceAges != null)
                                                {
                                                    @foreach (var a in audienceAges)
                                                    {
                                                        <MudSelectItem Value="@a.Id">@a.FullName</MudSelectItem>
                                                    }
                                                }
                                            </MudSelect>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                        </MudTabPanel>

                        <MudTabPanel Text="Media" Icon="@Icons.Material.Filled.Image">
                            <div class="d-flex justify-center">
                                <div style="max-width: 600px; width: 100%;">
                                    <MudText Class="isl-form__section-title mb-3 text-center">Event Image</MudText>
                                    <ImageUpload @ref="_imageUploadComponent"
                                                 @bind-PreviewUrl="imagePreviewUrl"
                                                 FileDataSelected="OnImageFileDataSelected"
                                                 IsProcessing="_isUploadingImage"
                                                 Width="100%"
                                                 Height="300px"
                                                 PlaceholderText="Upload featured image" />
                                    @if (_isUploadingImage)
                                    {
                                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">Uploading image...</MudText>
                                    }
                                    @if (_uploadError != null)
                                    {
                                        <MudAlert Severity="Severity.Error" Class="mt-2" ShowCloseIcon="true" CloseIconClicked="@(() => _uploadError = null)">
                                            @_uploadError
                                        </MudAlert>
                                    }
                                </div>
                            </div>
                        </MudTabPanel>

                        <MudTabPanel Text="Sessions" Icon="@Icons.Material.Filled.EventAvailable">
                            <MudText Class="isl-form__section-title mb-3">
                                Event Sessions
                                <MudText Typo="Typo.caption" Color="Color.Default" Class="ml-2">(Minimum 1 required)</MudText>
                            </MudText>

                            <div class="d-flex flex-column gap-4">
                                @for (int i = 0; i < sessions.Count; i++)
                                {
                                    var index = i;
                                    <MudCard Elevation="0" Class="pa-4 border-solid border-1 mud-border-lines-default rounded-lg">
                                        <div class="d-flex justify-space-between align-center mb-4">
                                            <MudText Typo="Typo.h6">Session @(index + 1)</MudText>
                                            @if (sessions.Count > 1)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => RemoveSession(index))" />
                                            }
                                        </div>

                                        <EventSessionEditor Session="sessions[index]"
                                                            SessionChanged="@((s) => OnSessionChanged(index, s))"
                                                            Index="index"
                                                            ShowRemoveButton="false"
                                                            ShowLocationSelector="true"
                                                            Locations="locations"
                                                            RegistrationModes="registrationModes"
                                                            ShowLanguageSelector="true"
                                                            Languages="languages" />
                                    </MudCard>
                                }
                            </div>

                            <div class="d-flex justify-center mt-4">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="AddSession">
                                    Add Another Session
                                </MudButton>
                            </div>
                        </MudTabPanel>

                        <MudTabPanel Text="Settings" Icon="@Icons.Material.Filled.Settings">
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudText Class="isl-form__section-title mb-3">Format & Visibility</MudText>
                                    <MudSelect @bind-Value="createDto.EventFormatId" Label="Format" Variant="Variant.Outlined" Class="mb-3">
                                        @if (eventFormats != null)
                                        {
                                            @foreach (var f in eventFormats)
                                            {
                                                <MudSelectItem Value="@f.Id">@f.FullName</MudSelectItem>
                                            }
                                        }
                                    </MudSelect>
                                    <MudSelect @bind-Value="createDto.VisibilityTypeId" Label="Visibility" Variant="Variant.Outlined">
                                        @if (visibilityTypes != null)
                                        {
                                            @foreach (var v in visibilityTypes)
                                            {
                                                <MudSelectItem Value="@v.Id">@v.FullName</MudSelectItem>
                                            }
                                        }
                                    </MudSelect>
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudText Class="isl-form__section-title mb-3">Categorization</MudText>
                                    <MudSelect T="Guid" Label="Categories" MultiSelection="true" @bind-SelectedValues="selectedCategoryIds" Variant="Variant.Outlined" Class="mb-3">
                                        @if (allCategories != null)
                                        {
                                            @foreach (var c in allCategories)
                                            {
                                                <MudSelectItem Value="@c.Id">@c.FullName</MudSelectItem>
                                            }
                                        }
                                    </MudSelect>
                                    <MudSelect T="Guid" Label="Tags" MultiSelection="true" @bind-SelectedValues="selectedTagIds" Variant="Variant.Outlined">
                                        @if (allTags != null)
                                        {
                                            @foreach (var t in allTags)
                                            {
                                                <MudSelectItem Value="@t.Id">@t.FullName</MudSelectItem>
                                            }
                                        }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>
                        </MudTabPanel>
                    </MudTabs>

                    <div class="d-flex justify-end mt-6 gap-2">
                        <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo("/events"))">Cancel</MudButton>
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(isProcessing || _isUploadingImage || !string.IsNullOrEmpty(_organizationRoleError))"
                                   StartIcon="@(isProcessing || _isUploadingImage ? null : Icons.Material.Filled.Save)">
                            @if (isProcessing)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Creating...</span>
                            }
                            else if (_isUploadingImage)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Uploading image...</span>
                            }
                            else
                            {
                                <span>Create Event</span>
                            }
                        </MudButton>
                    </div>
                </EditForm>
            </MudCardContent>
        </MudPaper>
    }
</MudContainer>
