@page "/create"
@using System.ComponentModel.DataAnnotations
@using MudBlazor
@using Microsoft.AspNetCore.Components.Forms
@using Explore.Blazor.Client.Services
@using Explore.Blazor.Client.Models.DTOs
@inject IEventService EventService
@inject IOrganizationService OrganizationService
@inject IAdminService AdminService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<style>
.create-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 16px;
}
.event-form {
    padding: 20px;
    border-radius: 12px;
    background: var(--mud-palette-background-paper);
}
.title {
    margin: 4px 0 16px;
    font-weight: 600;
}
.image-preview {
    width: 300px;
    height: 200px;
    border: 2px dashed var(--mud-palette-lines-default);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    position: relative;
    background-color: var(--mud-palette-background-gray);
}
</style>

@using Explore.Blazor.Client.Models.Enums

<MudContainer Class="create-page" DisableGutters="true">
    @if (isLoading)
    {
        <div style="display: flex; justify-content: center; align-items: center; min-height: 400px;">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (myOrganizations == null || !myOrganizations.Any())
    {
        <MudPaper Class="event-form" Elevation="1">
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                You do not have permission to create events. You must be a <strong>Creator</strong>, <strong>Co-Owner</strong> or <strong>Admin</strong> of an organization to create events.
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/organization/create"))">
                Create New Organization
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="event-form" Elevation="1">
            <MudText Typo="Typo.h4" Class="title">Create a New Event</MudText>
            <EditForm Model="createDto" OnValidSubmit="OnCreate">
                <DataAnnotationsValidator />
                
                <!-- Event Title -->
                <MudTextField @bind-Value="createDto.Title" 
                            Label="Event Title" 
                            Variant="Variant.Outlined" 
                            Required 
                            FullWidth 
                            Class="mb-3" />

                <!-- Event Description -->
                <MudTextField @bind-Value="createDto.Description" 
                            Label="Event Description" 
                            Variant="Variant.Outlined" 
                            Lines="4" 
                            FullWidth 
                            Class="mb-3" />

                <!-- Organization Selection -->
                <MudSelect @bind-Value="createDto.OrganizationId" 
                          Label="Organization" 
                          Variant="Variant.Outlined" 
                          FullWidth 
                          Required
                          Class="mb-3"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Business">
                    @if (myOrganizations != null)
                    {
                        @foreach (var org in myOrganizations)
                        {
                            <MudSelectItem Value="@org.Id">@org.FullName</MudSelectItem>
                        }
                    }
                </MudSelect>

                <!-- Event Type Selection -->
                <MudSelect @bind-Value="createDto.EventTypeId" 
                          Label="Event Type" 
                          Variant="Variant.Outlined" 
                          FullWidth 
                          Required
                          Class="mb-3"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Category">
                    @if (eventTypes != null)
                    {
                        @foreach (var eventType in eventTypes)
                        {
                            <MudSelectItem Value="@eventType.Id">@eventType.FullName</MudSelectItem>
                        }
                    }
                </MudSelect>

                <!-- Event Image Upload -->
                <MudText Typo="Typo.h6" Class="mb-3">Event Image</MudText>
                <MudPaper Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                    <ImageUpload ImageKey="@createDto.ImageKey"
                                ImageKeyChanged="OnImageKeyChanged"
                                PreviewUrl="@imagePreviewUrl"
                                PreviewUrlChanged="OnPreviewUrlChanged"
                                Width="100%"
                                Height="300px"
                                PlaceholderText="Add an event image"
                                HintText="Upload an attractive image for your event (JPG, PNG, GIF, WebP - Max 5MB)" />
                </MudPaper>

                <!-- Date and Time -->
                <MudText Typo="Typo.h6" Class="mb-3">Date and Time</MudText>
                <MudPaper Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="Start Date" @bind-Date="_startDate" Variant="Variant.Outlined" Required="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTimePicker Label="Start Time" @bind-Time="_startTime" Variant="Variant.Outlined" Required="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Label="End Date" @bind-Date="_endDate" Variant="Variant.Outlined" Required="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTimePicker Label="End Time" @bind-Time="_endTime" Variant="Variant.Outlined" Required="true" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- Location Info -->
                <MudText Typo="Typo.h6" Class="mb-3">Location</MudText>
                <MudPaper Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                    <MudSwitch @bind-Value="_isOnline" Label="Online Event (No physical location)" Color="Color.Primary" Class="mb-3" />
                    
                    @if (_isOnline)
                    {
                        <MudTextField @bind-Value="createDto.ProgramUrl" 
                                    Label="Online Meeting Link (e.g. Teams)" 
                                    Variant="Variant.Outlined" 
                                    FullWidth 
                                    Class="mb-3"
                                    Adornment="Adornment.Start"
                                    AdornmentIcon="@Icons.Material.Filled.Link" />
                    }
                    else
                    {
                        <MudGrid Spacing="3">
                            <MudItem xs="12">
                                <MudTextField @bind-Value="createDto.Address" 
                                            Label="Address" 
                                            Variant="Variant.Outlined" 
                                            FullWidth
                                            Placeholder="Street name and number"
                                            Adornment="Adornment.Start"
                                            AdornmentIcon="@Icons.Material.Filled.Home" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="createDto.City" 
                                            Label="City" 
                                            Variant="Variant.Outlined" 
                                            FullWidth
                                            Placeholder="City name"
                                            Adornment="Adornment.Start"
                                            AdornmentIcon="@Icons.Material.Filled.LocationCity" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect @bind-Value="createDto.Country" 
                                          Label="Country" 
                                          Variant="Variant.Outlined" 
                                          FullWidth
                                          Placeholder="Select Country"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Public">
                                    <MudSelectItem Value="@("Belgium")">Belgium</MudSelectItem>
                                    <MudSelectItem Value="@("Netherlands")">Netherlands</MudSelectItem>
                                    <MudSelectItem Value="@("France")">France</MudSelectItem>
                                    <MudSelectItem Value="@("Germany")">Germany</MudSelectItem>
                                    <MudSelectItem Value="@("Spain")">Spain</MudSelectItem>
                                    <MudSelectItem Value="@("Italy")">Italy</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField @bind-Value="createDto.PostCode" 
                                               Label="Postal Code" 
                                               Variant="Variant.Outlined" 
                                               FullWidth />
                            </MudItem>
                        </MudGrid>
                    }
                </MudPaper>

                <!-- Audience Info -->
                <MudText Typo="Typo.h6" Class="mb-3">Audience</MudText>
                <MudPaper Class="pa-3 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="createDto.AudienceGenderId" 
                                      Label="Target Gender" 
                                      Variant="Variant.Outlined" 
                                      FullWidth 
                                      Required>
                                @if (audienceGenders != null)
                                {
                                    @foreach (var gender in audienceGenders)
                                    {
                                        <MudSelectItem Value="@gender.Id">@gender.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="createDto.AudienceAgeId" 
                                      Label="Target Age Group" 
                                      Variant="Variant.Outlined" 
                                      FullWidth 
                                      Required>
                                @if (audienceAges != null)
                                {
                                    @foreach (var age in audienceAges)
                                    {
                                        <MudSelectItem Value="@age.Id">@age.FullName</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField @bind-Value="createDto.AudienceAttendees" 
                                           Label="Expected Attendees (optional)" 
                                           Variant="Variant.Outlined" 
                                           FullWidth 
                                           Min="0" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>

                <!-- Price & URL -->
                <MudNumericField @bind-Value="createDto.Price" 
                               Label="Price" 
                               Variant="Variant.Outlined" 
                               FullWidth
                               Min="0"
                               Class="mb-3"
                               Adornment="Adornment.Start"
                               AdornmentIcon="@Icons.Material.Filled.Euro" />

                <MudCheckBox @bind-Value="createDto.IsRegistrationRequired" 
                            Label="Registration Required" 
                            Color="Color.Primary"
                            Class="mb-4" />

                <!-- Action Buttons -->
                <div class="d-flex justify-content-between mt-4">
                    <MudButton Variant="Variant.Outlined" 
                             Color="Color.Secondary" 
                             Disabled="@isCreating"
                             OnClick="@(() => Navigation.NavigateTo("/myevents"))">
                        Cancel
                    </MudButton>
                    <MudButton ButtonType="ButtonType.Submit" 
                             Variant="Variant.Filled" 
                             Color="Color.Primary"
                             Disabled="@isCreating"
                             StartIcon="@(isCreating ? Icons.Material.Filled.HourglassBottom : Icons.Material.Filled.Add)">
                        @(isCreating ? "Creating..." : "Create Event")
                    </MudButton>
                </div>
            </EditForm>
        </MudPaper>
    }
</MudContainer>

@code {
    private MudForm? form;
    private CreateEventDto createDto = new();
    private List<OrganizationListDto>? myOrganizations;
    private List<EventTypeListDto>? eventTypes;
    private List<AudienceGenderListDto>? audienceGenders;
    private List<AudienceAgeListDto>? audienceAges;
    private bool isLoading = true;
    private string? imagePreviewUrl;

    private DateTime? _startDate = DateTime.Today;
    private TimeSpan? _startTime = new TimeSpan(9, 0, 0);
    private DateTime? _endDate = DateTime.Today;
    private TimeSpan? _endTime = new TimeSpan(17, 0, 0);
    private bool _isOnline = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            
            // Load all required dropdowns
            var allOrgs = await OrganizationService.GetMyOrganizationsAsync();
            // Filter for Creator/CoOwner/Admin
            myOrganizations = allOrgs.Where(o => o.CurrentUserRole == OrganizationRole.Creator || o.CurrentUserRole == OrganizationRole.CoOwner || o.CurrentUserRole == OrganizationRole.Admin).ToList();

            eventTypes = await AdminService.GetEventTypesAsync();
            audienceGenders = await AdminService.GetAudienceGendersAsync();
            audienceAges = await AdminService.GetAudienceAgesAsync();
            
            // Set defaults
            if (myOrganizations?.Any() == true)
            {
                createDto.OrganizationId = myOrganizations.First().Id;
            }
            
            if (eventTypes?.Any() == true)
            {
                createDto.EventTypeId = eventTypes.First().Id;
            }
            
            if (audienceGenders?.Any() == true)
            {
                createDto.AudienceGenderId = audienceGenders.First().Id;
            }
            
            if (audienceAges?.Any() == true)
            {
                createDto.AudienceAgeId = audienceAges.First().Id;
            }
            
            // Set default for registration required
            createDto.IsRegistrationRequired = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading form data: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool isCreating = false;

    private void OnImageKeyChanged(string? value)
    {
        createDto.ImageKey = value;
    }

    private void OnPreviewUrlChanged(string? value)
    {
        imagePreviewUrl = value;
    }
    
    private async Task OnCreate()
    {
        if (isCreating) return;
        
        try
        {
            if (_startDate.HasValue && _startTime.HasValue)
            {
                createDto.StartDate = (_startDate.Value.Date + _startTime.Value).ToUniversalTime();
            }
            
            if (_endDate.HasValue && _endTime.HasValue)
            {
                createDto.EndDate = (_endDate.Value.Date + _endTime.Value).ToUniversalTime();
            }

            if (_isOnline)
            {
                createDto.Address = null;
                createDto.City = null;
                createDto.Country = null;
                createDto.PostCode = null;
            }

            isCreating = true;
            StateHasChanged();
            
            Console.WriteLine("Starting event creation...");
            Console.WriteLine($"Title: {createDto.Title}");
            Console.WriteLine($"OrganizationId: {createDto.OrganizationId}");
            Console.WriteLine($"EventTypeId: {createDto.EventTypeId}");
            
            var eventId = await EventService.CreateEventAsync(createDto);
            
            if (eventId.HasValue)
            {
                Console.WriteLine($"Event created with ID: {eventId.Value}");
                Snackbar.Add("Event created successfully!", Severity.Success);
                // Navigate to confirmation page with event ID
                Navigation.NavigateTo($"/event-created/{eventId.Value}");
            }
            else
            {
                Console.WriteLine("Event creation returned null");
                Snackbar.Add("Failed to create event. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception during event creation: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            Snackbar.Add($"Error creating event: {ex.Message}", Severity.Error);
        }
        finally
        {
            isCreating = false;
            StateHasChanged();
        }
    }
}
