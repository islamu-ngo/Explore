@page "/event/detail/{eventId:int}"
@using MudBlazor
@inject NavigationManager Navigation

<PageTitle>Event Detail</PageTitle>

<style>
/* ===== TOKENS ===== */
:root{
  --ring: color-mix(in srgb, var(--mud-palette-primary) 30%, transparent);
}

/* ===== HERO ===== */
.hero{
  position: relative; border-radius: 16px; overflow: hidden;
  height: 320px; margin-bottom: 16px;
  box-shadow: 0 16px 40px rgba(0,0,0,.18);
}
.hero img{ width:100%; height:100%; object-fit:cover; display:block; }
.hero::after{
  content:""; position:absolute; inset:0;
  background: linear-gradient(180deg, rgba(0,0,0,.15) 0%, rgba(0,0,0,.45) 100%);
}
.hero-content{
  position:absolute; inset:0; display:flex; flex-direction:column; justify-content:flex-end;
  padding: 18px;
  color:#fff;
}
.hero-chips{ display:flex; gap:8px; flex-wrap:wrap; margin-bottom:8px; }
.hero-title{ margin: 2px 0 4px 0; }

/* ===== LAYOUT ===== */
.page-wrap{ padding-block: 18px 32px; }
.info-grid{ display:grid; gap:16px; grid-template-columns: 2fr 1fr; }
@@media (max-width: 1024px){ .info-grid{ grid-template-columns: 1fr; } }

/* ===== BODY CARD ===== */
.body-card{
  border: 1px solid color-mix(in srgb, var(--mud-palette-lines-default) 70%, transparent);
  border-radius: 16px; overflow: hidden;
}
.body-section{ padding: 18px; }
.body-section + .body-section{ border-top: 1px solid var(--mud-palette-lines-default); }

/* Info list */
.detail-list{ display:grid; gap:10px; }
.detail-row{ display:flex; align-items:flex-start; gap:10px; }
.detail-row .mud-icon-root{ opacity:.9; }

/* ===== STICKY ASIDE ===== */
.sticky{
  position: sticky; top: 84px;
  border: 1px solid color-mix(in srgb, var(--mud-palette-lines-default) 70%, transparent);
  border-radius: 16px; padding: 16px;
}
.aside-row{ display:flex; align-items:center; gap:8px; opacity:.9; }
.aside-divider{ margin: 12px 0; }
.cta .mud-button-root{ width:100%; border-radius: 10px; }
.cta .mud-button-root:focus-visible{ box-shadow: 0 0 0 3px var(--ring); }

/* Map placeholder */
.mapbox{
  height: 160px; border-radius: 12px; overflow:hidden;
  background: linear-gradient(135deg, #e5e7eb, #f3f4f6);
  display:grid; place-items:center; color: var(--mud-palette-text-secondary);
}

/* Back link */
.back-link .mud-button-root{ padding-left: 0; }
.back-link .mud-button-label{ font-weight:600; }

/* Text rhythm */
p{ line-height: 1.6; }
</style>

<MudContainer Class="page-wrap">
    <MudGrid>

        <!-- Back -->
        <MudItem xs="12" Class="mb-2">
            <div class="back-link">
                <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                           Variant="Variant.Text"
                           Color="Color.Primary"
                           OnClick="@(() => Navigation.NavigateTo("/events"))">
                    Back to Events
                </MudButton>
            </div>
        </MudItem>

        @if (selectedEvent != null)
        {
            <!-- HERO -->
            <MudItem xs="12">
                <div class="hero">
                    <img src="@($"https://dummyimage.com/1600x900/{GetEventColor(selectedEvent)}/ffffff&text={Uri.EscapeDataString(selectedEvent.Title)}")" alt="@selectedEvent.Title" />
                    <div class="hero-content">
                        <div class="hero-chips">
                            <MudChip T="string" 
                                     Color="Color.Primary" 
                                     StartIcon="@Icons.Material.Filled.Category" 
                                     Size="Size.Small"
                                     Style="background-color: rgba(33, 150, 243, 0.9); color: white; font-weight: 500;">
                                @selectedEvent.Category
                            </MudChip>
                            <MudChip T="string" 
                                     Color="Color.Info" 
                                     StartIcon="@Icons.Material.Filled.Event" 
                                     Size="Size.Small"
                                     Style="background-color: rgba(255, 255, 255, 0.9); color: #333; font-weight: 500;">
                                @selectedEvent.Date.ToString("dd/MM/yyyy • HH:mm")
                            </MudChip>
                            <MudChip T="string" 
                                     Color="Color.Secondary" 
                                     StartIcon="@Icons.Material.Filled.Place" 
                                     Size="Size.Small"
                                     Style="background-color: rgba(255, 255, 255, 0.9); color: #333; font-weight: 500;">
                                @(selectedEvent.Location == "Online" ? "Online" : GetCountryFromLocation(selectedEvent.Location))
                            </MudChip>
                        </div>
                        <MudText Typo="Typo.h4" Class="hero-title">@selectedEvent.Title</MudText>
                    </div>
                </div>
            </MudItem>

            <!-- CONTENT -->
            <MudItem xs="12">
                <div class="info-grid">

                    <!-- LEFT: description & details -->
                    <div>
                        <MudPaper Elevation="0" Class="body-card">
                            <div class="body-section">
                                <MudText Typo="Typo.h6" Class="mb-1">About this event</MudText>
                                <MudText Typo="Typo.body1">
                                    @selectedEvent.Description
                                </MudText>
                            </div>

                            <div class="body-section">
                                <MudText Typo="Typo.h6" Class="mb-2">Details</MudText>
                                <div class="detail-list">
                                    <div class="detail-row">
                                        <MudIcon Icon="@Icons.Material.Filled.Event" />
                                        <MudText>@selectedEvent.Date.ToString("dddd dd MMMM yyyy • HH:mm")</MudText>
                                    </div>
                                    <div class="detail-row">
                                        <MudIcon Icon="@Icons.Material.Filled.Category" />
                                        <MudText>@selectedEvent.Category</MudText>
                                    </div>
                                    <div class="detail-row">
                                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" />
                                        <MudText>@selectedEvent.Location</MudText>
                                    </div>
                                </div>
                            </div>

                            <div class="body-section">
                                <MudText Typo="Typo.h6" Class="mb-2">Share</MudText>
                                <MudStack Row="true" Spacing="1">
                                    <MudIconButton Icon="@Icons.Custom.Brands.Facebook" Color="Color.Default" Size="Size.Small" aria-label="Share on Facebook" />
                                    <MudIconButton Icon="@Icons.Custom.Brands.Twitter" Color="Color.Default" Size="Size.Small" aria-label="Share on X" />
                                    <MudIconButton Icon="@Icons.Custom.Brands.WhatsApp" Color="Color.Default" Size="Size.Small" aria-label="Share on WhatsApp" />
                                    <MudIconButton Icon="@Icons.Custom.Brands.LinkedIn" Color="Color.Default" Size="Size.Small" aria-label="Share on LinkedIn" />
                                </MudStack>
                            </div>
                        </MudPaper>
                    </div>

                    <!-- RIGHT: sticky actions -->
                    <div>
                        <MudPaper Elevation="0" Class="sticky">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle1">Attend this event</MudText>

                                <div class="aside-row">
                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" />
                                    <MudText>@selectedEvent.Date.ToString("dd/MM/yyyy • HH:mm")</MudText>
                                </div>
                                <div class="aside-row">
                                    <MudIcon Icon="@Icons.Material.Filled.Place" />
                                    <MudText>@(selectedEvent.Location == "Online" ? "Online" : GetCountryFromLocation(selectedEvent.Location))</MudText>
                                </div>

                                <MudDivider Class="aside-divider" />

                                <div class="cta">
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Size="Size.Large"
                                               FullWidth="true">
                                        Join us
                                    </MudButton>
                                </div>

                                <MudDivider Class="aside-divider" />

                                @if (selectedEvent.Location != "Online")
                                {
                                    <div class="mapbox">
                                        <MudText Typo="Typo.caption">Map preview</MudText>
                                    </div>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                        Online event — link will be provided by the organizer.
                                    </MudAlert>
                                }
                            </MudStack>
                        </MudPaper>
                    </div>

                </div>
            </MudItem>
        }
        else
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Warning">
                    Event not found.
                </MudAlert>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

