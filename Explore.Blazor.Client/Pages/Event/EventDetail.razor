@page "/event/detail/{eventId:guid}"
@using MudBlazor
@using Explore.Blazor.Client.Models.DTOs
@using Explore.Blazor.Client.Services
@inject NavigationManager Navigation
@inject IProgramService ProgramService
@inject IDialogService DialogService
@inject IOrganizationService OrganizationService
@inject IConfiguration Configuration

<PageTitle>Event Detail</PageTitle>

<style>
/* ===== TOKENS ===== */
:root{
  --ring: color-mix(in srgb, var(--mud-palette-primary) 30%, transparent);
}

/* ===== HERO ===== */
.hero{
  position: relative; border-radius: 16px; overflow: hidden;
  height: 320px; margin-bottom: 16px;
  box-shadow: 0 16px 40px rgba(0,0,0,.18);
}
.hero img{ width:100%; height:100%; object-fit:cover; display:block; }
.hero::after{
  content:""; position:absolute; inset:0;
  background: linear-gradient(180deg, rgba(0,0,0,.15) 0%, rgba(0,0,0,.45) 100%);
}
.hero-content{
  position:absolute; inset:0; display:flex; flex-direction:column; justify-content:flex-end;
  padding: 18px;
  color:#fff;
}
.hero-chips{ display:flex; gap:8px; flex-wrap:wrap; margin-bottom:8px; }
.hero-title{ margin: 2px 0 4px 0; }

/* Mobile hero */
@@media (max-width: 480px) {
  .hero{
    height: 240px; margin-bottom: 12px;
    border-radius: 12px;
  }
  .hero-content{ padding: 12px; }
  .hero-title{ font-size: 1.5rem !important; }
}

/* ===== LAYOUT ===== */
.page-wrap{ padding-block: 18px 32px; }
.info-grid{ display:grid; gap:16px; grid-template-columns: 2fr 1fr; }
@@media (max-width: 1024px){ .info-grid{ grid-template-columns: 1fr; } }

/* Mobile layout */
@@media (max-width: 480px) {
  .page-wrap{ padding-block: 8px 16px; padding-left: 8px; padding-right: 8px; }
  .info-grid{ gap: 8px; }
}

/* ===== BODY CARD ===== */
.body-card{
  border: 1px solid color-mix(in srgb, var(--mud-palette-lines-default) 70%, transparent);
  border-radius: 16px; overflow: hidden;
}
.body-section{ padding: 18px; }
.body-section + .body-section{ border-top: 1px solid var(--mud-palette-lines-default); }

/* Mobile body */
@@media (max-width: 480px) {
  .body-card{ border-radius: 12px; }
  .body-section{ padding: 10px; }
}

/* Info list */
.detail-list{ display:grid; gap:10px; }
.detail-row{ display:flex; align-items:flex-start; gap:10px; }
.detail-row .mud-icon-root{ opacity:.9; }

/* ===== STICKY ASIDE ===== */
.sticky{
  position: sticky; top: 84px;
  border: 1px solid color-mix(in srgb, var(--mud-palette-lines-default) 70%, transparent);
  border-radius: 16px; padding: 16px;
}
.aside-row{ display:flex; align-items:center; gap:8px; opacity:.9; }
.aside-divider{ margin: 12px 0; }
.cta .mud-button-root{ width:100%; border-radius: 10px; }
.cta .mud-button-root:focus-visible{ box-shadow: 0 0 0 3px var(--ring); }

/* Mobile sticky */
@@media (max-width: 480px) {
  .sticky{
    position: relative; top: auto;
    border-radius: 12px; padding: 10px;
    margin-top: 12px;
  }
  .aside-row{ gap: 6px; }
  .aside-divider{ margin: 8px 0; }
}

/* Map container */
.mapbox{
  height: 200px; border-radius: 12px; overflow:hidden;
  background: linear-gradient(135deg, var(--mud-palette-background-gray), var(--mud-palette-surface));
}
.mapbox iframe{ width:100%; height:100%; border:0; display:block; }

/* Mobile map */
@@media (max-width: 480px) {
  .mapbox{ height: 160px; border-radius: 10px; }
}

/* Back link */
.back-link .mud-button-root{ padding-left: 0; }
.back-link .mud-button-label{ font-weight:600; }

/* Mobile back link */
@@media (max-width: 480px) {
  .back-link .mud-button-root{ padding: 4px 8px; }
  .back-link .mud-button-label{ font-size: 0.9rem; }
}

/* Text rhythm */
p{ line-height: 1.6; }
</style>

<MudContainer Class="page-wrap">
    <MudGrid>

        <!-- Back -->
        <MudItem xs="12" Class="mb-2">
            <div class="back-link">
                <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                           Variant="Variant.Text"
                           Color="Color.Primary"
                           OnClick="@(() => Navigation.NavigateTo("/events"))">
                    Back to Events
                </MudButton>
            </div>
        </MudItem>

        @if (program != null)
        {
            <!-- HERO -->
            <MudItem xs="12">
                <div class="hero">
                    <img src="@($"https://dummyimage.com/1600x900/{GetEventColor()}/ffffff&text={Uri.EscapeDataString(program.Title)}")" alt="@program.Title" />
                    <div class="hero-content">
                        <div class="hero-chips">
                            <MudChip T="string" 
                                     Color="Color.Primary" 
                                     StartIcon="@Icons.Material.Filled.Category" 
                                     Size="Size.Small"
                                     Style="background-color: rgba(33, 150, 243, 0.9); color: white; font-weight: 500;">
                                @GetProgramTypeName()
                            </MudChip>
                            <MudChip T="string" 
                                     Color="Color.Secondary" 
                                     StartIcon="@Icons.Material.Filled.Place" 
                                     Size="Size.Small"
                                     Style="background-color: rgba(255, 255, 255, 0.9); color: #333; font-weight: 500;">
                                @GetLocationDisplay()
                            </MudChip>
                            @if (program.Price > 0)
                            {
                                <MudChip T="string" 
                                         Color="Color.Success" 
                                         StartIcon="@Icons.Material.Filled.Euro" 
                                         Size="Size.Small"
                                         Style="background-color: rgba(76, 175, 80, 0.9); color: white; font-weight: 500;">
                                    €@program.Price.ToString("F2")
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" 
                                         Color="Color.Success" 
                                         StartIcon="@Icons.Material.Filled.CardGiftcard" 
                                         Size="Size.Small"
                                         Style="background-color: rgba(76, 175, 80, 0.9); color: white; font-weight: 500;">
                                    Free
                                </MudChip>
                            }
                        </div>
                        <MudText Typo="Typo.h4" Class="hero-title">@program.Title</MudText>
                    </div>
                </div>
            </MudItem>

            <!-- CONTENT -->
            <MudItem xs="12">
                <div class="info-grid">

                    <!-- LEFT: description & details -->
                    <div>
                        <MudPaper Elevation="0" Class="body-card">
                            <div class="body-section">
                                <MudText Typo="Typo.h6" Class="mb-1">About this @(program.ProgramTypeId == 1 ? "event" : "program")</MudText>
                                <MudText Typo="Typo.body1">
                                    @program.Description
                                </MudText>
                            </div>

                            <div class="body-section">
                                <MudText Typo="Typo.h6" Class="mb-2">Details</MudText>
                                <div class="detail-list">
                                    <div class="detail-row">
                                        <MudIcon Icon="@Icons.Material.Filled.Category" />
                                        <MudText>@GetProgramTypeName() @(program.Event != null ? $"- {GetEventTypeName()}" : program.Education != null ? $"- {GetEducationTypeName()}" : "")</MudText>
                                    </div>
                                    <div class="detail-row">
                                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" />
                                        <MudText>@GetDateDisplay()</MudText>
                                    </div>
                                    <div class="detail-row">
                                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" />
                                        <MudText>@GetFullLocation()</MudText>
                                    </div>
                                    <div class="detail-row">
                                        <MudIcon Icon="@Icons.Material.Filled.Euro" />
                                        <MudText>@(program.Price > 0 ? $"€{program.Price:F2}" : "Free")</MudText>
                                    </div>
                                    @if (program.AudienceAttendees.HasValue && program.AudienceAttendees.Value > 0)
                                    {
                                        <div class="detail-row">
                                            <MudIcon Icon="@Icons.Material.Filled.People" />
                                            <MudText>Expected attendees: @program.AudienceAttendees</MudText>
                                        </div>
                                    }
                                    @if (program.IsRegistrationRequired.HasValue)
                                    {
                                        <div class="detail-row">
                                            <MudIcon Icon="@(program.IsRegistrationRequired.Value ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Info)" />
                                            <MudText>@(program.IsRegistrationRequired.Value ? "Registration required" : "No registration required")</MudText>
                                        </div>
                                    }
                                    <div class="detail-row">
                                        <MudIcon Icon="@Icons.Material.Filled.Visibility" />
                                        <MudText>@program.TotalViews views</MudText>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(program.ProgramUrl))
                                    {
                                        <div class="detail-row">
                                            <MudIcon Icon="@Icons.Material.Filled.Link" />
                                            <MudLink Href="@program.ProgramUrl" Target="_blank">Event website</MudLink>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="body-section">
                                <MudText Typo="Typo.h6" Class="mb-2">Share</MudText>
                                <MudStack Row="true" Spacing="1">
                                    <MudIconButton Icon="@Icons.Custom.Brands.Facebook" Color="Color.Default" Size="Size.Small" aria-label="Share on Facebook" />
                                    <MudIconButton Icon="@Icons.Custom.Brands.Twitter" Color="Color.Default" Size="Size.Small" aria-label="Share on X" />
                                    <MudIconButton Icon="@Icons.Custom.Brands.WhatsApp" Color="Color.Default" Size="Size.Small" aria-label="Share on WhatsApp" />
                                    <MudIconButton Icon="@Icons.Custom.Brands.LinkedIn" Color="Color.Default" Size="Size.Small" aria-label="Share on LinkedIn" />
                                </MudStack>
                            </div>
                        </MudPaper>
                    </div>

                    <!-- RIGHT: sticky actions -->
                    <div>
                        <MudPaper Elevation="0" Class="sticky">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.subtitle1">@(program.ProgramTypeId == 1 ? "Attend this event" : "Join this program")</MudText>

                                <div class="aside-row">
                                    <MudIcon Icon="@Icons.Material.Filled.Place" />
                                    <MudText>@GetLocationDisplay()</MudText>
                                </div>
                                <div class="aside-row">
                                    <MudIcon Icon="@Icons.Material.Filled.Euro" />
                                    <MudText>@(program.Price > 0 ? $"€{program.Price:F2}" : "Free")</MudText>
                                </div>

                                <MudDivider Class="aside-divider" />

                                @if (organization != null)
                                {
                                    <div class="d-flex align-center gap-2 cursor-pointer" style="cursor: pointer;" @onclick="@(() => Navigation.NavigateTo($"/organization/profile/{organization.Id}"))">
                                        <MudAvatar Size="Size.Medium">
                                             <MudImage Src="https://via.placeholder.com/150" />
                                        </MudAvatar>
                                        <div>
                                            <MudText Typo="Typo.caption">Organized by</MudText>
                                            <MudText Typo="Typo.subtitle2">@organization.FullName</MudText>
                                        </div>
                                    </div>
                                    
                                    <MudDivider Class="aside-divider" />
                                }

                                <div class="cta">
                                    <MudButton Variant="Variant.Filled"
                                               Color="GetButtonColor()"
                                               Size="Size.Large"
                                               FullWidth="true"
                                               Disabled="IsButtonDisabled()"
                                               StartIcon="@(isUserRegistered ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Event)"
                                               OnClick="OpenRegistrationDialog">
                                        @GetButtonText()
                                    </MudButton>
                                    @if (isUserRegistered)
                                    {
                                        <MudText Typo="Typo.caption" Align="Align.Center" Style="margin-top: 8px; color: var(--mud-palette-success);">
                                            You're all set for this event! 🎉
                                        </MudText>
                                    }
                                </div>

                                <MudDivider Class="aside-divider" />

                                <div>
                                    <MudMenu Icon="@Icons.Material.Filled.CalendarMonth" 
                                             Label="Add to Calendar"
                                             Variant="Variant.Outlined" 
                                             Color="Color.Default"
                                             FullWidth="true"
                                             Style="border-radius: 10px;"
                                             AnchorOrigin="Origin.BottomLeft"
                                             TransformOrigin="Origin.TopLeft">
                                        <MudMenuItem Icon="@Icons.Custom.Brands.Google" OnClick="@(() => AddToGoogleCalendar())">
                                            Google Calendar
                                        </MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Material.Filled.CalendarToday" OnClick="@(() => AddToAppleCalendar())">
                                            Apple .ics
                                        </MudMenuItem>
                                        <MudMenuItem Icon="@Icons.Custom.Brands.Microsoft" OnClick="@(() => AddToOutlookCalendar())">
                                            Outlook .ics
                                        </MudMenuItem>
                                    </MudMenu>
                                </div>

                                <MudDivider Class="aside-divider" />

                                @if (!string.IsNullOrWhiteSpace(program.Country))
                                {
                                    var mapUrl = GetMapEmbedUrl();
                                    if (!string.IsNullOrWhiteSpace(mapUrl))
                                    {
                                        <div class="mapbox">
                                            <iframe title="Location map"
                                                    src="@mapUrl"
                                                    loading="lazy"
                                                    allowfullscreen></iframe>
                                        </div>
                                    }
                                    else
                                    {
                                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                            Map preview unavailable. Please contact the organizer for details.
                                        </MudAlert>
                                    }
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                        Location details will be provided by the organizer.
                                    </MudAlert>
                                }
                            </MudStack>
                        </MudPaper>
                    </div>

                </div>
            </MudItem>
        }
        else if (isLoading)
        {
            <MudItem xs="12">
                <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="py-8">
                    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                    <MudText Typo="Typo.body1">Loading details...</MudText>
                </MudStack>
            </MudItem>
        }
        else
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Warning">
                    Event not found.
                </MudAlert>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

@code {
    [Parameter] public Guid EventId { get; set; }

    private ProgramDto? program;
    private OrganizationDto? organization;
    private bool isLoading = true;
    private bool isUserRegistered = false;
    private bool isCheckingRegistration = true;
    private Dictionary<int, string> programTypeMap = new();
    private Dictionary<int, string> eventTypeMap = new();
    private Dictionary<int, string> educationTypeMap = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        isCheckingRegistration = true;

        try
        {
            // Load program details and lookup data in parallel
            var programTask = ProgramService.GetProgramByIdAsync(EventId);
            var programTypesTask = ProgramService.GetProgramTypesAsync();
            var eventTypesTask = ProgramService.GetEventTypesAsync();

            await Task.WhenAll(programTask, programTypesTask, eventTypesTask);

            program = await programTask;
            
            // Check registration status if program loaded successfully
            if (program != null)
            {
                try
                {
                    organization = await OrganizationService.GetOrganizationByIdAsync(program.OrganizationId);

                    Console.WriteLine($"Checking registration for program: {program.Id}");
                    isUserRegistered = await ProgramService.IsUserRegisteredAsync(program.Id);
                    Console.WriteLine($"Is user registered: {isUserRegistered}");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error checking registration status: {ex.Message}");
                    isUserRegistered = false;
                }
            }
            
            // Build lookup maps
            var programTypes = await programTypesTask;
            programTypeMap = programTypes.ToDictionary(pt => pt.Id, pt => pt.FullName);

            var eventTypes = await eventTypesTask;
            eventTypeMap = eventTypes.ToDictionary(et => et.Id, et => et.FullName);

            // Note: EducationType endpoint would be needed for full education support
            // For now, we'll use mock data for education types
            educationTypeMap = new Dictionary<int, string>
            {
                { 1, "Course" },
                { 2, "Bootcamp" },
                { 3, "Workshop Series" }
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading event details: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            isCheckingRegistration = false;
        }
    }

    private string GetProgramTypeName()
    {
        if (program == null) return "";
        return programTypeMap.TryGetValue(program.ProgramTypeId, out var name) ? name : "Program";
    }

    private string GetEventTypeName()
    {
        if (program?.Event == null) return "";
        return eventTypeMap.TryGetValue(program.Event.EventTypeId, out var name) ? name : "Event";
    }

    private string GetEducationTypeName()
    {
        if (program?.Education == null) return "";
        return educationTypeMap.TryGetValue(program.Education.EducationTypeId, out var name) ? name : "Education";
    }

    private string GetDateDisplay()
    {
        if (program == null) return "";
        
        var start = program.StartDate.ToLocalTime();
        var end = program.EndDate.ToLocalTime();
        
        if (start.Date == end.Date)
        {
            return $"{start:dddd d MMMM yyyy} • {start:HH:mm} - {end:HH:mm}";
        }
        
        return $"{start:dd/MM/yyyy HH:mm} - {end:dd/MM/yyyy HH:mm}";
    }

    private string GetLocationDisplay()
    {
        if (program == null) return "";
        
        if (!string.IsNullOrWhiteSpace(program.Country))
        {
            return program.Country;
        }
        
        return "Location TBD";
    }

    private string GetFullLocation()
    {
        if (program == null) return "";

        var parts = new List<string>();
        
        if (!string.IsNullOrWhiteSpace(program.Address))
            parts.Add(program.Address);
        
        if (!string.IsNullOrWhiteSpace(program.City))
            parts.Add(program.City);
        
        if (program.PostCode.HasValue)
            parts.Add(program.PostCode.Value.ToString());
        
        if (!string.IsNullOrWhiteSpace(program.Country))
            parts.Add(program.Country);

        return parts.Count > 0 ? string.Join(", ", parts) : "Location to be announced";
    }

    private string GetMapEmbedUrl()
    {
        if (program == null) return string.Empty;
        var key = Configuration["GoogleMaps:ApiKey"];
        if (string.IsNullOrWhiteSpace(key)) return string.Empty;

        var location = GetFullLocation();
        if (string.IsNullOrWhiteSpace(location)) return string.Empty;

        var query = Uri.EscapeDataString(location);
        return $"https://www.google.com/maps/embed/v1/place?key={key}&q={query}";
    }

    private string GetEventColor()
    {
        if (program == null) return "607D8B";

        // Generate color based on program type
        return program.ProgramTypeId switch
        {
            1 => "2196F3",    // Event - Blue
            2 => "9C27B0",    // Education - Purple
            _ => "607D8B"     // Default - Blue Grey
        };
    }

    private async Task OpenRegistrationDialog()
    {
        if (program == null) return;

        var parameters = new DialogParameters
        {
            { "ProgramId", program.Id },
            { "Title", $"Register for {program.Title}" }
        };

        var options = new DialogOptions 
        { 
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            Position = DialogPosition.Center
        };

        var dialog = await DialogService.ShowAsync<Components.EventRegistration>(
            "Register", 
            parameters, 
            options
        );
        
        var result = await dialog.Result;
        
        if (result != null && !result.Canceled)
        {
            // Refresh registration status
            try
            {
                Console.WriteLine("Registration dialog closed successfully, refreshing status...");
                isUserRegistered = await ProgramService.IsUserRegisteredAsync(program.Id);
                Console.WriteLine($"Updated registration status: {isUserRegistered}");
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error refreshing registration status: {ex.Message}");
            }
        }
    }

    private string GetButtonText()
    {
        if (isCheckingRegistration) return "Checking...";
        if (isUserRegistered) return "Already Registered";
        return program?.IsRegistrationRequired == true ? "Register now" : "Join us";
    }

    private bool IsButtonDisabled()
    {
        return isCheckingRegistration || isUserRegistered;
    }

    private Color GetButtonColor()
    {
        return isUserRegistered ? Color.Success : Color.Primary;
    }

    private void AddToGoogleCalendar()
    {
        // To be implemented
        Console.WriteLine("Add to Google Calendar clicked");
    }

    private void AddToAppleCalendar()
    {
        // To be implemented
        Console.WriteLine("Add to Apple Calendar (.ics) clicked");
    }

    private void AddToOutlookCalendar()
    {
        // To be implemented
        Console.WriteLine("Add to Outlook Calendar (.ics) clicked");
    }
}
