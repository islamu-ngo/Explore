@page "/event/detail/{id}"
@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services
@using Microsoft.AspNetCore.Components
@using Explore.Blazor.Client.Components.Event
@using Explore.Blazor.Client.Services.Contracts

<PageTitle>Event Detail</PageTitle>
<MudContainer Class="event-detail">
    <MudGrid>

        <!-- Back and Actions -->
        <MudItem xs="12">
            <div class="event-detail__top-nav">
                <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                           Variant="Variant.Text"
                           Color="Color.Secondary"
                           Href="/events"
                           Class="event-detail__back-btn">
                    Back to Events
                </MudButton>

                @if (_eventDetails != null)
                {
                    <div class="event-detail__actions">
                        <MudButton StartIcon="@Icons.Material.Filled.Edit"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Href="@($"/event/edit/{EventId}")">
                            Edit
                        </MudButton>
                        @if (_canDelete && !_isCheckingAuth)
                        {
                            <MudButton StartIcon="@Icons.Material.Filled.Delete"
                                       Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="OpenDeleteDialog">
                                Delete
                            </MudButton>
                        }
                    </div>
                }
            </div>
        </MudItem>

        @if (_eventDetails != null)
        {
            <!-- Main Content Area -->
            <MudItem xs="12" md="8">
                <MudStack Spacing="4">

                    <!-- Header Section (Title & Badges) -->
                    <div class="event-detail__header-section">
                        <div class="event-detail__badges mb-3">
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                                @(_eventDetails.EventTypeFullName ?? "Event")
                            </MudChip>
                            <MudChip T="string" Color="Color.Surface" Variant="Variant.Outlined" Size="Size.Small">
                                @(_eventDetails.EventFormatFullName ?? "Online")
                            </MudChip>
                        </div>
                        <MudText Typo="Typo.h3" Class="event-detail__title mb-2">@_eventDetails.Title</MudText>

                        <div class="event-detail__organizer-row mt-2">
                            <MudAvatar Size="Size.Small" Class="mr-2">
                                <MudImage Src="@GetOrganizerProfilePicture()" />
                            </MudAvatar>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Hosted by <strong>@GetOrganizerName()</strong>
                            </MudText>
                        </div>
                    </div>

                    <!-- Featured Image -->
                    <div class="event-detail__image-wrapper">
                        @if (!string.IsNullOrEmpty(_eventDetails.FeaturedImageUri))
                        {
                            <MudImage Src="@_eventDetails.FeaturedImageUri" Alt="@_eventDetails.Title" Class="event-detail__image" ObjectFit="ObjectFit.Cover" />
                        }
                        else
                        {
                            <MudImage Src="@($"https://dummyimage.com/1600x900/{GetEventColor()}/ffffff&text={Uri.EscapeDataString(_eventDetails.Title)}")" Alt="@_eventDetails.Title" Class="event-detail__image" ObjectFit="ObjectFit.Cover" />
                        }
                    </div>

                    <!-- Description -->
                    <MudPaper Elevation="0" Class="event-detail__section-card pa-6">
                        <MudText Typo="Typo.h5" Class="mb-4">About this event</MudText>
                        <MudText Typo="Typo.body1" Class="event-detail__description">
                            @_eventDetails.Description
                        </MudText>
                    </MudPaper>

                    <!-- Event Aspects (Islamic and Tech) -->
                    @if (_islamicAspect != null || _techAspect != null || _canEdit)
                    {
                        <MudPaper Elevation="0" Class="event-detail__section-card pa-6">
                            <div class="d-flex justify-space-between align-center mb-4">
                                <MudText Typo="Typo.h5">Event Characteristics</MudText>
                                @if (_canEdit && (_islamicAspect == null || _techAspect == null))
                                {
                                    <MudMenu Icon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary">
                                        @if (_islamicAspect == null)
                                        {
                                            <MudMenuItem OnClick="OpenAddIslamicAspectDialog">
                                                <div class="d-flex align-center gap-2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Mosque" Size="Size.Small" />
                                                    <span>Add Islamic Characteristics</span>
                                                </div>
                                            </MudMenuItem>
                                        }
                                        @if (_techAspect == null)
                                        {
                                            <MudMenuItem OnClick="OpenAddTechAspectDialog">
                                                <div class="d-flex align-center gap-2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" />
                                                    <span>Add Tech Characteristics</span>
                                                </div>
                                            </MudMenuItem>
                                        }
                                    </MudMenu>
                                }
                            </div>

                            <MudStack Spacing="3">
                                @if (_islamicAspect != null)
                                {
                                    <EventIslamicAspectCard Aspect="_islamicAspect"
                                                            EventId="EventId"
                                                            ShowActions="_canEdit"
                                                            OnEdit="OpenEditIslamicAspectDialog"
                                                            OnDelete="ConfirmDeleteIslamicAspect" />
                                }

                                @if (_techAspect != null)
                                {
                                    <EventTechAspectCard Aspect="_techAspect"
                                                         EventId="EventId"
                                                         ShowActions="_canEdit"
                                                         OnEdit="OpenEditTechAspectDialog"
                                                         OnDelete="ConfirmDeleteTechAspect" />
                                }

                                @if (_islamicAspect == null && _techAspect == null && !_canEdit)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        No special characteristics defined for this event.
                                    </MudText>
                                }
                            </MudStack>
                        </MudPaper>
                    }

                    <!-- Sessions / Agenda (Only if multiple) -->
                    @if (_eventSessions != null && _eventSessions.Count > 1)
                    {
                        <MudPaper Elevation="0" Class="event-detail__section-card pa-6">
                            <MudText Typo="Typo.h5" Class="mb-4">Sessions</MudText>
                            <EventSessionManager EventId="EventId" ShowRegisterButton="true" OnRegisterClick="RegisterForSession" />
                        </MudPaper>
                    }

                </MudStack>
            </MudItem>

            <!-- Sidebar (Sticky) -->
            <MudItem xs="12" md="4">
                <div class="event-detail__sidebar">
                    <MudPaper Elevation="0" Class="event-detail__ticket-card pa-6">
                        <div class="d-flex justify-space-between align-center mb-6">
                            <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: 700;">
                                @(_eventDetails.Price.HasValue && _eventDetails.Price > 0 ? $"{_eventDetails.CurrencyCode ?? "€"}{_eventDetails.Price:F2}" : "Free")
                            </MudText>
                            @if (_eventDetails.IsRegistrationRequired == true)
                            {
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text">Registration Required</MudChip>
                            }
                        </div>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Large"
                                   FullWidth="true"
                                   Class="mb-6 py-3"
                                   OnClick="OpenRegistrationDialog"
                                   Disabled="IsButtonDisabled()"
                                   StartIcon="@(_isUserRegistered ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.ConfirmationNumber)">
                            @GetButtonText()
                        </MudButton>

                        @if (_isUserRegistered)
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Text" Dense="true" Class="mb-4">
                                You are registered for this event!
                            </MudAlert>
                        }

                        <MudDivider Class="mb-6" />

                        <div class="event-detail__sidebar-info">
                            <div class="sidebar-info__item mb-4">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Secondary" Class="mr-3" />
                                <div>
                                    <MudText Typo="Typo.subtitle2">Date & Time</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@GetDateDisplay()</MudText>
                                </div>
                            </div>

                            <div class="sidebar-info__item mb-4">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Secondary" Class="mr-3" />
                                <div>
                                    <MudText Typo="Typo.subtitle2">Location</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@GetLocationDisplay()</MudText>
                                    @if (_eventDetails.EventFormatId == 2)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">(Online Event)</MudText>
                                    }
                                </div>
                            </div>
                        </div>

                        <MudDivider Class="my-4" />

                        <MudText Typo="Typo.subtitle2" Class="mb-2">Share with friends</MudText>
                        <div class="d-flex gap-2">
                            <MudIconButton Icon="@Icons.Custom.Brands.Facebook" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" />
                            <MudIconButton Icon="@Icons.Custom.Brands.Twitter" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" />
                            <MudIconButton Icon="@Icons.Custom.Brands.LinkedIn" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" />
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Title="Copy Link" />
                        </div>

                    </MudPaper>
                </div>
            </MudItem>
        }
        else if (_isLoading)
        {
            <MudItem xs="12">
                <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="py-8">
                    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                    <MudText Typo="Typo.body1">Loading details...</MudText>
                </MudStack>
            </MudItem>
        }
        else
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Warning">
                    Event not found.
                </MudAlert>
            </MudItem>
        }
    </MudGrid>
</MudContainer>
