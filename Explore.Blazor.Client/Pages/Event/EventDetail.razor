@page "/event/detail/{id}"
@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services
@using Microsoft.AspNetCore.Components
@using Explore.Blazor.Client.Components.Event
@using Explore.Blazor.Client.Services.Contracts

<PageTitle>Event Detail</PageTitle>

@if (_eventDetails != null)
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-8">
        <MudGrid Spacing="4">
            <!-- Back and Actions -->
            <MudItem xs="12">
                <div class="d-flex justify-space-between align-center flex-wrap gap-4">
                    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                               Variant="Variant.Text"
                               Color="Color.Secondary"
                               Href="/events"
                               Class="rounded-pill">
                        Back to Events
                    </MudButton>

                    <div class="d-flex gap-2">
                        @if (_canEdit)
                        {
                            <MudButton StartIcon="@Icons.Material.Filled.Edit"
                                       Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Href="@($"/event/edit/{EventId}")"
                                       Class="rounded-pill">
                                Edit
                            </MudButton>
                        }
                        @if (_canDelete && !_isCheckingAuth)
                        {
                            <MudButton StartIcon="@Icons.Material.Filled.Delete"
                                       Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="OpenDeleteDialog"
                                       Class="rounded-pill">
                                Delete
                            </MudButton>
                        }
                    </div>
                </div>
            </MudItem>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_errorMessage</MudAlert>
                </MudItem>
            }

            <!-- Main Content Area -->
            <MudItem xs="12" md="8">
                <MudStack Spacing="6">

                    <!-- Header Section -->
                    <div>
                        <div class="d-flex gap-2 mb-4">
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                                @(_eventDetails.EventTypeFullName ?? "Event")
                            </MudChip>
                            <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
                                @(_eventDetails.EventFormatFullName ?? "Online")
                            </MudChip>
                        </div>
                        
                        <MudText Typo="Typo.h3" Style="font-weight: 800;" Class="mb-4">@_eventDetails.Title</MudText>

                        <div class="d-flex align-center gap-3">
                            <MudAvatar Size="Size.Medium">
                                <MudImage Src="@GetOrganizerProfilePicture()" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Hosted by</MudText>
                                <MudText Typo="Typo.body2" Style="font-weight: 700;">@GetOrganizerName()</MudText>
                            </div>
                        </div>
                    </div>

                    <!-- Featured Image -->
                    <MudPaper Elevation="0" Class="rounded-xl overflow-hidden" Style="aspect-ratio: 16/9; position: relative;">
                        @if (!string.IsNullOrEmpty(_eventDetails.FeaturedImageUri))
                        {
                            <MudImage Src="@_eventDetails.FeaturedImageUri" Alt="@_eventDetails.Title" ObjectFit="ObjectFit.Cover" Style="width: 100%; height: 100%;" />
                        }
                        else
                        {
                            <MudImage Src="@($"https://dummyimage.com/1600x900/{GetEventColor()}/ffffff&text={Uri.EscapeDataString(_eventDetails.Title)}")" Alt="@_eventDetails.Title" ObjectFit="ObjectFit.Cover" Style="width: 100%; height: 100%;" />
                        }
                    </MudPaper>

                    <!-- Description -->
                    <MudPaper Elevation="0" Class="pa-6 border-solid border-1 mud-border-lines-default rounded-xl">
                        <MudText Typo="Typo.h5" Style="font-weight: 700;" Class="mb-4">About this event</MudText>
                        <MudText Typo="Typo.body1" Style="line-height: 1.8; white-space: pre-wrap;">
                            @_eventDetails.Description
                        </MudText>
                    </MudPaper>

                    <!-- Event Aspects (Islamic and Tech) -->
                    @if (_islamicAspect != null || _techAspect != null || _canEdit)
                    {
                        <MudPaper Elevation="0" Class="pa-6 border-solid border-1 mud-border-lines-default rounded-xl">
                            <div class="d-flex justify-space-between align-center mb-6">
                                <MudText Typo="Typo.h5" Style="font-weight: 700;">Event Characteristics</MudText>
                                @if (_canEdit && (_islamicAspect == null || _techAspect == null))
                                {
                                    <MudMenu Icon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" Dense="true">
                                        @if (_islamicAspect == null)
                                        {
                                            <MudMenuItem OnClick="OpenAddIslamicAspectDialog">
                                                <div class="d-flex align-center gap-2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Mosque" Size="Size.Small" />
                                                    <span>Add Islamic Characteristics</span>
                                                </div>
                                            </MudMenuItem>
                                        }
                                        @if (_techAspect == null)
                                        {
                                            <MudMenuItem OnClick="OpenAddTechAspectDialog">
                                                <div class="d-flex align-center gap-2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" />
                                                    <span>Add Tech Characteristics</span>
                                                </div>
                                            </MudMenuItem>
                                        }
                                    </MudMenu>
                                }
                            </div>

                            <MudStack Spacing="4">
                                @if (_islamicAspect != null)
                                {
                                    <EventIslamicAspectCard Aspect="_islamicAspect"
                                                            EventId="EventId"
                                                            ShowActions="_canEdit"
                                                            OnEdit="OpenEditIslamicAspectDialog"
                                                            OnDelete="ConfirmDeleteIslamicAspect" />
                                }

                                @if (_techAspect != null)
                                {
                                    <EventTechAspectCard Aspect="_techAspect"
                                                         EventId="EventId"
                                                         ShowActions="_canEdit"
                                                         OnEdit="OpenEditTechAspectDialog"
                                                         OnDelete="ConfirmDeleteTechAspect" />
                                }

                                @if (_islamicAspect == null && _techAspect == null && !_canEdit)
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        No special characteristics defined for this event.
                                    </MudText>
                                }
                            </MudStack>
                        </MudPaper>
                    }

                    <!-- Sessions / Agenda -->
                    @if (_eventSessions != null && _eventSessions.Count > 1)
                    {
                        <MudPaper Elevation="0" Class="pa-6 border-solid border-1 mud-border-lines-default rounded-xl">
                            <MudText Typo="Typo.h5" Style="font-weight: 700;" Class="mb-4">Sessions</MudText>
                            <EventSessionManager EventId="EventId" ShowRegisterButton="true" OnRegisterClick="RegisterForSession" />
                        </MudPaper>
                    }

                </MudStack>
            </MudItem>

            <!-- Sidebar (Sticky) -->
            <MudItem xs="12" md="4">
                <div style="position: sticky; top: 24px;">
                    <MudPaper Elevation="4" Class="pa-6 rounded-xl">
                        <div class="d-flex justify-space-between align-center mb-6">
                            <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: 800;">
                                @(_eventDetails.Price.HasValue && _eventDetails.Price > 0 ? $"{_eventDetails.CurrencyCode ?? "€"}{_eventDetails.Price:F2}" : "Free")
                            </MudText>
                            @if (_eventDetails.IsRegistrationRequired == true)
                            {
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text">Registration Required</MudChip>
                            }
                        </div>

                        <MudButton Variant="Variant.Filled"
                                   Color="GetButtonColor()"
                                   Size="Size.Large"
                                   FullWidth="true"
                                   Class="mb-6 py-3 rounded-lg"
                                   OnClick="OpenRegistrationDialog"
                                   Disabled="IsButtonDisabled()"
                                   StartIcon="@(_isUserRegistered ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.ConfirmationNumber)">
                            @GetButtonText()
                        </MudButton>

                        @if (_isUserRegistered)
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Text" Dense="true" Class="mb-4">
                                You are registered for this event!
                            </MudAlert>
                        }

                        <MudDivider Class="mb-6" />

                        <MudStack Spacing="4">
                            <div class="d-flex gap-3">
                                <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Secondary" />
                                <div>
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Date & Time</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@GetDateDisplay()</MudText>
                                </div>
                            </div>

                            <div class="d-flex gap-3">
                                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Secondary" />
                                <div>
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Location</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@GetLocationDisplay()</MudText>
                                    @if (_eventDetails.EventFormatId == 2)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">(Online Event)</MudText>
                                    }
                                </div>
                            </div>
                        </MudStack>

                        <MudDivider Class="my-6" />

                        <MudText Typo="Typo.subtitle2" Class="mb-2">Share</MudText>
                        <div class="d-flex gap-2">
                            <MudIconButton Icon="@Icons.Custom.Brands.Facebook" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" />
                            <MudIconButton Icon="@Icons.Custom.Brands.Twitter" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" />
                            <MudIconButton Icon="@Icons.Custom.Brands.LinkedIn" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" />
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Title="Copy Link" />
                        </div>

                    </MudPaper>
                </div>
            </MudItem>
        </MudGrid>
    </MudContainer>
}
else if (_isLoading)
{
    <div class="d-flex flex-column align-center justify-center py-16">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        <MudText Typo="Typo.body1" Class="mt-4" Color="Color.Secondary">Loading details...</MudText>
    </div>
}
else
{
    <MudContainer Class="py-8">
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
            Event not found.
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/events" Class="mt-4">Back to Events</MudButton>
    </MudContainer>
}
