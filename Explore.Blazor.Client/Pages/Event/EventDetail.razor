@page "/event/detail/{id}"
@rendermode InteractiveServer
@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Services
@using Microsoft.AspNetCore.Components
@using Explore.Blazor.Client.Components.Event
@using Explore.Blazor.Client.Services.Contracts

<PageTitle>@(_eventDetails?.Title ?? "Event Detail")</PageTitle>

@if (_eventDetails != null)
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-8">
        <!-- Breadcrumb / Back Navigation -->
        <div class="mb-6">
            <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                       Variant="Variant.Text"
                       Color="Color.Default"
                       Href="/events"
                       Class="px-0 hover:bg-transparent text-secondary">
                Back to Events
            </MudButton>
        </div>

        <MudGrid Spacing="6">
            
            <!-- LEFT COLUMN: Main Content (Hero + Details) -->
            <MudItem xs="12" md="8">
                <MudStack Spacing="6">
                    
                    <!-- Hero Image (Clean, No Overlay) -->
                    <div class="rounded-xl overflow-hidden shadow-sm border border-gray-200 position-relative" style="aspect-ratio: 16/9; width: 100%; background-color: @GetEventColor();">
                        @if (!string.IsNullOrEmpty(_eventDetails.FeaturedImageUri))
                        {
                            <MudImage Src="@_eventDetails.FeaturedImageUri" ObjectFit="ObjectFit.Cover" Class="w-100 h-100" />
                        }
                        else if (!string.IsNullOrWhiteSpace(_appearance.BackgroundMediaUrl))
                        {
                            <MudImage Src="@_appearance.BackgroundMediaUrl" ObjectFit="ObjectFit.Cover" Class="w-100 h-100" />
                        }
                        else
                        {
                            <!-- Fallback Placeholder -->
                            <div class="d-flex align-center justify-center h-100 w-100" style="background: linear-gradient(135deg, @GetEventColor() 0%, darken(@GetEventColor(), 20%) 100%);">
                                <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Large" Color="Color.Surface" Style="font-size: 6rem; opacity: 0.2;" />
                            </div>
                        }

                        <!-- Admin Controls (Overlay) -->
                        @if (_canEdit || (_canDelete && !_isCheckingAuth))
                        {
                            <div class="absolute top-4 right-4 d-flex gap-2">
                                @if (_canEdit)
                                {
                                    <MudTooltip Text="Edit Event">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" Color="Color.Surface" Size="Size.Small" Href="@($"/event/edit/{EventId}")" />
                                    </MudTooltip>
                                }
                                @if (_canDelete && !_isCheckingAuth)
                                {
                                    <MudTooltip Text="Delete Event">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="OpenDeleteDialog" />
                                    </MudTooltip>
                                }
                            </div>
                        }
                    </div>

                    <!-- Header Info (Below Image) -->
                    <div>
                        <!-- Date Badge -->
                        <div class="d-flex align-center gap-3 mb-2">
                            <MudText Typo="Typo.h6" Color="Color.Error" Style="font-weight: 800; text-transform: uppercase;">
                                @(_primarySession?.StartTime.HasValue == true ? _primarySession.StartTime.Value.ToString("MMM dd, dddd") : "Date TBD")
                            </MudText>
                        </div>

                        <MudText Typo="Typo.h3" Style="font-weight: 900; line-height: 1.2;" Class="mb-2">
                            @_eventDetails.Title
                        </MudText>
                        
                        @if (!string.IsNullOrEmpty(_eventDetails.Subtitle))
                        {
                            <MudText Typo="Typo.h6" Color="Color.Secondary" Style="font-weight: 400;">
                                @_eventDetails.Subtitle
                            </MudText>
                        }

                        <!-- Organizer -->
                        <div class="d-flex align-center gap-3 mt-6">
                            <MudAvatar Size="Size.Medium" Color="Color.Primary" Variant="Variant.Outlined">
                                @if (!string.IsNullOrEmpty(GetOrganizerProfilePicture()))
                                {
                                    <MudImage Src="@GetOrganizerProfilePicture()" />
                                }
                                else
                                {
                                    @GetOrganizerName().FirstOrDefault()
                                }
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Hosted by</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight: 700;">@GetOrganizerName()</MudText>
                            </div>
                        </div>
                    </div>

                    <MudDivider />

                    <!-- About Section -->
                    <section>
                        <MudText Typo="Typo.h5" Style="font-weight: 800;" Class="mb-4">About this event</MudText>
                        
                        <!-- Tags -->
                        <div class="d-flex flex-wrap gap-2 mb-6">
                            <MudChip T="string" Label="true" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                @(_eventDetails.EventTypeFullName ?? "Event")
                            </MudChip>
                            <MudChip T="string" Label="true" Size="Size.Small" Variant="Variant.Outlined">
                                @(_eventDetails.EventFormatFullName ?? "Format")
                            </MudChip>
                            @if (_islamicAspect != null)
                            {
                                <MudChip T="string" Icon="@Icons.Material.Filled.Mosque" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">Islamic Event</MudChip>
                            }
                            @if (_techAspect != null)
                            {
                                <MudChip T="string" Icon="@Icons.Material.Filled.Code" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">Tech Event</MudChip>
                            }
                        </div>

                        <MudText Typo="Typo.body1" Style="white-space: pre-wrap; line-height: 1.8; color: var(--mud-palette-text-primary);">
                            @_eventDetails.Description
                        </MudText>
                    </section>

                    <!-- Event Details (Characteristics) -->
                    @if (_islamicAspect != null || _techAspect != null || _canEdit)
                    {
                        <div class="mt-4">
                            <div class="d-flex justify-space-between align-center mb-4">
                                <MudText Typo="Typo.h5" Style="font-weight: 800;">Characteristics</MudText>
                                @if (_canEdit && (_islamicAspect == null || _techAspect == null))
                                {
                                    <MudMenu Icon="@Icons.Material.Filled.Add" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Dense="true" Label="Add Details">
                                        @if (_islamicAspect == null)
                                        {
                                            <MudMenuItem OnClick="OpenAddIslamicAspectDialog">Add Islamic Info</MudMenuItem>
                                        }
                                        @if (_techAspect == null)
                                        {
                                            <MudMenuItem OnClick="OpenAddTechAspectDialog">Add Tech Info</MudMenuItem>
                                        }
                                    </MudMenu>
                                }
                            </div>

                            <MudGrid>
                                @if (_islamicAspect != null)
                                {
                                    <MudItem xs="12">
                                        <EventIslamicAspectCard Aspect="_islamicAspect"
                                                                EventId="EventId"
                                                                ShowActions="_canEdit"
                                                                OnEdit="OpenEditIslamicAspectDialog"
                                                                OnDelete="ConfirmDeleteIslamicAspect" />
                                    </MudItem>
                                }
                                @if (_techAspect != null)
                                {
                                    <MudItem xs="12">
                                        <EventTechAspectCard Aspect="_techAspect"
                                                             EventId="EventId"
                                                             ShowActions="_canEdit"
                                                             OnEdit="OpenEditTechAspectDialog"
                                                             OnDelete="ConfirmDeleteTechAspect" />
                                    </MudItem>
                                }
                            </MudGrid>
                        </div>
                    }

                    <!-- Agenda / Sessions -->
                    @if (_eventSessions != null && _eventSessions.Count > 1)
                    {
                        <div class="mt-4">
                            <MudText Typo="Typo.h5" Style="font-weight: 800;" Class="mb-4">Agenda</MudText>
                            <EventSessionManager EventId="EventId" ShowRegisterButton="false" />
                        </div>
                    }

                </MudStack>
            </MudItem>

            <!-- RIGHT COLUMN: Sticky Sidebar -->
            <MudItem xs="12" md="4">
                <div style="position: sticky; top: 100px;">
                    <MudPaper Elevation="0" Outlined="true" Class="rounded-xl border border-gray-200 overflow-hidden">
                        
                        <!-- Registration Card -->
                        <div class="pa-6">
                            <div class="d-flex align-center justify-start mb-2">
                                @if (_eventDetails.Price.HasValue && _eventDetails.Price > 0)
                                {
                                    <MudText Typo="Typo.h4" Style="font-weight: 800;">
                                        @($"{_eventDetails.CurrencyCode ?? "€"}{_eventDetails.Price:F2}")
                                    </MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.h4" Style="font-weight: 800;">Free</MudText>
                                }
                            </div>

                            <MudButton Variant="Variant.Filled"
                                       Color="GetButtonColor()"
                                       Size="Size.Large"
                                       FullWidth="true"
                                       Class="my-4 py-3 rounded-lg font-weight-bold"
                                       OnClick="OpenRegistrationDialog"
                                       Disabled="IsButtonDisabled()"
                                       Elevation="0"
                                       StartIcon="@(_isUserRegistered ? Icons.Material.Filled.CheckCircle : null)">
                                @GetButtonText()
                            </MudButton>

                            @if (_isUserRegistered)
                            {
                                <div class="text-center">
                                    <MudText Typo="Typo.body2" Color="Color.Success" Class="mb-1">You are going to this event!</MudText>
                                    <MudLink OnClick="CancelRegistrationAsync" Typo="Typo.caption" Color="Color.Error" Underline="Underline.Always">
                                        Cancel registration
                                    </MudLink>
                                </div>
                            }
                        </div>

                        <MudDivider />

                        <!-- Event Logistics -->
                        <div class="pa-6">
                            <MudStack Spacing="4">
                                <!-- Date & Time -->
                                <div class="d-flex gap-3">
                                    <MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Color="Color.Primary" Size="Size.Small" />
                                    <div>
                                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Date & Time</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@GetDateDisplay()</MudText>
                                        <div class="mt-1">
                                            <MudLink Href="#" OnClick="AddToGoogleCalendar" Typo="Typo.caption" Color="Color.Primary">Add to calendar</MudLink>
                                        </div>
                                    </div>
                                </div>

                                <!-- Location -->
                                <div class="d-flex gap-3">
                                    <MudIcon Icon="@Icons.Material.Outlined.LocationOn" Color="Color.Primary" Size="Size.Small" />
                                    <div>
                                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Location</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@GetFullLocation()</MudText>
                                        @if (_eventDetails.EventFormatId == 2) // Online
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Success">Online Event</MudText>
                                        }
                                        else
                                        {
                                            <div class="mt-1">
                                                <MudLink Href="#" Typo="Typo.caption" Color="Color.Primary">View Map</MudLink>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </MudStack>
                        </div>

                        <!-- Footer Actions -->
                        <div class="pa-4 bg-gray-50 border-t border-gray-100 d-flex justify-center gap-2">
                            <MudIconButton Icon="@Icons.Material.Outlined.Share" Size="Size.Small" Color="Color.Default" Title="Share Event" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Flag" Size="Size.Small" Color="Color.Default" Title="Report Event" />
                        </div>

                    </MudPaper>
                </div>
            </MudItem>

        </MudGrid>
    </MudContainer>
}
else if (_isLoading)
{
    <div class="d-flex flex-column align-center justify-center py-32">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        <MudText Typo="Typo.body1" Class="mt-4" Color="Color.Secondary">Loading details...</MudText>
    </div>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="py-16 text-center">
        <MudIcon Icon="@Icons.Material.Outlined.EventBusy" Size="Size.Large" Color="Color.Secondary" Style="font-size: 4rem;" Class="mb-4" />
        <MudText Typo="Typo.h4" Style="font-weight: 700;" Class="mb-2">Event not found</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">The event you are looking for might have been removed or is unavailable.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/events" Size="Size.Large">Browse Events</MudButton>
    </MudContainer>
}
