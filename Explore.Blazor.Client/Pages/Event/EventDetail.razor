    protected override void OnInitialized()
    {
        selectedEvent = mockEvents.FirstOrDefault(e => e.Id == EventId);
    }

    private string GetCountryFromLocation(string location)
        => location == "Online" ? "Online"
           : (location.Split(',').LastOrDefault()?.Trim() ?? location);

    private string GetEventColor(MockEvent evt)
    {
        // Generate color based on category or use a default color scheme
        return evt.Category switch
        {
            "lecture" => "2196F3",    // Blue
            "workshop" => "FF9800",   // Orange
            "social" => "4CAF50",     // Green
            "charity" => "E91E63",    // Pink
            "education" => "9C27B0",  // Purple
            _ => "607D8B"             // Blue Grey
        };
    }
}
