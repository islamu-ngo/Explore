<!-- FOOTER -->
<footer class="site-footer">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudGrid Spacing="4">
            <!-- Brand Column -->
            <MudItem xs="12" md="4">
                <div class="footer-brand">
                    <MudIcon Icon="@Icons.Material.Filled.Explore" Color="Color.Primary" Size="Size.Large" />
                    <div class="footer-brand-text">ISLAMU<span class="footer-brand-highlight">Explore</span></div>
                </div>
                <MudText Class="footer-desc">
                    Connecting Muslims through meaningful events, gatherings, and community building initiatives across the globe.
                </MudText>
            </MudItem>

            <!-- Links -->
            <MudItem xs="12" md="8">
                <MudGrid>
                    <MudItem xs="6" sm="4">
                        <div class="footer-heading">Platform</div>
                        <a href="/events" class="footer-link">Browse Events</a>
                        <a href="/event/categories" class="footer-link">Categories</a>
                        <a href="/organizations" class="footer-link">Organizations</a>
                    </MudItem>
                    
                    <MudItem xs="6" sm="4">
                        <div class="footer-heading">Company</div>
                        <a href="/about" class="footer-link">About Us</a>
                        <a href="/contact" class="footer-link">Contact</a>
                        <a href="/careers" class="footer-link">Careers</a>
                    </MudItem>

                    <MudItem xs="6" sm="4">
                        <div class="footer-heading">Legal</div>
                        <a href="/privacy" class="footer-link">Privacy Policy</a>
                        <a href="/terms" class="footer-link">Terms of Service</a>
                        <a href="/cookies" class="footer-link">Cookie Settings</a>
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-8" />

        <div class="d-flex flex-column flex-sm-row justify-space-between align-center gap-4">
            <div class="copyright-text">
                &copy; @DateTime.Now.Year ISLAMU Explore. All rights reserved.
            </div>
            
            <div class="d-flex gap-2">
                <MudIconButton Icon="@Icons.Custom.Brands.Facebook" Class="social-btn" Size="Size.Small" />
                <MudIconButton Icon="@Icons.Custom.Brands.Twitter" Class="social-btn" Size="Size.Small" />
                <MudIconButton Icon="@Icons.Custom.Brands.Instagram" Class="social-btn" Size="Size.Small" />
                <MudIconButton Icon="@Icons.Custom.Brands.LinkedIn" Class="social-btn" Size="Size.Small" />
            </div>
        </div>
    </MudContainer>
</footer>

