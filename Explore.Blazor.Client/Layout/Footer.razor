<MudGrid Class="mt-8">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudStack>
                    <MudStack Row AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.Favorite" Color="Color.Error" />
                        <MudText Typo="Typo.h6">ISLAMU Explore</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2">Connecting Muslims through meaningful events and gatherings.</MudText>
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="8">
                <MudGrid>
                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.subtitle2" Class="mb-4">Explore</MudText>
                        <MudStack Spacing="2">
                            <MudLink Href="/event">Events</MudLink>
                            <MudLink Href="/event/categories">Categories</MudLink>
                            <MudLink Href="/event/create">Create Event</MudLink>
                        </MudStack>
                    </MudItem>

                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.subtitle2" Class="mb-4">Company</MudText>
                        <MudStack Spacing="2">
                            <MudLink Href="/about">About</MudLink>
                            <MudLink Href="/contact">Contact</MudLink>
                            <MudLink Href="/careers">Careers</MudLink>
                        </MudStack>
                    </MudItem>

                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.subtitle2" Class="mb-4">Resources</MudText>
                        <MudStack Spacing="2">
                            <MudLink Href="/blog">Blog</MudLink>
                            <MudLink Href="/help">Help Center</MudLink>
                            <MudLink Href="/guidelines">Guidelines</MudLink>
                        </MudStack>
                    </MudItem>

                    <MudItem xs="6" sm="3">
                        <MudText Typo="Typo.subtitle2" Class="mb-4">Legal</MudText>
                        <MudStack Spacing="2">
                            <MudLink Href="/privacy">Privacy</MudLink>
                            <MudLink Href="/terms">Terms</MudLink>
                            <MudLink Href="/cookies">Cookie Policy</MudLink>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-6" />

        <MudGrid AlignItems="AlignItems.Center">
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.body2">&copy; 2025 ISLAMU. All rights reserved.</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" Class="d-flex justify-end">
                <MudStack Row>
                    <MudIconButton Icon="@Icons.Custom.Brands.Facebook" Color="Color.Default" Size="Size.Small" />
                    <MudIconButton Icon="@Icons.Custom.Brands.Twitter" Color="Color.Default" Size="Size.Small" />
                    <MudIconButton Icon="@Icons.Custom.Brands.Instagram" Color="Color.Default" Size="Size.Small" />
                    <MudIconButton Icon="@Icons.Custom.Brands.YouTube" Color="Color.Default" Size="Size.Small" />
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudContainer>
</MudGrid>
