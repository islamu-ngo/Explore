<!--
    Footer Component - BEM Methodology
    Block: site-footer
    Elements: __brand, __brand-icon, __brand-text, __brand-highlight, __description,
              __section, __heading, __link, __bottom, __copyright, __social, __social-btn
-->
@inject IPublicExperienceService PublicExperienceService

<div class="site-footer-root">
<footer class="site-footer">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudGrid Spacing="4">
            <!-- Brand Column -->
            <MudItem xs="12" md="4">
                <div class="site-footer__brand">
                    @if (!string.IsNullOrWhiteSpace(_brandLogoUrl))
                    {
                        <MudImage Src="@_brandLogoUrl" Alt="@_brandDisplayName" Width="28" Height="28" Class="site-footer__brand-icon" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Explore" Color="Color.Primary" Size="Size.Large" Class="site-footer__brand-icon" />
                    }
                    <div class="site-footer__brand-text">@_brandDisplayName</div>
                </div>
                <MudText Class="site-footer__description">
                    Connecting Muslims through meaningful events, gatherings, and community building initiatives across the globe.
                </MudText>
            </MudItem>

            <!-- Links -->
            <MudItem xs="12" md="8">
                <MudGrid>
                    <MudItem xs="6" sm="4">
                        <div class="site-footer__section">
                            <div class="site-footer__heading">Platform</div>
                            <a href="/events" class="site-footer__link">Browse Events</a>
                            <a href="/event/categories" class="site-footer__link">Categories</a>
                            <a href="/organizations" class="site-footer__link">Organizations</a>
                        </div>
                    </MudItem>

                    <MudItem xs="6" sm="4">
                        <div class="site-footer__section">
                            <div class="site-footer__heading">Company</div>
                            <a href="/about" class="site-footer__link">About Us</a>
                            <a href="/contact" class="site-footer__link">Contact</a>
                            <a href="/careers" class="site-footer__link">Careers</a>
                        </div>
                    </MudItem>

                    <MudItem xs="6" sm="4">
                        <div class="site-footer__section">
                            <div class="site-footer__heading">Legal</div>
                            <a href="/privacy" class="site-footer__link">Privacy Policy</a>
                            <a href="/terms" class="site-footer__link">Terms of Service</a>
                            <a href="/cookies" class="site-footer__link">Cookie Settings</a>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-8" />

        <div class="site-footer__bottom">
            <div class="site-footer__copyright">
                &copy; @DateTime.Now.Year @_brandDisplayName. All rights reserved.
            </div>

            <div class="site-footer__social">
                <MudIconButton Icon="@Icons.Custom.Brands.Facebook" AriaLabel="Facebook" Title="Visit our Facebook page" Class="site-footer__social-btn" Size="Size.Small" />
                <MudIconButton Icon="@Icons.Custom.Brands.Twitter" AriaLabel="Twitter" Title="Visit our Twitter page" Class="site-footer__social-btn" Size="Size.Small" />
                <MudIconButton Icon="@Icons.Custom.Brands.Instagram" AriaLabel="Instagram" Title="Visit our Instagram page" Class="site-footer__social-btn" Size="Size.Small" />
                <MudIconButton Icon="@Icons.Custom.Brands.LinkedIn" AriaLabel="LinkedIn" Title="Visit our LinkedIn page" Class="site-footer__social-btn" Size="Size.Small" />
            </div>
        </div>
    </MudContainer>
</footer>
</div>

@code {
    private string _brandDisplayName = "ISLAMU Explore";
    private string _brandLogoUrl = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var settings = await PublicExperienceService.GetSettingsAsync();
        if (settings == null)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(settings.BrandDisplayName))
        {
            _brandDisplayName = settings.BrandDisplayName;
        }

        _brandLogoUrl = settings.BrandLogoUrl ?? string.Empty;
    }
}
