@* ABOUTME: Minimal layout used during first-run setup to avoid exposing full app chrome before onboarding. *@
@* ABOUTME: Renders setup pages with Mud providers but without nav/footer links. Includes theme toggle. *@

@inherits LayoutComponentBase

<div class="setup-layout-root" style="margin:0;padding:0;width:100vw;min-height:100vh;overflow-x:hidden;">
    <MudThemeProvider @ref="_mudThemeProvider" Theme="@_theme" @bind-IsDarkMode="@_isDarkMode" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout Style="padding:0;margin:0;">
        <MudMainContent Style="padding:0;margin:0;padding-top:0;">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Rounded.AutoMode : Icons.Material.Outlined.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="ToggleDarkMode"
                           Style="position:fixed;top:12px;right:12px;z-index:10;background:var(--mud-palette-surface);box-shadow:0 1px 4px rgba(0,0,0,0.15);"
                           aria-label="Toggle dark mode" />
            @Body
        </MudMainContent>
    </MudLayout>
</div>
