@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<style>
/* ===== NAV WRAP ===== */
.topnav {
    position: sticky; top: 0; z-index: 50;
    width: 100%;
    padding: 10px 24px;
    background: color-mix(in srgb, var(--mud-palette-background-paper) 95%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--mud-palette-text-primary) 8%, transparent);
    box-shadow: 0 2px 20px rgba(0,0,0,.08);
}

/* Layout rows */
.nav-container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
}

.nav-row {
    display: flex; 
    align-items: center; 
    justify-content: space-between;
    gap: 24px;
    min-height: 60px;
}

/* ===== LEFT BRAND / HOME ===== */
.brand a.mud-nav-link {
    border-radius: 999px;
    padding: 8px 12px;
    font-weight: 700;
    letter-spacing: .2px;
    background: color-mix(in srgb, var(--mud-palette-primary) 10%, transparent);
    color: var(--mud-palette-primary-contrast-text) !important;
    box-shadow: 0 6px 16px color-mix(in srgb, var(--mud-palette-primary) 25%, transparent);
}
.brand a.mud-nav-link:hover {
    transform: translateY(-1px);
}

/* ===== CENTER LINKS ===== */
.center-links {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    max-width: 500px;
    margin: 0 auto;
    gap: 16px;
}

.pill a.mud-nav-link {
    border-radius: 999px;
    padding: 8px 16px;
    transition: background .15s ease, color .15s ease, transform .15s ease;
    white-space: nowrap;
    max-width: 100px;
    text-align: center;
    font-size: 0.875rem;
}
.pill a.mud-nav-link:hover {
    background: color-mix(in srgb, var(--mud-palette-primary) 10%, transparent);
    transform: translateY(-1px);
}

/* Active underline (subtle) */
a.mud-nav-link.mud-nav-link-active {
    position: relative;
}
a.mud-nav-link.mud-nav-link-active::after {
    content: ""; position: absolute; left: 12px; right: 12px; bottom: 4px; height: 2px;
    border-radius: 2px;
    background: var(--mud-palette-primary);
    opacity: .9;
}

/* ===== SEARCH ===== */
.nav-search {
    flex: 1;
    max-width: 320px;
    min-width: 240px;
}

.nav-search .mud-input-root {
    border-radius: 999px !important;
}
.nav-search input.mud-input-slot {
    padding-left: 16px; 
    padding-right: 40px;
}
.nav-search .mud-input-adornment {
    opacity: .85;
}
.nav-search .mud-input:not(.mud-input-disabled):focus-within {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--mud-palette-primary) 30%, transparent);
    border-color: var(--mud-palette-primary);
}

/* ===== RIGHT SIDE ===== */
.nav-actions .mud-button-root {
    border-radius: 999px;
}
.nav-actions .mud-icon-button-root {
    border-radius: 10px;
}
.nav-actions .mud-icon-button-root:hover {
    background: color-mix(in srgb, var(--mud-palette-text-primary) 8%, transparent);
}

/* ===== USER DROPDOWN ===== */
.user-dropdown {
    position: relative;
    display: inline-block;
}

.user-dropdown-button {
    cursor: pointer;
    border-radius: 999px;
    padding: 8px 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: color-mix(in srgb, var(--mud-palette-primary) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--mud-palette-primary) 20%, transparent);
    transition: all 0.2s ease;
}

.user-dropdown-button:hover {
    background: color-mix(in srgb, var(--mud-palette-primary) 15%, transparent);
    transform: translateY(-1px);
}

.user-dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 200px;
    background: var(--mud-palette-surface);
    border: 1px solid color-mix(in srgb, var(--mud-palette-text-primary) 12%, transparent);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.2s ease;
    z-index: 1000;
}

.user-dropdown-menu.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.user-dropdown-menu a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    color: var(--mud-palette-text-primary);
    text-decoration: none;
    transition: background 0.15s ease;
    border-radius: 8px;
    margin: 4px;
}

.user-dropdown-menu a:hover {
    background: color-mix(in srgb, var(--mud-palette-primary) 10%, transparent);
}

.user-dropdown-menu a:first-child {
    margin-top: 8px;
}

.user-dropdown-menu a:last-child {
    margin-bottom: 8px;
    color: var(--mud-palette-error);
}

.user-dropdown-menu a:last-child:hover {
    background: color-mix(in srgb, var(--mud-palette-error) 10%, transparent);
}

.user-dropdown-menu svg {
    width: 20px;
    height: 20px;
    fill: var(--mud-palette-text-primary); /* Adapts to theme automatically */
}

.user-dropdown-button svg {
    fill: var(--mud-palette-text-primary); /* Adapts to theme automatically */
}

/* Logout icon keeps error color */
.user-dropdown-menu a:last-child svg {
    fill: var(--mud-palette-error) !important;
}

/* ===== RESPONSIVE ===== */
@@media (max-width: 900px){
    .nav-row { 
        flex-wrap: wrap; 
        gap: 12px;
        justify-content: center;
    }
    
    .brand { 
        order: 1; 
        width: 100%; 
        justify-content: center; 
    }
    
    .center-links { 
        order: 2; 
        width: 100%; 
        justify-content: center;
        max-width: none;
        margin: 0;
    }
    
    .nav-search { 
        flex: 1 1 100%; 
        max-width: none;
        margin: 0 20px;
    }
    
    .nav-actions { 
        order: 3; 
        width: 100%; 
        justify-content: center; 
    }
}
</style>

<div class="topnav">
    <div class="nav-container">
        <div class="nav-row">

            <!-- Left: brand / home -->
            <MudStack Row="true" Spacing="1" Class="brand">
                <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Favorite" Color="Color.Error">
                    ISLAMU Explore
                </MudNavLink>
            </MudStack>

            <!-- Center: main links + search -->
            <div class="center-links">
                <div class="pill">
                    <MudNavLink Href="/events" Match="NavLinkMatch.Prefix">Events</MudNavLink>
                </div>
                <MudTextField @bind-Value="searchText"
                              Class="nav-search"
                              Placeholder="Search events..."
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>

            <!-- Right: actions (theme + create + auth) -->
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="nav-actions">
                <MudIconButton Icon="@Icons.Material.Rounded.AutoMode"
                               Color="Color.Inherit"
                               OnClick="@OnToggleTheme"
                               aria-label="Toggle theme" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/myevents" StartIcon="@Icons.Material.Filled.Add">
                    Create
                </MudButton>

                <!-- Auth buttons -->
                <div id="auth-buttons">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/login" StartIcon="@Icons.Material.Filled.Login">Login</MudButton>
                </div>
            </MudStack>

        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnToggleTheme { get; set; }

    private string searchText = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Update navigation based on authentication status (unchanged)
            await UpdateAuthenticationUI();
        }
    }

    private async Task UpdateAuthenticationUI()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                (async function() {
                    try {
                        const response = await fetch('/auth/status', {
                            method: 'GET',
                            credentials: 'same-origin'
                        });
                        const authButtons = document.getElementById('auth-buttons');
                        
                        if (response.ok && response.status === 200) {
                            const authInfo = await response.json();
                            if (authInfo.isAuthenticated && authInfo.name) {
                                if (authButtons) {
                                    authButtons.innerHTML = `
                                        <div class='user-dropdown'>
                                            <div class='user-dropdown-button' onclick='toggleUserDropdown(event)'>
                                                <svg class='mud-icon-root mud-svg-icon' style='width:20px;height:20px;' focusable='false' viewBox='0 0 24 24' aria-hidden='true'>
                                                    <path d='M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z'></path>
                                                </svg>
                                                <span>${authInfo.name}</span>
                                                <svg class='mud-icon-root mud-svg-icon' style='width:16px;height:16px;' focusable='false' viewBox='0 0 24 24' aria-hidden='true'>
                                                    <path d='M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z'></path>
                                                </svg>
                                            </div>
                                            <div class='user-dropdown-menu' id='userDropdownMenu'>
                                                <a href='/user/profile'>
                                                    <svg focusable='false' viewBox='0 0 24 24' aria-hidden='true'>
                                                        <path d='M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z'></path>
                                                    </svg>
                                                    My Profile
                                                </a>
                                                <a href='/myevents'>
                                                    <svg focusable='false' viewBox='0 0 24 24' aria-hidden='true'>
                                                        <path d='M19,4H18V2H16V4H8V2H6V4H5A2,2 0 0,0 3,6V20A2,2 0 0,0 5,22H19A2,2 0 0,0 21,20V6A2,2 0 0,0 19,4M19,20H5V10H19V20Z'></path>
                                                    </svg>
                                                    My Events
                                                </a>
                                                <a href='/logout'>
                                                    <svg focusable='false' viewBox='0 0 24 24' aria-hidden='true'>
                                                        <path d='M17,7L15.59,8.41L18.17,11H8V13H18.17L15.59,15.59L17,17L22,12L17,7M4,5H12V3H4C2.89,3 2,3.9 2,5V19A2,2 0 0,0 4,21H12V19H4V5Z'></path>
                                                    </svg>
                                                    Logout
                                                </a>
                                            </div>
                                        </div>
                                    `;

                                    // Add global click handler to close dropdown
                                    if (!window.toggleUserDropdown) {
                                        window.toggleUserDropdown = function(event) {
                                            event.stopPropagation();
                                            const menu = document.getElementById('userDropdownMenu');
                                            if (menu) {
                                                menu.classList.toggle('show');
                                            }
                                        };

                                        // Close dropdown when clicking outside
                                        document.addEventListener('click', function(event) {
                                            const menu = document.getElementById('userDropdownMenu');
                                            const dropdown = document.querySelector('.user-dropdown');
                                            if (menu && dropdown && !dropdown.contains(event.target)) {
                                                menu.classList.remove('show');
                                            }
                                        });
                                    }
                                }
                            } else {
                                if (authButtons) {
                                    authButtons.innerHTML = `
                                        <a href='/login' class='mud-button-root mud-button mud-button-text mud-button-text-primary mud-button-text-size-medium mud-ripple'>
                                            <span class='mud-button-start-icon-container'>
                                                <svg class='mud-icon-root mud-svg-icon mud-icon-size-medium' focusable='false' viewBox='0 0 24 24' aria-hidden='true'>
                                                    <path d='M10,17V14H3V10H10V7L15,12L10,17M10,2H19A2,2 0 0,1 21,4V20A2,2 0 0,1 19,22H10A2,2 0 0,1 8,20V18H10V20H19V4H10V6H8V4A2,2 0 0,1 10,2Z'></path>
                                                </svg>
                                            </span>
                                            <span class='mud-button-label'>Login</span>
                                        </a>
                                    `;
                                }
                            }
                        }
                    } catch (error) {
                        console.log('Auth UI update failed:', error);
                    }
                })();
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to update auth UI: {ex.Message}");
        }
    }
}
