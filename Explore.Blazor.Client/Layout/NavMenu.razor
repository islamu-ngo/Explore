@*
    NavMenu Component - BEM Methodology
    Block: navbar
    Elements: __content, __brand, __brand-icon, __brand-text, __brand-highlight,
              __links, __link, __actions, __theme-toggle, __create-event-btn, __login-btn,
              __user-dropdown, __user-btn, __user-avatar, __user-name, __user-arrow,
              __dropdown-menu, __dropdown-header, __dropdown-divider, __dropdown-section-label,
              __dropdown-item, __dropdown-overlay
    Modifiers: __link--active, __dropdown-menu--open, __dropdown-item--danger
*@

<div class="navbar">
    <div class="navbar__content">
        <!-- Brand -->
        <a href="/" class="navbar__brand" aria-label="Home">
            @if (!string.IsNullOrWhiteSpace(_brandLogoUrl))
            {
                <MudImage Src="@_brandLogoUrl" Alt="@_brandDisplayName" Class="navbar__brand-icon" Width="28" Height="28" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Explore" Color="Color.Primary" Size="Size.Large" Class="navbar__brand-icon" />
            }
            <div class="navbar__brand-text">@_brandDisplayName</div>
        </a>

        <!-- Global Search -->
        <div class="navbar__search">
            <MudTextField T="string"
                          Placeholder="Search events..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="navbar__search-input"
                          @bind-Value="SearchQuery"
                          @onkeyup="@HandleSearchKeyPress" />
        </div>

        <!-- Center Navigation -->
        <div class="navbar__links">
            <NavLink href="/events" class="navbar__link" Match="NavLinkMatch.Prefix" ActiveClass="navbar__link--active">
                Events
            </NavLink>

            @* Dynamic tenant navigation links *@
            @foreach (var link in _navigationLinks.OrderBy(l => l.Order))
            {
                var icon = string.IsNullOrWhiteSpace(link.Icon) ? Icons.Material.Filled.Link : link.Icon;

                @if (link.OpenInNewTab == true)
                {
                    <a @key="link.Id" href="@link.Url" target="_blank" rel="noopener noreferrer" class="navbar__link" title="@link.Label">
                        <MudIcon Icon="@icon" Size="Size.Small" Class="mr-2" />
                        @link.Label
                    </a>
                }
                else
                {
                    <NavLink @key="link.Id" href="@link.Url" class="navbar__link" Match="NavLinkMatch.Prefix" ActiveClass="navbar__link--active" title="@link.Label">
                        <MudIcon Icon="@icon" Size="Size.Small" Class="mr-2" />
                        @link.Label
                    </NavLink>
                }
            }
        </div>

        <!-- Right Actions -->
        <div class="navbar__actions">
            <MudIconButton Icon="@Icons.Material.Rounded.LightMode"
                           Color="Color.Inherit"
                           OnClick="@OnToggleTheme"
                           Title="Toggle Theme"
                           Class="navbar__theme-toggle" />

            <AuthorizeView>
                <Authorized>
                    @if (_eventCreationEligibility.CanCreate)
                    {
                        <a href="@_eventCreationEligibility.CreateEventRoute" style="text-decoration: none;">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       Size="Size.Small"
                                       Class="navbar__create-event-btn">
                                Add Event
                            </MudButton>
                        </a>
                    }

                    <!-- User Dropdown -->
                    <div class="navbar__user-dropdown">
                        <div class="navbar__user-btn" @onclick="ToggleDropdown" @onclick:stopPropagation
                             role="button" tabindex="0" aria-expanded="@_dropdownOpen" aria-haspopup="true" aria-label="User menu">
                            @if (!string.IsNullOrEmpty(_currentUser?.ProfileImageUri))
                            {
                                <MudAvatar Size="Size.Small" Class="navbar__user-avatar">
                                    <MudImage Src="@_currentUser.ProfileImageUri" Alt="@($"{context.User.Identity?.Name}'s profile picture")" />
                                </MudAvatar>
                            }
                            else
                            {
                                <MudAvatar Color="Color.Primary" Size="Size.Small" Class="navbar__user-avatar">
                                    @GetInitials(context.User.Identity?.Name)
                                </MudAvatar>
                            }
                            <span class="navbar__user-name">@context.User.Identity?.Name</span>
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Class="navbar__user-arrow" />
                        </div>

                        @if (_dropdownOpen)
                        {
                            <div class="navbar__dropdown-menu navbar__dropdown-menu--open" @onclick:stopPropagation>
                                <div class="navbar__dropdown-header">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Signed in as</MudText>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@context.User.Identity?.Name</MudText>
                                </div>
                                <div class="navbar__dropdown-divider"></div>

                                <a href="/user/profile" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                    My Profile
                                </a>
                                <a href="/myevents" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                    <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" />
                                    My Events
                                </a>
                                <a href="/organization/my" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                                    My Organizations
                                </a>
                                <a href="/my-registrations" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Small" />
                                    My Registrations
                                </a>

                                @if (HasAnyAdminAuthority(context.User))
                                {
                                    <div class="navbar__dropdown-divider"></div>
                                    <div class="navbar__dropdown-section-label">Admin</div>

                                    @if (IsInstanceAdmin(context.User))
                                    {
                                        <a href="/admin/instance/settings" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                            <MudIcon Icon="@Icons.Material.Filled.Dns" Size="Size.Small" />
                                            Instance Administration
                                        </a>
                                    }

                                    @if (IsTenantAdmin(context.User))
                                    {
                                        <a href="/admin/tenant/settings" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                            <MudIcon Icon="@Icons.Material.Filled.Domain" Size="Size.Small" />
                                            Tenant Administration
                                        </a>
                                    }

                                    @foreach (var orgId in GetAdminOrganizationIds(context.User))
                                    {
                                        <a href="@($"/admin/organization/{orgId}/settings")" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                            <MudIcon Icon="@Icons.Material.Filled.CorporateFare" Size="Size.Small" />
                                            Organization Settings
                                        </a>
                                    }
                                }

                                <div class="navbar__dropdown-divider"></div>

                                <a href="/settings" class="navbar__dropdown-item" @onclick="CloseDropdown">
                                    <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" />
                                    Settings
                                </a>
                                <a href="/logout" data-enhance-nav="false" class="navbar__dropdown-item navbar__dropdown-item--danger" @onclick="CloseDropdown">
                                    <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" />
                                    Logout
                                </a>
                            </div>
                        }
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" data-enhance-nav="false" style="text-decoration: none;">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Class="navbar__login-btn"
                                   StartIcon="@Icons.Material.Filled.Login">
                            Login
                        </MudButton>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@* Overlay to close dropdown when clicking outside *@
@if (_dropdownOpen)
{
    <div class="navbar__dropdown-overlay" @onclick="CloseDropdown" aria-hidden="true"></div>
}
