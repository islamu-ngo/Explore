@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<style>
    /* Modern Navbar Styles */
    .navbar-glass {
        position: sticky;
        top: 0;
        z-index: 100;
        width: 100%;
        height: 70px;
        padding: 0 24px;
        background: color-mix(in srgb, var(--mud-palette-surface) 85%, transparent);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid color-mix(in srgb, var(--mud-palette-lines-default) 40%, transparent);
        transition: all 0.3s ease;
    }

    .nav-content {
        max-width: 1280px;
        margin: 0 auto;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* Brand */
    .brand-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        transition: transform 0.2s ease;
    }
    
    .brand-logo:hover {
        transform: scale(1.02);
    }

    .brand-text {
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--mud-palette-text-primary);
    }

    .brand-highlight {
        color: var(--mud-palette-primary);
    }

    /* Navigation Links */
    .nav-links {
        display: flex;
        gap: 8px;
        background: color-mix(in srgb, var(--mud-palette-text-primary) 4%, transparent);
        padding: 4px;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--mud-palette-text-primary) 5%, transparent);
    }

    .nav-item {
        padding: 6px 16px;
        border-radius: 999px;
        color: var(--mud-palette-text-secondary);
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .nav-item:hover {
        color: var(--mud-palette-text-primary);
        background: color-mix(in srgb, var(--mud-palette-surface) 50%, transparent);
    }

    .nav-item.active {
        background: var(--mud-palette-surface);
        color: var(--mud-palette-primary);
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    /* User Menu & Actions */
    .nav-actions {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    /* User Dropdown Styles (Used by JS) */
    .user-dropdown-container {
        position: relative;
    }

    .user-profile-btn {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 6px 8px 6px 12px;
        background: color-mix(in srgb, var(--mud-palette-surface) 50%, transparent);
        border: 1px solid color-mix(in srgb, var(--mud-palette-lines-default) 50%, transparent);
        border-radius: 999px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .user-profile-btn:hover {
        background: color-mix(in srgb, var(--mud-palette-primary) 8%, transparent);
        border-color: color-mix(in srgb, var(--mud-palette-primary) 20%, transparent);
    }

    .nav-user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--mud-palette-primary);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 14px;
    }

    .user-dropdown-menu {
        position: absolute;
        top: calc(100% + 12px);
        right: 0;
        width: 240px;
        background: var(--mud-palette-surface);
        border: 1px solid color-mix(in srgb, var(--mud-palette-lines-default) 50%, transparent);
        border-radius: 16px;
        box-shadow: 0 10px 40px -10px rgba(0,0,0,0.15);
        padding: 8px;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 1000;
    }

    .user-dropdown-menu.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .menu-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        color: var(--mud-palette-text-primary);
        text-decoration: none;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 500;
        transition: all 0.15s ease;
    }

    .menu-item:hover {
        background: color-mix(in srgb, var(--mud-palette-text-primary) 4%, transparent);
    }

    .menu-item.danger {
        color: var(--mud-palette-error);
    }
    
    .menu-item.danger:hover {
        background: color-mix(in srgb, var(--mud-palette-error) 8%, transparent);
    }

    .menu-divider {
        height: 1px;
        background: color-mix(in srgb, var(--mud-palette-lines-default) 50%, transparent);
        margin: 6px 0;
    }

    .badge {
        background: var(--mud-palette-error);
        color: white;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 99px;
        margin-left: auto;
    }

    @@media (max-width: 768px) {
        .brand-text span { display: none; }
        .nav-links { display: none; } /* Or move to mobile menu */
    }
</style>

<div class="navbar-glass">
    <div class="nav-content">
        <!-- Brand -->
        <a href="/" class="brand-logo">
            <MudIcon Icon="@Icons.Material.Filled.Explore" Color="Color.Primary" Size="Size.Large" />
            <div class="brand-text">ISLAMU<span class="brand-highlight">Explore</span></div>
        </a>

        <!-- Center Navigation -->
        <div class="nav-links">
            <NavLink href="/events" class="nav-item" Match="NavLinkMatch.Prefix">
                Events
            </NavLink>
        </div>

        <!-- Right Actions -->
        <div class="nav-actions">
            <MudIconButton Icon="@Icons.Material.Rounded.LightMode" 
                           Color="Color.Inherit" 
                           OnClick="@OnToggleTheme" 
                           Title="Toggle Theme" />
            
            <div id="auth-buttons">
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           Href="/login" 
                           Class="rounded-pill px-6"
                           StartIcon="@Icons.Material.Filled.Login">
                    Login
                </MudButton>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnToggleTheme { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UpdateAuthenticationUI();
        }
    }

    private async Task UpdateAuthenticationUI()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                (async function() {
                    try {
                        const response = await fetch('/auth/status', {
                            method: 'GET',
                            credentials: 'same-origin'
                        });
                        const authButtons = document.getElementById('auth-buttons');
                        
                        if (response.ok && response.status === 200) {
                            const authInfo = await response.json();
                            if (authInfo.isAuthenticated && authInfo.name) {
                                if (authButtons) {
                                    // Generate initials
                                    const initials = authInfo.name.substring(0, 2).toUpperCase();
                                    
                                    authButtons.innerHTML = `
                                        <div class='user-dropdown-container'>
                                            <div class='user-profile-btn' onclick='toggleUserDropdown(event)'>
                                                <div class='nav-user-avatar'>${initials}</div>
                                                <span style='font-weight: 600; font-size: 0.9rem;'>${authInfo.name}</span>
                                                <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
                                                    <path d='M6 9l6 6 6-6'/>
                                                </svg>
                                            </div>
                                            
                                            <div class='user-dropdown-menu' id='userDropdownMenu'>
                                                <div style='padding: 8px 12px; margin-bottom: 4px;'>
                                                    <div style='font-size: 0.8rem; color: var(--mud-palette-text-secondary);'>Signed in as</div>
                                                    <div style='font-weight: 600; text-overflow: ellipsis; overflow: hidden;'>${authInfo.name}</div>
                                                </div>
                                                <div class='menu-divider'></div>
                                                
                                                <a href='/user/profile' class='menu-item'>
                                                    <svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'></path><circle cx='12' cy='7' r='4'></circle></svg>
                                                    My Profile
                                                </a>
                                                <a href='/myevents' class='menu-item'>
                                                    <svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><rect x='3' y='4' width='18' height='18' rx='2' ry='2'></rect><line x1='16' y1='2' x2='16' y2='6'></line><line x1='8' y1='2' x2='8' y2='6'></line><line x1='3' y1='10' x2='21' y2='10'></line></svg>
                                                    My Events
                                                </a>
                                                <a href='/organization/my' class='menu-item'>
                                                    <svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M3 21h18'/><path d='M5 21V7l8-4 8 4v14'/><path d='M17 21v-8.5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0-.5.5V21'/></svg>
                                                    My Organizations
                                                    ${authInfo.pendingInvitesCount > 0 ? `<span class='badge'>${authInfo.pendingInvitesCount}</span>` : ''}
                                                </a>
                                                <a href='/my-registrations' class='menu-item'>
                                                    <svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'></path><polyline points='14 2 14 8 20 8'></polyline><line x1='16' y1='13' x2='8' y2='13'></line><line x1='16' y1='17' x2='8' y2='17'></line><polyline points='10 9 9 9 8 9'></polyline></svg>
                                                    My Registrations
                                                </a>
                                                
                                                <div class='menu-divider'></div>
                                                
                                                <a href='/logout' class='menu-item danger'>
                                                    <svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4'></path><polyline points='16 17 21 12 16 7'></polyline><line x1='21' y1='12' x2='9' y2='12'></line></svg>
                                                    Logout
                                                </a>
                                            </div>
                                        </div>
                                    `;

                                    // Add global click handler to close dropdown
                                    if (!window.toggleUserDropdown) {
                                        window.toggleUserDropdown = function(event) {
                                            event.stopPropagation();
                                            const menu = document.getElementById('userDropdownMenu');
                                            if (menu) {
                                                menu.classList.toggle('show');
                                            }
                                        };

                                        // Close dropdown when clicking outside
                                        document.addEventListener('click', function(event) {
                                            const menu = document.getElementById('userDropdownMenu');
                                            const btn = document.querySelector('.user-profile-btn');
                                            if (menu && btn && !btn.contains(event.target) && !menu.contains(event.target)) {
                                                menu.classList.remove('show');
                                            }
                                        });
                                    }
                                }
                            } else {
                                if (authButtons) {
                                    authButtons.innerHTML = `
                                        <a href='/login' class='mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-button-filled-size-medium mud-ripple rounded-pill px-6'>
                                            <span class='mud-button-start-icon-container'>
                                                <svg class='mud-icon-root mud-svg-icon mud-icon-size-medium' focusable='false' viewBox='0 0 24 24' aria-hidden='true'>
                                                    <path d='M10,17V14H3V10H10V7L15,12L10,17M10,2H19A2,2 0 0,1 21,4V20A2,2 0 0,1 19,22H10A2,2 0 0,1 8,20V18H10V20H19V4H10V6H8V4A2,2 0 0,1 10,2Z'></path>
                                                </svg>
                                            </span>
                                            <span class='mud-button-label'>Login</span>
                                        </a>
                                    `;
                                }
                            }
                        }
                    } catch (error) {
                        console.log('Auth UI update failed:', error);
                    }
                })();
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to update auth UI: {ex.Message}");
        }
    }
}
