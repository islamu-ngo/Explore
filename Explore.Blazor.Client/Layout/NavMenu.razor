@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<style>
/* ===== NAV WRAP ===== */
.topnav {
    position: sticky; top: 0; z-index: 50;
    width: 100%;
    padding: 10px 24px;
    background: color-mix(in srgb, var(--mud-palette-background-paper) 95%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid color-mix(in srgb, var(--mud-palette-text-primary) 8%, transparent);
    box-shadow: 0 2px 20px rgba(0,0,0,.08);
}

/* Layout rows */
.nav-container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
}

.nav-row {
    display: flex; 
    align-items: center; 
    justify-content: space-between;
    gap: 24px;
    min-height: 60px;
}

/* ===== LEFT BRAND / HOME ===== */
.brand a.mud-nav-link {
    border-radius: 999px;
    padding: 8px 12px;
    font-weight: 700;
    letter-spacing: .2px;
    background: color-mix(in srgb, var(--mud-palette-primary) 10%, transparent);
    color: var(--mud-palette-primary-contrast-text) !important;
    box-shadow: 0 6px 16px color-mix(in srgb, var(--mud-palette-primary) 25%, transparent);
}
.brand a.mud-nav-link:hover {
    transform: translateY(-1px);
}

/* ===== CENTER LINKS ===== */
.center-links {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    max-width: 500px;
    margin: 0 auto;
    gap: 16px;
}

.pill a.mud-nav-link {
    border-radius: 999px;
    padding: 8px 16px;
    transition: background .15s ease, color .15s ease, transform .15s ease;
    white-space: nowrap;
    max-width: 100px;
    text-align: center;
    font-size: 0.875rem;
}
.pill a.mud-nav-link:hover {
    background: color-mix(in srgb, var(--mud-palette-primary) 10%, transparent);
    transform: translateY(-1px);
}

/* Active underline (subtle) */
a.mud-nav-link.mud-nav-link-active {
    position: relative;
}
a.mud-nav-link.mud-nav-link-active::after {
    content: ""; position: absolute; left: 12px; right: 12px; bottom: 4px; height: 2px;
    border-radius: 2px;
    background: var(--mud-palette-primary);
    opacity: .9;
}

/* ===== SEARCH ===== */
.nav-search {
    flex: 1;
    max-width: 320px;
    min-width: 240px;
}

.nav-search .mud-input-root {
    border-radius: 999px !important;
}
.nav-search input.mud-input-slot {
    padding-left: 16px; 
    padding-right: 40px;
}
.nav-search .mud-input-adornment {
    opacity: .85;
}
.nav-search .mud-input:not(.mud-input-disabled):focus-within {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--mud-palette-primary) 30%, transparent);
    border-color: var(--mud-palette-primary);
}

/* ===== RIGHT SIDE ===== */
.nav-actions .mud-button-root {
    border-radius: 999px;
}
.nav-actions .mud-icon-button-root {
    border-radius: 10px;
}
.nav-actions .mud-icon-button-root:hover {
    background: color-mix(in srgb, var(--mud-palette-text-primary) 8%, transparent);
}

/* ===== RESPONSIVE ===== */
@@media (max-width: 900px){
    .nav-row { 
        flex-wrap: wrap; 
        gap: 12px;
        justify-content: center;
    }
    
    .brand { 
        order: 1; 
        width: 100%; 
        justify-content: center; 
    }
    
    .center-links { 
        order: 2; 
        width: 100%; 
        justify-content: center;
        max-width: none;
        margin: 0;
    }
    
    .nav-search { 
        flex: 1 1 100%; 
        max-width: none;
        margin: 0 20px;
    }
    
    .nav-actions { 
        order: 3; 
        width: 100%; 
        justify-content: center; 
    }
}
</style>

<div class="topnav">
    <div class="nav-container">
        <div class="nav-row">

            <!-- Left: brand / home -->
            <MudStack Row="true" Spacing="1" Class="brand">
                <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Favorite" Color="Color.Error">
                    ISLAMU Explore
                </MudNavLink>
            </MudStack>

            <!-- Center: main links + search -->
            <div class="center-links">
                <div class="pill">
                    <MudNavLink Href="/events" Match="NavLinkMatch.Prefix">Events</MudNavLink>
                </div>
                <MudTextField @bind-Value="searchText"
                              Class="nav-search"
                              Placeholder="Search events..."
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>

            <!-- Right: actions (theme + create + auth) -->
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="nav-actions">
                <MudIconButton Icon="@Icons.Material.Rounded.AutoMode"
                               Color="Color.Inherit"
                               OnClick="@OnToggleTheme"
                               aria-label="Toggle theme" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/myevents" StartIcon="@Icons.Material.Filled.Add">
                    Create
                </MudButton>

                <!-- Auth buttons -->
                <div id="auth-buttons">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/login" StartIcon="@Icons.Material.Filled.Login">Login</MudButton>
                </div>
            </MudStack>

        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnToggleTheme { get; set; }

    private string searchText = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Update navigation based on authentication status (unchanged)
            await UpdateAuthenticationUI();
        }
    }

    private async Task UpdateAuthenticationUI()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                (async function() {
                    try {
                        const response = await fetch('/auth/status', {
                            method: 'GET',
                            credentials: 'same-origin'
                        });
                        const authButtons = document.getElementById('auth-buttons');
                        
                        if (response.ok && response.status === 200) {
                            const authInfo = await response.json();
                            if (authInfo.isAuthenticated && authInfo.name) {
                                if (authButtons) {
                                    authButtons.innerHTML = `
                                        <div class='mud-menu mud-menu-dense'>
                                            <button class='mud-button-root mud-button mud-button-text mud-button-text-primary mud-button-text-size-medium mud-ripple' type='button'>
                                                <span class='mud-button-start-icon-container'>
                                                    <svg class='mud-icon-root mud-svg-icon mud-icon-size-medium' focusable='false' viewBox='0 0 24 24' aria-hidden='true'>
                                                        <path d='M12 2C13.1 2 14 2.9 14 4C14 5.1 13.1 6 12 6C10.9 6 10 5.1 10 4C10 2.9 10.9 2 12 2ZM21 9V7L15 1.5V3H9V1.5L3 7V9H4L5 16L6 21H18L19 16L20 9H21ZM7 9H17L16.5 14H7.5L7 9Z'></path>
                                                    </svg>
                                                </span>
                                                <span class='mud-button-label'>${authInfo.name}</span>
                                            </button>
                                        </div>
                                        <a href='/logout' class='mud-button-root mud-button mud-button-text mud-button-text-primary mud-button-text-size-medium mud-ripple' style='margin-left: 8px;'>
                                            <span class='mud-button-start-icon-container'>
                                                <svg class='mud-icon-root mud-svg-icon mud-icon-size-medium' focusable='false' viewBox='0 0 24 24' aria-hidden='true'>
                                                    <path d='M17,7L15.59,8.41L18.17,11H8V13H18.17L15.59,15.59L17,17L22,12L17,7M4,5H12V3H4C2.89,3 2,3.9 2,5V19A2,2 0 0,0 4,21H12V19H4V5Z'></path>
                                                </svg>
                                            </span>
                                            <span class='mud-button-label'>Logout</span>
                                        </a>
                                    `;
                                }
                            } else {
                                if (authButtons) {
                                    authButtons.innerHTML = `
                                        <a href='/login' class='mud-button-root mud-button mud-button-text mud-button-text-primary mud-button-text-size-medium mud-ripple'>
                                            <span class='mud-button-start-icon-container'>
                                                <svg class='mud-icon-root mud-svg-icon mud-icon-size-medium' focusable='false' viewBox='0 0 24 24' aria-hidden='true'>
                                                    <path d='M10,17V14H3V10H10V7L15,12L10,17M10,2H19A2,2 0 0,1 21,4V20A2,2 0 0,1 19,22H10A2,2 0 0,1 8,20V18H10V20H19V4H10V6H8V4A2,2 0 0,1 10,2Z'></path>
                                                </svg>
                                            </span>
                                            <span class='mud-button-label'>Login</span>
                                        </a>
                                    `;
                                }
                            }
                        }
                    } catch (error) {
                        console.log('Auth UI update failed:', error);
                    }
                })();
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to update auth UI: {ex.Message}");
        }
    }
}
