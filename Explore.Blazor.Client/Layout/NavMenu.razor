@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<div class="navbar-glass">
    <div class="nav-content">
        <!-- Brand -->
        <a href="/" class="brand-logo" aria-label="Home">
            <MudIcon Icon="@Icons.Material.Filled.Explore" Color="Color.Primary" Size="Size.Large" />
            <div class="brand-text">ISLAMU<span class="brand-highlight">Explore</span></div>
        </a>

        <!-- Center Navigation -->
        <div class="nav-links">
            <NavLink href="/" class="nav-item" Match="NavLinkMatch.All">
                Events
            </NavLink>
        </div>

        <!-- Right Actions -->
        <div class="nav-actions">
            <MudIconButton Icon="@Icons.Material.Rounded.LightMode"
                           Color="Color.Inherit"
                           OnClick="@OnToggleTheme"
                           Title="Toggle Theme" />

            <AuthorizeView>
                <Authorized>
                    <!-- User Dropdown -->
                    <div class="user-dropdown-container">
                        <div class="user-profile-btn" @onclick="ToggleDropdown" @onclick:stopPropagation>
                            <MudAvatar Color="Color.Primary" Size="Size.Small" Class="nav-user-avatar">
                                @GetInitials(context.User.Identity?.Name)
                            </MudAvatar>
                            <span class="nav-user-name">@context.User.Identity?.Name</span>
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
                        </div>

                        @if (_dropdownOpen)
                        {
                            <div class="user-dropdown-menu show" @onclick:stopPropagation>
                                <div class="dropdown-header">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Signed in as</MudText>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@context.User.Identity?.Name</MudText>
                                </div>
                                <div class="menu-divider"></div>

                                <a href="/user/profile" class="menu-item" @onclick="CloseDropdown">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                                    My Profile
                                </a>
                                <a href="/myevents" class="menu-item" @onclick="CloseDropdown">
                                    <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" />
                                    My Events
                                </a>
                                <a href="/organization/my" class="menu-item" @onclick="CloseDropdown">
                                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                                    My Organizations
                                </a>
                                <a href="/my-registrations" class="menu-item" @onclick="CloseDropdown">
                                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Small" />
                                    My Registrations
                                </a>

                                @if (IsAdmin(context.User))
                                {
                                    <div class="menu-divider"></div>
                                    <div class="menu-section-label">Admin</div>
                                    <a href="/admin" class="menu-item" @onclick="CloseDropdown">
                                        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Small" />
                                        Organizations
                                    </a>
                                    <a href="/admin/categories" class="menu-item" @onclick="CloseDropdown">
                                        <MudIcon Icon="@Icons.Material.Filled.Category" Size="Size.Small" />
                                        Categories
                                    </a>
                                    <a href="/admin/tags" class="menu-item" @onclick="CloseDropdown">
                                        <MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" />
                                        Tags
                                    </a>
                                    <a href="/admin/locations" class="menu-item" @onclick="CloseDropdown">
                                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" />
                                        Locations
                                    </a>
                                }

                                <div class="menu-divider"></div>

                                <a href="/settings" class="menu-item" @onclick="CloseDropdown">
                                    <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" />
                                    Settings
                                </a>
                                <a href="/logout" class="menu-item danger" @onclick="CloseDropdown">
                                    <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" />
                                    Logout
                                </a>
                            </div>
                        }
                    </div>
                </Authorized>
                <NotAuthorized>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Href="/login"
                               Class="login-btn"
                               StartIcon="@Icons.Material.Filled.Login">
                        Login
                    </MudButton>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@* Overlay to close dropdown when clicking outside *@
@if (_dropdownOpen)
{
    <div class="dropdown-overlay" @onclick="CloseDropdown"></div>
}

@code {
    [Parameter] public EventCallback OnToggleTheme { get; set; }

    private bool _dropdownOpen = false;

    private void ToggleDropdown()
    {
        _dropdownOpen = !_dropdownOpen;
    }

    private void CloseDropdown()
    {
        _dropdownOpen = false;
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name.Length >= 2 ? name[..2].ToUpper() : name.ToUpper();
    }

    private bool IsAdmin(System.Security.Claims.ClaimsPrincipal user)
    {
        return user.IsInRole("Admin") || 
               user.HasClaim(c => c.Type == "role" && c.Value == "Admin") ||
               user.HasClaim(c => c.Type == "roles" && c.Value.Contains("Admin"));
    }
}
