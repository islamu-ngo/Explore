@inherits LayoutComponentBase

<MudThemeProvider @ref="_mudThemeProvider" Theme="@_theme" @bind-IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout class="main-layout">

    <!-- Fixed header container wrapping AnnouncementBar and NavMenu - full width -->
    <div class="main-layout__header">
        <!-- Announcement Bar -->
        <AnnouncementBar />

        <!-- Navigation Menu (handles its own content max-width) -->
        <NavMenu OnToggleTheme="DarkModeToggle" />
    </div>

    <MudMainContent>
        <div class="main-layout__content-wrapper">
            @Body
        </div>
    </MudMainContent>

    <!-- Full-width footer outside main content -->
    <Footer />

</MudLayout>
