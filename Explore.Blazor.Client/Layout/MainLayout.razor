@inherits LayoutComponentBase

<MudThemeProvider @ref="_mudThemeProvider" Theme="@_theme" @bind-IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<AnalyticsInitializer />

<MudLayout class="main-layout">
    @if (!_hideChrome)
    {
        <div class="main-layout__header">
            <AnnouncementBar />
            <NavMenu OnToggleTheme="DarkModeToggle" />
        </div>

        <MudDrawer Open="@SidebarState.IsOpen"
                   OpenChanged="@OnDrawerOpenChanged"
                   Anchor="Anchor.Start"
                   Variant="DrawerVariant.Responsive"
                   Breakpoint="Breakpoint.Md"
                   ClipMode="DrawerClipMode.Always"
                   Elevation="0"
                   Class="main-layout__drawer">
            <MudNavMenu Dense="true" Class="px-2 pt-2">
                <MudButton Href="/events"
                           Variant="Variant.Text"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Event"
                           FullWidth="true"
                           Class="justify-start text-transform-none"
                           Style="font-weight: 700; font-size: 1.1rem; justify-content: flex-start;">
                    Events
                </MudButton>
                <MudNavLink Href="/events"
                            Icon="@Icons.Material.Filled.ManageSearch"
                            Match="NavLinkMatch.All">
                    Advanced Search
                </MudNavLink>
                <MudNavLink Href="/events?sort=recent"
                            Icon="@Icons.Material.Filled.NewReleases">
                    Recently Added
                </MudNavLink>
                <MudNavLink Href="/events?sort=random"
                            Icon="@Icons.Material.Filled.Shuffle">
                    Random
                </MudNavLink>
            </MudNavMenu>
        </MudDrawer>
    }

    <MudMainContent Class="main-layout__main" Style="padding-top: 0 !important;">
        <div class="main-layout__content-wrapper">
            @Body
        </div>
    </MudMainContent>

    @if (!_hideChrome)
    {
        <Footer />
    }

</MudLayout>
