@inherits LayoutComponentBase

<MudThemeProvider @ref="_mudThemeProvider" Theme="@_theme" @bind-IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<AnalyticsInitializer />

<MudLayout class="main-layout" Style="--mud-appbar-height: 0px;">
    @if (!_hideChrome)
    {
        <div class="main-layout__header">
            <AnnouncementBar />
            <NavMenu OnToggleTheme="DarkModeToggle" />
        </div>
    }

    <MudMainContent Class="main-layout__main" Style="padding-top: 0 !important;">
        <div class="main-layout__content-wrapper">
            @Body
        </div>
    </MudMainContent>

    @if (!_hideChrome)
    {
        <Footer />
    }

</MudLayout>
