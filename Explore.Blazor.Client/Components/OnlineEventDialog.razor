@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" GutterBottom="true">@Title</MudText>
        <MudText Class="mb-4">
            You are about to join this online event.
        </MudText>
        <MudText>
            Click the button below to open the meeting link:
        </MudText>
        <MudText Class="mt-2" Typo="Typo.body2" Color="Color.Secondary">
            @Url
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Close</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Href="@Url" Target="_blank" StartIcon="@Icons.Material.Filled.VideoCall">
            Join Meeting
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Url { get; set; } = string.Empty;

    private void Cancel() => MudDialog.Cancel();
}
