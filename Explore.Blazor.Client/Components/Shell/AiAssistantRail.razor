    private sealed record AiRailTimelineItem(
        string Key,
        Messages2? Message,
        ProposedActions2? Action,
        decimal SequenceAnchor,
        DateTimeOffset? CreatedAt,
        int SortKind)
    {
        public static AiRailTimelineItem ForMessage(Messages2 message) => new(
            $"message:{message.Id?.ToString() ?? message.Sequence?.ToString() ?? message.CreatedAt?.ToUnixTimeMilliseconds().ToString() ?? message.Content ?? string.Empty}",
            message,
            null,
            message.Sequence ?? long.MaxValue,
            message.CreatedAt,
            0);

        public static AiRailTimelineItem ForAction(ProposedActions2 action, decimal sequenceAnchor) => new(
            $"action:{action.Id?.ToString() ?? action.CreatedAt?.ToUnixTimeMilliseconds().ToString() ?? action.PayloadJson ?? string.Empty}",
            null,
            action,
            sequenceAnchor,
            action.CreatedAt ?? action.ConfirmedAt ?? action.RejectedAt,
            1);
    }
