@* ABOUTME: Shell-level AI assistant rail hosted in MainLayout, outside page content. *@
@* ABOUTME: Slides in from the right; persists across page navigations. Plane-style chat UI. *@
@using Explore.Blazor.Client.Contracts.Services.Ai
@using Explore.Blazor.Client.Components.Shell.AiAssistant
@using Explore.Blazor.Client.Services.Ai
@implements IDisposable

@if (AiAssistantState.IsAvailable)
{
    @if (!HostedInDock && AiAssistantState.IsOpen)
    {
        <div class="ai-rail__backdrop" @onclick="AiAssistantState.Close" aria-hidden="true"></div>
    }

    <aside id="ai-assistant-rail"
           class="@RootClass"
           data-testid="shell-ai-rail"
           aria-label="AI Assistant"
           role="complementary">

        @* ── Header bar ── *@
        <div class="ai-rail__header">
            <div class="ai-rail__header-brand">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Class="ai-rail__header-icon" />
                <MudMenu @bind-Open="_modelMenuOpen"
                         AnchorOrigin="Origin.BottomLeft"
                         TransformOrigin="Origin.TopLeft"
                         Dense="true"
                         Class="ai-rail__model-menu">
                    <ActivatorContent>
                        <button type="button" class="ai-rail__model-picker-btn" @onclick="ToggleModelMenu">
                            <span class="ai-rail__header-title">ISLAMU AI (@SelectedModelLabel)</span>
                            <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Class="ai-rail__model-arrow" />
                        </button>
                    </ActivatorContent>
                    <ChildContent>
                        @foreach (var model in _modelOptions)
                        {
                            <MudMenuItem OnClick="() => SelectModel(model.Id)"
                                         Class="@GetModelItemClass(model.Id)">
                                @model.DisplayName
                            </MudMenuItem>
                        }
                    </ChildContent>
                </MudMenu>
            </div>
            <div class="ai-rail__header-actions">
                @if (ConversationState.CanCreateConversation)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.EditNote"
                                   Color="Color.Inherit"
                                   Size="Size.Small"
                                   OnClick="CreateConversationAsync"
                                   Disabled="@_isCommandRunning"
                                   Title="New conversation"
                                   aria-label="New conversation"
                                   data-testid="ai-rail-new-conversation" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.History"
                               Color="@(_showConversations ? Color.Primary : Color.Inherit)"
                               Size="Size.Small"
                               OnClick="ToggleConversations"
                               Title="Conversation history"
                               aria-label="Conversation history" />
                <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                         Color="Color.Inherit"
                         Size="Size.Small"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         Title="Close AI Assistant"
                         aria-label="Close AI Assistant"
                         data-testid="ai-rail-options-menu">
                    <MudMenuItem OnClick="DeleteCurrentChatAsync" Disabled="@(ConversationState.SelectedConversation is null)">
                        Delete chat
                    </MudMenuItem>
                </MudMenu>
            </div>
        </div>

        @* Drawer removed in favor of history sidebar overlay *@

        @* ── Chat body ── *@
        <div class="ai-rail__body">
            @if (ConversationState.IsLoading)
            {
                <div class="ai-rail__placeholder" role="status" aria-live="polite">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        Loading assistant context...
                    </MudText>
                </div>
            }
            else if (ConversationState.SelectedConversation is not null)
            {
                var timelineItems = GetTimelineItems();
                @if (timelineItems.Count > 0)
                {
                    <div class="ai-rail__timeline" role="log" aria-live="polite" aria-label="AI conversation messages and actions">
                        @foreach (var item in timelineItems)
                        {
                            @if (item.Message is not null)
                            {
                                <article @key="item.Key" class="@GetMessageClass(item.Message.Role)" data-testid="ai-rail-message">
                                    <span class="ai-rail__message-role">@item.Message.Role</span>
                                    <p>@item.Message.Content</p>
                                </article>
                            }
                            else if (item.Action is not null)
                            {
                                <AiProposedActionCard @key="item.Key"
                                                      Action="item.Action"
                                                      IsBusy="@IsActionBusy(item.Action.Id)"
                                                      ActionsEnabled="@IsBuildCapabilitySelected"
                                                      OnConfirm="ConfirmActionAsync"
                                                      OnReject="RejectActionAsync" />
                            }
                        }
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ai-rail__empty-hint">
                        No messages yet.
                    </MudText>
                }
            }
        </div>

        @* ── Error ── *@
        @if (!string.IsNullOrWhiteSpace(ConversationState.ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="ai-rail__alert" data-testid="ai-rail-error">
                @ConversationState.ErrorMessage
            </MudAlert>
        }

        @if (GetActiveRunId() is not null)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="ai-rail__alert" data-testid="ai-rail-running">
                <div class="d-flex align-center gap-2">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                    <span>AI is thinking. You can wait here or cancel this run.</span>
                    <MudSpacer />
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               Disabled="@_isCancelRunRunning"
                               OnClick="CancelActiveRunAsync"
                               data-testid="ai-rail-cancel-run">
                        Cancel
                    </MudButton>
                </div>
            </MudAlert>
        }

        @* ── Composer (bottom-pinned) ── *@
        @if (ConversationState.SelectedConversation is not null)
        {
            <div class="ai-rail__composer" role="form" aria-label="Send an AI assistant message">
                @* References panel (toggled inline) *@
                <div class="@ReferencesClass">
                    <AiReferencePicker SearchTerm="@_referenceSearchTerm"
                                       SearchTermChanged="OnReferenceSearchTermChanged"
                                       Results="ConversationState.ReferenceResults"
                                       SelectedReferences="ConversationState.SelectedReferences"
                                       IsSearching="@_isReferenceSearchRunning"
                                       HasSearched="@_hasSearchedReferences"
                                       OnSearch="SearchReferencesAsync"
                                       OnSelect="SelectReference"
                                       OnRemove="RemoveReference" />
                </div>

                <div class="ai-rail__composer-card">
                    <div class="ai-rail__composer-context">
                        <label class="ai-rail__actor-label" for="ai-rail-actor-selector">Acting as</label>
                        <select id="ai-rail-actor-selector"
                                class="ai-rail__actor-selector"
                                value="@(_selectedActorId?.ToString() ?? string.Empty)"
                                @onchange="OnActorSelectionChanged"
                                data-testid="ai-rail-actor-selector"
                                aria-label="AI assistant actor context"
                                disabled="@(_actorOptions.Count == 0)">
                            @if (_actorOptions.Count == 0)
                            {
                                <option value="">No actor contexts available</option>
                            }
                            else
                            {
                                @foreach (var actor in _actorOptions)
                                {
                                    <option value="@actor.ActorId"
                                            data-actor-type="@actor.ActorType"
                                            data-actor-display-name="@actor.ActorDisplayName">
                                        @actor.ActorType · @actor.ActorDisplayName
                                    </option>
                                }
                            }
                        </select>
                    </div>
                    <InputFile id="ai-file-picker" OnChange="OnFilesSelected" Multiple="true" style="display: none;" />
                    <textarea id="ai-rail-prompt"
                              class="ai-rail__textarea"
                              rows="1"
                              value="@_promptText"
                              @oninput="OnPromptInput"
                              @onchange="OnPromptChange"
                              placeholder="How can I help you today?"
                              data-testid="ai-rail-prompt"></textarea>
                    <div class="ai-rail__composer-toolbar">
                        <MudMenu @bind-Open="_referencesMenuOpen" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                            <ActivatorContent>
                                <button type="button"
                                        class="ai-rail__toolbar-btn @(_showReferences ? "ai-rail__toolbar-btn--active" : "")"
                                        title="Add references"
                                        aria-label="Add references"
                                        @onclick="ToggleReferencesMenu">
                                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                                </button>
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem OnClick="SelectReferencesAndCloseMenu">Search event references</MudMenuItem>
                                <MudMenuItem OnClick="OpenFilePickerAndCloseMenu">Add files of photos</MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                        <MudMenu @bind-Open="_capabilitiesMenuOpen" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                            <ActivatorContent>
                                <button type="button"
                                        class="ai-rail__capability-picker-btn"
                                        title="AI capabilities"
                                        aria-label="AI capabilities"
                                        @onclick="ToggleCapabilitiesMenu">
                                    <MudIcon Icon="@GetCapabilityIcon(_selectedCapability)" Size="Size.Small" />
                                    <span>@_selectedCapability</span>
                                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Class="ai-rail__capability-arrow" />
                                </button>
                            </ActivatorContent>
                            <ChildContent>
                                <MudMenuItem OnClick='() => SelectCapability("Build")'>Build</MudMenuItem>
                                <MudMenuItem OnClick='() => SelectCapability("Ask")'>Ask</MudMenuItem>
                            </ChildContent>
                        </MudMenu>
                        <div class="ai-rail__toolbar-spacer"></div>
                        <button type="button"
                                class="ai-rail__send-btn"
                                disabled="@IsSendDisabled"
                                @onclick="SendMessageAsync"
                                data-testid="ai-rail-send"
                                aria-label="Send message"
                                title="Send message">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" />
                        </button>
                    </div>
                </div>
                <span class="ai-rail__disclaimer">ISLAMU AI can make mistakes, please double-check responses.</span>
            </div>
        }

        @* ── History Overlay (Plane-style right sidebar overlay) ── *@
        <div class="@HistoryOverlayClass" aria-label="AI conversations history">
            <div class="ai-rail__history-header">
                <span class="ai-rail__history-title">Chat history</span>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Color="Color.Inherit"
                               Size="Size.Small"
                               OnClick="ToggleConversations"
                               Title="Close history"
                               aria-label="Close history" />
            </div>

            <div class="ai-rail__history-search-row">
                <button type="button" class="ai-rail__history-new-chat" @onclick="CreateConversationAsync" disabled="@_isCommandRunning">
                    <MudIcon Icon="@Icons.Material.Filled.EditNote" Size="Size.Small" />
                    <span>New chat</span>
                </button>
                <div class="ai-rail__history-search-btn">
                    <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" />
                </div>
            </div>

            <div class="ai-rail__history-section-title">Recents</div>

            <div class="ai-rail__history-body">
                @if (ConversationState.Conversations.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ai-rail__empty-hint">
                        @(ConversationState.CanCreateConversation
                            ? "Start a conversation to ask for event planning help."
                            : "Conversation creation is not available for your account.")
                    </MudText>
                }
                else
                {
                    <div class="ai-rail__history-list" role="list">
                        @foreach (var conversation in ConversationState.Conversations)
                        {
                            <button type="button"
                                    class="@GetConversationButtonClass(conversation.Id)"
                                    role="listitem"
                                    @onclick="() => SelectConversationAndCloseHistoryAsync(conversation.Id)"
                                    data-testid="ai-rail-conversation">
                                <span class="ai-rail__conversation-title">@GetConversationTitle(conversation)</span>
                                <span class="ai-rail__conversation-status">@conversation.Status</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </aside>
}

@code
{
    [Inject]
    protected AiAssistantState AiAssistantState { get; set; } = null!;

    [Inject]
    protected AiAssistantConversationState ConversationState { get; set; } = null!;

    [Inject]
    protected IAiAssistantClientService ClientService { get; set; } = null!;

    [Inject]
    protected IJSRuntime JS { get; set; } = null!;

    [Inject]
    protected ISnackbar Snackbar { get; set; } = null!;

    [Inject]
    protected IBffAuthApi BffAuthApi { get; set; } = null!;

    [Inject]
    protected ILogger<AiAssistantRail> Logger { get; set; } = null!;

    [Inject]
    protected NavigationManager Navigation { get; set; } = null!;

    [Parameter]
    public bool HostedInDock { get; set; }

    private readonly HashSet<Guid> _busyActionIds = [];
    private bool _hasLoaded;
    private bool _hasSearchedReferences;
    private bool _isCommandRunning;
    private bool _isCancelRunRunning;
    private bool _isReferenceSearchRunning;
    private bool _showConversations;
    private bool _showReferences;
    private string _promptText = string.Empty;
    private string _referenceSearchTerm = string.Empty;

    private bool _modelMenuOpen;
    private bool _referencesMenuOpen;
    private bool _capabilitiesMenuOpen;

    private IReadOnlyList<AiRailModelOption> _modelOptions = [];
    private IReadOnlyList<AiRailActorOption> _actorOptions = [];
    private string _selectedModelId = string.Empty;
    private Guid? _selectedActorId;
    private string _selectedCapability = "Build";
    private Guid? _activeRunId;

    private bool IsBuildCapabilitySelected =>
        string.Equals(_selectedCapability, "Build", StringComparison.OrdinalIgnoreCase);

    private string SelectedInteractionMode => IsBuildCapabilitySelected ? "build" : "ask";

    private string SelectedModelLabel => _modelOptions
        .FirstOrDefault(model => string.Equals(model.Id, _selectedModelId, StringComparison.OrdinalIgnoreCase))
        ?.DisplayName ?? (_selectedModelId.Length > 0 ? _selectedModelId : "Default");

    private string RootClass => string.Join(' ', new[]
    {
        "ai-rail",
        AiAssistantState.IsOpen ? "ai-rail--open" : null,
        HostedInDock ? "ai-rail--docked" : null
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private string HistoryOverlayClass => string.Join(' ', new[]
    {
        "ai-rail__history-overlay",
        _showConversations ? "ai-rail__history-overlay--open" : null
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private string ReferencesClass => string.Join(' ', new[]
    {
        "ai-rail__references-panel",
        _showReferences ? "ai-rail__references-panel--open" : null
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private bool IsSendDisabled =>
        _isCommandRunning
        || ConversationState.SelectedConversation?.Id is not Guid
        || !AiAssistantConversationState.CanSendMessage(ConversationState.SelectedConversation)
        || string.IsNullOrWhiteSpace(_promptText);

    protected override void OnInitialized()
    {
        AiAssistantState.OnChange += StateHasChanged;
        ConversationState.OnChange += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_hasLoaded && AiAssistantState.IsAvailable && (AiAssistantState.IsOpen || HostedInDock))
        {
            await LoadConversationsAsync();
        }
    }

    private void ToggleConversations() => _showConversations = !_showConversations;

    private void ToggleReferences() => _showReferences = !_showReferences;

    private async Task LoadConversationsAsync()
    {
        _hasLoaded = true;
        ConversationState.SetLoading(true);
        ConversationState.SetError(null);

        await LoadBootstrapAsync();

        var collection = await ClientService.GetConversationCollectionAsync();
        ConversationState.SetConversationCollection(collection);
        if (collection is null)
        {
            ConversationState.SetError("AI assistant conversations are not available for your account.");
            return;
        }

        if (ConversationState.SelectedConversation is null)
        {
            if (ConversationState.Conversations.FirstOrDefault()?.Id is Guid firstConversationId)
            {
                await SelectConversationAsync(firstConversationId);
            }
            else if (ConversationState.CanCreateConversation)
            {
                // Create a new conversation inline to avoid blank page
                var result = await ClientService.CreateConversationAsync(new CreateAiConversationRequestDto
                {
                    Title = "AI Assistant",
                    ActorId = _selectedActorId
                });

                if (result.Success && result.Id is Guid newConversationId)
                {
                    var newCollection = await ClientService.GetConversationCollectionAsync();
                    ConversationState.SetConversationCollection(newCollection);
                    await SelectConversationAsync(newConversationId);
                }
                else
                {
                    ConversationState.SetError(result.Message ?? "The AI assistant conversation could not be created.");
                }
            }
        }

        ConversationState.SetLoading(false);
    }

    private async Task CreateConversationAsync()
    {
        if (!ConversationState.CanCreateConversation)
        {
            ConversationState.SetError("Conversation creation is not available for your account.");
            return;
        }

        await RunCommandAsync(async () =>
        {
            var result = await ClientService.CreateConversationAsync(new CreateAiConversationRequestDto
            {
                Title = "AI Assistant",
                ActorId = _selectedActorId
            });

            if (!result.Success || result.Id is not Guid conversationId)
            {
                ConversationState.SetError(result.Message ?? "The AI assistant conversation could not be created.");
                return;
            }

            _hasLoaded = false;
            await LoadConversationsAsync();
            await SelectConversationAsync(conversationId);
        });
    }

    private async Task SelectConversationAsync(Guid? conversationId)
    {
        if (conversationId is not Guid id)
        {
            return;
        }

        ConversationState.SetLoading(true);
        ConversationState.SetError(null);

        var conversation = await ClientService.GetConversationAsync(id);
        if (conversation is null)
        {
            ConversationState.SetError("The AI assistant conversation could not be loaded.");
        }

        ConversationState.SelectConversation(conversation);
        _activeRunId = FindActiveRunId(conversation);
        ConversationState.SetLoading(false);
    }

    private async Task SendMessageAsync()
    {
        if (ConversationState.SelectedConversation?.Id is not Guid conversationId || string.IsNullOrWhiteSpace(_promptText))
        {
            return;
        }

        if (!AiAssistantConversationState.CanSendMessage(ConversationState.SelectedConversation))
        {
            ConversationState.SetError("Sending messages is not available for this conversation.");
            return;
        }

        var content = _promptText.Trim();
        var idempotencyKey = $"blazor-ai-send-{Guid.CreateVersion7()}";

        await RunCommandAsync(async () =>
        {
            _promptText = string.Empty;
            ConversationState.SetError(null);

            var result = await ClientService.SendMessageAsync(
                conversationId,
                content,
                _selectedModelId,
                idempotencyKey,
                mode: SelectedInteractionMode,
                actorId: _selectedActorId);
            if (!result.Success)
            {
                _promptText = content;
                await RefreshSelectedConversationAsync(conversationId);
                ConversationState.SetError(result.Message ?? "The AI assistant message could not be sent.");
                return;
            }

            await RefreshSelectedConversationAsync(conversationId);
            if (result.Id is Guid runId)
            {
                _activeRunId = runId;
                await PollRunUntilCompleteAsync(conversationId, runId);
            }
        });
    }

    private async Task RefreshSelectedConversationAsync(Guid conversationId)
    {
        var conversation = await ClientService.GetConversationAsync(conversationId);
        if (conversation is not null)
        {
            ConversationState.SelectConversation(conversation);
            _activeRunId = FindActiveRunId(conversation);
        }
    }

    private async Task PollRunUntilCompleteAsync(Guid conversationId, Guid runId)
    {
        const int maxAttempts = 150;
        const int maxConsecutiveStatusLoadFailures = 3;
        var delay = TimeSpan.FromSeconds(2);
        var consecutiveStatusLoadFailures = 0;

        for (var attempt = 0; attempt < maxAttempts; attempt++)
        {
            if (attempt == 0 || attempt % 25 == 0)
            {
                var authOk = await TryRefreshAuthSessionAsync();
                if (!authOk && attempt == 0)
                {
                    Logger.LogWarning("AI polling: initial auth refresh failed; redirecting to login.");
                    RedirectToLogin();
                    return;
                }
            }

            var statusResult = await ClientService.GetRunStatusAsync(conversationId, runId);
            if (statusResult.IsUnauthorized)
            {
                Logger.LogWarning("AI polling: received 401 during run status polling; redirecting to login.");
                RedirectToLogin();
                return;
            }

            if (!statusResult.Success)
            {
                consecutiveStatusLoadFailures++;
                if (consecutiveStatusLoadFailures <= maxConsecutiveStatusLoadFailures)
                {
                    var authOk = await TryRefreshAuthSessionAsync();
                    if (!authOk)
                    {
                        Logger.LogWarning("AI polling: auth refresh failed after status load failure; redirecting to login.");
                        RedirectToLogin();
                        return;
                    }
                    await Task.Delay(delay);
                    continue;
                }

                ConversationState.SetError("The AI run status could not be loaded.");
                return;
            }

            consecutiveStatusLoadFailures = 0;
            var run = statusResult.Run!;

            if (IsTerminalRunStatus(run.Status))
            {
                _activeRunId = null;
                await RefreshSelectedConversationAsync(conversationId);
                if (IsFailedRunStatus(run.Status))
                {
                    ConversationState.SetError(run.FailureMessage ?? "AI provider failed to complete the run.");
                }

                return;
            }

            await RefreshSelectedConversationAsync(conversationId);
            await Task.Delay(delay);
        }

        await RefreshSelectedConversationAsync(conversationId);
        ConversationState.SetError("AI is still working on this response. You can keep waiting or cancel the run.");
    }

    private async Task<bool> TryRefreshAuthSessionAsync()
    {
        try
        {
            var response = await BffAuthApi.RefreshSessionInternalAsync(CancellationToken.None);
            if (!response.IsSuccessStatusCode)
            {
                Logger.LogDebug(
                    "AI polling auth refresh returned status {StatusCode}.",
                    (int)response.StatusCode);
                return false;
            }
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "AI polling auth refresh could not be completed.");
            return false;
        }
    }

    private void RedirectToLogin()
    {
        var returnUrl = Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.NavigateTo($"/login?returnUrl={returnUrl}", forceLoad: true);
    }

    private Guid? GetActiveRunId()
    {
        if (_activeRunId is Guid activeRunId)
        {
            return activeRunId;
        }

        return FindActiveRunId(ConversationState.SelectedConversation);
    }

    private static Guid? FindActiveRunId(HalResourceOfAiConversationDto? conversation)
    {
        return conversation?.Runs?
            .OrderByDescending(run => run.StartedAt ?? run.QueuedAt)
            .FirstOrDefault(run => IsActiveRunStatus(run.Status))
            ?.Id;
    }

    private async Task CancelActiveRunAsync()
    {
        if (_isCancelRunRunning ||
            ConversationState.SelectedConversation?.Id is not Guid conversationId ||
            GetActiveRunId() is not Guid runId)
        {
            return;
        }

        _isCancelRunRunning = true;
        try
        {
            var result = await ClientService.CancelRunAsync(conversationId, runId);
            _activeRunId = null;
            await RefreshSelectedConversationAsync(conversationId);

            if (!result.Success)
            {
                ConversationState.SetError(result.Message ?? "The AI assistant run could not be cancelled.");
            }
        }
        finally
        {
            _isCancelRunRunning = false;
        }
    }

    private async Task SearchReferencesAsync(string? searchTerm)
    {
        var term = (searchTerm ?? _referenceSearchTerm).Trim();
        _referenceSearchTerm = term;
        if (term.Length < 2)
        {
            _hasSearchedReferences = false;
            ConversationState.SetReferenceResults([]);
            return;
        }

        _hasSearchedReferences = true;
        _isReferenceSearchRunning = true;
        ConversationState.SetError(null);

        var references = await ClientService.SearchReferencesAsync(term);
        ConversationState.SetReferenceResults(references);
        _isReferenceSearchRunning = false;
    }

    private void SelectReference(HalResourceOfAiReferenceSearchResultDto reference)
    {
        if (ConversationState.SelectedReferences.Any(selected => selected.ReferenceId == reference.ReferenceId))
        {
            return;
        }

        ConversationState.SetSelectedReferences([.. ConversationState.SelectedReferences, reference]);
    }

    private void RemoveReference(Guid referenceId)
    {
        ConversationState.SetSelectedReferences(
            ConversationState.SelectedReferences.Where(reference => reference.ReferenceId != referenceId).ToList());
    }

    private async Task ConfirmActionAsync(ProposedActions2 action)
    {
        if (!IsBuildCapabilitySelected)
        {
            ConversationState.SetError("Switch to Build mode to confirm proposed AI actions.");
            return;
        }

        if (ConversationState.SelectedConversation?.Id is not Guid conversationId || action.Id is not Guid actionId)
        {
            return;
        }

        await RunActionAsync(actionId, async () =>
        {
            var result = await ClientService.ConfirmProposedActionAsync(
                conversationId,
                actionId,
                $"blazor-ai-confirm-{Guid.CreateVersion7()}");

            if (!result.Success)
            {
                ConversationState.SetError(result.Message ?? "The AI proposed action could not be confirmed.");
                return;
            }

            await SelectConversationAsync(conversationId);
        });
    }

    private async Task RejectActionAsync(ProposedActions2 action)
    {
        if (!IsBuildCapabilitySelected)
        {
            ConversationState.SetError("Switch to Build mode to reject proposed AI actions.");
            return;
        }

        if (ConversationState.SelectedConversation?.Id is not Guid conversationId || action.Id is not Guid actionId)
        {
            return;
        }

        await RunActionAsync(actionId, async () =>
        {
            var result = await ClientService.RejectProposedActionAsync(conversationId, actionId);
            if (!result.Success)
            {
                ConversationState.SetError(result.Message ?? "The AI proposed action could not be rejected.");
                return;
            }

            await SelectConversationAsync(conversationId);
        });
    }

    private async Task RunCommandAsync(Func<Task> operation)
    {
        if (_isCommandRunning)
        {
            return;
        }

        _isCommandRunning = true;
        try
        {
            await operation();
        }
        finally
        {
            _isCommandRunning = false;
        }
    }

    private async Task RunActionAsync(Guid actionId, Func<Task> operation)
    {
        if (!_busyActionIds.Add(actionId))
        {
            return;
        }

        try
        {
            await operation();
        }
        finally
        {
            _busyActionIds.Remove(actionId);
        }
    }

