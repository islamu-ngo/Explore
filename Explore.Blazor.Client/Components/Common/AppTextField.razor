@* ABOUTME: Thin wrapper around MudTextField<T> providing project default styling (Outlined variant). *@
@* ABOUTME: Composition wrapper — does NOT inherit MudFormComponent. All params pass through via @attributes. *@
@typeparam T

<div class="app-text-field">
    <MudTextField T="T"
                  Variant="@Variant"
                  Margin="@Margin"
                  InputType="@InputType"
                  Adornment="@Adornment"
                  Dense="@Dense"
                  Required="@Required"
                  Disabled="@Disabled"
                  ReadOnly="@ReadOnly"
                  Immediate="@Immediate"
                  Lines="@Lines"
                  MaxLength="@MaxLength"
                  DebounceInterval="@DebounceInterval"
                  @attributes="AdditionalAttributes" />
</div>

@code {
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.None;
    [Parameter] public InputType InputType { get; set; } = InputType.Text;
    [Parameter] public Adornment Adornment { get; set; } = Adornment.None;
    [Parameter] public bool Dense { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Immediate { get; set; }
    [Parameter] public int Lines { get; set; } = 1;
    [Parameter] public int MaxLength { get; set; } = 524288;
    [Parameter] public double DebounceInterval { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }
}
