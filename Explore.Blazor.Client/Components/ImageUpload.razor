@using Microsoft.AspNetCore.Components.Forms
@using Explore.Blazor.Client.Services
@using Microsoft.Extensions.Logging
@inject IImageStorageService ImageStorageService
@inject ILogger<ImageUpload> Logger

<div class="d-flex flex-column gap-2" style="@($"width: {Width};")">
    <div class="relative d-flex justify-center align-center overflow-hidden rounded-lg border-2 border-dashed mud-border-primary" 
         style="@($"height: {Height}; background-color: var(--mud-palette-background-grey);")">
        
        @if (!string.IsNullOrEmpty(PreviewUrl))
        {
            <img src="@PreviewUrl" alt="@(Alt ?? "Image preview")" style="width: 100%; height: 100%; object-fit: cover;" />
        }
        else
        {
            <div class="d-flex flex-column align-center gap-2 pa-4 text-center">
                <MudIcon Icon="@(Icon ?? Icons.Material.Filled.Image)" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@(PlaceholderText ?? "No image selected")</MudText>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="my-1" ShowCloseIcon="true" CloseIconClicked="@(() => _errorMessage = null)">@_errorMessage</MudAlert>
    }

    <div class="d-flex justify-center gap-2">
        <MudFileUpload T="IBrowserFile"
                       @ref="_fileUpload"
                       FilesChanged="OnFileSelected"
                       Accept="@AcceptedFormats"
                       MaximumFileCount="1">
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.CloudUpload"
                           Color="Color.Primary"
                           Size="Size.Small">
                    @(UploadButtonText ?? "Select Image")
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>

        @if (HasImage)
        {
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       Size="Size.Small"
                       OnClick="RemoveImage">
                Remove
            </MudButton>
        }
    </div>

    @if (!string.IsNullOrEmpty(HintText))
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">@HintText</MudText>
    }
</div>

@code {
    [Parameter] public string? PreviewUrl { get; set; }
    [Parameter] public EventCallback<string?> PreviewUrlChanged { get; set; }

    /// <summary>
    /// Legacy callback that passes IBrowserFile. Prefer using FileDataSelected for reliable WASM uploads.
    /// </summary>
    [Parameter] public EventCallback<IBrowserFile?> FileSelected { get; set; }

    /// <summary>
    /// Preferred callback that passes FileUploadData (bytes read into memory).
    /// This prevents stream exhaustion issues in Blazor WASM.
    /// </summary>
    [Parameter] public EventCallback<FileUploadData?> FileDataSelected { get; set; }

    // Customization parameters
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public string Height { get; set; } = "250px";
    [Parameter] public string? PlaceholderText { get; set; }
    [Parameter] public string? UploadButtonText { get; set; }
    [Parameter] public string? HintText { get; set; } = "Supported formats: JPG, PNG, GIF, WebP (Max 5MB)";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Alt { get; set; }
    [Parameter] public string AcceptedFormats { get; set; } = ".jpg,.jpeg,.png,.gif,.webp";
    [Parameter] public long MaxFileSize { get; set; } = 5 * 1024 * 1024; // 5MB default

    /// <summary>
    /// Set to true to show a loading indicator while processing the file.
    /// </summary>
    [Parameter] public bool IsProcessing { get; set; }

    private MudFileUpload<IBrowserFile>? _fileUpload;
    private bool _isReadingFile;
    private bool HasImage => !string.IsNullOrEmpty(PreviewUrl);
    private string? _errorMessage;

    private async Task OnFileSelected(IBrowserFile? file)
    {
        _errorMessage = null;
        if (file == null) return;

        // Validate file type
        var allowedTypes = new[] { "image/jpeg", "image/png", "image/gif", "image/webp" };
        if (!allowedTypes.Contains(file.ContentType.ToLower()))
        {
            _errorMessage = "Please select a valid image file (JPG, PNG, GIF, or WebP)";
            return;
        }

        // Validate file size
        if (file.Size > MaxFileSize)
        {
            var maxSizeMB = MaxFileSize / (1024.0 * 1024.0);
            _errorMessage = $"File size must be less than {maxSizeMB:F1}MB";
            return;
        }

        _isReadingFile = true;
        StateHasChanged();

        try
        {
            Logger.LogInformation("[ImageUpload] Starting file processing for {FileName} ({Size} bytes)", file.Name, file.Size);

            // STEP 1: Read the file bytes FIRST - this is reliable
            // We'll generate the preview from these bytes (skip browser-side resizing which can hang)
            Logger.LogInformation("[ImageUpload] Step 1: Reading file {FileName} ({Size} bytes) into memory...", file.Name, file.Size);
            var fileData = await ImageStorageService.ReadFileAsync(file, MaxFileSize);

            if (fileData == null)
            {
                Logger.LogError("[ImageUpload] ReadFileAsync returned null for {FileName}", file.Name);
                _errorMessage = "Failed to read the selected file. Please try again.";
                await RemoveImage();
                return;
            }

            Logger.LogInformation("[ImageUpload] Step 1a: Successfully read {ByteCount} bytes from {FileName}", fileData.Size, fileData.FileName);

            // STEP 2: Generate preview from the bytes we just read
            // Use full-size bytes directly - browser-side resizing (RequestImageFileAsync) can hang in WASM
            Logger.LogInformation("[ImageUpload] Step 2: Generating preview from bytes...");
            string localPreview = ImageStorageService.GenerateLocalPreviewFromBytes(fileData);

            if (string.IsNullOrEmpty(localPreview))
            {
                Logger.LogWarning("[ImageUpload] Failed to generate preview for {FileName}", fileData.FileName);
                _errorMessage = "Failed to generate image preview";
                // Continue anyway - the upload might still work
            }
            else
            {
                Logger.LogInformation("[ImageUpload] Step 2a: Preview generated successfully");
            }

            // STEP 3: Update preview URL and notify parent
            // Yield to allow UI thread to process before heavy operations
            await Task.Yield();
            Logger.LogInformation("[ImageUpload] Step 3: Setting preview URL (length={Length} chars)...", localPreview?.Length ?? 0);
            try
            {
                PreviewUrl = localPreview;
                Logger.LogInformation("[ImageUpload] Step 3a: PreviewUrl property set");

                // Use InvokeAsync to ensure we're on the correct sync context
                await InvokeAsync(() =>
                {
                    Logger.LogInformation("[ImageUpload] Step 3b: Inside InvokeAsync, calling StateHasChanged...");
                    StateHasChanged();
                });
                Logger.LogInformation("[ImageUpload] Step 3c: StateHasChanged completed");

                // Yield again after render to let browser process
                await Task.Yield();

                if (PreviewUrlChanged.HasDelegate)
                {
                    Logger.LogInformation("[ImageUpload] Step 3d: Invoking PreviewUrlChanged callback...");
                    await PreviewUrlChanged.InvokeAsync(localPreview);
                    Logger.LogInformation("[ImageUpload] Step 3e: PreviewUrlChanged callback completed");
                }
                else
                {
                    Logger.LogWarning("[ImageUpload] Step 3d: PreviewUrlChanged has no delegate");
                }
            }
            catch (Exception previewEx)
            {
                Logger.LogError(previewEx, "[ImageUpload] Error during preview URL update: {Message}", previewEx.Message);
                // Continue - don't fail the entire upload just because preview failed
            }

            // STEP 4: Pass the file data to the parent component for upload
            Logger.LogInformation("[ImageUpload] Step 4: Checking FileDataSelected delegate (HasDelegate={HasDelegate})...", FileDataSelected.HasDelegate);
            if (FileDataSelected.HasDelegate)
            {
                Logger.LogInformation("[ImageUpload] Step 4a: Invoking FileDataSelected callback with {Size} bytes...", fileData.Size);
                await FileDataSelected.InvokeAsync(fileData);
                Logger.LogInformation("[ImageUpload] Step 4b: FileDataSelected callback completed successfully");
            }
            else
            {
                Logger.LogWarning("[ImageUpload] FileDataSelected has no delegate - parent callback not configured!");
            }

            // STEP 5: Also invoke legacy callback for backward compatibility
            if (FileSelected.HasDelegate)
            {
                Logger.LogInformation("[ImageUpload] Step 5: Invoking legacy FileSelected callback...");
                await FileSelected.InvokeAsync(file);
            }

            Logger.LogInformation("[ImageUpload] ✓ File processing completed successfully for {FileName}", file.Name);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error processing selected file {FileName}", file.Name);
            _errorMessage = $"An error occurred while processing the image: {ex.Message}";
            await RemoveImage();
        }
        finally
        {
            _isReadingFile = false;
            StateHasChanged();
        }
    }

    public async Task RemoveImage()
    {
        PreviewUrl = null;
        _errorMessage = null;
        await PreviewUrlChanged.InvokeAsync(null);

        // Notify parent that file was removed
        if (FileDataSelected.HasDelegate)
        {
            await FileDataSelected.InvokeAsync(null);
        }
        if (FileSelected.HasDelegate)
        {
            await FileSelected.InvokeAsync(null);
        }

        // Clear the file upload component
        if (_fileUpload != null)
        {
            await _fileUpload.ClearAsync();
        }

        StateHasChanged();
    }
}
