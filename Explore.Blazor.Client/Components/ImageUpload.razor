@using Microsoft.AspNetCore.Components.Forms
@using Explore.Blazor.Client.Services
@using Microsoft.Extensions.Logging
@inject IImageStorageService ImageStorageService
@inject ISnackbar Snackbar
@inject ILogger<ImageUpload> Logger

<div class="image-upload">
    <div class="image-upload__preview @(HasImage ? "image-upload__preview--has-image" : "")" style="@($"width: {Width}; height: {Height};")">
        @if (!string.IsNullOrEmpty(PreviewUrl))
        {
            <img class="image-upload__image" src="@PreviewUrl" alt="@(Alt ?? "Image preview")" />
        }
        else
        {
            <div class="image-upload__placeholder">
                <MudIcon Icon="@(Icon ?? Icons.Material.Filled.Image)" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body2">@(PlaceholderText ?? "No image selected")</MudText>
            </div>
        }
    </div>

    <div class="image-upload__actions">
        <MudFileUpload T="IBrowserFile"
                       @ref="_fileUpload"
                       FilesChanged="OnFileSelected"
                       Accept="@AcceptedFormats"
                       MaximumFileCount="1">
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.CloudUpload"
                           Color="Color.Primary">
                    @(UploadButtonText ?? "Select Image")
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>

        @if (HasImage)
        {
            <MudButton Variant="Variant.Text"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="RemoveImage">
                Remove
            </MudButton>
        }
    </div>

    @if (!string.IsNullOrEmpty(HintText))
    {
        <MudText Class="image-upload__hint">@HintText</MudText>
    }
</div>

@code {
    [Parameter] public string? PreviewUrl { get; set; }
    [Parameter] public EventCallback<string?> PreviewUrlChanged { get; set; }
    [Parameter] public EventCallback<IBrowserFile?> FileSelected { get; set; }

    // Customization parameters
    [Parameter] public string Width { get; set; } = "100%";
    [Parameter] public string Height { get; set; } = "250px";
    [Parameter] public string? PlaceholderText { get; set; }
    [Parameter] public string? UploadButtonText { get; set; }
    [Parameter] public string? HintText { get; set; } = "Supported formats: JPG, PNG, GIF, WebP (Max 5MB)";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Alt { get; set; }
    [Parameter] public string AcceptedFormats { get; set; } = ".jpg,.jpeg,.png,.gif,.webp";
    [Parameter] public long MaxFileSize { get; set; } = 5 * 1024 * 1024; // 5MB default

    private MudFileUpload<IBrowserFile>? _fileUpload;
    private bool HasImage => !string.IsNullOrEmpty(PreviewUrl);

    private async Task OnFileSelected(IBrowserFile? file)
    {
        if (file == null) return;

        // Validate file type
        var allowedTypes = new[] { "image/jpeg", "image/png", "image/gif", "image/webp" };
        if (!allowedTypes.Contains(file.ContentType.ToLower()))
        {
            Snackbar.Add("Please select a valid image file (JPG, PNG, GIF, or WebP)", Severity.Error);
            return;
        }

        // Validate file size
        if (file.Size > MaxFileSize)
        {
            var maxSizeMB = MaxFileSize / (1024.0 * 1024.0);
            Snackbar.Add($"File size must be less than {maxSizeMB:F1}MB", Severity.Error);
            return;
        }

        try
        {
            // Generate local preview
            var localPreview = await ImageStorageService.GenerateLocalPreviewAsync(file, MaxFileSize);
            PreviewUrl = localPreview;
            await PreviewUrlChanged.InvokeAsync(localPreview);

            // Pass the selected file to the parent
            await FileSelected.InvokeAsync(file);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Preview generation error");
            Snackbar.Add("An error occurred while generating the image preview", Severity.Error);
            await RemoveImage();
        }
    }

    public async Task RemoveImage()
    {
        PreviewUrl = null;
        await PreviewUrlChanged.InvokeAsync(null);
        await FileSelected.InvokeAsync(null);

        // Clear the file upload component
        if (_fileUpload != null)
        {
            await _fileUpload.ClearAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(PreviewUrl))
        {
            await PreviewUrlChanged.InvokeAsync(PreviewUrl);
        }
    }
}
