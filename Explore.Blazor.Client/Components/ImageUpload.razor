@using Microsoft.AspNetCore.Components.Forms
@using Explore.Blazor.Client.Services
@inject IImageStorageService ImageStorageService
@inject ISnackbar Snackbar

<style>
.image-upload-container {
    width: 100%;
}

.image-preview-box {
    width: 100%;
    max-width: @(Width ?? "300px");
    height: @(Height ?? "200px");
    border: 2px dashed var(--mud-palette-lines-default);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    position: relative;
    background-color: var(--mud-palette-background-gray);
    overflow: hidden;
    transition: border-color .2s ease, background-color .2s ease;
}

.image-preview-box:hover {
    border-color: var(--mud-palette-primary);
    background-color: color-mix(in srgb, var(--mud-palette-primary) 5%, var(--mud-palette-background-gray));
}

.image-preview-box.has-image {
    border-style: solid;
    border-color: var(--mud-palette-lines-default);
}

.image-preview-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.image-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--mud-palette-text-secondary);
}

.image-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.upload-hint {
    font-size: 0.875rem;
    color: var(--mud-palette-text-secondary);
    margin-top: 8px;
}

.loading-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
}
</style>

<div class="image-upload-container">
    <div class="image-preview-box @(HasImage ? "has-image" : "")">
        @if (IsUploading)
        {
            <div class="loading-overlay">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        
        @if (!string.IsNullOrEmpty(PreviewUrl))
        {
            <img src="@PreviewUrl" alt="@(Alt ?? "Image preview")" />
        }
        else
        {
            <div class="image-placeholder">
                <MudIcon Icon="@(Icon ?? Icons.Material.Filled.Image)" Size="Size.Large" Color="Color.Secondary" />
                <MudText Typo="Typo.body2">@(PlaceholderText ?? "No image selected")</MudText>
            </div>
        }
    </div>

    <div class="image-actions">
        <MudFileUpload T="IBrowserFile" 
                       FilesChanged="OnFileSelected" 
                       Accept="@AcceptedFormats"
                       Disabled="@IsUploading">
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined" 
                          StartIcon="@Icons.Material.Filled.CloudUpload" 
                          Color="Color.Primary"
                          Disabled="@IsUploading">
                    @(UploadButtonText ?? "Upload Image")
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>

        @if (HasImage && !IsUploading)
        {
            <MudButton Variant="Variant.Text" 
                      Color="Color.Error" 
                      StartIcon="@Icons.Material.Filled.Delete"
                      OnClick="RemoveImage">
                Remove
            </MudButton>
        }
    </div>

    @if (!string.IsNullOrEmpty(HintText))
    {
        <MudText Class="upload-hint">@HintText</MudText>
    }
</div>

@code {
    [Parameter] public string? ImageKey { get; set; }
    [Parameter] public EventCallback<string?> ImageKeyChanged { get; set; }
    [Parameter] public string? PreviewUrl { get; set; }
    [Parameter] public EventCallback<string?> PreviewUrlChanged { get; set; }
    
    // Customization parameters
    [Parameter] public string? Width { get; set; }
    [Parameter] public string? Height { get; set; }
    [Parameter] public string? PlaceholderText { get; set; }
    [Parameter] public string? UploadButtonText { get; set; }
    [Parameter] public string? HintText { get; set; } = "Supported formats: JPG, PNG, GIF, WebP (Max 5MB)";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Alt { get; set; }
    [Parameter] public string AcceptedFormats { get; set; } = ".jpg,.jpeg,.png,.gif,.webp";
    [Parameter] public long MaxFileSize { get; set; } = 5 * 1024 * 1024; // 5MB default
    
    private bool IsUploading { get; set; }
    private bool HasImage => !string.IsNullOrEmpty(ImageKey) || !string.IsNullOrEmpty(PreviewUrl);

    private async Task OnFileSelected(IBrowserFile? file)
    {
        if (file == null) return;

        // Validate file type
        var allowedTypes = new[] { "image/jpeg", "image/png", "image/gif", "image/webp" };
        if (!allowedTypes.Contains(file.ContentType.ToLower()))
        {
            Snackbar.Add("Please select a valid image file (JPG, PNG, GIF, or WebP)", Severity.Error);
            return;
        }

        // Validate file size
        if (file.Size > MaxFileSize)
        {
            var maxSizeMB = MaxFileSize / (1024.0 * 1024.0);
            Snackbar.Add($"File size must be less than {maxSizeMB:F1}MB", Severity.Error);
            return;
        }

        IsUploading = true;
        StateHasChanged();

        try
        {
            // Generate local preview first
            var localPreview = await ImageStorageService.GenerateLocalPreviewAsync(file, MaxFileSize);
            PreviewUrl = localPreview;
            await PreviewUrlChanged.InvokeAsync(localPreview);
            StateHasChanged();

            // Get upload URL from backend
            var uploadResponse = await ImageStorageService.GetUploadUrlAsync(file.Name, file.ContentType);
            
            if (uploadResponse == null)
            {
                Snackbar.Add("Failed to get upload URL. Please try again.", Severity.Error);
                return;
            }

            // Upload the file
            var uploadSuccess = await ImageStorageService.UploadImageAsync(uploadResponse.UploadUrl, file);
            
            if (uploadSuccess)
            {
                // Update with S3 URLs
                ImageKey = uploadResponse.ImageKey;
                PreviewUrl = uploadResponse.ViewUrl;
                
                await ImageKeyChanged.InvokeAsync(uploadResponse.ImageKey);
                await PreviewUrlChanged.InvokeAsync(uploadResponse.ViewUrl);
                
                Snackbar.Add("Image uploaded successfully", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to upload image. Please try again.", Severity.Error);
                PreviewUrl = null;
                await PreviewUrlChanged.InvokeAsync(null);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Upload error: {ex.Message}");
            Snackbar.Add("An error occurred while uploading the image", Severity.Error);
            PreviewUrl = null;
            await PreviewUrlChanged.InvokeAsync(null);
        }
        finally
        {
            IsUploading = false;
            StateHasChanged();
        }
    }

    private async Task RemoveImage()
    {
        if (!string.IsNullOrEmpty(ImageKey))
        {
            // Optionally delete from S3
            await ImageStorageService.DeleteImageAsync(ImageKey);
        }

        ImageKey = null;
        PreviewUrl = null;
        
        await ImageKeyChanged.InvokeAsync(null);
        await PreviewUrlChanged.InvokeAsync(null);
        
        Snackbar.Add("Image removed", Severity.Info);
    }

    protected override async Task OnParametersSetAsync()
    {
        // If we have an ImageKey but no PreviewUrl, fetch it
        if (!string.IsNullOrEmpty(ImageKey) && string.IsNullOrEmpty(PreviewUrl))
        {
            var url = await ImageStorageService.GetImageUrlAsync(ImageKey);
            if (!string.IsNullOrEmpty(url))
            {
                PreviewUrl = url;
                await PreviewUrlChanged.InvokeAsync(url);
            }
        }
    }
}
