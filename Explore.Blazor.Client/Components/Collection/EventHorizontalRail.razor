@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Components.Presentation

<div class="event-rail mb-10">
    <div class="d-flex align-center justify-space-between mb-4 px-2">
        <div class="d-flex align-center gap-3">
            <MudText Typo="Typo.h5" Class="font-weight-black" Style="letter-spacing: 0.5px;">@Title.ToUpper()</MudText>
            @if (IsTrending)
            {
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Primary" />
            }
        </div>
        <MudLink Href="@ViewAllUrl" Underline="Underline.None" Class="d-flex align-center gap-1 font-weight-bold">
            VIEW ALL <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
        </MudLink>
    </div>

    <div class="event-rail__container">
        @if (Events == null || !Events.Any())
        {
            <div class="d-flex gap-4 overflow-x-auto pb-4 hide-scrollbar">
                @for (int i = 0; i < 5; i++)
                {
                    <div class="event-rail__item-skeleton">
                        <Explore.Blazor.Client.Pages.Events.Components.EventCardSkeleton Layout="LayoutMode.CompactGrid" />
                    </div>
                }
            </div>
        }
        else
        {
            <div class="d-flex gap-4 overflow-x-auto pb-4 hide-scrollbar px-2">
                @foreach (var evt in Events)
                {
                    <div class="event-rail__item">
                        <EventCard Event="evt" OnEventClick="HandleEventClick" />
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .event-rail__container {
        position: relative;
    }

    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .event-rail__item {
        flex: 0 0 280px;
        max-width: 280px;
    }

    .event-rail__item-skeleton {
        flex: 0 0 280px;
        width: 280px;
    }

    @@media (max-width: 600px) {
        .event-rail__item, .event-rail__item-skeleton {
            flex: 0 0 240px;
            max-width: 240px;
        }
    }
</style>

@code {
    [Parameter] public string Title { get; set; } = "Events";
    [Parameter] public string ViewAllUrl { get; set; } = "/events";
    [Parameter] public IEnumerable<EventListDto>? Events { get; set; }
    [Parameter] public bool IsTrending { get; set; }
    [Parameter] public EventCallback<EventListDto> OnEventClick { get; set; }

    private async Task HandleEventClick(EventListDto evt)
    {
        if (OnEventClick.HasDelegate)
            await OnEventClick.InvokeAsync(evt);
    }
}
