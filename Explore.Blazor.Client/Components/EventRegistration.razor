@inject IProgramService ProgramService
@inject IUserService UserService
@inject ISnackbar Snackbar

<style>
/* ===== DIALOG STYLING ===== */
.registration-shell {
    padding: 24px;
}

/* ===== SUCCESS STATE ===== */
.success-content {
    text-align: center;
    padding: 48px 24px;
}

.success-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 24px;
    background: var(--mud-palette-success);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: scaleIn 0.4s ease-out;
}

@@keyframes scaleIn {
    from {
        transform: scale(0.5);
        opacity: 0;
    }
    to {
        transform: scale(1);
        opacity: 1;
    }
}

.success-icon .mud-icon-root {
    font-size: 3rem;
    color: white;
}

.success-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 12px;
    color: var(--mud-palette-success);
}

.success-message {
    color: var(--mud-palette-text-secondary);
    line-height: 1.6;
    margin-bottom: 24px;
}

.action-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-top: 24px;
}
</style>

<MudDialog Class="registration-dialog">
    <DialogContent>
        @if (isLoading)
        {
            <div class="registration-shell" style="text-align: center; padding: 48px;">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.body1" style="margin-top: 16px;">
                    Checking registration status...
                </MudText>
            </div>
        }
        else if (isAlreadyRegistered)
        {
            <div class="registration-shell">
                <div class="success-content">
                    <div class="success-icon">
                        <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Style="color: var(--mud-palette-success);" />
                    </div>
                    <MudText Typo="Typo.h4" Class="success-title">
                        You're Already Registered! ✅
                    </MudText>
                    <MudText Typo="Typo.body1" Class="success-message">
                        You have already registered for this event.<br />
                        We look forward to seeing you there!
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               OnClick="Close"
                               StartIcon="@Icons.Material.Filled.Close">
                        Close
                    </MudButton>
                </div>
            </div>
        }
        else if (!isRegistered)
        {
            <div class="registration-shell">
                <MudText Typo="Typo.h5" Class="mb-2">@Title</MudText>
                <MudText Typo="Typo.body2" Class="mb-6 mud-text-secondary">
                    Click confirm to register for this event
                </MudText>

                @if (currentUser != null)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-4">
                        You will be registered as: <strong>@currentUser.FirstName @currentUser.LastName</strong> (@currentUser.Email)
                    </MudAlert>
                }

                <div class="action-buttons">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Default"
                               OnClick="Cancel"
                               Disabled="isSubmitting">
                        Cancel
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="HandleSubmit"
                               Disabled="isSubmitting || currentUser == null"
                               StartIcon="@(isSubmitting ? null : Icons.Material.Filled.CheckCircle)">
                        @if (isSubmitting)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Registering...</span>
                        }
                        else
                        {
                            <span>Confirm Registration</span>
                        }
                    </MudButton>
                </div>
            </div>
        }
        else
        {
            <div class="registration-shell">
                <div class="success-content">
                    <div class="success-icon">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                    </div>
                    <MudText Typo="Typo.h4" Class="success-title">
                        Registration Successful! 🎉
                    </MudText>
                    <MudText Typo="Typo.body1" Class="success-message">
                        Thank you for registering@(currentUser != null ? $", {currentUser.FirstName}" : "")! <br />
                        You will receive a confirmation email shortly.
                    </MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               OnClick="Close"
                               StartIcon="@Icons.Material.Filled.Close">
                        Close
                    </MudButton>
                </div>
            </div>
        }
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private MudBlazor.IDialogReference? DialogReference { get; set; }

    [Parameter]
    public Guid ProgramId { get; set; }

    [Parameter]
    public string Title { get; set; } = "Register for Event";

    private CreateEventRegistrationDto registrationModel = new();
    private UserDto? currentUser;
    private bool isSubmitting = false;
    private bool isRegistered = false;
    private bool isAlreadyRegistered = false;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Get current user
            currentUser = await UserService.GetCurrentUserAsync();
            
            if (currentUser != null)
            {
                registrationModel.EventSessionId = ProgramId;
                registrationModel.UserId = currentUser.Id;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading user data: {ex.Message}", Severity.Warning);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (currentUser == null)
        {
            Snackbar.Add("You must be logged in to register.", Severity.Error);
            return;
        }

        isSubmitting = true;

        try
        {
            var response = await ProgramService.RegisterForProgramAsync(registrationModel);

            if (response?.Success == true)
            {
                isRegistered = true;
                Snackbar.Add("You have been successfully registered!", Severity.Success);
            }
            else
            {
                Snackbar.Add(response?.Message ?? "Something went wrong. Please try again later.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Registration error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        DialogReference?.Close();
    }

    private void Close()
    {
        DialogReference?.Close();
    }
}
