@using MudBlazor
@using Explore.Blazor.Client.Clients

<div class="featured-event-hero rounded-xl overflow-hidden relative mud-elevation-6 mb-8" style="@GetHeroStyle()">
    <div class="featured-event-hero__overlay"></div>
    
    <div class="featured-event-hero__content pa-8 pa-md-16 d-flex flex-column justify-end h-100 relative">
        <MudStack Spacing="2" Class="mb-6">
            <div class="d-flex gap-2 mb-2">
                @if (!string.IsNullOrEmpty(Event.EventFormatFullName))
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold px-4">@Event.EventFormatFullName.ToUpperInvariant()</MudChip>
                }
                @if (Event.Price == 0 || Event.Price == null)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold px-4">FREE</MudChip>
                }
                @if (IsFeaturedToday())
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold px-4 animate-pulse">LIVE NOW</MudChip>
                }
            </div>
            
            <MudText Typo="Typo.h2" Class="featured-event-hero__title font-weight-black mb-2">@Event.Title</MudText>
            
            <div class="d-flex align-center gap-4 mb-4">
                <div class="d-flex align-center gap-2">
                    <MudAvatar Size="Size.Small" Image="@Event.ActorProfilePictureUri" />
                    <MudText Typo="Typo.subtitle1" Class="font-weight-medium">@Event.ActorDisplayName</MudText>
                </div>
                <MudDivider Vertical="true" FlexItem="true" DividerType="DividerType.Middle" Class="my-1" Style="background-color: rgba(255,255,255,0.3)" />
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" />
                    <MudText Typo="Typo.subtitle1" Class="font-weight-medium">
                        @if (Event.FirstSessionDate.HasValue)
                        {
                            @Event.FirstSessionDate.Value.ToString("MMMM dd, yyyy")
                        }
                        else
                        {
                            @("Date to be announced")
                        }
                    </MudText>
                </div>
            </div>

            <MudText Typo="Typo.body1" Class="featured-event-hero__description d-none d-md-block">
                @GetDescription()
            </MudText>
        </MudStack>

        <div class="d-flex gap-4 align-center">
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       Size="Size.Large" 
                       Class="rounded-pill px-10 py-4 font-weight-bold" 
                       Style="font-size: 1.1rem; letter-spacing: 1px;"
                       Href="@($"/event/detail/{Event.Id}")">
                VIEW EVENT
            </MudButton>
            
            <MudIconButton Icon="@Icons.Material.Filled.BookmarkBorder" 
                           Color="Color.Inherit" 
                           Class="rounded-circle pa-4" 
                           Style="background: rgba(255,255,255,0.1); backdrop-filter: blur(10px);" />
            
            <MudIconButton Icon="@Icons.Material.Filled.Share" 
                           Color="Color.Inherit" 
                           Class="rounded-circle pa-4" 
                           Style="background: rgba(255,255,255,0.1); backdrop-filter: blur(10px);" />
        </div>
    </div>
</div>

<style>
    .featured-event-hero {
        height: 600px;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        color: white;
    }

    .featured-event-hero__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 40%, rgba(0,0,0,0.1) 100%),
                    linear-gradient(to right, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 50%);
    }

    .featured-event-hero__content {
        z-index: 2;
    }

    .featured-event-hero__title {
        line-height: 1;
        text-shadow: 0 4px 20px rgba(0,0,0,0.5);
        font-size: clamp(2.5rem, 5vw, 4rem) !important;
    }

    .featured-event-hero__description {
        max-width: 800px;
        font-size: 1.1rem;
        opacity: 0.9;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }

    .animate-pulse {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: .7; }
    }
</style>

@code {
    [Parameter] public EventListDto Event { get; set; } = default!;

    private string GetDescription()
    {
        if (Event.SessionCount.GetValueOrDefault() > 1)
        {
            return $"Hosted by {Event.ActorDisplayName} with {Event.SessionCount} scheduled sessions.";
        }

        return $"Hosted by {Event.ActorDisplayName} in {Event.Timezone ?? "the local timezone"}.";
    }

    private bool IsFeaturedToday()
    {
        return Event.FirstSessionDate.HasValue && Event.FirstSessionDate.Value.UtcDateTime.Date == DateTime.UtcNow.Date;
    }

    private string GetHeroStyle()
    {
        var img = !string.IsNullOrEmpty(Event.FeaturedImageUri) ? Event.FeaturedImageUri : "image/landing_placeholder.png";
        return $"background-image: url('{img}');";
    }
}
