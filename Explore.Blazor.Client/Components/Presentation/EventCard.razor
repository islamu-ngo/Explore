@using MudBlazor
@using Explore.Blazor.Client.Clients

<AppCard Class="event-card rounded-xl overflow-hidden cursor-pointer hover-scale" @onclick="OnClick">
    <div class="event-card__image-container relative">
        <MudImage Src="@(string.IsNullOrEmpty(Event.FeaturedImageUri) ? "image/landing_placeholder.png" : Event.FeaturedImageUri)" 
                  Alt="@Event.Title"
                  ObjectFit="ObjectFit.Cover"
                  Class="event-card__image" />
        
        <div class="event-card__badges absolute top-0 left-0 pa-3 d-flex flex-column gap-2">
            @if (Event.Price == 0 || Event.Price == null)
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold">FREE</MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Surface" Size="Size.Small" Variant="Variant.Filled" Class="font-weight-bold">@Event.Price @Event.CurrencyCode</MudChip>
            }
        </div>

        <div class="event-card__status absolute bottom-0 right-0 pa-3">
            @if (IsPastEvent())
            {
                <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Filled">PAST</MudChip>
            }
            else if (IsUpcomingToday())
            {
                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">ONGOING</MudChip>
            }
        </div>
    </div>

    <MudCardContent Class="pa-4 flex-grow-1">
        <MudText Typo="Typo.subtitle1" Class="event-card__title font-weight-black mb-1" Style="line-height: 1.2;">@Event.Title</MudText>
        
        <div class="d-flex align-center gap-2 mb-2">
            <MudAvatar Size="Size.Small" Image="@Event.ActorProfilePictureUri" Class="mr-n1" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-medium">@Event.ActorDisplayName</MudText>
        </div>

        <div class="d-flex align-center gap-2 mt-auto">
            <div class="d-flex align-center gap-1 px-2 py-1 rounded-pill" style="background: rgba(var(--mud-palette-info-rgb), 0.1);">
                <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Color="Color.Info" Style="font-size: 0.9rem;" />
                <MudText Typo="Typo.caption" Color="Color.Info" Class="font-weight-bold" Style="font-size: 0.75rem;">
                    @if (Event.FirstSessionDate.HasValue)
                    {
                        @Event.FirstSessionDate.Value.ToString("MMM dd")
                    }
                    else
                    {
                        @("TBD")
                    }
                </MudText>
            </div>
            
            @if (Event.TotalViews > 50)
            {
                <div class="d-flex align-center gap-1 ml-auto">
                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Secondary" Style="font-size: 0.9rem;" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Event.TotalViews</MudText>
                </div>
            }
        </div>
    </MudCardContent>
</AppCard>

<style>
    .event-card {
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid var(--mud-palette-divider);
        background: var(--mud-palette-surface);
    }

    .event-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.12);
        border-color: var(--mud-palette-primary-lighten);
    }

    .event-card__image-container {
        height: 160px;
        width: 100%;
        overflow: hidden;
        position: relative;
    }

    .event-card__image {
        height: 100%;
        width: 100%;
        transition: transform 0.6s ease;
    }

    .event-card:hover .event-card__image {
        transform: scale(1.1);
    }

    .event-card__title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.4em;
    }
</style>

@code {
    [Parameter] public EventListDto Event { get; set; } = default!;
    [Parameter] public EventCallback<EventListDto> OnEventClick { get; set; }

    private bool IsPastEvent()
    {
        return Event.LastSessionDate.HasValue && Event.LastSessionDate.Value.UtcDateTime.Date < DateTime.UtcNow.Date;
    }

    private bool IsUpcomingToday()
    {
        return Event.FirstSessionDate.HasValue && Event.FirstSessionDate.Value.UtcDateTime.Date == DateTime.UtcNow.Date && !IsPastEvent();
    }

    private async Task OnClick()
    {
        if (OnEventClick.HasDelegate)
            await OnEventClick.InvokeAsync(Event);
    }
}
