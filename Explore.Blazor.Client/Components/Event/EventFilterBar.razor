@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Models
@using Explore.Blazor.Client.Components.Event

<MudPaper Class="filter-bar sticky-header rounded-b-lg" Elevation="1" Style="z-index: 10; position: sticky; top: calc(var(--nav-height, 64px) + var(--announcement-bar-height, 0px)); backdrop-filter: blur(10px); background-color: color-mix(in srgb, var(--mud-palette-background) 95%, transparent);">

    @* ── Primary Action Row: Search + Show Filters + Search Button ── *@
    <div class="filter-bar__primary-row">
        <MudTextField @bind-Value="SearchTerm"
                      Placeholder="Search events..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Class="filter-bar__search-field" />

        <MudButton Variant="Variant.Outlined"
                   Color="@(_filtersExpanded ? Color.Primary : Color.Default)"
                   EndIcon="@(_filtersExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                   OnClick="ToggleFilters"
                   Size="Size.Medium"
                   Class="filter-bar__toggle-btn">
            @if (GetActiveFilterCount() > 0)
            {
                <MudBadge Content="@GetActiveFilterCount()" Color="Color.Primary" Overlap="true" Bordered="true">
                    <span>Filters</span>
                </MudBadge>
            }
            else
            {
                <span>Filters</span>
            }
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Search"
                   OnClick="SearchAsync"
                   Size="Size.Medium"
                   Class="filter-bar__search-btn">
            Search
        </MudButton>
    </div>

    @* ── Collapsible Filter Panel ── *@
    <MudCollapse Expanded="_filtersExpanded">
        <div class="filter-bar__panel">
            <div class="filter-bar__filters">

                @* ── Core Filters ── *@
                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Date Range</div>
                    <MudDateRangePicker @bind-DateRange="SelectedDateRange"
                                        Variant="Variant.Outlined"
                                        Margin="Margin.Dense"
                                        Placeholder="Any Time"
                                        Clearable="true"
                                        AutoClose="true"
                                        Dense="true" />
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Category</div>
                    <TriStateCategoryFilterDropdown @ref="_categoryFilterDropdown" CategoryGroups="@CategoryGroups" />
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Location</div>
                    <MudSelect T="Guid" MultiSelection="true" @bind-SelectedValues="SelectedLocationIds" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var location in Locations)
                        {
                            <MudSelectItem T="Guid" Value="@(location.Id.GetValueOrDefault())">@location.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Format</div>
                    <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedFormatIds" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var format in EventFormats)
                        {
                            <MudSelectItem T="int" Value="@(format.Id.GetValueOrDefault())">@format.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Type</div>
                    <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedEventTypeIds" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var type in EventTypes)
                        {
                            <MudSelectItem T="int" Value="@(type.Id.GetValueOrDefault())">@type.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Madhab</div>
                    <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedMadhabIds" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var madhab in Madhabs)
                        {
                            <MudSelectItem T="int" Value="@(madhab.Id.GetValueOrDefault())">@madhab.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Registration</div>
                    <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedRegistrationModeIds" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var mode in RegistrationModes)
                        {
                            <MudSelectItem T="int" Value="@(mode.Id.GetValueOrDefault())">@mode.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Language</div>
                    <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedLanguageIds" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var language in Languages)
                        {
                            <MudSelectItem T="int" Value="@(language.Id.GetValueOrDefault())">@language.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Gender</div>
                    <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedAudienceGenderIds" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var gender in AudienceGenders)
                        {
                            <MudSelectItem T="int" Value="@(gender.Id.GetValueOrDefault())">@gender.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Age</div>
                    <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedAudienceAgeIds" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var age in AudienceAges)
                        {
                            <MudSelectItem T="int" Value="@(age.Id.GetValueOrDefault())">@age.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Status</div>
                    <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedEventStatusIds" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var status in EventStatuses)
                        {
                            <MudSelectItem T="int" Value="@(status.Id.GetValueOrDefault())">@status.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Sort By</div>
                    <MudSelect T="string" @bind-Value="SelectedSortBy" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("date")">Date</MudSelectItem>
                        <MudSelectItem Value="@("title")">Title</MudSelectItem>
                        <MudSelectItem Value="@("popularity")">Popularity</MudSelectItem>
                        <MudSelectItem Value="@("created")">Recently Added</MudSelectItem>
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Tags</div>
                    <TriStateTagFilterDropdown @ref="_tagFilterDropdown" TagGroups="@TagGroups" />
                </div>

                @* ── Islamic Aspect Filters (conditional) ── *@
                @if (IsIslamicModuleEnabled)
                {
                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Gender Mode</div>
                        <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedGenderModeIds" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                            @foreach (GenderSegregationMode item in Enum.GetValues(typeof(GenderSegregationMode)))
                            {
                                <MudSelectItem T="int" Value="@((int)item)">@item.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Prayer Time</div>
                        <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="SelectedReferencePrayerIds" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                            @foreach (PrayerTime item in Enum.GetValues(typeof(PrayerTime)))
                            {
                                <MudSelectItem T="int" Value="@((int)item)">@item.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                }

                @* ── Tech Aspect Filters (conditional) ── *@
                @if (IsTechModuleEnabled)
                {
                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Skill Level</div>
                        <MudSelect T="SkillLevel?" @bind-Value="SelectedSkillLevel" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                            <MudSelectItem T="SkillLevel?" Value="@((SkillLevel?)null)">Any</MudSelectItem>
                            @foreach (SkillLevel item in Enum.GetValues(typeof(SkillLevel)))
                            {
                                <MudSelectItem Value="@((SkillLevel?)item)">@item.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Tech Stack</div>
                        <MudTextField @bind-Value="TechStackTag" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Placeholder="e.g. React, .NET" DebounceInterval="500" />
                    </div>
                }
            </div>

            @* ── Active Filters Summary ── *@
            @{ var activeCount = GetActiveFilterCount(); }
            @if (activeCount > 0)
            {
                <div class="filter-bar__active-summary">
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text">
                        @activeCount active @(activeCount == 1 ? "filter" : "filters")
                    </MudChip>
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.ClearAll" OnClick="ClearAllFilters">
                        Clear All
                    </MudButton>
                </div>
            }
        </div>
    </MudCollapse>

    @* ── Layout Switcher Row: always visible, always at the bottom, right-aligned ── *@
    <div class="filter-bar__layout-row">
        <MudToggleGroup T="LayoutMode" Value="CurrentLayout" ValueChanged="OnLayoutChanged"
                        Size="Size.Medium" Color="Color.Primary"
                        Class="filter-bar__layout-switcher">
            <MudToggleItem Value="@LayoutMode.SingleRow" Title="Single Row">
                <MudIcon Icon="@Icons.Material.Filled.ViewList" Size="Size.Medium" />
            </MudToggleItem>
            <MudToggleItem Value="@LayoutMode.DetailedList" Title="Detailed List">
                <MudIcon Icon="@Icons.Material.Filled.ViewModule" Size="Size.Medium" />
            </MudToggleItem>
            <MudToggleItem Value="@LayoutMode.CompactGrid" Title="Compact Grid">
                <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Medium" />
            </MudToggleItem>
        </MudToggleGroup>
    </div>

</MudPaper>
