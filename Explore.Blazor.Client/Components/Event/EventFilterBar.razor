@using MudBlazor
@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Models
@using Explore.Blazor.Client.Components.Event

<MudPaper Class="filter-bar sticky-header mb-4 rounded-lg mud-elevation-2" Style="z-index: 10; position: sticky; top: calc(var(--nav-height, 64px) + var(--announcement-bar-height, 0px)); backdrop-filter: blur(10px); background-color: color-mix(in srgb, var(--mud-palette-background) 95%, transparent);">

    @* ── Primary Action Row: Search + Show Filters + Search Button ── *@
    <div class="filter-bar__primary-row">
        <MudTextField @bind-Value="SearchTerm"
                      Placeholder="Search events..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      Class="filter-bar__search-field" />

        <MudButton Variant="Variant.Outlined"
                   Color="@(_filtersExpanded ? Color.Primary : Color.Default)"
                   EndIcon="@(_filtersExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                   OnClick="ToggleFilters"
                   Size="Size.Medium"
                   Class="filter-bar__toggle-btn">
            @if (GetActiveFilterCount() > 0)
            {
                <MudBadge Content="@GetActiveFilterCount()" Color="Color.Primary" Overlap="true" Bordered="true">
                    <span>Filters</span>
                </MudBadge>
            }
            else
            {
                <span>Filters</span>
            }
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Search"
                   OnClick="SearchAsync"
                   Size="Size.Medium"
                   Class="filter-bar__search-btn">
            Search
        </MudButton>
    </div>

    @* ── Collapsible Filter Panel ── *@
    <MudCollapse Expanded="_filtersExpanded">
        <div class="filter-bar__panel">
            <div class="filter-bar__filters">

                @* ── Core Filters ── *@
                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Date</div>
                    <MudSelect T="string" @bind-Value="SelectedDate" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("")">Any Time</MudSelectItem>
                        <MudSelectItem Value="@("today")">Today</MudSelectItem>
                        <MudSelectItem Value="@("tomorrow")">Tomorrow</MudSelectItem>
                        <MudSelectItem Value="@("thisweek")">This Week</MudSelectItem>
                        <MudSelectItem Value="@("thismonth")">This Month</MudSelectItem>
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Category</div>
                    <TriStateCategoryFilterDropdown @ref="_categoryFilterDropdown" CategoryGroups="@CategoryGroups" />
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Location</div>
                    <MudSelect T="Guid?" @bind-Value="SelectedLocationId" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">All Locations</MudSelectItem>
                        @foreach (var location in Locations)
                        {
                            <MudSelectItem @key="location.Id" T="Guid?" Value="@location.Id">@location.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Format</div>
                    <MudSelect T="int?" @bind-Value="SelectedFormatId" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">All Formats</MudSelectItem>
                        @foreach (var format in EventFormats)
                        {
                            <MudSelectItem @key="format.Id" T="int?" Value="@format.Id">@format.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Type</div>
                    <MudSelect T="int?" @bind-Value="SelectedEventTypeId" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">All Types</MudSelectItem>
                        @foreach (var type in EventTypes)
                        {
                            <MudSelectItem @key="type.Id" T="int?" Value="@type.Id">@type.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Madhab</div>
                    <MudSelect T="int?" @bind-Value="SelectedMadhabId" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">All Madhabs</MudSelectItem>
                        @foreach (var madhab in Madhabs)
                        {
                            <MudSelectItem @key="madhab.Id" T="int?" Value="@madhab.Id">@madhab.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Registration</div>
                    <MudSelect T="int?" @bind-Value="SelectedRegistrationModeId" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">All Modes</MudSelectItem>
                        @foreach (var mode in RegistrationModes)
                        {
                            <MudSelectItem @key="mode.Id" T="int?" Value="@mode.Id">@mode.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Language</div>
                    <MudSelect T="int?" @bind-Value="SelectedLanguageId" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">All Languages</MudSelectItem>
                        @foreach (var language in Languages)
                        {
                            <MudSelectItem @key="language.Id" T="int?" Value="@language.Id">@language.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Gender</div>
                    <MudSelect T="int?" @bind-Value="SelectedAudienceGenderId" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">All Genders</MudSelectItem>
                        @foreach (var gender in AudienceGenders)
                        {
                            <MudSelectItem @key="gender.Id" T="int?" Value="@gender.Id">@gender.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Age</div>
                    <MudSelect T="int?" @bind-Value="SelectedAudienceAgeId" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">All Ages</MudSelectItem>
                        @foreach (var age in AudienceAges)
                        {
                            <MudSelectItem @key="age.Id" T="int?" Value="@age.Id">@age.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Status</div>
                    <MudSelect T="int?" @bind-Value="SelectedEventStatusId" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                        <MudSelectItem T="int?" Value="@((int?)null)">All Statuses</MudSelectItem>
                        @foreach (var status in EventStatuses)
                        {
                            <MudSelectItem @key="status.Id" T="int?" Value="@status.Id">@status.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Sort By</div>
                    <MudSelect T="string" @bind-Value="SelectedSortBy" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("date")">Date</MudSelectItem>
                        <MudSelectItem Value="@("title")">Title</MudSelectItem>
                        <MudSelectItem Value="@("popularity")">Popularity</MudSelectItem>
                        <MudSelectItem Value="@("created")">Recently Added</MudSelectItem>
                    </MudSelect>
                </div>

                <div class="filter-bar__filter-item">
                    <div class="filter-bar__label">Tags</div>
                    <TriStateTagFilterDropdown @ref="_tagFilterDropdown" TagGroups="@TagGroups" />
                </div>

                @* ── Islamic Aspect Filters (conditional) ── *@
                @if (IsIslamicModuleEnabled)
                {
                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Gender Mode</div>
                        <MudSelect T="GenderSegregationMode?" @bind-Value="SelectedGenderMode" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                            <MudSelectItem T="GenderSegregationMode?" Value="@((GenderSegregationMode?)null)">Any</MudSelectItem>
                            @foreach (GenderSegregationMode item in Enum.GetValues(typeof(GenderSegregationMode)))
                            {
                                <MudSelectItem Value="@((GenderSegregationMode?)item)">@item.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Prayer Time</div>
                        <MudSelect T="PrayerTime?" @bind-Value="SelectedReferencePrayer" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                            <MudSelectItem T="PrayerTime?" Value="@((PrayerTime?)null)">Any</MudSelectItem>
                            @foreach (PrayerTime item in Enum.GetValues(typeof(PrayerTime)))
                            {
                                <MudSelectItem Value="@((PrayerTime?)item)">@item.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                }

                @* ── Tech Aspect Filters (conditional) ── *@
                @if (IsTechModuleEnabled)
                {
                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Skill Level</div>
                        <MudSelect T="SkillLevel?" @bind-Value="SelectedSkillLevel" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                            <MudSelectItem T="SkillLevel?" Value="@((SkillLevel?)null)">Any</MudSelectItem>
                            @foreach (SkillLevel item in Enum.GetValues(typeof(SkillLevel)))
                            {
                                <MudSelectItem Value="@((SkillLevel?)item)">@item.ToString()</MudSelectItem>
                            }
                        </MudSelect>
                    </div>

                    <div class="filter-bar__filter-item">
                        <div class="filter-bar__label">Tech Stack</div>
                        <MudTextField @bind-Value="TechStackTag" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Placeholder="e.g. React, .NET" DebounceInterval="500" />
                    </div>
                }
            </div>

            @* ── Active Filters Summary ── *@
            @{ var activeCount = GetActiveFilterCount(); }
            @if (activeCount > 0)
            {
                <div class="filter-bar__active-summary">
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text">
                        @activeCount active @(activeCount == 1 ? "filter" : "filters")
                    </MudChip>
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.ClearAll" OnClick="ClearAllFilters">
                        Clear All
                    </MudButton>
                </div>
            }
        </div>
    </MudCollapse>

</MudPaper>
