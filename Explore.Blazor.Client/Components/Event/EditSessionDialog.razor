@using Explore.Blazor.Client.Clients
@using Explore.Blazor.Client.Validators
@using FluentValidation
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3 mb-n1" />
            Edit Session
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="success" Model="sessionDto">
            <MudTextField @bind-Value="sessionDto.Title" Label="Title" For="@(() => sessionDto.Title)" Required="true" RequiredError="Title is required." />
            <MudTextField @bind-Value="sessionDto.Description" Label="Description" For="@(() => sessionDto.Description)" Lines="3" />
            <MudDatePicker @bind-Date="startDate" Label="Start Date" Required="true" />
            <MudTimePicker @bind-Time="startTime" Label="Start Time" Required="true" />
            <MudDatePicker @bind-Date="endDate" Label="End Date" Required="true" />
            <MudTimePicker @bind-Time="endTime" Label="End Time" Required="true" />
            <MudNumericField @bind-Value="sessionDto.MaxAudienceAttendees" Label="Max Audience" For="@(() => sessionDto.MaxAudienceAttendees)" Min="0" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Update</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public EventSessionDto ExistingSession { get; set; }

    private UpdateEventSessionDtoValidator validator = new();
    private MudForm form;
    private bool success;

    private UpdateEventSessionDto sessionDto = new();

    private DateTime? startDate = DateTime.Now;
    private TimeSpan? startTime = DateTime.Now.TimeOfDay;
    private DateTime? endDate = DateTime.Now.AddHours(1);
    private TimeSpan? endTime = DateTime.Now.AddHours(1).TimeOfDay;

    protected override void OnInitialized()
    {
        sessionDto.EventId = ExistingSession.EventId;
        sessionDto.Id = ExistingSession.Id;
        sessionDto.Title = ExistingSession.Title;
        sessionDto.Description = ExistingSession.Description;
        sessionDto.StartTime = ExistingSession.StartTime;
        sessionDto.EndTime = ExistingSession.EndTime;
        sessionDto.MaxAudienceAttendees = ExistingSession.MaxAudienceAttendees;

        // ExistingSession.StartTime is non-nullable DateTimeOffset
        startDate = ExistingSession.StartTime.Date.ToLocalTime();
        startTime = ExistingSession.StartTime.TimeOfDay;
        endDate = ExistingSession.EndTime.Date.ToLocalTime();
        endTime = ExistingSession.EndTime.TimeOfDay;
    }

    private async Task Submit()
    {
        await form.Validate();
        if (form.IsValid)
        {
            sessionDto.StartTime = new DateTimeOffset(startDate.Value.Date).Add(startTime.Value);
            sessionDto.EndTime = new DateTimeOffset(endDate.Value.Date).Add(endTime.Value);
            MudDialog.Close(DialogResult.Ok(sessionDto));
        }
    }

    void Cancel() => MudDialog.Cancel();
}
