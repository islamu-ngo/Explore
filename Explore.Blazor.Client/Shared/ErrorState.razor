@* ABOUTME: Shared error state component for displaying API errors with retry capability. *@
@* ABOUTME: Used across all pages for consistent error presentation. *@

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div role="alert">
        <MudAlert Severity="Severity.Error" 
                  Variant="Variant.Outlined" 
                  Class="mb-4"
                  ShowCloseIcon="true"
                  CloseIconClicked="OnDismiss">
            @ErrorMessage
        </MudAlert>
    </div>
    
    @if (OnRetry.HasDelegate)
    {
        <AppButton StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="OnRetry"
                   Class="mb-4">
            @RetryText
        </AppButton>
    }
}

@code {
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public string RetryText { get; set; } = "Try Again";
    
    private void OnDismiss()
    {
        ErrorMessage = null;
    }
}
