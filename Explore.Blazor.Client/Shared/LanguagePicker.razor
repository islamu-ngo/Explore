@* ABOUTME: Dropdown language picker using MudMenu, displays current language flag/code. *@
@* ABOUTME: Fetches available languages from ITranslationService, persists selection via BFF cookie. *@

@using Explore.Blazor.Client.Models
@inject ITranslationService TranslationService
@inject IHttpClientFactory HttpClientFactory
@inject ILogger<LanguagePicker> Logger

<MudMenu @bind-Open="_isOpen"
         AnchorOrigin="Origin.BottomCenter"
         TransformOrigin="Origin.TopCenter"
         Dense="true"
         Class="language-picker">
    <ActivatorContent>
        <AppButton Variant="Variant.Text" 
                   Color="Color.Inherit" 
                   EndIcon="@(_isOpen ? Icons.Material.Filled.ArrowDropUp : Icons.Material.Filled.ArrowDropDown)"
                   Style="text-transform: none; min-width: 0; padding: 4px 8px;">
            <MudText Typo="Typo.body1">@LanguageContext.ForLanguage(_currentLang).Flag</MudText>
        </AppButton>
    </ActivatorContent>
    <ChildContent>
        @if (_languages.Count > 0)
        {
            @foreach (var lang in _languages)
            {
                var ctx = LanguageContext.ForLanguage(lang);
                <MudMenuItem OnClick="@(() => SelectLanguageAsync(lang))"
                             Class="@(lang == _currentLang ? "language-picker__item--active" : "")">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.body2">@ctx.Flag</MudText>
                        <MudText Typo="Typo.body2">@ctx.LanguageName (@lang.ToUpperInvariant())</MudText>
                    </MudStack>
                </MudMenuItem>
            }
        }
        else
        {
            <MudMenuItem Disabled="true">
                <MudText Typo="Typo.body2">Loading...</MudText>
            </MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@code {
    [CascadingParameter(Name = "Language")]
    private LanguageContext? Language { get; set; }

    private ICollection<string> _languages = new List<string>();
    private string _currentLang = "en";
    private bool _isOpen;

    protected override async Task OnInitializedAsync()
    {
        _currentLang = Language?.LanguageCode ?? "en";

        try
        {
            _languages = await TranslationService.GetAvailableLanguagesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load available languages");
            _languages = new List<string> { "en" };
        }
    }

    private async Task SelectLanguageAsync(string languageCode)
    {
        if (languageCode == _currentLang)
            return;

        try
        {
            // Persist via BFF cookie endpoint
            var httpClient = HttpClientFactory.CreateClient("BffClient");
            await httpClient.PostAsync($"/bff/language?lang={languageCode}", null);

            // Change language in service (updates cache + fires event)
            await TranslationService.ChangeLanguageAsync(languageCode);
            _currentLang = languageCode;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to change language to {Language}", languageCode);
        }
    }
}
