@* ABOUTME: Consent-aware analytics initializer driven by a 7-state machine (Amendment 4). *@
@* ABOUTME: Banner shown only when CookieBannerEnabled. Decline → cookieless or disabled per policy. *@
@using Explore.Blazor.Client.Contracts.Interop
@using Explore.Blazor.Client.Models.Analytics
@using Explore.Blazor.Client.Services
@inject IPublicExperienceService PublicExperienceService
@inject IAnalyticsInterop AnalyticsInterop
@inject ICookieConsentInterop CookieConsentInterop
@inject CookieConsentStateService CookieConsentState
@inject NavigationManager NavigationManager
@inject ILogger<AnalyticsInitializer> Logger
@implements IDisposable

<CookieConsentBanner Visible="@_showBanner" OnAccept="HandleAcceptAsync" OnDecline="HandleDeclineAsync" />

@code {
    private const string NavigationSourceProperty = "navigation_source";
    private const string TenantIdProperty = "tenant_id";
    private const string PageReferrerProperty = "page_referrer";
    private const string InitialLoadNavigationSource = "initial_load";
    private const string InterceptedNavigationSource = "intercepted_navigation";
    private const string ProgrammaticNavigationSource = "programmatic_navigation";

    private bool _initialized;
    private bool _analyticsEnabled;
    private string? _lastTrackedPath;
    private string? _tenantId;

    private ConsentState _consentState = ConsentState.Uninitialized;
    private bool _showBanner;
    private PublicExperienceSettingsModel? _settings;
    private AnalyticsConsentBootstrapModel? _consent;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized)
        {
            return;
        }

        _initialized = true;

        CookieConsentState.OnReopenRequested += HandleReopenRequestedAsync;

        try
        {
            _settings = await PublicExperienceService.GetSettingsAsync();
            if (_settings is null)
            {
                return;
            }

            _consent = _settings.AnalyticsConsent;
            _analyticsEnabled = _settings.AnalyticsEnabled;
            _tenantId = _settings.TenantId == Guid.Empty ? null : _settings.TenantId.ToString();

            if (!_analyticsEnabled)
            {
                return;
            }

            await DetermineInitialStateAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Analytics initializer failed");
        }
    }

    private async Task DetermineInitialStateAsync()
    {
        if (_consent is null || !_consent.CookieBannerEnabled)
        {
            await TransitionToAsync(ConsentState.NoBannerImmediateInit);
            return;
        }

        var existingConsent = await CookieConsentInterop.ReadConsentAsync(_consent.ConsentCookieKey);

        if (string.Equals(existingConsent, "accepted", StringComparison.OrdinalIgnoreCase))
        {
            await TransitionToAsync(ConsentState.Accepted);
            return;
        }

        if (string.Equals(existingConsent, "declined", StringComparison.OrdinalIgnoreCase))
        {
            var declineState = _consent.DeclineBehavior == "cookieless"
                ? ConsentState.DeclinedCookieless
                : ConsentState.DeclinedDisabled;
            await TransitionToAsync(declineState);
            return;
        }

        // No cookie yet — show banner
        if (_consent.CanRunBeforeConsent)
        {
            await TransitionToAsync(ConsentState.BannerPendingCookieless);
        }
        else
        {
            await TransitionToAsync(ConsentState.BannerPendingBlocked);
        }
    }

    private async Task TransitionToAsync(ConsentState newState)
    {
        _consentState = newState;

        switch (newState)
        {
            case ConsentState.NoBannerImmediateInit:
                _showBanner = false;
                await InitAnalyticsFullAsync();
                await StartTrackingAsync();
                break;

            case ConsentState.BannerPendingCookieless:
                _showBanner = true;
                await InitAnalyticsCookielessAsync();
                await StartTrackingAsync();
                StateHasChanged();
                break;

            case ConsentState.BannerPendingBlocked:
                _showBanner = true;
                StateHasChanged();
                break;

            case ConsentState.Accepted:
                _showBanner = false;
                await AnalyticsInterop.OptInCapturingAsync();
                await InitAnalyticsFullAsync();
                await StartTrackingAsync();
                StateHasChanged();
                break;

            case ConsentState.DeclinedCookieless:
                _showBanner = false;
                await AnalyticsInterop.OptOutCapturingAsync();
                await StartTrackingAsync();
                StateHasChanged();
                break;

            case ConsentState.DeclinedDisabled:
                _showBanner = false;
                _analyticsEnabled = false;
                StateHasChanged();
                break;
        }
    }

    private async Task HandleAcceptAsync()
    {
        if (_consent is not null)
        {
            await CookieConsentInterop.WriteConsentAsync(
                _consent.ConsentCookieKey, "accepted", _consent.ConsentCookieLifetimeDays);
        }
        await TransitionToAsync(ConsentState.Accepted);
    }

    private async Task HandleDeclineAsync()
    {
        if (_consent is not null)
        {
            await CookieConsentInterop.WriteConsentAsync(
                _consent.ConsentCookieKey, "declined", _consent.ConsentCookieLifetimeDays);
        }

        var declineState = _consent?.DeclineBehavior == "cookieless"
            ? ConsentState.DeclinedCookieless
            : ConsentState.DeclinedDisabled;
        await TransitionToAsync(declineState);
    }

    /// <summary>Reopens the consent banner (called from footer "Cookie Settings" link).</summary>
    public async Task ReopenConsentAsync()
    {
        if (_consent is null || !_consent.CookieBannerEnabled)
        {
            return;
        }

        await CookieConsentInterop.ClearConsentAsync(_consent.ConsentCookieKey);

        if (_consent.CanRunBeforeConsent)
        {
            await TransitionToAsync(ConsentState.BannerPendingCookieless);
        }
        else
        {
            await TransitionToAsync(ConsentState.BannerPendingBlocked);
        }
    }

    private async Task HandleReopenRequestedAsync()
    {
        await InvokeAsync(async () =>
        {
            await ReopenConsentAsync();
            StateHasChanged();
        });
    }

    private async Task InitAnalyticsFullAsync()
    {
        if (_settings is null) return;
        await AnalyticsInterop.InitAsync(
            _settings.AnalyticsProvider,
            _settings.AnalyticsEnabled,
            _settings.AnalyticsConsentMode,
            _settings.AnalyticsTransportMode,
            _settings.AnalyticsAllowIdentify,
            _settings.AnalyticsPublicApiKey,
            _settings.AnalyticsEndpointUrl,
            _consent?.Posthog);
    }

    private async Task InitAnalyticsCookielessAsync()
    {
        if (_settings is null) return;
        var cookielessPosthog = _consent?.Posthog is not null
            ? new PosthogClientBootstrapModel
            {
                CookielessMode = "always",
                PersonProfiles = _consent.Posthog.PersonProfiles,
                SessionReplay = false,
                Autocapture = _consent.Posthog.Autocapture,
                Heatmaps = false,
                Toolbar = false
            }
            : null;

        await AnalyticsInterop.InitAsync(
            _settings.AnalyticsProvider,
            _settings.AnalyticsEnabled,
            _settings.AnalyticsConsentMode,
            _settings.AnalyticsTransportMode,
            _settings.AnalyticsAllowIdentify,
            _settings.AnalyticsPublicApiKey,
            _settings.AnalyticsEndpointUrl,
            cookielessPosthog);
    }

    private async Task StartTrackingAsync()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        await TrackPageViewAsync(NormalizePagePath(NavigationManager.Uri), InitialLoadNavigationSource);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            var navigationSource = e.IsNavigationIntercepted
                ? InterceptedNavigationSource
                : ProgrammaticNavigationSource;

            await TrackPageViewAsync(NormalizePagePath(e.Location), navigationSource);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Analytics pageview tracking failed for {Location}", e.Location);
        }
    }

    private async Task TrackPageViewAsync(string pagePath, string navigationSource)
    {
        if (!_analyticsEnabled || string.Equals(_lastTrackedPath, pagePath, StringComparison.Ordinal))
        {
            return;
        }

        var properties = new Dictionary<string, object>(StringComparer.Ordinal)
        {
            [NavigationSourceProperty] = navigationSource
        };

        if (!string.IsNullOrWhiteSpace(_tenantId))
        {
            properties[TenantIdProperty] = _tenantId;
        }

        if (!string.IsNullOrWhiteSpace(_lastTrackedPath))
        {
            properties[PageReferrerProperty] = _lastTrackedPath;
        }

        await AnalyticsInterop.PageViewAsync(pagePath, properties);
        _lastTrackedPath = pagePath;
    }

    private static string NormalizePagePath(string location)
    {
        if (!Uri.TryCreate(location, UriKind.Absolute, out var absoluteUri))
        {
            return string.IsNullOrWhiteSpace(location) ? "/" : location;
        }

        var path = absoluteUri.AbsolutePath;
        return string.IsNullOrWhiteSpace(path) ? "/" : path;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        CookieConsentState.OnReopenRequested -= HandleReopenRequestedAsync;
    }
}
