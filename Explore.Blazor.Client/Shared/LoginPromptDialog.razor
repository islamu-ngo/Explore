@* ABOUTME: Contextual sign-in intercept shown before protected actions.
   ABOUTME: Defers provider selection to the dedicated login flow. *@

@using MudBlazor
@inject NavigationManager Navigation

<MudDialog Class="login-prompt" DefaultFocus="DefaultFocus.None">
    <DialogContent>
        <div class="login-prompt__container">
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Class="login-prompt__close"
                           OnClick="Close" />

            <div class="login-prompt__header">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h5" Class="login-prompt__title">
                    Sign in required
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="login-prompt__message">
                    @Message
                </MudText>
            </div>

            <div class="login-prompt__section">
                <MudButton Elevation="0" Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Login"
                           OnClick="ContinueToLogin"
                           Class="login-prompt__btn login-prompt__btn--primary">
                    Continue to Login
                </MudButton>

                <MudButton Elevation="0" Variant="Variant.Text"
                           Color="Color.Default"
                           FullWidth="true"
                           OnClick="Close"
                           Class="login-prompt__btn login-prompt__btn--cancel">
                    Not now
                </MudButton>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? ReturnUrl { get; set; }

    [Parameter]
    public string Message { get; set; } = "You need to sign in before continuing.";

    private void Close()
    {
        MudDialog.Close();
    }

    private void ContinueToLogin()
    {
        MudDialog.Close();
        var returnUrl = ReturnUrl ?? "/";
        Navigation.NavigateTo($"/auth/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }

    /// <summary>
    /// Static helper to show the dialog using the project's typed dialog pattern.
    /// </summary>
    public static async Task<IDialogReference> ShowAsync(
        IDialogService dialogService,
        string? returnUrl = null,
        string? message = null)
    {
        var parameters = new DialogParameters
        {
            ["ReturnUrl"] = returnUrl,
            ["Message"] = message ?? "You need to sign in before continuing."
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true,
            CloseButton = false,
            NoHeader = true,
            CloseOnEscapeKey = true,
            BackgroundClass = "login-prompt-backdrop"
        };
        return await dialogService.ShowAsync<LoginPromptDialog>("Sign in", parameters, options);
    }
}
