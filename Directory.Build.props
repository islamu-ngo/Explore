<Project>
  <PropertyGroup>
    <!-- Compiler Warning Ratchet: treat warnings as errors across the entire solution -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <!--
      Temporary ratchet suppressions. Categories are removed incrementally as warnings are resolved:
      - Nullable: 'nullable' alias (CS8600-CS8631, CS8669, CS8767)
      - C# Compiler: CS0105, CS0108, CS0168, CS0169, CS0219, CS0414, CS0618, CS0649, CS4014, CS9107, CS9113, CS9124
      - Framework/Component: MUD0002, EF1002, S3903, S5332, SYSLIB0050, SYSLIB1034
      - Code Analysis (Design/Naming): CA1000, CA1036, CA1050, CA1068, CA1707, CA1708, CA1711, CA1716, CA1720, CA1725, CA1727
      - Code Analysis (Globalization): CA1304, CA1305, CA1309, CA1311
      - Code Analysis (Maintainability/Interoperability): CA1416, CA1512
      - Code Analysis (Performance): CA1805, CA1806, CA1816, CA1826, CA1827, CA1829, CA1832, CA1846, CA1847, CA1859, CA1860, CA1861, CA1862, CA1863, CA1865, CA1869, CA1870, CA1873, CA1875
      - Code Analysis (Reliability/Security): CA2000, CA2012, CA2016, CA2208, CA2263
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);nullable;CS0105;CS0108;CS0168;CS0169;CS0219;CS0414;CS0618;CS0649;CS4014;CS9107;CS9113;CS9124;MUD0002;EF1002;S3903;S5332;SYSLIB0050;SYSLIB1034;CA1000;CA1036;CA1050;CA1068;CA1304;CA1305;CA1309;CA1311;CA1416;CA1512;CA1707;CA1708;CA1711;CA1716;CA1720;CA1725;CA1727;CA1805;CA1806;CA1816;CA1826;CA1827;CA1829;CA1832;CA1846;CA1847;CA1859;CA1860;CA1861;CA1862;CA1863;CA1865;CA1869;CA1870;CA1873;CA1875;CA2000;CA2012;CA2016;CA2208;CA2263</WarningsNotAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Authors>Amir Akrari, ISLAMU Team, and Contributors</Authors>
    <Company>ISLAMU (ASBL en formation)</Company>
    <Copyright>Copyright (c) 2026 ISLAMU (ASBL en formation). Licensed under AGPL-3.0-or-later.</Copyright>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/islamu-ngo/Event</PackageProjectUrl>
    <RepositoryUrl>https://github.com/islamu-ngo/Event</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- Commercial Lucky Penny build: define C# preprocessor symbol for #if guards -->
  <PropertyGroup Condition="'$(UseCommercialLuckyPennyLibraries)' == 'true'">
    <DefineConstants>$(DefineConstants);USE_COMMERCIAL_LUCKYPENNY_LIBS</DefineConstants>
  </PropertyGroup>

  <!-- CI: FOSS builds enforce locked restore (deterministic, lock files committed to repo) -->
  <PropertyGroup Condition="('$(TF_BUILD)' == 'true' or '$(GITHUB_ACTIONS)' == 'true') and '$(UseCommercialLuckyPennyLibraries)' != 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

  <!-- CI: Commercial builds re-resolve packages (lock files track FOSS versions) -->
  <PropertyGroup Condition="('$(TF_BUILD)' == 'true' or '$(GITHUB_ACTIONS)' == 'true') and '$(UseCommercialLuckyPennyLibraries)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <EnableMicrosoftTestingPlatformExtensions>true</EnableMicrosoftTestingPlatformExtensions>
  </PropertyGroup>
</Project>
