<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);nullable;MUD0002</WarningsNotAsErrors>
    <Deterministic>true</Deterministic>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- Commercial Lucky Penny build: define C# preprocessor symbol for #if guards -->
  <PropertyGroup Condition="'$(UseCommercialLuckyPennyLibraries)' == 'true'">
    <DefineConstants>$(DefineConstants);USE_COMMERCIAL_LUCKYPENNY_LIBS</DefineConstants>
  </PropertyGroup>

  <!-- CI: FOSS builds enforce locked restore (deterministic, lock files committed to repo) -->
  <PropertyGroup Condition="('$(TF_BUILD)' == 'true' or '$(GITHUB_ACTIONS)' == 'true') and '$(UseCommercialLuckyPennyLibraries)' != 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

  <!-- CI: Commercial builds re-resolve packages (lock files track FOSS versions) -->
  <PropertyGroup Condition="('$(TF_BUILD)' == 'true' or '$(GITHUB_ACTIONS)' == 'true') and '$(UseCommercialLuckyPennyLibraries)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <EnableMicrosoftTestingPlatformExtensions>true</EnableMicrosoftTestingPlatformExtensions>
  </PropertyGroup>
</Project>
